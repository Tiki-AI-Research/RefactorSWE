+function formatElement(value: unknown): string {
+  if (value === null) {
+    return "null";
+  }
+  if (value === undefined) {
+    return "undefined";
+  }
+  const t = typeof value;
+  if (t === "object" || t === "function") {
+    return `<type: ${t}>`;
+  }
+  return String(value);
+}
+
+function formatReturned(value: unknown): string {
+  if (Array.isArray(value)) {
+    return `[length: ${value.length}]`;
+  }
+  if (value === null) {
+    return "null";
+  }
+  if (value === undefined) {
+    return "undefined";
+  }
