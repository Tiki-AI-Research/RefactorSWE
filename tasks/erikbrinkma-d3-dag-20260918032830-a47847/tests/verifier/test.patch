+
+function assertThrows(fn: () => unknown): Error {
+  try {
+    fn();
+  } catch (err) {
+    expect(err).toBeInstanceOf(Error);
+    return err as Error;
+  }
+  throw new Error("Expected function to throw, but it did not throw");
+}
+
+const ERROR_REGEX =
+  /^category=([^;]+);\s*node=([^;]+);\s*width=([^;]+);\s*height=([^;]+)(?:;\s*returned=([^;]+))?(?:;\s*legacy=(.*))?$/;
+
+interface ExpectedError {
+  category: string;
+  node: string;
+  width: string;
+  height: string;
+  returned?: string;
+}
+
+function assertStandardError(
+  fn: () => unknown,
+  expected: ExpectedError,
+): Error {
+  const err = assertThrows(fn);
+  const match = err.message.match(ERROR_REGEX);
+  expect(match).toBeTruthy();
+  if (!match) {
+    throw new Error(`Message did not match standard format: ${err.message}`);
+  }
+
+  expect(match[1]).toBe(expected.category);
+  expect(match[2]).toBe(expected.node);
+  expect(match[3]).toBe(expected.width);
+  expect(match[4]).toBe(expected.height);
+
+  if (expected.returned !== undefined) {
+    expect(match[5]).toBe(expected.returned);
+  } else {
+    expect(match[5]).toBeUndefined();
+  }
+
+  if (expected.category === "constant-node-size") {
+    expect(match[6]).toBeDefined();
+    expect(err.message.endsWith(`; legacy=${match[6]}`)).toBe(true);
+    expect(
+      match[6]!.includes("must be positive") ||
+        match[6]!.includes("all node sizes must be positive"),
+    ).toBe(true);
+  } else if (expected.category === "invalid-callback-node-size") {
+    expect(match[6]).toBeDefined();
+    expect(err.message.endsWith(`; legacy=${match[6]}`)).toBe(true);
+    expect(match[6]!.includes("all node sizes must be positive")).toBe(true);
+  } else if (expected.category === "node-size-callback-threw") {
+    expect(match[3]).toBe("<unavailable>");
+    expect(match[4]).toBe("<unavailable>");
+    expect(match[5]).toBeUndefined();
+    expect(match[6]).toBeUndefined();
+    expect(err.message).toBe(
+      `category=node-size-callback-threw; node=${expected.node}; width=<unavailable>; height=<unavailable>`,
+    );
+    expect("cause" in err).toBe(true);
+  }
+
+  return err;
+}
