+// ============================================================================
+// State, Caching, Twisting, Unwrapping, and Coercion Safety
+// ============================================================================
+test("callbacks reusing a single mutable tuple preserve independent dimensions in splitNodeSize", () => {
+  const sharedTuple: [number, number] = [0, 0];
+  const dimensionMap: Record<string, [number, number]> = {
+    A: [10, 20],
+    B: [30, 40],
+    C: [50, 60],
+  };
+
+  const mutableCallback = (node: GraphNode<string, undefined>) => {
+    const dim = dimensionMap[node.data];
+    sharedTuple[0] = dim[0];
+    sharedTuple[1] = dim[1];
+    return sharedTuple;
+  };
+
+  const grfSplit = graph() as any;
+  const snA = grfSplit.node("A");
+  const snB = grfSplit.node("B");
+  const [xLen, yLen] = splitNodeSize(mutableCallback);
+  expect(xLen(snA)).toBe(10);
+  sharedTuple[0] = 999;
+  sharedTuple[1] = 888;
+  expect(yLen(snA)).toBe(20);
+  expect(xLen(snB)).toBe(30);
+  sharedTuple[0] = -1;
+  sharedTuple[1] = -1;
+  expect(yLen(snB)).toBe(40);
+  expect(xLen(snA)).toBe(10);
+  expect(yLen(snA)).toBe(20);
+});
