+test("zherebko evaluates shared tweak callback at most once per node in a single execution", () => {
+  const normalSizes: Record<string, readonly [number, number]> = {
+    A: [12, 14],
+    B: [24, 28],
+  };
+  const sentinelSizes: Record<string, readonly [number, number]> = {
+    A: [120, 140],
+    B: [240, 280],
+  };
+  const counts = new Map<string, number>();
+
+  const nodeSizeFn = (node: GraphNode<string, undefined>) => {
+    const c = (counts.get(node.data) ?? 0) + 1;
+    counts.set(node.data, c);
+    return c === 1 ? normalSizes[node.data] : sentinelSizes[node.data];
+  };
+
+  const grfCtrl = graph<string, undefined>();
+  const aCtrl = grfCtrl.node("A");
+  const bCtrl = grfCtrl.node("B");
+  const linkCtrl = aCtrl.child(bCtrl);
+  const ctrlRes = zherebko()
+    .nodeSize((node) => normalSizes[node.data])
+    .tweaks([tweakShape((node) => normalSizes[node.data])])(grfCtrl);
+
+  const grf = graph<string, undefined>();
+  const a = grf.node("A");
+  const b = grf.node("B");
+  const link = a.child(b);
+
+  const observedInTweak = new Map<string, readonly [number, number]>();
+  const spyShape = (
+    center: readonly [number, number],
+    size: readonly [number, number],
+    first: readonly [number, number],
+    second: readonly [number, number],
+  ) => {
+    if (center[0] === a.x && center[1] === a.y) {
+      observedInTweak.set("A", size);
+    } else if (center[0] === b.x && center[1] === b.y) {
+      observedInTweak.set("B", size);
+    }
+    return shapeRect(center, size, first, second);
+  };
+
+  const layout = zherebko()
+    .nodeSize(nodeSizeFn)
+    .tweaks([tweakShape(nodeSizeFn, spyShape)]);
+
+  const res = layout(grf);
+
+  expect(counts.get("A")).toBe(1);
+  expect(counts.get("B")).toBe(1);
+
+  expect(observedInTweak.get("A")).toEqual(normalSizes.A);
+  expect(observedInTweak.get("B")).toEqual(normalSizes.B);
+
+  expect(res.width).toBe(ctrlRes.width);
+  expect(res.height).toBe(ctrlRes.height);
+  expect(a.x).toBe(aCtrl.x);
+  expect(a.y).toBe(aCtrl.y);
+  expect(b.x).toBe(bCtrl.x);
+  expect(b.y).toBe(bCtrl.y);
+  expect(link.points).toEqual(linkCtrl.points);
+});
