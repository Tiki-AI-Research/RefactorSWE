+  expect(innerOuterCount).toBe(1);
+
+  let errorCbCount = 0;
+  const thrownErr = new Error("nested failure");
+  const throwingCb = (_node: GraphNode<string, undefined>) => {
+    errorCbCount++;
+    throw thrownErr;
+  };
+  const innerErrAccessor = cachedNodeSize(throwingCb);
+  const outerErrAccessor = cachedNodeSize(innerErrAccessor);
+  let caughtInner: any;
+  try {
+    innerErrAccessor(nA);
+  } catch (e) {
+    caughtInner = e;
+  }
+  expect(errorCbCount).toBe(1);
+  expect(caughtInner).toBeDefined();
