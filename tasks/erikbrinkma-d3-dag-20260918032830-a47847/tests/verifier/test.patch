+test("callbacks reusing a single mutable tuple preserve independent dimensions in sugiyama", () => {
+  const dimensionMap: Record<string, readonly [number, number]> = {
+    A: [10, 20],
+    B: [30, 40],
+  };
+
+  // 1. Control graph with fresh tuples
+  const grfControl = graph<string, undefined>();
+  const cA = grfControl.node("A");
+  const cB = grfControl.node("B");
+  const linkControl = cA.child(cB);
+
+  const freshCallback = (node: GraphNode<string, undefined>) => {
+    const dim = dimensionMap[node.data];
+    return [dim[0], dim[1]] as [number, number];
+  };
+
+  const controlRes = sugiyama()
+    .nodeSize(freshCallback)
+    .tweaks([tweakShape(freshCallback), tweakSugiyama(freshCallback)])(
+    grfControl,
+  );
+
+  // 2. Mutable graph reusing single sharedTuple
+  const sharedTuple: [number, number] = [0, 0];
+  const counts = new Map<string, number>();
+  const mutableCallback = (node: GraphNode<string, undefined>) => {
+    counts.set(node.data, (counts.get(node.data) ?? 0) + 1);
+    const dim = dimensionMap[node.data];
+    sharedTuple[0] = dim[0];
+    sharedTuple[1] = dim[1];
+    return sharedTuple;
+  };
+
+  const grfSugi = graph<string, undefined>();
+  const sA = grfSugi.node("A");
+  const sB = grfSugi.node("B");
+  const linkSugi = sA.child(sB);
+
+  const observedInTweak = new Map<string, readonly [number, number]>();
+  const spyShape = (
+    center: readonly [number, number],
+    size: readonly [number, number],
+    first: readonly [number, number],
+    second: readonly [number, number],
+  ) => {
+    if (center[0] === sA.x && center[1] === sA.y) {
+      observedInTweak.set("A", [size[0], size[1]]);
+    } else if (center[0] === sB.x && center[1] === sB.y) {
+      observedInTweak.set("B", [size[0], size[1]]);
+    }
+    return shapeRect(center, size, first, second);
+  };
+
+  const sugiRes = sugiyama()
+    .nodeSize(mutableCallback)
+    .tweaks([
+      tweakShape(mutableCallback, spyShape),
+      tweakSugiyama(mutableCallback),
+    ])(grfSugi);
+
+  // Sentinel overwrite to guarantee defensive copying
+  sharedTuple[0] = 9999;
+  sharedTuple[1] = 9999;
+
+  // Assertions:
+  expect(counts.get("A")).toBe(1);
+  expect(counts.get("B")).toBe(1);
+
+  expect(observedInTweak.get("A")).toEqual([10, 20]);
+  expect(observedInTweak.get("B")).toEqual([30, 40]);
+
+  expect(sugiRes.width).toBe(controlRes.width);
+  expect(sugiRes.height).toBe(controlRes.height);
+  expect(sA.x).toBe(cA.x);
+  expect(sA.y).toBe(cA.y);
+  expect(sB.x).toBe(cB.x);
+  expect(sB.y).toBe(cB.y);
+  expect(linkSugi.points).toEqual(linkControl.points);
+});
