+test("sugiyama shared execution context reuses failure state between accessor and tweakShape when callback throws", () => {
+  const grf = graph<string, undefined>();
+  const a = grf.node("A");
+  const b = grf.node("B");
+  a.child(b);
+
+  const callCounts = new Map<string, number>();
+  const cb = (node: GraphNode<string, undefined>) => {
+    const count = (callCounts.get(node.data) ?? 0) + 1;
+    callCounts.set(node.data, count);
+    if (count > 1) {
+      throw new Error("cb invoked second time for node " + node.data);
+    }
+    return [10, 20] as const;
+  };
+
+  const tweak = tweakShape(cb);
+  const layout = sugiyama().nodeSize(cb).tweaks([tweak]);
+  let res: LayoutResult | undefined;
+  expect(() => {
+    res = layout(grf);
+  }).not.toThrow();
+
+  expect(res).toBeDefined();
+  expect(res!.width).toBeGreaterThan(0);
+  expect(res!.height).toBeGreaterThan(0);
+  expect(callCounts.get("A")).toBe(1);
+  expect(callCounts.get("B")).toBe(1);
+  expect(a.x).toBeDefined();
+  expect(a.y).toBeDefined();
+  expect(b.x).toBeDefined();
+  expect(b.y).toBeDefined();
+});
