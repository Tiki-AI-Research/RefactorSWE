+test("inner layout failure in custom tweak restores outer execution context and preserves geometry", () => {
+  const grfControl = graph<string, undefined>();
+  const c0 = grfControl.node("0");
+  const c1 = grfControl.node("1");
+  const linkControl = c0.child(c1);
+
+  const controlCounts: Record<string, number> = { "0": 0, "1": 0 };
+  const controlCallback = (node: GraphNode<string, undefined>) => {
+    controlCounts[node.data] = (controlCounts[node.data] ?? 0) + 1;
+    return node.data === "0" ? ([20, 30] as const) : ([40, 50] as const);
+  };
+
+  const dummyTweak: Tweak<string, undefined> = (_g, res) => res;
+  const controlRes = sugiyama()
+    .nodeSize(controlCallback)
+    .tweaks([dummyTweak, tweakSugiyama(controlCallback)])(grfControl);
+
+  const grf = graph<string, undefined>();
+  const n0 = grf.node("0");
+  const n1 = grf.node("1");
+  const link = n0.child(n1);
+
+  const outerCounts: Record<string, number> = { "0": 0, "1": 0 };
+  const outerCallback = (node: GraphNode<string, undefined>) => {
+    outerCounts[node.data] = (outerCounts[node.data] ?? 0) + 1;
+    return node.data === "0" ? ([20, 30] as const) : ([40, 50] as const);
+  };
+
+  let caughtError: unknown = null;
+  const targetInnerException = new Error("inner layout intentional failure");
+  const customTweak: Tweak<string, undefined> = (_g, res) => {
+    try {
+      const innerGrf = graph<string, undefined>();
+      const inA = innerGrf.node("inA");
+      const inB = innerGrf.node("inB");
+      inA.child(inB);
+      sugiyama().nodeSize(() => {
+        throw targetInnerException;
+      })(innerGrf);
+    } catch (err: unknown) {
+      caughtError = err;
+    }
+    return res;
+  };
+
+  const experimentalRes = sugiyama()
+    .nodeSize(outerCallback)
+    .tweaks([customTweak, tweakSugiyama(outerCallback)])(grf);
+
+  expect(caughtError).toBeTruthy();
+  expect(outerCounts["0"]).toBe(1);
+  expect(outerCounts["1"]).toBe(1);
+
+  expect(experimentalRes.width).toBe(controlRes.width);
+  expect(experimentalRes.height).toBe(controlRes.height);
+  expect(n0.x).toBe(c0.x);
+  expect(n0.y).toBe(c0.y);
+  expect(n1.x).toBe(c1.x);
+  expect(n1.y).toBe(c1.y);
+  expect(link.points).toEqual(linkControl.points);
+});
