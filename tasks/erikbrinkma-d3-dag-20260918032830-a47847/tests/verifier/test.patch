+function testCachedNodeSizeOperator(
+  createOp: () => {
+    nodeSize: (
+      acc: (node: GraphNode<string, undefined>) => readonly [number, number],
+    ) => {
+      (dag: Graph<string, undefined>): unknown;
+      tweaks: (
+        t: readonly unknown[],
+      ) => (dag: Graph<string, undefined>) => unknown;
+    };
+  },
+) {
+  const counts = new Map<string, number>();
+  const rawCallback = (node: GraphNode<string, undefined>) => {
+    counts.set(node.data, (counts.get(node.data) ?? 0) + 1);
+    return [10, 20] as const;
+  };
+
+  const accessor = cachedNodeSize(rawCallback);
+
+  const grf = graph() as any;
+  const nA = grf.node("A");
+  const nB = grf.node("B");
+  grf.link(nA, nB);
+
+  // 1. Direct invocation on accessor caches for its own lifetime
+  const direct1 = accessor(nA);
+  expect(direct1).toEqual([10, 20]);
+  expect(counts.get("A")).toBe(1);
+
+  const direct2 = accessor(nA);
+  expect(direct2).toEqual([10, 20]);
+  expect(counts.get("A")).toBe(1);
+
+  const op = createOp();
+  const layout = op.nodeSize(accessor);
+
+  // 2. First layout execution: MUST use an execution-local cache and evaluate each node
+  layout(grf);
+  expect(counts.get("A")).toBe(2);
+  expect(counts.get("B")).toBe(1);
+
+  // 3. Second layout execution: MUST use a new execution-local cache and evaluate each node again
+  layout(grf);
+  expect(counts.get("A")).toBe(3);
+  expect(counts.get("B")).toBe(2);
+
+  // 4. Third layout execution with attached tweak sharing the same accessor reference
+  const layoutWithTweak = op.nodeSize(accessor).tweaks([tweakShape(accessor)]);
+  layoutWithTweak(grf);
+  expect(counts.get("A")).toBe(4);
+  expect(counts.get("B")).toBe(3);
+}
