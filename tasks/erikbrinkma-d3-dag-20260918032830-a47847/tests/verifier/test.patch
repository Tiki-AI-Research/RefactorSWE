+test("reusing mutable tuple achieves identical layout geometry to fresh tuples", () => {
+  const grfControl = graph<string, undefined>();
+  const cR = grfControl.node("R");
+  const cA = grfControl.node("A");
+  const cB = grfControl.node("B");
+  const linkRAControl = cR.child(cA);
+  const linkRBControl = cR.child(cB);
+
+  const controlDimensions: Record<string, readonly [number, number]> = {
+    R: [10, 10],
+    A: [10, 20],
+    B: [50, 40],
+  };
+  const freshCallback = (node: GraphNode<string, undefined>) => {
+    const dim = controlDimensions[node.data];
+    return [dim[0], dim[1]] as const;
+  };
+
+  const controlRes = sugiyama()
+    .nodeSize(freshCallback)
+    .tweaks([tweakShape(freshCallback), tweakSugiyama(freshCallback)])(
+    grfControl,
+  );
+
+  const grfMutable = graph<string, undefined>();
+  const mR = grfMutable.node("R");
+  const mA = grfMutable.node("A");
+  const mB = grfMutable.node("B");
+  const linkRAMutable = mR.child(mA);
+  const linkRBMutable = mR.child(mB);
+
+  const sharedTuple: [number, number] = [0, 0];
+  const mutableCallback = (node: GraphNode<string, undefined>) => {
+    const dim = controlDimensions[node.data];
+    sharedTuple[0] = dim[0];
+    sharedTuple[1] = dim[1];
+    return sharedTuple;
+  };
+
+  const mutableRes = sugiyama()
+    .nodeSize(mutableCallback)
+    .tweaks([tweakShape(mutableCallback), tweakSugiyama(mutableCallback)])(
+    grfMutable,
+  );
+
+  sharedTuple[0] = 99999;
+  sharedTuple[1] = 88888;
+
+  expect(mutableRes.width).toBe(controlRes.width);
+  expect(mutableRes.height).toBe(controlRes.height);
+  expect(mR.x).toBe(cR.x);
+  expect(mR.y).toBe(cR.y);
+  expect(mA.x).toBe(cA.x);
+  expect(mA.y).toBe(cA.y);
+  expect(mB.x).toBe(cB.x);
+  expect(mB.y).toBe(cB.y);
+  expect(linkRAMutable.points).toEqual(linkRAControl.points);
+  expect(linkRBMutable.points).toEqual(linkRBControl.points);
+});
