+      observedInTweak.set("GB", size);
+    } else if (center[0] === gC.x && center[1] === gC.y) {
+      observedInTweak.set("GC", size);
+    }
+    return shapeRect(center, size, first, second);
+  };
+
+  const gridLayout = grid()
+    .gap([20, 20])
+    .nodeSize(nodeSizeFn)
+    .tweaks([
+      tweakGridHandles(nodeSizeFn, [20, 20]),
+      tweakShape(nodeSizeFn, spyShape),
+    ]);
