diff --git a/internal/x11/win/decoration.go b/internal/x11/win/decoration.go
new file mode 100644
index 0000000000000000000000000000000000000000..cd8a6756a5a743309219c58f935d77fe084e8ae1
--- /dev/null
+++ b/internal/x11/win/decoration.go
@@ -0,0 +1,227 @@
+//go:build linux || openbsd || freebsd || netbsd
+// +build linux openbsd freebsd netbsd
+
+package win
+
+import (
+	"image"
+
+	"fyne.io/fyne/v2"
+	"fyne.io/fyne/v2/test"
+	"fyne.io/fyne/v2/theme"
+	"fyne.io/fyne/v2/tools/playground"
+
+	"github.com/BurntSushi/xgb/xproto"
+
+	"fyshos.com/fynedesk"
+	"fyshos.com/fynedesk/internal/x11"
+	wmTheme "fyshos.com/fynedesk/theme"
+	"fyshos.com/fynedesk/wm"
+)
+
+type decoration struct {
+	client *client
+	frame  *frame
+
+	borderTop, borderTopRight             xproto.Pixmap
+	borderTopGC, borderTopRightGC, rectGC xproto.Gcontext
+	borderTopWidth                        uint16
+	canvas                                test.WindowlessCanvas
+}
+
+func newDecoration(c *client, f *frame) *decoration {
+	return &decoration{
+		client: c,
+		frame:  f,
+	}
+}
+
+func (d *decoration) applyBorderlessTheme() {
+	w, h := d.frame.size()
+	xproto.ConfigureWindow(d.client.wm.Conn(), d.client.win, xproto.ConfigWindowX|xproto.ConfigWindowY|
+		xproto.ConfigWindowWidth|xproto.ConfigWindowHeight,
+		[]uint32{uint32(0), uint32(0), uint32(w), uint32(h)})
+}
+
+func (d *decoration) copyDecorationPixels(width, height, xoff, yoff uint32, img image.Image, pid xproto.Pixmap, draw xproto.Gcontext, depth byte) {
+	// DATA is BGRx
+	data := make([]byte, width*height*4)
+	i := uint32(0)
+	for y := uint32(0); y < height; y++ {
+		for x := uint32(0); x < width; x++ {
+			r, g, b, _ := img.At(int(xoff+x), int(yoff+y)).RGBA()
+
+			data[i] = byte(b)
+			data[i+1] = byte(g)
+			data[i+2] = byte(r)
+			data[i+3] = 0xff
+
+			i += 4
+		}
+	}
+	xproto.PutImage(d.client.wm.Conn(), xproto.ImageFormatZPixmap, xproto.Drawable(pid), draw,
+		uint16(width), uint16(height), 0, int16(yoff), 0, depth, data)
+}
+
+func (d *decoration) createPixmaps(depth byte) error {
+	heightPix := x11.TitleHeight(x11.XWin(d.client))
+	rightWidthPix := d.topRightPixelWidth()
+	w, _ := d.frame.size()
+	d.borderTopWidth = w - rightWidthPix
+
+	pid, err := xproto.NewPixmapId(d.client.wm.Conn())
+	if err != nil {
+		return err
+	}
+
+	xproto.CreatePixmap(d.client.wm.Conn(), depth, pid,
+		xproto.Drawable(d.client.wm.X().Screen().Root), d.borderTopWidth, heightPix)
+	d.borderTop = pid
+
+	pid, err = xproto.NewPixmapId(d.client.wm.Conn())
+	if err != nil {
+		return err
+	}
+
+	xproto.CreatePixmap(d.client.wm.Conn(), depth, pid,
+		xproto.Drawable(d.client.wm.X().Screen().Root), rightWidthPix, heightPix)
+	d.borderTopRight = pid
+
+	backR, backG, backB, _ := theme.DisabledButtonColor().RGBA()
+	if d.client.Focused() {
+		backR, backG, backB, _ = theme.BackgroundColor().RGBA()
+	}
+	bgColor := uint32(uint8(backR))<<16 | uint32(uint8(backG))<<8 | uint32(uint8(backB))
+
+	d.rectGC, _ = xproto.NewGcontextId(d.client.wm.Conn())
+	xproto.CreateGC(d.client.wm.Conn(), d.rectGC, xproto.Drawable(d.client.id), xproto.GcForeground, []uint32{bgColor})
+
+	d.borderTopGC, _ = xproto.NewGcontextId(d.client.wm.Conn())
+	xproto.CreateGC(d.client.wm.Conn(), d.borderTopGC, xproto.Drawable(d.borderTop), xproto.GcForeground, []uint32{bgColor})
+	d.borderTopRightGC, _ = xproto.NewGcontextId(d.client.wm.Conn())
+	xproto.CreateGC(d.client.wm.Conn(), d.borderTopRightGC, xproto.Drawable(d.borderTopRight), xproto.GcForeground, []uint32{bgColor})
+
+	return nil
+}
+
+func (d *decoration) decorate(force bool) {
+	depth := d.client.wm.X().Screen().RootDepth
+	refresh := force
+
+	if refresh {
+		d.freePixmaps()
+	}
+	if d.borderTop == 0 {
+		err := d.createPixmaps(depth)
+		if err != nil {
+			fyne.LogError("New Pixmap Error", err)
+			return
+		}
+		refresh = true
+	}
+
+	if refresh || d.canvas == nil {
+		d.drawDecoration(d.borderTop, d.borderTopGC, d.borderTopRight, d.borderTopRightGC, depth)
+	}
+
+	w, h := d.frame.size()
+	heightPix := x11.TitleHeight(x11.XWin(d.client))
+	rect := xproto.Rectangle{X: 0, Y: 0, Width: w, Height: h}
+	xproto.PolyFillRectangleChecked(d.client.wm.Conn(), xproto.Drawable(d.client.id), d.rectGC, []xproto.Rectangle{rect})
+
+	rightWidthPix := d.topRightPixelWidth()
+	minWidth := d.canvas.Content().MinSize().Width
+	widthPix := uint16(minWidth*d.canvas.Scale()) - rightWidthPix
+	xproto.CopyArea(d.client.wm.Conn(), xproto.Drawable(d.borderTop), xproto.Drawable(d.client.id), d.borderTopGC,
+		0, 0, 0, 0, widthPix, heightPix)
+	xproto.CopyArea(d.client.wm.Conn(), xproto.Drawable(d.borderTopRight), xproto.Drawable(d.client.id), d.borderTopRightGC,
+		0, 0, int16(w-rightWidthPix), 0, rightWidthPix, heightPix)
+}
+
+func (d *decoration) drawDecoration(pidTop xproto.Pixmap, drawTop xproto.Gcontext, pidTopRight xproto.Pixmap, drawTopRight xproto.Gcontext, depth byte) {
+	screen := fynedesk.Instance().Screens().ScreenForWindow(d.client)
+	scale := screen.CanvasScale()
+
+	canMaximize := true
+	if windowSizeFixed(d.client.wm.X(), d.client.win) ||
+		!windowSizeCanMaximize(d.client.wm.X(), d.client) {
+		canMaximize = false
+	}
+
+	if d.canvas == nil {
+		canvas := playground.NewSoftwareCanvas()
+		canvas.SetPadded(false)
+
+		canvas.SetContent(wm.NewBorder(d.client, d.client.Properties().Icon(), canMaximize))
+		d.canvas = canvas
+	} else {
+		b := d.canvas.Content().(*wm.Border)
+		b.SetTitle(d.client.props.Title())
+		b.SetMaximized(d.client.maximized)
+		b.SetIcon(d.client.Properties().Icon())
+		b.Refresh()
+	}
+	d.canvas.SetScale(scale)
+
+	heightPix := x11.TitleHeight(x11.XWin(d.client))
+	rightWidthPix := d.topRightPixelWidth()
+	minWidth := d.canvas.Content().MinSize().Width
+	winPixWidth := d.borderTopWidth + rightWidthPix
+	d.canvas.Resize(fyne.NewSize(float32(winPixWidth)/scale, wmTheme.TitleHeight))
+	widthPix := uint16(minWidth*d.canvas.Scale()) - rightWidthPix
+	img := d.canvas.Capture()
+
+	// Draw in pixel rows so we don't overflow count usable by PutImageChecked
+	for i := uint16(0); i < heightPix; i++ {
+		d.copyDecorationPixels(uint32(widthPix), 1, 0, uint32(i), img, pidTop, drawTop, depth)
+	}
+	d.copyDecorationPixels(uint32(rightWidthPix), uint32(heightPix), uint32(winPixWidth-rightWidthPix), 0, img, pidTopRight, drawTopRight, depth)
+}
+
+func (d *decoration) freePixmaps() {
+	if d.borderTop != 0 {
+		xproto.FreePixmap(d.client.wm.Conn(), d.borderTop)
+		d.borderTop = 0
+	}
+	if d.borderTopRight != 0 {
+		xproto.FreePixmap(d.client.wm.Conn(), d.borderTopRight)
+		d.borderTopRight = 0
+	}
+
+	if d.rectGC != 0 {
+		xproto.FreeGC(d.client.wm.Conn(), d.rectGC)
+		d.rectGC = 0
+	}
+	if d.borderTopGC != 0 {
+		xproto.FreeGC(d.client.wm.Conn(), d.borderTopGC)
+		d.borderTopGC = 0
+	}
+	if d.borderTopRightGC != 0 {
+		xproto.FreeGC(d.client.wm.Conn(), d.borderTopRightGC)
+		d.borderTopRightGC = 0
+	}
+}
+
+func (d *decoration) topRightPixelWidth() uint16 {
+	screen := fynedesk.Instance().Screens().ScreenForWindow(d.client)
+	scale := screen.CanvasScale()
+
+	iconPix := x11.ButtonWidth(x11.XWin(d.client))
+	iconAndBorderPix := iconPix + x11.BorderWidth(x11.XWin(d.client))*2 + uint16(theme.Padding()*scale)
+	if fynedesk.Instance().Settings().BorderButtonPosition() == "Right" {
+		iconAndBorderPix = 3*iconAndBorderPix - uint16(theme.Padding()*scale)
+	}
+
+	return iconAndBorderPix - uint16(theme.Padding()*scale)
+}
+
+func (d *decoration) invalidateCanvas() {
+	d.canvas = nil
+}
+
+func (d *decoration) findObjectAt(x, y int, matches func(fyne.CanvasObject) bool) fyne.CanvasObject {
+	if d.canvas == nil {
+		return nil
+	}
+	return wm.FindObjectAtPixelPositionMatching(x, y, d.canvas, matches)
+}
