+func TestClassifyPress_TitleBarCenter_DoesNotQueryCanResize(t *testing.T) {
+	width := uint16(200)
+	height := uint16(150)
+	titleHeight := uint16(30)
+	borderWidth := uint16(5)
+	buttonWidth := uint16(10)
+
+	t.Run("title bar center does not query canResize", func(t *testing.T) {
+		queried := false
+		canResize := func() bool {
+			queried = true
+			return true
+		}
+
+		moveOnly, top, bottom, left, right := classifyPress(
+			100, 15, width, height, titleHeight, borderWidth, buttonWidth, canResize,
+		)
+		assert.True(t, moveOnly)
+		assert.False(t, top)
+		assert.False(t, bottom)
+		assert.False(t, left)
+		assert.False(t, right)
+		assert.False(t, queried, "canResize must not be queried for title bar center")
+	})
+
+	t.Run("outside title bar center queries canResize", func(t *testing.T) {
+		queried := false
+		canResize := func() bool {
+			queried = true
+			return true
+		}
+
+		classifyPress(
+			2, 10, width, height, titleHeight, borderWidth, buttonWidth, canResize,
+		)
+		assert.True(t, queried, "canResize must be queried when outside title bar center")
+	})
+}
