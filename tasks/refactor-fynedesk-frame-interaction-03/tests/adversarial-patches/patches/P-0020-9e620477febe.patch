diff --git a/internal/x11/win/interaction.go b/internal/x11/win/interaction.go
new file mode 100644
index 0000000000000000000000000000000000000000..54f5d00213ebe0f5633174b5429d1f67381a07f1
--- /dev/null
+++ b/internal/x11/win/interaction.go
@@ -0,0 +1,355 @@
+//go:build linux || openbsd || freebsd || netbsd
+// +build linux openbsd freebsd netbsd
+
+package win
+
+import (
+	"context"
+	"math"
+	"time"
+
+	"fyne.io/fyne/v2"
+	"fyne.io/fyne/v2/driver/desktop"
+
+	"github.com/BurntSushi/xgb/xproto"
+
+	"fyshos.com/fynedesk"
+	"fyshos.com/fynedesk/internal/x11"
+	"fyshos.com/fynedesk/wm"
+)
+
+const unmaximizeThreshold = 84
+
+type interaction struct {
+	client *client
+	frame  *frame
+
+	mouseX, mouseY                      int16
+	moveX, moveY                        int16
+	resizeStartX, resizeStartY          int16
+	resizeStartWidth, resizeStartHeight uint16
+	resizeBottom, resizeTop             bool
+	resizeLeft, resizeRight             bool
+	moveOnly, ignoreDrag                bool
+
+	hovered    desktop.Hoverable
+	clickCount int
+	cancelFunc context.CancelFunc
+}
+
+func newInteraction(c *client, f *frame) *interaction {
+	return &interaction{
+		client: c,
+		frame:  f,
+	}
+}
+
+func classifyPress(relX, relY int16, width, height, titleHeight, borderWidth, buttonWidth uint16, canResize func() bool) (moveOnly, top, bottom, left, right bool) {
+	if relY < int16(titleHeight) && relX >= int16(borderWidth) && relX < int16(width-borderWidth) {
+		moveOnly = true
+	} else if canResize != nil && canResize() {
+		if relY < int16(titleHeight) {
+			if relX < int16(borderWidth) {
+				left = true
+				top = true
+			} else if relX >= int16(width-borderWidth) {
+				right = true
+				top = true
+			}
+		} else {
+			if relY >= int16(height-buttonWidth) {
+				bottom = true
+			}
+			if relX < int16(buttonWidth) {
+				left = true
+			} else if relX >= int16(width-buttonWidth) {
+				right = true
+			}
+		}
+	}
+	return
+}
+
+func shouldUnmaximize(y, frameY int16, titleHeight uint16, moveDeltaY int16, scale float32) bool {
+	outsideBar := y > frameY+int16(titleHeight) || y < frameY
+	threshold := uint16(math.Ceil(float64(unmaximizeThreshold) * float64(scale)))
+	return outsideBar && uint16(math.Abs(float64(moveDeltaY))) > threshold
+}
+
+func calculateRestoreCoordinates(mouseX, mouseY, frameX int16, frameWidth, restoreWidth uint16) (int16, int16) {
+	diff := mouseX - frameX
+	scale := float64(restoreWidth) / float64(frameWidth)
+	restoreX := mouseX - int16(math.Ceil(float64(diff)*scale))
+	restoreY := mouseY
+	return restoreX, restoreY
+}
+
+func decideResizeCursor(x, y int16, width, height, titleHeight, edgeSize, cornerSize uint16) xproto.Cursor {
+	if y < int16(titleHeight) { // top left or right
+		if x < int16(edgeSize) {
+			return x11.ResizeTopLeftCursor
+		} else if x >= int16(width-edgeSize) {
+			return x11.ResizeTopRightCursor
+		}
+	} else if y >= int16(height-cornerSize) { // bottom
+		if x < int16(cornerSize) {
+			return x11.ResizeBottomLeftCursor
+		} else if x >= int16(width-cornerSize) {
+			return x11.ResizeBottomRightCursor
+		} else {
+			return x11.ResizeBottomCursor
+		}
+	} else { // center (sides)
+		if x < int16(cornerSize) {
+			return x11.ResizeLeftCursor
+		} else if x >= int16(width-cornerSize) {
+			return x11.ResizeRightCursor
+		}
+	}
+
+	return x11.DefaultCursor
+}
+
+func (i *interaction) lookupResizeCursor(x, y int16) xproto.Cursor {
+	cornerSize := x11.ButtonWidth(x11.XWin(i.client))
+	edgeSize := x11.BorderWidth(x11.XWin(i.client))
+	titleHeight := x11.TitleHeight(x11.XWin(i.client))
+	w, h := i.frame.size()
+
+	return decideResizeCursor(x, y, w, h, titleHeight, edgeSize, cornerSize)
+}
+
+func (i *interaction) mouseDrag(x, y int16) {
+	if i.client.Fullscreened() || i.ignoreDrag {
+		return
+	}
+	moveDeltaX := x - i.mouseX
+	moveDeltaY := y - i.mouseY
+	if moveDeltaX == 0 && moveDeltaY == 0 {
+		return
+	}
+
+	frameX, frameY := i.frame.pos()
+	frameWidth, frameHeight := i.frame.size()
+
+	if i.client.Maximized() {
+		screen := fynedesk.Instance().Screens().ScreenForWindow(i.client)
+		scale := screen.CanvasScale()
+		titleHeight := uint16(x11.TitleHeight(x11.XWin(i.client)))
+
+		if shouldUnmaximize(y, frameY, titleHeight, moveDeltaY, scale) {
+			restoreX, restoreY := calculateRestoreCoordinates(i.mouseX, i.mouseY, frameX, frameWidth, i.client.restoreWidth)
+
+			i.client.restoreX = restoreX
+			i.client.restoreY = restoreY
+
+			i.moveX = i.client.restoreX
+			i.moveY = i.client.restoreY
+			i.client.Unmaximize()
+		}
+		return
+	}
+
+	i.mouseX = x
+	i.mouseY = y
+
+	if i.moveOnly {
+		i.moveX += moveDeltaX
+		i.moveY += moveDeltaY
+		i.frame.queueGeometry(i.moveX, i.moveY, frameWidth, frameHeight, false)
+	}
+	if i.resizeTop || i.resizeBottom || i.resizeLeft || i.resizeRight && !windowSizeFixed(i.client.wm.X(), i.client.win) {
+		deltaX := x - i.resizeStartX
+		deltaY := y - i.resizeStartY
+		width := int16(i.resizeStartWidth)
+		height := int16(i.resizeStartHeight)
+		if i.resizeTop {
+			i.moveY += moveDeltaY
+			height -= deltaY
+		} else if i.resizeBottom {
+			height += deltaY
+		}
+		if i.resizeLeft {
+			i.moveX += moveDeltaX
+			width -= deltaX
+		} else if i.resizeRight {
+			width += deltaX
+		}
+
+		// avoid uint underflow
+		if width < 0 {
+			width = 0
+		}
+		if height < 0 {
+			height = 0
+		}
+		i.frame.queueGeometry(i.moveX, i.moveY, uint16(width), uint16(height), false)
+	}
+}
+
+func (i *interaction) mouseMotion(x, y int16) {
+	frameX, frameY := i.frame.pos()
+	relX := x - frameX
+	relY := y - frameY
+
+	refresh := false
+	obj := i.frame.findMatchingObject(int(relX), int(relY),
+		func(obj fyne.CanvasObject) bool {
+			_, ok := obj.(desktop.Cursorable)
+			if ok {
+				return true
+			}
+
+			_, ok = obj.(desktop.Hoverable)
+			return ok
+		},
+	)
+
+	cursor := x11.DefaultCursor
+	if obj != nil {
+		if cur, ok := obj.(desktop.Cursorable); ok {
+			if cur.Cursor() == wm.CloseCursor {
+				cursor = x11.CloseCursor
+			}
+		}
+		if hov, ok := obj.(desktop.Hoverable); ok {
+			if i.hovered == nil {
+				hov.MouseIn(&desktop.MouseEvent{})
+				i.hovered = hov
+				refresh = true
+			} else if obj.(desktop.Hoverable) != i.hovered {
+				i.hovered.MouseOut()
+				hov.MouseIn(&desktop.MouseEvent{})
+				i.hovered = hov
+				refresh = true
+			} else {
+				hov.MouseMoved(&desktop.MouseEvent{})
+			}
+		}
+	} else if !i.client.Maximized() && !i.client.Fullscreened() && !windowSizeFixed(i.client.wm.X(), i.client.win) {
+		cursor = i.lookupResizeCursor(relX, relY)
+	}
+
+	if obj == nil && i.hovered != nil {
+		i.hovered.MouseOut()
+		i.hovered = nil
+		refresh = true
+	}
+	if refresh {
+		i.frame.applyTheme(true)
+	}
+	xproto.ChangeWindowAttributes(i.client.wm.Conn(), i.client.id, xproto.CwCursor,
+		[]uint32{uint32(cursor)})
+}
+
+func (i *interaction) mousePress(x, y int16, b xproto.Button) {
+	if b != xproto.ButtonIndex1 {
+		return
+	}
+	if !i.client.Focused() {
+		i.client.RaiseToTop()
+		i.client.Focus()
+		return
+	}
+	if i.client.Fullscreened() {
+		return
+	}
+
+	frameX, frameY := i.frame.pos()
+	relX := x - frameX
+	relY := y - frameY
+	obj := i.frame.findMatchingObject(int(relX), int(relY),
+		func(obj fyne.CanvasObject) bool {
+			_, ok := obj.(fyne.Tappable)
+			return ok
+		},
+	)
+	if obj != nil {
+		i.ignoreDrag = false
+		return
+	}
+
+	buttonWidth := x11.ButtonWidth(x11.XWin(i.client))
+	borderWidth := x11.BorderWidth(x11.XWin(i.client))
+	titleHeight := x11.TitleHeight(x11.XWin(i.client))
+	width, height := i.frame.size()
+
+	i.mouseX = x
+	i.mouseY = y
+	i.resizeStartX = x
+	i.resizeStartY = y
+	i.moveX = frameX
+	i.moveY = frameY
+	i.resizeStartWidth = width
+	i.resizeStartHeight = height
+	i.resizeBottom = false
+	i.resizeLeft = false
+	i.resizeRight = false
+	i.resizeTop = false
+	i.moveOnly = false
+
+	canResize := func() bool {
+		return !windowSizeFixed(i.client.wm.X(), i.client.win) && !i.client.Maximized()
+	}
+
+	i.moveOnly, i.resizeTop, i.resizeBottom, i.resizeLeft, i.resizeRight = classifyPress(
+		relX, relY, width, height, titleHeight, borderWidth, buttonWidth, canResize,
+	)
+
+	i.client.wm.RaiseToTop(i.client)
+}
+
+func (i *interaction) mouseRelease(x, y int16, b xproto.Button) {
+	i.ignoreDrag = false
+	if b != xproto.ButtonIndex1 {
+		return
+	}
+	titleHeight := x11.TitleHeight(x11.XWin(i.client))
+
+	frameX, frameY := i.frame.pos()
+	relX := x - frameX
+	relY := y - frameY
+	barYMax := int16(titleHeight)
+	if relY > barYMax {
+		return
+	}
+	i.clickCount++
+
+	if i.cancelFunc != nil {
+		i.cancelFunc()
+		return
+	}
+	go i.mouseReleaseWaitForDoubleClick(int(relX), int(relY))
+}
+
+func (i *interaction) mouseReleaseWaitForDoubleClick(relX int, relY int) {
+	var ctx context.Context
+	ctx, i.cancelFunc = context.WithDeadline(context.TODO(), time.Now().Add(time.Millisecond*300))
+	defer i.cancelFunc()
+
+	<-ctx.Done()
+	if i.clickCount == 2 {
+		obj := i.frame.findMatchingObject(relX, relY,
+			func(obj fyne.CanvasObject) bool {
+				_, ok := obj.(fyne.DoubleTappable)
+				return ok
+			},
+		)
+		if obj != nil {
+			obj.(fyne.DoubleTappable).DoubleTapped(&fyne.PointEvent{})
+		}
+	} else {
+		obj := i.frame.findMatchingObject(relX, relY,
+			func(obj fyne.CanvasObject) bool {
+				_, ok := obj.(fyne.Tappable)
+				return ok
+			},
+		)
+		if obj != nil {
+			obj.(fyne.Tappable).Tapped(&fyne.PointEvent{})
+		}
+	}
+
+	i.clickCount = 0
+	i.cancelFunc = nil
+}
