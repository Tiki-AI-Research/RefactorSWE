+func TestClassifyPress_TitleBarCenter_MoveOnly(t *testing.T) {
+	width := uint16(200)
+	height := uint16(150)
+	titleHeight := uint16(30)
+	borderWidth := uint16(5)
+	buttonWidth := uint16(10)
+
+	alwaysCanResize := func() bool { return true }
+
+	tests := []struct {
+		name         string
+		relX         int16
+		relY         int16
+		wantMoveOnly bool
+		wantTop      bool
+		wantBottom   bool
+		wantLeft     bool
+		wantRight    bool
+	}{
+		{
+			name:         "center of title bar",
+			relX:         100,
+			relY:         15,
+			wantMoveOnly: true,
+		},
+		{
+			name:         "left boundary of center title bar (relX == borderWidth)",
+			relX:         int16(borderWidth),
+			relY:         15,
+			wantMoveOnly: true,
+		},
+		{
+			name:         "right boundary of center title bar (relX == width - borderWidth - 1)",
+			relX:         int16(width - borderWidth - 1),
+			relY:         15,
+			wantMoveOnly: true,
+		},
+		{
+			name:         "relX == width - borderWidth switches to top right resize",
+			relX:         int16(width - borderWidth),
+			relY:         15,
+			wantMoveOnly: false,
+			wantTop:      true,
+			wantRight:    true,
+		},
+		{
+			name:         "bottom boundary of title bar (relY == titleHeight - 1)",
+			relX:         100,
+			relY:         int16(titleHeight - 1),
+			wantMoveOnly: true,
+		},
+		{
+			name:         "relY == titleHeight enters window body",
+			relX:         100,
+			relY:         int16(titleHeight),
+			wantMoveOnly: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			moveOnly, top, bottom, left, right := classifyPress(
+				tt.relX, tt.relY, width, height, titleHeight, borderWidth, buttonWidth, alwaysCanResize,
+			)
+			assert.Equal(t, tt.wantMoveOnly, moveOnly, "moveOnly mismatch")
+			assert.Equal(t, tt.wantTop, top, "top mismatch")
+			assert.Equal(t, tt.wantBottom, bottom, "bottom mismatch")
+			assert.Equal(t, tt.wantLeft, left, "left mismatch")
+			assert.Equal(t, tt.wantRight, right, "right mismatch")
+		})
+	}
+}
