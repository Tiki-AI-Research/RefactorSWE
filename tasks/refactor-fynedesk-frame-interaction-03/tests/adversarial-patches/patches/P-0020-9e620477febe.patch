+			scale:      1.0,
+			moveDeltaY: 84,
+			want:       false,
+		},
+		{
+			name:       "scale=1 threshold 84 unmaximized (delta=85)",
+			scale:      1.0,
+			moveDeltaY: 85,
+			want:       true,
+		},
+		{
+			name:       "scale=1 negative delta not unmaximized (delta=-84)",
+			scale:      1.0,
+			moveDeltaY: -84,
+			want:       false,
+		},
+		{
+			name:       "scale=1 negative delta unmaximized (delta=-85)",
+			scale:      1.0,
+			moveDeltaY: -85,
+			want:       true,
+		},
+		{
+			name:       "scale=2 threshold 168 not unmaximized (delta=168)",
+			scale:      2.0,
+			moveDeltaY: 168,
+			want:       false,
+		},
+		{
+			name:       "scale=2 threshold 168 unmaximized (delta=169)",
+			scale:      2.0,
+			moveDeltaY: 169,
+			want:       true,
+		},
+		{
+			name:       "scale=2 negative delta not unmaximized (delta=-168)",
+			scale:      2.0,
+			moveDeltaY: -168,
+			want:       false,
+		},
+		{
+			name:       "scale=2 negative delta unmaximized (delta=-169)",
+			scale:      2.0,
+			moveDeltaY: -169,
+			want:       true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := shouldUnmaximize(outsideY, frameY, titleHeight, tt.moveDeltaY, tt.scale)
+			assert.Equal(t, tt.want, got)
