+// Bound local interfaces are inferred from production assignments, literals,
+// and parameter binding. A merely declared implementation is not evidence.
+func (pkg *f2pR3Package) productionFuncs() []*f2pR3Func {
+	var out []*f2pR3Func
+	for _, fs := range pkg.funcs {
+		for _, f := range fs {
+			if !f.isTest && f.decl.Body != nil {
+				out = append(out, f)
+			}
+		}
+	}
+	for _, fs := range pkg.methods {
+		for _, f := range fs {
+			if !f.isTest && f.decl.Body != nil {
+				out = append(out, f)
+			}
+		}
+	}
+	return out
+}
+func (pkg *f2pR3Package) boundType(name string) string {
+	choices := pkg.interfaceBindings[name]
+	if len(choices) > 1 && pkg.uncertainInterfaces != nil {
+		pkg.uncertainInterfaces[name] = true
+	}
+	if len(choices) != 1 {
+		return ""
+	}
+	for n := range choices {
+		return n
+	}
+	return ""
+}
+func (pkg *f2pR3Package) inferInterfaceBindings() {
+	pkg.interfaceBindings = map[string]map[string]bool{}
+	bind := func(iface, concrete string) {
+		if t := pkg.types[iface]; t == nil || !t.isIface {
+			return
+		}
+		if t := pkg.types[concrete]; t == nil || !t.isStruct || strings.HasSuffix(t.file, "_test.go") {
+			return
+		}
+		if pkg.interfaceBindings[iface] == nil {
+			pkg.interfaceBindings[iface] = map[string]bool{}
+		}
+		pkg.interfaceBindings[iface][concrete] = true
+	}
+	for pass := 0; pass < 4; pass++ {
+		for _, fi := range pkg.productionFuncs() {
+			env := f2pR3EnvFor(pkg, fi)
+			ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+				switch a := n.(type) {
+				case *ast.AssignStmt:
+					for i, lhs := range a.Lhs {
+						if i >= len(a.Rhs) {
+							break
+						}
+						left, _ := env.exprType(lhs)
+						right, _ := env.exprType(a.Rhs[i])
+						bind(left, right)
+					}
+				case *ast.CompositeLit:
+					typ, _ := env.exprType(a)
+					info := pkg.types[typ]
+					if info == nil {
+						return true
+					}
+					for _, elt := range a.Elts {
+						kv, ok := elt.(*ast.KeyValueExpr)
+						if !ok {
+							continue
+						}
+						key, ok := kv.Key.(*ast.Ident)
+						if !ok {
+							continue
+						}
+						rhs, _ := env.exprType(kv.Value)
+						bind(f2pR3ExprBaseName(info.fields[key.Name]), rhs)
+					}
+				case *ast.CallExpr:
+					target := pkg.resolveCallee(env, a)
+					if target == nil || target.decl.Type.Params == nil {
+						return true
+					}
+					index := 0
+					for _, param := range target.decl.Type.Params.List {
+						for range param.Names {
+							if index < len(a.Args) {
+								rhs, _ := env.exprType(a.Args[index])
+								bind(f2pR3ExprBaseName(param.Type), rhs)
+							}
+							index++
+						}
+					}
+				}
+				return true
+			})
+		}
+	}
+}
+
+// Only owned local data is traversed. References back to geometry/lifecycle and
+// interface services do not turn those services into owned interaction state.
+func (pkg *f2pR3Package) ownedTypes(root string) map[string]bool {
+	out := map[string]bool{}
+	var walk func(string)
+	walk = func(name string) {
+		if out[name] || name == "frame" && name != root || name == "client" {
+			return
+		}
+		info := pkg.types[name]
+		if info == nil || !info.isStruct {
+			return
+		}
+		out[name] = true
+		for _, field := range info.fields {
+			walk(f2pR3ExprBaseName(field))
+		}
+	}
+	walk(root)
+	return out
+}
+func (pkg *f2pR3Package) lookupField(typ, name string, seen map[string]bool) (string, ast.Expr) {
+	if seen[typ] {
+		return "", nil
+	}
+	seen[typ] = true
+	info := pkg.types[typ]
+	if info == nil {
+		return "", nil
+	}
+	if f := info.fields[name]; f != nil {
+		return typ, f
+	}
+	for key, f := range info.fields {
+		embedded := f2pR3ExprBaseName(f)
+		if key == embedded {
+			if owner, field := pkg.lookupField(embedded, name, seen); field != nil {
+				return owner, field
+			}
+		}
+	}
+	return "", nil
+}
+func (pkg *f2pR3Package) inferAdditionalRoles() {
+	set := func(typ, field, role string) {
+		if typ == "" || role == "" {
+			return
+		}
+		if pkg.originRoles[typ] == nil {
+			pkg.originRoles[typ] = map[string]string{}
+		}
+		pkg.originRoles[typ][field] = role
+	}
+	field := func(env *f2pR3Env, e ast.Expr) (string, string) {
+		s, ok := e.(*ast.SelectorExpr)
+		if !ok {
+			return "", ""
+		}
+		typ, _ := env.exprType(s.X)
+		decl, _ := pkg.lookupField(typ, s.Sel.Name, map[string]bool{})
+		return decl, s.Sel.Name
+	}
+	for typ, info := range pkg.types {
+		if !info.isStruct {
+			continue
+		}
+		for name, e := range info.fields {
+			path, kind := f2pR3QualifiedType(pkg, info.file, e)
+			if path == "context" && kind == "CancelFunc" {
+				set(typ, name, "cancelFunc")
+			}
+			if strings.HasSuffix(path, "/desktop") && kind == "Hoverable" {
+				set(typ, name, "hovered")
+			}
+		}
+	}
+	deltas := map[*f2pR3Func]map[string]int{}
+	drag := pkg.f2pR3ClientMethod("NotifyMouseDrag")
+	if drag == nil {
+		return
+	}
+	closure := pkg.f2pR3Reachable(drag)
+	for pass := 0; pass < 5; pass++ {
+		for _, fi := range closure {
+			if fi.isTest || fi.decl.Body == nil {
+				continue
+			}
+			env := f2pR3EnvFor(pkg, fi)
+			if deltas[fi] == nil {
+				deltas[fi] = map[string]int{}
+			}
+			axis := func(e ast.Expr) int {
+				if id, ok := e.(*ast.Ident); ok {
+					return deltas[fi][id.Name]
+				}
+				if b, ok := e.(*ast.BinaryExpr); ok && b.Op == token.SUB {
+					typ, n := field(env, b.Y)
+					switch pkg.stateRole(typ, n) {
+					case "mouseX":
+						return 1
+					case "mouseY":
+						return 2
+					}
+				}
+				return 0
+			}
+			ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+				switch a := n.(type) {
+				case *ast.AssignStmt:
+					for i, lhs := range a.Lhs {
+						if i >= len(a.Rhs) {
+							break
+						}
+						rhs := a.Rhs[i]
+						ax := axis(rhs)
+						if id, ok := lhs.(*ast.Ident); ok && ax != 0 {
+							deltas[fi][id.Name] = ax
+						}
+						typ, f := field(env, lhs)
+						if a.Tok == token.ADD_ASSIGN && ax != 0 {
+							set(typ, f, []string{"", "moveX", "moveY"}[ax])
+						}
+					}
+				case *ast.CallExpr:
+					child := pkg.resolveCallee(env, a)
+					if child == nil || child.isTest {
+						break
+					}
+					params := f2pR3ParamNames(child)
+					if deltas[child] == nil {
+						deltas[child] = map[string]int{}
+					}
+					for i, arg := range a.Args {
+						if i < len(params) {
+							if ax := axis(arg); ax != 0 {
+								deltas[child][params[i]] = ax
+							}
+						}
+					}
+				}
+				return true
+			})
+		}
+	}
+	// Transfer roles through explicit copies of decision fields, regardless of
+	// the helper's private result-field spelling.
+	for pass := 0; pass < 3; pass++ {
+		for _, fi := range pkg.productionFuncs() {
+			env := f2pR3EnvFor(pkg, fi)
+			ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+				a, ok := n.(*ast.AssignStmt)
+				if !ok {
+					return true
+				}
+				for i, lhs := range a.Lhs {
+					if i >= len(a.Rhs) {
+						break
+					}
+					lt, lf := field(env, lhs)
+					rt, rf := field(env, a.Rhs[i])
+					if lt != "" && rt != "" {
+						role := pkg.stateRole(lt, lf)
+						if role == "moveOnly" || role == "ignoreDrag" || role == "resizeTop" || role == "resizeBottom" || role == "resizeLeft" || role == "resizeRight" {
+							set(rt, rf, role)
+						}
+					}
+				}
+				return true
+			})
+		}
+	}
+}
+func (pkg *f2pR3Package) decisionResultFlowsToState(result, owner string, roles map[string]bool) bool {
+	if pkg.ownedTypes(owner)[result] {
+		return true
+	}
+	for _, fi := range pkg.f2pR3Reachable(pkg.f2pR3ClientMethod("NotifyMousePress")) {
+		if fi.isTest {
+			continue
+		}
+		env := f2pR3EnvFor(pkg, fi)
+		found := false
+		ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+			a, ok := n.(*ast.AssignStmt)
+			if !ok {
+				return true
+			}
+			for i, lhs := range a.Lhs {
+				if i >= len(a.Rhs) {
+					break
+				}
+				l, ok := lhs.(*ast.SelectorExpr)
+				if !ok {
+					continue
+				}
+				lt, _ := env.exprType(l.X)
+				decl, _ := pkg.lookupField(lt, l.Sel.Name, map[string]bool{})
+				if !pkg.ownedTypes(owner)[decl] || !roles[pkg.stateRole(decl, l.Sel.Name)] {
+					continue
+				}
+				ast.Inspect(a.Rhs[i], func(n ast.Node) bool {
+					if e, ok := n.(ast.Expr); ok {
+						rt, _ := env.exprType(e)
+						if rt == result {
+							found = true
+						}
+					}
+					return true
+				})
+			}
+			return true
+		})
+		if found {
+			return true
+		}
+	}
+	return false
+}
+
+// Execute the candidate's actual selected unit test in a fresh copy of this
+// already-compiled test binary. No X connection/display is supplied. Only a
+// non-skipped passing test satisfies the deliverable; a syntactic assertion
+// alone is not evidence that the test runs successfully.
+func f2pR3RunPureTest(t *testing.T, fi *f2pR3Func) bool {
+	binary, err := os.Executable()
+	if err != nil {
+		t.Skipf("unsupported executable lookup: %v", err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	name := fi.decl.Name.Name
+	cmd := exec.CommandContext(ctx, binary, "-test.v", "-test.run", "^"+regexp.QuoteMeta(name)+"$")
+	cmd.Env = append(os.Environ(), "DISPLAY=")
+	output, err := cmd.CombinedOutput()
+	if ctx.Err() != nil {
+		t.Skipf("candidate unit-test execution timed out: %s", name)
+	}
+	if err != nil {
+		t.Logf("candidate test %s did not pass: %s", name, output)
+		return false
+	}
+	return strings.Contains(string(output), "--- PASS: "+name+" (")
+}
+
+// A new named Go type may retain another local struct's field layout, and a
+// true type alias denotes that same type. Resolve those declarations before
+// collecting bindings; otherwise additional real implementations disappear.
+func (pkg *f2pR3Package) resolveNamedUnderlyingTypes() {
+	for pass := 0; pass < len(pkg.types); pass++ {
+		changed := false
+		for _, info := range pkg.types {
+			if info.isStruct || info.isIface {
+				continue
+			}
+			id, ok := info.underlying.(*ast.Ident)
+			if !ok {
+				continue
+			}
+			base := pkg.types[id.Name]
+			if base == nil || (!base.isStruct && !base.isIface) {
+				continue
+			}
+			info.isStruct = base.isStruct
+			info.isIface = base.isIface
+			info.fields = base.fields
+			info.iface = base.iface
+			info.file = base.file
+			changed = true
+		}
+		if !changed {
+			return
+		}
+	}
+}
