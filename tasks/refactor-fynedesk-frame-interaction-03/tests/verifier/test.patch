+// Find the canvas by its interface, not by a collaborator or field name.
+// Reflection is restricted to test setup; unsafe only allows access to the
+// package-private fields of this package's compiled frame/collaborators.
+func p2pInteractionCanvas(t *testing.T, f *frame) fyneTest.WindowlessCanvas {
+	t.Helper()
+	seen := map[uintptr]bool{}
+	var walk func(reflect.Value, int) fyneTest.WindowlessCanvas
+	walk = func(v reflect.Value, depth int) fyneTest.WindowlessCanvas {
+		if !v.IsValid() || depth > 5 {
+			return nil
+		}
+		if v.CanAddr() && !v.CanInterface() {
+			v = reflect.NewAt(v.Type(), unsafe.Pointer(v.UnsafeAddr())).Elem()
+		}
+		if v.CanInterface() {
+			if cv, ok := v.Interface().(fyneTest.WindowlessCanvas); ok && cv != nil {
+				return cv
+			}
+		}
+		if v.Kind() == reflect.Interface {
+			if v.IsNil() {
+				return nil
+			}
+			return walk(v.Elem(), depth+1)
+		}
+		if v.Kind() == reflect.Ptr {
+			if v.IsNil() || v.Type() == reflect.TypeOf((*client)(nil)) || seen[v.Pointer()] {
+				return nil
+			}
+			seen[v.Pointer()] = true
+			return walk(v.Elem(), depth+1)
+		}
+		if v.Kind() == reflect.Struct {
+			for n := 0; n < v.NumField(); n++ {
+				if cv := walk(v.Field(n), depth+1); cv != nil {
+					return cv
+				}
+			}
+		}
+		return nil
+	}
+	cv := walk(reflect.ValueOf(f), 0)
+	if cv == nil {
+		t.Fatal("frame's decoration graph has no windowless canvas")
+	}
+	return cv
+}
