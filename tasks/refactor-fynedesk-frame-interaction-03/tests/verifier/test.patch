+// f2pR3CalledSelectorNames returns every selector name used as a call target in
+// a function body.
+func f2pR3CalledSelectorNames(fi *f2pR3Func) []string {
+	var out []string
+	if fi.decl.Body == nil {
+		return out
+	}
+	ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+		call, ok := n.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+			out = append(out, sel.Sel.Name)
+		} else if ident, ok := call.Fun.(*ast.Ident); ok {
+			out = append(out, ident.Name)
+		}
+		return true
+	})
+	return out
+}
