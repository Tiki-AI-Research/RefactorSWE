+// f2pR3RelocatedHandlers verifies the frozen notification method and returns
+// every state-owner method with the frozen handler signature that the
+// notification reaches through real delegated calls. It fails when the frozen
+// entry point or its delegation is missing.
+func f2pR3RelocatedHandlers(t *testing.T, pkg *f2pR3Package, owner string, spec f2pR3NotifySpec) ([]*f2pR3Func, map[string]*f2pR3Func) {
+	t.Helper()
+	notify := pkg.f2pR3ClientMethod(spec.notify)
+	if notify == nil {
+		t.Fatalf("client.%s is missing: the four window-client pointer notifications must remain the entry points (REQ-BEH-T4:C1)", spec.notify)
+	}
+	if !f2pR3SameSignature(pkg, notify, spec.wantSig) {
+		t.Fatalf("client.%s must keep the frozen %v signature and return no value (REQ-BEH-T4:C1), found %v", spec.notify, spec.wantSig, f2pR3Signature(pkg, notify))
+	}
+	params := f2pR3ParamNames(notify)
+	forwarded := false
+	for _, call := range pkg.f2pR3ResolvedCalls(notify) {
+		if call.target == nil || len(call.call.Args) != len(params) {
+			continue
+		}
+		ok := true
+		for i, arg := range call.call.Args {
+			ident, isIdent := arg.(*ast.Ident)
+			if !isIdent || ident.Name != params[i] {
+				ok = false
+				break
+			}
+		}
+		if ok {
+			forwarded = true
+			break
+		}
+	}
+	if !forwarded {
+		t.Fatalf("client.%s does not forward its pointer arguments unchanged to the handling path: the notification routing must preserve argument forwarding (REQ-BEH-T4:C1/B5)", spec.notify)
+	}
+	closure := pkg.f2pR3Reachable(notify)
+	var handlers []*f2pR3Func
+	for _, symbol := range f2pR3SortedSymbols(closure) {
+		fi := closure[symbol]
+		if fi.recvType == owner {
+			handlers = append(handlers, fi)
+		}
+	}
+	if len(handlers) == 0 {
+		t.Fatalf("client.%s never reaches a %s handler with the frozen %v signature: pointer handling must delegate to the collaborator that owns the interaction state (REQ-STRUCT-001, REQ-BEH-T4:C1/B5)", spec.notify, owner, spec.wantSig)
+	}
+	return handlers, closure
+}
+
+func f2pR3AccessAny(fi *f2pR3Func, pkg *f2pR3Package, writes, reads map[string]bool, names ...string) bool {
+	for _, name := range names {
+		if writes[name] || reads[name] {
+			return true
+		}
+	}
+	return false
+}
+
+func f2pR3WriteAny(pkg *f2pR3Package, fi *f2pR3Func, names ...string) bool {
+	owned := pkg.ownedTypes(fi.recvType)
+	closure := pkg.f2pR3Reachable(fi)
+	closure[fi.symbol()] = fi
+	for _, child := range closure {
+		if !owned[child.recvType] {
+			continue
+		}
+		writes, reads := f2pR3Access(pkg, child, f2pR3StateFieldSet())
+		_ = writes
+		_ = reads
+		for _, n := range names {
+			if writes[n] {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func f2pR3ReadAny(pkg *f2pR3Package, fi *f2pR3Func, names ...string) bool {
+	owned := pkg.ownedTypes(fi.recvType)
+	closure := pkg.f2pR3Reachable(fi)
+	closure[fi.symbol()] = fi
+	for _, child := range closure {
+		if !owned[child.recvType] {
+			continue
+		}
+		writes, reads := f2pR3Access(pkg, child, f2pR3StateFieldSet())
+		_ = writes
+		_ = reads
+		for _, n := range names {
+			if reads[n] {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func f2pR3ClosureOwnerReads(pkg *f2pR3Package, owner string, closure map[string]*f2pR3Func, names ...string) bool {
+	stateFields := f2pR3StateFieldSet()
+	for _, fi := range closure {
+		if !pkg.ownedTypes(owner)[fi.recvType] {
+			continue
+		}
+		writes, reads := f2pR3Access(pkg, fi, stateFields)
+		if f2pR3AccessAny(fi, pkg, writes, reads, names...) {
+			return true
+		}
+	}
+	return false
+}
