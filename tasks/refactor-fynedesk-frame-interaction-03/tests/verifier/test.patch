+// f2pR3DragDecisionDecls returns the production declarations on the frozen drag
+// notification path that actually decide the drag geometry: state owner
+// handlers operating the drag state, and pure helpers computing drag geometry.
+func (pkg *f2pR3Package) f2pR3DragDecisionDecls(owner string) map[string]*f2pR3Func {
+	notify := pkg.f2pR3ClientMethod("NotifyMouseDrag")
+	if notify == nil {
+		return nil
+	}
+	decision := f2pR3DecisionFields()
+	stateFields := f2pR3StateFieldSet()
+	out := map[string]*f2pR3Func{}
+	for symbol, fi := range pkg.f2pR3Reachable(notify) {
+		if fi.isTest {
+			continue
+		}
+		if fi.recvType == owner {
+			writes, reads := f2pR3Access(pkg, fi, stateFields)
+			for name := range decision {
+				if writes[name] || reads[name] {
+					out[symbol] = fi
+					break
+				}
+			}
+			continue
+		}
+		if fi.recvType == "" && f2pR3HasResult(fi) {
+			out[symbol] = fi
+		}
+	}
+	return out
+}
