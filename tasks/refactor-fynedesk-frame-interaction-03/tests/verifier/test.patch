+// Command p2p runs the verifier pass-to-pass (P2P) test selection declared by
+// the pipeline and writes a standard JUnit XML report.
+//
+// The selection is read from the materialized pipeline declaration (config /
+// p2p_select). The command surface is intentionally tiny: every selected leaf
+// is executed with `go test -json` in its own package and the native results
+// are converted to JUnit without any third party tooling.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"encoding/xml"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+type selector struct {
+	Path string // repository relative test file path
+	Leaf string // exact test function name
+}
+
+func (s selector) String() string { return s.Path + "::" + s.Leaf }
+
+type testResult struct {
+	Selector selector
+	Action   string // pass, fail, skip, error
+	Output   string
+	Elapsed  float64
+}
+
+const (
+	actionPass  = "pass"
+	actionFail  = "fail"
+	actionSkip  = "skip"
+	actionError = "error"
+)
+
+var modulePath = "fyshos.com/fynedesk"
+
+func main() {
+	root := findRepoRoot()
+	report := ""
+	var selectFile, configFile string
+	for _, a := range os.Args[1:] {
+		if strings.Contains(a, "{") && strings.Contains(a, "}") {
+			continue // unsubstituted pipeline placeholder
+		}
+		switch {
+		case strings.HasSuffix(a, ".json"):
+			if configFile == "" {
+				configFile = a
+			}
+		case strings.HasSuffix(a, ".txt"):
+			if selectFile == "" {
+				selectFile = a
+			}
+		default:
+			if report == "" {
+				report = a
+			}
+		}
+	}
+	if report == "" {
+		for _, env := range []string{"P2P_REPORT", "JUNIT_REPORT", "REPORT", "REPORT_PATH"} {
+			if v := os.Getenv(env); v != "" {
+				report = v
+				break
+			}
+		}
+	}
+	if configFile == "" {
+		configFile = findCandidateFile(root, report, "config.json")
+	}
+	if selectFile == "" {
+		selectFile = findCandidateFile(root, report, "p2p_select.txt")
+	}
+	if selectFile == "" {
+		for _, env := range []string{"P2P_SELECT", "SELECT", "SELECT_PATH"} {
+			if v := os.Getenv(env); v != "" && fileExists(v) {
+				selectFile = v
+				break
+			}
+		}
+	}
+	if report == "" {
+		report = filepath.Join(root, "p2p-junit.xml")
+	}
+	if !filepath.IsAbs(report) {
+		report = filepath.Join(root, report)
+	}
+
+	sels := loadSelectors(configFile, selectFile)
+	if len(sels) == 0 {
+		fmt.Fprintln(os.Stderr, "p2p runner: no selectors declared, nothing to run")
+		os.Exit(3)
+	}
+
+	results := runSelectors(root, sels)
+	if err := writeJUnit(report, results); err != nil {
+		fmt.Fprintln(os.Stderr, "p2p runner: cannot write report:", err)
+		os.Exit(2)
+	}
+	failed := 0
+	for _, r := range results {
+		if r.Action != actionPass && r.Action != actionSkip {
+			failed++
+		}
+	}
+	fmt.Printf("p2p runner: %d selectors, %d not passing, report %s\n", len(results), failed, report)
+	if failed > 0 {
+		os.Exit(1)
+	}
+}
+
+func findRepoRoot() string {
+	dir, err := os.Getwd()
+	if err != nil {
+		return "."
+	}
+	for {
+		if fileExists(filepath.Join(dir, "go.mod")) {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "."
+		}
+		dir = parent
+	}
+}
+
+func fileExists(path string) bool {
+	st, err := os.Stat(path)
+	return err == nil && !st.IsDir()
+}
+
+// findCandidateFile looks for a pipeline materialized declaration file in the
+// usual places: next to the report, the working directory, the repository root
+// and one level above the repository root.
+func findCandidateFile(root, report, name string) string {
+	var dirs []string
+	if report != "" {
+		dirs = append(dirs, filepath.Dir(report), filepath.Dir(filepath.Dir(report)))
+	}
+	if wd, err := os.Getwd(); err == nil {
+		dirs = append(dirs, wd, filepath.Dir(wd))
+	}
+	if exe, err := os.Executable(); err == nil {
+		dirs = append(dirs, filepath.Dir(exe))
+	}
+	if execDir := strings.TrimSpace(os.Getenv("VERIFIER_EXEC_DIR")); execDir != "" {
+		dirs = append(dirs, execDir)
+	}
+	dirs = append(dirs, root, filepath.Dir(root), filepath.Join(root, "verifier"), filepath.Join(root, "evidence"))
+	seen := map[string]bool{}
+	for _, d := range dirs {
+		if d == "" || seen[d] {
+			continue
+		}
+		seen[d] = true
+		candidate := filepath.Join(d, name)
+		if !fileExists(candidate) {
+			continue
+		}
+		if name == "config.json" && !looksLikePlan(candidate) {
+			continue
+		}
+		return candidate
+	}
+	return ""
+}
+
+func looksLikePlan(path string) bool {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return false
+	}
+	return strings.Contains(string(data), "p2p") || strings.Contains(string(data), "selector")
+}
+
+// loadSelectors reads the execution set from the pipeline declarations. The
+// dedicated p2p select list is authoritative and the config declaration is the
+// fallback. The embedded copy of the frozen declaration is always merged in so
+// that every declared selector is executed (the execution report must cover
+// the supplemental P2P selections and the collected original inventory), even
+// when the materialized declaration files cannot be located.
+func loadSelectors(configFile, selectFile string) []selector {
+	var declared []selector
+	if selectFile != "" {
+		declared = selectorsFromList(selectFile)
+	}
+	if len(declared) == 0 && configFile != "" {
+		declared = selectorsFromJSON(configFile)
+	}
+	out := make([]selector, 0, len(declared)+64)
+	for _, s := range embeddedSelectors() {
+		out = appendUnique(out, s)
+	}
+	for _, s := range declared {
+		out = appendUnique(out, s)
+	}
+	return out
+}
+
+func selectorsFromJSON(path string) []selector {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	var doc map[string]interface{}
+	if err := json.Unmarshal(data, &doc); err != nil {
+		return nil
+	}
+	var out []selector
+	var add func(v interface{})
+	add = func(v interface{}) {
+		switch item := v.(type) {
+		case string:
+			if s, ok := parseSelector(item); ok {
+				out = appendUnique(out, s)
+			}
+		case map[string]interface{}:
+			for _, key := range []string{"selector", "test"} {
+				if raw, ok := item[key].(string); ok {
+					if s, ok := parseSelector(raw); ok {
+						out = appendUnique(out, s)
+						return
+					}
+				}
+			}
+		case []interface{}:
+			for _, e := range item {
+				add(e)
+			}
+		}
+	}
+	for _, key := range []string{"p2p", "original_inventory", "selectors", "tests", "test_paths"} {
+		if v, ok := doc[key]; ok {
+			add(v)
+		}
+	}
+	return out
+}
+
+func selectorsFromList(path string) []selector {
+	file, err := os.Open(path)
+	if err != nil {
+		return nil
+	}
+	defer file.Close()
+	var out []selector
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		fields := strings.Fields(line)
+		for _, f := range fields {
+			if s, ok := parseSelector(strings.Trim(f, `",'`)); ok {
+				out = appendUnique(out, s)
+				break
+			}
+		}
+	}
+	return out
+}
+
+func parseSelector(raw string) (selector, bool) {
+	if !strings.Contains(raw, "::") {
+		return selector{}, false
+	}
+	parts := strings.SplitN(raw, "::", 2)
+	path := strings.TrimSpace(parts[0])
+	leaf := strings.TrimSpace(parts[1])
+	if path == "" || leaf == "" || strings.Contains(leaf, "::") {
+		return selector{}, false
+	}
+	return selector{Path: path, Leaf: leaf}, true
+}
+
+func appendUnique(list []selector, s selector) []selector {
+	for _, cur := range list {
+		if cur == s {
+			return list
+		}
+	}
+	return append(list, s)
+}
+
+func runSelectors(root string, sels []selector) []testResult {
+	groups := map[string][]selector{}
+	var order []string
+	for _, s := range sels {
+		pkg := "./" + filepath.ToSlash(filepath.Dir(s.Path))
+		if _, ok := groups[pkg]; !ok {
+			order = append(order, pkg)
+		}
+		groups[pkg] = append(groups[pkg], s)
+	}
+	sort.Strings(order)
+
+	bySelector := map[string]testResult{}
+	for _, pkg := range order {
+		group := groups[pkg]
+		leaves := make([]string, 0, len(group))
+		for _, s := range group {
+			leaves = append(leaves, regexp.QuoteMeta(s.Leaf))
+		}
+		pattern := "^(" + strings.Join(leaves, "|") + ")$"
+		results, output := runPackage(root, pkg, pattern)
+		for _, s := range group {
+			if r, ok := results[s.Leaf]; ok {
+				bySelector[s.String()] = testResult{Selector: s, Action: r.action, Output: r.output, Elapsed: r.elapsed}
+				continue
+			}
+			reason := fmt.Sprintf("test %s was not collected in package %s", s.Leaf, pkg)
+			if strings.TrimSpace(output) != "" {
+				reason += "\n" + firstCause(output)
+			}
+			bySelector[s.String()] = testResult{Selector: s, Action: actionError, Output: reason}
+		}
+	}
+
+	out := make([]testResult, 0, len(sels))
+	for _, s := range sels {
+		if r, ok := bySelector[s.String()]; ok {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+type leafResult struct {
+	action  string
+	output  string
+	elapsed float64
+}
+
+func runPackage(root, pkg, pattern string) (map[string]leafResult, string) {
+	cmd := exec.Command("go", "test", "-json", "-count=1", "-run", pattern, pkg)
+	cmd.Dir = root
+	env := os.Environ()
+	// The pipeline provides an executable directory when the plan declares
+	// require_exec; compile and execute the per-package test binaries there so
+	// a noexec temporary mount cannot block the real run.
+	if execDir := strings.TrimSpace(os.Getenv("VERIFIER_EXEC_DIR")); execDir != "" {
+		env = append(env, "GOTMPDIR="+execDir, "TMPDIR="+execDir)
+	}
+	cmd.Env = append(env, "GOFLAGS=-mod=mod", "GOPROXY=off")
+	done := make(chan struct{})
+	var data []byte
+	var err error
+	go func() {
+		data, err = cmd.CombinedOutput()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(8 * time.Minute):
+		if cmd.Process != nil {
+			_ = cmd.Process.Kill()
+		}
+		<-done
+		return map[string]leafResult{}, fmt.Sprintf("timeout running go test %s %s", pkg, pattern)
+	}
+
+	results := map[string]leafResult{}
+	var packageOutput strings.Builder
+	dec := json.NewDecoder(strings.NewReader(string(data)))
+	for {
+		var event struct {
+			Action  string  `json:"Action"`
+			Package string  `json:"Package"`
+			Test    string  `json:"Test"`
+			Elapsed float64 `json:"Elapsed"`
+			Output  string  `json:"Output"`
+		}
+		if err := dec.Decode(&event); err != nil {
+			break
+		}
+		if event.Test == "" {
+			if event.Action == "output" {
+				packageOutput.WriteString(event.Output)
+			}
+			continue
+		}
+		switch event.Action {
+		case "pass", "fail", "skip":
+			prev := results[event.Test]
+			prev.action = event.Action
+			prev.elapsed = event.Elapsed
+			results[event.Test] = prev
+		case "output":
+			prev := results[event.Test]
+			prev.output += event.Output
+			results[event.Test] = prev
+		}
+	}
+	output := packageOutput.String()
+	if err != nil && len(results) == 0 {
+		output += "\n" + string(data)
+	}
+	return results, output
+}
+
+func firstCause(output string) string {
+	lines := strings.Split(output, "\n")
+	for _, line := range lines {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		if strings.HasPrefix(line, "#") || strings.Contains(line, ".go:") || strings.Contains(strings.ToLower(line), "error") {
+			return line
+		}
+	}
+	if len(lines) > 0 {
+		return strings.TrimSpace(lines[0])
+	}
+	return ""
+}
+
+type junitTestSuite struct {
+	XMLName  xml.Name        `xml:"testsuite"`
+	Name     string          `xml:"name,attr"`
+	Tests    int             `xml:"tests,attr"`
+	Failures int             `xml:"failures,attr"`
+	Errors   int             `xml:"errors,attr"`
+	Skipped  int             `xml:"skipped,attr"`
+	Time     string          `xml:"time,attr"`
+	Cases    []junitTestCase `xml:"testcase"`
+}
+
+type junitTestCase struct {
+	Name      string        `xml:"name,attr"`
+	Classname string        `xml:"classname,attr"`
+	Time      string        `xml:"time,attr"`
+	Failure   *junitMessage `xml:"failure,omitempty"`
+	Error     *junitMessage `xml:"error,omitempty"`
+	Skipped   *junitMessage `xml:"skipped,omitempty"`
+	Output    string        `xml:"system-out,omitempty"`
+}
+
+type junitMessage struct {
+	Type    string `xml:"type,attr,omitempty"`
+	Message string `xml:"message,attr"`
