+// f2pR3AssertionCount counts real assertion calls: testify assert/require
+// helpers and *testing.T failure methods.
+func f2pR3AssertionCount(pkg *f2pR3Package, fi *f2pR3Func) int {
+	seen := map[*f2pR3Func]bool{}
+	var count func(*f2pR3Func) int
+	count = func(f *f2pR3Func) int {
+		if f == nil || f.decl.Body == nil || seen[f] {
+			return 0
+		}
+		seen[f] = true
+		defer delete(seen, f)
+		total := 0
+		env := f2pR3EnvFor(pkg, f)
+		testingVars := map[string]bool{}
+		if f.decl.Type.Params != nil {
+			for _, p := range f.decl.Type.Params.List {
+				path, typ := f2pR3QualifiedType(pkg, f.file, p.Type)
+				if path == "testing" && typ == "T" {
+					for _, n := range p.Names {
+						testingVars[n.Name] = true
+					}
+				}
+			}
+		}
+		ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+			call, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+				if base, ok := sel.X.(*ast.Ident); ok {
+					path := pkg.imports[f.file][base.Name]
+					if strings.Contains(path, "testify/assert") || strings.Contains(path, "testify/require") {
+						total++
+						return true
+					}
+					switch sel.Sel.Name {
+					case "Fatalf", "Errorf", "Fatal", "Error", "FailNow":
+						if testingVars[base.Name] {
+							total++
+							return true
+						}
+					}
+				}
+			}
+			child := pkg.resolveCallee(env, call)
+			if child != nil && child.isTest {
+				total += count(child)
+			}
+			return true
+		})
+		return total
+	}
+	return count(fi)
+}
