+func (pkg *f2pR3Package) f2pR3ResolvedCalls(fi *f2pR3Func) []f2pR3Call {
+	var out []f2pR3Call
+	if fi.decl.Body == nil {
+		return out
+	}
+	env := f2pR3EnvFor(pkg, fi)
+	ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+		call, ok := n.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		out = append(out, f2pR3Call{call: call, target: pkg.resolveCallee(env, call)})
+		return true
+	})
+	return out
+}
