+const f2pR3OwnTestFile = "f2p_frame_responsibilities_test.go"
+
+var f2pR3FrozenTestFiles = map[string]bool{
+	"p2p_frame_test.go":   true,
+	"p2p_xserver_test.go": true,
+}
+
+// f2pR3PureCandidateFiles returns solution test files that need no X connection:
+// the pipeline-frozen P2P files and this file are excluded, and any xgbutil
+// import (the X connection package) disqualifies a file.
+func (pkg *f2pR3Package) f2pR3PureCandidateFiles() []string {
+	var out []string
+	for name := range pkg.imports {
+		if !strings.HasSuffix(name, "_test.go") || f2pR3FrozenTestFiles[name] || name == f2pR3OwnTestFile {
+			continue
+		}
+		if pkg.f2pR3FileCallsXgbutil(name) {
+			continue
+		}
+		out = append(out, name)
+	}
+	sort.Strings(out)
+	return out
+}
+
+
+// f2pR3FileCallsXgbutil reports whether a test file calls into an xgbutil
+// package or opens an X connection. Merely naming an xgbutil type (for
+// example a nil-returning X() *xgbutil.XUtil stub that a fake window manager
+// needs to satisfy x11.XWM) does not make a test need an X connection; the
+// candidate test is additionally executed with DISPLAY unset.
+func (pkg *f2pR3Package) f2pR3FileCallsXgbutil(name string) bool {
+	file, err := parser.ParseFile(token.NewFileSet(), filepath.Join(pkg.dir, name), nil, 0)
+	if err != nil {
+		return true
+	}
+	calls := false
+	ast.Inspect(file, func(n ast.Node) bool {
+		call, ok := n.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		sel, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		base, ok := sel.X.(*ast.Ident)
+		if !ok {
+			return true
+		}
+		path := pkg.imports[name][base.Name]
+		if strings.Contains(path, "xgbutil") || (strings.HasSuffix(path, "BurntSushi/xgb") && strings.HasPrefix(sel.Sel.Name, "NewConn")) {
+			calls = true
+		}
+		return true
+	})
+	return calls
+}
