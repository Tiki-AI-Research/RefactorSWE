+func TestP2PPressUnfocusedWindowRaisesAndReturns(t *testing.T) {
+	c := p2pLive(t, p2pClientOptions{Focused: false})
+	px, py := p2pTitleBarCenter(c)
+	before := c.geometry()
+	raises := c.raiseCount()
+	// Drain initialization requests, then inspect only this press's effects.
+	p2pSyncX(t, c)
+	c.fx.mu.Lock()
+	c.fx.pressTrace = true
+	c.fx.pressEvents = nil
+	c.fx.mu.Unlock()
+	c.press(px, py, xproto.ButtonIndex1)
+	p2pSyncX(t, c)
+	c.fx.mu.Lock()
+	events := append([]string(nil), c.fx.pressEvents...)
+	c.fx.pressTrace = false
+	c.fx.mu.Unlock()
+	if !reflect.DeepEqual(events, []string{"raise", "focus"}) {
+		t.Fatalf("this unfocused press must raise then request focus exactly once, got %v", events)
+	}
+	f := p2pCaptureGeometry(t, c)
+	c.drag(px+30, py+40)
+	if len(f.pendingGeometry) != 0 {
+		t.Fatal("unfocused press did not return before drag classification")
+	}
+	time.Sleep(p2pSettle)
+	if after := c.geometry(); after != before {
+		t.Fatalf("unfocused press changed geometry: %+v -> %+v", before, after)
+	}
+	if !c.fx.clientMessageWith("_NET_ACTIVE_WINDOW", -1) {
+		t.Fatal("unfocused press did not request window activation")
+	}
+	if c.raiseCount() <= raises {
+		t.Fatal("unfocused press did not raise the window")
+	}
+}
