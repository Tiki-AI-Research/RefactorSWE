+// The queue belongs to frame, not to the interaction implementation. Stop its
+// consumer before observing requests, so coalescing and minimum-size handling
+// cannot hide an incorrect interaction request. Tests do not rename, wrap or
+// replace any production method.
+func p2pCaptureGeometry(t *testing.T, c *p2pClient) *frame {
+	t.Helper()
+	f := c.win.(*client).frame
+	if f.pendingGeometry != nil {
+		f.endConfigureLoop()
+		if !c.fx.waitFor(func() bool { return f.pendingGeometry == nil }, p2pTimeout) {
+			t.Fatal("geometry consumer did not stop")
+		}
+	}
+	f.pendingGeometry = make(chan *configureGeometry, 50)
+	return f
+}
+
+func p2pGeometryRequest(t *testing.T, f *frame) *configureGeometry {
+	t.Helper()
+	select {
+	case g := <-f.pendingGeometry:
+		if g == nil {
+			t.Fatal("nil geometry request")
+		}
+		if len(f.pendingGeometry) != 0 {
+			t.Fatal("one drag queued more than one geometry request")
+		}
+		return g
+	case <-time.After(time.Second):
+		t.Fatal("drag did not queue geometry")
+		return nil
+	}
+}
