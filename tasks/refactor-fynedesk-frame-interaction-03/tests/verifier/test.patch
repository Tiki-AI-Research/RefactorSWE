+func TestF2PDecorationResourceLifecycleRunsThroughCollaborator(t *testing.T) {
+	pkg := f2pR3LoadPackage(t)
+	base, _, _, _ := f2pR3RequireDecorationOwner(t, pkg, "pixmap and graphics-context lifecycle must run in the decoration collaborator")
+	closure := map[string]*f2pR3Func{}
+	for _, typeName := range []string{"frame", "client"} {
+		for _, fi := range pkg.methods[typeName] {
+			closure[fi.symbol()] = fi
+			for symbol, reached := range pkg.f2pR3Reachable(fi) {
+				closure[symbol] = reached
+			}
+		}
+	}
+	created, freed := false, false
+	for _, fi := range closure {
+		if fi.recvType != base {
+			continue
+		}
+		for _, name := range f2pR3XprotoCallNames(pkg, fi) {
+			switch name {
+			case "CreatePixmap", "CreateGC", "PutImage":
+				created = true
+			case "FreePixmap", "FreeGC":
+				freed = true
+			}
+		}
+	}
+	if !created || !freed {
+		t.Fatalf("the decoration collaborator %s reached from the frame does not own the xproto resource lifecycle (create=%v, free=%v): createPixmaps/GC creation and pixmap/GC cleanup must move out of the frame (REQ-STRUCT-002)", base, created, freed)
+	}
+}
