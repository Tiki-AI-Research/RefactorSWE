+// f2pR3XprotoCallNames returns the names of calls whose selector base resolves
+// to the xproto protocol package.
+func f2pR3XprotoCallNames(pkg *f2pR3Package, fi *f2pR3Func) []string {
+	var out []string
+	if fi.decl.Body == nil {
+		return out
+	}
+	ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+		call, ok := n.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		sel, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		base, ok := sel.X.(*ast.Ident)
+		if !ok {
+			return true
+		}
+		if !strings.HasSuffix(pkg.imports[fi.file][base.Name], "xproto") {
+			return true
+		}
+		out = append(out, sel.Sel.Name)
+		return true
+	})
+	return out
+}
