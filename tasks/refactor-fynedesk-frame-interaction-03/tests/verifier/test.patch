+// staysAt asserts that no interaction changes the frame geometry for the given
+// action, which is how a discarded or no-op pointer sequence is observed.
+func (c *p2pClient) staysAt(t *testing.T, why string, action func()) {
+	t.Helper()
+	before := c.geometry()
+	action()
+	time.Sleep(p2pSettle)
+	if after := c.geometry(); after != before {
+		t.Fatalf("%s: frame geometry changed from %+v to %+v", why, before, after)
+	}
+}
