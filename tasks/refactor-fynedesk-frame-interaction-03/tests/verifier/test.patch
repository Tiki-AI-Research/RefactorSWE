+// f2pR3TypeContains reports whether the type or a composite element of it is
+// identical to want, so a relocated resource cannot hide behind a pointer,
+// slice, array, channel or map field of the frame.
+func f2pR3TypeContains(typ, want reflect.Type) bool {
+	if typ == want {
+		return true
+	}
+	switch typ.Kind() {
+	case reflect.Ptr, reflect.Slice, reflect.Array, reflect.Chan, reflect.Map:
+		return f2pR3TypeContains(typ.Elem(), want)
+	}
+	return false
+}
+
+func f2pR3AssertFrameOmitsResource(t *testing.T, what string, want reflect.Type) {
+	t.Helper()
+	for i := 0; i < f2pR3FrameType.NumField(); i++ {
+		field := f2pR3FrameType.Field(i)
+		if f2pR3TypeContains(field.Type, want) {
+			t.Fatalf("win.frame still declares %s field %q (%s): decoration rendering resources must live in the decoration collaborator (REQ-STRUCT-002)", what, field.Name, field.Type)
+		}
+	}
+}
+
+func TestF2PFrameDropsPixmapResources(t *testing.T) {
+	f2pR3AssertFrameOmitsResource(t, "decoration pixmap", reflect.TypeOf(xproto.Pixmap(0)))
+}
+
+func TestF2PFrameDropsGraphicsContextResources(t *testing.T) {
+	f2pR3AssertFrameOmitsResource(t, "decoration graphics-context", reflect.TypeOf(xproto.Gcontext(0)))
+}
+
+func TestF2PFrameDropsDecorationCanvas(t *testing.T) {
+	canvas := reflect.TypeOf((*test.WindowlessCanvas)(nil)).Elem()
+	f2pR3AssertFrameOmitsResource(t, "decoration canvas", canvas)
+}
