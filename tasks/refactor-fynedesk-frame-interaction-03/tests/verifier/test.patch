+// f2pR3FrameFieldGraphDeclaresMethod reports whether any type held in a frame
+// field declares the named method (the controlled frame surface may be reached
+// through an interface field).
+func (pkg *f2pR3Package) f2pR3FrameFieldGraphDeclaresMethod(name string) bool {
+	for _, base := range f2pR3FrameFieldBaseTypes() {
+		if pkg.f2pR3DeclaresMethod(base, name) {
+			return true
+		}
+		if info := pkg.types[base]; info != nil && info.isIface {
+			for typeName := range pkg.types {
+				if pkg.f2pR3DeclaresMethod(typeName, name) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
