+func (pkg *f2pR3Package) f2pR3TestFuncsInFile(file string) []*f2pR3Func {
+	var out []*f2pR3Func
+	for name, list := range pkg.funcs {
+		if !strings.HasPrefix(name, "Test") {
+			continue
+		}
+		for _, fi := range list {
+			if fi.file == file && fi.recvType == "" && fi.isTest {
+				out = append(out, fi)
+			}
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].decl.Name.Name < out[j].decl.Name.Name })
+	return out
+}
