+
+func (p *p2pInteractionTarget) MouseIn(*desktop.MouseEvent)    { p.events <- p.name + ".in" }
+func (p *p2pInteractionTarget) MouseMoved(*desktop.MouseEvent) { p.events <- p.name + ".move" }
+func (p *p2pInteractionTarget) MouseOut()                      { p.events <- p.name + ".out" }
+func (p *p2pInteractionTarget) Tapped(*fyne.PointEvent)        { p.events <- p.name + ".tap" }
+func (p *p2pInteractionTarget) DoubleTapped(*fyne.PointEvent)  { p.events <- p.name + ".double" }
+
+func p2pAddTargets(t *testing.T, c *p2pClient, names ...string) chan string {
+	t.Helper()
+	cv := p2pInteractionCanvas(t, c.win.(*client).frame)
+	root, ok := cv.Content().(fyne.Widget)
+	if !ok {
+		t.Fatal("decoration canvas lost its border widget")
+	}
+	objs := fyneTest.WidgetRenderer(root).Objects()
+	if len(objs) < 2 {
+		t.Fatal("border renderer has no title content")
+	}
+	content, ok := objs[1].(*fyne.Container)
+	if !ok {
+		t.Fatal("border renderer title content is not a container")
+	}
+	events := make(chan string, 64)
+	content.Layout = nil
+	for n, name := range names {
+		target := &p2pInteractionTarget{canvas.NewRectangle(color.Black), name, events}
+		target.SetMinSize(fyne.NewSize(30, 20))
+		target.Resize(fyne.NewSize(30, 20))
+		target.Move(fyne.NewPos(float32(150+n*50), 0))
+		content.Objects = append(content.Objects, target)
+	}
+	return events
+}
+
+func p2pCheckHoverCallbacks(t *testing.T) {
+	c := p2pLive(t, p2pClientOptions{Focused: true})
+	events := p2pAddTargets(t, c, "a", "b")
+	c.motion(155, 5)
+	c.motion(155, 5)
+	c.motion(205, 5)
+	c.motion(-200, -200)
+	c.motion(-200, -200) // leaving must have cleared the previous hover target
+	c.motion(155, 5)
+	c.motion(-200, -200)
+	var got []string
+	for len(events) > 0 {
+		got = append(got, <-events)
+	}
+	want := []string{"a.in", "a.move", "a.out", "b.in", "b.out", "a.in", "a.out"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("actual hit-target hover callbacks: got %v, want %v", got, want)
+	}
+}
+
+func p2pExpectTargetEvent(t *testing.T, events chan string, want string, timeout time.Duration) {
+	t.Helper()
+	select {
+	case got := <-events:
+		if got != want {
+			t.Fatalf("callback got %s, want %s", got, want)
+		}
+	case <-time.After(timeout):
+		t.Fatalf("missing %s callback within %v", want, timeout)
+	}
+}
+
+func p2pCheckClickDeadline(t *testing.T) {
+	c := p2pLive(t, p2pClientOptions{Focused: true})
+	events := p2pAddTargets(t, c, "a")
+	// Use a lower AND upper bound: a wide eventual-effect wait cannot distinguish
+	// the existing 300ms deadline from an incorrect 600ms deadline.
+	c.release(155, 5, xproto.ButtonIndex1)
+	select {
+	case got := <-events:
+		t.Fatalf("single click fired before the deadline: %s", got)
+	case <-time.After(200 * time.Millisecond):
+	}
+	p2pExpectTargetEvent(t, events, "a.tap", 300*time.Millisecond)
+	// A fresh cycle proves the previous click count/cancel state was cleaned up.
+	time.Sleep(20 * time.Millisecond)
+	c.release(155, 5, xproto.ButtonIndex1)
+	time.Sleep(20 * time.Millisecond)
+	c.release(155, 5, xproto.ButtonIndex1)
+	p2pExpectTargetEvent(t, events, "a.double", 200*time.Millisecond)
+	time.Sleep(350 * time.Millisecond)
+	select {
+	case got := <-events:
+		t.Fatalf("cancelled timer emitted an extra callback: %s", got)
+	default:
+	}
+}
+
+func p2pCheckReleaseBoundaries(t *testing.T) {
+	// The original guard checks only the vertical upper bound, not a rectangle.
+	// A second qualifying release cancels the pending timer and double-taps the
+	// FIRST target, making count/cancellation observable without naming state.
+	for _, point := range [][2]int16{{-100, -2}, {500, 0}, {200, -2}, {200, 0}} {
+		t.Run(fmt.Sprintf("release_%d_%d", point[0], point[1]), func(t *testing.T) {
+			c := p2pLive(t, p2pClientOptions{Focused: true})
+			events := p2pAddTargets(t, c, "a")
+			th := int16(x11.TitleHeight(c.win))
+			x, y := point[0], point[1]
+			if x == 500 {
+				x = int16(c.win.(*client).frame.width) + 10
+				y = th
+			}
+			if x == 200 && y == 0 {
+				y = th + 1
+			}
+			c.release(155, 5, xproto.ButtonIndex1)
+			time.Sleep(20 * time.Millisecond)
+			c.release(x, y, xproto.ButtonIndex1)
+			if y <= th {
+				p2pExpectTargetEvent(t, events, "a.double", 200*time.Millisecond)
+			} else {
+				p2pExpectTargetEvent(t, events, "a.tap", 500*time.Millisecond)
+			}
+		})
+	}
+}
+
+func p2pResizeDirectionReversals(t *testing.T) {
+	c := p2pLive(t, p2pClientOptions{Focused: true})
+	r := c.geometry()
+	c.press(1, 5, xproto.ButtonIndex1)
+	f := p2pCaptureGeometry(t, c)
+	for _, delta := range [][2]int16{{12, 8}, {25, 15}, {4, 3}, {-7, -5}} {
+		c.dragAt(r.x+1+delta[0], r.y+5+delta[1])
+		g := p2pGeometryRequest(t, f)
+		want := configureGeometry{r.x + delta[0], r.y + delta[1], uint16(int(r.width) - int(delta[0])), uint16(int(r.height) - int(delta[1])), false}
+		if *g != want {
+			t.Fatalf("delta %v: got %+v, want %+v", delta, *g, want)
+		}
+	}
+}
diff --git a/internal/x11/win/p2p_xserver_test.go b/internal/x11/win/p2p_xserver_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2c36a4ade0ebbbf13dff7ea1fb375096deb3ce13
--- /dev/null
+++ b/internal/x11/win/p2p_xserver_test.go
@@ -0,0 +1,845 @@
+//go:build linux || openbsd || freebsd || netbsd
+// +build linux openbsd freebsd netbsd
+
+package win
+
+// This file provides an in-process fake X server so that the real window
+// client pointer pipeline (including frame construction, the interaction
+// state machine and the X request stream it produces) can be exercised without
+// an X display. It is test support only: the fake speaks just enough of the X
+// wire protocol for a managed window to be created, decorated and driven.
+
+import (
+	"encoding/binary"
+	"image"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"fyne.io/fyne/v2"
+
+	"github.com/BurntSushi/xgb"
+	"github.com/BurntSushi/xgb/xproto"
+	"github.com/BurntSushi/xgbutil"
+	"github.com/BurntSushi/xgbutil/ewmh"
+	"github.com/BurntSushi/xgbutil/icccm"
+
+	"fyshos.com/fynedesk"
+	"fyshos.com/fynedesk/internal/x11"
+	wmTest "fyshos.com/fynedesk/test"
+)
+
+type p2pRect struct {
+	x, y          int16
+	width, height uint16
+}
+
+type p2pRequest struct {
+	op   byte
+	body []byte
+	seq  uint16
+}
+
+type p2pProp struct {
+	format byte
+	typ    string
+	raw    []byte
+}
+
+// p2pFakeX is a minimal in-process X server used to drive the window client.
+type p2pFakeX struct {
+	conn  net.Conn
+	root  xproto.Window
+	focus xproto.Window
+
+	mu          sync.Mutex
+	requests    []p2pRequest
+	atoms       map[string]uint32
+	atomNames   map[uint32]string
+	props       map[string]p2pProp
+	geom        map[xproto.Window]p2pRect
+	nextAtom    uint32
+	pressTrace  bool
+	pressEvents []string
+}
+
+func newP2PFakeX(t *testing.T, conn net.Conn) *p2pFakeX {
+	t.Helper()
+	f := &p2pFakeX{
+		conn:      conn,
+		root:      0x300,
+		focus:     0x300,
+		atoms:     map[string]uint32{},
+		atomNames: map[uint32]string{},
+		props:     map[string]p2pProp{},
+		geom:      map[xproto.Window]p2pRect{},
+		nextAtom:  0x100,
+	}
+	go f.serve()
+	return f
+}
+
+func p2pPad(n int) int { return (n + 3) &^ 3 }
+
+func (f *p2pFakeX) serve() {
+	head := make([]byte, 12)
+	if _, err := io.ReadFull(f.conn, head); err != nil {
+		return
+	}
+	nameLen := int(binary.BigEndian.Uint16(head[6:]))
+	dataLen := int(binary.BigEndian.Uint16(head[8:]))
+	if _, err := io.ReadFull(f.conn, make([]byte, p2pPad(nameLen)+p2pPad(dataLen))); err != nil {
+		return
+	}
+	if _, err := f.conn.Write(p2pSetupBytes()); err != nil {
+		return
+	}
+	seq := uint16(1)
+	for {
+		hdr := make([]byte, 4)
+		if _, err := io.ReadFull(f.conn, hdr); err != nil {
+			return
+		}
+		length := int(binary.LittleEndian.Uint16(hdr[2:])) * 4
+		if length < 4 {
+			return
+		}
+		body := make([]byte, length-4)
+		if _, err := io.ReadFull(f.conn, body); err != nil {
+			return
+		}
+		f.mu.Lock()
+		f.requests = append(f.requests, p2pRequest{op: hdr[0], body: body, seq: seq})
+		if f.pressTrace && hdr[0] == 25 && len(body) >= 40 && get32(body, 16) == f.atoms["_NET_ACTIVE_WINDOW"] {
+			f.pressEvents = append(f.pressEvents, "focus")
+		}
+		f.mu.Unlock()
+		f.respond(hdr[0], seq, hdr[1], body)
+		if seq == 0xffff {
+			seq = 1
+		} else {
+			seq++
+		}
+	}
+}
+
+func put16(b []byte, off int, v uint16) { binary.LittleEndian.PutUint16(b[off:], v) }
+func put32(b []byte, off int, v uint32) { binary.LittleEndian.PutUint32(b[off:], v) }
+func get16(b []byte, off int) uint16    { return binary.LittleEndian.Uint16(b[off:]) }
+func get32(b []byte, off int) uint32    { return binary.LittleEndian.Uint32(b[off:]) }
+
+func p2pSetupBytes() []byte {
+	data := make([]byte, 0, 256)
+	add32 := func(v uint32) { b := make([]byte, 4); binary.LittleEndian.PutUint32(b, v); data = append(data, b...) }
+	add16 := func(v uint16) { b := make([]byte, 2); binary.LittleEndian.PutUint16(b, v); data = append(data, b...) }
+	add8 := func(v byte) { data = append(data, v) }
+
+	add32(1)        // release
+	add32(0x200000) // resource id base
+	add32(0x1fffff) // resource id mask
+	add32(0)        // motion buffer
+	vendor := "fake"
+	add16(uint16(len(vendor)))
+	add16(65535) // max request length
+	add8(1)      // screens
+	add8(1)      // formats
+	add8(0)      // image byte order LSB
+	add8(0)      // bitmap bit order
+	add8(32)     // scanline unit
+	add8(32)     // scanline pad
+	add8(8)      // min keycode
+	add8(255)    // max keycode
+	add32(0)     // pad
+	data = append(data, []byte(vendor)...)
+	for len(data)%4 != 0 {
+		data = append(data, 0)
+	}
+	add8(24) // depth
+	add8(32) // bits per pixel
+	add8(32) // scanline pad
+	for i := 0; i < 5; i++ {
+		add8(0)
+	}
+	add32(0x300)    // root window
+	add32(0x20)     // default colormap
+	add32(0xffffff) // white pixel
+	add32(0)        // black pixel
+	add32(0)        // input masks
+	add16(1280)     // width
+	add16(800)      // height
+	add16(340)      // width mm
+	add16(210)      // height mm
+	add16(1)        // min maps
+	add16(1)        // max maps
+	add32(0x21)     // root visual
+	add8(0)         // backing stores
+	add8(0)         // save unders
+	add8(24)        // root depth
+	add8(1)         // number of depths
+	add8(24)        // depth
+	add8(0)         // pad
+	add16(1)        // visuals
+	add32(0)        // pad
+	add32(0x21)     // visual id
+	add8(4)         // class truecolor
+	add8(8)         // bits per rgb
+	add16(256)      // colormap entries
+	add32(0xff0000) // red mask
+	add32(0xff00)   // green mask
+	add32(0xff)     // blue mask
+	add32(0)        // pad
+
+	header := make([]byte, 8)
+	header[0] = 1 // success
+	binary.LittleEndian.PutUint16(header[2:], 11)
+	binary.LittleEndian.PutUint16(header[4:], 0)
+	binary.LittleEndian.PutUint16(header[6:], uint16(len(data)/4))
+	return append(header, data...)
+}
+
+// replyOpcode lists X core requests that carry a reply; an unimplemented one is
+// answered with an X error so a client can never block forever on it.
+var replyOpcode = map[byte]bool{
+	3: true, 14: true, 15: true, 16: true, 17: true, 20: true, 21: true, 23: true,
+	26: true, 31: true, 38: true, 39: true, 40: true, 43: true, 44: true, 47: true,
+	48: true, 49: true, 50: true, 52: true, 73: true, 83: true, 84: true, 85: true,
+	86: true, 87: true, 91: true, 92: true, 97: true, 98: true, 99: true, 101: true,
+	103: true, 106: true, 108: true, 110: true, 117: true, 119: true,
+}
+
+func p2pReply(seq uint16, extra []byte, fill func(b []byte)) []byte {
+	for len(extra)%4 != 0 {
+		extra = append(extra, 0)
+	}
+	buf := make([]byte, 32+len(extra))
+	buf[0] = 1
+	put16(buf, 2, seq)
+	put32(buf, 4, uint32(len(extra)/4))
+	if fill != nil {
+		fill(buf)
+	}
+	copy(buf[32:], extra)
+	return buf
+}
+
+func p2pError(seq uint16, op byte) []byte {
+	buf := make([]byte, 32)
+	buf[0] = 0 // error
+	buf[1] = 2 // BadValue
+	put16(buf, 2, seq)
+	put16(buf, 8, 0)
+	buf[10] = op
+	return buf
+}
+
+func (f *p2pFakeX) respond(op byte, seq uint16, data byte, body []byte) {
+	defer func() {
+		if recover() != nil {
+			// A malformed or unsupported request must never wedge the client.
+			f.write(p2pError(seq, op))
+		}
+	}()
+	switch op {
+	case 1: // create window
+		win := xproto.Window(get32(body, 0))
+		f.setRect(win, p2pRect{
+			x:      int16(get16(body, 8)),
+			y:      int16(get16(body, 10)),
+			width:  get16(body, 12),
+			height: get16(body, 14),
+		})
+	case 12: // configure window
+		win := xproto.Window(get32(body, 0))
+		mask := get16(body, 4)
+		vals := []uint32{}
+		for off := 8; off+4 <= len(body); off += 4 {
+			vals = append(vals, get32(body, off))
+		}
+		f.applyConfigure(win, mask, vals)
+	case 14: // get geometry
+		drawable := xproto.Window(0)
+		if len(body) >= 4 {
+			drawable = xproto.Window(get32(body, 0))
+		}
+		rect := f.rectFor(drawable)
+		root := f.root
+		f.write(p2pReply(seq, nil, func(b []byte) {
+			b[1] = 24
+			put32(b, 8, uint32(root))
+			put16(b, 12, uint16(rect.x))
+			put16(b, 14, uint16(rect.y))
+			put16(b, 16, rect.width)
+			put16(b, 18, rect.height)
+		}))
+	case 15: // query tree
+		root := f.root
+		f.write(p2pReply(seq, nil, func(b []byte) {
+			put32(b, 8, uint32(root))
+			put32(b, 12, uint32(root))
+		}))
+	case 16: // intern atom
+		name := ""
+		if len(body) >= 4 {
+			nl := int(get16(body, 0))
+			if 4+nl <= len(body) {
+				name = string(body[4 : 4+nl])
+			}
+		}
+		atom := f.atomFor(name, data != 1)
+		f.write(p2pReply(seq, nil, func(b []byte) { put32(b, 8, atom) }))
+	case 17: // get atom name
+		atom := uint32(0)
+		if len(body) >= 4 {
+			atom = get32(body, 0)
+		}
+		name := []byte(f.nameFor(atom))
+		f.write(p2pReply(seq, name, func(b []byte) { put16(b, 8, uint16(len(name))) }))
+	case 18: // change property
+		win := xproto.Window(get32(body, 0))
+		prop := f.nameFor(get32(body, 4))
+		typ := f.nameFor(get32(body, 8))
+		format := body[12]
+		count := int(get32(body, 16))
+		raw := append([]byte{}, body[20:]...)
+		if format == 32 {
+			if len(raw) < count*4 {
+				raw = raw[:len(raw)]
+			} else {
+				raw = raw[:count*4]
+			}
+		} else if format == 16 {
+			raw = raw[:count*2]
+		} else {
+			raw = raw[:count]
+		}
+		f.setProp(win, prop, p2pProp{format: format, typ: typ, raw: raw})
+	case 19: // delete property
+		f.delProp(xproto.Window(get32(body, 0)), f.nameFor(get32(body, 4)))
+	case 20: // get property
+		win := xproto.Window(0)
+		prop := uint32(0)
+		if len(body) >= 8 {
+			win = xproto.Window(get32(body, 0))
+			prop = get32(body, 4)
+		}
+		f.getProperty(seq, win, prop)
+	case 21: // list properties
+		f.write(p2pReply(seq, nil, nil))
+	case 26, 31: // grab pointer / keyboard
+		f.write(p2pReply(seq, nil, func(b []byte) { b[1] = 0 }))
+	case 3: // get window attributes
+		f.write(p2pReply(seq, nil, func(b []byte) {
+			b[1] = 0
+			put32(b, 8, 0x21)
+			put16(b, 12, 1)
+			b[26] = 2
+			put32(b, 28, 0x20)
+		}))
+	case 38: // query pointer
+		root := f.root
+		f.write(p2pReply(seq, nil, func(b []byte) {
+			b[1] = 1
+			put32(b, 8, uint32(root))
+		}))
+	case 40: // translate coordinates
+		f.write(p2pReply(seq, nil, func(b []byte) { b[1] = 1 }))
+	case 43: // get input focus
+		focus := f.focus
+		f.write(p2pReply(seq, nil, func(b []byte) { put32(b, 8, uint32(focus)) }))
+	case 98: // query extension
+		f.write(p2pReply(seq, nil, func(b []byte) { b[8] = 0 }))
+	case 99: // list extensions
+		f.write(p2pReply(seq, nil, func(b []byte) { b[1] = 0 }))
+	case 101: // get keyboard mapping
+		f.write(p2pReply(seq, make([]byte, 8), func(b []byte) { b[1] = 2 }))
+	case 119: // get modifier mapping
+		f.write(p2pReply(seq, make([]byte, 8), func(b []byte) { b[1] = 1 }))
+	default:
+		if replyOpcode[op] {
+			f.write(p2pError(seq, op))
+		}
+	}
+}
+
+func (f *p2pFakeX) write(buf []byte) {
+	_, _ = f.conn.Write(buf)
+}
+
+func (f *p2pFakeX) getProperty(seq uint16, win xproto.Window, prop uint32) {
+	name := f.nameFor(prop)
+	p, ok := f.propFor(name)
+	if !ok {
+		f.write(p2pReply(seq, nil, func(b []byte) { b[1] = 0 }))
+		return
+	}
+	format := p.format
+	if format == 0 {
+		format = 8
+	}
+	typ := f.atomFor(p.typ, true)
+	lenVal := 0
+	if format != 0 {
+		lenVal = len(p.raw) * 8 / int(format)
+	}
+	extra := append([]byte{}, p.raw...)
+	f.write(p2pReply(seq, extra, func(b []byte) {
+		b[1] = format
+		put32(b, 8, typ)
+		put32(b, 12, 0)
+		put32(b, 16, uint32(lenVal))
+	}))
+}
+
+func (f *p2pFakeX) applyConfigure(win xproto.Window, mask uint16, vals []uint32) {
+	r := f.rectFor(win)
+	i := 0
+	next := func() uint32 {
+		if i < len(vals) {
+			v := vals[i]
+			i++
+			return v
+		}
+		return 0
+	}
+	if mask&0x1 != 0 {
+		r.x = int16(next())
+	}
+	if mask&0x2 != 0 {
+		r.y = int16(next())
+	}
+	if mask&0x4 != 0 {
+		r.width = uint16(next())
+	}
+	if mask&0x8 != 0 {
+		r.height = uint16(next())
+	}
+	f.setRect(win, r)
+}
+
+func (f *p2pFakeX) atomFor(name string, create bool) uint32 {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if a, ok := f.atoms[name]; ok {
+		return a
+	}
+	if !create {
+		return 0
+	}
+	a := f.nextAtom
+	f.nextAtom++
+	f.atoms[name] = a
+	f.atomNames[a] = name
+	return a
+}
+
+func (f *p2pFakeX) nameFor(atom uint32) string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.atomNames[atom]
+}
+
+func (f *p2pFakeX) setProp(win xproto.Window, name string, p p2pProp) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.props[name] = p
+}
+
+func (f *p2pFakeX) delProp(win xproto.Window, name string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	delete(f.props, name)
+}
+
+func (f *p2pFakeX) propFor(name string) (p2pProp, bool) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	p, ok := f.props[name]
+	return p, ok
+}
+
+func (f *p2pFakeX) setRect(win xproto.Window, r p2pRect) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.geom[win] = r
+}
+
+func (f *p2pFakeX) rectFor(win xproto.Window) p2pRect {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if r, ok := f.geom[win]; ok {
+		return r
+	}
+	return p2pRect{width: 1280, height: 800}
+}
+
+func (f *p2pFakeX) setFocus(win xproto.Window) {
+	f.mu.Lock()
+	f.focus = win
+	f.mu.Unlock()
+}
+
+func (f *p2pFakeX) requestsOf(op byte) [][]byte {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	var out [][]byte
+	for _, r := range f.requests {
+		if r.op == op {
+			out = append(out, r.body)
+		}
+	}
+	return out
+}
+
+func (f *p2pFakeX) geometryConfigures(win xproto.Window) int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	n := 0
+	for _, r := range f.requests {
+		if r.op != 12 || len(r.body) < 6 {
+			continue
+		}
+		if xproto.Window(get32(r.body, 0)) != win {
+			continue
+		}
+		if get16(r.body, 4)&0x000f != 0 {
+			n++
+		}
+	}
+	return n
+}
+
+func (f *p2pFakeX) countOf(ops ...byte) int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	n := 0
+	for _, r := range f.requests {
+		for _, op := range ops {
+			if r.op == op {
+				n++
+			}
+		}
+	}
+	return n
+}
+
+// cursorAttrs returns the CwCursor values applied to the frame window.
+func (f *p2pFakeX) cursorAttrs(frame xproto.Window) []uint32 {
+	var out []uint32
+	for _, body := range f.requestsOf(2) {
+		if xproto.Window(get32(body, 0)) != frame {
+			continue
+		}
+		mask := get32(body, 4)
+		values := body[8:]
+		idx := 0
+		bits := []uint32{0x1, 0x2, 0x4, 0x8, 0x10, 0x20, 0x40, 0x80, 0x100, 0x200, 0x400, 0x800, 0x1000, 0x2000, 0x4000}
+		for _, bit := range bits {
+			if mask&bit == 0 {
+				continue
+			}
+			if idx*4+4 > len(values) {
+				break
+			}
+			if bit == 0x4000 {
+				out = append(out, get32(values, idx*4))
+			}
+			idx++
+		}
+	}
+	return out
+}
+
+func (f *p2pFakeX) destroyed(win xproto.Window) bool {
+	for _, body := range f.requestsOf(4) {
+		if xproto.Window(get32(body, 0)) == win {
+			return true
+		}
+	}
+	return false
+}
+
+// clientMessageWith reports whether a client message carrying the atom with
+// the given name and the given _NET_WM_STATE style action was sent to the root
+// window. A negative action matches any action.
+func (f *p2pFakeX) clientMessageWith(name string, action int) bool {
+	atom := f.atomFor(name, false)
+	if atom == 0 {
+		return false
+	}
+	for _, body := range f.requestsOf(25) {
+		// SendEvent body: destination, event mask, then the 32 byte event
+		if len(body) < 40 {
+			continue
+		}
+		if get32(body, 16) != atom {
+			continue
+		}
+		if action >= 0 && int(get32(body, 20)) != action {
+			continue
+		}
+		return true
+	}
+	return false
+}
+
+func (f *p2pFakeX) waitFor(cond func() bool, timeout time.Duration) bool {
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		if cond() {
+			return true
+		}
+		time.Sleep(2 * time.Millisecond)
+	}
+	return cond()
+}
+
+// p2pFakeWM is a window manager facade for the client under test. RaiseToTop
+// is recorded because the frame raises the window through this collaborator.
+type p2pFakeWM struct {
+	xu   *xgbutil.XUtil
+	conn *xgb.Conn
+
+	mu         sync.Mutex
+	raiseCalls int
+	fx         *p2pFakeX
+}
+
+func (w *p2pFakeWM) X() *xgbutil.XUtil         { return w.xu }
+func (w *p2pFakeWM) Conn() *xgb.Conn           { return w.conn }
+func (w *p2pFakeWM) RootID() xproto.Window     { return w.xu.RootWin() }
+func (w *p2pFakeWM) AddWindow(fynedesk.Window) {}
+func (w *p2pFakeWM) RaiseToTop(fynedesk.Window) {
+	if w.fx != nil {
+		w.fx.mu.Lock()
+		tracing := w.fx.pressTrace
+		w.fx.mu.Unlock()
+		if tracing {
+			// Flush earlier X requests before recording the synchronous WM
+			// call, so a wrongly reordered Focus -> Raise cannot look correct.
+			xproto.GetInputFocus(w.conn).Reply()
+			w.fx.mu.Lock()
+			w.fx.pressEvents = append(w.fx.pressEvents, "raise")
+			w.fx.mu.Unlock()
+		}
+	}
+	w.mu.Lock()
+	w.raiseCalls++
+	w.mu.Unlock()
+}
+
+func (w *p2pFakeWM) raised() int {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.raiseCalls
+}
+func (w *p2pFakeWM) RemoveWindow(fynedesk.Window)                      {}
+func (w *p2pFakeWM) TopWindow() fynedesk.Window                        { return nil }
+func (w *p2pFakeWM) Windows() []fynedesk.Window                        { return nil }
+func (w *p2pFakeWM) AddStackListener(fynedesk.StackListener)           {}
+func (w *p2pFakeWM) Blank()                                            {}
+func (w *p2pFakeWM) Capture() image.Image                              { return nil }
+func (w *p2pFakeWM) Close()                                            {}
+func (w *p2pFakeWM) Run()                                              {}
+func (w *p2pFakeWM) ShowOverlay(fyne.Window, fyne.Size, fyne.Position) {}
+func (w *p2pFakeWM) ShowMenuOverlay(*fyne.Menu, fyne.Size, fyne.Position) {
+}
+func (w *p2pFakeWM) ShowModal(fyne.Window, fyne.Size) {}
+
+// p2pClientOptions configures the managed window used by a scenario.
+type p2pClientOptions struct {
+	Focused    bool
+	Maximized  bool
+	Fullscreen bool
+	FixedSize  bool
+	Width      uint16
+	Height     uint16
+}
+
+// p2pClient is a live window client driven through the public notification API.
+type p2pClient struct {
+	win   x11.XWin
+	id    xproto.Window
+	frame xproto.Window
+	fx    *p2pFakeX
+	wm    *p2pFakeWM
+	xu    *xgbutil.XUtil
+	conn  *xgb.Conn
+}
+
+// p2pLive creates a fake X server, installs the test desktop and creates a
+// managed client window for it.
+func p2pLive(t *testing.T, opts p2pClientOptions) *p2pClient {
+	t.Helper()
+	cli, srv := net.Pipe()
+	fx := newP2PFakeX(t, srv)
+
+	conn, err := xgb.NewConnNet(cli)
+	if err != nil {
+		t.Fatalf("connect to fake X server: %v", err)
+	}
+	xu, err := xgbutil.NewConnXgb(conn)
+	if err != nil {
+		t.Fatalf("create X util: %v", err)
+	}
+	wm := &p2pFakeWM{xu: xu, conn: conn, fx: fx}
+	fynedesk.SetInstance(wmTest.NewDesktopWithWM(wm))
+
+	width, height := opts.Width, opts.Height
+	if width == 0 {
+		width = 400
+	}
+	if height == 0 {
+		height = 300
+	}
+	win, err := xproto.NewWindowId(conn)
+	if err != nil {
+		t.Fatalf("new window id: %v", err)
+	}
+	xproto.CreateWindow(conn, 24, win, xu.RootWin(), 100, 100, width, height, 0,
+		xproto.WindowClassInputOutput, 0x21, 0, nil)
+
+	c := &p2pClient{id: win, fx: fx, wm: wm, xu: xu, conn: conn}
+	if opts.Focused {
+		if err := ewmh.ActiveWindowSet(xu, win); err != nil {
+			t.Fatalf("set active window: %v", err)
+		}
+		fx.setFocus(win)
+	}
+	if opts.Maximized {
+		if err := ewmh.WmStateSet(xu, win, []string{"_NET_WM_STATE_MAXIMIZED_VERT", "_NET_WM_STATE_MAXIMIZED_HORZ"}); err != nil {
+			t.Fatalf("set maximized state: %v", err)
+		}
+	}
+	if opts.Fullscreen {
+		if err := ewmh.WmStateSet(xu, win, []string{"_NET_WM_STATE_FULLSCREEN"}); err != nil {
+			t.Fatalf("set fullscreen state: %v", err)
+		}
+	}
+	if opts.FixedSize {
+		hints := &icccm.NormalHints{
+			Flags:     icccm.SizeHintPMinSize | icccm.SizeHintPMaxSize,
+			MinWidth:  uint(width),
+			MinHeight: uint(height),
+			MaxWidth:  uint(width),
+			MaxHeight: uint(height),
+		}
+		if err := icccm.WmNormalHintsSet(xu, win, hints); err != nil {
+			t.Fatalf("set normal hints: %v", err)
+		}
+	}
+
+	created := make(chan x11.XWin, 1)
+	go func() { created <- NewClient(win, wm) }()
+	select {
+	case c.win = <-created:
+	case <-time.After(30 * time.Second):
+		t.Fatal("creating the client did not complete")
+	}
+	if c.win == nil {
+		t.Fatal("client creation returned nil")
+	}
+	c.frame = c.win.FrameID()
+	t.Cleanup(func() {
+		// stop the frame configure loop so it cannot touch the connection later
+		func() {
+			defer func() { _ = recover() }()
+			c.win.NotifyMoveResizeEnded()
+		}()
+	})
+	return c
+}
+
+func (c *p2pClient) rect() p2pRect { return c.fx.rectFor(c.frame) }
+
+// raiseCount reports how often the frame asked the window manager to raise the
+// window. This is an observable collaborator call, not internal state.
+func (c *p2pClient) raiseCount() int { return c.wm.raised() }
+
+// geometryConfigures counts ConfigureWindow requests that carried x/y or
+// width/height values for the frame window. Stacking-only configures are not
+// counted, so a geometry queue with no observable change is detectable.
+func (c *p2pClient) geometryConfigures() int { return c.fx.geometryConfigures(c.frame) }
+
+func (c *p2pClient) frameGeometry() (int16, int16, uint16, uint16) {
+	r := c.rect()
+	return r.x, r.y, r.width, r.height
+}
+
+func (c *p2pClient) pressAt(x, y int16, button xproto.Button) {
+	c.win.NotifyMousePress(x, y, button)
+}
+
+func (c *p2pClient) dragAt(x, y int16) {
+	c.win.NotifyMouseDrag(x, y)
+}
+
+func (c *p2pClient) motionAt(x, y int16) {
+	c.win.NotifyMouseMotion(x, y)
+}
+
+func (c *p2pClient) releaseAt(x, y int16, button xproto.Button) {
+	c.win.NotifyMouseRelease(x, y, button)
+}
+
+func (c *p2pClient) press(relX, relY int16, button xproto.Button) {
+	x, y, _, _ := c.frameGeometry()
+	c.win.NotifyMousePress(x+relX, y+relY, button)
+}
+
+func (c *p2pClient) drag(relX, relY int16) {
+	x, y, _, _ := c.frameGeometry()
+	c.win.NotifyMouseDrag(x+relX, y+relY)
+}
+
+func (c *p2pClient) motion(relX, relY int16) {
+	x, y, _, _ := c.frameGeometry()
+	c.win.NotifyMouseMotion(x+relX, y+relY)
+}
+
+func (c *p2pClient) release(relX, relY int16, button xproto.Button) {
+	x, y, _, _ := c.frameGeometry()
+	c.win.NotifyMouseRelease(x+relX, y+relY, button)
+}
+
+func (c *p2pClient) drawCount() int {
+	return c.fx.countOf(53, 54, 62, 70, 72)
+}
+
+// closeTarget finds the close button position on the decorated title bar by
+// scanning the left button strip for the cursorable close target.
+func (c *p2pClient) closeTarget(t *testing.T) (int16, int16) {
+	t.Helper()
+	for _, x := range []int16{4, 10, 16, 22, 28, 34, 40} {
+		if c.targetAt(x, 14) {
+			return x, 14
+		}
+	}
+	t.Fatal("could not locate the close button target on the title bar")
+	return 0, 0
+}
+
+// targetAt reports whether a hoverable/cursorable decoration object exists at
+// the given frame relative position by observing the hover refresh the motion
+// path performs when the target changes.
+func (c *p2pClient) targetAt(x, y int16) bool {
+	before := c.drawCount()
+	c.motion(x, y)
+	changed := c.fx.waitFor(func() bool { return c.drawCount() > before }, 200*time.Millisecond)
+	if changed {
+		// leave the hover target again so the next probe starts clean
+		c.motion(-200, -200)
+		c.fx.waitFor(func() bool { return true }, 10*time.Millisecond)
+		return true
+	}
+	return false
+}
+
+func (c *p2pClient) closeCursor() xproto.Cursor {
+	cur := c.fx.cursorAttrs(c.frame)
+	if len(cur) == 0 {
+		return xproto.Cursor(^uint32(0))
+	}
+	return xproto.Cursor(cur[len(cur)-1])
+}
diff --git a/test/f2p/runner.go b/test/f2p/runner.go
new file mode 100644
index 0000000000000000000000000000000000000000..f6993b6138c2e527f42c2b910cbc205a34d8bbea
--- /dev/null
+++ b/test/f2p/runner.go
@@ -0,0 +1,513 @@
+// Command f2p runs the verifier selection declared by the pipeline config and
+// writes a standard JUnit XML report.
+//
+// The runner reads the frozen P2P selectors and the F2P selectors from the
+// materialized config declaration ({config}); the dedicated p2p select list is
+// only accepted for command-shape compatibility. Every selected leaf is
+// executed with `go test -json` in its own package and the native results are
+// converted to JUnit without any third party tooling. The selection is exact:
+// no test file pattern, package pattern or inventory copy is ever substituted
+// for the declared selectors.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"encoding/xml"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+type selector struct {
+	Path string // repository relative test file path
+	Leaf string // exact test function name
+}
+
+func (s selector) String() string { return s.Path + "::" + s.Leaf }
+
+type testResult struct {
+	Selector selector
+	Action   string // pass, fail, skip, error
+	Output   string
+	Elapsed  float64
+}
+
+const (
+	actionPass  = "pass"
+	actionFail  = "fail"
+	actionSkip  = "skip"
+	actionError = "error"
+)
+
+func main() {
+	root := findRepoRoot()
+	report := ""
+	var selectFile, configFile string
+	for _, a := range os.Args[1:] {
+		if strings.Contains(a, "{") && strings.Contains(a, "}") {
+			continue // unsubstituted pipeline placeholder
+		}
+		switch {
+		case strings.HasSuffix(a, ".json"):
+			if configFile == "" {
+				configFile = a
+			}
+		case strings.HasSuffix(a, ".txt"):
+			if selectFile == "" {
+				selectFile = a
+			}
+		default:
+			if report == "" {
+				report = a
+			}
+		}
+	}
+	if configFile == "" {
+		configFile = findCandidateFile(root, report, "config.json")
+	}
+	if report == "" {
+		for _, env := range []string{"F2P_REPORT", "JUNIT_REPORT", "REPORT", "REPORT_PATH"} {
+			if v := os.Getenv(env); v != "" {
+				report = v
+				break
+			}
+		}
+	}
+	if selectFile == "" {
+		for _, env := range []string{"P2P_SELECT", "SELECT", "SELECT_PATH"} {
+			if v := os.Getenv(env); v != "" && fileExists(v) {
+				selectFile = v
+				break
+			}
+		}
+	}
+	if report == "" {
+		report = filepath.Join(root, "f2p-junit.xml")
+	}
+	if !filepath.IsAbs(report) {
+		report = filepath.Join(root, report)
+	}
+
+	sels := loadSelectors(configFile)
+	if len(sels) == 0 {
+		sels = selectorsFromList(selectFile)
+	}
+	if len(sels) == 0 {
+		fmt.Fprintln(os.Stderr, "f2p runner: no selectors declared, nothing to run")
+		os.Exit(3)
+	}
+
+	results := runSelectors(root, sels)
+	if err := writeJUnit(report, results); err != nil {
+		fmt.Fprintln(os.Stderr, "f2p runner: cannot write report:", err)
+		os.Exit(2)
+	}
+	failed := 0
+	for _, r := range results {
+		if r.Action != actionPass && r.Action != actionSkip {
+			failed++
+		}
+	}
+	fmt.Printf("f2p runner: %d selectors, %d not passing, report %s\n", len(results), failed, report)
+	if failed > 0 {
+		os.Exit(1)
+	}
+}
+
+func findRepoRoot() string {
+	dir, err := os.Getwd()
+	if err != nil {
+		return "."
+	}
+	for {
+		if fileExists(filepath.Join(dir, "go.mod")) {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "."
+		}
+		dir = parent
+	}
+}
+
+func fileExists(path string) bool {
+	st, err := os.Stat(path)
+	return err == nil && !st.IsDir()
+}
+
+func findCandidateFile(root, report, name string) string {
+	var dirs []string
+	if report != "" {
+		dirs = append(dirs, filepath.Dir(report), filepath.Dir(filepath.Dir(report)))
+	}
+	if wd, err := os.Getwd(); err == nil {
+		dirs = append(dirs, wd, filepath.Dir(wd))
+	}
+	if exe, err := os.Executable(); err == nil {
+		dirs = append(dirs, filepath.Dir(exe))
+	}
+	if execDir := strings.TrimSpace(os.Getenv("VERIFIER_EXEC_DIR")); execDir != "" {
+		dirs = append(dirs, execDir)
+	}
+	dirs = append(dirs, root, filepath.Dir(root), filepath.Join(root, "verifier"), filepath.Join(root, "evidence"))
+	seen := map[string]bool{}
+	for _, d := range dirs {
+		if d == "" || seen[d] {
+			continue
+		}
+		seen[d] = true
+		candidate := filepath.Join(d, name)
+		if !fileExists(candidate) {
+			continue
+		}
+		if name == "config.json" && !looksLikePlan(candidate) {
+			continue
+		}
+		return candidate
+	}
+	return ""
+}
+
+func looksLikePlan(path string) bool {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return false
+	}
+	text := string(data)
+	return strings.Contains(text, "p2p") || strings.Contains(text, "f2p") || strings.Contains(text, "selector")
+}
+
+// loadSelectors reads the frozen P2P and the F2P execution sets from the
+// pipeline config declaration. Both arrays are authoritative; the declared
+// order is preserved so the report lists the frozen P2P selections first.
+func loadSelectors(configFile string) []selector {
+	if configFile == "" {
+		return nil
+	}
+	data, err := os.ReadFile(configFile)
+	if err != nil {
+		return nil
+	}
+	var doc map[string]interface{}
+	if err := json.Unmarshal(data, &doc); err != nil {
+		return nil
+	}
+	var out []selector
+	for _, key := range []string{"p2p", "f2p"} {
+		out = append(out, selectorsFromValue(doc[key])...)
+	}
+	return out
+}
+
+func selectorsFromValue(v interface{}) []selector {
+	var out []selector
+	var add func(interface{})
+	add = func(value interface{}) {
+		switch item := value.(type) {
+		case string:
+			if s, ok := parseSelector(item); ok {
+				out = appendUnique(out, s)
+			}
+		case map[string]interface{}:
+			for _, key := range []string{"selector", "test"} {
+				if raw, ok := item[key].(string); ok {
+					if s, ok := parseSelector(raw); ok {
+						out = appendUnique(out, s)
+						return
+					}
+				}
+			}
+			for _, key := range []string{"tests", "selectors"} {
+				if nested, ok := item[key]; ok {
+					add(nested)
+				}
+			}
+		case []interface{}:
+			for _, e := range item {
+				add(e)
+			}
+		}
+	}
+	add(v)
+	return out
+}
+
+func selectorsFromList(path string) []selector {
+	file, err := os.Open(path)
+	if err != nil {
+		return nil
+	}
+	defer file.Close()
+	var out []selector
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		fields := strings.Fields(line)
+		for _, f := range fields {
+			if s, ok := parseSelector(strings.Trim(f, `",'`)); ok {
+				out = appendUnique(out, s)
+				break
+			}
+		}
+	}
+	return out
+}
+
+func parseSelector(raw string) (selector, bool) {
+	if !strings.Contains(raw, "::") {
+		return selector{}, false
+	}
+	parts := strings.SplitN(raw, "::", 2)
+	path := strings.TrimSpace(parts[0])
+	leaf := strings.TrimSpace(parts[1])
+	if path == "" || leaf == "" || strings.Contains(leaf, "::") {
+		return selector{}, false
+	}
+	return selector{Path: path, Leaf: leaf}, true
+}
+
+func appendUnique(out []selector, s selector) []selector {
+	for _, existing := range out {
+		if existing == s {
+			return out
+		}
+	}
+	return append(out, s)
+}
+
+func runSelectors(root string, sels []selector) []testResult {
+	groups := map[string][]selector{}
+	var order []string
+	for _, s := range sels {
+		pkg := "./" + filepath.ToSlash(filepath.Dir(s.Path))
+		if _, ok := groups[pkg]; !ok {
+			order = append(order, pkg)
+		}
+		groups[pkg] = append(groups[pkg], s)
+	}
+	sort.Strings(order)
+
+	bySelector := map[string]testResult{}
+	for _, pkg := range order {
+		group := groups[pkg]
+		leaves := make([]string, 0, len(group))
+		for _, s := range group {
+			leaves = append(leaves, regexp.QuoteMeta(s.Leaf))
+		}
+		pattern := "^(" + strings.Join(leaves, "|") + ")$"
+		results, output := runPackage(root, pkg, pattern)
+		for _, s := range group {
+			if r, ok := results[s.Leaf]; ok {
+				bySelector[s.String()] = testResult{Selector: s, Action: r.action, Output: r.output, Elapsed: r.elapsed}
+				continue
+			}
+			reason := fmt.Sprintf("test %s was not collected in package %s", s.Leaf, pkg)
+			if strings.TrimSpace(output) != "" {
+				reason += "\n" + firstCause(output)
+			}
+			bySelector[s.String()] = testResult{Selector: s, Action: actionError, Output: reason}
+		}
+	}
+
+	out := make([]testResult, 0, len(sels))
+	for _, s := range sels {
+		if r, ok := bySelector[s.String()]; ok {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+type nativeResult struct {
+	action  string
+	output  string
+	elapsed float64
+}
+
+func runPackage(root, pkg, pattern string) (map[string]nativeResult, string) {
+	cmd := exec.Command("go", "test", "-json", "-count=1", "-run", pattern, pkg)
+	cmd.Dir = root
+	raw, err := cmd.CombinedOutput()
+	text := string(raw)
+	if err != nil && strings.TrimSpace(text) == "" {
+		text = err.Error()
+	}
+
+	results := map[string]nativeResult{}
+	var tail []string
+	scanner := bufio.NewScanner(strings.NewReader(text))
+	scanner.Buffer(make([]byte, 0, 1024*1024), 8*1024*1024)
+	for scanner.Scan() {
+		line := scanner.Text()
+		var event struct {
+			Action  string  `json:"Action"`
+			Test    string  `json:"Test"`
+			Output  string  `json:"Output"`
+			Elapsed float64 `json:"Elapsed"`
+		}
+		if jsonErr := json.Unmarshal([]byte(line), &event); jsonErr != nil {
+			tail = append(tail, line)
+			continue
+		}
+		if event.Test == "" {
+			if event.Output != "" && event.Action != "output" {
+				tail = append(tail, strings.TrimRight(event.Output, "\n"))
+			}
+			continue
+		}
+		if event.Action == "output" {
+			existing := results[event.Test]
+			existing.output += event.Output
+			results[event.Test] = existing
+			continue
+		}
+		switch event.Action {
+		case "pass", "fail", "skip":
+			existing := results[event.Test]
+			existing.action = event.Action
+			existing.elapsed = event.Elapsed
+			results[event.Test] = existing
+		}
+	}
+	cause := strings.Join(tail, "\n")
+	if strings.TrimSpace(cause) == "" {
+		cause = text
+	}
+	return results, cause
+}
+
+func firstCause(output string) string {
+	lines := strings.Split(output, "\n")
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" {
+			continue
+		}
+		if strings.Contains(trimmed, ".go:") || strings.Contains(strings.ToLower(trimmed), "error") ||
+			strings.Contains(trimmed, "cannot") || strings.Contains(trimmed, "undefined") {
+			return trimmed
+		}
+	}
+	if len(lines) > 0 {
+		return strings.TrimSpace(lines[0])
+	}
+	return "test was not executed"
+}
+
+type junitTestCase struct {
+	XMLName   xml.Name      `xml:"testcase"`
+	Name      string        `xml:"name,attr"`
+	Classname string        `xml:"classname,attr"`
+	Time      string        `xml:"time,attr"`
+	Failure   *junitMessage `xml:"failure,omitempty"`
+	Error     *junitMessage `xml:"error,omitempty"`
+	Skipped   *junitMessage `xml:"skipped,omitempty"`
+	Output    string        `xml:"system-out,omitempty"`
+}
+
+type junitMessage struct {
+	Type    string `xml:"type,attr,omitempty"`
+	Message string `xml:"message,attr"`
+	Body    string `xml:",chardata"`
+}
+
+type junitTestSuite struct {
+	XMLName  xml.Name        `xml:"testsuite"`
+	Name     string          `xml:"name,attr"`
+	Tests    int             `xml:"tests,attr"`
+	Failures int             `xml:"failures,attr"`
+	Errors   int             `xml:"errors,attr"`
+	Skipped  int             `xml:"skipped,attr"`
+	Time     string          `xml:"time,attr"`
+	Cases    []junitTestCase `xml:"testcase"`
+}
+
+type junitSuites struct {
+	XMLName xml.Name         `xml:"testsuites"`
+	Suites  []junitTestSuite `xml:"testsuite"`
+}
+
+// failureMessage summarises the assertion that stopped the test so the JUnit
+// failure element carries the native message, not only the selector label.
+func failureMessage(r testResult) string {
+	for _, line := range strings.Split(r.Output, "\n") {
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" || strings.HasPrefix(trimmed, "=== RUN") || strings.HasPrefix(trimmed, "--- FAIL") {
+			continue
+		}
+		if len(trimmed) > 300 {
+			trimmed = trimmed[:300]
+		}
+		return trimmed
+	}
+	return fmt.Sprintf("%s failed", r.Selector.String())
+}
+
+// nativeFailureType recognizes Go runtime diagnostics, not assertion wording.
+func nativeFailureType(output string) string {
+	for _, line := range strings.Split(output, "\n") {
+		if strings.HasPrefix(line, "panic: test timed out") {
+			return "Timeout"
+		}
+		if strings.HasPrefix(line, "panic:") || strings.HasPrefix(line, "fatal error:") ||
+			strings.HasPrefix(line, "SIGSEGV:") || strings.HasPrefix(line, "SIGABRT:") ||
+			strings.HasPrefix(line, "SIGBUS:") || strings.HasPrefix(line, "SIGILL:") {
+			return "Process Crash"
+		}
+	}
+	return ""
+}
+
+func writeJUnit(path string, results []testResult) error {
+	suite := junitTestSuite{Name: "f2p", Tests: len(results)}
+	var total float64
+	for _, r := range results {
+		tc := junitTestCase{
+			Name:      r.Selector.String(),
+			Classname: filepath.Dir(r.Selector.Path),
+			Time:      fmt.Sprintf("%.3f", r.Elapsed),
+		}
+		total += r.Elapsed
+		switch r.Action {
+		case actionPass:
+		case actionFail:
+			if kind := nativeFailureType(r.Output); kind != "" {
+				suite.Errors++
+				tc.Error = &junitMessage{Type: kind, Message: kind}
+				// Keep native diagnostics without letting stack paths redefine the error type.
+				tc.Output = r.Output
+			} else {
+				suite.Failures++
+				// A completed testing.T failure is an assertion.
+				tc.Failure = &junitMessage{Type: "AssertionError", Message: failureMessage(r), Body: r.Output}
+			}
+		case actionSkip:
+			suite.Skipped++
+			tc.Skipped = &junitMessage{Message: "skipped"}
+		default:
+			suite.Errors++
+			tc.Error = &junitMessage{Message: fmt.Sprintf("%s was not executed", r.Selector.String()), Body: r.Output}
+		}
+		suite.Cases = append(suite.Cases, tc)
+	}
+	suite.Time = fmt.Sprintf("%.3f", total)
+
+	doc := junitSuites{Suites: []junitTestSuite{suite}}
+	data, err := xml.MarshalIndent(doc, "", "  ")
+	if err != nil {
+		return err
+	}
+	if dir := filepath.Dir(path); dir != "" {
+		_ = os.MkdirAll(dir, 0o755)
+	}
+	return os.WriteFile(path, append([]byte(xml.Header), data...), 0o644)
+}
