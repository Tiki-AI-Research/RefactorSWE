+// ---------------------------------------------------------------------------
+// Notification-path wiring: the frozen entry points must delegate into the
+// collaborator that owns the relocated state.
+// ---------------------------------------------------------------------------
+
+// f2pR3RequireStateOwner returns the interaction collaborator type that is
+// stored in a frame field and declares the relocated pointer-interaction state.
+func f2pR3RequireStateOwner(t *testing.T, pkg *f2pR3Package, why string) string {
+	t.Helper()
+	owner := pkg.f2pR3FindStateOwner()
+	if len(pkg.uncertainInterfaces) > 0 {
+		t.Skipf("unsupported ambiguous production interface bindings: %v", pkg.uncertainInterfaces)
+	}
+	if owner == "" {
+		t.Fatalf("no win package type held by a frame field declares the relocated pointer-interaction state: %s (REQ-STRUCT-001)", why)
+	}
+	return owner
+}
+
+func TestF2PInteractionStateOwnedByFrameHeldCollaborator(t *testing.T) {
+	pkg := f2pR3LoadPackage(t)
+	owner := f2pR3RequireStateOwner(t, pkg, "the pointer-interaction state machine must move out of the frame into a collaborator the frame holds")
+	info := pkg.types[owner]
+	family := func(names ...string) string {
+		for _, name := range names {
+			if pkg.hasStateRole(info, name) {
+				return name
+			}
+		}
+		return ""
+	}
+	if family("mouseX", "mouseY") == "" {
+		t.Fatalf("frame-held interaction collaborator %s does not own the drag-origin state (mouseX/mouseY): REQ-STRUCT-001 requires the state machine to move with the collaborator", owner)
+	}
+	if family("moveX", "moveY") == "" {
+		t.Fatalf("frame-held interaction collaborator %s does not own the accumulated move offset state (moveX/moveY): REQ-STRUCT-001", owner)
+	}
+	if family("resizeStartX", "resizeStartY") == "" {
+		t.Fatalf("frame-held interaction collaborator %s does not own the resize start geometry state (resizeStartX/resizeStartY): REQ-STRUCT-001", owner)
+	}
+	if family("hovered") == "" {
+		t.Fatalf("frame-held interaction collaborator %s does not own the hover tracking state (hovered): REQ-STRUCT-001", owner)
+	}
+	if family("clickCount", "cancelFunc") == "" {
+		t.Fatalf("frame-held interaction collaborator %s does not own the double-click detection state (clickCount/cancelFunc): REQ-STRUCT-001", owner)
+	}
+	families := []struct {
+		what   string
+		fields []string
+	}{
+		{"drag-origin", []string{"mouseX", "mouseY"}},
+		{"move-accumulator", []string{"moveX", "moveY"}},
+		{"resize-start-geometry", []string{"resizeStartX", "resizeStartY", "resizeStartWidth", "resizeStartHeight"}},
+		{"hover-tracking", []string{"hovered"}},
+		{"double-click-detection", []string{"clickCount", "cancelFunc"}},
+	}
+	closure := f2pR3NotificationClosure(pkg)
+	for _, family := range families {
+		if !f2pR3OwnerFamilyWired(pkg, owner, family.fields, closure) {
+			t.Fatalf("frame-held interaction collaborator %s owns the %s state but no %s handler reachable from the four frozen pointer notifications reads or writes it: the state machine must move into the collaborator and stay wired to the notification path (REQ-STRUCT-001)", owner, family.what, owner)
+		}
+	}
+}
+
+// f2pR3OwnerTouchesFields reports whether any method declared on the owner type
+// reads or writes one of the named receiver fields.
+func f2pR3OwnerTouchesFields(pkg *f2pR3Package, owner string, names []string) bool {
+	fields := map[string]bool{}
+	for _, name := range names {
+		fields[name] = true
+	}
+	for _, fi := range pkg.methods[owner] {
+		writes, reads := f2pR3Access(pkg, fi, fields)
+		if len(writes) > 0 || len(reads) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// f2pR3NotificationClosure unions the call closures of the four frozen
+// window-client pointer notifications.
+func f2pR3NotificationClosure(pkg *f2pR3Package) map[string]*f2pR3Func {
+	out := map[string]*f2pR3Func{}
+	for _, spec := range []f2pR3NotifySpec{f2pR3DragNotify, f2pR3MotionNotify, f2pR3PressNotify, f2pR3ReleaseNotify} {
+		notify := pkg.f2pR3ClientMethod(spec.notify)
+		if notify == nil {
+			continue
+		}
+		for symbol, reached := range pkg.f2pR3Reachable(notify) {
+			out[symbol] = reached
+		}
+	}
+	return out
+}
+
+// f2pR3OwnerFamilyWired reports whether a handler of the owner type that is
+// actually reachable from one of the frozen notifications reads or writes one
+// of the named state fields.
+func f2pR3OwnerFamilyWired(pkg *f2pR3Package, owner string, names []string, closure map[string]*f2pR3Func) bool {
+	fields := map[string]bool{}
+	for _, name := range names {
+		fields[name] = true
+	}
+	for _, fi := range closure {
+		if !pkg.ownedTypes(owner)[fi.recvType] {
+			continue
+		}
+		writes, reads := f2pR3Access(pkg, fi, fields)
+		if len(writes) > 0 || len(reads) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+type f2pR3NotifySpec struct {
+	notify  string
+	wantSig []string
+}
+
+var (
+	f2pR3DragNotify    = f2pR3NotifySpec{notify: "NotifyMouseDrag", wantSig: []string{"int16", "int16"}}
+	f2pR3MotionNotify  = f2pR3NotifySpec{notify: "NotifyMouseMotion", wantSig: []string{"int16", "int16"}}
+	f2pR3PressNotify   = f2pR3NotifySpec{notify: "NotifyMousePress", wantSig: []string{"int16", "int16", "xproto.Button"}}
+	f2pR3ReleaseNotify = f2pR3NotifySpec{notify: "NotifyMouseRelease", wantSig: []string{"int16", "int16", "xproto.Button"}}
+)
+
+func (pkg *f2pR3Package) f2pR3ClientMethod(name string) *f2pR3Func {
+	if pkg.methods["client"] == nil {
+		return nil
+	}
+	return pkg.methods["client"][name]
+}
+
+func f2pR3ParamNames(fi *f2pR3Func) []string {
+	var out []string
+	if fi.decl.Type.Params == nil {
+		return out
+	}
+	for _, field := range fi.decl.Type.Params.List {
+		for _, name := range field.Names {
+			out = append(out, name.Name)
+		}
+	}
+	return out
+}
