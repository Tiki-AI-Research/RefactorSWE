+// f2pR3PureTestDrives reports whether some X-connection-free solution unit test
+// calls a declaration from the given production decision set and contains real
+// assertions.
+func f2pR3PureTestDrives(t *testing.T, pkg *f2pR3Package, candidates map[string]*f2pR3Func) bool {
+	t.Helper()
+	for _, file := range pkg.f2pR3PureCandidateFiles() {
+		for _, fi := range pkg.f2pR3TestFuncsInFile(file) {
+			if f2pR3AssertionCount(pkg, fi) == 0 {
+				continue
+			}
+			reached := pkg.f2pR3Reachable(fi)
+			for symbol := range candidates {
+				if reached[symbol] != nil && f2pR3RunPureTest(t, fi) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
