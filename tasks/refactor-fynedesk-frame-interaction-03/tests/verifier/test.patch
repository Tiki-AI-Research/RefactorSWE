+// ---------------------------------------------------------------------------
+// Source analysis engine.
+//
+// The engine parses every package file (production and test) into struct and
+// interface declarations, method declarations and package-level function
+// declarations, and resolves field chains and call targets syntactically with a
+// small type environment. It is strong enough to follow the compiled frame's
+// field graph into a collaborator and to prove that a handler reached from a
+// frozen notification actually reads or writes the relocated state.
+// ---------------------------------------------------------------------------
+
+type f2pR3Type struct {
+	underlying ast.Expr
+	isAlias    bool
+	name       string
+	isStruct   bool
+	isIface    bool
+	fields     map[string]ast.Expr
+	iface      map[string]bool
+	file       string
+}
+
+type f2pR3Func struct {
+	decl     *ast.FuncDecl
+	file     string
+	recvType string
+	isTest   bool
+}
+
+func (f *f2pR3Func) symbol() string {
+	if f.recvType == "" {
+		return f.decl.Name.Name
+	}
+	return f.recvType + "." + f.decl.Name.Name
+}
+
+type f2pR3Package struct {
+	dir     string
+	types   map[string]*f2pR3Type
+	methods map[string]map[string]*f2pR3Func
+	funcs   map[string][]*f2pR3Func
+	imports map[string]map[string]string
+	// Actual receiver fields mapped to semantic drag-origin roles.
+	originRoles         map[string]map[string]string
+	interfaceBindings   map[string]map[string]bool
+	uncertainInterfaces map[string]bool
+}
+
+func f2pR3PackageDir(t *testing.T) string {
+	t.Helper()
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("f2p: cannot resolve the package directory of this test file")
+	}
+	return filepath.Dir(file)
+}
+
+func f2pR3LoadPackage(t *testing.T) *f2pR3Package {
+	t.Helper()
+	dir := f2pR3PackageDir(t)
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatalf("f2p: cannot read package directory %s: %v", dir, err)
+	}
+	pkg := &f2pR3Package{
+		dir:     dir,
+		types:   map[string]*f2pR3Type{},
+		methods: map[string]map[string]*f2pR3Func{},
+		funcs:   map[string][]*f2pR3Func{},
+		imports: map[string]map[string]string{},
+	}
+	fset := token.NewFileSet()
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasSuffix(name, ".go") {
+			continue
+		}
+		file, err := parser.ParseFile(fset, filepath.Join(dir, name), nil, parser.SkipObjectResolution)
+		if err != nil {
+			t.Fatalf("f2p: cannot parse package file %s: %v", name, err)
+		}
+		if pkg.imports[name] == nil {
+			pkg.imports[name] = map[string]string{}
+		}
+		for _, imported := range file.Imports {
+			path := strings.Trim(imported.Path.Value, `"`)
+			alias := ""
+			if imported.Name != nil {
+				alias = imported.Name.Name
+			} else if idx := strings.LastIndex(path, "/"); idx >= 0 {
+				alias = path[idx+1:]
+			} else {
+				alias = path
+			}
+			if alias == "_" || alias == "." || alias == "" {
+				continue
+			}
+			pkg.imports[name][alias] = path
+		}
+		isTest := strings.HasSuffix(name, "_test.go")
+		for _, decl := range file.Decls {
+			switch d := decl.(type) {
+			case *ast.GenDecl:
+				for _, spec := range d.Specs {
+					ts, ok := spec.(*ast.TypeSpec)
+					if !ok {
+						continue
+					}
+					info := &f2pR3Type{name: ts.Name.Name, file: name, fields: map[string]ast.Expr{}, iface: map[string]bool{}}
+					info.underlying = ts.Type
+					info.isAlias = ts.Assign.IsValid()
+					switch typ := ts.Type.(type) {
+					case *ast.StructType:
+						info.isStruct = true
+						for _, field := range typ.Fields.List {
+							if len(field.Names) == 0 {
+								info.fields[f2pR3ExprBaseName(field.Type)] = field.Type
+							}
+							for _, fieldName := range field.Names {
+								info.fields[fieldName.Name] = field.Type
+							}
+						}
+					case *ast.InterfaceType:
+						info.isIface = true
+						for _, method := range typ.Methods.List {
+							for _, methodName := range method.Names {
+								info.iface[methodName.Name] = true
+							}
+						}
+					}
+					pkg.types[info.name] = info
+				}
+			case *ast.FuncDecl:
+				fi := &f2pR3Func{decl: d, file: name, recvType: f2pR3ReceiverTypeName(d.Recv), isTest: isTest}
+				if fi.recvType == "" {
+					pkg.funcs[d.Name.Name] = append(pkg.funcs[d.Name.Name], fi)
+				} else {
+					if pkg.methods[fi.recvType] == nil {
+						pkg.methods[fi.recvType] = map[string]*f2pR3Func{}
+					}
+					pkg.methods[fi.recvType][d.Name.Name] = fi
+				}
+			}
+		}
+	}
+	pkg.resolveNamedUnderlyingTypes()
+	pkg.inferInterfaceBindings()
+	pkg.uncertainInterfaces = map[string]bool{}
+	pkg.inferOriginRoles()
+	pkg.inferAdditionalRoles()
+	return pkg
+}
+
+// inferOriginRoles derives each saved pointer coordinate from its use: a press
+// parameter is stored in receiver state, and a drag parameter is subtracted
+// from that saved state. No list of acceptable private field names is used.
+func (pkg *f2pR3Package) inferOriginRoles() {
+	pkg.originRoles = map[string]map[string]string{}
+	press := pkg.f2pR3ClientMethod("NotifyMousePress")
+	drag := pkg.f2pR3ClientMethod("NotifyMouseDrag")
+	if press == nil || drag == nil {
+		return
+	}
+	stores := map[string]map[string]int{}
+	params := func(fi *f2pR3Func) []string {
+		var out []string
+		if fi.decl.Type.Params != nil {
+			for _, f := range fi.decl.Type.Params.List {
+				for _, n := range f.Names {
+					out = append(out, n.Name)
+				}
+			}
+		}
+		return out
+	}
+	for _, fi := range pkg.f2pR3Reachable(press) {
+		if fi.isTest || fi.recvType == "" {
+			continue
+		}
+		names := params(fi)
+		if len(names) < 2 {
+			continue
+		}
+		env := f2pR3EnvFor(pkg, fi)
+		ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+			a, ok := n.(*ast.AssignStmt)
+			if !ok {
+				return true
+			}
+			for i, lhs := range a.Lhs {
+				if i >= len(a.Rhs) {
+					continue
+				}
+				sel, ok := lhs.(*ast.SelectorExpr)
+				if !ok {
+					continue
+				}
+				typ, _ := env.exprType(sel.X)
+				if typ != fi.recvType {
+					continue
+				}
+				rhs, ok := a.Rhs[i].(*ast.Ident)
+				if !ok {
+					continue
+				}
+				for axis := 0; axis < 2; axis++ {
+					if rhs.Name == names[axis] {
+						if stores[typ] == nil {
+							stores[typ] = map[string]int{}
+						}
+						stores[typ][sel.Sel.Name] = axis + 1
+					}
+				}
+			}
+			return true
+		})
+	}
+	for _, fi := range pkg.f2pR3Reachable(drag) {
+		if fi.isTest || fi.recvType == "" {
+			continue
+		}
+		names := params(fi)
+		if len(names) < 2 {
+			continue
+		}
+		env := f2pR3EnvFor(pkg, fi)
+		// Unlike resize-start coordinates, the last pointer origin is also
+		// advanced to the incoming coordinates by the drag handler itself.
+		updated := map[string]int{}
+		ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+			a, ok := n.(*ast.AssignStmt)
+			if !ok {
+				return true
+			}
+			for j, lhs := range a.Lhs {
+				if j >= len(a.Rhs) {
+					continue
+				}
+				sel, ok := lhs.(*ast.SelectorExpr)
+				if !ok {
+					continue
+				}
+				typ, _ := env.exprType(sel.X)
+				if typ != fi.recvType {
+					continue
+				}
+				input, ok := a.Rhs[j].(*ast.Ident)
+				if !ok {
+					continue
+				}
+				for axis := 0; axis < 2; axis++ {
+					if input.Name == names[axis] {
+						updated[sel.Sel.Name] = axis + 1
+					}
+				}
+			}
+			return true
+		})
+		ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+			b, ok := n.(*ast.BinaryExpr)
+			if !ok || b.Op != token.SUB {
+				return true
+			}
+			input, ok := b.X.(*ast.Ident)
+			if !ok {
+				return true
+			}
+			saved, ok := b.Y.(*ast.SelectorExpr)
+			if !ok {
+				return true
+			}
+			typ, _ := env.exprType(saved.X)
+			for axis, role := range []string{"mouseX", "mouseY"} {
+				if input.Name == names[axis] && stores[typ][saved.Sel.Name] == axis+1 && updated[saved.Sel.Name] == axis+1 {
+					if pkg.originRoles[typ] == nil {
+						pkg.originRoles[typ] = map[string]string{}
+					}
+					pkg.originRoles[typ][saved.Sel.Name] = role
+				}
+			}
+			return true
+		})
+	}
+}
+
+func (pkg *f2pR3Package) stateRole(typ, field string) string {
+	if role := pkg.originRoles[typ][field]; role != "" {
+		return role
+	}
+	return field
+}
+
+func (pkg *f2pR3Package) hasStateRole(info *f2pR3Type, role string) bool {
+	if info == nil {
+		return false
+	}
+	for typ := range pkg.ownedTypes(info.name) {
+		for field := range pkg.types[typ].fields {
+			if pkg.stateRole(typ, field) == role {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func f2pR3AssertControlledGeometry(t *testing.T, pkg *f2pR3Package, owner string) {
+	t.Helper()
+	closure := f2pR3NotificationClosure(pkg)
+	seen := map[*f2pR3Func]bool{}
+	var visit func(*f2pR3Func)
+	visit = func(fi *f2pR3Func) {
+		if fi == nil || seen[fi] || fi.isTest || fi.recvType == "frame" {
+			return
+		}
+		// Client lifecycle and decoration methods have their own responsibilities.
+		if fi.recvType == "client" {
+			return
+		}
+		seen[fi] = true
+		env := f2pR3EnvFor(pkg, fi)
+		ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+			if sel, ok := n.(*ast.SelectorExpr); ok {
+				typ, _ := env.exprType(sel.X)
+				if typ == "frame" {
+					field := pkg.types["frame"].fields[sel.Sel.Name]
+					name := f2pR3ExprBaseName(field)
+					if name == "int16" || name == "uint16" {
+						t.Errorf("interaction path %s directly accesses frame geometry %s; use a controlled frame geometry surface", fi.symbol(), sel.Sel.Name)
+					}
+					if _, channel := field.(*ast.ChanType); channel {
+						t.Errorf("interaction path %s directly accesses frame queue %s; use the geometry queueing surface", fi.symbol(), sel.Sel.Name)
+					}
+				}
+			}
+			if call, ok := n.(*ast.CallExpr); ok {
+				if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+					base, _ := env.exprType(sel.X)
+					if info := pkg.types[base]; info != nil && info.isIface {
+						return true
+					}
+				}
+				visit(pkg.resolveCallee(env, call))
+			}
+			return true
+		})
+	}
+	for _, fi := range closure {
+		if fi.recvType == owner {
+			visit(fi)
+		}
+	}
+}
+
+func f2pR3ReceiverTypeName(recv *ast.FieldList) string {
+	if recv == nil || len(recv.List) == 0 {
+		return ""
+	}
+	return f2pR3ExprBaseName(recv.List[0].Type)
+}
+
+func f2pR3ReceiverIdent(decl *ast.FuncDecl) string {
+	if decl.Recv == nil || len(decl.Recv.List) == 0 || len(decl.Recv.List[0].Names) == 0 {
+		return ""
+	}
+	return decl.Recv.List[0].Names[0].Name
+}
+
+func f2pR3ExprBaseName(expr ast.Expr) string {
+	switch typed := expr.(type) {
+	case *ast.StarExpr:
+		return f2pR3ExprBaseName(typed.X)
+	case *ast.ParenExpr:
+		return f2pR3ExprBaseName(typed.X)
+	case *ast.IndexExpr:
+		return f2pR3ExprBaseName(typed.X)
+	case *ast.IndexListExpr:
+		return f2pR3ExprBaseName(typed.X)
+	case *ast.Ident:
+		return typed.Name
+	}
+	return ""
+}
+
+// f2pR3ExprTypeName resolves a type expression to a comparable name. Package
+// qualified types are normalised to "alias.Name" using the file's import map so
+// aliases do not matter.
+func f2pR3ExprTypeName(pkg *f2pR3Package, file string, expr ast.Expr) string {
+	switch typed := expr.(type) {
+	case *ast.StarExpr:
+		return f2pR3ExprTypeName(pkg, file, typed.X)
+	case *ast.ParenExpr:
+		return f2pR3ExprTypeName(pkg, file, typed.X)
+	case *ast.ArrayType, *ast.ChanType:
+		return ""
+	case *ast.Ellipsis:
+		return f2pR3ExprTypeName(pkg, file, typed.Elt)
+	case *ast.Ident:
+		return typed.Name
+	case *ast.SelectorExpr:
+		if base, ok := typed.X.(*ast.Ident); ok {
+			path := pkg.imports[file][base.Name]
+			if strings.HasSuffix(path, "/xproto") || path == "github.com/BurntSushi/xgb/xproto" {
+				return "xproto." + typed.Sel.Name
+			}
+			if path != "" {
+				return base.Name + "." + typed.Sel.Name
+			}
+		}
+		return typed.Sel.Name
+	case *ast.IndexExpr:
+		return f2pR3ExprTypeName(pkg, file, typed.X)
+	case *ast.IndexListExpr:
+		return f2pR3ExprTypeName(pkg, file, typed.X)
+	}
+	return ""
+}
+
+// f2pR3QualifiedType resolves a type expression to (import path, type name).
+func f2pR3QualifiedType(pkg *f2pR3Package, file string, expr ast.Expr) (string, string) {
+	switch typed := expr.(type) {
+	case *ast.StarExpr:
+		return f2pR3QualifiedType(pkg, file, typed.X)
+	case *ast.ParenExpr:
+		return f2pR3QualifiedType(pkg, file, typed.X)
+	case *ast.Ident:
+		return "", typed.Name
+	case *ast.SelectorExpr:
+		if base, ok := typed.X.(*ast.Ident); ok {
+			return pkg.imports[file][base.Name], typed.Sel.Name
+		}
+		return "", typed.Sel.Name
+	case *ast.IndexExpr:
+		return f2pR3QualifiedType(pkg, file, typed.X)
+	case *ast.IndexListExpr:
+		return f2pR3QualifiedType(pkg, file, typed.X)
+	}
+	return "", ""
+}
+
+type f2pR3Env struct {
+	pkg    *f2pR3Package
+	vars   map[string]string
+	inTest bool
+}
+
+func f2pR3EnvFor(pkg *f2pR3Package, fi *f2pR3Func) *f2pR3Env {
+	env := &f2pR3Env{pkg: pkg, vars: map[string]string{}, inTest: fi.isTest}
+	decl := fi.decl
+	if name := f2pR3ReceiverIdent(decl); name != "" {
+		env.vars[name] = fi.recvType
+	}
+	if decl.Type.Params != nil {
+		for _, field := range decl.Type.Params.List {
+			typeName := f2pR3NamedType(pkg, f2pR3ExprBaseName(field.Type))
+			for _, name := range field.Names {
+				env.vars[name.Name] = typeName
+			}
+		}
+	}
+	for pass := 0; pass < 2; pass++ {
+		ast.Inspect(decl.Body, func(n ast.Node) bool {
+			switch stmt := n.(type) {
+			case *ast.AssignStmt:
+				f2pR3BindAssign(pkg, env, stmt)
+			case *ast.ValueSpec:
+				if stmt.Type != nil {
+					typeName := f2pR3NamedType(pkg, f2pR3ExprBaseName(stmt.Type))
+					for _, name := range stmt.Names {
+						env.vars[name.Name] = typeName
+					}
+					return true
+				}
+				for i, name := range stmt.Names {
+					if i < len(stmt.Values) {
+						if typeName, _ := env.exprType(stmt.Values[i]); typeName != "" {
+							env.vars[name.Name] = typeName
+						}
+					}
+				}
+			}
+			return true
+		})
+	}
+	return env
+}
+
+func f2pR3NamedType(pkg *f2pR3Package, name string) string {
+	if name == "" {
+		return ""
+	}
+	if info, ok := pkg.types[name]; ok {
+		if info.isAlias {
+			return f2pR3NamedType(pkg, f2pR3ExprBaseName(info.underlying))
+		}
+		return name
+	}
+	return ""
+}
+
+func f2pR3BindAssign(pkg *f2pR3Package, env *f2pR3Env, stmt *ast.AssignStmt) {
+	if stmt.Tok != token.DEFINE && stmt.Tok != token.ASSIGN {
+		return
+	}
+	if len(stmt.Rhs) == 1 && len(stmt.Lhs) > 1 {
+		call, ok := stmt.Rhs[0].(*ast.CallExpr)
+		if !ok {
+			return
+		}
+		results := f2pR3CallResultTypes(pkg, env, call)
+		if len(results) != len(stmt.Lhs) {
+			return
+		}
+		for i, lhs := range stmt.Lhs {
+			if ident, ok := lhs.(*ast.Ident); ok && ident.Name != "_" {
+				env.vars[ident.Name] = results[i]
+			}
+		}
+		return
+	}
+	for i, lhs := range stmt.Lhs {
+		if i >= len(stmt.Rhs) {
+			break
+		}
+		ident, ok := lhs.(*ast.Ident)
+		if !ok || ident.Name == "_" {
+			continue
+		}
+		if typeName, _ := env.exprType(stmt.Rhs[i]); typeName != "" {
+			env.vars[ident.Name] = typeName
+		}
+	}
+}
+
+func (env *f2pR3Env) exprType(expr ast.Expr) (string, int) {
+	switch typed := expr.(type) {
+	case *ast.Ident:
+		return env.vars[typed.Name], 1
+	case *ast.ParenExpr:
+		return env.exprType(typed.X)
+	case *ast.StarExpr:
+		return env.exprType(typed.X)
+	case *ast.UnaryExpr:
+		if typed.Op == token.AND {
+			return env.exprType(typed.X)
+		}
+		return "", 1
+	case *ast.CompositeLit:
+		return f2pR3NamedType(env.pkg, f2pR3ExprBaseName(typed.Type)), 1
+	case *ast.SelectorExpr:
+		base, _ := env.exprType(typed.X)
+		if base == "" {
+			return "", 1
+		}
+		info := env.pkg.types[base]
+		if info == nil || !info.isStruct {
+			return "", 1
+		}
+		_, fieldType := env.pkg.lookupField(base, typed.Sel.Name, map[string]bool{})
+		if fieldType == nil {
+			return "", 1
+		}
+		return f2pR3NamedType(env.pkg, f2pR3ExprBaseName(fieldType)), 1
+	case *ast.CallExpr:
+		results := f2pR3CallResultTypes(env.pkg, env, typed)
+		if len(results) > 0 {
+			return results[0], len(results)
+		}
+		return "", 1
+	case *ast.IndexExpr:
+		return env.exprType(typed.X)
+	case *ast.IndexListExpr:
+		return env.exprType(typed.X)
+	}
+	return "", 1
+}
+
+func f2pR3CallResultTypes(pkg *f2pR3Package, env *f2pR3Env, call *ast.CallExpr) []string {
+	target := pkg.resolveCallee(env, call)
+	if target == nil {
+		return nil
+	}
+	return f2pR3ResultTypeNames(pkg, target)
+}
+
+func f2pR3ResultTypeNames(pkg *f2pR3Package, fi *f2pR3Func) []string {
+	if fi.decl.Type.Results == nil {
+		return nil
+	}
+	var out []string
+	for _, field := range fi.decl.Type.Results.List {
+		name := f2pR3NamedType(pkg, f2pR3ExprBaseName(field.Type))
+		count := len(field.Names)
+		if count == 0 {
+			count = 1
+		}
+		for i := 0; i < count; i++ {
+			out = append(out, name)
+		}
+	}
+	return out
+}
+
+func (pkg *f2pR3Package) resolveCallee(env *f2pR3Env, call *ast.CallExpr) *f2pR3Func {
+	switch fun := call.Fun.(type) {
+	case *ast.Ident:
+		if _, isVar := env.vars[fun.Name]; isVar {
+			return nil
+		}
+		return pkg.chooseFunc(fun.Name, env.inTest)
+	case *ast.SelectorExpr:
+		base, _ := env.exprType(fun.X)
+		if base == "" {
+			return nil
+		}
+		if methods := pkg.methods[base]; methods != nil {
+			if target := methods[fun.Sel.Name]; target != nil {
+				return target
+			}
+		}
+		if bound := pkg.boundType(base); bound != "" {
+			return pkg.methods[bound][fun.Sel.Name]
+		}
+		return nil
+	case *ast.ParenExpr:
+		if inner, ok := fun.X.(*ast.CallExpr); ok {
+			return pkg.resolveCallee(env, inner)
+		}
+	}
+	return nil
+}
+
+func (pkg *f2pR3Package) chooseFunc(name string, preferTest bool) *f2pR3Func {
+	candidates := pkg.funcs[name]
+	if len(candidates) == 0 {
+		return nil
+	}
+	sorted := append([]*f2pR3Func(nil), candidates...)
+	sort.Slice(sorted, func(i, j int) bool {
+		if sorted[i].isTest != sorted[j].isTest {
+			if preferTest {
+				return sorted[i].isTest
+			}
+			return !sorted[i].isTest
+		}
+		return sorted[i].file < sorted[j].file
+	})
+	return sorted[0]
+}
+
+// f2pR3Reachable follows call expressions from start through package methods
+// and functions and returns every reachable declaration (excluding the start).
+func (pkg *f2pR3Package) f2pR3Reachable(start *f2pR3Func) map[string]*f2pR3Func {
+	out := map[string]*f2pR3Func{}
+	queue := []*f2pR3Func{start}
+	seen := map[*f2pR3Func]bool{start: true}
+	for len(queue) > 0 {
+		fi := queue[0]
+		queue = queue[1:]
+		env := f2pR3EnvFor(pkg, fi)
+		if fi.decl.Body == nil {
+			continue
+		}
+		ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+			call, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			child := pkg.resolveCallee(env, call)
+			if child == nil {
+				return true
+			}
+			out[child.symbol()] = child
+			if !seen[child] {
+				seen[child] = true
+				queue = append(queue, child)
+			}
+			return true
+		})
+	}
+	return out
+}
+
+func (pkg *f2pR3Package) findMethodByName(name string) *f2pR3Func {
+	types := make([]string, 0, len(pkg.methods))
+	for typeName := range pkg.methods {
+		types = append(types, typeName)
+	}
+	sort.Strings(types)
+	for _, typeName := range types {
+		if target := pkg.methods[typeName][name]; target != nil {
+			return target
+		}
+	}
+	return nil
+}
+
+// f2pR3Access reports which of the given fields a method writes and which it
+// reads through the receiver selector.
+func f2pR3Access(pkg *f2pR3Package, fi *f2pR3Func, fieldSet map[string]bool) (map[string]bool, map[string]bool) {
+	writes := map[string]bool{}
+	reads := map[string]bool{}
+	recv := f2pR3ReceiverIdent(fi.decl)
+	if recv == "" || fi.decl.Body == nil || len(fieldSet) == 0 {
+		return writes, reads
+	}
+	match := func(expr ast.Expr) (string, bool) {
+		selector, ok := expr.(*ast.SelectorExpr)
+		if !ok {
+			return "", false
+		}
+		root := ast.Expr(selector.X)
+		for {
+			child, ok := root.(*ast.SelectorExpr)
+			if !ok {
+				break
+			}
+			root = child.X
+		}
+		ident, ok := root.(*ast.Ident)
+		if !ok || ident.Name != recv {
+			return "", false
+		}
+		env := f2pR3EnvFor(pkg, fi)
+		base, _ := env.exprType(selector.X)
+		declaring, _ := pkg.lookupField(base, selector.Sel.Name, map[string]bool{})
+		if !pkg.ownedTypes(fi.recvType)[declaring] {
+			return "", false
+		}
+		role := pkg.stateRole(declaring, selector.Sel.Name)
+		if !fieldSet[role] {
+			return "", false
+		}
+		return role, true
+	}
+	collect := func(node ast.Node, into map[string]bool) {
+		ast.Inspect(node, func(n ast.Node) bool {
+			if expr, ok := n.(ast.Expr); ok {
+				if name, ok := match(expr); ok {
+					into[name] = true
+				}
+			}
+			return true
+		})
+	}
+	ast.Inspect(fi.decl.Body, func(n ast.Node) bool {
+		switch stmt := n.(type) {
+		case *ast.AssignStmt:
+			for _, lhs := range stmt.Lhs {
+				collect(lhs, writes)
+			}
+			if stmt.Tok != token.ASSIGN && stmt.Tok != token.DEFINE {
+				for _, lhs := range stmt.Lhs {
+					collect(lhs, reads)
+				}
+			}
+			for _, rhs := range stmt.Rhs {
+				collect(rhs, reads)
+			}
+			return false
+		case *ast.IncDecStmt:
+			collect(stmt.X, writes)
+			collect(stmt.X, reads)
+			return false
+		case *ast.SelectorExpr:
+			if name, ok := match(stmt); ok {
+				reads[name] = true
+			}
+		}
+		return true
+	})
+	return writes, reads
+}
+
+func f2pR3Touches(fieldSet map[string]bool) func(pkg *f2pR3Package, fi *f2pR3Func) bool {
+	return func(pkg *f2pR3Package, fi *f2pR3Func) bool {
+		writes, reads := f2pR3Access(pkg, fi, fieldSet)
+		return len(writes) > 0 || len(reads) > 0
+	}
+}
+
+// f2pR3SortedSymbols returns the deterministic key list of a reachable map.
+func f2pR3SortedSymbols(reachable map[string]*f2pR3Func) []string {
+	out := make([]string, 0, len(reachable))
+	for symbol := range reachable {
+		out = append(out, symbol)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Collaborator discovery through the compiled frame's field graph.
+// ---------------------------------------------------------------------------
+
+// f2pR3FrameFieldBaseTypes returns the package-local base type name of every
+// frame field (pointers and interfaces included), in declaration order.
+func f2pR3FrameFieldBaseTypes() []string {
+	var out []string
+	seen := map[string]bool{}
+	for i := 0; i < f2pR3FrameType.NumField(); i++ {
+		fieldType := f2pR3FrameType.Field(i).Type
+		if fieldType.Kind() == reflect.Interface {
+			name := fieldType.Name()
+			if name != "" && !seen[name] {
+				seen[name] = true
+				out = append(out, name)
+			}
+			continue
+		}
+		for fieldType.Kind() == reflect.Ptr {
+			fieldType = fieldType.Elem()
+		}
+		if fieldType.Kind() != reflect.Struct {
+			continue
+		}
+		name := fieldType.Name()
+		if name == "" || seen[name] {
+			continue
+		}
+		seen[name] = true
+		out = append(out, name)
+	}
+	return out
+}
+
+// f2pR3FindStateOwner returns the type stored in a frame field that declares at
+// least six relocated interaction state fields.
+func (pkg *f2pR3Package) f2pR3FindStateOwner() string {
+	for _, base := range f2pR3FrameFieldBaseTypes() {
+		if bound := pkg.boundType(base); bound != "" {
+			base = bound
+		}
+		info := pkg.types[base]
+		if info == nil || !info.isStruct {
+			continue
+		}
+		if pkg.hasStateRole(info, "mouseX") && pkg.hasStateRole(info, "hovered") && pkg.hasStateRole(info, "cancelFunc") {
+			return base
+		}
+	}
+	return ""
+}
+
+func (pkg *f2pR3Package) f2pR3StateOwnerImplementing(iface *f2pR3Type) string {
+	stateFields := f2pR3StateFieldSet()
+	names := make([]string, 0, len(pkg.types))
+	for name := range pkg.types {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		info := pkg.types[name]
+		if info == nil || !info.isStruct {
+			continue
+		}
+		implements := true
+		for method := range iface.iface {
+			if pkg.methods[name] == nil || pkg.methods[name][method] == nil {
+				implements = false
+				break
+			}
+		}
+		if !implements {
+			continue
+		}
+		count := 0
+		for fieldName := range info.fields {
+			if stateFields[pkg.stateRole(info.name, fieldName)] {
+				count++
+			}
+		}
+		if count >= 6 {
+			return name
+		}
+	}
+	return ""
+}
+
+// f2pR3FindDecorationOwner returns the collaborator type stored in a frame field
+// that owns both pixmap and graphics-context fields, together with those fields.
+func (pkg *f2pR3Package) f2pR3FindDecorationOwner() (string, string, map[string]bool, map[string]bool, bool) {
+	for _, base := range f2pR3FrameFieldBaseTypes() {
+		info := pkg.types[base]
+		if info == nil || !info.isStruct {
+			continue
+		}
+		pixmaps := map[string]bool{}
+		gcs := map[string]bool{}
+		for fieldName, fieldType := range info.fields {
+			path, typeName := f2pR3QualifiedType(pkg, info.file, fieldType)
+			if !strings.HasSuffix(path, "xproto") {
+				continue
+			}
+			switch typeName {
+			case "Pixmap":
+				pixmaps[fieldName] = true
+			case "Gcontext":
+				gcs[fieldName] = true
+			}
+		}
+		if len(pixmaps) > 0 && len(gcs) > 0 {
+			return base, pkg.f2pR3FrameFieldForType(base), pixmaps, gcs, true
+		}
+	}
+	return "", "", nil, nil, false
+}
+
+// f2pR3FrameFieldForType returns the name of the frame field holding the given
+// type (pointer or value).
+func (pkg *f2pR3Package) f2pR3FrameFieldForType(base string) string {
+	for i := 0; i < f2pR3FrameType.NumField(); i++ {
+		fieldType := f2pR3FrameType.Field(i).Type
+		for fieldType.Kind() == reflect.Ptr {
+			fieldType = fieldType.Elem()
+		}
+		if fieldType.Kind() == reflect.Struct && fieldType.Name() == base {
+			return f2pR3FrameType.Field(i).Name
+		}
+	}
+	return ""
+}
+
+// f2pR3Signature returns the parameter type names of a declaration.
+func f2pR3Signature(pkg *f2pR3Package, fi *f2pR3Func) []string {
+	var out []string
+	if fi.decl.Type.Params == nil {
+		return out
+	}
+	for _, field := range fi.decl.Type.Params.List {
+		typeName := f2pR3ExprTypeName(pkg, fi.file, field.Type)
+		count := len(field.Names)
+		if count == 0 {
+			count = 1
+		}
+		for i := 0; i < count; i++ {
+			out = append(out, typeName)
+		}
+	}
+	return out
+}
+
+func f2pR3HasResult(fi *f2pR3Func) bool {
+	return fi.decl.Type.Results != nil && len(fi.decl.Type.Results.List) > 0
+}
+
+func f2pR3SameSignature(pkg *f2pR3Package, fi *f2pR3Func, want []string) bool {
+	if f2pR3HasResult(fi) {
+		return false
+	}
+	got := f2pR3Signature(pkg, fi)
+	if len(got) != len(want) {
+		return false
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			return false
+		}
+	}
+	return true
+}
