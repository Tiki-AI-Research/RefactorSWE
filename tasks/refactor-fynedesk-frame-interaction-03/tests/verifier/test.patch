+func f2pR3DecisionFields() map[string]bool {
+	return map[string]bool{
+		"mouseX": true, "mouseY": true,
+		"moveX": true, "moveY": true,
+		"moveOnly":  true,
+		"resizeTop": true, "resizeBottom": true, "resizeLeft": true, "resizeRight": true,
+		"ignoreDrag": true,
+	}
+}
