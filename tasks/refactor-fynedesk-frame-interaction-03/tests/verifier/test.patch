+	x11.CloseCursor = 0x2002
+	x11.ResizeBottomCursor = 0x2003
+	x11.ResizeBottomLeftCursor = 0x2004
+	x11.ResizeBottomRightCursor = 0x2005
+	x11.ResizeLeftCursor = 0x2006
