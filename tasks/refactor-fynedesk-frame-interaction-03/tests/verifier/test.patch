+}
+
+type junitSuites struct {
+	XMLName xml.Name         `xml:"testsuites"`
+	Suites  []junitTestSuite `xml:"testsuite"`
+}
+
+// nativeFailureType recognizes Go runtime diagnostics, not assertion wording.
+func nativeFailureType(output string) string {
+	for _, line := range strings.Split(output, "\n") {
+		if strings.HasPrefix(line, "panic: test timed out") {
+			return "Timeout"
+		}
+		if strings.HasPrefix(line, "panic:") || strings.HasPrefix(line, "fatal error:") ||
+			strings.HasPrefix(line, "SIGSEGV:") || strings.HasPrefix(line, "SIGABRT:") ||
+			strings.HasPrefix(line, "SIGBUS:") || strings.HasPrefix(line, "SIGILL:") {
+			return "Process Crash"
+		}
+	}
+	return ""
+}
+
+func writeJUnit(path string, results []testResult) error {
+	suite := junitTestSuite{Name: "p2p", Tests: len(results)}
+	var total float64
+	for _, r := range results {
+		tc := junitTestCase{
+			Name:      r.Selector.String(),
+			Classname: filepath.Dir(r.Selector.Path),
+			Time:      fmt.Sprintf("%.3f", r.Elapsed),
+		}
+		total += r.Elapsed
+		switch r.Action {
+		case actionPass:
+		case actionFail:
+			if kind := nativeFailureType(r.Output); kind != "" {
+				suite.Errors++
+				tc.Error = &junitMessage{Type: kind, Message: kind}
+				// Keep native diagnostics without letting stack paths redefine the error type.
+				tc.Output = r.Output
+			} else {
+				suite.Failures++
+				// A completed testing.T failure is an assertion.
+				tc.Failure = &junitMessage{Type: "AssertionError", Message: fmt.Sprintf("%s failed", r.Selector.String()), Body: r.Output}
+			}
+		case actionSkip:
+			suite.Skipped++
+			tc.Skipped = &junitMessage{Message: "skipped"}
+		default:
+			suite.Errors++
+			tc.Error = &junitMessage{Message: fmt.Sprintf("%s was not executed", r.Selector.String()), Body: r.Output}
+		}
+		suite.Cases = append(suite.Cases, tc)
+	}
+	suite.Time = fmt.Sprintf("%.3f", total)
+
+	doc := junitSuites{Suites: []junitTestSuite{suite}}
+	data, err := xml.MarshalIndent(doc, "", "  ")
+	if err != nil {
+		return err
+	}
+	if dir := filepath.Dir(path); dir != "" {
+		_ = os.MkdirAll(dir, 0o755)
+	}
+	return os.WriteFile(path, append([]byte(xml.Header), data...), 0o644)
+}
