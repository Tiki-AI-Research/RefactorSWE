+func TestP2PTitleBarEdgeStripsSelectTopResize(t *testing.T) {
+	t.Run("successive-direction-reversals", p2pResizeDirectionReversals)
+	c := p2pLive(t, p2pClientOptions{Focused: true})
+	r := c.geometry()
+	titleY := int16(5)
