+// f2pR3PressDecisionDecls returns the production declarations on the frozen
+// press notification path that actually decide the press classification: state
+// owner handlers touching the press decision state, and pure helpers returning
+// the decision flags.
+func (pkg *f2pR3Package) f2pR3PressDecisionDecls(owner string) map[string]*f2pR3Func {
+	notify := pkg.f2pR3ClientMethod("NotifyMousePress")
+	if notify == nil {
+		return nil
+	}
+	decision := f2pR3DecisionFields()
+	stateFields := f2pR3StateFieldSet()
+	out := map[string]*f2pR3Func{}
+	for symbol, fi := range pkg.f2pR3Reachable(notify) {
+		if fi.isTest {
+			continue
+		}
+		if fi.recvType == owner {
+			writes, reads := f2pR3Access(pkg, fi, stateFields)
+			for name := range decision {
+				if writes[name] || reads[name] {
+					out[symbol] = fi
+					break
+				}
+			}
+			continue
+		}
+		if fi.recvType != "" {
+			continue
+		}
+		results := f2pR3ResultTypeNames(pkg, fi)
+		if len(results) >= 3 {
+			out[symbol] = fi
+			continue
+		}
+		for _, typeName := range results {
+			info := pkg.types[typeName]
+			if info == nil || !info.isStruct {
+				continue
+			}
+			if pkg.decisionResultFlowsToState(typeName, owner, decision) {
+				out[symbol] = fi
+				break
+			}
+		}
+	}
+	return out
+}
