+//go:build linux || openbsd || freebsd || netbsd
+// +build linux openbsd freebsd netbsd
+
+package win
+
+// F2P structural verification of the window-frame responsibility split.
+//
+// The frozen P2P selection already pins the observable pointer behaviour with a
+// live fake X server. This file verifies the part of the contract that cannot be
+// observed in a pass-to-pass run of the unsplit baseline, namely the split
+// itself:
+//
+//   - the pointer-interaction state machine must move out of win.frame into a
+//     collaborator that owns and operates that state (REQ-STRUCT-001),
+//   - the decoration rendering resources (pixmaps, graphics contexts, theme
+//     application) must move into a separate decoration collaborator, leaving
+//     the frame with geometry and lifecycle only (REQ-STRUCT-002),
+//   - the frozen pointer notifications must still reach relocated handlers with
+//     their exact int16/button signatures (REQ-BEH-T4:C1/B5),
+//   - the hover path must keep a theme-refresh entry point reachable from the
+//     interaction collaborator (REQ-BEH-T4:C4),
+//   - the solution must ship X-connection-free unit tests that drive the
+//     relocated press and drag decision logic (REQ-STRUCT-005).
+//
+// Every selector fails on the unsplit baseline with a genuine assertion failure
+// and passes for a solution that performs the split with a wired collaborator.
+// The only frozen names used by the analysis are the interaction state field
+// names that the requirement relocates; collaborator type names, method names,
+// constructor shapes and file layout stay free.
+
+import (
+	"context"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"runtime"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"fyne.io/fyne/v2/test"
+
+	"github.com/BurntSushi/xgb/xproto"
+)
+
+// ---------------------------------------------------------------------------
+// Compiled-frame checks: the frame must give the relocated state up.
+// ---------------------------------------------------------------------------
+
+var f2pR3FrameType = reflect.TypeOf(frame{})
+
+var f2pR3PointerStateFields = []string{
+	"mouseX", "mouseY",
+	"moveX", "moveY",
+	"resizeStartX", "resizeStartY", "resizeStartWidth", "resizeStartHeight",
+	"resizeTop", "resizeBottom", "resizeLeft", "resizeRight",
+	"moveOnly", "ignoreDrag",
+	"hovered", "clickCount", "cancelFunc",
+}
+
+func f2pR3StateFieldSet() map[string]bool {
+	out := map[string]bool{}
+	for _, name := range f2pR3PointerStateFields {
+		out[name] = true
+	}
+	return out
+}
+
+func f2pR3AssertFrameOmits(t *testing.T, what string, names ...string) {
+	t.Helper()
+	pkg := f2pR3LoadPackage(t)
+	for i := 0; i < f2pR3FrameType.NumField(); i++ {
+		field := f2pR3FrameType.Field(i)
+		for _, name := range names {
+			if pkg.stateRole("frame", field.Name) == name {
+				t.Fatalf("win.frame still declares %s state field %q (%s): the pointer-interaction collaborator must own it (REQ-STRUCT-001)", what, field.Name, field.Type)
+			}
+		}
+	}
+}
+
+func TestF2PFrameDropsPointerOriginState(t *testing.T) {
+	f2pR3AssertFrameOmits(t, "pointer origin / press anchor", "mouseX", "mouseY")
+}
+
+func TestF2PFrameDropsMoveAccumulatorState(t *testing.T) {
+	f2pR3AssertFrameOmits(t, "accumulated window move offset", "moveX", "moveY")
+}
+
+func TestF2PFrameDropsResizeStartGeometryState(t *testing.T) {
+	f2pR3AssertFrameOmits(t, "resize start geometry", "resizeStartX", "resizeStartY", "resizeStartWidth", "resizeStartHeight")
+}
+
+func TestF2PFrameDropsResizeEdgeFlags(t *testing.T) {
+	f2pR3AssertFrameOmits(t, "active resize edge flag", "resizeTop", "resizeBottom", "resizeLeft", "resizeRight")
+}
+
+func TestF2PFrameDropsDragModeFlags(t *testing.T) {
+	f2pR3AssertFrameOmits(t, "drag interaction mode flag", "moveOnly", "ignoreDrag")
+}
+
+func TestF2PFrameDropsHoverTargetState(t *testing.T) {
+	f2pR3AssertFrameOmits(t, "hovered target", "hovered")
+}
+
+func TestF2PFrameDropsDoubleClickTimerState(t *testing.T) {
+	f2pR3AssertFrameOmits(t, "double-click counter / cancel timer", "clickCount", "cancelFunc")
+}
