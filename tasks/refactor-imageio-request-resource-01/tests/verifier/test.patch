+
+def test_kind_queries_work_without_opening_the_resource(tmp_path):
+    families = _build_families(tmp_path)
+    names, expected = _expected_vectors(families)
+    folder = tmp_path / "folder"
+    folder.mkdir()
+    missing = tmp_path / "never-written.bin"
+
+    targets = {
+        # a directory cannot be opened for reading
+        "local_path": [
+            Request(str(folder), "ri"),
+            # the write target does not exist yet
+            Request(str(missing), "wi"),
+        ],
+        "http": [Request("http://example.invalid/missing.png", "ri")],
+        "ftp": [Request("ftp://example.invalid/missing.png", "ri")],
+    }
+    for kind, requests in targets.items():
+        for request in requests:
+            assert _same_values(_read_queries(request, names), expected[kind]), (
+                f"an unavailable {kind} target is not classified as {kind}"
+            )
+    assert not missing.exists(), "classifying a write target created it as a side effect"
+
+
+def test_directory_requests_keep_error_priority_and_kind_queries(tmp_path):
+    families = _build_families(tmp_path)
+    names, expected = _expected_vectors(families)
+    folder = tmp_path / "folder"
+    folder.mkdir()
+
+    directory_request = Request(str(folder), "ri")
+    assert _same_values(_read_queries(directory_request, names), expected["local_path"]), (
+        "a directory request does not report the local-path kind"
+    )
