index 0000000000000000000000000000000000000000..20e4a71a4f35b9b275aa512c8cd2606a6c2a03c4
--- /dev/null
+++ b/tests/test_request_f2p_kind_delegation.py
@@ -0,0 +1,187 @@
+"""Lifecycle behavior and independence from legacy numeric dispatch."""
+
+from contextlib import contextmanager
+from io import BytesIO
+from pathlib import Path
+import pytest
+from urllib.request import OpenerDirector
+from zipfile import ZipFile
+
+from imageio.core import Request
+from imageio.core.request import (
+    URI_BYTES,
+    URI_FILE,
+    URI_FILENAME,
+    URI_FTP,
+    URI_HTTP,
+    URI_ZIPPED,
+)
+
+
+PAYLOAD_A = b"f2p-delegation-alpha-0123456789"
+PAYLOAD_B = b"f2p-delegation-beta-9876543210"
+
+
+@contextmanager
+def _without_numeric_dispatch(monkeypatch):
+    original = Request.__getattribute__
+
+    def attribute(instance, name):
+        if name == "_uri_type":
+            return -987654321
+        return original(instance, name)
+
+    with monkeypatch.context() as scoped:
+        scoped.setattr(Request, "__getattribute__", attribute)
+        yield
+
+
+def _archive(path):
+    with ZipFile(path, "w") as archive:
+        archive.writestr("existing.bin", PAYLOAD_A)
+    return path
+
+
+def test_local_read_handle_without_numeric_dispatch(tmp_path, monkeypatch):
+    source = tmp_path / "source.bin"
+    source.write_bytes(PAYLOAD_A)
+    request = Request(str(source), "ri")
+    with _without_numeric_dispatch(monkeypatch):
+        handle = request.get_file()
+        assert handle is not None, "a local read request must return a file handle"
+        assert handle is request.get_file()
+        assert handle.read() == PAYLOAD_A
+        request.finish()
+    assert handle.closed
+
+
+def test_zip_write_handle_without_numeric_dispatch(tmp_path, monkeypatch):
+    archive = _archive(tmp_path / "target.zip")
+    request = Request(f"{archive}/new.bin", "wi")
+    with _without_numeric_dispatch(monkeypatch):
+        handle = request.get_file()
+        assert handle is not None, "a ZIP write request must return a file handle"
+        handle.write(PAYLOAD_B)
+        request.finish()
+    with ZipFile(archive) as result:
+        assert "new.bin" in result.namelist(), "finish() must write the requested ZIP member"
+        assert result.read("new.bin") == PAYLOAD_B
+        assert result.read("existing.bin") == PAYLOAD_A
+
+
+def test_local_filename_without_numeric_dispatch(tmp_path, monkeypatch):
+    source = tmp_path / "source.bin"
+    source.write_bytes(PAYLOAD_A)
+    request = Request(str(source), "ri")
+    with _without_numeric_dispatch(monkeypatch):
+        try:
+            local = request.get_local_filename()
+        except Exception as exc:
+            pytest.fail(f"local filename capability failed without numeric dispatch: {type(exc).__name__}: {exc}")
+        assert Path(local) == source
+        assert Path(local).read_bytes() == PAYLOAD_A
+        request.finish()
+    assert source.read_bytes() == PAYLOAD_A
+
+
+def test_temporary_read_without_numeric_dispatch(tmp_path, monkeypatch):
+    request = Request(PAYLOAD_A, "ri")
+    with _without_numeric_dispatch(monkeypatch):
+        assert request.get_file() is not None, "an in-memory read request must return a file handle"
+        local = Path(request.get_local_filename())
+        assert local.read_bytes() == PAYLOAD_A
+        request.finish()
+    assert not local.exists()
+
+
+def test_return_bytes_write_without_numeric_dispatch(tmp_path, monkeypatch):
+    request = Request("<bytes>", "wi")
+    with _without_numeric_dispatch(monkeypatch):
+        handle = request.get_file()
+        assert handle is not None, "a return-bytes write request must return a file handle"
+        handle.write(PAYLOAD_B)
+        request.finish()
+        assert request.get_result() == PAYLOAD_B
+
+
+def test_zip_temporary_write_without_numeric_dispatch(tmp_path, monkeypatch):
+    archive = _archive(tmp_path / "target.zip")
+    request = Request(f"{archive}/new.bin", "wi")
+    with _without_numeric_dispatch(monkeypatch):
+        local = Path(request.get_local_filename())
+        local.write_bytes(PAYLOAD_B)
+        request.finish()
+    assert not local.exists()
+    with ZipFile(archive) as result:
+        assert "new.bin" in result.namelist(), "finish() must write the requested ZIP member"
+        assert result.read("new.bin") == PAYLOAD_B
+        assert result.read("existing.bin") == PAYLOAD_A
+
+
+def test_caller_file_temporary_write_without_numeric_dispatch(monkeypatch):
+    target = BytesIO()
+    request = Request(target, "wi")
+    with _without_numeric_dispatch(monkeypatch):
+        local = Path(request.get_local_filename())
+        local.write_bytes(PAYLOAD_B)
+        request.finish()
+    assert not local.exists()
+    assert not target.closed
+    assert target.getvalue() == PAYLOAD_B
+
+
+def test_legacy_classification_stays_readable_after_finish(tmp_path, monkeypatch):
+    source = tmp_path / "source.bin"
+    source.write_bytes(PAYLOAD_A)
+    archive = _archive(tmp_path / "source.zip")
+    caller = BytesIO(PAYLOAD_A)
+    cases = (
+        (PAYLOAD_A, URI_BYTES),
+        (str(source), URI_FILENAME),
+        (f"{archive}/existing.bin", URI_ZIPPED),
+        (caller, URI_FILE),
+        ("http://example.invalid/one.png", URI_HTTP),
+        ("ftp://example.invalid/one.png", URI_FTP),
+    )
+    for uri, expected_kind in cases:
+        request = Request(uri, "ri")
+        assert request._uri_type == expected_kind
+        with _without_numeric_dispatch(monkeypatch):
+            request.finish()
+        assert request._uri_type == expected_kind
+    assert not caller.closed
+
+
+def test_owned_handle_closes_without_numeric_dispatch(tmp_path, monkeypatch):
+    source = tmp_path / "source.bin"
+    source.write_bytes(PAYLOAD_A)
+    request = Request(str(source), "ri")
+    with _without_numeric_dispatch(monkeypatch):
+        handle = request.get_file()
+        assert handle is not None, "an owned local resource must return a file handle"
+        assert not handle.closed
+        assert request.finish() is None
+    assert handle.closed
+
+
+def test_resource_kinds_work_without_numeric_dispatch(tmp_path, monkeypatch):
+    source = tmp_path / "source.bin"
+    source.write_bytes(PAYLOAD_A)
+    archive = _archive(tmp_path / "source.zip")
+    caller = BytesIO(PAYLOAD_A)
+    monkeypatch.setattr(OpenerDirector, "open", lambda *args, **kwargs: BytesIO(PAYLOAD_A))
+    cases = (
+        (PAYLOAD_A, PAYLOAD_A),
+        (str(source), PAYLOAD_A),
+        (f"{archive}/existing.bin", PAYLOAD_A),
+        (caller, PAYLOAD_A),
+        ("http://example.invalid/one.png", PAYLOAD_A),
+        ("ftp://example.invalid/one.png", None),
+    )
+    for uri, expected in cases:
+        request = Request(uri, "ri")
+        with _without_numeric_dispatch(monkeypatch):
+            handle = request.get_file()
+            assert (None if handle is None else handle.read()) == expected
+            request.finish()
+    assert not caller.closed
diff --git a/tests/test_request_f2p_semantic_queries.py b/tests/test_request_f2p_semantic_queries.py
new file mode 100644
index 0000000000000000000000000000000000000000..0a5efa23901101f8e1c518bbda462081ee4374c7
--- /dev/null
+++ b/tests/test_request_f2p_semantic_queries.py
@@ -0,0 +1,535 @@
+"""F2P tests for the semantic resource-kind queries of ``imageio.core.Request``.
+
+The frozen obligation behind these tests is the responsibility move: the
+request must delegate opening, temporary-file creation, write-back and closing
+to per-kind resource objects and expose *semantic, documented queries* about
+the resource kind, so that plugins no longer have to read the private numeric
+kind (``_uri_type``) or hard-code its numeric values.
+
+The tests discover the query surface dynamically from the public attributes of
+``Request`` instances: a "kind query" is a public (non-underscore) attribute
+that is not part of the preserved request surface and yields, as a value or
+a documented no-argument method, a stable result for the same kind across
+distinct URIs.  The discovered queries must separate all supported input
+classes; the tests then pin the plugin-facing contract (public, read-only,
+reliable), the mode and consumer splits, the shipped type declarations and the
+unchanged error priority.  The per-kind resource objects that own opening,
+temporary-file creation, write-back and closing are pinned separately in
+``tests/test_request_f2p_kind_delegation.py``.  Every check runs
+offline and only uses temporary files created under ``tmp_path``.
+"""
+
+import ast
+import builtins
+import enum
+import inspect
+import itertools
+import tempfile
+import zipfile
+from io import BytesIO
+from pathlib import Path
+from urllib.request import OpenerDirector
+
+import imageio.core.request as request_module
+from imageio.core import Request
+from imageio.core.imopen import imopen
+
+PAYLOAD_A = b"f2p-payload-alpha-0123456789"
+PAYLOAD_B = b"f2p-payload-beta-9876543210"
+PAYLOAD_C = b"f2p-payload-gamma-1122334455"
+
+DIRECTORY_ERROR = (
+    "ImageIO does not generally support reading folders. "
+    "Limited support may be available via specific plugins. "
+    "Specify the plugin explicitly using the `plugin` kwarg, e.g. `plugin='DICOM'`"
+)
+
+#: Documented public surface of ``Request`` that the frozen contract preserves.
+#: These names are not resource-kind queries: ``raw_uri`` / ``filename`` /
+#: ``extension`` / ``format_hint`` / ``mode`` / ``kwargs`` / ``firstbytes``
+#: carry per-instance values and the methods open or close the resource.
+PRESERVED_PUBLIC = frozenset(
+    {
+        "raw_uri",
+        "filename",
+        "extension",
+        "format_hint",
+        "mode",
+        "kwargs",
+        "firstbytes",
+        "get_file",
+        "get_local_filename",
+        "finish",
+        "get_result",
+    }
+)
+
+def _write_file(path, payload):
+    path.write_bytes(payload)
+    return str(path)
+
+
+def _make_zip(path, member, payload):
+    with zipfile.ZipFile(path, "w") as archive:
+        archive.writestr(member, payload)
+    return str(path)
+
+
+def _build_families(root):
+    """Build at least two distinct read requests for every input class."""
+    file_a = root / "alpha.bin"
+    file_b = root / "beta.bin"
+    _write_file(file_a, PAYLOAD_A)
+    _write_file(file_b, PAYLOAD_B)
+
+    zip_a = _make_zip(root / "first.zip", "member.bin", PAYLOAD_A)
+    zip_b = _make_zip(root / "second.zip", "member.bin", PAYLOAD_B)
+
+    return {
+        "bytes": [
+            Request(PAYLOAD_A, "ri"),
+            Request(PAYLOAD_B, "ri"),
+            Request(memoryview(PAYLOAD_C), "ri"),
+        ],
+        "file_object": [
+            Request(file_a.open("rb"), "ri"),
+            Request(file_b.open("rb"), "ri"),
+        ],
+        "local_path": [
+            Request(str(file_a), "ri"),
+            Request(Path(file_b), "ri"),
+            Request("file://" + str(file_a), "ri"),
+        ],
+        "zip_member": [
+            Request(f"{zip_a}/member.bin", "ri"),
+            Request(f"{zip_b}/member.bin", "ri"),
+        ],
+        "http": [
+            Request("http://example.invalid/one.png", "ri"),
+            Request("https://example.invalid/two.jpg", "ri"),
+        ],
+        "ftp": [
+            Request("ftp://example.invalid/one.png", "ri"),
+            Request("ftps://example.invalid/two.jpg", "ri"),
+        ],
+    }
+
+
+def _query_value(request, name):
+    value = getattr(request, name)
+    if callable(value):
+        inspect.signature(value).bind()
+        assert inspect.getdoc(value), f"the public query {name} is undocumented"
+        return value()
+    return value
+
+
+def _query_state(request):
+    names = (
+        "raw_uri", "filename", "extension", "format_hint", "mode", "kwargs",
+        "_uri_type", "_filename_zip",
+    )
+    state = {name: repr(getattr(request, name)) for name in names}
+    stream = request.raw_uri
+    if isinstance(stream, BytesIO):
+        state["caller_file"] = (
+            stream.closed, None if stream.closed else (stream.tell(), stream.getvalue())
+        )
+    return state
+
+
+def _public_snapshot(request):
+    """Public property or no-argument method query results."""
+    values = {}
+    for name in dir(request):
+        if name.startswith("_") or name in PRESERVED_PUBLIC:
+            continue
+        try:
+            value = _query_value(request, name)
+        except Exception:
+            continue
+        values[name] = value
+    return values
+
+
+def _values_differ(left, right):
+    if type(left) is not type(right):
+        return True
+    try:
+        return not bool(left == right)
+    except Exception:
+        return True
+
+
+def _kind_queries(families):
+    """Public attributes that are stable for a kind and shared by all kinds."""
+    per_kind = {}
+    for kind, requests in families.items():
+        snapshots = [_public_snapshot(request) for request in requests]
+        names = set(snapshots[0])
+        for snapshot in snapshots[1:]:
+            names &= set(snapshot)
+        stable = {}
+        for name in names:
+            first = snapshots[0][name]
+            if all(not _values_differ(first, snapshot[name]) for snapshot in snapshots[1:]):
+                stable[name] = first
+        per_kind[kind] = stable
+
+    common = set.intersection(*[set(values) for values in per_kind.values()])
+    queries = {
+        name: {kind: per_kind[kind][name] for kind in families} for name in sorted(common)
+    }
+    assert queries, (
+        "Request exposes no public attribute that is stable for a given resource "
+        "kind and shared by every supported input class, so plugins still have to "
+        "inspect the private numeric kind instead of a semantic query"
+    )
+    return queries
+
+
+def _separating_queries(queries):
+    kinds = sorted(next(iter(queries.values())))
+    separating = {
+        name: values
+        for name, values in queries.items()
+        if any(
+            _values_differ(values[left], values[right])
+            for left, right in itertools.combinations(kinds, 2)
+        )
+    }
+    assert separating, "no public kind query distinguishes any pair of input classes"
+    return separating
+
+
+def _expected_vectors(families):
+    queries = _kind_queries(families)
+    names = sorted(_separating_queries(queries))
+    expected = {kind: {name: queries[name][kind] for name in names} for kind in families}
+    return names, expected
+
+
+_MISSING = object()
+
+
+def _read_queries(request, names):
+    values = {}
+    for name in names:
+        try:
+            values[name] = _query_value(request, name)
+        except Exception:
+            values[name] = _MISSING
+    return values
+
+
+def _same_values(left, right):
+    if set(left) != set(right):
+        return False
+    return all(not _values_differ(left[name], right[name]) for name in left)
+
+
+def _return_bytes():
+    value = getattr(request_module, "RETURN_BYTES", None)
+    assert isinstance(value, str), "the public RETURN_BYTES constant is not importable"
+    return value
+
+
+# ---------------------------------------------------------------------------
+# the public, read-only and reliable query surface
+# ---------------------------------------------------------------------------
+
+
+def test_public_kind_queries_distinguish_all_input_classes(tmp_path):
+    families = _build_families(tmp_path)
+    queries = _kind_queries(families)
+    kinds = sorted(families)
+    for left, right in itertools.combinations(kinds, 2):
+        assert any(
+            _values_differ(queries[name][left], queries[name][right])
+            for name in queries
+        ), f"public kind queries do not distinguish {left!r} from {right!r}"
+
+
+def test_kind_queries_are_read_only(tmp_path, monkeypatch):
+    families = _build_families(tmp_path)
+
+    def unexpected_io(*args, **kwargs):
+        raise AssertionError("a kind query performed resource I/O")
+
+    monkeypatch.setattr(builtins, "open", unexpected_io)
+    monkeypatch.setattr(Path, "open", unexpected_io)
+    monkeypatch.setattr(tempfile, "mkstemp", unexpected_io)
+    monkeypatch.setattr(OpenerDirector, "open", unexpected_io)
+    queries = _kind_queries(families)
+    for kind in ("bytes", "local_path", "zip_member", "http"):
+        request = families[kind][0]
+        for name in queries:
+            state = _query_state(request)
+            before = _query_value(request, name)
+            assert not _values_differ(_query_value(request, name), before)
+            assert _query_state(request) == state, f"the query {name} mutates its request"
+            if callable(getattr(request, name)):
+                continue
+            rejected = False
+            try:
+                setattr(request, name, before)
+            except AttributeError:
+                rejected = True
+            assert rejected, f"the kind query {name} of a {kind} request can be overwritten"
+            assert not _values_differ(_query_value(request, name), before), (
+                f"the kind query {name} changed after a write attempt"
+            )
+
+
+def test_kind_queries_are_reliable_for_unseen_instances(tmp_path):
+    families = _build_families(tmp_path)
+    names, expected = _expected_vectors(families)
+
+    extra_file = _write_file(tmp_path / "gamma.bin", PAYLOAD_C)
+    extra_zip = _make_zip(tmp_path / "third.zip", "other.bin", PAYLOAD_C)
+    unseen = {
+        "bytes": Request(PAYLOAD_C, "ri"),
+        "file_object": Request((tmp_path / "gamma.bin").open("rb"), "ri"),
+        "local_path": Request(Path(extra_file), "ri"),
+        "zip_member": Request(f"{extra_zip}/other.bin", "ri"),
+        "http": Request("https://example.invalid/three.png", "ri"),
+        "ftp": Request("ftps://example.invalid/three.png", "ri"),
+    }
+    for kind, request in unseen.items():
+        assert _same_values(_read_queries(request, names), expected[kind]), (
+            f"an unseen {kind} request reports different kind queries"
+        )
+
+
+def test_kind_queries_are_semantic_and_not_numeric_codes(tmp_path):
+    families = _build_families(tmp_path)
+    queries = _kind_queries(families)
+    for name, values in queries.items():
