+    outcomes = []
+    for legacy_mode in (True, False):
+        try:
+            imopen(str(folder), "r", legacy_mode=legacy_mode)
+        except Exception as error:
+            outcomes.append((legacy_mode, type(error), str(error)))
+        else:
+            outcomes.append((legacy_mode, None, None))
+    assert outcomes == [
+        (True, ValueError, DIRECTORY_ERROR),
+        (False, IOError, DIRECTORY_ERROR),
+    ], f"the directory error priority changed: {outcomes!r}"
+
+
+# ---------------------------------------------------------------------------
+# special URIs, documented surface and the per-kind resource objects
+# ---------------------------------------------------------------------------
+
+
+def test_special_read_uris_report_the_bytes_kind_queries(tmp_path):
+    families = _build_families(tmp_path)
+    names, expected = _expected_vectors(families)
+    for uri in ("<video0>", "<video1>", "<screen>", "<clipboard>"):
+        request = Request(uri, "ri")
+        assert _same_values(_read_queries(request, names), expected["bytes"]), (
+            f"the special read uri {uri!r} does not report the bytes kind"
+        )
+
+
+def _declared_stub_members(tree, class_name):
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ClassDef) and node.name == class_name:
+            names = set()
+            for item in node.body:
+                if isinstance(item, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                    names.add(item.name)
+                elif isinstance(item, ast.AnnAssign) and isinstance(item.target, ast.Name):
+                    names.add(item.target.id)
+                elif isinstance(item, ast.Assign):
+                    for target in item.targets:
+                        if isinstance(target, ast.Name):
+                            names.add(target.id)
+            return names
+    return None
+
+
+def test_kind_queries_are_declared_in_shipped_type_stub(tmp_path):
+    families = _build_families(tmp_path)
+    queries = _kind_queries(families)
+    stub_path = Path(request_module.__file__).with_suffix(".pyi")
+    assert stub_path.is_file(), f"the shipped type declaration {stub_path} is missing"
+    declared = _declared_stub_members(ast.parse(stub_path.read_text()), "Request")
+    assert declared is not None, "request.pyi does not declare the Request class"
+    missing = sorted(name for name in queries if name not in declared)
+    assert not missing, f"the semantic kind queries {missing} are missing from request.pyi"
+
+
+def test_plugin_modules_do_not_read_the_private_numeric_kind():
+    import imageio.plugins as plugins_package
+
+    root = Path(plugins_package.__file__).parent
+    consumer_paths = sorted(root.rglob("*.py"))
+    consumer_paths.append(Path(request_module.__file__).with_name("imopen.py"))
+    offenders = []
+    for path in consumer_paths:
+        try:
+            tree = ast.parse(path.read_text(encoding="utf-8"))
+        except SyntaxError as error:
+            offenders.append(f"{path.name}:{error.lineno} (unparsable)")
+            continue
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Attribute) and node.attr == "_uri_type":
+                offenders.append(f"{path.name}:{node.lineno}")
+    assert not offenders, f"query consumers still read the private numeric kind: {offenders}"
