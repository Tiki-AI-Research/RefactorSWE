+            environment_reads.append(name)
+            return configured["timeout"]
+        return default
+
+    class StreamingResponse(io.BytesIO):
+        def seekable(self):
+            return False
+
+        def seek(self, *args, **kwargs):
+            raise io.UnsupportedOperation("HTTP responses are not seekable")
+
+    def fake_open(opener, url, data=None, timeout=None):
+        if isinstance(url, UrlRequest):
+            url = url.full_url
+        calls.append((url, timeout))
+        return StreamingResponse(PAYLOAD)
+
+    monkeypatch.setattr(os, "getenv", fake_getenv)
+    monkeypatch.setattr(OpenerDirector, "open", fake_open)
+    for scheme in ("http", "https"):
+        for value, expected in ((None, 5.0), ("7", 7.0), ("invalid", 5.0)):
+            configured["timeout"] = "13"
+            url = f"{scheme}://example.invalid/original.bin?keep=1"
+            previous_calls = len(calls)
+            previous_reads = len(environment_reads)
+            request = Request(url, "ri")
+            assert len(calls) == previous_calls, "HTTP construction opened a connection"
+            assert len(environment_reads) == previous_reads, "timeout was read before opening"
+            configured["timeout"] = value
+            try:
+                handle = request.get_file()
+                assert calls[previous_calls:] == [(url, expected)]
+                assert len(environment_reads) > previous_reads
+                assert handle.seekable()
+                assert handle.read(17) == PAYLOAD[:17]
+                handle.seek(0)
+                assert handle.read() == PAYLOAD
+                assert request.get_file() is handle
+                assert len(calls) == previous_calls + 1
+            finally:
+                request.finish()
+
+
+def test_http_video_reader_passes_raw_uri_to_backend(monkeypatch):
+    import imageio.plugins.pyav as pyav_module
+
+    captured = []
+
+    class _Probe(Exception):
+        pass
+
+    def fake_open(source, *args, **kwargs):
+        captured.append(source)
+        raise _Probe()
+
+    monkeypatch.setattr(pyav_module.av, "open", fake_open)
+
+    with pytest.raises((_Probe, OSError)):
+        iio.v3.imopen("http://example.com/video.mp4", "r", plugin="pyav")
+
+    assert captured, "the pyav backend was never asked to open the resource"
+    assert captured[0] == "http://example.com/video.mp4"
+
+
+# ---------------------------------------------------------------------------
+# plugin-facing contract
+# ---------------------------------------------------------------------------
+
+
+def test_request_object_handed_to_plugin_unchanged(tmp_path):
+    image = tmp_path / "image.png"
+    array = np.zeros((4, 5, 3), dtype=np.uint8)
+    array[0, 0] = [1, 2, 3]
+    iio.v3.imwrite(image, array)
+
+    with iio.v3.imopen(image, "r") as file:
+        request = file.request
+        assert isinstance(request, Request)
+        assert request.raw_uri == image
+        assert request.mode == "r?"
+        assert request.extension == ".png"
+        assert request.filename == str(image)
+        result = file.read()
+
+    assert result.shape == array.shape
+    assert np.array_equal(result, array)
+
+
+def test_plugin_write_back_byte_for_byte(tmp_path):
+    image = tmp_path / "written.png"
+    array = np.arange(6 * 7 * 3, dtype=np.uint8).reshape(6, 7, 3)
+    iio.v3.imwrite(image, array)
+
+    with iio.v3.imopen(image, "r") as file:
+        result = file.read()
+    assert np.array_equal(result, array)
+
+
+def test_return_bytes_write_result_through_public_api():
+    array = np.arange(4 * 5 * 3, dtype=np.uint8).reshape(4, 5, 3)
+    result = iio.v3.imwrite(RETURN_BYTES, array, extension=".png")
+    assert isinstance(result, bytes)
+    assert result.startswith(b"\x89PNG\r\n\x1a\n")
+    assert len(result) > 0
