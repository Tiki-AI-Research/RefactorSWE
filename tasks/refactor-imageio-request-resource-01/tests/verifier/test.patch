+def test_type_declaration_keeps_legacy_numeric_surface():
+    declaration = Path(request_module.__file__).with_suffix(".pyi")
+    assert declaration.is_file()
+
+    text = declaration.read_text(encoding="utf-8")
+    for name in (
+        "URI_BYTES",
+        "URI_FILE",
+        "URI_FILENAME",
+        "URI_ZIPPED",
+        "URI_HTTP",
+        "URI_FTP",
+    ):
+        assert name in text, name
+    assert "_uri_type" in text
+    tree = ast.parse(text)
+    declaration = next(
+        (node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "Request"),
+        None,
+    )
+    assert declaration is not None, "the stub no longer declares Request"
+    annotated = {
+        node.target.id for node in declaration.body
+        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name)
+    }
+    methods = {}
+    for node in declaration.body:
+        if isinstance(node, ast.FunctionDef):
+            methods.setdefault(node.name, []).append(node)
+    assert "raw_uri" in annotated, "the stub lost Request.raw_uri"
+    def is_int(annotation):
+        return (
+            isinstance(annotation, ast.Name) and annotation.id == "int"
+            or isinstance(annotation, ast.Constant) and annotation.value == "int"
+            or isinstance(annotation, ast.Attribute) and isinstance(annotation.value, ast.Name)
+               and annotation.value.id == "builtins" and annotation.attr == "int"
+        )
+    numeric_attribute = any(
+        isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name)
+        and node.target.id == "_uri_type" and is_int(node.annotation)
+        for node in declaration.body
+    )
+    numeric_property = any(
+        is_int(node.returns)
+        and [a.arg for a in node.args.posonlyargs + node.args.args] == ["self"]
+        and not node.args.kwonlyargs and node.args.vararg is None and node.args.kwarg is None
+        and any(
+            isinstance(d, ast.Name) and d.id == "property"
+            or isinstance(d, ast.Attribute) and isinstance(d.value, ast.Name)
+               and d.value.id == "builtins" and d.attr == "property"
+            for d in node.decorator_list
+        )
+        for node in methods.get("_uri_type", [])
+    )
+    assert numeric_attribute or numeric_property, "the stub must describe readable Request._uri_type as int"
+    for name in ("filename", "extension", "format_hint", "mode", "kwargs", "firstbytes"):
+        assert name in annotated or any(
+            isinstance(decorator, ast.Name) and decorator.id == "property"
+            for node in methods.get(name, []) for decorator in node.decorator_list
+        ), f"the stub lost the public Request.{name} property"
+    for name in ("get_file", "get_local_filename", "finish", "get_result"):
+        assert name in methods, f"the stub lost Request.{name}"
+        assert any(
+            [argument.arg for argument in node.args.posonlyargs + node.args.args] == ["self"]
+            and not node.args.posonlyargs and not node.args.defaults
+            and not node.args.kwonlyargs and node.args.vararg is None
+            and node.args.kwarg is None and node.returns is not None
+            for node in methods[name]
+        ), f"the stub changed the public signature of Request.{name}"
+    assert any(
+        not node.args.posonlyargs
+        and [argument.arg for argument in node.args.args] == ["self", "uri", "mode"]
+        and not node.args.defaults and node.args.vararg is None
+        and [argument.arg for argument in node.args.kwonlyargs] == ["extension", "format_hint"]
+        and all(isinstance(value, ast.Constant) and value.value is None for value in node.args.kw_defaults)
+        and node.args.kwarg is not None and node.args.kwarg.arg == "kwargs"
+        for node in methods.get("__init__", [])
+    ), "the stub changed the public Request constructor signature"
+
