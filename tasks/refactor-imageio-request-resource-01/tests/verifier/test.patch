+            assert isinstance(value, (bool, enum.Enum)) or not isinstance(
+                value, (int, float)
+            ), f"the kind query {name} returns a bare numeric value {value!r} for {kind}"
+
+
+# ---------------------------------------------------------------------------
+# mode and consumer splits
+# ---------------------------------------------------------------------------
+
+
+def test_kind_queries_do_not_depend_on_io_mode(tmp_path):
+    families = _build_families(tmp_path)
+    names, expected = _expected_vectors(families)
+
+    write_requests = {
+        "bytes": Request(_return_bytes(), "wi"),
+        "local_path": Request(str(tmp_path / "written.bin"), "wi"),
+        "zip_member": Request(str(tmp_path / "first.zip") + "/member.bin", "wi"),
+        "file_object": Request(BytesIO(), "wi"),
+    }
+    for kind, request in write_requests.items():
+        assert _same_values(_read_queries(request, names), expected[kind]), (
+            f"a write-mode {kind} request reports different kind queries than the "
+            "read-mode request of the same kind"
