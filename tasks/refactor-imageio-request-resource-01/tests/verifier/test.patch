+
+def test_plugin_consumer_sees_kind_queries_through_imopen(tmp_path):
+    families = _build_families(tmp_path)
+    names, expected = _expected_vectors(families)
+
+    seen = []
+
+    def recording_plugin(request, **kwargs):
+        seen.append(request)
+        return object()
+
+    imopen(PAYLOAD_A, "r", plugin=recording_plugin)
+    assert len(seen) == 1, "imopen did not hand a request to the plugin"
+    assert _same_values(_read_queries(seen[0], names), expected["bytes"]), (
+        "the request handed to a plugin for in-memory bytes does not report the bytes kind"
+    )
+
+    file_path = _write_file(tmp_path / "delta.bin", PAYLOAD_C)
+    imopen(file_path, "r", plugin=recording_plugin)
+    assert len(seen) == 2, "imopen did not hand the second request to the plugin"
+    assert _same_values(_read_queries(seen[-1], names), expected["local_path"]), (
+        "the request handed to a plugin for a local path does not report the "
+        "local-path kind"
