+"""Frozen baseline observations through public request operations."""
+import functools
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+@functools.lru_cache(maxsize=1)
+def lifecycle_observations():
+    root = Path(__file__).resolve().parents[1]
+    try:
+        process = subprocess.run([sys.executable, str(root / "tests/case32_lifecycle_probe.py")], cwd=root, capture_output=True, text=True, timeout=90)
+    except subprocess.TimeoutExpired:
+        return {"error": "public lifecycle probe timed out"}, {}
+    if process.returncode:
+        return {"error": process.stderr[-10000:], "exit_code": process.returncode}, {}
+    try:
+        actual = json.loads(process.stdout)
+    except ValueError:
+        return {"error": "invalid probe output", "stdout": process.stdout[-10000:]}, {}
+    expected = json.loads((root / "tests/testdata/case32_lifecycle.json").read_text())
+    return actual, expected
+
+def test_http_partial_initialization_releases_opened_stream():
+    actual, expected = lifecycle_observations()
+    assert "error" not in actual, actual
+    assert actual["wrapper/http"] == expected["wrapper/http"]
+
+def test_zip_partial_initialization_releases_opened_member():
+    actual, expected = lifecycle_observations()
+    assert "error" not in actual, actual
+    assert actual["wrapper/zip"] == expected["wrapper/zip"]
+
+def test_lifecycle_retry_ownership_and_byte_results_preserved():
+    actual, expected = lifecycle_observations()
+    assert "error" not in actual, actual
+    assert set(actual) == set(expected)
+    differences = {key: {"actual": actual[key], "expected": expected[key]} for key in expected if not key.startswith("wrapper/") and actual[key] != expected[key]}
+    assert not differences, differences
