index 0000000000000000000000000000000000000000..d1608b6ea546e362e77f99e19305dd7a3e6cc248
--- /dev/null
+++ b/tests/case32_lifecycle_probe.py
@@ -0,0 +1,156 @@
+"""Public-operation differential observations; no expected result copied from candidates."""
+import contextlib
+import importlib
+import io
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import urllib.request
+import zipfile
+from unittest.mock import patch
+
+sys.path.insert(0, os.getcwd())
+rm = importlib.import_module('imageio.core.request')
+Request = rm.Request
+REAL_BYTES = io.BytesIO
+payload = bytes(range(256)) * 3 + b'end'
+rows = {}
+
+def value(fn):
+    try:
+        x = fn()
+        return x.hex() if isinstance(x, bytes) else x
+    except Exception as e:
+        return {'error': type(e).__name__, 'message': str(e)}
+
+@contextlib.contextmanager
+def all_core_aliases(original, replacement):
+    with contextlib.ExitStack() as stack:
+        for modname, mod in list(sys.modules.items()):
+            if modname.startswith('imageio.core') and mod:
+                for key, obj in list(vars(mod).items()):
+                    if obj is original:
+                        stack.enter_context(patch.object(mod, key, replacement))
+        yield
+
+with tempfile.TemporaryDirectory() as td:
+    root = Path(td)
+    local = root/'read.bin'
+    local.write_bytes(payload)
+    zp = root/'read.zip'
+    with zipfile.ZipFile(zp, 'w') as z:
+        z.writestr('member.bin', payload)
+    for kind in ('bytes', 'memoryview', 'path', 'file_uri', 'zip', 'caller'):
+        for mode in ('ri', 'r?', 'rI'):
+            for via in ('handle', 'temporary'):
+                caller = REAL_BYTES(payload)
+                uri = {'bytes':payload, 'memoryview':memoryview(payload), 'path':local,
+                       'file_uri':'file://'+str(local), 'zip':str(zp)+'/member.bin', 'caller':caller}[kind]
+                r = Request(uri, mode, extension='.bin', label='audit')
+                o = {'kind':r._uri_type, 'mode':str(r.mode), 'extension':r.extension,
+                     'kwargs':r.kwargs, 'header':r.firstbytes.hex()}
+                handle = r.get_file()
+                o['reuse'] = r.get_file() is handle
+                if via == 'handle':
+                    o['chunks'] = [handle.read(7).hex(), handle.read().hex()]
+                else:
+                    temp = r.get_local_filename()
+                    o['contents'] = Path(temp).read_bytes().hex()
+                    o['was_local'] = temp == str(local)
+                o['finish'] = value(r.finish)
+                o['second_finish'] = value(r.finish)
+                o['result'] = value(r.get_result)
+                o['closed'] = handle.closed
+                o['caller_closed'] = caller.closed
+                if via == 'temporary':
+                    o['path_exists_after'] = Path(temp).exists()
+                rows[f'read/{kind}/{mode}/{via}'] = o
+                caller.close()
+    for kind in ('bytes', 'local', 'zip', 'caller'):
+        for via in ('handle', 'temporary'):
+            dest = root/f'write-{kind}-{via}.bin'
+            archive = root/f'write-{kind}-{via}.zip'
+            caller = REAL_BYTES()
+            uri = {'bytes':rm.RETURN_BYTES, 'local':dest, 'zip':str(archive)+'/member.bin', 'caller':caller}[kind]
+            r = Request(uri, 'wi')
+            if via == 'handle':
+                h = r.get_file(); h.write(payload[:30]); h.write(payload[30:])
+            else:
+                temp = r.get_local_filename(); Path(temp).write_bytes(payload)
+            o = {'finish':value(r.finish), 'second_finish':value(r.finish),
+                 'result':value(r.get_result), 'consumed_result':value(r.get_result), 'caller_closed':caller.closed}
+            if kind == 'local': o['contents'] = dest.read_bytes().hex()
+            if kind == 'zip':
+                with zipfile.ZipFile(archive) as z: o['contents'] = z.read('member.bin').hex()
+            if kind == 'caller': o['contents'] = caller.getvalue().hex()
+            if via == 'temporary': o['path_exists_after'] = Path(temp).exists()
+            rows[f'write/{kind}/{via}'] = o
+            caller.close()
+
+    # Two live requests of the same kind must not share mutable lifecycle state.
+    pair = [Request(rm.RETURN_BYTES, 'wi') for _ in range(2)]
+    pair[0].get_file().write(b'A'); pair[1].get_file().write(b'B')
+    pair[1].finish(); pair[0].finish()
+    rows['interleaved'] = [value(p.get_result) for p in pair]
+
+    # Failed allocation, followed by cleanup and a successful new opening.
+    for kind in ('bytes', 'zip'):
+        archive = root/f'fault-{kind}.zip'
+        uri = rm.RETURN_BYTES if kind == 'bytes' else str(archive)+'/member'
+        r = Request(uri, 'wi')
+        error = MemoryError('audit buffer allocation')
+        def fail_buffer(*args, **kwargs): raise error
+        with all_core_aliases(REAL_BYTES, fail_buffer), patch.object(io, 'BytesIO', fail_buffer):
+            o = {'open':value(r.get_file), 'finish':value(r.finish), 'second_finish':value(r.finish),
+                 'result':value(r.get_result), 'archive_exists':archive.exists()}
+        h = r.get_file(); h.write(b'retry'); o['retry_finish'] = value(r.finish)
+        o['retry_result'] = value(r.get_result)
+        if kind == 'zip':
+            with zipfile.ZipFile(archive) as z: o['retry_contents'] = z.read('member').hex()
+        rows['allocation/'+kind] = o
+
+    # The stream has opened, but creating its seekable wrapper fails. Keep a
+    # strong external reference so Python garbage collection cannot hide loss
+    # of the owner's explicit cleanup responsibility.
+    for kind in ('http', 'zip'):
+        acquired = []
+        def fail_wrapper(stream):
+            acquired.append(stream)
+            raise MemoryError('audit wrapper allocation')
+        remote = REAL_BYTES(payload)
+        r = Request('http://audit.invalid/file.bin' if kind == 'http' else str(zp)+'/member.bin', 'ri')
+        with all_core_aliases(rm.SeekableFileObject, fail_wrapper), patch.object(urllib.request.OpenerDirector, 'open', lambda *a, **k:remote):
+            o = {'open':value(r.get_file), 'opened_count':len(acquired),
+                 'closed_before_finish':[s.closed for s in acquired], 'finish':value(r.finish),
+                 'closed_after_finish':[s.closed for s in acquired]}
+        rows['wrapper/'+kind] = o
+        for stream in acquired: stream.close()
+        remote.close()
+
+    # Caller write-back failure must keep caller ownership and be retryable.
+    class Caller(REAL_BYTES):
+        fail = True
+        def write(self, data):
+            if self.fail: raise OSError('audit caller write')
+            return super().write(data)
+    caller = Caller(); r = Request(caller, 'wi'); temp = r.get_local_filename(); Path(temp).write_bytes(b'retry-data')
+    o = {'finish':value(r.finish), 'caller_closed':caller.closed, 'temp_after_failure':Path(temp).exists()}
+    caller.fail = False; o['retry_finish'] = value(r.finish); o['contents'] = caller.getvalue().hex()
+    o['temp_after_retry'] = Path(temp).exists(); caller.close(); rows['caller-write-error'] = o
+
+    for uri in ('ftp://audit.invalid/a.bin', 'ftps://audit.invalid/a.bin', '<video0>', '<screen>', '<clipboard>'):
+        r = Request(uri, 'ri')
+        o = {'kind':r._uri_type, 'handle_none':r.get_file() is None, 'finish':value(r.finish)}
+        rows['sentinel/'+uri] = o
+
+    # A real plugin round trip exercises its semantic query and write-back.
+    import imageio.v3 as iio
+    import numpy as np
+    pixels = np.arange(60, dtype=np.uint8).reshape(4,5,3)
+    encoded = iio.imwrite('<bytes>', pixels, extension='.png', plugin='pillow')
+    decoded = iio.imread(encoded, plugin='pillow')
+    rows['pillow-roundtrip'] = {'same':bool(np.array_equal(decoded,pixels)), 'shape':list(decoded.shape), 'dtype':str(decoded.dtype)}
+
+print(json.dumps(rows, sort_keys=True))
diff --git a/tests/test_request_f2p_kind_delegation.py b/tests/test_request_f2p_kind_delegation.py
