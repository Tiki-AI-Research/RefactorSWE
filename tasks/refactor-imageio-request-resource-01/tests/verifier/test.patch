+    io_calls = []
+    real_open = io.open
+
+    def spy_open(file, *args, **kwargs):
+        io_calls.append(("open", str(file)))
+        return real_open(file, *args, **kwargs)
+
+    def spy_mkstemp(*args, **kwargs):
+        io_calls.append(("mkstemp",))
+        raise AssertionError("creating a request must not create temporary files")
+
+    def spy_create_connection(*args, **kwargs):
+        io_calls.append(("connect",))
+        raise AssertionError("creating a request must not open network connections")
+
+    monkeypatch.setattr(io, "open", spy_open)
+    monkeypatch.setattr(builtins, "open", spy_open)
+    monkeypatch.setattr(tempfile, "mkstemp", spy_mkstemp)
+    monkeypatch.setattr(socket, "create_connection", spy_create_connection)
+
+    requests = [
+        (str(source), "ri"),
+        (str(tmp_path / "missing_target.png"), "wi"),
+        (PAYLOAD, "ri"),
+        (memoryview(PAYLOAD), "ri"),
+        ("<video0>", "ri"),
