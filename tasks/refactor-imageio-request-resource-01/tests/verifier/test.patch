+"""P2P regression tests for the preserved Request resource-kind contract.
+
+These tests pin the externally observable behavior of ``imageio.core.Request``
+and the resource-kind machinery around it that the frozen instruction requires
+to stay unchanged while resource-kind handling is moved behind resource
+objects.  They only touch the surface that is promised to keep working
+(``get_file``, ``get_local_filename``, ``finish``, ``get_result``, the public
+request attributes and the legacy ``_uri_type`` / ``_filename_zip`` attributes)
+so that any correct implementation of the responsibility move keeps passing
+them.
+
+Everything runs offline and only uses temporary files created via ``tmp_path``.
+"""
+
+import ast
+import builtins
+import inspect
+import io
+import os
+import re
+import socket
+import tempfile
+import zipfile
+from pathlib import Path
+from urllib.request import OpenerDirector, Request as UrlRequest
+
+import numpy as np
+import pytest
+
+import imageio as iio
+import imageio.core.request as request_module
+from imageio.core import Request
+from imageio.core.request import (
+    RETURN_BYTES,
+    URI_BYTES,
+    URI_FILE,
+    URI_FILENAME,
+    URI_FTP,
+    URI_HTTP,
+    URI_ZIPPED,
+    IOMode,
+    ImageMode,
+    Mode,
+)
+
+PAYLOAD = bytes(range(256)) * 3
+
+DIRECTORY_ERROR = (
+    "ImageIO does not generally support reading folders. "
+    "Limited support may be available via specific plugins. "
+    "Specify the plugin explicitly using the `plugin` kwarg, e.g. `plugin='DICOM'`"
+)
+
+
+def _make_zip(path, member, payload=PAYLOAD):
+    with zipfile.ZipFile(path, "w") as archive:
+        archive.writestr(member, payload)
+    return path
+
+
+def _member_uri(zip_path, member):
+    return os.path.join(str(zip_path), member)
+
+
+def test_module_public_names_preserved():
+    legacy_names = (
+        "errno os BytesIO zipfile tempfile shutil enum warnings urlopen "
+        "get_remote_file Path urlparse Optional URI_BYTES URI_FILE "
+        "URI_FILENAME URI_ZIPPED URI_HTTP URI_FTP IOMode ImageMode Mode "
+        "SPECIAL_READ_URIS RETURN_BYTES EXAMPLE_IMAGES Request "
+        "read_n_bytes SeekableFileObject InitializationError"
+    ).split()
+    missing_names = [name for name in legacy_names if not hasattr(request_module, name)]
+    assert not missing_names, f"the request module lost public names: {missing_names}"
+
+
+def test_constructor_signature_preserved():
+    parameters = list(inspect.signature(Request).parameters.values())
+    expected = [
+        ("uri", inspect.Parameter.POSITIONAL_OR_KEYWORD, inspect.Parameter.empty),
+        ("mode", inspect.Parameter.POSITIONAL_OR_KEYWORD, inspect.Parameter.empty),
+        ("extension", inspect.Parameter.KEYWORD_ONLY, None),
+        ("format_hint", inspect.Parameter.KEYWORD_ONLY, None),
+        ("kwargs", inspect.Parameter.VAR_KEYWORD, inspect.Parameter.empty),
+    ]
+    assert [(item.name, item.kind, item.default) for item in parameters] == expected
+    with pytest.raises(TypeError):
+        Request(PAYLOAD)
+
+
+class _ReadableFile:
+    def read(self, n=-1):
+        return b""
+
+    def close(self):
+        return None
+
+
+class _WritableFile:
+    def write(self, data):
+        return len(data)
+
+    def close(self):
+        return None
+
+
+# ---------------------------------------------------------------------------
+# input classes / classification
+# ---------------------------------------------------------------------------
+
+
+def test_string_uri_classification_preserved(tmp_path):
+    data_file = tmp_path / "plain.bin"
+    data_file.write_bytes(PAYLOAD)
+    zip_path = _make_zip(tmp_path / "archive.zip", "inner/member.bin")
+
+    cases = [
+        ("http://example.com/x.png", URI_HTTP),
+        ("https://example.com/x.png", URI_HTTP),
+        ("ftp://example.com/x.png", URI_FTP),
+        ("ftps://example.com/x.png", URI_FTP),
+        ("file://" + str(data_file), URI_FILENAME),
+        (str(data_file), URI_FILENAME),
+        (_member_uri(zip_path, "inner/member.bin"), URI_ZIPPED),
+    ]
+    for uri, expected_type in cases:
+        request = Request(uri, "ri")
+        assert request._uri_type == expected_type, uri
+    assert Request("file://" + str(data_file), "ri").filename == str(data_file)
+    assert Request(str(data_file), "ri").filename == str(data_file)
+    assert Request(_member_uri(zip_path, "inner/member.bin"), "ri").extension == ".bin"
+
+
+def test_special_read_uris_and_return_bytes_classification_preserved():
+    for uri in ("<video0>", "<video1>", "<screen>", "<clipboard>"):
+        request = Request(uri, "rI")
+        assert request._uri_type == URI_BYTES, uri
+        assert request.filename == uri
+
+    request = Request(RETURN_BYTES, "wi")
+    assert request._uri_type == URI_BYTES
+    assert request.filename == RETURN_BYTES
+
+
+def test_inmemory_and_path_inputs_classification_preserved(tmp_path):
+    request = Request(PAYLOAD, "ri")
+    assert request._uri_type == URI_BYTES
+    assert request.filename == "<bytes>"
+
+    request = Request(memoryview(PAYLOAD), "ri")
+    assert request._uri_type == URI_BYTES
+    assert request.filename == "<bytes>"
+
+    image = tmp_path / "image.png"
+    image.write_bytes(PAYLOAD)
+    request = Request(image, "ri")
+    assert request._uri_type == URI_FILENAME
+    assert request.filename == str(image)
+    assert request.extension == ".png"
+
+    request = Request(str(image), "ri")
+    assert request._uri_type == URI_FILENAME
+    assert request.filename == str(image)
+
+
+def test_file_object_classification_preserved():
+    request = Request(_ReadableFile(), "ri")
+    assert request._uri_type == URI_FILE
+    assert request.filename == "<file>"
+
+    request = Request(_WritableFile(), "wi")
+    assert request._uri_type == URI_FILE
+    assert request.filename == "<file>"
+
+
+
+def test_standard_image_uri_resolution_preserved(monkeypatch, tmp_path):
+    userdir = tmp_path / "userdir"
+    cache = userdir / ".imageio" / "images"
+    cache.mkdir(parents=True)
+    png_bytes = b"\x89PNG\r\n\x1a\n" + b"seeded-standard-image" * 8
+    (cache / "chelsea.png").write_bytes(png_bytes)
+    with zipfile.ZipFile(cache / "chelsea.zip", "w") as archive:
+        archive.writestr("chelsea.png", png_bytes)
+    monkeypatch.setenv("IMAGEIO_USERDIR", str(userdir))
+
+    plain = Request("imageio:chelsea.png", "ri")
+    assert plain._uri_type == URI_FILENAME
+    assert plain.filename == str(cache / "chelsea.png")
+    assert plain.extension == ".png"
+    assert plain.get_file().read() == png_bytes
+    plain.finish()
+
+    zipped = Request("imageio:chelsea.zip/chelsea.png", "ri")
+    assert zipped._uri_type == URI_ZIPPED
+    assert zipped._filename_zip == (str(cache / "chelsea.zip"), "chelsea.png")
+    assert zipped.extension == ".png"
+    assert zipped.get_file().read() == png_bytes
+    zipped.finish()
+
+def test_zip_lookalike_directory_stays_plain_path(tmp_path):
+    bait = tmp_path / "lookalike.zip"
+    bait.mkdir()
+    inner = bait / "foo.jpg"
+    inner.write_bytes(PAYLOAD)
+
+    request = Request(str(inner), "ri")
+    assert request._uri_type == URI_FILENAME
+    assert request._filename_zip is None
+
+
+def test_user_dir_expansion_and_absolute_paths_preserved(tmp_path, monkeypatch):
+    request = Request("~/imageio_p2p_missing_file.png", "wi")
+    assert request._uri_type == URI_FILENAME
+    assert request.filename == os.path.abspath(
+        os.path.expanduser("~/imageio_p2p_missing_file.png")
+    )
+
+    relative = tmp_path / "relative.bin"
+    relative.write_bytes(PAYLOAD)
+    monkeypatch.chdir(tmp_path)
+    request = Request("relative.bin", "ri")
+    assert request.filename == str(relative)
+
+
+# ---------------------------------------------------------------------------
+# public attributes and properties
+# ---------------------------------------------------------------------------
+
+
+def test_public_attributes_and_properties_preserved(tmp_path):
+    image = tmp_path / "picture.png"
+    image.write_bytes(PAYLOAD)
+
+    request = Request(image, "ri", my_kwarg=17)
+    assert request.raw_uri == image
+    assert request.filename == str(image)
+    assert request.extension == ".png"
+    assert request.format_hint is None
+    assert request.mode == "ri"
+    assert request.mode.io_mode is IOMode.read
+    assert request.mode.image_mode is ImageMode.single_image
+    assert request.mode[0] == "r"
+    assert request.mode[1] == "i"
+    assert request.kwargs == {"my_kwarg": 17}
+
+    string_request = Request(str(image), "ri")
+    assert string_request.raw_uri == str(image)
+
+
+def test_mode_normalization_preserved():
+    assert Request(PAYLOAD, "r").mode == "r?"
+    assert Request("~/bar.zip/spam.png", "w").mode == "w?"
+    assert Request(PAYLOAD, "r").mode.io_mode is IOMode.read
+    assert Request("~/bar.zip/spam.png", "w").mode[0] == "w"
+
+    mode = Mode("ri")
+    assert mode == "ri"
