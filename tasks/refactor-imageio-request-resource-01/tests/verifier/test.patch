+    file_path = _write_file(tmp_path / "epsilon.bin", PAYLOAD_C)
+    request = Request(file_path, "ri")
+    seen = []
+
+    def recording_plugin(plugin_request, **kwargs):
+        seen.append(plugin_request)
+        return object()
+
+    imopen(request, "r", plugin=recording_plugin, legacy_mode=True)
+    assert seen and seen[-1] is request, "legacy mode must hand the built request to the plugin"
+    assert _same_values(_read_queries(seen[-1], names), expected["local_path"]), (
+        "the legacy request handed to the plugin does not report the local-path kind"
+    )
+
+
+# ---------------------------------------------------------------------------
+# state, side effects and error priority
+# ---------------------------------------------------------------------------
+
+
+def test_kind_queries_are_stable_across_get_file_and_finish(tmp_path):
+    families = _build_families(tmp_path)
+    names, expected = _expected_vectors(families)
+
+    read_request = Request(PAYLOAD_A, "ri")
+    before_read = _read_queries(read_request, names)
+    assert _same_values(before_read, expected["bytes"])
+    assert read_request.get_file().read(len(PAYLOAD_A)) == PAYLOAD_A
+    read_request.finish()
+    assert _same_values(_read_queries(read_request, names), before_read), (
+        "the kind queries changed while a bytes request was read and finished"
+    )
+
+    write_request = Request(_return_bytes(), "wi")
+    before_write = _read_queries(write_request, names)
+    assert _same_values(before_write, expected["bytes"])
+    write_request.get_file().write(PAYLOAD_B)
+    write_request.finish()
+    assert _same_values(_read_queries(write_request, names), before_write), (
+        "the kind queries changed while a write-to-bytes request was finished"
+    )
