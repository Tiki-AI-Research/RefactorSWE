+def test_finish_returns_none_for_every_write_target(tmp_path, monkeypatch):
+    request = Request(tmp_path / "direct.bin", "wi")
+    request.get_file()
+    assert request.finish() is None
+
+    request = Request(RETURN_BYTES, "wi")
+    request.get_file()
+    assert request.finish() is None
+
+    request = Request(io.BytesIO(), "wi")
+    request.get_file()
+    assert request.finish() is None
+
+    import sys
+
+    for uri in (RETURN_BYTES, _member_uri(tmp_path / "unopened.zip", "member.bin")):
+        request = Request(uri, "wi")
+        allocation_error = MemoryError("buffer allocation denied")
+        allocation_calls = []
+
+        def fail_allocate(*args, **kwargs):
+            allocation_calls.append((args, kwargs))
+            raise allocation_error
+
+        with monkeypatch.context() as allocation:
+            for module_name, module in tuple(sys.modules.items()):
+                if module_name.startswith("imageio.core.") and module is not None:
+                    for name, value in tuple(vars(module).items()):
+                        if value is io.BytesIO:
+                            allocation.setattr(module, name, fail_allocate)
+            allocation.setattr(io, "BytesIO", fail_allocate)
+            with pytest.raises(MemoryError) as raised:
+                request.get_file()
+            assert raised.value is allocation_error
+            try:
+                completion = request.finish()
+            except Exception as error:
+                raise AssertionError(
+                    "finish() must remain valid after write-buffer allocation fails"
+                ) from error
+            assert completion is None
+            assert request.finish() is None
+            assert request.get_result() is None
+            assert len(allocation_calls) == 1
+            assert not (tmp_path / "unopened.zip").exists()
+
