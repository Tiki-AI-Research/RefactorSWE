+            "ftps://example.com/test.png",
+            "ri",
+            core.request.ResourceKind.FTP,
+            core.request.URI_FTP,
+        ),
+    ]
+    kinds_seen = set()
+    types_seen = set()
+    for uri, mode, expected_kind, expected_uri_type in cases:
+        req = Request(uri, mode)
+        assert req.resource_kind == expected_kind
+        assert req.resource_kind is expected_kind
+        assert req._uri_type == expected_uri_type
+        # check read-only
+        with pytest.raises(AttributeError):
+            req.resource_kind = expected_kind
+        # check accessing resource_kind does not open file
+        if expected_kind is not core.request.ResourceKind.FILE:
+            assert req._file is None
+        kinds_seen.add(expected_kind)
+        types_seen.add(expected_uri_type)
+        assert req.finish() is None
+        # readable after finish
+        assert req.resource_kind is expected_kind
+
+    assert len(kinds_seen) == 6
+    assert len(types_seen) == 6
+
