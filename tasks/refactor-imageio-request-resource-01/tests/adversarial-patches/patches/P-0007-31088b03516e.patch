+def test_http_uri_is_passed_to_av_open(monkeypatch):
+    import av
+    from imageio.plugins.pyav import PyAVPlugin
+    from imageio.core import Request
+
+    recorded = []
+
+    class DummyContainer:
+        def __init__(self):
+            self.streams = type("Streams", (), {"video": [type("Stream", (), {})()]})()
+
+        def decode(self, **kwargs):
+            return iter([])
+
+        def close(self):
+            pass
+
+    def fake_open(target, **kwargs):
+        recorded.append(target)
+        return DummyContainer()
+
+    monkeypatch.setattr(av, "open", fake_open)
+
+    # HTTP request
+    req_http = Request("http://example.com/video.mp4", "r")
+    plugin_http = PyAVPlugin(req_http)
+    assert recorded[-1] == "http://example.com/video.mp4"
+
+    # HTTPS request
+    req_https = Request("https://example.com/video.mp4", "r")
+    plugin_https = PyAVPlugin(req_https)
+    assert recorded[-1] == "https://example.com/video.mp4"
+
+    # Non-HTTP request (e.g. bytes)
+    req_bytes = Request(b"\x00" * 100, "r", extension=".mp4")
+    plugin_bytes = PyAVPlugin(req_bytes)
+    assert recorded[-1] is req_bytes.get_file()
+
+    plugin_http.close()
+    plugin_https.close()
+    plugin_bytes.close()
