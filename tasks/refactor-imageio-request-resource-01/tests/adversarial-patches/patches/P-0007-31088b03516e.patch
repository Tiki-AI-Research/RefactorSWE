+def test_request_finish_does_not_close_caller_file(tmp_path):
+    # Read mode with real file object
+    filepath = tmp_path / "sample.txt"
+    filepath.write_bytes(b"hello world")
+    with open(filepath, "rb") as fh:
+        req = Request(fh, "ri")
+        req.get_local_filename()
+        assert req.finish() is None
+        assert not fh.closed
+        fh.seek(0)
+        assert fh.read() == b"hello world"
+
+    # Write mode with BytesIO
+    buf = BytesIO()
+    req_w = Request(buf, "wi")
+    loc = req_w.get_local_filename()
+    with open(loc, "wb") as f:
+        f.write(b"written bytes")
+    assert req_w.finish() is None
+    assert not buf.closed
+    assert buf.getvalue() == b"written bytes"
+    assert not os.path.exists(loc)
 
 
