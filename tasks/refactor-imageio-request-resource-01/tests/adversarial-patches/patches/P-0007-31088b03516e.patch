+def test_request_timeout_env_variable(monkeypatch):
+    getenv_calls = []
+    urlopen_calls = []
+
+    real_getenv = os.getenv
+
+    def fake_getenv(key, default=None):
+        if key == "IMAGEIO_REQUEST_TIMEOUT":
+            getenv_calls.append(key)
+        return real_getenv(key, default)
+
+    def fake_urlopen(url, timeout=None):
+        urlopen_calls.append((url, timeout))
+        return BytesIO(b"data")
+
+    monkeypatch.setattr(os, "getenv", fake_getenv)
+    monkeypatch.setattr(imageio.core.request, "urlopen", fake_urlopen)
+
+    # Non-HTTP construction and get_file: no getenv, no urlopen
+    req_bytes = Request(b"data", "ri")
+    req_bytes.get_file()
+    req_bytes.finish()
+    assert len(getenv_calls) == 0
+    assert len(urlopen_calls) == 0
+
+    # HTTP construction: no getenv, no urlopen
+    req_http = Request("http://example.com/test.png", "ri")
+    assert len(getenv_calls) == 0
+    assert len(urlopen_calls) == 0
+
+    # HTTP get_file(): getenv called once, urlopen with 5.0 default
+    req_http.get_file()
+    assert len(getenv_calls) == 1
+    assert len(urlopen_calls) == 1
+    assert urlopen_calls[0] == ("http://example.com/test.png", 5.0)
+    req_http.finish()
+
+    # HTTP with IMAGEIO_REQUEST_TIMEOUT="10"
+    monkeypatch.setenv("IMAGEIO_REQUEST_TIMEOUT", "10")
+    req_http2 = Request("http://example.com/test2.png", "ri")
+    req_http2.get_file()
+    assert urlopen_calls[-1] == ("http://example.com/test2.png", 10.0)
+    req_http2.finish()
+
