+def test_request_construction_has_no_side_effects(tmp_path, monkeypatch):
+    import builtins
+
+    counts = {"open": 0, "mkstemp": 0, "urlopen": 0}
+
+    real_open = builtins.open
+    real_mkstemp = tempfile.mkstemp
+
+    def counted_open(*args, **kwargs):
+        counts["open"] += 1
+        return real_open(*args, **kwargs)
+
+    def counted_mkstemp(*args, **kwargs):
+        counts["mkstemp"] += 1
+        return real_mkstemp(*args, **kwargs)
+
+    def counted_urlopen(*args, **kwargs):
+        counts["urlopen"] += 1
+        raise AssertionError("urlopen called during construction")
+
+    monkeypatch.setattr(builtins, "open", counted_open)
+    monkeypatch.setattr(tempfile, "mkstemp", counted_mkstemp)
+    monkeypatch.setattr(imageio.core.request, "urlopen", counted_urlopen)
+
+    existing_file = tmp_path / "exist.png"
+    with real_open(existing_file, "wb") as f:
+        f.write(b"data")
+
+    bio = BytesIO()
+
+    cases = [
+        (str(existing_file), "ri"),
+        (Path(existing_file), "ri"),
+        (b"data", "ri"),
+        (memoryview(b"data"), "ri"),
+        ("<video0>", "rI"),
+        (iio.RETURN_BYTES, "wi"),
+        (str(tmp_path / "out.png"), "wi"),
+        (bio, "ri"),
+        (bio, "wi"),
+        ("http://example.com/test.png", "ri"),
+        ("https://example.com/test.png", "ri"),
+        ("ftp://example.com/test.png", "ri"),
+        ("ftps://example.com/test.png", "ri"),
+    ]
+
+    for uri, mode in cases:
+        counts["open"] = 0
+        counts["mkstemp"] = 0
+        counts["urlopen"] = 0
+        req = Request(uri, mode)
+        assert counts["open"] == 0
+        assert counts["mkstemp"] == 0
+        assert counts["urlopen"] == 0
+        assert req._filename_local is None
+        if hasattr(uri, "read") or hasattr(uri, "write"):
+            assert req._file is uri
+        else:
+            assert req._file is None
+        req.finish()
+
