+export default function bezier() {
+	return (t) => t;
+}
+`)}`;
+const VITEST_STUB = `data:text/javascript,export default globalThis.__F2P_VITEST__;export const describe = globalThis.__F2P_VITEST__.describe;export const it = globalThis.__F2P_VITEST__.it;export const test = globalThis.__F2P_VITEST__.test;export const expect = globalThis.__F2P_VITEST__.expect;export const beforeAll = globalThis.__F2P_VITEST__.beforeAll;export const afterAll = globalThis.__F2P_VITEST__.afterAll;export const beforeEach = globalThis.__F2P_VITEST__.beforeEach;export const afterEach = globalThis.__F2P_VITEST__.afterEach;export const AssertionError = globalThis.__F2P_VITEST__.AssertionError;`;
+
+globalThis.__F2P_VITEST__ = vitestShim;
+globalThis.__F2P_IMPORT_META_ENV__ = { DEV: false, PROD: true, MODE: "test", SSR: false };
+
+const BARE_SHIMS = new Map([
+	["@ungap/structured-clone", STRUCTURED_CLONE_STUB],
+	["bezier-easing", BEZIER_STUB],
+	["vitest", VITEST_STUB],
+]);
+
+const EXTENSION_CANDIDATES = [".ts", ".tsx", ".mts", ".js", ".mjs", "/index.ts", "/index.tsx", "/index.mts", "/index.js"];
+
+function resolveExtensionlessRelative(specifier, parentURL) {
+	if (!parentURL || !specifier.startsWith(".")) return null;
+	if (/\.[cm]?[jt]sx?$/.test(specifier)) return null;
+	for (const candidate of EXTENSION_CANDIDATES) {
+		const url = new URL(`${specifier}${candidate}`, parentURL);
+		if (existsSync(fileURLToPath(url))) return url.href;
+	}
+	return null;
+}
+
+registerHooks({
+	resolve(specifier, context, nextResolve) {
+		const shim = BARE_SHIMS.get(specifier);
+		if (shim) return { url: shim, format: "module", shortCircuit: true };
+		const relative = resolveExtensionlessRelative(specifier, context.parentURL);
+		if (relative) return { url: relative, shortCircuit: true };
+		return nextResolve(specifier, context);
+	},
+	load(url, context, nextLoad) {
+		if (url.startsWith("data:")) return nextLoad(url, context);
+		if (url.endsWith(".css")) {
+			return { format: "module", source: "export default new Proxy({}, { get: (_, key) => typeof key === 'string' ? key : undefined });", shortCircuit: true };
+		}
+		if (/\.(ts|tsx|mts)$/.test(url)) {
+			const original = readFileSync(fileURLToPath(url), "utf8");
+			const rewritten = original.replaceAll(
+				"import.meta.env",
+				"globalThis.__F2P_IMPORT_META_ENV__",
+			);
+			const source = stripTypeScriptTypes(rewritten, {
+				mode: "transform",
+				sourceUrl: url,
+			});
+			return { format: "module", source, shortCircuit: true };
+		}
+		return nextLoad(url, context);
