+
+it("P2P: sets the propagation flag and stops propagation on the original event when stopPropagation is called", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([makeLine(0, 1000, { word: "A" })]);
+
+	let propagationStopped = true;
+	player.addEventListener("line-click", (event) => {
