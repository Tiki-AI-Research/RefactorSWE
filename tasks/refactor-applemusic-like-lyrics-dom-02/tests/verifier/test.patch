+#!/usr/bin/env node
+/**
+ * F2P owner （ Node.js ）
+ *
+ *  node_modules，：
+ * 1.  `node:module`  `.css` 
+ *    （`@ungap/structured-clone``bezier-easing`） `vitest` ；
+ * 2.  `describe/it/expect`  API（ `it.each`）；
+ * 3.  JUnit XML（`{report}`）
+ *
+ * （）：
+ *   node --disable-warning=ExperimentalWarning \
+ *     packages/core/test/f2p-owner/run-f2p.mjs --report <junit.xml> \
+ *     <test-file> [...]
+ *
+ * JUnit  classname （， `--root` ），
+ *  P2P  `path::name` 
+ * `<failure type="AssertionError">`， `<error>`，
+ * 
+ *
+ * （`--worker`），
+ * ，；
+ *  JUnit  `{report}`
+ */
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { registerHooks, stripTypeScriptTypes } from "node:module";
+import { tmpdir } from "node:os";
+import { dirname, isAbsolute, join, relative, resolve, sep } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+/**  <repo>/packages/core/test/f2p-owner/run-f2p.mjs， */
+const REPO_ROOT = resolve(
+	dirname(fileURLToPath(import.meta.url)),
+	"..",
+	"..",
+	"..",
+	"..",
+);
+
+if (typeof stripTypeScriptTypes !== "function") {
+	throw new Error(
+		"run-f2p.mjs requires Node.js with module.stripTypeScriptTypes (Node >= 22.13)",
+	);
+}
+
+// ---------------------------------------------------------------------------
+//  API（vitest ）
+// ---------------------------------------------------------------------------
+
+export class AssertionError extends Error {
+	constructor(message) {
+		super(message);
+		this.name = "AssertionError";
+	}
+}
+
+function display(value, seen = new Set(), depth = 0) {
+	if (value === null) return "null";
+	if (value === undefined) return "undefined";
+	if (typeof value === "string") return JSON.stringify(value);
+	if (typeof value === "number" || typeof value === "boolean" || typeof value === "bigint")
+		return String(value);
+	if (typeof value === "function") return `[Function ${value.name || "anonymous"}]`;
+	if (typeof value === "symbol") return value.toString();
+	if (value instanceof Error) return `${value.name}: ${value.message}`;
+	if (value instanceof Date) return `Date(${value.toISOString()})`;
+	if (value instanceof RegExp) return value.toString();
+	if (seen.has(value)) return "[Circular]";
+	seen.add(value);
+	if (depth > 2) return "[Object]";
+	if (Array.isArray(value)) return `[${value.map((item) => display(item, seen, depth + 1)).join(", ")}]`;
+	if (value instanceof Map) return `Map(${display([...value.entries()], seen, depth + 1)})`;
+	if (value instanceof Set) return `Set(${display([...value.values()], seen, depth + 1)})`;
+	if (ArrayBuffer.isView(value)) return `${value.constructor.name}(${[...value].join(", ")})`;
+	const entries = Object.entries(value).map(
+		([key, item]) => `${key}: ${display(item, seen, depth + 1)}`,
+	);
+	return `{ ${entries.join(", ")} }`;
+}
+
+function truncate(text, limit = 240) {
+	const value = String(text);
+	return value.length <= limit ? value : `${value.slice(0, limit)}…`;
+}
+
+function keysOf(value) {
+	return Object.keys(value).filter((key) => value[key] !== undefined);
+}
+
+function deepEqual(a, b, seen = new Map()) {
+	if (Object.is(a, b)) return true;
+	if (typeof a !== typeof b) return false;
+	if (typeof a !== "object" || a === null || b === null) return false;
+	const previous = seen.get(a);
+	if (previous?.has(b)) return true;
+	if (!previous) seen.set(a, new Set([b]));
+	else previous.add(b);
+
+	if (a instanceof Date || b instanceof Date)
+		return a instanceof Date && b instanceof Date && a.getTime() === b.getTime();
+	if (a instanceof RegExp || b instanceof RegExp)
+		return a instanceof RegExp && b instanceof RegExp && a.source === b.source && a.flags === b.flags;
+	if (ArrayBuffer.isView(a) || ArrayBuffer.isView(b)) {
+		if (!ArrayBuffer.isView(a) || !ArrayBuffer.isView(b)) return false;
+		if (a.constructor !== b.constructor || a.byteLength !== b.byteLength) return false;
+		return [...a].every((item, index) => deepEqual(item, b[index], seen));
+	}
+	if (a instanceof Map || b instanceof Map) {
+		if (!(a instanceof Map) || !(b instanceof Map) || a.size !== b.size) return false;
+		for (const [key, value] of a) {
+			if (!b.has(key) || !deepEqual(value, b.get(key), seen)) return false;
+		}
+		return true;
+	}
+	if (a instanceof Set || b instanceof Set) {
+		if (!(a instanceof Set) || !(b instanceof Set) || a.size !== b.size) return false;
+		for (const value of a) if (!b.has(value)) return false;
+		return true;
+	}
+	if (Array.isArray(a) || Array.isArray(b)) {
+		if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+		return a.every((item, index) => deepEqual(item, b[index], seen));
+	}
+	const aKeys = keysOf(a);
+	const bKeys = keysOf(b);
+	if (aKeys.length !== bKeys.length) return false;
+	return aKeys.every((key) => deepEqual(a[key], b[key], seen));
+}
+
+function matchesObject(actual, expected, seen = new Map()) {
+	if (Object.is(actual, expected)) return true;
+	if (expected === null || typeof expected !== "object") return deepEqual(actual, expected, seen);
+	if (actual === null || typeof actual !== "object") return false;
+	if (expected instanceof Date || expected instanceof RegExp) return deepEqual(actual, expected, seen);
+	if (Array.isArray(expected)) {
+		if (!Array.isArray(actual) || actual.length < expected.length) return false;
+		return expected.every((item, index) => matchesObject(actual[index], item, seen));
+	}
+	return keysOf(expected).every((key) => matchesObject(actual[key], expected[key], seen));
+}
+
+function makeMatchers(actual, negated) {
+	const assert = (passed, message) => {
+		if (negated ? passed : !passed) throw new AssertionError(message);
+	};
+	const matchers = {
+		toBe(expected) {
+			assert(
+				Object.is(actual, expected),
+				truncate(`expected ${display(actual)} ${negated ? "not " : ""}to be ${display(expected)}`),
+			);
+		},
+		toEqual(expected) {
+			assert(
+				deepEqual(actual, expected),
+				truncate(`expected ${display(actual)} ${negated ? "not " : ""}to equal ${display(expected)}`),
+			);
+		},
+		toStrictEqual(expected) {
+			matchers.toEqual(expected);
+		},
+		toMatchObject(expected) {
+			assert(
+				matchesObject(actual, expected),
+				truncate(`expected ${display(actual)} ${negated ? "not " : ""}to match object ${display(expected)}`),
+			);
+		},
+		toBeUndefined() {
+			assert(actual === undefined, `expected ${display(actual)} ${negated ? "not " : ""}to be undefined`);
+		},
+		toBeDefined() {
+			assert(actual !== undefined, `expected ${display(actual)} ${negated ? "not " : ""}to be defined`);
+		},
+		toBeNull() {
+			assert(actual === null, `expected ${display(actual)} ${negated ? "not " : ""}to be null`);
+		},
+		toBeTruthy() {
+			assert(Boolean(actual), `expected ${display(actual)} ${negated ? "not " : ""}to be truthy`);
+		},
+		toBeFalsy() {
+			assert(!actual, `expected ${display(actual)} ${negated ? "not " : ""}to be falsy`);
+		},
+		toBeInstanceOf(expected) {
+			assert(
+				actual instanceof expected,
+				`expected ${display(actual)} ${negated ? "not " : ""}to be instance of ${expected?.name}`,
+			);
+		},
+		toHaveLength(expected) {
+			assert(
+				actual?.length === expected,
+				`expected length ${display(actual?.length)} ${negated ? "not " : ""}to be ${expected}`,
+			);
+		},
+		toContain(expected) {
+			const passed =
+				typeof actual?.includes === "function" &&
+				(typeof expected === "string" ? actual.includes(expected) : actual.includes(expected));
+			assert(passed, `expected ${display(actual)} ${negated ? "not " : ""}to contain ${display(expected)}`);
+		},
+		toContainEqual(expected) {
+			const passed = Array.from(actual ?? []).some((item) => deepEqual(item, expected));
+			assert(passed, `expected ${display(actual)} ${negated ? "not " : ""}to contain equal ${display(expected)}`);
+		},
+		toMatch(expected) {
+			const passed =
+				expected instanceof RegExp
+					? expected.test(String(actual))
+					: String(actual).includes(String(expected));
+			assert(passed, `expected ${display(actual)} ${negated ? "not " : ""}to match ${display(expected)}`);
+		},
+		toBeLessThan(expected) {
+			assert(actual < expected, `expected ${display(actual)} ${negated ? "not " : ""}to be less than ${display(expected)}`);
+		},
+		toBeGreaterThan(expected) {
+			assert(actual > expected, `expected ${display(actual)} ${negated ? "not " : ""}to be greater than ${display(expected)}`);
+		},
+		toBeGreaterThanOrEqual(expected) {
+			assert(actual >= expected, `expected ${display(actual)} ${negated ? "not " : ""}to be >= ${display(expected)}`);
+		},
+		toBeLessThanOrEqual(expected) {
+			assert(actual <= expected, `expected ${display(actual)} ${negated ? "not " : ""}to be <= ${display(expected)}`);
+		},
+		toBeCloseTo(expected, precision = 2) {
+			const tolerance = 10 ** -precision / 2;
+			assert(Math.abs(actual - expected) <= tolerance, `expected ${display(actual)} ${negated ? "not " : ""}to be close to ${display(expected)}`);
+		},
+		toThrow(expected) {
+			if (typeof actual !== "function") {
+				throw new AssertionError("toThrow expects a function");
+			}
+			let thrown = null;
+			let didThrow = false;
+			try {
+				actual();
+			} catch (error) {
+				didThrow = true;
+				thrown = error;
+			}
+			if (negated) {
+				if (didThrow) throw new AssertionError(`expected function not to throw, but it threw ${display(thrown)}`);
+				return;
+			}
+			if (!didThrow) throw new AssertionError("expected function to throw, but it did not");
+			if (expected === undefined) return;
+			if (expected instanceof Error) {
+				const sameType = thrown instanceof expected.constructor;
+				const sameMessage = String(thrown?.message) === String(expected.message);
+				if (!sameType || !sameMessage) {
+					throw new AssertionError(
+						`expected function to throw ${expected.constructor.name}(${display(expected.message)}), but it threw ${display(thrown?.name)}(${display(thrown?.message)})`,
+					);
+				}
+				return;
+			}
+			if (typeof expected === "function") {
+				if (!(thrown instanceof expected)) {
+					throw new AssertionError(
+						`expected function to throw ${expected.name}, but it threw ${display(thrown)}`,
+					);
+				}
+				return;
+			}
+			if (expected instanceof RegExp) {
+				if (!expected.test(String(thrown?.message ?? thrown))) {
+					throw new AssertionError(`expected error message ${display(thrown?.message)} to match ${expected}`);
+				}
+				return;
+			}
+			if (!String(thrown?.message ?? thrown).includes(String(expected))) {
+				throw new AssertionError(
+					`expected error message ${display(thrown?.message)} to contain ${display(expected)}`,
+				);
+			}
+		},
+	};
+	return matchers;
+}
+
+function expect(actual) {
+	return {
+		...makeMatchers(actual, false),
