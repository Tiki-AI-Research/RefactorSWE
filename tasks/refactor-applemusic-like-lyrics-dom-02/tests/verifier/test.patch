+/** Rebuild-time ordering must also work when the DOM construction is bypassed. */
+import { beforeAll, afterAll, expect, it } from "vitest";
+import { installFakeDomEnv, uninstallFakeDomEnv, triggerResize } from "../f2p-owner/fake-dom-env.ts";
+import { attachPlayer, buildGroups, configurePlayer, createStandardPlayer, loadPlayerClasses, makeLine, type PlayerClasses } from "../f2p-owner/f2p-fixtures.ts";
+let classes: PlayerClasses;
+beforeAll(async () => { installFakeDomEnv(); classes = await loadPlayerClasses(); });
+afterAll(() => { uninstallFakeDomEnv(); });
+
+function unorderedPlayer(initialTime = 0) {
+    class Subclass extends classes.DomLyricPlayer {
+        protected override buildLyricGroups(): void {
+            // Input preprocessing cannot sort this array: the extension creates it afterwards.
+            this.currentLyricGroups = buildGroups(this, classes, [
+                makeLine(2000, 3000, { word: "late" }),
+                makeLine(1000, 2000, { word: "tie-first" }),
+                makeLine(1000, 2000, { word: "tie-second" }),
+                makeLine(0, 1000, { word: "early" }),
+            ]);
+        }
+    }
+    const player = configurePlayer(new Subclass());
+    player.setLyricLines([], initialTime);
+    return player;
+}
+function activeWords(player: InstanceType<PlayerClasses["DomLyricPlayer"]>) {
+    return player.currentLyricGroups.filter(group => group.isActive)
+        .map(group => group.mainLine.getLine().words[0].word);
+}
+it("P2P: stably rebuilds nondecreasing start times for directly populated subclass groups", () => {
+    const player = unorderedPlayer();
+    expect(player.currentLyricGroups.map(group => group.mainLine.getLine().startTime))
+        .toEqual([0, 1000, 1000, 2000]);
+    player.dispose();
+});
+it("P2P: keeps subclass construction order for equal start times", () => {
+    const player = unorderedPlayer();
+    expect(player.currentLyricGroups.slice(1, 3).map(group => group.mainLine.getLine().words[0].word))
+        .toEqual(["tie-first", "tie-second"]);
+    player.dispose();
+});
+it("P2P: initializes timeline playback bounds from sorted subclass groups", () => {
+    const player = unorderedPlayer(1500);
+    expect(activeWords(player)).toEqual(["tie-first", "tie-second"]);
+    player.dispose();
+});
+it("P2P: initializes a fallback height slot for each directly populated subclass group", () => {
+    const player = unorderedPlayer();
+    attachPlayer(player);
+    expect([0, 1, 2, 3].map(index => player.getLineHeight(index)))
+        .toEqual([player.defaultLineHeight, player.defaultLineHeight, player.defaultLineHeight, player.defaultLineHeight]);
+    player.dispose();
+});
+it("P2P: rebuilds an empty subclass group array without retaining old groups", () => {
+    class Empty extends classes.DomLyricPlayer {
+        protected override buildLyricGroups(): void { this.currentLyricGroups = []; }
+    }
+    const player = configurePlayer(new Empty());
+    player.setLyricLines([makeLine(0, 1000)]);
+    player.rebuildLyricView(0);
+    expect(player.currentLyricGroups).toEqual([]);
+    player.dispose();
+});
+it("P2P: preserves paused repeated-time short circuit without an explicit seek", () => {
+    const player = createStandardPlayer(classes);
+    player.setLyricLines([makeLine(0, 1000)]);
+    player.pause();
+    let calls = 0;
+    const timeline = (player as unknown as { timelineController: { sync: (...args: unknown[]) => unknown } }).timelineController;
+    const sync = timeline.sync.bind(timeline);
+    timeline.sync = (...args) => { calls++; return sync(...args); };
+    player.setCurrentTime(0);
+    expect(calls).toBe(0);
+    player.dispose();
+});
+it("P2P: ignores identical main-element measurements after an array mutation", () => {
+    const player = createStandardPlayer(classes);
+    player.setLyricLines([makeLine(0, 1000), makeLine(1000, 2000), makeLine(2000, 3000)]);
+    attachPlayer(player);
+    const group = player.currentLyricGroups[0];
+    triggerResize(player.resizeObserver, { target: group.getElement(), width: 100, height: 42 });
+    player.currentLyricGroups.reverse();
+    const before = [0, 1, 2].map(index => player.getLineHeight(index));
+    let calls = 0;
+    const notify = group.onLineSizeChange.bind(group);
+    group.onLineSizeChange = size => { calls++; notify(size); };
+    triggerResize(player.resizeObserver, { target: group.getElement(), width: 100, height: 42 });
+    expect({ calls, heights: [0, 1, 2].map(index => player.getLineHeight(index)) })
+        .toEqual({ calls: 0, heights: before });
+    player.dispose();
+});
