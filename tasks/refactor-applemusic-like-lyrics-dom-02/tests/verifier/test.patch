+import { afterAll, expect, it } from 'vitest';
+import { installFakeDomEnv, triggerResize, uninstallFakeDomEnv } from '../f2p-owner/fake-dom-env.ts';
+import { attachPlayer, createStandardPlayer, loadPlayerClasses, makeLine, threeMainLines } from '../f2p-owner/f2p-fixtures.ts';
+installFakeDomEnv();
+const classes = await loadPlayerClasses();
+afterAll(uninstallFakeDomEnv);
+
+it('F2P: a newly appended group is measured without a new registration call', () => {
+  const p=createStandardPlayer(classes);
+  p.setLyricLines(threeMainLines()); attachPlayer(p);
+  const group=new classes.LyricLineGroup(p,new classes.LyricLineEl(p,makeLine(5000,6000)));
+  const previousHeights = p.currentLyricGroups.map((_, i) => p.getLineHeight(i));
+  p.currentLyricGroups.push(group);
+  const calls: any[]=[];
+  group.onLineSizeChange = size => calls.push(size);
+  triggerResize(p.resizeObserver,{target:group.getElement(),width:137,height:61});
+  const result={cache:p.lyricGroupSize.get(group),calls,index:p.currentLyricGroups.indexOf(group),height:p.getLineHeight(3)};
+  expect(result.cache).toEqual([137,61]); expect(result.calls).toEqual([[137,61]]); expect(result.height).toBe(61);
+  expect(previousHeights).toEqual(previousHeights.map((_, i) => p.getLineHeight(i)));
+});
+
+it('F2P: removal preserves size notification and cache with zero slot writes', () => {
+  const p=createStandardPlayer(classes);
+  p.setLyricLines(threeMainLines()); attachPlayer(p);
+  const group=p.currentLyricGroups[0]; p.currentLyricGroups.splice(0,1);
+  const writes:any[]=[],calls:any[]=[]; const layout=(p as any).layoutCalculator;
+  const original=layout.setLineHeight.bind(layout);
+  layout.setLineHeight=(...args:any[])=>{writes.push(args);return original(...args);};
+  group.onLineSizeChange=size=>calls.push(size);
+  let error:string|null=null;
+  try { triggerResize(p.resizeObserver,{target:group.getElement(),width:137,height:61}); }
+  catch(e) {error=String(e);}
+  const result={writes,calls,cache:p.lyricGroupSize.get(group),error};
+  expect(result.writes).toEqual([]); expect(result.calls).toEqual([[137,61]]); expect(result.cache).toEqual([137,61]); expect(result.error).toBeNull();
+});
diff --git a/packages/core/test/f2p-owner/f2p-fixtures.ts b/packages/core/test/f2p-owner/f2p-fixtures.ts
new file mode 100644
index 0000000..45f2145
--- /dev/null
+++ b/packages/core/test/f2p-owner/f2p-fixtures.ts
@@ -0,0 +1,190 @@
+/**
+ * Shared fixtures for the F2P owner tests.
+ *
+ * The fixtures build DOM lyric players whose group array is populated by a
+ * subclass (the documented `buildLyricGroups` extension point) instead of the
+ * DOM build path, so the group relationships owned by the player can be
+ * observed from the outside.
+ */
+import type { LyricLine } from "#interfaces";
+import { triggerResize } from "./fake-dom-env.ts";
+import type { DomLyricPlayer } from "#lyric/dom/index.ts";
+import type { LyricLineGroup } from "#lyric/dom/lyric-group.ts";
+import type { LyricLineEl } from "#lyric/dom/lyric-line.ts";
+
+/** ， */
+export const DISABLED_OPTIMIZE_OPTIONS = {
+	normalizeSpaces: false,
+	resetLineTimestamps: false,
+	syncMainAndBackgroundLines: false,
+	cleanUnintentionalOverlaps: false,
+	tryAdvanceStartTime: false,
+};
+
+export interface LineOptions extends Partial<LyricLine> {
+	/**  */
+	word?: string;
+}
+
+/**  */
+export function makeLine(
+	startTime: number,
+	endTime: number,
+	options: LineOptions = {},
+): LyricLine {
+	const { word = "w", ...overrides } = options;
+	return {
+		words: [{ word, startTime, endTime }],
+		translatedLyric: "",
+		romanLyric: "",
+		startTime,
+		endTime,
+		isBG: false,
+		isDuet: false,
+		...overrides,
+	};
+}
+
+export interface PlayerClasses {
+	DomLyricPlayer: typeof DomLyricPlayer;
+	LyricLineGroup: typeof LyricLineGroup;
+	LyricLineEl: typeof LyricLineEl;
+}
+
+/**  DOM  */
+export async function loadPlayerClasses(): Promise<PlayerClasses> {
+	const { DomLyricPlayer } = await import("#lyric/dom/index.ts");
+	const { LyricLineGroup } = await import("#lyric/dom/lyric-group.ts");
+	const { LyricLineEl } = await import("#lyric/dom/lyric-line.ts");
+	return { DomLyricPlayer, LyricLineGroup, LyricLineEl };
+}
+
+/** ， */
+export function configurePlayer<T extends DomLyricPlayer>(player: T): T {
+	player.setEnableSpring(false);
+	player.setLyricProcessConfig({
+		optimizeOptions: DISABLED_OPTIMIZE_OPTIONS,
+	});
+	return player;
+}
+
+/** ， */
+export function attachPlayer(player: DomLyricPlayer): void {
+	triggerResize(
+		(player as unknown as { resizeObserver: unknown }).resizeObserver,
+		{ target: player.getElement(), width: 1200, height: 800 },
+	);
+	player.update(0);
+}
+
+/** ， */
+export function buildGroups(
+	player: DomLyricPlayer,
+	classes: PlayerClasses,
+	lines: ReadonlyArray<LyricLine>,
+): LyricLineGroup[] {
+	const groups: LyricLineGroup[] = [];
+	let currentGroup: LyricLineGroup | null = null;
+	for (const line of lines) {
+		const element = new classes.LyricLineEl(player, line);
+		if (!line.isBG || !currentGroup) {
+			currentGroup = new classes.LyricLineGroup(player, element);
+			groups.push(currentGroup);
+		} else {
+			currentGroup.addBgLine(element);
+		}
+	}
+	return groups;
+}
+
+/**  DOM  */
+export function createStandardPlayer(classes: PlayerClasses): DomLyricPlayer {
+	return configurePlayer(new classes.DomLyricPlayer());
+}
+
+/** ： currentLyricGroups */
+export function createReplacementPlayer(classes: PlayerClasses): DomLyricPlayer {
+	class ReplacementPlayer extends classes.DomLyricPlayer {
+		protected override buildLyricGroups(): void {
+			this.currentLyricGroups = buildGroups(
+				this,
+				classes,
+				this.processedLines,
+			);
+		}
+	}
+	return configurePlayer(new ReplacementPlayer());
+}
+
+/**  DOM  */
+export function createExtensionPlayer(classes: PlayerClasses): DomLyricPlayer {
+	class ExtensionPlayer extends classes.DomLyricPlayer {
+		protected override buildLyricGroups(): void {
+			super.buildLyricGroups();
+			const line = this.processedLines[this.processedLines.length - 1];
+			this.currentLyricGroups.push(
+				new classes.LyricLineGroup(
+					this,
+					new classes.LyricLineEl(this, line),
+				),
+			);
+		}
+	}
+	return configurePlayer(new ExtensionPlayer());
+}
+
+/** ， */
+export function mainWithBackgroundLines(): LyricLine[] {
+	return [
+		makeLine(0, 1000, { word: "main" }),
+		makeLine(100, 500, { word: "bg", isBG: true }),
+		makeLine(2000, 3000, { word: "next" }),
+	];
+}
+
+/**  */
+export function threeMainLines(): LyricLine[] {
+	return [
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(2000, 3000, { word: "C" }),
+	];
+}
+
+export function measureChangedGroupOrder(
+	classes: PlayerClasses,
+	change: "reorder" | "reappend" | "replace",
+): { currentHeight: number; previousHeight: number; unrelatedHeight: number } {
+	const player = createStandardPlayer(classes);
+	player.setLyricLines(threeMainLines());
+	attachPlayer(player);
+	const original = [...player.currentLyricGroups];
+	// Measure the group that started at index 0 after it moves to a later
+	// index. A layout write fixed at index 0 would otherwise satisfy reorder
+	// and replace, because those mutations used to park the measured group
+	// at index 0.
+	const measured = original[0];
+	if (change === "reorder") {
+		player.currentLyricGroups.reverse();
+	} else if (change === "reappend") {
+		player.currentLyricGroups = [original[1], original[2]];
+		player.currentLyricGroups.push(measured);
+	} else {
+		player.currentLyricGroups = [original[2], measured, original[1]];
+	}
+	triggerResize(player.resizeObserver, {
+		target: measured.getElement(),
+		width: 100,
+		height: 42,
+	});
+	const currentIndex = player.currentLyricGroups.indexOf(measured);
+	const previousIndex = original.indexOf(measured);
+	const unrelatedIndex = [0, 1, 2].find(
+		index => index !== currentIndex && index !== previousIndex,
+	)!;
+	return {
+		currentHeight: player.getLineHeight(currentIndex),
+		previousHeight: player.getLineHeight(previousIndex),
+		unrelatedHeight: player.getLineHeight(unrelatedIndex),
+	};
+}
