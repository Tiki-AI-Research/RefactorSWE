+
+function formatCaseName(template, args) {
+	let index = 0;
+	const formatted = String(template).replace(/%(?:([sdifjoO])|%)/g, (match, specifier) => {
+		if (specifier === undefined) return "%";
+		const value = args[index++];
+		if (specifier === "s") return String(value);
+		if (specifier === "d" || specifier === "f" || specifier === "i") return String(Number(value));
+		if (specifier === "j") return JSON.stringify(value);
+		return display(value);
+	});
+	if (formatted !== String(template)) return formatted;
+	return String(template).replace(/\$([A-Za-z0-9_.]+)/g, (match, path) => {
+		let current = args[0];
+		for (const segment of path.split(".")) current = current?.[segment];
+		return current === undefined ? match : String(current);
