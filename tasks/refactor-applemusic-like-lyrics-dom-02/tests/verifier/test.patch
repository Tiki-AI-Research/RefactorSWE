@@ -0,0 +1,49 @@
+import { afterAll, expect, it } from "vitest";
+import {
+	installFakeDomEnv,
+	uninstallFakeDomEnv,
+} from "../f2p-owner/fake-dom-env.ts";
+import {
+	createStandardPlayer,
+	loadPlayerClasses,
+	makeLine,
+	} from "../f2p-owner/f2p-fixtures.ts";
+
+installFakeDomEnv();
+
+afterAll(() => {
+	uninstallFakeDomEnv();
+});
+
+it("P2P: disposes and replaces the previous background line in the same group", async () => {
+	const classes = await loadPlayerClasses();
+	const player = createStandardPlayer(classes);
+	const main = new classes.LyricLineEl(
+		player,
+		makeLine(0, 1000, { word: "main" }),
+	);
+	const group = new classes.LyricLineGroup(player, main);
+	const firstBackground = new classes.LyricLineEl(
+		player,
+		makeLine(100, 500, { word: "first", isBG: true }),
+	);
+	let disposeCount = 0;
+	const originalDispose = firstBackground.dispose.bind(firstBackground);
+	firstBackground.dispose = () => {
+		disposeCount += 1;
+		originalDispose();
+	};
+
+	group.addBgLine(firstBackground);
+	const previousWrapper = group.bgWrapper;
+	const replacementBackground = new classes.LyricLineEl(
+		player,
+		makeLine(200, 600, { word: "replacement", isBG: true }),
+	);
+	group.addBgLine(replacementBackground);
+
+	expect(disposeCount).toBe(1);
+	expect(group.bgLine).toBe(replacementBackground);
+	expect(group.bgWrapper).not.toBe(previousWrapper);
+	expect(previousWrapper?.parentElement).toBe(null);
+});
