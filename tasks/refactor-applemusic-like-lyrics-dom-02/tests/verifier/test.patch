+
+function parseArguments(argv) {
+	const options = { report: null, root: REPO_ROOT, files: [], worker: false, summary: null };
+	for (let index = 0; index < argv.length; index += 1) {
+		const argument = argv[index];
+		if (argument === "--report") options.report = argv[++index];
+		else if (argument === "--root") options.root = argv[++index];
+		else if (argument === "--summary") options.summary = argv[++index];
+		else if (argument === "--worker") options.worker = true;
+		else if (argument.startsWith("--report=")) options.report = argument.slice("--report=".length);
+		else if (argument.startsWith("--root=")) options.root = argument.slice("--root=".length);
+		else if (argument.startsWith("--summary=")) options.summary = argument.slice("--summary=".length);
+		else options.files.push(argument);
+	}
+	options.files = [...new Set(options.files)];
+	return options;
+}
+
+function escapeXml(value) {
+	return String(value)
+		.replace(/&/g, "&amp;")
+		.replace(/</g, "&lt;")
+		.replace(/>/g, "&gt;")
+		.replace(/"/g, "&quot;")
+		.replace(/'/g, "&apos;")
+		.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f]/g, "");
+}
+
+function describeError(error) {
+	if (error instanceof Error) {
+		return {
+			name: error.name || "Error",
+			message: `${error.name}: ${error.message}`,
+			stack: typeof error.stack === "string" ? error.stack : `${error.name}: ${error.message}`,
+		};
+	}
+	return { name: "Error", message: display(error), stack: display(error) };
+}
+
+function resolveTestFile(file, root) {
+	if (isAbsolute(file)) return file;
+	for (const candidate of [resolve(process.cwd(), file), resolve(REPO_ROOT, file), resolve(root, file)]) {
+		if (existsSync(candidate)) return candidate;
+	}
+	return resolve(process.cwd(), file);
+}
+
+function absolutePath(value) {
+	return isAbsolute(value) ? value : resolve(process.cwd(), value);
+}
+
+function renderJUnit(suites, totalSeconds) {
+	const totalTests = suites.reduce((total, suite) => total + suite.tests.length, 0);
+	const totalFailures = suites.reduce((total, suite) => total + suite.failures, 0);
+	const totalErrors = suites.reduce((total, suite) => total + suite.errors, 0);
+	const lines = ['<?xml version="1.0" encoding="UTF-8" ?>'];
+	lines.push(
+		`<testsuites name="f2p-owner" tests="${totalTests}" failures="${totalFailures}" errors="${totalErrors}" time="${totalSeconds.toFixed(6)}">`,
+	);
+	for (const suite of suites) {
+		const suiteSeconds = suite.tests.reduce((total, test) => total + test.duration, 0);
+		lines.push(
+			`    <testsuite name="${escapeXml(suite.className)}" timestamp="${new Date().toISOString()}" hostname="localhost" tests="${suite.tests.length}" failures="${suite.failures}" errors="${suite.errors}" skipped="0" time="${suiteSeconds.toFixed(6)}">`,
+		);
+		for (const test of suite.tests) {
+			lines.push(
+				`        <testcase classname="${escapeXml(suite.className)}" name="${escapeXml(test.name)}" time="${test.duration.toFixed(6)}">`,
+			);
+			if (test.error) {
+				const tag = test.error.isAssertion ? "failure" : "error";
+				lines.push(
+					`            <${tag} message="${escapeXml(test.error.message)}" type="${escapeXml(test.error.name)}">${escapeXml(test.error.stack)}</${tag}>`,
+				);
+			}
+			lines.push("        </testcase>");
+		}
+		lines.push("    </testsuite>");
+	}
+	lines.push("</testsuites>");
+	return `${lines.join("\n")}\n`;
+}
+
+function writeReport(reportPath, contents) {
+	const resolved = absolutePath(reportPath);
+	mkdirSync(dirname(resolved), { recursive: true });
+	writeFileSync(resolved, contents, "utf8");
+	return resolved;
+}
+
+function logFailures(suites) {
+	for (const suite of suites) {
+		for (const test of suite.tests) {
+			if (test.error) {
+				console.error(
+					`[f2p-runner] ${test.error.isAssertion ? "FAIL" : "ERROR"} ${suite.className}::${test.name}\n${test.error.stack}`,
+				);
+			}
+		}
+	}
+}
+
+/** ， suite  */
+async function runSingleFile(absoluteFilePath, root) {
+	const className = relative(root, absoluteFilePath).split(sep).join("/") || absoluteFilePath;
+	const fileUrl = pathToFileURL(absoluteFilePath).href;
+	const suite = { className, tests: [], failures: 0, errors: 0 };
+
+	runState.currentFile = fileUrl;
+	runState.currentClassName = className;
+	runState.suiteStack.length = 0;
+	runState.tests.length = 0;
+	runState.hooksByFile.clear();
+
+	try {
+		await import(fileUrl);
+	} catch (error) {
+		const described = describeError(error);
+		suite.errors += 1;
+		suite.tests.push({ name: className, duration: 0, error: { ...described, isAssertion: false } });
+		return suite;
+	}
+
+	const scope = runState.hooksByFile.get(fileUrl) ?? {};
+	const fileTests = runState.tests.filter((test) => test.file === fileUrl);
+	try {
+		for (const hook of scope.beforeAll ?? []) await hook();
+		for (const test of fileTests) {
+			const testStarted = Date.now();
+			let error = null;
+			try {
+				for (const hook of scope.beforeEach ?? []) await hook();
+				await test.callback();
+			} catch (caught) {
+				error = caught;
+			}
+			try {
+				for (const hook of scope.afterEach ?? []) await hook();
+			} catch (caught) {
+				if (!error) error = caught;
+			}
+			const duration = (Date.now() - testStarted) / 1000;
+			if (error) {
+				const described = describeError(error);
+				const isAssertion = error instanceof AssertionError;
+				if (isAssertion) suite.failures += 1;
+				else suite.errors += 1;
+				suite.tests.push({ name: test.fullName, duration, error: { ...described, isAssertion } });
+			} else {
+				suite.tests.push({ name: test.fullName, duration, error: null });
+			}
+		}
+		for (const hook of scope.afterAll ?? []) await hook();
+	} catch (error) {
+		const described = describeError(error);
+		suite.errors += 1;
+		suite.tests.push({
+			name: `${className} (file hooks)`,
+			duration: 0,
+			error: { ...described, isAssertion: false },
+		});
+	}
+	return suite;
+}
+
+/** worker ：， JUnit  JSON  */
+async function runWorker(options, root) {
+	const absoluteFilePath = resolveTestFile(options.files[0], root);
