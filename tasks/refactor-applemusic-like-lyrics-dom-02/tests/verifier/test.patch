+#!/usr/bin/env node
+/**
+ *  P2P （， Node.js ）
+ *
+ *  node_modules（vitest/jsdom ），：
+ * 1.  `node:module`  `.css` 
+ *    （`@ungap/structured-clone``bezier-easing`） `vitest` ；
+ * 2.  `describe/it/expect`  API（ vitest ）；
+ * 3.  JUnit XML（`{report}`）
+ *
+ * （）：
+ *   node --disable-warning=ExperimentalWarning \
+ *     packages/core/test/p2p-owner/run-p2p.mjs --report <junit.xml> \
+ *     <test-file> [...]
+ *
+ * JUnit  classname （， `--root` ），
+ * ，， cwd
+ *
+ * ：`.ts`  TypeScript “”，
+ *  Node  `stripTypeScriptTypes(..., { mode: "transform" })` ，
+ * ， `--experimental-transform-types` 
+ */
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { registerHooks, stripTypeScriptTypes } from "node:module";
+import { dirname, isAbsolute, relative, resolve, sep } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+/**  <repo>/packages/core/test/p2p-owner/run-p2p.mjs， */
+const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..", "..", "..", "..");
+
+// ---------------------------------------------------------------------------
+//  API（vitest ）
+// ---------------------------------------------------------------------------
+
+const state = {
+	currentFile: null,
+	currentFileName: null,
+	stack: [],
+	tests: [],
+	fileScopes: new Map(),
+};
+
+if (typeof stripTypeScriptTypes !== "function") {
+	throw new Error(
+		"the dependency-free P2P runner requires Node.js with module.stripTypeScriptTypes (Node >= 22.13)",
+	);
+}
+
+function formatValue(value, seen = new Set(), depth = 0) {
+	if (value === null) return "null";
+	if (value === undefined) return "undefined";
+	if (typeof value === "string") return JSON.stringify(value);
+	if (typeof value === "number" || typeof value === "boolean" || typeof value === "bigint")
+		return String(value);
+	if (typeof value === "function") return `[Function ${value.name || "anonymous"}]`;
+	if (typeof value === "symbol") return value.toString();
+	if (value instanceof Date) return `Date(${value.toISOString()})`;
+	if (value instanceof RegExp) return value.toString();
+	if (value instanceof Error) return `${value.name}: ${value.message}`;
+	if (seen.has(value)) return "[Circular]";
+	seen.add(value);
+	if (depth > 4) return "[Object]";
+	if (Array.isArray(value)) {
+		return `[${value.map((item) => formatValue(item, seen, depth + 1)).join(", ")}]`;
+	}
+	if (value instanceof Map) {
+		return `Map(${formatValue([...value.entries()], seen, depth + 1)})`;
+	}
+	if (value instanceof Set) {
+		return `Set(${formatValue([...value.values()], seen, depth + 1)})`;
+	}
+	if (ArrayBuffer.isView(value)) {
+		return `${value.constructor.name}(${[...value].join(", ")})`;
+	}
+	const entries = Object.entries(value).map(
+		([key, item]) => `${key}: ${formatValue(item, seen, depth + 1)}`,
+	);
+	return `{ ${entries.join(", ")} }`;
+}
+
+function isPlainObjectLike(value) {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function enumerableKeys(value) {
+	return Object.keys(value).filter((key) => value[key] !== undefined);
+}
+
+function deepEqual(a, b, seen = new Map()) {
+	if (Object.is(a, b)) return true;
+	if (typeof a !== typeof b) return false;
+	if (typeof a !== "object" || a === null || b === null) return false;
+	const previous = seen.get(a);
+	if (previous && previous.has(b)) return true;
+	let bucket = seen.get(a);
+	if (!bucket) {
+		bucket = new Set();
+		seen.set(a, bucket);
+	}
+	bucket.add(b);
+
+	if (a instanceof Date || b instanceof Date) {
+		return a instanceof Date && b instanceof Date && a.getTime() === b.getTime();
+	}
+	if (a instanceof RegExp || b instanceof RegExp) {
+		return a instanceof RegExp && b instanceof RegExp && a.source === b.source && a.flags === b.flags;
+	}
+	if (ArrayBuffer.isView(a) || ArrayBuffer.isView(b)) {
+		if (!ArrayBuffer.isView(a) || !ArrayBuffer.isView(b)) return false;
+		if (a.constructor !== b.constructor || a.byteLength !== b.byteLength) return false;
+		return [...a].every((item, index) => deepEqual(item, b[index], seen));
+	}
+	if (Array.isArray(a) || Array.isArray(b)) {
+		if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+		return a.every((item, index) => deepEqual(item, b[index], seen));
+	}
+	if (a instanceof Set || b instanceof Set) {
+		if (!(a instanceof Set) || !(b instanceof Set) || a.size !== b.size) return false;
+		const remaining = [...b.values()];
+		for (const item of a.values()) {
+			const index = remaining.findIndex((candidate) => deepEqual(item, candidate, seen));
+			if (index === -1) return false;
+			remaining.splice(index, 1);
+		}
+		return true;
+	}
+	if (a instanceof Map || b instanceof Map) {
+		if (!(a instanceof Map) || !(b instanceof Map) || a.size !== b.size) return false;
+		const remaining = [...b.entries()];
+		for (const [key, value] of a.entries()) {
+			const index = remaining.findIndex(
+				([otherKey, otherValue]) =>
+					deepEqual(key, otherKey, seen) && deepEqual(value, otherValue, seen),
+			);
+			if (index === -1) return false;
+			remaining.splice(index, 1);
+		}
+		return true;
+	}
+	if (a instanceof Error || b instanceof Error) {
+		return a instanceof Error && b instanceof Error && a.name === b.name && a.message === b.message;
+	}
+	const aKeys = enumerableKeys(a);
+	const bKeys = enumerableKeys(b);
+	if (aKeys.length !== bKeys.length) return false;
+	return aKeys.every(
+		(key) => Object.hasOwn(b, key) && deepEqual(a[key], b[key], seen),
+	);
+}
+
+function matchObject(received, expected, seen = new Map()) {
+	if (Object.is(received, expected)) return true;
+	if (expected instanceof Date || expected instanceof RegExp) return deepEqual(received, expected, seen);
+	if (Array.isArray(expected)) {
+		if (!Array.isArray(received) || received.length < expected.length) return false;
+		return expected.every((item, index) => matchObject(received[index], item, seen));
+	}
+	if (isPlainObjectLike(expected)) {
+		if (!isPlainObjectLike(received)) return false;
+		return Object.keys(expected).every((key) => matchObject(received[key], expected[key], seen));
+	}
+	return deepEqual(received, expected, seen);
+}
+
+class AssertionError extends Error {
+	constructor(message) {
+		super(message);
+		this.name = "AssertionError";
+	}
+}
+
+function describeThrow(received, expected) {
+	if (typeof expected === "string") return `message containing ${JSON.stringify(expected)}`;
+	if (expected instanceof RegExp) return `message matching ${expected}`;
+	if (expected instanceof Error) return `${expected.name}(${JSON.stringify(expected.message)})`;
+	if (typeof expected === "function") return `an instance of ${expected.name || "the expected class"}`;
+	return "any thrown value";
+}
+
+function throwsMatching(error, expected) {
+	if (expected === undefined) return true;
+	if (typeof expected === "string") return String(error?.message ?? error).includes(expected);
+	if (expected instanceof RegExp) return expected.test(String(error?.message ?? error));
+	if (expected instanceof Error) {
+		return String(error?.message ?? error) === expected.message;
+	}
+	if (typeof expected === "function") return error instanceof expected;
+	return false;
+}
+
+function createExpect(received, negated = false) {
+	const check = (condition, message, negatedMessage) => {
+		if (negated ? condition : !condition) {
+			throw new AssertionError(negated ? negatedMessage : message);
+		}
+	};
+	const api = {
+		toBe(expected) {
+			check(
+				Object.is(received, expected),
+				`expected ${formatValue(received)} to be ${formatValue(expected)}`,
+				`expected ${formatValue(received)} not to be ${formatValue(expected)}`,
+			);
+		},
+		toStrictEqual(expected) {
+			check(
+				deepEqual(received, expected),
+				`expected ${formatValue(received)} to strictly equal ${formatValue(expected)}`,
+				`expected ${formatValue(received)} not to strictly equal ${formatValue(expected)}`,
+			);
+		},
+		toEqual(expected) {
+			check(
+				deepEqual(received, expected),
+				`expected ${formatValue(received)} to equal ${formatValue(expected)}`,
+				`expected ${formatValue(received)} not to equal ${formatValue(expected)}`,
+			);
+		},
+		toMatchObject(expected) {
+			check(
+				matchObject(received, expected),
+				`expected ${formatValue(received)} to match object ${formatValue(expected)}`,
+				`expected ${formatValue(received)} not to match object ${formatValue(expected)}`,
+			);
+		},
+		toBeDefined() {
+			check(
+				received !== undefined,
+				"expected value to be defined",
+				"expected value not to be defined",
+			);
+		},
+		toBeUndefined() {
+			check(
+				received === undefined,
+				`expected ${formatValue(received)} to be undefined`,
+				"expected value not to be undefined",
+			);
+		},
+		toBeNull() {
+			check(received === null, `expected ${formatValue(received)} to be null`, "expected value not to be null");
+		},
+		toBeNaN() {
+			check(Number.isNaN(received), `expected ${formatValue(received)} to be NaN`, "expected value not to be NaN");
+		},
+		toBeTruthy() {
+			check(Boolean(received), `expected ${formatValue(received)} to be truthy`, `expected ${formatValue(received)} to be falsy`);
+		},
+		toBeFalsy() {
+			check(!received, `expected ${formatValue(received)} to be falsy`, `expected ${formatValue(received)} to be truthy`);
+		},
+		toBeInstanceOf(expected) {
+			check(
+				received instanceof expected,
+				`expected ${formatValue(received)} to be an instance of ${expected?.name}`,
+				`expected value not to be an instance of ${expected?.name}`,
+			);
+		},
+		toHaveLength(expected) {
+			check(
+				received?.length === expected,
+				`expected length ${received?.length} to be ${expected}`,
+				`expected length ${received?.length} not to be ${expected}`,
+			);
+		},
+		toContain(expected) {
+			const found = typeof received === "string" ? received.includes(expected) : Array.from(received ?? []).includes(expected);
+			check(found, `expected ${formatValue(received)} to contain ${formatValue(expected)}`, `expected ${formatValue(received)} not to contain ${formatValue(expected)}`);
+		},
+		toContainEqual(expected) {
+			const found = Array.from(received ?? []).some((item) => deepEqual(item, expected));
+			check(found, `expected ${formatValue(received)} to contain equal ${formatValue(expected)}`, `expected ${formatValue(received)} not to contain equal ${formatValue(expected)}`);
+		},
+		toMatch(expected) {
+			const found = expected instanceof RegExp ? expected.test(received) : String(received).includes(String(expected));
+			check(found, `expected ${formatValue(received)} to match ${formatValue(expected)}`, `expected ${formatValue(received)} not to match ${formatValue(expected)}`);
+		},
+		toBeLessThan(expected) {
+			check(received < expected, `expected ${formatValue(received)} to be less than ${formatValue(expected)}`, `expected ${formatValue(received)} not to be less than ${formatValue(expected)}`);
+		},
+		toBeGreaterThan(expected) {
+			check(received > expected, `expected ${formatValue(received)} to be greater than ${formatValue(expected)}`, `expected ${formatValue(received)} not to be greater than ${formatValue(expected)}`);
+		},
+		toBeLessThanOrEqual(expected) {
+			check(received <= expected, `expected ${formatValue(received)} to be <= ${formatValue(expected)}`, `expected ${formatValue(received)} not to be <= ${formatValue(expected)}`);
+		},
+		toBeGreaterThanOrEqual(expected) {
+			check(received >= expected, `expected ${formatValue(received)} to be >= ${formatValue(expected)}`, `expected ${formatValue(received)} not to be >= ${formatValue(expected)}`);
+		},
+		toBeCloseTo(expected, precision = 2) {
+			const threshold = 10 ** -precision / 2;
+			check(Math.abs(received - expected) < threshold, `expected ${received} to be close to ${expected}`, `expected ${received} not to be close to ${expected}`);
+		},
+		toHaveProperty(path, expected) {
+			const segments = Array.isArray(path) ? path : String(path).split(".");
+			let current = received;
+			let exists = true;
+			for (const segment of segments) {
+				if (current === null || current === undefined || !Object.hasOwn(Object(current), segment)) {
+					exists = false;
+					break;
+				}
+				current = current[segment];
+			}
+			const matched = arguments.length > 1 ? exists && deepEqual(current, expected) : exists;
+			check(matched, `expected ${formatValue(received)} to have property ${String(path)}`, `expected ${formatValue(received)} not to have property ${String(path)}`);
+		},
+		toThrow(expected) {
+			if (typeof received !== "function") {
+				throw new AssertionError("toThrow expects a function");
+			}
+			let thrown;
+			let didThrow = false;
+			try {
+				received();
+			} catch (error) {
+				didThrow = true;
+				thrown = error;
+			}
+			const matched = didThrow && throwsMatching(thrown, expected);
+			check(
+				matched,
+				didThrow
+					? `expected function to throw ${describeThrow(received, expected)}, but it threw ${formatValue(thrown)}`
+					: `expected function to throw ${describeThrow(received, expected)}, but it did not throw`,
+				`expected function not to throw ${describeThrow(received, expected)}`,
+			);
+		},
+	};
+
+	Object.defineProperty(api, "not", {
+		get: () => createExpect(received, !negated),
+		enumerable: true,
+	});
+	return api;
+}
+
+function expect(received) {
+	return createExpect(received);
+}
+
+function defineTestApi() {
+	const registerHook = (kind, callback) => {
+		const scope = state.fileScopes.get(state.currentFile) ?? { beforeAll: [], afterAll: [], beforeEach: [], afterEach: [] };
+		state.fileScopes.set(state.currentFile, scope);
+		scope[kind].push(callback);
+	};
+	const api = {
+		describe(name, callback) {
+			state.stack.push(name);
+			try {
+				callback();
+			} finally {
+				state.stack.pop();
+			}
+		},
+		it(name, callback) {
+			state.tests.push({
+				file: state.currentFile,
+				fileName: state.currentFileName,
+				fullName: [...state.stack, name].join(" > "),
+				callback,
+			});
+		},
+		test(name, callback) {
+			api.it(name, callback);
+		},
+		beforeAll: (callback) => registerHook("beforeAll", callback),
+		afterAll: (callback) => registerHook("afterAll", callback),
+		beforeEach: (callback) => registerHook("beforeEach", callback),
+		afterEach: (callback) => registerHook("afterEach", callback),
+		expect,
+		AssertionError,
+	};
+	const formatCaseName = (template, args) => {
+		let index = 0;
+		const formatted = String(template).replace(
+			/%(?:([sdifjoO])|%)/g,
+			(match, specifier) => {
+				if (specifier === undefined) return "%";
+				const value = args[index++];
+				if (specifier === "s") return String(value);
+				if (specifier === "d" || specifier === "f") return String(Number(value));
+				if (specifier === "i") return String(Number.parseInt(value, 10));
+				if (specifier === "j") return JSON.stringify(value);
+				return formatValue(value);
+			},
+		);
+		if (formatted === String(template)) {
+			return String(template).replace(/\$([A-Za-z0-9_.]+)/g, (match, path) => {
+				let current = args[0];
+				for (const segment of path.split(".")) current = current?.[segment];
+				return current === undefined ? match : String(current);
+			});
+		}
+		return formatted;
+	};
+	const makeEach = (cases) => (template, callback) => {
+		const rows = Array.isArray(cases) ? cases : [];
+		rows.forEach((row) => {
+			const args = Array.isArray(row) ? row : [row];
+			api.it(formatCaseName(template, args), () => callback(...args));
+		});
+	};
+	api.it.skip = () => {};
+	api.it.only = api.it;
+	api.it.each = makeEach;
+	api.test.each = makeEach;
+	api.describe.skip = () => {};
+	api.describe.only = api.describe;
+	api.describe.each = (cases) => (name, callback) => {
+		const rows = Array.isArray(cases) ? cases : [];
+		rows.forEach((row) => {
+			const args = Array.isArray(row) ? row : [row];
+			api.describe(formatCaseName(name, args), () => callback(...args));
+		});
+	};
+	return api;
+}
+
+const vitestApi = defineTestApi();
+globalThis.__P2P_VITEST__ = vitestApi;
+globalThis.__P2P_IMPORT_META_ENV__ = { DEV: false, PROD: true, MODE: "test" };
+
+// ---------------------------------------------------------------------------
+// ：CSS vitest 
+// ---------------------------------------------------------------------------
+
+const CSS_STUB_SOURCE =
+	"const handler = { get: (target, key) => (typeof key === \"string\" ? key : undefined) };\n" +
+	"export default new Proxy({}, handler);\n";
+
+const STRUCTURED_CLONE_SHIM_URL = `data:text/javascript,${encodeURIComponent(
+	"export default globalThis.structuredClone;",
+)}`;
+
+// bezier-easing （， P2P ）
+const BEZIER_SHIM_SOURCE = `
+function A(a1, a2) { return 1 - 3 * a2 + 3 * a1; }
+function B(a1, a2) { return 3 * a2 - 6 * a1; }
+function C(a1) { return 3 * a1; }
+function calcBezier(t, a1, a2) { return ((A(a1, a2) * t + B(a1, a2)) * t + C(a1)) * t; }
+function getSlope(t, a1, a2) { return 3 * A(a1, a2) * t * t + 2 * B(a1, a2) * t + C(a1); }
+export default function bezier(x1, y1, x2, y2) {
+	if (x1 === y1 && x2 === y2) return (t) => t;
+	return (t) => {
+		if (t <= 0) return 0;
+		if (t >= 1) return 1;
+		let guess = t;
+		for (let i = 0; i < 8; i += 1) {
+			const slope = getSlope(guess, x1, x2);
+			if (slope === 0) break;
+			const current = calcBezier(guess, x1, x2) - t;
+			guess -= current / slope;
+		}
+		return calcBezier(guess, y1, y2);
+	};
+}
+`;
+const BEZIER_SHIM_URL = `data:text/javascript,${encodeURIComponent(BEZIER_SHIM_SOURCE)}`;
+
+const VITEST_SHIM_URL = `data:text/javascript,${encodeURIComponent(
+	[
+		"const api = globalThis.__P2P_VITEST__;",
+		"export const describe = api.describe;",
+		"export const it = api.it;",
+		"export const test = api.test;",
+		"export const expect = api.expect;",
+		"export const beforeAll = api.beforeAll;",
+		"export const afterAll = api.afterAll;",
+		"export const beforeEach = api.beforeEach;",
+		"export const afterEach = api.afterEach;",
+		"export const AssertionError = api.AssertionError;",
+		"export const vi = { stubGlobal() { throw new Error('vi.stubGlobal is unavailable in the dependency-free runner'); } };",
+		"export default { describe, it, test, expect, beforeAll, afterAll, beforeEach, afterEach };",
+	].join("\n"),
+)}`;
+
+const BARE_SPECIFIER_SHIMS = new Map([
+	["@ungap/structured-clone", STRUCTURED_CLONE_SHIM_URL],
+	["bezier-easing", BEZIER_SHIM_URL],
+	["vitest", VITEST_SHIM_URL],
+]);
+
+const EXTENSION_CANDIDATES = [".ts", ".tsx", ".mts", ".js", ".mjs", ".cjs"];
+
+function resolveExtensionlessRelative(specifier, parentURL) {
+	if (!specifier.startsWith("./") && !specifier.startsWith("../")) return null;
+	if (/\.[a-zA-Z0-9]+$/.test(specifier)) return null;
+	if (!parentURL) return null;
+	for (const candidate of EXTENSION_CANDIDATES) {
+		const url = new URL(specifier + candidate, parentURL);
+		if (existsSync(fileURLToPath(url))) return url.href;
+	}
+	for (const candidate of EXTENSION_CANDIDATES) {
+		const url = new URL(`${specifier}/index${candidate}`, parentURL);
+		if (existsSync(fileURLToPath(url))) return url.href;
+	}
+	return null;
+}
+
+registerHooks({
+	resolve(specifier, context, nextResolve) {
+		const shim = BARE_SPECIFIER_SHIMS.get(specifier);
+		if (shim) return { url: shim, format: "module", shortCircuit: true };
+		const relative = resolveExtensionlessRelative(specifier, context.parentURL);
+		if (relative) return { url: relative, shortCircuit: true };
+		return nextResolve(specifier, context);
+	},
+	load(url, context, nextLoad) {
+		if (url.startsWith("data:")) return nextLoad(url, context);
+		if (url.endsWith(".css")) {
+			return { format: "module", source: CSS_STUB_SOURCE, shortCircuit: true };
+		}
+		if (/\.(ts|tsx|mts)$/.test(url)) {
+			//  Node  TypeScript （），
+			//  Vite  import.meta.env 
+			const original = readFileSync(fileURLToPath(url), "utf8");
+			const rewritten = original.replaceAll(
+				"import.meta.env",
+				"globalThis.__P2P_IMPORT_META_ENV__",
+			);
+			const source = stripTypeScriptTypes(rewritten, {
+				mode: "transform",
+				sourceUrl: url,
+			});
+			return { format: "module", source, shortCircuit: true };
+		}
+		return nextLoad(url, context);
+	},
+});
+
+// ---------------------------------------------------------------------------
+//  JUnit 
+// ---------------------------------------------------------------------------
+
+function parseArguments(argv) {
+	const options = { report: null, root: REPO_ROOT, files: [] };
+	for (let index = 0; index < argv.length; index += 1) {
+		const argument = argv[index];
+		if (argument === "--report") {
+			options.report = argv[++index];
+		} else if (argument === "--root") {
+			options.root = argv[++index];
+		} else if (argument.startsWith("--report=")) {
+			options.report = argument.slice("--report=".length);
+		} else if (argument.startsWith("--root=")) {
+			options.root = argument.slice("--root=".length);
+		} else {
+			options.files.push(argument);
+		}
+	}
+	return options;
+}
+
+function escapeXml(value) {
+	return String(value)
+		.replace(/&/g, "&amp;")
+		.replace(/</g, "&lt;")
+		.replace(/>/g, "&gt;")
+		.replace(/"/g, "&quot;")
+		.replace(/'/g, "&apos;")
+		.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f]/g, "");
+}
+
+function toClassName(root, absolutePath) {
+	const relativePath = relative(root, absolutePath) || absolutePath;
+	return relativePath.split(sep).join("/");
+}
+
+function summarizeError(error) {
+	if (error instanceof Error) {
+		const stack = typeof error.stack === "string" ? error.stack : `${error.name}: ${error.message}`;
+		return { message: `${error.name}: ${error.message}`, stack };
+	}
+	return { message: formatValue(error), stack: formatValue(error) };
+}
+
+async function run() {
+	const options = parseArguments(process.argv.slice(2));
+	if (!options.report) {
+		throw new Error("missing --report <path>");
+	}
+	if (options.files.length === 0) {
+		throw new Error("missing test file arguments");
+	}
+	const root = resolve(options.root);
+	const resolveTestFile = (file) => {
+		if (isAbsolute(file)) return file;
+		const candidates = [
+			resolve(process.cwd(), file),
+			resolve(REPO_ROOT, file),
+			resolve(root, file),
+		];
+		for (const candidate of candidates) {
+			if (existsSync(candidate)) return candidate;
+		}
+		return candidates[0];
+	};
+
+	const suites = [];
+	let totalTests = 0;
+	let totalFailures = 0;
+	const startedAll = Date.now();
+
+	for (const file of options.files) {
+		const absolutePath = resolveTestFile(file);
+		const className = toClassName(root, absolutePath);
+		const fileUrl = pathToFileURL(absolutePath).href;
+		const suite = { className, absolutePath, tests: [], failures: 0 };
+		suites.push(suite);
+
+		state.currentFile = fileUrl;
+		state.currentFileName = className;
+		state.stack.length = 0;
+		state.tests.length = 0;
+		state.fileScopes.clear();
+		state.fileScopes.set(fileUrl, { beforeAll: [], afterAll: [], beforeEach: [], afterEach: [] });
+
+		try {
+			await import(fileUrl);
+		} catch (error) {
+			const summary = summarizeError(error);
+			suite.failures += 1;
+			totalFailures += 1;
+			totalTests += 1;
+			suite.tests.push({ name: className, duration: 0, error: summary });
+			continue;
+		}
+
+		const scope = state.fileScopes.get(fileUrl) ?? {};
+		const fileTests = state.tests.filter((test) => test.file === fileUrl);
+		try {
+			for (const hook of scope.beforeAll ?? []) await hook();
+			for (const test of fileTests) {
+				const testStarted = Date.now();
+				let error = null;
+				try {
+					for (const hook of scope.beforeEach ?? []) await hook();
+					await test.callback();
+				} catch (caught) {
+					error = summarizeError(caught);
+				}
+				try {
+					for (const hook of scope.afterEach ?? []) await hook();
+				} catch (caught) {
+					if (!error) error = summarizeError(caught);
+				}
+				const duration = (Date.now() - testStarted) / 1000;
+				suite.tests.push({ name: test.fullName, duration, error });
+				totalTests += 1;
+				if (error) {
+					suite.failures += 1;
+					totalFailures += 1;
+				}
+			}
+			for (const hook of scope.afterAll ?? []) await hook();
+		} catch (error) {
+			const summary = summarizeError(error);
+			suite.failures += 1;
+			totalFailures += 1;
+			totalTests += 1;
+			suite.tests.push({ name: `${className} (file hooks)`, duration: 0, error: summary });
+		}
+	}
+
+	const totalSeconds = (Date.now() - startedAll) / 1000;
+	const lines = ['<?xml version="1.0" encoding="UTF-8" ?>'];
+	lines.push(
+		`<testsuites name="p2p-owner" tests="${totalTests}" failures="${totalFailures}" errors="0" time="${totalSeconds.toFixed(6)}">`,
+	);
+	for (const suite of suites) {
+		const suiteSeconds = suite.tests.reduce((total, test) => total + test.duration, 0);
+		lines.push(
+			`    <testsuite name="${escapeXml(suite.className)}" timestamp="${new Date().toISOString()}" hostname="localhost" tests="${suite.tests.length}" failures="${suite.failures}" errors="0" skipped="0" time="${suiteSeconds.toFixed(6)}">`,
+		);
+		for (const test of suite.tests) {
+			lines.push(
+				`        <testcase classname="${escapeXml(suite.className)}" name="${escapeXml(test.name)}" time="${test.duration.toFixed(6)}">`,
+			);
+			if (test.error) {
+				lines.push(
+					`            <failure message="${escapeXml(test.error.message)}" type="AssertionError">${escapeXml(test.error.stack)}</failure>`,
+				);
+			}
+			lines.push("        </testcase>");
+		}
+		lines.push("    </testsuite>");
+	}
+	lines.push("</testsuites>");
+
+	const reportPath = isAbsolute(options.report) ? options.report : resolve(process.cwd(), options.report);
+	mkdirSync(dirname(reportPath), { recursive: true });
+	writeFileSync(reportPath, `${lines.join("\n")}\n`, "utf8");
+
+	console.log(
+		`[p2p-runner] files=${suites.length} tests=${totalTests} failures=${totalFailures} report=${reportPath}`,
+	);
+	for (const suite of suites) {
+		for (const test of suite.tests) {
+			if (test.error) console.error(`[p2p-runner] FAIL ${suite.className}::${test.name}\n${test.error.stack}`);
+		}
+	}
+
+	// ：，
+	if (totalFailures > 0) {
+		process.exitCode = 1;
+	}
+}
+
+await run();
