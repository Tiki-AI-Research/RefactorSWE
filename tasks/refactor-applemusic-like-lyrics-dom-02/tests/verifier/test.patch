--- /dev/null
+++ b/packages/core/test/f2p-owner/fake-dom-env.ts
@@ -0,0 +1,530 @@
+/**
+ * Minimal in-process DOM double for the F2P owner tests.
+ * Implements only the browser surface the DOM lyric player touches.
+ */
+
+type AnyListener = ((event: any) => void) | { handleEvent(event: any): void };
+
+interface ListenerRecord {
+	listener: AnyListener;
+	removed: boolean;
+}
+
+class EventTargetDouble {
+	protected listeners = new Map<string, ListenerRecord[]>();
+
+	addEventListener(
+		type: string,
+		listener: AnyListener | null,
+		options?: AddEventListenerOptions | boolean,
+	): void {
+		if (!listener) return;
+		const records = this.listeners.get(type) ?? [];
+		records.push({ listener, removed: false });
+		this.listeners.set(type, records);
+		const signal =
+			typeof options === "object" && options !== null
+				? options.signal
+				: undefined;
+		if (signal) {
+			const remove = () => this.removeEventListener(type, listener);
+			if (signal.aborted) remove();
+			else signal.addEventListener("abort", remove, { once: true });
+		}
+	}
+
+	removeEventListener(type: string, listener: AnyListener | null): void {
+		if (!listener) return;
+		for (const record of this.listeners.get(type) ?? []) {
+			if (record.listener === listener) record.removed = true;
+		}
+	}
+
+	hasListener(type: string, listener: AnyListener): boolean {
+		return (this.listeners.get(type) ?? []).some(
+			(record) => !record.removed && record.listener === listener,
+		);
+	}
+
+	listenerCount(type: string): number {
+		return (this.listeners.get(type) ?? []).filter((r) => !r.removed).length;
+	}
+
+	dispatchEvent(event: any): boolean {
+		if (!Object.getOwnPropertyDescriptor(event, "target")) {
+			Object.defineProperty(event, "target", { value: this, configurable: true });
+		}
+		const path: EventTargetDouble[] = [];
+		let current: any = this;
+		while (current) {
+			path.push(current);
+			current = current.parentElement ?? null;
+		}
+		for (const node of path) {
+			for (const record of [...(node.listeners.get(event.type) ?? [])]) {
+				if (record.removed) continue;
+				if (typeof record.listener === "function") record.listener.call(node, event);
+				else record.listener.handleEvent(event);
+				if (event.immediatePropagationStopped) break;
+			}
+			if (event.cancelBubble || event.immediatePropagationStopped) break;
+		}
+		return !event.defaultPrevented;
+	}
+}
