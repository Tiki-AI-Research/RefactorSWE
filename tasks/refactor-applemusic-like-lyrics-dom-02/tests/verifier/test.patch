+	constructor(type: string, init: { bubbles?: boolean; cancelable?: boolean } = {}) {
+		super(type, { bubbles: init.bubbles ?? true, cancelable: init.cancelable ?? true });
+	}
+
+	override stopPropagation(): void {
+		this.propagationStopped = true;
+		super.stopPropagation();
+	}
+
+	override stopImmediatePropagation(): void {
+		this.immediatePropagationStopped = true;
+		super.stopImmediatePropagation();
+	}
+}
+
+export class FakeNode extends EventTargetDouble {
+	static readonly DOCUMENT_POSITION_DISCONNECTED = 1;
+	static readonly DOCUMENT_POSITION_PRECEDING = 2;
+	static readonly DOCUMENT_POSITION_FOLLOWING = 4;
+	static readonly DOCUMENT_POSITION_CONTAINS = 8;
+	static readonly DOCUMENT_POSITION_CONTAINED_BY = 16;
+	static readonly DOCUMENT_POSITION_IMPLEMENTATION_SPECIFIC = 32;
+	readonly DOCUMENT_POSITION_DISCONNECTED = 1;
+	readonly DOCUMENT_POSITION_PRECEDING = 2;
+	readonly DOCUMENT_POSITION_FOLLOWING = 4;
+	readonly DOCUMENT_POSITION_CONTAINS = 8;
+	readonly DOCUMENT_POSITION_CONTAINED_BY = 16;
+	readonly DOCUMENT_POSITION_IMPLEMENTATION_SPECIFIC = 32;
+	private static nextIdentity = 0;
+	private readonly nodeIdentity = FakeNode.nextIdentity++;
+
+	get previousSibling(): FakeNode | null {
+		if (!this.parentNode) return null;
+		return this.parentNode.childNodes[this.parentNode.childNodes.indexOf(this) - 1] ?? null;
+	}
+
+	get nextSibling(): FakeNode | null {
+		if (!this.parentNode) return null;
+		return this.parentNode.childNodes[this.parentNode.childNodes.indexOf(this) + 1] ?? null;
+	}
+
+	compareDocumentPosition(other: FakeNode): number {
+		if (!(other instanceof FakeNode)) throw new TypeError("Expected a Node");
+		if (this === other) return 0;
+		const ancestors = (node: FakeNode) => {
+			const chain: FakeNode[] = [];
+			for (let current: FakeNode | null = node; current; current = current.parentNode) chain.unshift(current);
+			return chain;
+		};
+		const a = ancestors(this), b = ancestors(other);
+		if (a[0] !== b[0]) return 1 | 32 | (a[0].nodeIdentity < b[0].nodeIdentity ? 4 : 2);
+		if (b.includes(this)) return 4 | 16;
+		if (a.includes(other)) return 2 | 8;
+		let index = 0;
+		while (a[index] === b[index]) index++;
+		const siblings = a[index - 1].childNodes;
+		return siblings.indexOf(a[index]) < siblings.indexOf(b[index]) ? 4 : 2;
+	}
+
+	nodeType = 1;
+	childNodes: FakeNode[] = [];
+	parentNode: FakeNode | null = null;
+	private ownText = "";
+
+	get parentElement(): FakeElement | null {
+		return this.parentNode instanceof FakeElement ? this.parentNode : null;
+	}
+
+	get textContent(): string {
+		if (this.childNodes.length === 0) return this.ownText;
+		return this.childNodes.map((child) => child.textContent).join("");
+	}
+
+	set textContent(value: string) {
+		this.childNodes = [];
+		this.ownText = String(value);
+	}
+
+	appendChild<T extends FakeNode>(child: T): T {
+		child.remove();
+		child.parentNode = this;
+		this.childNodes.push(child);
+		return child;
+	}
+
+	removeChild<T extends FakeNode>(child: T): T {
+		const index = this.childNodes.indexOf(child);
+		if (index !== -1) this.childNodes.splice(index, 1);
+		child.parentNode = null;
+		return child;
+	}
+
+	remove(): void {
+		this.parentNode?.removeChild(this);
+	}
+}
+
+export class FakeTextNode extends FakeNode {
+	constructor(text: string) {
+		super();
+		this.nodeType = 3;
+		this.textContent = text;
+	}
+}
+
+function createStyle(): any {
+	const props = new Map<string, string>();
+	const target = {
+		setProperty(name: string, value: string) {
+			props.set(name, String(value));
+		},
+		removeProperty(name: string) {
+			props.delete(name);
+		},
+		getPropertyValue(name: string) {
+			return props.get(name) ?? "";
+		},
+	};
+	return new Proxy(target, {
+		get(obj, prop) {
+			if (prop in obj) return (obj as any)[prop];
+			return props.get(String(prop)) ?? "";
+		},
+		set(_obj, prop, value) {
+			props.set(String(prop), String(value));
+			return true;
+		},
+	});
+}
+
+export class FakeAnimation {
+	id = "";
+	playbackRate = 1;
+	currentTime: number | null = 0;
+	playState = "idle";
+	effect = { getComputedTiming: () => ({ delay: 0, duration: 0 }) };
+	play(): void {
+		this.playState = "running";
+	}
+	pause(): void {
+		this.playState = "paused";
+	}
+	cancel(): void {
+		this.playState = "idle";
+	}
+	finish(): void {
+		this.playState = "finished";
+	}
+	addEventListener(): void {}
+	removeEventListener(): void {}
+}
+
+export class FakeElement extends FakeNode {
+	get nextElementSibling(): FakeElement | null {
+        let node = this.nextSibling;
+        while (node && node.nodeType !== 1) node = node.nextSibling;
+        return node as FakeElement | null;
+    }
+
+	readonly classList: {
+		add(...names: string[]): void;
+		remove(...names: string[]): void;
+		toggle(name: string, force?: boolean): boolean;
+		contains(name: string): boolean;
+		toString(): string;
+	};
+	readonly style = createStyle();
+	readonly dataset: Record<string, string> = {};
+	clientWidth = 0;
+	clientHeight = 0;
+	offsetWidth = 0;
+	offsetHeight = 0;
+
+	private classes = new Set<string>();
+	private attributes = new Map<string, string>();
+
+	constructor(public readonly tagName: string) {
+		super();
+		const classes = this.classes;
+		this.classList = {
+			add: (...names: string[]) => {
+				for (const name of names) if (name) classes.add(name);
+			},
+			remove: (...names: string[]) => {
+				for (const name of names) classes.delete(name);
+			},
+			toggle: (name: string, force?: boolean) => {
+				const should = force ?? !classes.has(name);
+				if (should) classes.add(name);
+				else classes.delete(name);
+				return should;
+			},
+			contains: (name: string) => classes.has(name),
+			toString: () => [...classes].join(" "),
+		};
+	}
+
+	get children(): FakeElement[] {
+		return this.childNodes.filter((child): child is FakeElement => child instanceof FakeElement);
+	}
+
+	get firstChild(): FakeNode | null {
+		return this.childNodes[0] ?? null;
+	}
+
+	get className(): string {
+		return [...this.classes].join(" ");
+	}
+
+	set className(value: string) {
+		this.classes.clear();
+		for (const name of String(value).split(/\s+/)) if (name) this.classes.add(name);
+	}
+
+	get innerHTML(): string {
+		return this.textContent;
+	}
+
+	set innerHTML(value: string) {
+		this.childNodes = [];
+		this.textContent = String(value);
+	}
+
+	setAttribute(name: string, value: string): void {
+		this.attributes.set(name, String(value));
+		if (name === "class") this.className = String(value);
+	}
+
+	getAttribute(name: string): string | null {
+		return this.attributes.get(name) ?? null;
+	}
+
+	hasAttribute(name: string): boolean {
+		return this.attributes.has(name) || (name === "class" && this.classes.size > 0);
+	}
+
+	insertBefore<T extends FakeNode>(child: T, reference: FakeNode | null): T {
+		if (child === reference) return child;
+		if (!reference) return this.appendChild(child);
+		child.remove();
+		child.parentNode = this;
+		const index = this.childNodes.indexOf(reference);
+		if (index === -1) this.childNodes.push(child);
+		else this.childNodes.splice(index, 0, child);
+		return child;
+	}
+
+	matches(selector: string): boolean {
+		if (selector.startsWith(".")) return this.classList.contains(selector.slice(1));
+		return this.tagName.toLowerCase() === selector.toLowerCase();
+	}
+
+	closest(selector: string): FakeElement | null {
+		let current: FakeElement | null = this;
+		while (current) {
+			if (current.matches(selector)) return current;
+			current = current.parentElement;
+		}
+		return null;
+	}
+
+	querySelectorAll(selector: string): FakeElement[] {
+		const found: FakeElement[] = [];
+		const visit = (element: FakeElement) => {
+			for (const child of element.children) {
+				if (child.matches(selector)) found.push(child);
+				visit(child);
+			}
+		};
+		visit(this);
+		return found;
+	}
+
+	querySelector(selector: string): FakeElement | null {
+		return this.querySelectorAll(selector)[0] ?? null;
+	}
+
+	getBoundingClientRect(): DOMRect {
+		return {
+			x: 0,
+			y: 0,
+			top: 0,
+			left: 0,
+			right: 0,
+			bottom: 0,
+			width: 0,
+			height: 0,
+			toJSON: () => ({}),
+		} as DOMRect;
+	}
+
+	getContext(): null {
+		return null;
+	}
+
+	animate(): FakeAnimation {
+		return new FakeAnimation();
+	}
+}
+
+export class FakeResizeObserver {
+	static instances: FakeResizeObserver[] = [];
+	readonly observed = new Set<Element>();
+	readonly unobserved: Element[] = [];
+
+	constructor(public readonly callback: ResizeObserverCallback) {
+		FakeResizeObserver.instances.push(this);
+	}
+
+	observe(target: Element): void {
+		this.observed.add(target);
+	}
+
+	unobserve(target: Element): void {
+		this.observed.delete(target);
+		this.unobserved.push(target);
+	}
+
+	disconnect(): void {
+		this.observed.clear();
+	}
+
+	trigger(entries: unknown[]): void {
+		this.callback(entries as ResizeObserverEntry[], this as unknown as ResizeObserver);
+	}
+}
+
+export class FakeMutationObserver {
+	readonly observed: Element[] = [];
+	constructor(public readonly callback: MutationCallback) {}
+	observe(target: Element): void {
+		this.observed.push(target);
+	}
+	disconnect(): void {
+		this.observed.length = 0;
+	}
+}
+
+const fakeDocument = {
+	createElement(tag: string) {
+		return new FakeElement(tag);
+	},
+	createTextNode(text: string) {
+		return new FakeTextNode(text);
+	},
+	createRange() {
+		return {
+			selectNodeContents: () => {},
+			setStart: () => {},
+			setEnd: () => {},
+			getBoundingClientRect: () => ({ width: 0, height: 0, left: 0, top: 0 }),
+		};
+	},
+};
+
+export const fakeWindow = {
+	innerHeight: 800,
+	innerWidth: 1280,
+	addEventListener: () => {},
+	removeEventListener: () => {},
+	setTimeout: (handler: () => void, timeout?: number) =>
+		setTimeout(handler, timeout) as unknown as number,
+	clearTimeout: (id: number) => clearTimeout(id as unknown as NodeJS.Timeout),
+};
+
+const computedStyle = new Proxy(
+	{
+		fontSize: "16px",
+		paddingLeft: "0px",
+		paddingRight: "0px",
+		paddingTop: "0px",
+		paddingBottom: "0px",
+	},
+	{
+		get(obj, prop) {
+			if (prop in obj) return (obj as any)[prop];
+			return "";
+		},
+	},
+);
+
+const saved = new Map<PropertyKey, PropertyDescriptor | undefined>();
+
+function stub(name: string, value: unknown): void {
+	if (!saved.has(name)) saved.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+	Object.defineProperty(globalThis, name, {
+		value,
+		writable: true,
+		configurable: true,
+		enumerable: true,
+	});
+}
+
+export function installFakeDomEnv(): void {
+	FakeResizeObserver.instances = [];
+	stub("Node", FakeNode);
+	stub("Element", FakeElement);
+	stub("HTMLElement", FakeElement);
+	stub("MouseEvent", FakeMouseEvent);
+	stub("ResizeObserver", FakeResizeObserver);
+	stub("MutationObserver", FakeMutationObserver);
+	stub("document", fakeDocument);
+	stub("window", fakeWindow);
+	stub("getComputedStyle", () => computedStyle);
+	stub("CSS", { supports: () => true });
+	stub("requestAnimationFrame", (callback: FrameRequestCallback) =>
+		setTimeout(() => callback(performance.now()), 16),
+	);
+	stub("cancelAnimationFrame", (id: number) => clearTimeout(id as unknown as NodeJS.Timeout));
+}
+
+export function uninstallFakeDomEnv(): void {
+	for (const [name, descriptor] of saved) {
+		if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+		else delete (globalThis as any)[name as string];
+	}
+	saved.clear();
+	FakeResizeObserver.instances = [];
+}
+
+export interface ResizeSpec {
+	target: Element;
+	width: number;
+	height: number;
+}
+
+export function resizeEntries(...specs: ResizeSpec[]): unknown[] {
+	return specs.map((spec) => ({
+		target: spec.target,
+		contentRect: {
+			width: spec.width,
+			height: spec.height,
+			top: 0,
+			left: 0,
+			right: spec.width,
+			bottom: spec.height,
+			x: 0,
+			y: 0,
+		},
+		borderBoxSize: [{ inlineSize: spec.width, blockSize: spec.height }],
+		contentBoxSize: [{ inlineSize: spec.width, blockSize: spec.height }],
+	}));
+}
+
+export function triggerResize(observer: unknown, ...specs: ResizeSpec[]): void {
+	(observer as FakeResizeObserver).trigger(resizeEntries(...specs));
+}
+
+export function observedElements(player: unknown): Set<Element> {
+	return (player as { resizeObserver: FakeResizeObserver }).resizeObserver.observed;
+}
