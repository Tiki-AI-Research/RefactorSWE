+}
+
+const vitestShim = defineTestApi();
+
+// ---------------------------------------------------------------------------
+// ：CSSvitest 
+// ---------------------------------------------------------------------------
+
+const CSS_STUB = "data:text/javascript,export default new Proxy({}, { get: (_, key) => typeof key === 'string' ? key : undefined });";
+const STRUCTURED_CLONE_STUB = `data:text/javascript,${encodeURIComponent(`
