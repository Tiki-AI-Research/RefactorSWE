+	});
+
+	const mouseEvent = new FakeMouseEvent("click", { cancelable: true });
+	player.currentLyricGroups[0].getElement().dispatchEvent(mouseEvent);
+
+	expect(propagationStopped).toBe(true);
+	expect(mouseEvent.propagationStopped).toBe(true);
+	expect(mouseEvent.immediatePropagationStopped).toBe(true);
+});
+
+it("P2P: sets the propagation flag and stops immediate propagation on the original event when stopImmediatePropagation is called", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([makeLine(0, 1000, { word: "A" })]);
+
+	let propagationStopped = false;
+	player.addEventListener("line-click", (event) => {
+		const lyricEvent = event as LyricLineMouseEvent;
+		lyricEvent.stopImmediatePropagation();
+		propagationStopped = lyricEvent.isPropagationStopped;
+	});
+
+	const mouseEvent = new FakeMouseEvent("click", { cancelable: true });
+	player.currentLyricGroups[0].getElement().dispatchEvent(mouseEvent);
+
+	expect(propagationStopped).toBe(true);
+	expect(mouseEvent.propagationStopped).toBe(true);
+	expect(mouseEvent.immediatePropagationStopped).toBe(true);
+});
+
+it("P2P: constructs LyricLineMouseEvent as a mouse event with payload fields and an initially false propagation flag", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "main" }),
+		makeLine(100, 500, { word: "bg", isBG: true }),
+	]);
+
+	const group = player.currentLyricGroups[0];
+	const original = new FakeMouseEvent("click", { cancelable: true });
