+
+it("P2P: delivers line-click and line-contextmenu through the player as lyric mouse events", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([makeLine(0, 1000, { word: "A" })]);
+
+	const delivered: Array<{ type: string; isMouseEvent: boolean }> = [];
