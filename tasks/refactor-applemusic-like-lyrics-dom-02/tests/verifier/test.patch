+	const totalTests = suites.reduce((total, suite) => total + suite.tests.length, 0);
+	const totalFailures = suites.reduce((total, suite) => total + suite.failures, 0);
+	const totalErrors = suites.reduce((total, suite) => total + suite.errors, 0);
+	const reportPath = writeReport(options.report, renderJUnit(suites, (Date.now() - startedAll) / 1000));
+
+	console.log(
+		`[f2p-runner] files=${suites.length} tests=${totalTests} failures=${totalFailures} errors=${totalErrors} report=${reportPath}`,
+	);
+	if (totalFailures > 0 || totalErrors > 0) process.exitCode = 1;
+}
+
+async function run() {
+	const options = parseArguments(process.argv.slice(2));
+	if (!options.report) throw new Error("missing --report <path>");
+	if (options.files.length === 0) throw new Error("missing test file arguments");
+	const root = resolve(options.root);
+	if (options.worker) {
+		await runWorker(options, root);
+		return;
+	}
+	await runIsolated(options, root);
+}
+
+await run();
