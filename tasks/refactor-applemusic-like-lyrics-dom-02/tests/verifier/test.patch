+import { afterAll, expect, it } from "vitest";
+import {
+	FakeElement,
+	installFakeDomEnv,
+	triggerResize,
+	uninstallFakeDomEnv,
+} from "./fake-dom-env.ts";
+import { createTestPlayer, makeLine } from "./p2p-fixtures.ts";
+
+installFakeDomEnv();
+const { DomLyricPlayer } = await import("#lyric/dom/index.ts");
+
+afterAll(() => {
+	uninstallFakeDomEnv();
+});
+
+function observedElements(player: DomLyricPlayer): Set<Element> {
+	return (
+		player.resizeObserver as unknown as {
+			observed: Set<Element>;
+		}
+	).observed;
+}
+
+function attachAllGroups(player: DomLyricPlayer): void {
+	triggerResize(player.resizeObserver, {
+		target: player.getElement(),
+		width: 1200,
+		height: 800,
+	});
+	player.update(0);
+}
+
+it("P2P: attaches visible groups to the player container in sorted order", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(2000, 3000, { word: "C" }),
+	]);
+	attachAllGroups(player);
+
+	const groups = player.currentLyricGroups;
+	const container = player.getElement();
+	expect(groups.map((group) => group.getElement().parentElement)).toEqual([
+		container,
+		container,
+		container,
+	]);
+	expect(
+		container.children.filter((child) =>
+			groups.some((group) => group.getElement() === child),
+		),
+	).toEqual(groups.map((group) => group.getElement()));
+});
+
+it("P2P: detaches a hidden group and stops observing its element and background wrapper", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(1100, 1400, { word: "bgB", isBG: true }),
+	]);
+	attachAllGroups(player);
+
+	const group = player.currentLyricGroups[1];
+	const backgroundWrapper = group.bgWrapper;
+	expect(backgroundWrapper).toBeDefined();
+	expect(observedElements(player).has(group.getElement())).toBe(true);
+	expect(observedElements(player).has(backgroundWrapper as HTMLElement)).toBe(
+		true,
+	);
+
+	group.hide();
+
+	expect(group.getElement().parentElement).toBeNull();
+	expect(observedElements(player).has(group.getElement())).toBe(false);
+	expect(observedElements(player).has(backgroundWrapper as HTMLElement)).toBe(
+		false,
+	);
+});
+
+it("P2P: remounts a detached group before the first later attached group", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(2000, 3000, { word: "C" }),
+	]);
+	attachAllGroups(player);
+
+	const container = player.getElement();
+	const [first, second, third] = player.currentLyricGroups;
+	const position = (group: (typeof player.currentLyricGroups)[number]) =>
+		container.children.indexOf(group.getElement());
+
+	second.hide();
+	second.show();
+	expect(position(first)).toBeLessThan(position(second));
+	expect(position(second) + 1).toBe(position(third));
+});
+
+it("P2P: does not move an already attached group when shown", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(2000, 3000, { word: "C" }),
+	]);
+	attachAllGroups(player);
+	const container = player.getElement();
+	const before = [...container.children];
+	player.currentLyricGroups[1].show();
+	expect(container.children).toEqual(before);
+});
+
+it("P2P: appends a remounted group when no later group remains attached", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(2000, 3000, { word: "C" }),
+	]);
+	attachAllGroups(player);
+	const [first, second, third] = player.currentLyricGroups;
+	const container = player.getElement();
+	third.hide();
+	second.hide();
+	second.show();
+	expect(
+		container.children.filter((child) =>
+			[first, second, third].some((group) => group.getElement() === child),
+		),
+	).toEqual([first, second].map((group) => group.getElement()));
+});
+
+it("P2P: keeps group and line identity across hide and show", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(1100, 1400, { word: "bgB", isBG: true }),
+	]);
+	attachAllGroups(player);
+
+	const group = player.currentLyricGroups[1];
+	const mainLine = group.mainLine;
+	const backgroundLine = group.bgLine;
+	group.hide();
+	group.show();
+
+	expect(player.currentLyricGroups.indexOf(group)).toBe(1);
+	expect(group.mainLine).toBe(mainLine);
+	expect(group.bgLine).toBe(backgroundLine);
+});
+
+it("P2P: preserves main and background associations across hide and show", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(1100, 1400, { word: "bgB", isBG: true }),
+	]);
+	attachAllGroups(player);
+	const group = player.currentLyricGroups[1];
+	const backgroundWrapper = group.bgWrapper as HTMLElement;
+	expect(player.lyricGroupElementMap.get(group.getElement())).toBe(group);
+	expect(player.lyricGroupElementMap.get(backgroundWrapper)).toBe(group);
+	group.hide();
+	group.show();
+	expect(player.lyricGroupElementMap.get(group.getElement())).toBe(group);
+	expect(player.lyricGroupElementMap.get(backgroundWrapper)).toBe(group);
+});
+
+it("P2P: remounts a shown group into its player container", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+	]);
+	attachAllGroups(player);
+	const group = player.currentLyricGroups[1];
+	group.hide();
+	group.show();
+	expect(group.getElement().parentElement).toBe(player.getElement());
+});
+
+it("P2P: exposes main and background-wrapper associations for registered groups", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(1100, 1400, { word: "bgB", isBG: true }),
+	]);
+	attachAllGroups(player);
+
+	const group = player.currentLyricGroups[1];
+	const backgroundWrapper = group.bgWrapper as HTMLElement;
+
+	expect(player.lyricGroupElementMap.get(group.getElement())).toBe(group);
+	expect(player.lyricGroupElementMap.get(backgroundWrapper)).toBe(group);
+});
+
+it("P2P: exposes and updates the group size map", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+	]);
+	attachAllGroups(player);
+	const group = player.currentLyricGroups[1];
+	expect(typeof player.lyricGroupSize.get).toBe("function");
+	triggerResize(player.resizeObserver, {
+		target: group.getElement(),
+		width: 120,
+		height: 64,
+	});
+	expect(player.lyricGroupSize.get(group)).toEqual([120, 64]);
+});
+
+it("P2P: exposes resize observation for registered groups and wrappers", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([
+		makeLine(0, 1000, { word: "A" }),
+		makeLine(1000, 2000, { word: "B" }),
+		makeLine(1100, 1400, { word: "bgB", isBG: true }),
+	]);
+	attachAllGroups(player);
+	const group = player.currentLyricGroups[1];
+	const backgroundWrapper = group.bgWrapper as HTMLElement;
+	expect(observedElements(player).has(group.getElement())).toBe(true);
+	expect(observedElements(player).has(backgroundWrapper)).toBe(true);
