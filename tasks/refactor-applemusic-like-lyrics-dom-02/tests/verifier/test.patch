+/**
+ * F2P owner tests for the consolidated group-relationship contract.
+ *
+ * These leaves exercise the player through the documented public surfaces
+ * (`currentLyricGroups` populated by a subclass through `buildLyricGroups`,
+ * the exposed element map and size map, the resize observer and the public
+ * mouse events) and assert the responsibilities that the consolidation must
+ * own: association queries, event payloads, remount ordering with resumed
+ * observations, preserved event semantics and the frozen dependency surface.
+ */
+import { readFileSync } from "node:fs";
+import { afterAll, expect, it } from "vitest";
+import type { LyricLine } from "#interfaces";
+import type { LyricLineMouseEvent } from "#lyric/dom/index.ts";
+import {
+	FakeElement,
+	FakeMouseEvent,
+	installFakeDomEnv,
+	triggerResize,
+	uninstallFakeDomEnv,
+} from "../f2p-owner/fake-dom-env.ts";
+import {
+	attachPlayer,
+	createReplacementPlayer,
+	loadPlayerClasses,
+	makeLine,
+	mainWithBackgroundLines,
+} from "../f2p-owner/f2p-fixtures.ts";
+
+installFakeDomEnv();
+const classes = await loadPlayerClasses();
+
+afterAll(() => {
+	uninstallFakeDomEnv();
+});
+
+/** （ 1 ） */
+function spacedMainLines(count: number): LyricLine[] {
+	return Array.from({ length: count }, (_value, index) =>
+		makeLine(index * 1000, index * 1000 + 1000, { word: `L${index}` }),
+	);
+}
+
+function dispatchMouseEvent(
+	target: Element,
+	type: "click" | "contextmenu",
+): FakeMouseEvent {
+	const event = new FakeMouseEvent(type, { cancelable: true });
+	(
+		target as unknown as { dispatchEvent(event: unknown): boolean }
+	).dispatchEvent(event);
+	return event;
+}
+
+function childrenOf(player: { getElement(): Element }): Element[] {
+	const element = player.getElement() as FakeElement;
+	return element.childNodes.filter(
+		(child): child is Element => child instanceof FakeElement,
+	) as unknown as Element[];
+}
