+import type { LyricLine } from "#interfaces";
+import { installFakeDomEnv } from "./fake-dom-env.ts";
+
+/**
+ * ， `setLyricLines` 
+ *
+ * ：`convertExcessiveBackgroundLines`  `sortLyricLines` ，
+ * 
+ */
+export const DISABLED_OPTIMIZE_OPTIONS = {
+	normalizeSpaces: false,
+	resetLineTimestamps: false,
+	syncMainAndBackgroundLines: false,
+	cleanUnintentionalOverlaps: false,
+	tryAdvanceStartTime: false,
+};
+
+export interface LineOptions extends Partial<LyricLine> {
+	/**  */
+	word?: string;
+}
+
+/**  */
+export function makeLine(
+	startTime: number,
+	endTime: number,
+	options: LineOptions = {},
+): LyricLine {
+	const { word = "w", ...overrides } = options;
+	return {
+		words: [{ word, startTime, endTime }],
+		translatedLyric: "",
+		romanLyric: "",
+		startTime,
+		endTime,
+		isBG: false,
+		isDuet: false,
+		...overrides,
+	};
+}
+
+/**  */
+export function lineMark(line: LyricLine): string {
+	return line.words[0]?.word ?? "";
+}
+
+type PlayerModule = typeof import("#lyric/dom/index.ts");
+
+/**  DOM  */
+export async function loadPlayerModule(): Promise<PlayerModule> {
+	installFakeDomEnv();
+	return import("#lyric/dom/index.ts");
+}
+
+/**  DOM  */
+export async function createTestPlayer(): Promise<
+	InstanceType<PlayerModule["DomLyricPlayer"]>
+> {
+	const { DomLyricPlayer } = await loadPlayerModule();
+	const player = new DomLyricPlayer();
+	player.setEnableSpring(false);
+	player.setLyricProcessConfig({
+		optimizeOptions: DISABLED_OPTIMIZE_OPTIONS,
+	});
+	return player;
+}
