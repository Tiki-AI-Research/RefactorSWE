+
+it("P2P: reports -1 when the main line has no processed index while keeping the line objects", async () => {
+	class IndexPruningPlayer extends DomLyricPlayer {
+		protected override buildLyricGroups(): void {
+			super.buildLyricGroups();
+			for (const group of this.currentLyricGroups) {
+				this.lyricLinesIndexes.delete(group.mainLine);
