+import { afterAll, expect, it } from 'vitest';
+import { FakeElement, FakeMouseEvent, installFakeDomEnv, triggerResize, uninstallFakeDomEnv } from '../f2p-owner/fake-dom-env.ts';
+import { attachPlayer, configurePlayer, createStandardPlayer, loadPlayerClasses, threeMainLines } from '../f2p-owner/f2p-fixtures.ts';
+installFakeDomEnv();
+const classes = await loadPlayerClasses();
+afterAll(uninstallFakeDomEnv);
+
+function standard() {
+  const p = createStandardPlayer(classes);
+  p.setLyricLines(threeMainLines());
+  attachPlayer(p);
+  return p;
+}
+
+it('P2P: replacing the exposed association map routes a newly associated element', () => {
+  const p = standard(), group = p.currentLyricGroups[0];
+  const element = new FakeElement('span');
+  p.lyricGroupElementMap = new WeakMap([[element, group]]);
+  const calls: unknown[] = [];
+  group.onBgSizeChange = size => calls.push(size);
+  triggerResize(p.resizeObserver, {target: element, width: 71, height: 23});
+  expect(calls).toEqual([[71, 23]]);
+});
+
+it('P2P: a subclass can replace the protected line index map', () => {
+  class Player extends classes.DomLyricPlayer {
+    replaceIndexMap(line: any) { this.lyricLinesIndexes = new WeakMap([[line, 19]]); }
+  }
+  const p = configurePlayer(new Player());
+  p.setLyricLines(threeMainLines());
+  attachPlayer(p);
+  const group = p.currentLyricGroups[0];
+  p.replaceIndexMap(group.mainLine);
+  const seen: number[] = [];
+  p.addEventListener('line-click', ((e: any) => seen.push(e.lineIndex)) as EventListener);
+  group.getElement().dispatchEvent(new FakeMouseEvent('click', {cancelable: true}));
+  expect(seen).toEqual([19]);
+});
+
+it('P2P: existing registered group without a stored line index keeps the -1 sentinel', () => {
+  const p = standard(), group = p.currentLyricGroups[0];
+  (p as any).lyricLinesIndexes.delete(group.mainLine);
+  const seen: number[] = [];
+  p.addEventListener('line-click', ((e: any) => seen.push(e.lineIndex)) as EventListener);
+  group.getElement().dispatchEvent(new FakeMouseEvent('click', {cancelable: true}));
+  expect(seen).toEqual([-1]);
+});
+
