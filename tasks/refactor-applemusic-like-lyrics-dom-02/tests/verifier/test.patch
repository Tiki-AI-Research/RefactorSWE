+
+	// ，
+	groups.reverse();
+
+	const clickIndices: number[] = [];
+	const contextIndices: number[] = [];
+	const clickTypes: string[] = [];
+	player.addEventListener("line-click", (event) => {
+		clickIndices.push((event as LyricLineMouseEvent).lineIndex);
