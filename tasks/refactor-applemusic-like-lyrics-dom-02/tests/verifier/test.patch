+	);
+	groups[0].getElement().dispatchEvent(
+		new FakeMouseEvent("contextmenu", { cancelable: true }),
+	);
+	expect(clickIndices).toEqual([2]);
+	expect(contextIndices).toEqual([2]);
+	expect(clickTypes).toEqual(["line-click"]);
+
+	groups[1].getElement().dispatchEvent(
+		new FakeMouseEvent("click", { cancelable: true }),
