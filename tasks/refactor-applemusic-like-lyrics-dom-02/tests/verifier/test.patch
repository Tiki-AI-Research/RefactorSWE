+/** Public preservation boundaries; every case runs on the pinned baseline. */
+import { afterAll, expect, it } from "vitest";
+import { MaskObsceneWordsMode } from "#lyric/base/consts.ts";
+import { LayoutReason } from "#lyric/base/consts.ts";
+import { installFakeDomEnv, triggerResize, uninstallFakeDomEnv } from "./fake-dom-env.ts";
+import { createTestPlayer, makeLine } from "./p2p-fixtures.ts";
+installFakeDomEnv();
+afterAll(() => uninstallFakeDomEnv());
+
+async function maskedPlayer() {
+    const player = await createTestPlayer();
+    const line = makeLine(0, 1000, { word: "fuck" });
+    line.words[0].obscene = true;
+    player.setLyricProcessConfig({ maskMode: MaskObsceneWordsMode.FullMask });
+    player.setLyricLines([line]);
+    return player;
+}
+const displayed = (player: Awaited<ReturnType<typeof createTestPlayer>>) =>
+    player.currentLyricGroups[0].mainLine.getLine().words[0].word;
+
+it("P2P: mask character convenience setter normalizes to the first character", async () => {
+    const player = await maskedPlayer();
+    player.setMaskObsceneWordChar("!?");
+    expect(displayed(player)).toBe("!!!!");
+    player.dispose();
+});
+it("P2P: mask character convenience setter falls back on empty input", async () => {
+    const player = await maskedPlayer();
+    player.setMaskObsceneWordChar("!");
+    player.setMaskObsceneWordChar("");
+    expect(displayed(player)).toBe("****");
+    player.dispose();
+});
+it("P2P: changing the mask character immediately replaces the displayed group", async () => {
+    const player = await maskedPlayer();
+    const old = player.currentLyricGroups[0];
+    player.setMaskObsceneWordChar("!");
+    expect(player.currentLyricGroups[0]).not.toBe(old);
+    player.dispose();
+});
+it("P2P: mask character convenience setter preserves unprocessed lyrics", async () => {
+    const player = await maskedPlayer();
+    player.setMaskObsceneWordChar("!?");
+    expect(player.getLyricLines()[0].words[0].word).toBe("fuck");
+    player.dispose();
+});
+it("P2P: mask character convenience setter skips an unchanged normalized character", async () => {
+    const player = await maskedPlayer();
+    player.setMaskObsceneWordChar("!");
+    const old = player.currentLyricGroups[0];
+    player.setMaskObsceneWordChar("!?");
+    expect(player.currentLyricGroups[0]).toBe(old);
+    player.dispose();
+});
+it("P2P: bulk processing configuration retains its empty mask character semantics", async () => {
+    const player = await maskedPlayer();
+    player.updateLyricProcessConfig({ maskChar: "" });
+    expect(displayed(player)).toBe("");
+    player.dispose();
+});
+
+async function timedPlayer() {
+    const player = await createTestPlayer();
+    player.setLyricLines([makeLine(0, 1000), makeLine(1000, 2000), makeLine(2000, 3000)]);
+    return player;
+}
+function resize(player: Awaited<ReturnType<typeof createTestPlayer>>, height: number) {
+    triggerResize(player.resizeObserver, { target: player.getElement(), width: 1200, height });
+    player.update(0);
+}
+function observed(player: Awaited<ReturnType<typeof createTestPlayer>>) {
+    return (player.resizeObserver as unknown as { observed: Set<Element> }).observed;
+}
+it("P2P: hiding a never-mounted group retains its main element observation", async () => {
+    const player = await createTestPlayer();
+    const { LyricLineEl } = await import("#lyric/dom/lyric-line.ts");
+    const { LyricLineGroup } = await import("#lyric/dom/lyric-group.ts");
+    const group = new LyricLineGroup(player, new LyricLineEl(player, makeLine(0, 1000)));
+    expect(group.getElement().parentElement).toBeNull();
+    expect(observed(player).has(group.getElement())).toBe(true);
+    group.hide();
+    expect(observed(player).has(group.getElement())).toBe(true);
+    player.dispose();
+});
+async function externallyDetachedPlayer() {
+    const player = await createTestPlayer();
+    player.setLyricLines([makeLine(0, 1000), makeLine(0, 1000, { isBG: true })]);
+    resize(player, 800);
+    const group = player.currentLyricGroups[0];
+    group.getElement().remove();
+    return { player, group };
+}
+it("P2P: hiding an externally detached group retains its main element observation", async () => {
+    const { player, group } = await externallyDetachedPlayer();
+    expect(observed(player).has(group.getElement())).toBe(true);
+    group.hide();
+    expect(observed(player).has(group.getElement())).toBe(true);
+    player.dispose();
+});
+it("P2P: hiding an externally detached group retains its background observation", async () => {
+    const { player, group } = await externallyDetachedPlayer();
+    expect(observed(player).has(group.bgWrapper as HTMLElement)).toBe(true);
+    group.hide();
+    expect(observed(player).has(group.bgWrapper as HTMLElement)).toBe(true);
+    player.dispose();
+});
+it("P2P: container resize updates the fallback height of an unmeasured slot", async () => {
+    const player = await timedPlayer();
+    resize(player, 800);
+    expect(player.getLineHeight(1)).toBe(160);
+    resize(player, 1000);
+    expect(player.getLineHeight(1)).toBe(200);
+    player.dispose();
+});
+it("P2P: container resize preserves the height of a measured slot", async () => {
+    const player = await timedPlayer();
+    resize(player, 800);
+    triggerResize(player.resizeObserver, { target: player.currentLyricGroups[0].getElement(), width: 100, height: 42 });
+    resize(player, 1000);
+    expect(player.getLineHeight(0)).toBe(42);
+    player.dispose();
+});
