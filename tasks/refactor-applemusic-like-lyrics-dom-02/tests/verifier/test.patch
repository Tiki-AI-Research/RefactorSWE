+	const orphanChild = new FakeElement("span");
+	orphanWrapper.appendChild(orphanChild);
+	orphanChild.dispatchEvent(new FakeMouseEvent("click", { cancelable: true }));
+
+	expect(events.length).toBe(0);
+});
+
+it("P2P: forwards cancellation and default prevention from the lyric event to the original mouse event", async () => {
+	const player = await createTestPlayer();
+	player.setLyricLines([makeLine(0, 1000, { word: "A" })]);
+
+	player.addEventListener("line-click", (event) => {
