+	console.log(
+		`[f2p-runner] file=${suite.className} tests=${suite.tests.length} failures=${suite.failures} errors=${suite.errors} report=${reportPath}`,
+	);
+	logFailures([suite]);
+	if (suite.failures > 0 || suite.errors > 0) process.exitCode = 1;
+}
+
+/**
+ * ：，
+ * （ DOM ）；
+ *  JSON  JUnit  {report}
+ */
+async function runIsolated(options, root) {
+	const startedAll = Date.now();
+	const suites = [];
+	const scratch = mkdtempSync(join(tmpdir(), "f2p-runner-"));
+	try {
+		for (const [index, file] of options.files.entries()) {
+			const absoluteFilePath = resolveTestFile(file, root);
+			const summaryPath = join(scratch, `summary-${index}.json`);
+			const workerReportPath = join(scratch, `report-${index}.xml`);
+			const result = spawnSync(
+				process.execPath,
+				[
+					"--disable-warning=ExperimentalWarning",
+					fileURLToPath(import.meta.url),
+					"--worker",
+					"--report",
+					workerReportPath,
+					"--summary",
+					summaryPath,
+					"--root",
+					root,
+					absoluteFilePath,
+				],
+				{ stdio: ["ignore", "inherit", "inherit"] },
+			);
+			let suite = null;
+			if (existsSync(summaryPath)) {
+				try {
+					const parsed = JSON.parse(readFileSync(summaryPath, "utf8"));
+					if (parsed && Array.isArray(parsed.tests) && typeof parsed.className === "string") suite = parsed;
+				} catch {
+					suite = null;
+				}
+			}
+			if (!suite) {
+				const className = relative(root, absoluteFilePath).split(sep).join("/") || absoluteFilePath;
+				const detail = result.error
+					? `worker failed to start: ${result.error.message}`
+					: `worker exited with status ${result.status}${result.signal ? ` signal ${result.signal}` : ""} without a usable summary`;
