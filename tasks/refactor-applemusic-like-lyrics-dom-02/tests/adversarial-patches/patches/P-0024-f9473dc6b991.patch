@@ -0,0 +1,143 @@
+import { MediaTime } from "#utils/time.ts";
+import type { LyricLineGroupBase } from "./group.ts";
+import type { LyricLineBase } from "./line.ts";
+
+export interface LyricGroupRelationsHost {
+	currentLyricGroups: LyricLineGroupBase[];
+	lyricGroupElementMap: WeakMap<Element, LyricLineGroupBase>;
+	lyricGroupSize: WeakMap<LyricLineGroupBase, [number, number]>;
+	resizeObserver: ResizeObserver;
+	readonly defaultLineHeight: number;
+	getElement(): HTMLElement;
+	getLineHeight(index: number): number;
+	getLyricLinesIndexes(): WeakMap<LyricLineBase, number>;
+	setTimelineBounds(
+		bounds: readonly { startTime: MediaTime; endTime: MediaTime }[],
+	): void;
+	initLayoutHeights(count: number, defaultHeight: number): void;
+}
+
+export class LyricGroupRelations {
+
+	constructor(private readonly host: LyricGroupRelationsHost) {}
+
+	resetGroups(): void {
+		this.host.currentLyricGroups = [];
+	}
+
+	initializeGroupOrder(): void {
+		const groups = this.host.currentLyricGroups;
+		groups.sort((a, b) => MediaTime.cmp(a.startTime, b.startTime));
+
+
+
+		const bounds = groups.map((group) => ({
+			startTime: group.startTime,
+			endTime: group.endTime,
+		}));
+		this.host.setTimelineBounds(bounds);
+		this.host.initLayoutHeights(groups.length, this.host.defaultLineHeight);
+	}
+
+	getLayoutIndex(group: LyricLineGroupBase): number {
+		return this.host.currentLyricGroups.indexOf(group);
+	}
+
+	registerLine(line: LyricLineBase, processedIndex: number): void {
+		this.host.getLyricLinesIndexes().set(line, processedIndex);
+	}
+
+	getLineIndex(line: LyricLineBase): number {
+		return this.host.getLyricLinesIndexes().get(line) ?? -1;
+	}
+
+	registerGroup(group: LyricLineGroupBase): void {
+		this.host.currentLyricGroups.push(group);
+		this.host.lyricGroupElementMap.set(group.getElement(), group);
+	}
+
+	getGroupForElement(element: Element): LyricLineGroupBase | undefined {
+		return this.host.lyricGroupElementMap.get(element);
+	}
+
+	getGroupSize(group: LyricLineGroupBase): [number, number] {
+		return this.host.lyricGroupSize.get(group) ?? [0, 0];
+	}
+
+	setGroupSize(group: LyricLineGroupBase, size: [number, number]): void {
+		this.host.lyricGroupSize.set(group, size);
+	}
+
+	getGroupIndex(group: LyricLineGroupBase): number {
+		return this.host.currentLyricGroups.indexOf(group);
+	}
+
+	getGroupHeight(group: LyricLineGroupBase): number {
+		const index = this.getGroupIndex(group);
+		return index !== -1
+			? this.host.getLineHeight(index)
+			: this.host.defaultLineHeight;
+	}
+
+	observeGroup(group: LyricLineGroupBase): void {
+		this.host.resizeObserver.observe(group.getElement());
+	}
+
+	registerBackground(group: LyricLineGroupBase, wrapper: HTMLElement): void {
+		this.host.lyricGroupElementMap.set(wrapper, group);
+		if (group.getElement().parentElement) {
+			this.host.resizeObserver.observe(wrapper);
+		}
+	}
+
+	mount(group: LyricLineGroupBase): void {
+		const groupEl = group.getElement();
+		if (groupEl.parentElement) return;
+
+		const playerEl = this.host.getElement();
+		const groups = this.host.currentLyricGroups;
+		const myIndex = groups.indexOf(group);
+
+		let referenceNode: Element | null = null;
+		if (myIndex !== -1) {
+			for (let i = myIndex + 1; i < groups.length; i++) {
+				const nextEl = groups[i].getElement();
+				if (nextEl.parentElement === playerEl) {
+					referenceNode = nextEl;
+					break;
+				}
+			}
+		}
+
+		playerEl.insertBefore(groupEl, referenceNode);
+
+		this.host.resizeObserver.observe(groupEl);
+		const bgWrapper = (group as { bgWrapper?: HTMLElement }).bgWrapper;
+		if (bgWrapper) {
+			this.host.resizeObserver.observe(bgWrapper);
+		}
+	}
+
+	unmount(group: LyricLineGroupBase): void {
+		const groupEl = group.getElement();
+		if (!groupEl.parentElement) return;
+
+		this.host.resizeObserver.unobserve(groupEl);
+		const bgWrapper = (group as { bgWrapper?: HTMLElement }).bgWrapper;
+		if (bgWrapper) {
+			this.host.resizeObserver.unobserve(bgWrapper);
+		}
+		groupEl.remove();
+	}
+
+	unregisterGroup(group: LyricLineGroupBase): void {
+		const groupEl = group.getElement();
+		this.host.resizeObserver.unobserve(groupEl);
+		const bgWrapper = (group as { bgWrapper?: HTMLElement }).bgWrapper;
+		if (bgWrapper) {
+			this.host.lyricGroupElementMap.delete(bgWrapper);
+			this.host.resizeObserver.unobserve(bgWrapper);
+		}
+		groupEl.remove();
+	}
+}
