+import { describe, expect, it, vi } from "vitest";
+import type { LyricLineGroupBase } from "../src/lyric-player/base/group.ts";
+import {
+	LyricGroupRelations,
+	type LyricGroupRelationsHost,
+} from "../src/lyric-player/base/group-relations.ts";
+import type { LyricLineBase } from "../src/lyric-player/base/line.ts";
+import { MediaTime } from "../src/utils/time.ts";
+import { FakeElement } from "./fake-dom.ts";
+
+function createMockGroup(
+	startTimeMs: number,
+	endTimeMs: number,
+	bgWrapper?: FakeElement,
+): LyricLineGroupBase & { element: FakeElement; bgWrapper?: FakeElement } {
+	const el = new FakeElement("div");
+	return {
+		element: el,
+		bgWrapper,
+		startTime: MediaTime.fromMillis(startTimeMs),
+		endTime: MediaTime.fromMillis(endTimeMs),
+		getElement() {
+			return el as unknown as HTMLElement;
+		},
+	} as unknown as LyricLineGroupBase & {
+		element: FakeElement;
+		bgWrapper?: FakeElement;
+	};
+}
+
+describe("LyricGroupRelations unit tests", () => {
+	it("handles group registration, ordering, layout slot allocation, and empty reset", () => {
+		const playerEl = new FakeElement("div");
+		const linesIndexes = new WeakMap<LyricLineBase, number>();
+		const timelineBoundsSpy = vi.fn();
+		const initLayoutHeightsSpy = vi.fn();
+		const observed: Element[] = [];
+		const unobserved: Element[] = [];
+
+		const host: LyricGroupRelationsHost = {
+			currentLyricGroups: [],
+			lyricGroupElementMap: new WeakMap(),
+			lyricGroupSize: new WeakMap(),
+			resizeObserver: {
+				observe: (el: Element) => observed.push(el),
+				unobserve: (el: Element) => unobserved.push(el),
+			} as unknown as ResizeObserver,
+			defaultLineHeight: 30,
+			getElement: () => playerEl as unknown as HTMLElement,
+			getLineHeight: (i: number) => (i + 1) * 20,
+			getLyricLinesIndexes: () => linesIndexes,
+			setTimelineBounds: timelineBoundsSpy,
+			initLayoutHeights: initLayoutHeightsSpy,
+		};
+
+		const relations = new LyricGroupRelations(host);
+
+		// Group creation
+		const g1 = createMockGroup(2000, 3000);
+		const g2 = createMockGroup(1000, 2000);
+		const g3 = createMockGroup(1000, 2500); // Same start time as g2
+		const gUnsorted = createMockGroup(500, 1000);
+
+		host.currentLyricGroups = [g1, g2, g3];
+
+		relations.initializeGroupOrder();
+
+		// Stable sort: g2 and g3 both have startTime 1000, g2 was first, so [g2, g3, g1]
+		expect(host.currentLyricGroups).toEqual([g2, g3, g1]);
+
+		// Bounds and layout init
+		expect(timelineBoundsSpy).toHaveBeenCalledWith([
+			{ startTime: g2.startTime, endTime: g2.endTime },
+			{ startTime: g3.startTime, endTime: g3.endTime },
+			{ startTime: g1.startTime, endTime: g1.endTime },
+		]);
+		expect(initLayoutHeightsSpy).toHaveBeenCalledWith(3, 30);
+
+		// Layout indices
+		expect(relations.getLayoutIndex(g2)).toBe(0);
+		expect(relations.getLayoutIndex(g3)).toBe(1);
+		expect(relations.getLayoutIndex(g1)).toBe(2);
+		expect(relations.getLayoutIndex(gUnsorted)).toBe(-1);
+
+		// Group height
+		expect(relations.getGroupHeight(g2)).toBe(20);
+		expect(relations.getGroupHeight(g3)).toBe(40);
+		expect(relations.getGroupHeight(g1)).toBe(60);
+		expect(relations.getGroupHeight(gUnsorted)).toBe(30);
+
+		// Reset groups
+		relations.resetGroups();
+		expect(host.currentLyricGroups).toEqual([]);
+
+		relations.initializeGroupOrder();
+		expect(timelineBoundsSpy).toHaveBeenLastCalledWith([]);
