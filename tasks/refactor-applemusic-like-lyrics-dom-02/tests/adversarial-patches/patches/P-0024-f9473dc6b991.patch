--- /dev/null
+++ b/packages/core/test/dom-group-relations.test.ts
@@ -0,0 +1,425 @@
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import {
+	cleanupFakeDom,
+	FakeElement,
+	FakeMouseEvent,
+	type FakeResizeObserver,
+	setupFakeDom,
+} from "./fake-dom.ts";
+
+let DomLyricPlayer: typeof import("../src/lyric-player/dom/index.ts").DomLyricPlayer;
+let LyricLineEl: typeof import("../src/lyric-player/dom/lyric-line.ts").LyricLineEl;
+let LyricLineGroup: typeof import("../src/lyric-player/dom/lyric-group.ts").LyricLineGroup;
+type LyricLineMouseEventType =
+	import("../src/lyric-player/dom/index.ts").LyricLineMouseEvent;
+
+describe("DomLyricPlayer group relations integration tests", () => {
+	beforeAll(async () => {
+		setupFakeDom();
+		const domMod = await import("../src/lyric-player/dom/index.ts");
+		DomLyricPlayer = domMod.DomLyricPlayer;
+		const groupMod = await import("../src/lyric-player/dom/lyric-group.ts");
+		LyricLineGroup = groupMod.LyricLineGroup;
+		const lineMod = await import("../src/lyric-player/dom/lyric-line.ts");
+		LyricLineEl = lineMod.LyricLineEl;
+	});
+
+	afterAll(() => {
+		cleanupFakeDom();
+	});
+
+	it("handles mouse event targeting, processed index vs group order, bg targets, and cancel/propagation forwarding", () => {
+		const player = new DomLyricPlayer();
+
+		// Create two lines in processed order:
+		// Line 0: startTime 5000 (later in time)
+		// Line 1: startTime 1000 (earlier in time)
+		const rawLine0 = {
+			words: [{ word: "L0", startTime: 5000, endTime: 6000 }],
+			translatedLyric: "",
+			romanLyric: "",
+			startTime: 5000,
+			endTime: 6000,
+			isBG: false,
+			isDuet: false,
+		};
+		const rawLine1 = {
+			words: [{ word: "L1", startTime: 1000, endTime: 2000 }],
+			translatedLyric: "",
+			romanLyric: "",
+			startTime: 1000,
+			endTime: 2000,
+			isBG: false,
+			isDuet: false,
+		};
+		const rawBgLine = {
+			words: [{ word: "BG", startTime: 5200, endTime: 5800 }],
+			translatedLyric: "",
+			romanLyric: "",
+			startTime: 5200,
+			endTime: 5800,
+			isBG: true,
+			isDuet: false,
+		};
+
+		const lineEl0 = new LyricLineEl(player, rawLine0);
+		const lineEl1 = new LyricLineEl(player, rawLine1);
+		const bgLineEl = new LyricLineEl(player, rawBgLine);
+
+		player.groupRelations.registerLine(lineEl0, 0);
+		player.groupRelations.registerLine(lineEl1, 1);
+		player.groupRelations.registerLine(bgLineEl, 2);
+
+		const group0 = new LyricLineGroup(player, lineEl0);
+		group0.addBgLine(bgLineEl);
+		player.groupRelations.registerGroup(group0);
+
+		const group1 = new LyricLineGroup(player, lineEl1);
+		player.groupRelations.registerGroup(group1);
+
+		// Initialize order: stable sort puts group1 (1000ms) at slot 0, and group0 (5000ms) at slot 1
+		player.groupRelations.initializeGroupOrder();
+		expect(player.currentLyricGroups).toEqual([group1, group0]);
+
+		// Attach groups to player element
+		group1.show();
+		group0.show();
+
+		// Test 1: Click on main line of group0
+		// In sorted array, group0 is at index 1. But its lineEl0 was registered at processed index 0!
+		const lineClickEvents: LyricLineMouseEventType[] = [];
+		player.addEventListener("line-click", ((e: Event) => {
+			lineClickEvents.push(e as LyricLineMouseEventType);
+		}) as EventListener);
+
+		const mouseEvent0 = new FakeMouseEvent("click", { cancelable: true });
+		group0.element.dispatchEvent(mouseEvent0);
+
+		expect(lineClickEvents.length).toBe(1);
+		expect(lineClickEvents[0].lineIndex).toBe(0); // MUST be processed index 0, NOT sorted group index 1!
+		expect(lineClickEvents[0].line).toBe(lineEl0);
+		expect(lineClickEvents[0].bgLine).toBe(bgLineEl);
+
+		// Test 2: Click on child inside background wrapper of group0
+		const bgChild = new FakeElement("span");
+		group0.bgWrapper?.appendChild(bgChild as unknown as HTMLElement);
+
+		const mouseEventBg = new FakeMouseEvent("click", { cancelable: true });
+		bgChild.dispatchEvent(mouseEventBg);
+
+		expect(lineClickEvents.length).toBe(2);
+		expect(lineClickEvents[1].lineIndex).toBe(0); // Reports MAIN line's processed index
+		expect(lineClickEvents[1].line).toBe(lineEl0);
+		expect(lineClickEvents[1].bgLine).toBe(bgLineEl);
+
+		// Test 3: Unassociated target produces no event
+		const unassociatedEl = new FakeElement("button");
+		player.getElement().appendChild(unassociatedEl as unknown as HTMLElement);
+		const mouseEventUnassociated = new FakeMouseEvent("click", {
+			cancelable: true,
+		});
+		unassociatedEl.dispatchEvent(mouseEventUnassociated);
+		expect(lineClickEvents.length).toBe(2); // No new event
+		expect(mouseEventUnassociated.defaultPrevented).toBe(false);
+
+		// Test 4: Cancellation forwarding
+		let cancelNext = false;
+		player.addEventListener("line-contextmenu", ((e: Event) => {
+			if (cancelNext) {
+				e.preventDefault();
+			}
+		}) as EventListener);
+
+		cancelNext = false;
+		const ctxEvent1 = new FakeMouseEvent("contextmenu", { cancelable: true });
+		group0.element.dispatchEvent(ctxEvent1);
+		expect(ctxEvent1.defaultPrevented).toBe(false);
+
+		cancelNext = true;
+		const ctxEvent2 = new FakeMouseEvent("contextmenu", { cancelable: true });
+		group0.element.dispatchEvent(ctxEvent2);
+		expect(ctxEvent2.defaultPrevented).toBe(true); // Forwarded preventDefault!
+
+		// Test 5: Propagation forwarding
+		let stopNext = false;
+		let stopImmediateNext = false;
+		player.addEventListener("line-click", ((e: Event) => {
+			if (stopNext) {
+				e.stopPropagation();
+			}
+			if (stopImmediateNext) {
+				e.stopImmediatePropagation();
+			}
+		}) as EventListener);
+
+		stopNext = true;
+		const clickEventStop = new FakeMouseEvent("click", { cancelable: true });
+		group0.element.dispatchEvent(clickEventStop);
+		expect(clickEventStop.isPropagationStopped).toBe(true);
+		expect(clickEventStop.isImmediatePropagationStopped).toBe(true);
+
+		stopNext = false;
+		stopImmediateNext = true;
+		const clickEventStopImm = new FakeMouseEvent("click", { cancelable: true });
+		group0.element.dispatchEvent(clickEventStopImm);
+		expect(clickEventStopImm.isPropagationStopped).toBe(true);
+		expect(clickEventStopImm.isImmediatePropagationStopped).toBe(true);
+	});
+
+	it("routes ResizeObserver entries, writes size to group and layout slot, and handles bg measurements", () => {
+		const player = new DomLyricPlayer();
+
+		const rawLine0 = {
+			words: [{ word: "A", startTime: 1000, endTime: 2000 }],
+			translatedLyric: "",
+			romanLyric: "",
+			startTime: 1000,
+			endTime: 2000,
+			isBG: false,
+			isDuet: false,
+		};
+		const rawLine1 = {
+			words: [{ word: "B", startTime: 3000, endTime: 4000 }],
+			translatedLyric: "",
+			romanLyric: "",
+			startTime: 3000,
+			endTime: 4000,
+			isBG: false,
+			isDuet: false,
+		};
+		const rawBgLine = {
+			words: [{ word: "BG", startTime: 3200, endTime: 3800 }],
+			translatedLyric: "",
+			romanLyric: "",
+			startTime: 3200,
+			endTime: 3800,
+			isBG: true,
+			isDuet: false,
+		};
+
+		const lineEl0 = new LyricLineEl(player, rawLine0);
+		const lineEl1 = new LyricLineEl(player, rawLine1);
+		const bgLineEl = new LyricLineEl(player, rawBgLine);
+
+		player.groupRelations.registerLine(lineEl0, 0);
+		player.groupRelations.registerLine(lineEl1, 1);
+		player.groupRelations.registerLine(bgLineEl, 2);
+
+		const group0 = new LyricLineGroup(player, lineEl0);
+		player.groupRelations.registerGroup(group0);
+
+		const group1 = new LyricLineGroup(player, lineEl1);
+		group1.addBgLine(bgLineEl);
+		player.groupRelations.registerGroup(group1);
+
+		player.groupRelations.initializeGroupOrder();
+
+		const observer = player.resizeObserver as unknown as FakeResizeObserver;
+
+		// 1. Trigger size change for group0 (slot 0)
+		const mainLineSpy = vi.spyOn(lineEl0, "onLineSizeChange");
+		observer.trigger([
+			{
+				target: group0.element as unknown as Element,
+				borderBoxSize: [{ inlineSize: 400, blockSize: 65 }],
+			},
+		]);
+
+		expect(player.lyricGroupSize.get(group0)).toEqual([400, 65]);
+		expect(mainLineSpy).toHaveBeenCalledWith([400, 65]);
+		expect(player.getLineHeight(0)).toBe(65);
+
+		// 2. Trigger size change for group1 (slot 1)
+		const group1MainSpy = vi.spyOn(lineEl1, "onLineSizeChange");
+		const group1BgSpy = vi.spyOn(bgLineEl, "onLineSizeChange");
+		observer.trigger([
+			{
+				target: group1.element as unknown as Element,
+				borderBoxSize: [{ inlineSize: 380, blockSize: 75 }],
+			},
+		]);
+
+		expect(player.lyricGroupSize.get(group1)).toEqual([380, 75]);
+		expect(group1MainSpy).toHaveBeenCalledWith([380, 75]);
+		expect(group1BgSpy).toHaveBeenCalledWith([380, 75]);
+		expect(player.getLineHeight(1)).toBe(75);
+
+		// 3. Duplicate size does not re-trigger line notification
+		mainLineSpy.mockClear();
+		observer.trigger([
+			{
+				target: group0.element as unknown as Element,
+				borderBoxSize: [{ inlineSize: 400, blockSize: 65 }],
+			},
+		]);
+		expect(mainLineSpy).not.toHaveBeenCalled();
+
+		// 4. Background wrapper measurement routes to onBgSizeChange without modifying main size or main layout slot
+		const bgSizeSpy = vi.spyOn(group1, "onBgSizeChange");
+		observer.trigger([
+			{
+				target: group1.bgWrapper as unknown as Element,
+				borderBoxSize: [{ inlineSize: 350, blockSize: 30 }],
+			},
+		]);
+
+		expect(bgSizeSpy).toHaveBeenCalledWith([350, 30]);
+		expect(player.lyricGroupSize.get(group1)).toEqual([380, 75]); // Main size unchanged!
+		expect(player.getLineHeight(1)).toBe(75); // Main layout slot unchanged!
+
+		// 5. Unknown element is ignored
+		const unassociated = new FakeElement("div");
+		expect(() => {
+			observer.trigger([
+				{
+					target: unassociated as unknown as Element,
+					borderBoxSize: [{ inlineSize: 100, blockSize: 20 }],
+				},
+			]);
+		}).not.toThrow();
+	});
+
+	it("preserves group and line identities across hide/show, maintains mount order, and handles disposal", () => {
+		const player = new DomLyricPlayer();
+
+		const rawLine0 = {
+			words: [{ word: "A", startTime: 1000, endTime: 2000 }],
+			translatedLyric: "",
+			romanLyric: "",
+			startTime: 1000,
+			endTime: 2000,
+			isBG: false,
+			isDuet: false,
+		};
+		const rawLine1 = {
+			words: [{ word: "B", startTime: 2000, endTime: 3000 }],
+			translatedLyric: "",
+			romanLyric: "",
+			startTime: 2000,
+			endTime: 3000,
+			isBG: false,
+			isDuet: false,
+		};
+		const rawBgLine = {
+			words: [{ word: "BG", startTime: 2100, endTime: 2800 }],
+			translatedLyric: "",
+			romanLyric: "",
+			startTime: 2100,
+			endTime: 2800,
+			isBG: true,
+			isDuet: false,
+		};
+
+		const lineEl0 = new LyricLineEl(player, rawLine0);
+		const lineEl1 = new LyricLineEl(player, rawLine1);
+		const bgLineEl = new LyricLineEl(player, rawBgLine);
