+		player.groupRelations.initializeGroupOrder();
+
+		const playerEl = player.getElement() as unknown as FakeElement;
+		const observer = player.resizeObserver as unknown as FakeResizeObserver;
+
+		// Initial show
+		group0.show();
+		group1.show();
+		expect(group0.element.parentElement).toBe(playerEl);
+		expect(group1.element.parentElement).toBe(playerEl);
+		expect(
+			(playerEl.children as unknown as HTMLElement[]).indexOf(group0.element),
+		).toBeLessThan(
+			(playerEl.children as unknown as HTMLElement[]).indexOf(group1.element),
+		);
+		expect(observer.observed.has(group0.element as unknown as Element)).toBe(
+			true,
+		);
+		expect(observer.observed.has(group1.element as unknown as Element)).toBe(
+			true,
+		);
+		expect(observer.observed.has(group1.bgWrapper as unknown as Element)).toBe(
+			true,
+		);
+
+		// Hide group0
+		group0.hide();
+		expect(group0.element.parentElement).toBeNull();
+		expect(playerEl.children as unknown as HTMLElement[]).not.toContain(
+			group0.element,
+		);
+		expect(observer.unobserved).toContain(group0.element as unknown as Element);
+		// Identity and associations preserved
+		expect(
+			player.groupRelations.getGroupForElement(
+				group0.element as unknown as Element,
+			),
+		).toBe(group0);
+		expect(group0.mainLine).toBe(lineEl0);
+
+		// Hide group1
+		group1.hide();
+		expect(group1.element.parentElement).toBeNull();
+		expect(playerEl.children as unknown as HTMLElement[]).not.toContain(
+			group1.element,
+		);
+		expect(observer.unobserved).toContain(
+			group1.bgWrapper as unknown as Element,
+		);
+
+		// Remount: show group1 first, then group0
+		group1.show();
+		expect(playerEl.children as unknown as HTMLElement[]).toContain(
+			group1.element,
+		);
+		expect(playerEl.children as unknown as HTMLElement[]).not.toContain(
+			group0.element,
+		);
+
+		// Now show group0: since group0 is before group1 in currentLyricGroups,
+		// it must find group1 as referenceNode and insert BEFORE group1!
+		group0.show();
+		expect(playerEl.children as unknown as HTMLElement[]).toContain(
+			group0.element,
+		);
+		expect(playerEl.children as unknown as HTMLElement[]).toContain(
+			group1.element,
+		);
+		expect(
+			(playerEl.children as unknown as HTMLElement[]).indexOf(group0.element),
+		).toBeLessThan(
+			(playerEl.children as unknown as HTMLElement[]).indexOf(group1.element),
+		);
+
+		// Calling show on already mounted group does not move it
+		group0.show();
+		expect(
+			(playerEl.children as unknown as HTMLElement[]).indexOf(group0.element),
+		).toBeLessThan(
+			(playerEl.children as unknown as HTMLElement[]).indexOf(group1.element),
+		);
+
+		// Dispose group1
+		const bgWrapper = group1.bgWrapper;
+		group1.dispose();
+		expect(group1.element.parentElement).toBeNull();
+		// bgWrapper association deleted
+		expect(
+			player.groupRelations.getGroupForElement(bgWrapper as unknown as Element),
+		).toBeUndefined();
+		// Group element association preserved
+		expect(
+			player.groupRelations.getGroupForElement(
+				group1.element as unknown as Element,
+			),
+		).toBe(group1);
+	});
+});
