+import { vi } from "vitest";
+
+export class FakeClassList {
+	private classes = new Set<string>();
+
+	constructor(initial = "") {
+		for (const c of initial.split(/\s+/)) {
+			if (c) this.classes.add(c);
+		}
+	}
+
+	add(...tokens: string[]): void {
+		for (const t of tokens) {
+			if (t) this.classes.add(t);
+		}
+	}
+
+	remove(...tokens: string[]): void {
+		for (const t of tokens) {
+			this.classes.delete(t);
+		}
+	}
+
+	contains(token: string): boolean {
+		return this.classes.has(token);
+	}
+
+	toggle(token: string, force?: boolean): boolean {
+		if (force !== undefined) {
+			if (force) this.classes.add(token);
+			else this.classes.delete(token);
+			return force;
+		}
+		if (this.classes.has(token)) {
+			this.classes.delete(token);
+			return false;
+		}
+		this.classes.add(token);
+		return true;
+	}
+
+	toString(): string {
+		return Array.from(this.classes).join(" ");
+	}
+}
+
+export class FakeNode {
+	static readonly ELEMENT_NODE: number = 1;
+	static readonly TEXT_NODE: number = 3;
+	nodeType: number = 1;
+}
+
+export class FakeElement extends FakeNode {
+	override readonly nodeType: number = 1;
+	parentElement: FakeElement | null = null;
+	children: FakeElement[] = [];
+	classList: FakeClassList;
+	style: Record<string, string> & {
+		setProperty(k: string, v: string): void;
+		removeProperty(k: string): void;
+	};
+	innerHTML: string = "";
+	textContent: string = "";
+	dataset: Record<string, string> = {};
+	clientWidth: number = 100;
+	clientHeight: number = 50;
+	offsetWidth: number = 100;
+	offsetHeight: number = 50;
+
+	private listeners = new Map<
+		string,
+		Array<{
+			listener: EventListenerOrEventListenerObject;
+			options?: AddEventListenerOptions | boolean;
+		}>
+	>();
+
+	constructor(public tagName: string = "div") {
+		super();
+		this.classList = new FakeClassList();
+		const styleProps: Record<string, string> = {};
+		this.style = Object.assign(styleProps, {
+			setProperty(k: string, v: string) {
+				styleProps[k] = v;
+			},
+			removeProperty(k: string) {
+				delete styleProps[k];
+			},
+		});
+	}
+
+	get className(): string {
+		return this.classList.toString();
+	}
+
+	set className(val: string) {
+		this.classList = new FakeClassList(val);
+	}
+
+	get childNodes(): FakeElement[] {
+		return this.children;
+	}
+
+	getBoundingClientRect(): {
+		left: number;
+		right: number;
+		top: number;
+		bottom: number;
+		width: number;
+		height: number;
+	} {
+		return {
+			left: 0,
+			right: this.clientWidth,
+			top: 0,
+			bottom: this.clientHeight,
+			width: this.clientWidth,
+			height: this.clientHeight,
+		};
+	}
+
+	private attributes = new Map<string, string>();
+
+	setAttribute(name: string, value: string): void {
+		if (name === "class") {
+			this.className = value;
+		}
+		this.attributes.set(name, value);
+	}
+
+	getAttribute(name: string): string | null {
+		if (name === "class") {
+			return this.className;
+		}
+		return this.attributes.get(name) ?? null;
+	}
+
+	removeAttribute(name: string): void {
+		if (name === "class") {
+			this.className = "";
+		}
+		this.attributes.delete(name);
+	}
+
+	getAttributeNames(): string[] {
+		const names = Array.from(this.attributes.keys());
+		if (this.className && !names.includes("class")) {
+			names.push("class");
+		}
+		return names;
+	}
+
+	appendChild<T extends FakeElement>(child: T): T {
+		if (child.parentElement) {
+			child.parentElement.removeChild(child);
+		}
+		child.parentElement = this;
+		this.children.push(child);
+		return child;
+	}
+
+	insertBefore<T extends FakeElement>(
+		newChild: T,
+		refChild: FakeElement | null,
+	): T {
+		if (newChild.parentElement) {
+			newChild.parentElement.removeChild(newChild);
+		}
+		newChild.parentElement = this;
+		if (!refChild) {
+			this.children.push(newChild);
+			return newChild;
+		}
+		const idx = this.children.indexOf(refChild);
+		if (idx === -1) {
+			this.children.push(newChild);
+		} else {
+			this.children.splice(idx, 0, newChild);
+		}
+		return newChild;
+	}
+
+	removeChild<T extends FakeElement>(child: T): T {
+		const idx = this.children.indexOf(child);
+		if (idx !== -1) {
+			this.children.splice(idx, 1);
+		}
+		child.parentElement = null;
+		return child;
+	}
+
+	remove(): void {
+		if (this.parentElement) {
+			this.parentElement.removeChild(this);
+		}
+	}
+
+	animate(): Animation {
+		return {
+			pause: () => {},
+			play: () => {},
+			finish: () => {},
+			cancel: () => {},
+			currentTime: 0,
+			playbackRate: 1,
+			addEventListener: () => {},
+			removeEventListener: () => {},
+		} as unknown as Animation;
+	}
+
+	closest(selector: string): FakeElement | null {
+		if (selector.startsWith(".")) {
+			const cls = selector.slice(1);
+			if (this.classList.contains(cls)) return this;
+		}
+		return this.parentElement?.closest(selector) ?? null;
+	}
+
+	querySelectorAll(selector: string): FakeElement[] {
+		const results: FakeElement[] = [];
+		const search = (el: FakeElement) => {
+			for (const child of el.children) {
+				if (selector.startsWith(".")) {
+					if (child.classList.contains(selector.slice(1))) {
+						results.push(child);
+					}
+				} else if (child.tagName.toLowerCase() === selector.toLowerCase()) {
+					results.push(child);
+				}
+				search(child);
+			}
+		};
+		search(this);
+		return results;
+	}
+
+	querySelector(selector: string): FakeElement | null {
+		return this.querySelectorAll(selector)[0] ?? null;
+	}
+
+	addEventListener(
+		type: string,
+		listener: EventListenerOrEventListenerObject,
+		options?: AddEventListenerOptions | boolean,
+	): void {
+		let list = this.listeners.get(type);
+		if (!list) {
+			list = [];
+			this.listeners.set(type, list);
+		}
+		list.push({ listener, options });
+		if (typeof options === "object" && options?.signal) {
+			options.signal.addEventListener("abort", () => {
+				this.removeEventListener(type, listener);
+			});
+		}
+	}
+
+	removeEventListener(
+		type: string,
+		listener: EventListenerOrEventListenerObject,
+	): void {
+		const list = this.listeners.get(type);
+		if (list) {
+			const idx = list.findIndex((item) => item.listener === listener);
+			if (idx !== -1) {
+				list.splice(idx, 1);
+			}
+		}
+	}
+
+	dispatchEvent(event: Event): boolean {
+		if (!event.target) {
+			Object.defineProperty(event, "target", {
+				value: this,
+				configurable: true,
+			});
+		}
+		let curr: FakeElement | null = this;
+		while (curr) {
+			const list = curr.listeners.get(event.type) ?? [];
+			for (const item of [...list]) {
+				if (typeof item.listener === "function") {
+					item.listener(event);
+				} else if (
+					item.listener &&
+					typeof item.listener.handleEvent === "function"
+				) {
+					item.listener.handleEvent(event);
+				}
+				if ((event as FakeMouseEvent).isImmediatePropagationStopped) break;
+			}
+			if (
+				(event as FakeMouseEvent).isPropagationStopped ||
+				(event as FakeMouseEvent).isImmediatePropagationStopped
+			) {
+				break;
+			}
+			curr = curr.parentElement;
+		}
+		return !event.defaultPrevented;
+	}
+}
+
+export class FakeMouseEvent extends Event {
+	override defaultPrevented: boolean = false;
+	isPropagationStopped: boolean = false;
+	isImmediatePropagationStopped: boolean = false;
+	override target: EventTarget | null = null;
+
+	override preventDefault(): void {
+		this.defaultPrevented = true;
+	}
+
+	override stopPropagation(): void {
+		this.isPropagationStopped = true;
+	}
+
+	override stopImmediatePropagation(): void {
+		this.isImmediatePropagationStopped = true;
+	}
+}
+
+export class FakeResizeObserver {
+	static instances: FakeResizeObserver[] = [];
+	observed: Set<Element> = new Set<Element>();
+	unobserved: Element[] = [];
+
+	constructor(public callback: ResizeObserverCallback) {
+		FakeResizeObserver.instances.push(this);
+	}
+
+	observe(el: Element): void {
+		this.observed.add(el);
+	}
+
+	unobserve(el: Element): void {
+		this.observed.delete(el);
+		this.unobserved.push(el);
+	}
+
+	disconnect(): void {
+		this.observed.clear();
+	}
+
+	trigger(entries: Partial<ResizeObserverEntry>[]): void {
+		this.callback(
+			entries as ResizeObserverEntry[],
+			this as unknown as ResizeObserver,
+		);
+	}
+}
+
+export class FakeMutationObserver {
+	constructor(public callback: MutationCallback) {}
+	observe(): void {}
+	disconnect(): void {}
+}
+
+export function setupFakeDom(): void {
+	FakeResizeObserver.instances = [];
+	vi.stubGlobal("Node", FakeNode);
+	vi.stubGlobal("Element", FakeElement);
+	vi.stubGlobal("HTMLElement", FakeElement);
+	vi.stubGlobal("MouseEvent", FakeMouseEvent);
+	vi.stubGlobal("ResizeObserver", FakeResizeObserver);
+	vi.stubGlobal("MutationObserver", FakeMutationObserver);
+	vi.stubGlobal("document", {
+		createElement(tag: string) {
+			return new FakeElement(tag);
+		},
+		createTextNode(text: string) {
+			return { textContent: text, nodeType: 3 };
+		},
+		createRange() {
+			return {
+				selectNodeContents: () => {},
+				setStart: () => {},
+				setEnd: () => {},
+				getBoundingClientRect: () => ({
+					left: 0,
+					right: 0,
+					top: 0,
+					bottom: 0,
+					width: 0,
+					height: 0,
+				}),
+			};
+		},
+	});
+	vi.stubGlobal("window", {
+		innerHeight: 1000,
+		addEventListener: vi.fn(),
+		removeEventListener: vi.fn(),
+	});
+	vi.stubGlobal("getComputedStyle", () => ({
+		fontSize: "16px",
+	}));
+	vi.stubGlobal("CSS", {
+		supports: () => true,
+	});
+}
+
+export function cleanupFakeDom(): void {
+	vi.unstubAllGlobals();
+	FakeResizeObserver.instances = [];
+}
