+        expect(getParentCount()).toBe(0);
+        // Secondary pointer must NOT have capture, primary pointer retains capture
+        expect(svg.hasPointerCapture(52)).toBe(false);
+        expect(svg.hasPointerCapture(51)).toBe(true);
