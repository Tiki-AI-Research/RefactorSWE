+        // Complete primary gesture cleanly
+        svg.dispatchEvent(new MockPointerEvent("pointerup", { pointerId: 51, clientX: 30, clientY: 30 }));
+        expect(svg.hasPointerCapture(51)).toBe(false);
+      } finally {
+        disconnectPicker(picker);
+      }
+    }
+
+    // ------------------------------------------------------------------------
+    // Branch 6: Reconnected after removing interactive attribute (positive control: bubbles, propagationStopped === false)
+    // ------------------------------------------------------------------------
+    {
+      const { picker, svg, getParentCount } = setupParentAndPicker(true, false, true);
+      try {
+        // Remove interactive attribute, disconnect and reconnect
+        (picker as unknown as MockElement).removeAttribute("interactive");
