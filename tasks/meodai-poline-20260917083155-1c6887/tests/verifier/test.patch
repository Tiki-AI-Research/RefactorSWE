+class MockNode {
+  get ownerDocument(): any { return (globalThis as any).document; }
+  get firstChild(): MockNode | null { return this.children[0] ?? null; }
+  get lastElementChild(): MockElement | null {
+    return this.children.filter((node): node is MockElement => node instanceof MockElement).at(-1) ?? null;
+  }
+  private connectedRoot: boolean | undefined;
+  get isConnected(): boolean { return this.connectedRoot ?? this.parentNode?.isConnected ?? false; }
+  set isConnected(value: boolean) { this.connectedRoot = value; }
+  public parentNode: MockNode | null = null;
+  public children: MockNode[] = [];
+  public classList = new MockClassList();
+  public attributes = new Map<string, string>();
+  public styles: Record<string, string> = {};
+  public textContent = "";
+  public style = {
+    setProperty: (k: string, v: string): void => {
+      this.styles[k] = v;
+    },
+    getPropertyValue: (k: string): string => this.styles[k] || "",
+  };
+  protected listeners: Record<string, ((event: unknown) => void)[]> = {};
+  protected captureListeners: Record<string, ((event: unknown) => void)[]> = {};
+
+  setAttribute(k: string, v: string): void {
+    this.attributes.set(k, String(v));
+    if (k === "class") {
+      v.split(/\s+/)
+        .filter(Boolean)
+        .forEach((c) => this.classList.add(c));
+    }
+  }
+  getAttribute(k: string): string | null {
+    return this.attributes.get(k) ?? null;
+  }
+  hasAttribute(k: string): boolean {
+    return this.attributes.has(k);
+  }
+  removeAttribute(k: string): void {
+    this.attributes.delete(k);
+  }
+  getAttributeNames(): string[] {
+    return Array.from(this.attributes.keys());
+  }
+
+  set className(v: string) {
+    this.setAttribute("class", v);
+  }
+  get className(): string {
+    return this.getAttribute("class") || "";
+  }
+
+  appendChild<T extends MockNode>(child: T): T {
+    child.parentNode = this;
+    this.children.push(child);
+    return child;
+  }
+
+  append(...nodes: (MockNode | string)[]): void {
+    for (const node of nodes) {
+      if (typeof node === "string") {
+        const textNode = new MockNode();
+        textNode.textContent = node;
+        textNode.parentNode = this;
+        this.children.push(textNode);
+      } else if (node instanceof MockNode) {
+        node.parentNode = this;
+        this.children.push(node);
+      }
+    }
+  }
+
+  replaceChildren(...nodes: (MockNode | string)[]): void {
+    for (const child of this.children.slice()) {
+      this.removeChild(child);
+    }
+    this.append(...nodes);
+  }
+
+  replaceChild<T extends MockNode>(replacement: MockNode, child: T): T {
+    if (!this.children.includes(child)) throw new Error("NotFoundError");
+    if (replacement === child) return child;
+    replacement.parentNode?.removeChild(replacement);
+    const index = this.children.indexOf(child);
+    this.children[index] = replacement;
+    child.parentNode = null;
+    replacement.parentNode = this;
+    return child;
+  }
+
+  removeChild<T extends MockNode>(child: T): T {
+    const i = this.children.indexOf(child);
+    if (i >= 0) {
+      this.children.splice(i, 1);
+      child.parentNode = null;
+    }
+    return child;
+  }
+
+  remove(): void {
+    if (this.parentNode) {
+      this.parentNode.removeChild(this);
+    }
+  }
+
+  contains(node: MockNode | null): boolean {
+    if (!node || typeof node !== "object") {
+      return false;
+    }
+    for (let current: MockNode | null = node; current; current = current.parentNode) {
+      if (current === this) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  addEventListener(type: string, fn: (event: unknown) => void, capture = false): void {
+    const listeners = capture ? this.captureListeners : this.listeners;
+    if (!listeners[type]) listeners[type] = [];
+    listeners[type]?.push(fn);
+  }
+
+  removeEventListener(type: string, fn: (event: unknown) => void, capture = false): void {
+    const listeners = capture ? this.captureListeners : this.listeners;
+    if (!listeners[type]) return;
+    listeners[type] = listeners[type]?.filter((l) => l !== fn);
+  }
+
+  getEventListeners(type: string): ((event: unknown) => void)[] {
+    return this.listeners[type] || [];
+  }
+
+  getSelf(): MockNode {
+    return this;
+  }
+
+  dispatchEvent(event: MockEvent | { type: string; target?: unknown; currentTarget?: unknown; bubbles?: boolean; propagationStopped?: boolean }): boolean {
+    if (!event.target) {
+      event.target = this;
+    }
+    for (let current: MockNode | null = this.getSelf(); current; current = current.parentNode) {
+      event.currentTarget = current;
+      // At-target capture listeners run first. Retain the dispatch snapshot across
+      // synchronous rebinding so retired callbacks already in flight are exercised.
+      const handlers = [
+        ...(current === this ? current.captureListeners[event.type] || [] : []),
+        ...(current.listeners[event.type] || []),
+      ];
+      for (const h of handlers) {
+        h(event);
+      }
+      if (event.propagationStopped || event.bubbles === false) {
+        break;
+      }
+    }
+    return true;
+  }
+
+  querySelector(sel: string): MockNode | null {
+    return this.querySelectorAll(sel)[0] ?? null;
+  }
+
+  querySelectorAll(sel: string): MockNode[] {
+    const result: MockNode[] = [];
+    const walk = (node: MockNode): void => {
+      let match = false;
+      if (sel.startsWith(".")) {
+        const cls = sel.slice(1);
+        if (node.classList.contains(cls)) match = true;
+      } else if (sel.startsWith("#")) {
+        const id = sel.slice(1);
+        if (node.getAttribute("id") === id) match = true;
+      } else {
+        if (
+          node instanceof MockElement &&
+          node.tagName.toLowerCase() === sel.toLowerCase()
+        )
+          match = true;
+      }
+      if (match) result.push(node);
+      for (const c of node.children) walk(c);
+    };
+    for (const c of this.children) walk(c);
+    return result;
+  }
+}
