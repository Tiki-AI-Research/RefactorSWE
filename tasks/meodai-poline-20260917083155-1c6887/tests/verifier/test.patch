+// Effective visibility inspector for device styles
+function isElementEffectivelyHidden(el: MockElement, shadowRoot: MockShadowRoot | null, isCoarse: boolean): boolean {
+  for (let curr: MockNode | null = el; curr; curr = curr.parentNode) {
+    if (curr.hasAttribute("hidden")) return true;
+    const styles = (curr as unknown as { styles?: Record<string, string> }).styles || {};
+    const inlineDisplay = curr.style?.getPropertyValue("display") || styles.display;
+    if (inlineDisplay === "none") return true;
+    const inlineVisibility = curr.style?.getPropertyValue("visibility") || styles.visibility;
+    if (inlineVisibility === "hidden") return true;
+    const inlineOpacity = curr.style?.getPropertyValue("opacity") || styles.opacity;
+    if (inlineOpacity === "0") return true;
+  }
+
+  if (!shadowRoot) return false;
+
+  const styleElements = shadowRoot.querySelectorAll("style");
+  let cssText = "";
+  for (const s of styleElements) {
+    cssText += " " + (s.textContent || "");
+  }
+  cssText = cssText.replace(/\/\*[\s\S]*?\*\//g, "");
+
+  function selectorMatches(sel: string, target: MockElement): boolean {
+    const trimmed = sel.trim();
+    if (!trimmed) return false;
+    const parts = trimmed.split(",").map((p) => p.trim()).filter(Boolean);
+    for (const part of parts) {
+      const segments = part.split(/[\s>+~]+/).map((s) => s.trim()).filter(Boolean);
+      if (segments.length === 0) continue;
+      const rightmost = segments[segments.length - 1]!;
+      let targetMatches = true;
+      const classMatches = rightmost.match(/\.([a-zA-Z0-9_-]+)/g);
+      if (classMatches) {
+        for (const cm of classMatches) {
+          if (!target.classList.contains(cm.slice(1))) {
+            targetMatches = false;
+            break;
+          }
+        }
+      }
+      const tagMatch = rightmost.match(/^[a-zA-Z0-9_-]+/);
+      if (tagMatch && targetMatches) {
+        if (target.tagName.toLowerCase() !== tagMatch[0].toLowerCase()) {
+          targetMatches = false;
+        }
+      }
+      const idMatch = rightmost.match(/#([a-zA-Z0-9_-]+)/);
+      if (idMatch && targetMatches) {
+        if (target.getAttribute("id") !== idMatch[1]) {
+          targetMatches = false;
+        }
+      }
+      if (targetMatches) return true;
+
+      for (const seg of segments) {
+        if (seg === ":host" || seg.startsWith(":host(")) {
+          if (segments.length === 1) return true;
+        }
+        for (let anc: MockNode | null = target.parentNode; anc; anc = anc.parentNode) {
+          if (anc instanceof MockElement) {
+            let ancMatches = true;
+            const aClasses = seg.match(/\.([a-zA-Z0-9_-]+)/g);
+            if (aClasses) {
+              for (const cm of aClasses) {
+                if (!anc.classList.contains(cm.slice(1))) {
+                  ancMatches = false;
+                  break;
+                }
+              }
+            }
+            const aTag = seg.match(/^[a-zA-Z0-9_-]+/);
+            if (aTag && ancMatches) {
+              if (anc.tagName.toLowerCase() !== aTag[0].toLowerCase()) {
+                ancMatches = false;
+              }
+            }
+            if (ancMatches && (aClasses || aTag)) {
+              if (segments.length === 1) return true;
+            }
+          }
+        }
+      }
+    }
+    return false;
+  }
+
+  let fineHidden = false;
+  let coarseHidden = false;
+
+  interface Rule {
+    media: string | null;
+    selector: string;
+    body: string;
+  }
+  const rules: Rule[] = [];
+
+  const mediaBlocks: Array<{ mediaQuery: string; content: string; start: number; end: number }> = [];
+  let idx = 0;
+  while (idx < cssText.length) {
+    const mediaIdx = cssText.indexOf("@media", idx);
+    if (mediaIdx === -1) break;
+    const braceStart = cssText.indexOf("{", mediaIdx);
+    if (braceStart === -1) break;
+    const mediaQuery = cssText.slice(mediaIdx + 6, braceStart).trim();
+    let depth = 1;
+    let currIdx = braceStart + 1;
+    while (currIdx < cssText.length && depth > 0) {
+      if (cssText[currIdx] === "{") depth++;
+      else if (cssText[currIdx] === "}") depth--;
+      currIdx++;
+    }
+    const innerContent = cssText.slice(braceStart + 1, currIdx - 1);
+    mediaBlocks.push({ mediaQuery, content: innerContent, start: mediaIdx, end: currIdx });
+    idx = currIdx;
+  }
+
+  let lastEnd = 0;
+  const topLevelSnippets: string[] = [];
+  for (const mb of mediaBlocks) {
+    topLevelSnippets.push(cssText.slice(lastEnd, mb.start));
+    lastEnd = mb.end;
+  }
+  topLevelSnippets.push(cssText.slice(lastEnd));
+
+  function parseRulesInBlock(blockText: string, media: string | null): void {
+    const ruleRegex = /([^{}]+)\{([^{}]+)\}/g;
+    let rMatch: RegExpExecArray | null;
+    while ((rMatch = ruleRegex.exec(blockText)) !== null) {
+      const sel = rMatch[1]?.trim();
+      const body = rMatch[2]?.trim();
+      if (sel && body) {
+        rules.push({ media, selector: sel, body });
+      }
+    }
+  }
+
+  for (const snip of topLevelSnippets) {
+    parseRulesInBlock(snip, null);
+  }
+  for (const mb of mediaBlocks) {
+    parseRulesInBlock(mb.content, mb.mediaQuery);
+  }
+
+  for (const r of rules) {
+    if (selectorMatches(r.selector, el)) {
+      const isHide =
+        /\bdisplay\s*:\s*none\b/i.test(r.body) ||
+        /\bvisibility\s*:\s*hidden\b/i.test(r.body) ||
+        /\bopacity\s*:\s*0\b/i.test(r.body);
+      const isShow =
+        /\bdisplay\s*:\s*(?!none\b)[a-z-]+\b/i.test(r.body) ||
+        /\bvisibility\s*:\s*visible\b/i.test(r.body) ||
+        /\bopacity\s*:\s*1\b/i.test(r.body);
+
+      if (r.media === null) {
+        if (isHide) {
+          fineHidden = true;
+          coarseHidden = true;
+        } else if (isShow) {
+          fineHidden = false;
+          coarseHidden = false;
+        }
+      } else if (r.media.includes("coarse")) {
+        if (isHide) coarseHidden = true;
+        else if (isShow) coarseHidden = false;
+      } else if (r.media.includes("fine")) {
+        if (isHide) fineHidden = true;
+        else if (isShow) fineHidden = false;
+      }
+    }
+  }
+
+  return isCoarse ? coarseHidden : fineHidden;
