+  constructor(tagName: string, ns: string | null = null) {
+    super();
+    this.tagName = tagName;
+    this.namespaceURI = ns;
+  }
+
+  getBoundingClientRect(): {
+    left: number;
+    top: number;
+    width: number;
+    height: number;
+    right: number;
+    bottom: number;
+  } {
