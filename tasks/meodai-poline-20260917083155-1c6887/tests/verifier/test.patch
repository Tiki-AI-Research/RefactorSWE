+  it("F2P::event::pointerdown_propagation_branches", () => {
+    isCoarsePointer = false;
+
+    // Helper: setup picker mounted inside a parent container
+    const setupParentAndPicker = (interactive: boolean, allowAddPoints: boolean, withPoline: boolean) => {
+      const parent = new MockElement("div");
+      const picker = new PolinePickerConstructor();
+      parent.appendChild(picker as unknown as MockElement);
+
+      if (interactive) {
+        (picker as unknown as MockElement).setAttribute("interactive", "");
+      }
+      if (allowAddPoints) {
+        (picker as unknown as MockElement).setAttribute("allow-add-points", "");
+      }
+      connectPicker(picker);
+
+      let poline: PolineType | null = null;
+      if (withPoline) {
+        poline = new PolineConstructor({
+          anchorColors: [
+            [120, 0.5, 0.5],
+            [240, 0.5, 0.5],
+          ],
+          numPoints: 4,
+        });
+        const p0 = poline.anchorPoints[0];
+        const p1 = poline.anchorPoints[1];
+        if (p0) p0.position = [0.3, 0.3, 0.5];
+        if (p1) p1.position = [0.7, 0.7, 0.5];
+        picker.setPoline(poline);
+      }
+
+      let parentCount = 0;
+      parent.addEventListener("pointerdown", () => {
+        parentCount++;
+      });
+
+      const host = picker as unknown as MockHTMLElement;
+      const svg = host.shadowRoot?.querySelector("svg") as MockElement;
+      expect(svg).toBeDefined();
+
+      return { parent, picker, svg, poline, getParentCount: () => parentCount };
+    };
+
+    // ------------------------------------------------------------------------
+    // Branch 1: Non-interactive state surface click (positive control: bubbles, propagationStopped === false)
+    // ------------------------------------------------------------------------
+    {
+      const { picker, svg, getParentCount } = setupParentAndPicker(false, false, true);
+      try {
+        const ev1 = new MockPointerEvent("pointerdown", { pointerId: 1, clientX: 30, clientY: 30 });
+        svg.dispatchEvent(ev1);
+        expect(ev1.propagationStopped).toBe(false);
+        expect(getParentCount()).toBe(1);
+        expect(svg.hasPointerCapture(1)).toBe(false);
+      } finally {
+        disconnectPicker(picker);
+      }
+    }
+
+    // ------------------------------------------------------------------------
+    // Branch 2: Interactive state without palette surface click (negative control: intercepted, propagationStopped === true)
+    // ------------------------------------------------------------------------
+    {
+      const { picker, svg, getParentCount } = setupParentAndPicker(true, true, false);
+      try {
+        const ev2 = new MockPointerEvent("pointerdown", { pointerId: 2, clientX: 30, clientY: 30 });
+        svg.dispatchEvent(ev2);
+        expect(ev2.propagationStopped).toBe(true);
+        expect(getParentCount()).toBe(0);
+        expect(svg.hasPointerCapture(2)).toBe(false);
+      } finally {
+        disconnectPicker(picker);
+      }
+    }
+
+    // ------------------------------------------------------------------------
+    // Branch 3: Interactive state, without allow-add-points, clicking blank canvas (negative control: intercepted)
+    // ------------------------------------------------------------------------
+    {
+      const { picker, svg, getParentCount } = setupParentAndPicker(true, false, true);
+      try {
+        // (10, 10) is blank presentation canvas far from anchors (30,30) and (70,70)
+        const ev3 = new MockPointerEvent("pointerdown", { pointerId: 3, clientX: 10, clientY: 10 });
+        svg.dispatchEvent(ev3);
+        expect(ev3.propagationStopped).toBe(true);
+        expect(getParentCount()).toBe(0);
+        expect(svg.hasPointerCapture(3)).toBe(false);
+      } finally {
+        disconnectPicker(picker);
+      }
+    }
+
+    // ------------------------------------------------------------------------
+    // Branch 4: Interactive state clicking anchor core (negative control: intercepted, acquires capture)
+    // ------------------------------------------------------------------------
+    {
+      const { picker, svg, getParentCount } = setupParentAndPicker(true, false, true);
+      try {
+        // (30, 30) is anchor 0 core
+        const ev4 = new MockPointerEvent("pointerdown", { pointerId: 4, clientX: 30, clientY: 30 });
+        svg.dispatchEvent(ev4);
+        expect(ev4.propagationStopped).toBe(true);
+        expect(getParentCount()).toBe(0);
+        expect(svg.hasPointerCapture(4)).toBe(true);
+        svg.dispatchEvent(new MockPointerEvent("pointerup", { pointerId: 4, clientX: 30, clientY: 30 }));
+      } finally {
+        disconnectPicker(picker);
+      }
+    }
+
+    // ------------------------------------------------------------------------
+    // Branch 5: Interactive state secondary pointerdown during active gesture (negative control: intercepted, does not hijack active pointer)
+    // ------------------------------------------------------------------------
+    {
+      const { picker, svg, getParentCount } = setupParentAndPicker(true, true, true);
+      try {
+        // First pointer initiates anchor drag
+        const ev5_1 = new MockPointerEvent("pointerdown", { pointerId: 51, clientX: 30, clientY: 30 });
+        svg.dispatchEvent(ev5_1);
+        expect(ev5_1.propagationStopped).toBe(true);
+        expect(getParentCount()).toBe(0);
+        expect(svg.hasPointerCapture(51)).toBe(true);
