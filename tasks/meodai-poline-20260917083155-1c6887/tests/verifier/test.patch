+function connectPicker(picker: PolinePickerType): void {
+  (picker as unknown as MockNode).isConnected = true;
+  if (picker.shadowRoot) {
+    (picker.shadowRoot as unknown as MockNode).isConnected = true;
+  }
+  picker.connectedCallback();
+  if (picker.shadowRoot) {
+    (picker.shadowRoot as unknown as MockNode).isConnected = true;
+  }
