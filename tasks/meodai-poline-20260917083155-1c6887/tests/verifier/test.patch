+// Global environment state
+let isCoarsePointer = false;
+const customElementRegistry = new Map<string, unknown>();
+
+// SVG coordinate parser accepting spaces, commas, scientific notation, and rejecting invalid tokens
+function parseSvgPoints(pointsAttr: string): Array<[number, number]> {
+  if (!pointsAttr || typeof pointsAttr !== "string") return [];
+  const normalized = pointsAttr.trim();
+  if (!normalized) return [];
+  const matches = normalized.match(/-?(?:\d*\.\d+|\d+)(?:[eE][+-]?\d+)?/g);
+  if (!matches) return [];
+  const numbers = matches.map(Number);
+  if (numbers.some((n) => !Number.isFinite(n))) {
+    throw new Error("SVG points attribute contains non-finite or invalid number");
+  }
+  expect(numbers.length % 2).toBe(0);
+  const result: Array<[number, number]> = [];
+  for (let i = 0; i < numbers.length; i += 2) {
+    result.push([numbers[i]!, numbers[i + 1]!]);
+  }
+  return result;
+}
