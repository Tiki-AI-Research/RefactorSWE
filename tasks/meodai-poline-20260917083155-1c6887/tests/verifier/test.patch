+        expect(ev6.propagationStopped).toBe(false);
+        expect(getParentCount()).toBe(countBefore + 1);
+        expect(currentSvg.hasPointerCapture(6)).toBe(false);
+      } finally {
+        disconnectPicker(picker);
+      }
+    }
+  });
