+class MockElement extends MockNode {
+  get localName(): string { return this.tagName.toLowerCase(); }
+  public tagName: string;
+  public namespaceURI: string | null = null;
+  public capturedPointers = new Set<number>();
+  public computedStyle: Record<string, string> = {};
+  public clientWidth = 100;
+  public clientHeight = 100;
