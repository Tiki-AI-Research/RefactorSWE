+      left: 0,
+      top: 0,
+      width: 100,
+      height: 100,
+      right: 100,
+      bottom: 100,
+    };
+  }
+
+  setPointerCapture(id: number): void {
+    this.capturedPointers.add(id);
+  }
+  releasePointerCapture(id: number): void {
+    this.capturedPointers.delete(id);
+  }
+  hasPointerCapture(id: number): boolean {
+    return this.capturedPointers.has(id);
+  }
+
+  set innerHTML(html: string) {
+    parseMarkupIntoNode(this, html, this.namespaceURI || HTML_NAMESPACE);
+  }
+
+  get innerHTML(): string {
+    return "";
+  }
+}
+
+function parseMarkupIntoNode(root: MockNode, html: string, defaultNamespace: string): void {
+  for (const child of root.children) child.parentNode = null;
+  root.children = [];
+  const stack: MockElement[] = [];
+
+  const tagRegex = /<!--[\s\S]*?-->|<style([^>]*)>([\s\S]*?)<\/style>|<\/([a-zA-Z0-9_:-]+)>|<([a-zA-Z0-9_:-]+)([^>]*?)(\/?)>/gi;
+  let match: RegExpExecArray | null;
+  let lastIdx = 0;
+
+  while ((match = tagRegex.exec(html)) !== null) {
+    const textBetween = html.slice(lastIdx, match.index).trim();
+    if (textBetween && stack.length > 0) {
+      const top = stack[stack.length - 1];
+      if (top) top.textContent = textBetween;
+    }
+    lastIdx = tagRegex.lastIndex;
+
+    if (match[0].startsWith("<!--")) {
+      continue;
+    }
+
+    const currentParent: MockNode = stack.length > 0 ? stack[stack.length - 1] || root : root;
+
+    if (match[2] !== undefined) {
+      const styleAttrs = match[1] || "";
+      const styleText = match[2];
+      const styleEl = new MockElement("style", HTML_NAMESPACE);
+      styleEl.textContent = styleText;
+
+      const attrRegex = /([a-zA-Z0-9_:-]+)(?:=(?:"([^"]*)"|'([^']*)'|([^\s>]+)))?/g;
+      let attrMatch: RegExpExecArray | null;
+      while ((attrMatch = attrRegex.exec(styleAttrs)) !== null) {
+        const attrName = attrMatch[1];
+        if (!attrName || attrName === "/") continue;
+        const attrVal = attrMatch[2] ?? attrMatch[3] ?? attrMatch[4] ?? "";
+        styleEl.setAttribute(attrName, attrVal);
+      }
+
+      currentParent.appendChild(styleEl);
+      continue;
+    }
+
+    if (match[3]) {
+      const closeTag = match[3].toLowerCase();
+      if (stack.length > 0) {
+        let foundIdx = -1;
+        for (let i = stack.length - 1; i >= 0; i--) {
+          const item = stack[i];
+          if (item && item.tagName.toLowerCase() === closeTag) {
+            foundIdx = i;
+            break;
+          }
+        }
+        if (foundIdx >= 0) {
+          stack.length = foundIdx;
+        }
+      }
+      continue;
+    }
+
+    if (match[4]) {
+      const rawTag = match[4];
+      const normalizedTag = rawTag.toLowerCase();
+      let attrsStr = match[5] || "";
+      let selfClosing = match[6] === "/";
+
+      if (!selfClosing && /\/\s*$/.test(attrsStr)) {
+        selfClosing = true;
+        attrsStr = attrsStr.replace(/\/\s*$/, "");
+      }
+
+      const parentNs = currentParent instanceof MockElement ? (currentParent.namespaceURI || defaultNamespace) : defaultNamespace;
+      const childNamespace =
+        normalizedTag === "svg" || parentNs === SVG_NAMESPACE
+          ? SVG_NAMESPACE
+          : HTML_NAMESPACE;
+
+      const el = new MockElement(rawTag, childNamespace);
+
+      const attrRegex = /([a-zA-Z0-9_:-]+)(?:=(?:"([^"]*)"|'([^']*)'|([^\s>]+)))?/g;
+      let attrMatch: RegExpExecArray | null;
+      while ((attrMatch = attrRegex.exec(attrsStr)) !== null) {
+        const attrName = attrMatch[1];
+        if (!attrName || attrName === "/") continue;
+        const attrVal = attrMatch[2] ?? attrMatch[3] ?? attrMatch[4] ?? "";
+        el.setAttribute(attrName, attrVal);
+      }
+
+      currentParent.appendChild(el);
+
+      if (!selfClosing && !VOID_HTML_TAGS.has(normalizedTag)) {
+        stack.push(el);
+      }
+    }
+  }
+}
