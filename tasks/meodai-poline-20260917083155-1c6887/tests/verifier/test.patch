+class MockHTMLElement extends MockElement {
+  public shadowRoot: MockShadowRoot | null = null;
+  constructor(tagName = "div") {
+    super(tagName, HTML_NAMESPACE);
+  }
+  attachShadow(_init?: { mode: string }): MockShadowRoot {
+    void _init;
+    this.shadowRoot = new MockShadowRoot();
+    this.shadowRoot.parentNode = this;
+    this.shadowRoot.isConnected = this.isConnected;
+    return this.shadowRoot;
+  }
+}
