diff --git a/src/picker-interaction.ts b/src/picker-interaction.ts
new file mode 100644
--- /dev/null
+++ b/src/picker-interaction.ts
@@ -0,0 +1,511 @@
+import { Poline, ColorPoint } from "./index";
+import {
+  svgscale,
+  UI_METRICS,
+  ROTARY_TURNS_TO_FULL,
+  ROTARY_TURNS_TO_FULL_SHIFT,
+  RingAdjustState,
+  PickerInteractionCallbacks,
+  pointToCartesian,
+} from "./picker-types";
+
+export class PickerInteraction {
+  private callbacks: PickerInteractionCallbacks;
+  private svg: SVGElement | null = null;
+  private getPoline: () => Poline | null;
+  private interactive = false;
+  private allowAddPoints = false;
+
+  private currentPoint: ColorPoint | null = null;
+  private ringAdjust: RingAdjustState | null = null;
+  private ringHoverIndex: number | null = null;
+  private activePointerId: number | null = null;
+  private interactionRevision = 0;
+  private bindingGeneration = 0;
+  private stalePointerIds: Set<number> = new Set<number>();
+
+  private boundPointerDown: ((e: PointerEvent) => void) | null = null;
+  private boundPointerMove: ((e: PointerEvent) => void) | null = null;
+  private boundPointerUp: ((e: PointerEvent) => void) | null = null;
+  private boundPointerCancel: ((e: PointerEvent) => void) | null = null;
+  private boundLostPointerCapture: ((e: PointerEvent) => void) | null = null;
+
+  constructor(
+    callbacks: PickerInteractionCallbacks,
+    getPoline: () => Poline | null
+  ) {
+    this.callbacks = callbacks;
+    this.getPoline = getPoline;
+  }
+
+  public setInteractive(interactive: boolean): void {
+    this.interactive = interactive;
+  }
+
+  public setAllowAddPoints(allow: boolean): void {
+    this.allowAddPoints = allow;
+  }
+
+  public getRingHoverIndex(): number | null {
+    return this.ringHoverIndex;
+  }
+
+  public getRingAdjust(): RingAdjustState | null {
+    return this.ringAdjust;
+  }
+
+  public getActivePointerId(): number | null {
+    return this.activePointerId;
+  }
+
+  public invalidatePendingOperations(): void {
+    this.interactionRevision++;
+  }
+
+  public cancelGesture(releaseCapture = true): void {
+    this.interactionRevision++;
+    const pointerId = this.activePointerId;
+    if (pointerId !== null) {
+      this.stalePointerIds.add(pointerId);
+    }
+    this.activePointerId = null;
+
+    if (releaseCapture && pointerId !== null && this.svg) {
+      try {
+        this.svg.releasePointerCapture(pointerId);
+      } catch {
+        // ignore
+      }
+    }
+    this.currentPoint = null;
+
+    if (this.ringAdjust) {
+      this.ringAdjust = null;
+      this.callbacks.onAdjustingChanged(false);
+    }
+
+    if (this.ringHoverIndex !== null) {
+      this.ringHoverIndex = null;
+      this.callbacks.onHoverChanged(null);
+    }
+  }
+
+  public bind(svg: SVGElement): void {
+    this.unbind();
+    this.svg = svg;
+    const currentGeneration = ++this.bindingGeneration;
+    const boundSvg = svg;
+
+    this.boundPointerDown = (e: PointerEvent) => {
+      if (
+        !this.interactive ||
+        this.svg !== boundSvg ||
+        this.bindingGeneration !== currentGeneration ||
+        (e.currentTarget && e.currentTarget !== boundSvg)
+      ) {
+        return;
+      }
+      this.handlePointerDown(e);
+    };
+
+    this.boundPointerMove = (e: PointerEvent) => {
+      if (
+        !this.interactive ||
+        this.svg !== boundSvg ||
+        this.bindingGeneration !== currentGeneration ||
+        (e.currentTarget && e.currentTarget !== boundSvg)
+      ) {
+        return;
+      }
+      this.handlePointerMove(e);
+    };
+
+    this.boundPointerUp = (e: PointerEvent) => {
+      if (
+        !this.interactive ||
+        this.svg !== boundSvg ||
+        this.bindingGeneration !== currentGeneration ||
+        (e.currentTarget && e.currentTarget !== boundSvg)
+      ) {
+        return;
+      }
+      this.handlePointerUp(e);
+    };
+
+    this.boundPointerCancel = (e: PointerEvent) => {
+      if (
+        !this.interactive ||
+        this.svg !== boundSvg ||
+        this.bindingGeneration !== currentGeneration ||
+        (e.currentTarget && e.currentTarget !== boundSvg)
+      ) {
+        return;
+      }
+      this.handlePointerCancel(e);
+    };
+
+    this.boundLostPointerCapture = (e: PointerEvent) => {
+      if (
+        !this.interactive ||
+        this.svg !== boundSvg ||
+        this.bindingGeneration !== currentGeneration ||
+        (e.currentTarget && e.currentTarget !== boundSvg)
+      ) {
+        return;
+      }
+      this.handleLostPointerCapture(e);
+    };
+
+    if (this.interactive) {
+      this.svg.addEventListener("pointerdown", this.boundPointerDown);
+      this.svg.addEventListener("pointermove", this.boundPointerMove);
+      this.svg.addEventListener("pointerup", this.boundPointerUp);
+      this.svg.addEventListener("pointercancel", this.boundPointerCancel);
+      this.svg.addEventListener(
+        "lostpointercapture",
+        this.boundLostPointerCapture
+      );
+    }
+  }
+
+  public unbind(): void {
+    this.interactionRevision++;
+    this.bindingGeneration++;
+    if (this.svg) {
+      if (this.boundPointerDown) {
+        this.svg.removeEventListener("pointerdown", this.boundPointerDown);
+      }
+      if (this.boundPointerMove) {
+        this.svg.removeEventListener("pointermove", this.boundPointerMove);
+      }
+      if (this.boundPointerUp) {
+        this.svg.removeEventListener("pointerup", this.boundPointerUp);
+      }
+      if (this.boundPointerCancel) {
+        this.svg.removeEventListener("pointercancel", this.boundPointerCancel);
+      }
+      if (this.boundLostPointerCapture) {
+        this.svg.removeEventListener(
+          "lostpointercapture",
+          this.boundLostPointerCapture
+        );
+      }
+      this.cancelGesture(true);
+      this.svg = null;
+    } else {
+      this.cancelGesture(true);
+    }
+  }
+
+  public handlePointerDown(e: PointerEvent): void {
+    if (!this.interactive || !this.svg) return;
+
+    // Preserving baseline behavior: stopPropagation is unconditionally called on pointerdown on interactive SVG
+    e.stopPropagation();
+
+    this.stalePointerIds.delete(e.pointerId);
+
+    // A second pointerdown must not overwrite an interaction already in progress
+    if (this.activePointerId !== null) return;
+
+    const poline = this.getPoline();
+    if (!poline) return;
+
+    const { normalizedX, normalizedY } = this.pointerToNormalizedCoordinates(e);
+
+    // Check if we're clicking on a ring (outer band of an anchor)
+    // Skip on touch devices
+    const isTouch = window.matchMedia("(pointer: coarse)").matches;
+    const ringHit = isTouch
+      ? null
+      : this.pickRing(normalizedX, normalizedY, poline);
+
+    if (ringHit !== null) {
+      const anchor = poline.anchorPoints[ringHit];
+      if (!anchor) return;
+
+      const cartesian = pointToCartesian(anchor);
+      if (!cartesian) return;
+
+      const [anchorX, anchorY] = cartesian;
+      const svgX = normalizedX * svgscale;
+      const svgY = normalizedY * svgscale;
+
+      const startAngle = Math.atan2(svgY - anchorY, svgX - anchorX);
+
+      this.ringAdjust = {
+        anchorIndex: ringHit,
+        currentSaturation: anchor.color[1],
+        prevAngle: startAngle,
+      };
+
+      this.activePointerId = e.pointerId;
+      this.ringHoverIndex = ringHit;
+      this.callbacks.onAdjustingChanged(true);
+      this.callbacks.onHoverChanged(ringHit);
+
+      try {
+        this.svg.setPointerCapture(e.pointerId);
+      } catch {
+        // ignore
+      }
+      return;
+    }
+
+    // Check if we're clicking on an anchor core
+    const closestAnchor = poline.getClosestAnchorPoint({
+      xyz: [normalizedX, normalizedY, null],
+      maxDistance: 0.05,
+    });
+
+    if (closestAnchor) {
+      this.currentPoint = closestAnchor;
+      this.activePointerId = e.pointerId;
+      try {
+        this.svg.setPointerCapture(e.pointerId);
+      } catch {
+        // ignore
+      }
+    } else if (this.allowAddPoints) {
+      const revision = this.interactionRevision;
+      const gen = this.bindingGeneration;
+      const svg = this.svg;
+      const polineBefore = this.getPoline();
+      const point = this.callbacks.onPointAdded(normalizedX, normalizedY);
+
+      if (
+        revision !== this.interactionRevision ||
+        gen !== this.bindingGeneration ||
+        svg !== this.svg ||
+        polineBefore !== this.getPoline() ||
+        this.activePointerId !== null ||
+        !point
+      ) {
+        this.stalePointerIds.add(e.pointerId);
+        return;
+      }
+
+      this.currentPoint = point;
+      this.activePointerId = e.pointerId;
+      try {
+        svg.setPointerCapture(e.pointerId);
+      } catch {
+        // ignore
+      }
+    }
+  }
+
+  public handlePointerMove(e: PointerEvent): void {
+    if (!this.interactive || !this.svg) return;
+
+    if (this.stalePointerIds.has(e.pointerId)) {
+      return;
+    }
+
+    // Movement from a non-active pointer must not modify an anchor, saturation, or interaction state
+    if (this.activePointerId !== null && e.pointerId !== this.activePointerId) {
+      return;
+    }
+
+    const poline = this.getPoline();
+    if (!poline) return;
+
+    const { normalizedX, normalizedY } = this.pointerToNormalizedCoordinates(e);
+
+    // Handle ring adjustment (rotary drag)
+    if (this.ringAdjust) {
+      const anchor = poline.anchorPoints[this.ringAdjust.anchorIndex];
+      if (!anchor) return;
+
+      const cartesian = pointToCartesian(anchor);
+      if (!cartesian) return;
+
+      const [anchorX, anchorY] = cartesian;
+      const svgX = normalizedX * svgscale;
+      const svgY = normalizedY * svgscale;
+
+      const curAngle = Math.atan2(svgY - anchorY, svgX - anchorX);
+
+      // Calculate delta angle, normalized to [-PI, PI]
+      let dA = curAngle - this.ringAdjust.prevAngle;
+      if (dA > Math.PI) dA -= Math.PI * 2;
+      else if (dA < -Math.PI) dA += Math.PI * 2;
+
+      this.ringAdjust.prevAngle = curAngle;
+
+      if (dA === 0) return;
+
+      // Incremental saturation delta calculation:
+      // avoids jumps when Shift key is pressed or released mid-gesture
+      const turnsToFull = e.shiftKey
+        ? ROTARY_TURNS_TO_FULL_SHIFT
+        : ROTARY_TURNS_TO_FULL;
+      const deltaSat = dA / (Math.PI * 2) / turnsToFull;
+
+      // Calculate new saturation clamped to [0, 1]
+      let newSaturation = this.clamp01(
+        this.ringAdjust.currentSaturation + deltaSat
+      );
+
+      // Snap rules:
+      // When moving towards 1 (deltaSat > 0), snap values > 0.99 to 1.
+      // When moving towards 0 (deltaSat < 0), snap values < 0.01 to 0.
+      if (deltaSat > 0 && newSaturation > 0.99) {
+        newSaturation = 1;
+      } else if (deltaSat < 0 && newSaturation < 0.01) {
+        newSaturation = 0;
+      }
+
+      this.ringAdjust.currentSaturation = newSaturation;
+
+      // Do not update model or dispatch change events if value didn't change
+      if (anchor.color[1] === newSaturation) {
+        return;
+      }
+
+      this.callbacks.onAnchorSaturationChanged(anchor, newSaturation);
+      return;
+    }
+
+    // Handle anchor point dragging
+    if (this.currentPoint) {
+      if (
+        normalizedX === this.currentPoint.x &&
+        normalizedY === this.currentPoint.y
+      ) {
+        return;
+      }
+      this.callbacks.onAnchorMoved(this.currentPoint, normalizedX, normalizedY);
+      return;
+    }
+
+    // Handle ring hover detection when no interaction is active (skip on touch devices)
+    if (!window.matchMedia("(pointer: coarse)").matches) {
+      const ringHover = this.pickRing(normalizedX, normalizedY, poline);
+      if (ringHover !== this.ringHoverIndex) {
+        this.ringHoverIndex = ringHover;
+        this.callbacks.onHoverChanged(ringHover);
+      }
+    }
+  }
+
+  public handlePointerUp(e: PointerEvent): void {
+    if (!this.interactive || !this.svg) return;
+
+    if (this.stalePointerIds.has(e.pointerId)) {
+      this.stalePointerIds.delete(e.pointerId);
+      return;
+    }
+
+    // If an interaction is active, only the active pointer may end it and release capture
+    if (this.activePointerId !== null) {
+      if (e.pointerId !== this.activePointerId) {
+        return;
+      }
+      try {
+        this.svg.releasePointerCapture(this.activePointerId);
+      } catch {
+        // ignore
+      }
+      this.activePointerId = null;
+    }
+
+    if (this.ringAdjust) {
+      this.ringAdjust = null;
+      this.callbacks.onAdjustingChanged(false);
+    }
+
+    this.currentPoint = null;
+
+    // Re-check hover state after release
+    const poline = this.getPoline();
+    if (poline && !window.matchMedia("(pointer: coarse)").matches) {
+      const { normalizedX, normalizedY } =
+        this.pointerToNormalizedCoordinates(e);
+      const ringHover = this.pickRing(normalizedX, normalizedY, poline);
+      if (ringHover !== this.ringHoverIndex) {
+        this.ringHoverIndex = ringHover;
+        this.callbacks.onHoverChanged(ringHover);
+      }
+    }
+  }
+
+  public handlePointerCancel(e: PointerEvent): void {
+    if (!this.interactive || !this.svg) return;
+
+    if (this.stalePointerIds.has(e.pointerId)) {
+      this.stalePointerIds.delete(e.pointerId);
+      return;
+    }
+
+    // If an interaction is active, only the active pointer may cancel it and release capture
+    if (this.activePointerId !== null && e.pointerId !== this.activePointerId) {
+      return;
+    }
+
+    this.cancelGesture();
+  }
+
+  public handleLostPointerCapture(e: PointerEvent): void {
+    if (this.stalePointerIds.has(e.pointerId)) {
+      this.stalePointerIds.delete(e.pointerId);
+      return;
+    }
+
+    if (this.activePointerId === null || e.pointerId !== this.activePointerId) {
+      return;
+    }
+
+    this.cancelGesture(false);
+  }
+
+  public pickRing(
+    normalizedX: number,
+    normalizedY: number,
+    poline: Poline
+  ): number | null {
+    const svgX = normalizedX * svgscale;
+    const svgY = normalizedY * svgscale;
+
+    for (let i = 0; i < poline.anchorPoints.length; i++) {
+      const anchor = poline.anchorPoints[i];
+      if (!anchor) continue;
+
+      const cartesian = pointToCartesian(anchor);
+      if (!cartesian) continue;
+
+      const [cx, cy] = cartesian;
+      const dist = Math.hypot(svgX - cx, svgY - cy);
+
+      // Check if within ring zone (between anchor radius and outer ring radius)
+      if (
+        dist > UI_METRICS.anchorRadius &&
+        dist <= UI_METRICS.ringOuterRadius
+      ) {
+        return i;
+      }
+    }
+
+    return null;
+  }
+
+  public pointerToNormalizedCoordinates(e: PointerEvent): {
+    normalizedX: number;
+    normalizedY: number;
+  } {
+    if (!this.svg) {
+      return { normalizedX: 0, normalizedY: 0 };
+    }
+    const svgRect = this.svg.getBoundingClientRect();
+    const svgX = ((e.clientX - svgRect.left) / svgRect.width) * svgscale;
+    const svgY = ((e.clientY - svgRect.top) / svgRect.height) * svgscale;
+    return {
+      normalizedX: svgX / svgscale,
+      normalizedY: svgY / svgscale,
+    };
+  }
+
+  private clamp01(value: number): number {
+    return Math.max(0, Math.min(1, value));
+  }
+}
diff --git a/src/picker-types.ts b/src/picker-types.ts
new file mode 100644
--- /dev/null
+++ b/src/picker-types.ts
@@ -0,0 +1,44 @@
+import { ColorPoint } from "./index";
+
+export const namespaceURI = "http://www.w3.org/2000/svg";
+export const svgscale = 100;
+
+// UI metrics for the saturation ring control (in SVG units)
+export const UI_METRICS = {
+  anchorRadius: 2, // Core anchor point radius
+  ringOuterRadius: 5, // Outer radius of the ring interaction zone
+  ringThickness: 1, // Visual thickness of the saturation arc
+  ringThicknessHover: 2, // Thickness when hovered
+  ringGap: 0.5, // Gap between anchor and ring
+  tickLength: 1.5, // Length of the tick at end of arc (pointing outward)
+  tickGap: 0.5, // Gap between ring and tick
+};
+
+// Rotary interaction sensitivity
+export const ROTARY_TURNS_TO_FULL = 1.0; // 1 full turn = full saturation range
+export const ROTARY_TURNS_TO_FULL_SHIFT = 2.5; // With shift: slower adjustment
+
+export type RingAdjustState = {
+  anchorIndex: number;
+  currentSaturation: number;
+  prevAngle: number;
+};
+
+export interface PickerInteractionCallbacks {
+  onAnchorMoved: (
+    point: ColorPoint,
+    normalizedX: number,
+    normalizedY: number
+  ) => void;
+  onAnchorSaturationChanged: (point: ColorPoint, newSaturation: number) => void;
+  onPointAdded: (normalizedX: number, normalizedY: number) => ColorPoint | null;
+  onHoverChanged: (hoverIndex: number | null) => void;
+  onAdjustingChanged: (isAdjusting: boolean) => void;
+}
+
+export function pointToCartesian(point: ColorPoint): [number, number] {
+  const half = svgscale / 2;
+  const x = half + (point.x - 0.5) * svgscale;
+  const y = half + (point.y - 0.5) * svgscale;
+  return [x, y];
+}
diff --git a/src/picker-view.ts b/src/picker-view.ts
new file mode 100644
--- /dev/null
+++ b/src/picker-view.ts
@@ -0,0 +1,405 @@
+import { Poline, ColorPoint } from "./index";
+import {
+  namespaceURI,
+  svgscale,
+  UI_METRICS,
+  pointToCartesian,
+} from "./picker-types";
+
+export class PickerView {
+  private svg: SVGElement | null = null;
+  private line: SVGPolylineElement | null = null;
+  private wheel: SVGGElement | null = null;
+  private anchors: SVGGElement | null = null;
+  private points: SVGGElement | null = null;
+  private saturationRings: SVGGElement | null = null;
+  private pickerDiv: HTMLElement | null = null;
+  private shadowRoot: ShadowRoot | null = null;
+
+  private hoverIndex: number | null = null;
+  private activeAdjustIndex: number | null = null;
+
+  public init(shadowRoot: ShadowRoot): void {
+    this.shadowRoot = shadowRoot;
+    this.render();
+  }
+
+  public getSvgElement(): SVGElement | null {
+    return this.svg;
+  }
+
+  public updateLightnessBackground(poline: Poline | null): void {
+    if (!this.pickerDiv || !poline) return;
+    if (poline.invertedLightness) {
+      this.pickerDiv.style.setProperty("--maxL", "#000");
+      this.pickerDiv.style.setProperty("--minL", "#fff");
+    } else {
+      this.pickerDiv.style.setProperty("--maxL", "#fff");
+      this.pickerDiv.style.setProperty("--minL", "#000");
+    }
+  }
+
+  public setRingHover(index: number | null): void {
+    this.hoverIndex = index;
+    if (!this.saturationRings) return;
+    const ringGroups = Array.from(
+      this.saturationRings.querySelectorAll(".wheel__ring-group")
+    ) as SVGGElement[];
+    ringGroups.forEach((group, i) => {
+      const isHovered = i === this.hoverIndex || i === this.activeAdjustIndex;
+      group.classList.toggle("wheel__ring-group--hover", !!isHovered);
+    });
+  }
+
+  public setRingAdjusting(
+    isAdjusting: boolean,
+    index: number | null = null
+  ): void {
+    this.activeAdjustIndex = isAdjusting ? index : null;
+    this.setRingHover(this.hoverIndex);
+  }
+
+  public cleanup(): void {
+    this.hoverIndex = null;
+    this.activeAdjustIndex = null;
+    if (this.saturationRings) {
+      const ringGroups = Array.from(
+        this.saturationRings.querySelectorAll(".wheel__ring-group")
+      ) as SVGGElement[];
+      ringGroups.forEach((group) => {
+        group.classList.remove("wheel__ring-group--hover");
+      });
+    }
+  }
+
+  public updateSVG(poline: Poline | null): void {
+    if (!poline || !this.svg || !this.line || !this.anchors || !this.points) {
+      return;
+    }
+
+    this.updateLightnessBackground(poline);
+
+    // 1) Draw line paths
+    const flattenedPoints = poline.flattenedPoints;
+    const pathPoints = flattenedPoints
+      .map((p) => {
+        const cartesian = pointToCartesian(p);
+        if (!cartesian) return "";
+        const [x, y] = cartesian;
+        return `${x},${y}`;
+      })
+      .filter((point) => point !== "")
+      .join(" ");
+
+    this.line.setAttribute("points", pathPoints);
+
+    // Helper to update or create circles efficiently
+    const updateCircles = (
+      container: SVGGElement,
+      points: ColorPoint[],
+      className: string,
+      radiusFn: (p: ColorPoint) => number
+    ) => {
+      const existing = container.children;
+
+      // Remove excess elements if we have fewer points than before
+      while (existing.length > points.length) {
+        const last = existing[existing.length - 1];
+        if (last) container.removeChild(last);
+      }
+
+      points.forEach((point, i) => {
+        let circle = existing[i] as SVGCircleElement;
+        const cartesian = pointToCartesian(point);
+        if (!cartesian) return;
+
+        const [x = 0, y = 0] = cartesian;
+        const r = radiusFn(point);
+        const fill = point.hslCSS;
+
+        // Create if doesn't exist
+        if (!circle) {
+          circle = document.createElementNS(namespaceURI, "circle");
+          circle.setAttribute("class", className);
+          container.appendChild(circle);
+        }
+
+        // Update attributes
+        circle.setAttribute("cx", x.toString());
+        circle.setAttribute("cy", y.toString());
+        circle.setAttribute("r", r.toString());
+        circle.setAttribute("fill", fill);
+      });
+    };
+
+    // 2) Draw saturation rings around anchor points
+    this.updateSaturationRings(poline);
+
+    // 3) Draw anchor points (white dots at the ends)
+    updateCircles(
+      this.anchors,
+      poline.anchorPoints,
+      "wheel__anchor",
+      () => UI_METRICS.anchorRadius
+    );
+
+    // 4) Draw intermediate points (sample dots along the lines) - TOP layer
+    updateCircles(
+      this.points,
+      flattenedPoints,
+      "wheel__point",
+      (p) => 0.5 + p.color[1]
+    );
+  }
+
+  public updateSaturationRings(poline: Poline): void {
+    const saturationRings = this.saturationRings;
+    if (!poline || !saturationRings) return;
+
+    const anchors = poline.anchorPoints;
+    const ringGroups = Array.from(
+      saturationRings.querySelectorAll(".wheel__ring-group")
+    ) as SVGGElement[];
+
+    // Remove excess groups
+    while (ringGroups.length > anchors.length) {
+      const last = ringGroups.pop();
+      if (last) last.remove();
+    }
+
+    anchors.forEach((anchor, i) => {
+      const cartesian = pointToCartesian(anchor);
+      if (!cartesian) return;
+
+      const [cx, cy] = cartesian;
+      const saturation = anchor.z;
+      const ringRadius = UI_METRICS.anchorRadius + UI_METRICS.ringGap + 1;
