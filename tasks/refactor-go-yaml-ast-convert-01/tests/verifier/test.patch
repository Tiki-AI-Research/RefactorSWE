index 0000000..c447c4f
--- /dev/null
+++ b/tests/p2p_decode_test.go
@@ -0,0 +1,95 @@
+package p2p_test
+
+import (
+	"reflect"
+	"testing"
+
+	yaml "github.com/goccy/go-yaml"
+	p2p "github.com/goccy/go-yaml/tests"
+)
+
+// TestDecodeValueSnapshot pins successful decode outcomes for tag, anchor,
+// alias, merge, scalar and container inputs, including wrapped (anchored,
+// aliased and tagged) mapping keys.
+func TestDecodeValueSnapshot(t *testing.T) {
+	assertAnchorRebinding(t)
+	assertInternalWork(t, "decode")
+	fx := loadFixture(t)
+	var want map[string]p2p.DecodeValueRecord
+	fixtureValue(t, fx, "decode_values", &want)
+
+	got, err := p2p.DecodeValueRecords()
+	check(t, err)
+	for _, c := range p2p.DecodeValueCases {
+		expected, ok := want[c.Name]
+		if !ok {
+			t.Fatalf("fixture has no decode_values entry for %q", c.Name)
+		}
+		if got[c.Name] != expected {
+			t.Fatalf("%s: decode mismatch:\nwant value=%q error=%q\ngot  value=%q error=%q",
+				c.Name, expected.Value, expected.Error, got[c.Name].Value, got[c.Name].Error)
+		}
+	}
+}
+
+// Rebinding a scalar must replace its cached value, not just its AST target.
+// Mapping and recursive controls distinguish this from a blanket cache reset.
+func assertAnchorRebinding(t *testing.T) {
+	t.Helper()
+	for _, tc := range []struct {
+		name, source string
+		want         map[string]interface{}
+	}{
+		{"scalar", "a: &x 1\nb: &x 2\nc: *x\n", map[string]interface{}{"a": uint64(1), "b": uint64(2), "c": uint64(2)}},
+		{"mapping", "a: &x {k: 1}\nb: &x {k: 2}\nc: *x\n", map[string]interface{}{"a": map[string]interface{}{"k": uint64(1)}, "b": map[string]interface{}{"k": uint64(2)}, "c": map[string]interface{}{"k": uint64(2)}}},
+		{"recursive", "a: &x [*x]\nb: *x\n", map[string]interface{}{"a": []interface{}{nil}, "b": []interface{}{nil}}},
+	} {
+		t.Run("anchor_rebinding_"+tc.name, func(t *testing.T) {
+			// Decode through the interface{} entry point: typed-map decoding may
+			// revisit scalars and accidentally hide a stale generic-value cache.
+			var got interface{}
+			if err := yaml.Unmarshal([]byte(tc.source), &got); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(got, tc.want) {
+				t.Fatalf("anchor binding: got %#v, want %#v", got, tc.want)
+			}
+		})
+	}
+}
+
+// TestDecodeErrorSnapshot pins failing decode outcomes: the exact error text
+// and the error value classification for unresolved aliases, malformed tags,
+// duplicate keys and invalid merge inputs.
+func TestDecodeErrorSnapshot(t *testing.T) {
+	fx := loadFixture(t)
+	var want map[string]p2p.DecodeErrorRecord
+	fixtureValue(t, fx, "decode_errors", &want)
+
+	got, err := p2p.DecodeErrorRecords()
+	check(t, err)
+	for _, c := range p2p.DecodeErrorCases {
+		expected, ok := want[c.Name]
+		if !ok {
+			t.Fatalf("fixture has no decode_errors entry for %q", c.Name)
+		}
+		if got[c.Name] != expected {
+			t.Fatalf("%s: decode error mismatch:\nwant %+v\ngot  %+v", c.Name, expected, got[c.Name])
+		}
+	}
+}
+
+// TestDecodeDepthLimitSentinel pins the depth-limit sentinel: decoding a
+// document nested beyond the internal limit must return ErrExceededMaxDepth
+// (identifiable with errors.Is) and the same error text.
+func TestDecodeDepthLimitSentinel(t *testing.T) {
+	fx := loadFixture(t)
+	var want p2p.DepthLimitRecord
+	fixtureValue(t, fx, "depth_limit", &want)
+
+	got, err := p2p.DepthLimitRecords()
+	check(t, err)
+	if got != want {
+		t.Fatalf("depth limit mismatch: want %+v got %+v", want, got)
+	}
+}
