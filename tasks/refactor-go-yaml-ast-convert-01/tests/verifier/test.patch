@@ -0,0 +1,596 @@
+#!/usr/bin/env python3
+"""Execute declared P2P test selectors with the Go toolchain and emit JUnit.
+
+The runner executes exactly the frozen P2P selectors and writes a conventional
+JUnit XML report to {report}. Selector input is the pipeline-materialized asset
+whenever it can be resolved: the `--select` argument ({p2p_select}), an
+environment key such as `P2P_SELECT`, a well-known `p2p_select.txt` location, or
+a verifier config that declares the selector list. Only when none of those
+assets can be resolved does the runner fall back to the frozen catalog embedded
+below (identical to this plan's declared `p2p` selectors), so the report
+mechanism stays self-contained inside the repository. It never installs
+anything and never touches the network: only repo files and the frozen image
+toolchain are used.
+"""
+
+from __future__ import annotations
+
+import argparse
+import atexit
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+
+def fail(message: str, code: int = 2) -> "None":
+    sys.stderr.write("p2p_junit_runner: %s\n" % message)
+    raise SystemExit(code)
+
+
+def find_go() -> str:
+    go = shutil.which("go")
+    if go:
+        return go
+    for candidate in (
+        "/opt/envpipe/runtime/bin/go",
+        "/usr/local/go/bin/go",
+        "/usr/lib/go/bin/go",
+        "/usr/lib/go-1.21/bin/go",
+    ):
+        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    fail("go toolchain not found on PATH or in known image locations")
+
+
+DECLARED_SELECTORS = (
+    "tests/p2p_traversal_test.go::TestWalkVisitOrderSnapshot",
+    "tests/p2p_traversal_test.go::TestParentIdentitySnapshot",
+    "tests/p2p_traversal_test.go::TestFilterOrderSnapshot",
+    "tests/p2p_traversal_test.go::TestFilterFileSnapshot",
+    "tests/p2p_traversal_test.go::TestVisitorProtocolCalls",
+    "tests/p2p_traversal_test.go::TestWalkVisitsEachNodeOnce",
+    "tests/p2p_nodes_test.go::TestNodeMethodsForEveryNodeKind",
+    "tests/p2p_nodes_test.go::TestFormatOutputSnapshot",
+    "tests/p2p_decode_test.go::TestDecodeValueSnapshot",
+    "tests/p2p_decode_test.go::TestDecodeErrorSnapshot",
+    "tests/p2p_decode_test.go::TestDecodeDepthLimitSentinel",
+    "tests/p2p_path_test.go::TestPathFilterSnapshot",
+    "tests/p2p_path_test.go::TestPathReplaceSnapshot",
+    "tests/p2p_integrity_test.go::TestExportedAPISurfacePreserved",
+    "tests/p2p_integrity_test.go::TestModuleDependencyGraphUnchanged",
+    "parser/parser_test.go::TestParser",
+    "parser/parser_test.go::TestParseEmptyDocument",
+    "parser/parser_test.go::TestParseComplicatedDocument",
+    "parser/parser_test.go::TestParseWhitespace",
+    "parser/parser_test.go::TestNewLineChar",
+    "parser/parser_test.go::TestSyntaxError",
+    "parser/parser_test.go::TestComment",
+    "parser/parser_test.go::TestCommentWithNull",
+    "parser/parser_test.go::TestSequenceComment",
+    "parser/parser_test.go::TestCommentWithMap",
+    "parser/parser_test.go::TestInFlowStyle",
+    "parser/parser_test.go::TestNodePath",
+    "decode_test.go::TestDecodeWithMergeKey",
+    "decode_test.go::TestDecoder_UnmarshalYAMLWithAlias",
+    "decode_test.go::TestDecoder_DecodeWithAnchorAnyValue",
+    "decode_test.go::TestDecoder_SiblingAnchorAlias",
+    "decode_test.go::TestDecoder_AnchorInUnmappedField",
+    "decode_test.go::TestRoundtripAnchorAlias",
+    "decode_test.go::TestDecodeWithSameAnchor",
+    "decode_test.go::TestSetNullValue",
+    "decode_test.go::TestIssue735",
+    "decode_test.go::TestDecode_Literal",
+    "decode_test.go::TestDecoder_LiteralWithNewLine",
+    "decode_test.go::TestDecoder_DecodeWithNode",
+    "decode_test.go::TestIssue617",
+    "decode_test.go::TestBytesUnmarshalerWithMapAlias",
+    "decode_test.go::TestDecoder_AnchorReferenceDirs",
+    "fuzz_test.go::FuzzUnmarshalToMap",
+    "yaml_test_suite_test.go::TestYAMLTestSuite",
+    "yaml_test.go::TestSmartAnchor",
+    "printer/printer_test.go::Test_Printer",
+    "printer/printer_test.go::TestPrinter_Anchor",
+    "printer/printer_test.go::Test_Printer_Multiline",
+    "encode_test.go::TestTagMarshalling",
+    "encode_test.go::TestIssue356",
+    "encode_test.go::TestMarshalIndentWithMultipleText",
+    "encode_test.go::TestEncodeWithAnchorAndAlias",
+    "encode_test.go::TestEncoder_MarshalAnchor",
+    "encode_test.go::TestIssue259",
+    "encode_test.go::TestEncoder_Flow",
+    "yaml_test.go::TestRoundTripWithComment",
+    "yaml_test.go::TestStreamDecodingWithComment",
+    "path_test.go::TestPathBuilder",
+    "path_test.go::TestPath",
+    "path_test.go::TestPath_FilterFile",
+    "path_test.go::TestPath_ReservedKeyword",
+    "path_test.go::TestPath_Invalid",
+    "path_test.go::TestPath_ReadNode",
+    "path_test.go::TestPath_Merge",
+    "path_test.go::TestPath_Replace",
+    "path_test.go::TestInvalidPath",
+)
+
+SELECTOR_ENV_KEYS = (
+    "P2P_SELECT",
+    "P2P_SELECT_FILE",
+    "P2P_SELECTORS",
+    "VERIFIER_P2P_SELECT",
+    "P2P_SELECT_PATH",
+)
+
+SELECTOR_FILE_NAMES = ("p2p_select.txt", "p2p_select")
+
+PLACEHOLDER_RE = re.compile(r"^\{[^{}]+\}$")
+
+
+class SelectorError(RuntimeError):
+    """Raised when a selector source is unreadable or malformed."""
+
+
+def find_repo_root() -> Path:
+    script_dir = Path(__file__).resolve().parent
+    for base in (script_dir, Path.cwd()):
+        for candidate in (base,) + tuple(base.parents):
+            if (candidate / "go.mod").is_file():
+                return candidate
+    return script_dir.parent
+
+
+def parse_selector_text(text: str):
+    selectors = []
+    seen = set()
+    for raw in text.splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        if "::" not in line:
+            raise SelectorError("invalid selector (missing '::'): %r" % line)
+        file_part, leaf = line.split("::", 1)
+        if not file_part.strip() or not leaf.strip():
+            raise SelectorError("invalid selector: %r" % line)
+        if line in seen:
+            continue
+        seen.add(line)
+        selectors.append(line)
+    if not selectors:
+        raise SelectorError("selector source contains no selectors")
+    return selectors
+
+
+def read_selector_file(path: Path):
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as exc:
+        raise SelectorError("cannot read selector file %s: %s" % (path, exc))
+    return parse_selector_text(text)
+
+
+def collect_json_selectors(value):
+    found = []
+    if isinstance(value, str):
+        if "::" in value:
+            found.append(value.strip())
+    elif isinstance(value, list):
+        for item in value:
+            found.extend(collect_json_selectors(item))
+    elif isinstance(value, dict):
+        for key in ("p2p_select", "p2p_selectors", "selectors", "tests", "p2p"):
+            if key in value:
+                found.extend(collect_json_selectors(value[key]))
+        if not found:
+            for item in value.values():
+                found.extend(collect_json_selectors(item))
+    deduped = []
+    seen = set()
+    for selector in found:
+        if selector and selector not in seen:
+            seen.add(selector)
+            deduped.append(selector)
+    return deduped
+
+
+def read_selector_config(path: Path):
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise SelectorError("cannot read selector config %s: %s" % (path, exc))
+    selectors = collect_json_selectors(data)
+    if not selectors:
+        raise SelectorError("selector config %s declares no selectors" % path)
+    return selectors
+
+
+def resolve_selectors(explicit: str, root: Path, script_dir: Path, warn) -> list:
+    file_candidates = []
+    explicit = (explicit or "").strip()
+    if explicit and not PLACEHOLDER_RE.match(explicit):
+        file_candidates.append(Path(explicit))
+    for key in SELECTOR_ENV_KEYS:
+        value = os.environ.get(key, "").strip()
+        if value and not PLACEHOLDER_RE.match(value):
+            file_candidates.append(Path(value))
+    config_candidates = []
+    seen_bases = set()
+    for base in (
+        script_dir,
+        root,
+        root / "verifier",
+        Path.cwd(),
+        Path("/workspace/verifier"),
+        Path("/verifier"),
+    ):
+        base = Path(os.path.abspath(str(base)))
+        if base in seen_bases:
+            continue
+        seen_bases.add(base)
+        for name in SELECTOR_FILE_NAMES:
+            file_candidates.append(base / name)
+        config_candidates.append(base / "config.json")
+    for path in file_candidates:
+        if path.is_file():
+            try:
+                return read_selector_file(path)
+            except SelectorError as exc:
+                warn(str(exc))
+    declared = set(DECLARED_SELECTORS)
+    for path in config_candidates:
+        if path.is_file():
+            try:
+                selectors = read_selector_config(path)
+            except SelectorError as exc:
+                warn(str(exc))
+                continue
+            if declared <= set(selectors):
+                return selectors
+            warn("selector config %s does not cover the declared selectors" % path)
+    warn("using the frozen embedded selector catalog (%d selectors)" % len(DECLARED_SELECTORS))
+    return list(DECLARED_SELECTORS)
+
+
+def run_pattern(leaf: str) -> str:
+    parts = leaf.split("/")
+    return "/".join("^(%s)$" % re.escape(part) for part in parts)
+
+
+EXEC_PROBE_TEXT = "#!/bin/sh\nexit 0\n"
+
+
+def probe_exec(base: Path) -> bool:
+    """Return True when a file created in base can actually be executed.
+
+    A noexec mount is invisible to os.access(), so the only reliable probe is
+    to write a trivial script and run it from the candidate directory.
+    """
+    try:
+        base.mkdir(parents=True, exist_ok=True)
+    except OSError:
+        return False
+    probe = base / ("exec-probe-%d.sh" % os.getpid())
+    try:
+        probe.write_text(EXEC_PROBE_TEXT, encoding="utf-8")
+        os.chmod(str(probe), 0o755)
+        proc = subprocess.run(
+            [str(probe)],
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            timeout=15,
+        )
+        return proc.returncode == 0
+    except (OSError, subprocess.SubprocessError):
+        return False
+    finally:
+        try:
+            probe.unlink()
+        except OSError:
+            pass
+
+
+def resolve_exec_root(tmp_root: Path, warn) -> Path:
+    """Pick a directory in which the compiled test binary can be executed.
+
+    `go test` executes the test binary it builds, so that binary must be
+    written to an exec-capable directory: the pipeline-provided
+    VERIFIER_EXEC_DIR when require_exec is declared, otherwise the first
+    usable candidate. General temporary data (build cache, module cache)
+    still lives under TMPDIR.
+    """
+    candidates = []
+    exec_dir = (os.environ.get("VERIFIER_EXEC_DIR") or "").strip()
+    if exec_dir and not PLACEHOLDER_RE.match(exec_dir):
+        candidates.append((Path(exec_dir), "VERIFIER_EXEC_DIR"))
+    candidates.append((Path(tmp_root), "TMPDIR"))
+    for fallback in ("/tmp", "/var/tmp", "/run"):
+        candidates.append((Path(fallback), fallback))
+    try:
+        candidates.append((Path.home(), "$HOME"))
+    except (RuntimeError, KeyError):
+        pass
+    for base, label in candidates:
+        if probe_exec(base):
+            if exec_dir and label != "VERIFIER_EXEC_DIR":
+                warn("VERIFIER_EXEC_DIR %s is not exec-capable; using %s" % (exec_dir, base))
+            return base
+    warn("no exec-capable temporary directory could be verified; using TMPDIR")
+    return Path(tmp_root)
+
+
+def go_env(tmp_root: Path, exec_root: Path) -> tuple:
+    env = dict(os.environ)
+    env.setdefault("GO111MODULE", "on")
+    env["GOTOOLCHAIN"] = "local"
+    env["GOPROXY"] = "off"
+    env["GOFLAGS"] = "-mod=readonly"
+    env["GOWORK"] = "off"
+    cache = tmp_root / "go-build-cache"
+    gopath = tmp_root / "go-path"
+    cache.mkdir(parents=True, exist_ok=True)
+    (gopath / "pkg" / "mod").mkdir(parents=True, exist_ok=True)
+    work = exec_root / ("p2p-go-work-%d" % os.getpid())
+    work.mkdir(parents=True, exist_ok=True)
+    env["GOCACHE"] = str(cache)
+    env["GOPATH"] = str(gopath)
+    env["GOMODCACHE"] = str(gopath / "pkg" / "mod")
+    env["GOTMPDIR"] = str(work)
+    env["CGO_ENABLED"] = "0"
+    return env, work
+
+
+class PackageRun:
+    def __init__(self, pkg_dir: str):
+        self.pkg_dir = pkg_dir
+        self.results = {}  # test name -> (status, seconds, output)
+        self.build_output = []
+        self.build_failed = False
+        self.process_error = ""
+        self.elapsed = 0.0
+
+
+def run_package(go: str, root: Path, env: dict, pkg_dir: str, leaves, timeout: int) -> PackageRun:
+    run = PackageRun(pkg_dir)
+    pattern = "^(" + "|".join(re.escape(leaf) for leaf in sorted(set(leaves))) + ")$"
+    cmd = [
+        go,
+        "test",
+        "-json",
+        "-count=1",
+        "-timeout",
+        "%ds" % max(timeout - 30, 30),
+        "-run",
+        pattern,
+        "./" + pkg_dir if pkg_dir not in ("", ".") else ".",
+    ]
+    started = time.time()
+    try:
+        proc = subprocess.run(
+            cmd,
+            cwd=str(root),
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        run.process_error = "go test timed out after %ds" % timeout
+        return run
+    except OSError as exc:
+        run.process_error = "cannot execute go test: %s" % exc
+        return run
+
+    stderr = proc.stderr.decode("utf-8", "replace")
+    if stderr.strip():
+        run.build_output.append(stderr.strip())
+
+    decoder = json.JSONDecoder()
+    stdout = proc.stdout.decode("utf-8", "replace")
+    idx = 0
+    length = len(stdout)
+    events = []
+    while idx < length:
+        while idx < length and stdout[idx] in " \t\r\n":
+            idx += 1
+        if idx >= length:
+            break
+        try:
+            obj, end = decoder.raw_decode(stdout, idx)
+        except ValueError:
+            break
+        events.append(obj)
+        idx = end
+
+    for ev in events:
+        action = ev.get("Action")
+        name = ev.get("Test")
+        out = ev.get("Output", "")
+        if not name:
+            if action in ("build-output", "build-fail"):
+                if out.strip():
+                    run.build_output.append(out.rstrip("\n"))
+                if action == "build-fail":
+                    run.build_failed = True
+                continue
+            if action == "output" and out.strip() and not out.startswith("=== RUN") and not out.startswith("ok ") and not out.startswith("FAIL"):
+                run.build_output.append(out.rstrip("\n"))
+            continue
+        entry = run.results.setdefault(name, {"status": None, "output": [], "elapsed": 0.0})
+        if action == "output":
+            entry["output"].append(out)
+        elif action in ("pass", "fail", "skip"):
+            entry["status"] = action
+            entry["elapsed"] = ev.get("Elapsed", 0.0)
+    if run.build_failed and not run.process_error:
+        run.process_error = "go test could not build the test package"
+    if proc.returncode != 0 and not run.results and not run.process_error:
+        run.process_error = "go test exited with status %d" % proc.returncode
+    if proc.returncode != 0 and stderr.strip() and run.process_error:
+        run.process_error += ": " + stderr.strip().splitlines()[0]
+    run.elapsed = time.time() - started
+    return run
+
+
+def testcase_for(selector: str, file_part: str, leaf: str, run: PackageRun) -> ET.Element:
+    case = ET.Element(
+        "testcase",
+        {
+            "classname": file_part,
+            "name": leaf,
+            "file": file_part,
+        },
+    )
+    props = ET.SubElement(case, "properties")
+    ET.SubElement(props, "property", {"name": "p2p_selector", "value": selector})
+
+    entry = run.results.get(leaf)
+    if entry is None:
+        err = ET.SubElement(
+            case,
+            "error",
+            {"message": "selector did not produce a test result", "type": "NotRun"},
+        )
+        detail = run.process_error or "no go test event matched %r in package %r" % (leaf, run.pkg_dir)
+        err.text = detail + "\n" + "\n".join(run.build_output[-20:])
+        case.set("time", "0")
+        return case
+    case.set("time", "%.3f" % float(entry.get("elapsed") or 0.0))
+    status = entry.get("status")
+    output = "".join(entry.get("output") or [])
+    if status == "pass":
+        return case
+    if status == "skip":
+        err = ET.SubElement(case, "error", {"message": "test was skipped", "type": "Skipped"})
+        err.text = output
+        return case
+    # Only a completed native Go test failure is an assertion result. Preserve
+    # incomplete, operational and runtime-crash evidence for strict classification.
+    assertion_failure = (
+        status == "fail" and not run.process_error and bool(output.strip())
+        and not re.search(r"(?m)^(?:panic:|fatal error:|runtime:|\[signal )", output)
+    )
+    failure = ET.SubElement(
+        case,
+        "failure",
+        {"message": "go test reported failure",
+         "type": "AssertionError" if assertion_failure else "GoTestFailure"},
+    )
+    failure.text = output
+    return case
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="P2P JUnit runner")
+    ap.add_argument("--select", default="", help="path to the pipeline selector list ({p2p_select})")
+    ap.add_argument("--report", required=True, help="path of the JUnit report to write ({report})")
+    ap.add_argument("--timeout", type=int, default=240, help="per-package timeout in seconds")
+    args = ap.parse_args()
+
+    def warn(message: str) -> None:
+        sys.stderr.write("p2p_junit_runner: %s\n" % message)
+
+    script_dir = Path(__file__).resolve().parent
+    root = find_repo_root()
+    selector_lines = resolve_selectors(args.select, root, script_dir, warn)
+
+    selectors = []
+    seen = set()
+    for line in selector_lines:
+        if "::" not in line:
+            fail("invalid selector (missing '::'): %r" % line)
+        file_part, leaf = line.split("::", 1)
+        file_part, leaf = file_part.strip(), leaf.strip()
+        if not file_part or not leaf:
+            fail("invalid selector: %r" % line)
+        if line in seen:
+            continue
+        seen.add(line)
+        selectors.append((line, file_part, leaf))
+    if not selectors:
+        fail("no selectors to execute")
+
+    tmp_root = Path(os.environ.get("TMPDIR") or "/tmp")
+    exec_root = resolve_exec_root(tmp_root, warn)
+    env, work_dir = go_env(tmp_root, exec_root)
+    atexit.register(shutil.rmtree, str(work_dir), ignore_errors=True)
+    warn("go test work dir %s" % work_dir)
+    go = find_go()
+
+    by_package = {}
+    for selector, file_part, leaf in selectors:
+        pkg_dir = os.path.dirname(file_part)
+        if pkg_dir in ("", "."):
+            pkg_dir = "."
+        if not (root / file_part).is_file():
+            fail("selector file %s does not exist in the repository" % file_part)
+        by_package.setdefault(pkg_dir, []).append((selector, file_part, leaf))
+
+    suites = []
+    total = failures = errors = 0
+    started = time.time()
+    for pkg_dir, items in sorted(by_package.items()):
+        run = run_package(go, root, env, pkg_dir, [leaf for _, _, leaf in items], args.timeout)
+        suite = ET.Element(
+            "testsuite",
+            {
+                "name": pkg_dir,
+                "package": pkg_dir,
+            },
+        )
+        s_tests = s_failures = s_errors = 0
+        for selector, file_part, leaf in items:
+            case = testcase_for(selector, file_part, leaf, run)
+            suite.append(case)
+            s_tests += 1
+            if case.find("failure") is not None:
+                s_failures += 1
+            elif case.find("error") is not None:
+                s_errors += 1
+            status = run.results.get(leaf, {}).get("status", "notrun")
+            print("%-6s %s" % (str(status).upper(), selector))
+        suite.set("tests", str(s_tests))
+        suite.set("failures", str(s_failures))
+        suite.set("errors", str(s_errors))
+        suite.set("skipped", "0")
+        suite.set("time", "%.3f" % run.elapsed)
+        suites.append(suite)
+        total += s_tests
+        failures += s_failures
+        errors += s_errors
+
+    root_el = ET.Element(
+        "testsuites",
+        {
+            "name": "p2p",
+            "tests": str(total),
+            "failures": str(failures),
+            "errors": str(errors),
+            "skipped": "0",
+            "time": "%.3f" % (time.time() - started),
+        },
+    )
+    for suite in suites:
+        root_el.append(suite)
+    tree = ET.ElementTree(root_el)
+    try:
+        ET.indent(tree, space="  ")
+    except AttributeError:
+        pass
+    report_path = Path(args.report)
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    tmp_report = report_path.with_name(report_path.name + ".tmp")
+    tree.write(str(tmp_report), encoding="UTF-8", xml_declaration=True)
+    os.replace(str(tmp_report), str(report_path))
+
+    print(
+        "p2p_junit_runner: wrote %s (tests=%d failures=%d errors=%d)"
+        % (report_path, total, failures, errors)
+    )
+    return 1 if failures or errors else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
