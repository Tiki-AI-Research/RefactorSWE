+++ b/tests/p2p_support.go
@@ -0,0 +1,1125 @@
+// Package p2p is the shared machinery used by the supplemental P2P
+// regression tests in this directory. It computes deterministic, observable
+// records for the public YAML API (traversal, node capability, formatting,
+// decoding, path handling and module integrity) so that the tests can compare
+// them against the frozen baseline snapshot in testdata/p2p_snapshots.json.
+//
+// The package contains no production logic: it only drives the module's
+// exported API and the Go standard library.
+package p2p
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	goast "go/ast"
+	goparser "go/parser"
+	gotoken "go/token"
+	"go/types"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+
+	"github.com/goccy/go-yaml"
+	"github.com/goccy/go-yaml/ast"
+	"github.com/goccy/go-yaml/parser"
+	"github.com/goccy/go-yaml/printer"
+	"github.com/goccy/go-yaml/token"
+)
+
+// CorpusNames lists the deterministic YAML fixtures in a stable order.
+var CorpusNames = []string{"scalars", "containers", "comments", "folded", "directive", "multidoc"}
+
+// CorpusDocs holds the YAML sources of the fixtures. They exercise every node
+// kind shipped by the module (null, bool, integer, float, infinity, nan,
+// string, literal, merge key, mapping, mapping key, mapping value, sequence,
+// sequence entry, anchor, alias, directive, tag and comments), block and flow
+// styles, anchors, aliases, tags, merges and comment placements.
+var CorpusDocs = map[string]string{
+	"scalars": "null_val: null\n" +
+		"empty_val:\n" +
+		"bool_true: true\n" +
+		"bool_false: false\n" +
+		"int_val: 42\n" +
+		"int_neg: -7\n" +
+		"float_val: 1.5\n" +
+		"inf_val: .inf\n" +
+		"neg_inf_val: -.inf\n" +
+		"nan_val: .nan\n" +
+		"str_plain: hello\n" +
+		"str_single: 'it''s'\n" +
+		"str_double: \"quoted\\n\"\n" +
+		"literal: |\n" +
+		"  line1\n" +
+		"  line2\n",
+	"folded": "plain: x\n" +
+		"folded: >\n" +
+		"  fold1\n" +
+		"  fold2\n",
+	"directive": "%YAML 1.2\n" +
+		"---\n" +
+		"a: 1\n",
+	"containers": "# head comment\n" +
+		"base: &base\n" +
+		"  a: 1\n" +
+		"  b: two\n" +
+		"merged:\n" +
+		"  <<: *base\n" +
+		"  c: 3\n" +
+		"seq:\n" +
+		"  - one\n" +
+		"  - two\n" +
+		"anchored_scalar: &sc hello\n" +
+		"alias_scalar: *sc\n" +
+		"tagged_seq: !!seq\n" +
+		"  - x\n" +
+		"tagged_map: !!map\n" +
+		"  k: v\n" +
+		"tagged_null: !!null null\n" +
+		"flow_map: {k1: v1, k2: v2}\n" +
+		"flow_seq: [1, 2.5, true]\n" +
+		"? explicit_key\n" +
+		": 1\n" +
+		"# foot comment\n",
+	"comments": "# head comment\n" +
+		"a: 1 # line comment\n" +
+		"# between comment\n" +
+		"b: 2\n" +
+		"seq:\n" +
+		"  # entry head\n" +
+		"  - x\n" +
+		"  - y # entry line\n" +
+		"# document foot\n",
+	"multidoc": "---\n" +
+		"a: 1\n" +
+		"---\n" +
+		"b:\n" +
+		"  - x\n" +
+		"  - y\n",
+}
+
+// ParseCorpus parses a fixture with comment parsing enabled.
+func ParseCorpus(name string) (*ast.File, error) {
+	src, ok := CorpusDocs[name]
+	if !ok {
+		return nil, fmt.Errorf("unknown corpus %q", name)
+	}
+	return parseBytes([]byte(src))
+}
+
+// parseBytes parses YAML with comment parsing enabled.
+func parseBytes(src []byte) (*ast.File, error) {
+	return parseBytesWithComments(src)
+}
+
+// parseBytesWithComments parses YAML with comment parsing enabled.
+func parseBytesWithComments(src []byte) (*ast.File, error) {
+	return parser.ParseBytes(src, parser.ParseComments)
+}
+
+// VisitorFunc adapts a function to the ast.Visitor interface.
+type VisitorFunc func(ast.Node) ast.Visitor
+
+// Visit implements ast.Visitor.
+func (f VisitorFunc) Visit(n ast.Node) ast.Visitor { return f(n) }
+
+// stopVisitor is a non-nil visitor that stops descending into a subtree.
+func stopVisitor(ast.Node) ast.Visitor { return nil }
+
+// nodeCollector records every visited node and keeps descending.
+type nodeCollector struct {
+	nodes []ast.Node
+}
+
+func (c *nodeCollector) Visit(n ast.Node) ast.Visitor {
+	if n == nil {
+		return nil
+	}
+	c.nodes = append(c.nodes, n)
+	return c
+}
+
+// WalkNodes returns every non-nil node visited by ast.Walk in visit order.
+func WalkNodes(root ast.Node) []ast.Node {
+	c := &nodeCollector{}
+	ast.Walk(c, root)
+	return c.nodes
+}
+
+// NodeLabel renders a stable observable label for a node.
+func NodeLabel(n ast.Node) string {
+	tk := n.GetToken()
+	if tk == nil {
+		return fmt.Sprintf("%s|-|-", n.Type())
+	}
+	return fmt.Sprintf("%s|%s|%s", n.Type(), tk.Type, tk.Value)
+}
+
+// NodeLabels renders labels for a node slice.
+func NodeLabels(nodes []ast.Node) []string {
+	labels := make([]string, 0, len(nodes))
+	for _, n := range nodes {
+		labels = append(labels, NodeLabel(n))
+	}
+	return labels
+}
+
+// WalkOrderRecords returns, per corpus, the walk visit labels per document.
+func WalkOrderRecords() (map[string][][]string, error) {
+	out := map[string][][]string{}
+	for _, name := range CorpusNames {
+		file, err := ParseCorpus(name)
+		if err != nil {
+			return nil, err
+		}
+		var docs [][]string
+		for _, doc := range file.Docs {
+			docs = append(docs, NodeLabels(WalkNodes(doc)))
+		}
+		out[name] = docs
+	}
+	return out, nil
+}
+
+// ParentIndexRecords returns, for the containers fixture, the index (in walk
+// order) of ast.Parent for every visited node, or -1 when the parent is nil.
+func ParentIndexRecords() ([]int, error) {
+	file, err := ParseCorpus("containers")
+	if err != nil {
+		return nil, err
+	}
+	doc := file.Docs[0]
+	nodes := WalkNodes(doc)
+	index := map[ast.Node]int{}
+	for i, n := range nodes {
+		if _, ok := index[n]; !ok {
+			index[n] = i
+		}
+	}
+	out := make([]int, 0, len(nodes))
+	for _, n := range nodes {
+		parent := ast.Parent(doc, n)
+		if parent == nil {
+			out = append(out, -1)
+			continue
+		}
+		idx, ok := index[parent]
+		if !ok {
+			return nil, fmt.Errorf("parent %s not present in visit order", parent.Type())
+		}
+		out = append(out, idx)
+	}
+	return out, nil
+}
+
+// FilterResult captures ast.Filter output for one fixture.
+type FilterResult struct {
+	MappingValues []string `json:"mapping_values"`
+	Strings       []string `json:"strings"`
+	Comments      []string `json:"comments"`
+	Sequences     []string `json:"sequences"`
+}
+
+// FilterFileResult captures ast.FilterFile output for the multi-document file.
+type FilterFileResult struct {
+	MappingValues []string `json:"mapping_values"`
+	Strings       []string `json:"strings"`
+}
+
+func renderNodes(nodes []ast.Node) []string {
+	out := make([]string, 0, len(nodes))
+	for _, n := range nodes {
+		out = append(out, n.String())
+	}
+	return out
+}
+
+// FilterRecords returns ast.Filter results per corpus.
+func FilterRecords() (map[string]FilterResult, error) {
+	out := map[string]FilterResult{}
+	for _, name := range CorpusNames {
+		file, err := ParseCorpus(name)
+		if err != nil {
+			return nil, err
+		}
+		doc := file.Docs[0]
+		out[name] = FilterResult{
+			MappingValues: renderNodes(ast.Filter(ast.MappingValueType, doc)),
+			Strings:       renderNodes(ast.Filter(ast.StringType, doc)),
+			Comments:      renderNodes(ast.Filter(ast.CommentType, doc)),
+			Sequences:     renderNodes(ast.Filter(ast.SequenceType, doc)),
+		}
+	}
+	return out, nil
+}
+
+// FilterFileRecords returns ast.FilterFile results for the multi-doc fixture.
+func FilterFileRecords() (FilterFileResult, error) {
+	file, err := ParseCorpus("multidoc")
+	if err != nil {
+		return FilterFileResult{}, err
+	}
+	return FilterFileResult{
+		MappingValues: renderNodes(ast.FilterFile(ast.MappingValueType, file)),
+		Strings:       renderNodes(ast.FilterFile(ast.StringType, file)),
+	}, nil
+}
+
+// VisitorProtocolRecord captures the visitor call protocol.
+type VisitorProtocolRecord struct {
+	Visits      int      `json:"visits"`
+	NilVisits   int      `json:"nil_visits"`
+	StopSeen    []string `json:"stop_seen"`
+	StopStopped bool     `json:"stop_stopped"`
+}
+
+// countingVisitor counts Visit calls and keeps descending.
+type countingVisitor struct {
+	visits int
+	nils   int
+}
+
+func (v *countingVisitor) Visit(n ast.Node) ast.Visitor {
+	if n == nil {
+		v.nils++
+		return nil
+	}
+	v.visits++
+	return v
+}
+
+// stoppingVisitor records visits and stops descending at the first string
+// scalar it encounters.
+type stoppingVisitor struct {
+	seen    []string
+	stopped bool
+}
+
+func (v *stoppingVisitor) Visit(n ast.Node) ast.Visitor {
+	if n == nil {
+		return nil
+	}
+	v.seen = append(v.seen, NodeLabel(n))
+	if !v.stopped && n.Type() == ast.StringType {
+		v.stopped = true
+		return nil
+	}
+	return v
+}
+
+// VisitorProtocolRecords computes the visitor protocol record.
+func VisitorProtocolRecords() (VisitorProtocolRecord, error) {
+	file, err := ParseCorpus("containers")
+	if err != nil {
+		return VisitorProtocolRecord{}, err
+	}
+	cv := &countingVisitor{}
+	ast.Walk(cv, file.Docs[0])
+
+	file, err = ParseCorpus("containers")
+	if err != nil {
+		return VisitorProtocolRecord{}, err
+	}
+	sv := &stoppingVisitor{}
+	ast.Walk(sv, file.Docs[0])
+
+	return VisitorProtocolRecord{Visits: cv.visits, NilVisits: cv.nils, StopSeen: sv.seen, StopStopped: sv.stopped}, nil
+}
+
+// WalkCountRecords returns the number of nodes visited for every fixture plus
+// a larger generated document.
+func WalkCountRecords() (map[string]int, error) {
+	out := map[string]int{}
+	for _, name := range CorpusNames {
+		file, err := ParseCorpus(name)
+		if err != nil {
+			return nil, err
+		}
+		total := 0
+		for _, doc := range file.Docs {
+			nodes := WalkNodes(doc)
+			if err := assertUniqueNodes(nodes); err != nil {
+				return nil, fmt.Errorf("%s: %w", name, err)
+			}
+			total += len(nodes)
+		}
+		out[name] = total
+	}
+	size := 500
+	var sb strings.Builder
+	sb.WriteString("root:\n")
+	for i := 0; i < size; i++ {
+		fmt.Fprintf(&sb, "  key%d: [1, 2, 3]\n", i)
+	}
+	file, err := parseBytesWithComments([]byte(sb.String()))
+	if err != nil {
+		return nil, err
+	}
+	nodes := WalkNodes(file.Docs[0])
+	if err := assertUniqueNodes(nodes); err != nil {
+		return nil, fmt.Errorf("large: %w", err)
+	}
+	out["large"] = len(nodes)
+	return out, nil
+}
+
+// LargeDocumentNodes returns the node count of the generated large document.
+func LargeDocumentNodes() (int, error) {
+	counts, err := WalkCountRecords()
+	if err != nil {
+		return 0, err
+	}
+	return counts["large"], nil
+}
+
+// LargeDocumentSource returns the generated large document source.
+func LargeDocumentSource() string {
+	var sb strings.Builder
+	sb.WriteString("root:\n")
+	for i := 0; i < 500; i++ {
+		fmt.Fprintf(&sb, "  key%d: [1, 2, 3]\n", i)
+	}
+	return sb.String()
+}
+
+func assertUniqueNodes(nodes []ast.Node) error {
+	seen := map[ast.Node]bool{}
+	for _, n := range nodes {
+		if seen[n] {
+			return fmt.Errorf("node %s visited more than once by Walk", NodeLabel(n))
+		}
+		seen[n] = true
+	}
+	return nil
+}
+
+// NodeMethodRecord captures the observable result of every Node interface
+// method for one node.
+type NodeMethodRecord struct {
+	GoType        string `json:"go_type"`
+	Type          string `json:"type"`
+	YAMLName      string `json:"yaml_name"`
+	TokenType     string `json:"token_type"`
+	TokenValue    string `json:"token_value"`
+	PathAfterSet  string `json:"path_after_set"`
+	CommentBefore bool   `json:"comment_before"`
+	SetCommentErr string `json:"set_comment_err"`
+	CommentSame   bool   `json:"comment_same"`
+	String        string `json:"string"`
+	StringComment string `json:"string_comment"`
+	MarshalYAML   string `json:"marshal_yaml"`
+	Read          string `json:"read"`
+	ColumnBefore  int    `json:"column_before"`
+	ColumnAfter   int    `json:"column_after"`
+}
+
+func tokenString(tk *token.Token) (string, string) {
+	if tk == nil {
+		return "-", "-"
+	}
+	return tk.Type.String(), tk.Value
+}
+
+func tokenColumn(tk *token.Token) int {
+	if tk == nil || tk.Position == nil {
+		return 0
+	}
+	return tk.Position.Column
+}
+
+// NodeMethodRecords exercises the Node interface on every node of the richest
+// fixture and returns one record per node in walk order.
+func NodeMethodRecords() ([]NodeMethodRecord, error) {
+	comment := ast.CommentGroup([]*token.Token{
+		token.New("# p2p comment", "# p2p comment", &token.Position{Line: 1, Column: 1}),
+	})
+	type docRef struct {
+		corpus string
+		doc    int
+	}
+	var refs []docRef
+	for _, name := range CorpusNames {
+		file, err := ParseCorpus(name)
+		if err != nil {
+			return nil, err
+		}
+		for i := range file.Docs {
+			refs = append(refs, docRef{corpus: name, doc: i})
+		}
+	}
+	loadNodes := func() ([]ast.Node, error) {
+		var nodes []ast.Node
+		for _, ref := range refs {
+			file, err := ParseCorpus(ref.corpus)
+			if err != nil {
+				return nil, err
+			}
+			visited := WalkNodes(file.Docs[ref.doc])
+			nodes = append(nodes, visited...)
+			// Sequence entry nodes are not visited by ast.Walk but are part
+			// of the shipped node types, so exercise them explicitly.
+			for _, n := range visited {
+				seq, ok := n.(*ast.SequenceNode)
+				if !ok {
+					continue
+				}
+				for _, entry := range seq.Entries {
+					nodes = append(nodes, entry)
+				}
+			}
+		}
+		return nodes, nil
+	}
+	nodes, err := loadNodes()
+	if err != nil {
+		return nil, err
+	}
+
+	out := make([]NodeMethodRecord, 0, len(nodes))
+	for i, n := range nodes {
+		tokType, tokValue := tokenString(n.GetToken())
+		rec := NodeMethodRecord{
+			GoType:        fmt.Sprintf("%T", n),
+			Type:          n.Type().String(),
+			YAMLName:      n.Type().YAMLName(),
+			TokenType:     tokType,
+			TokenValue:    tokValue,
+			CommentBefore: n.GetComment() != nil,
+			String:        n.String(),
+		}
+		n.SetPath("$.p2p")
+		rec.PathAfterSet = n.GetPath()
+		if err := n.SetComment(comment); err != nil {
+			rec.SetCommentErr = err.Error()
+		}
+		rec.CommentSame = n.GetComment() == comment
+		rec.StringComment = n.String()
+		marshaled, err := n.MarshalYAML()
+		if err != nil {
+			return nil, fmt.Errorf("node %d (%s): MarshalYAML: %w", i, rec.Type, err)
+		}
+		rec.MarshalYAML = string(marshaled)
+		read, err := io.ReadAll(n)
+		if err != nil {
+			return nil, fmt.Errorf("node %d (%s): Read: %w", i, rec.Type, err)
+		}
+		rec.Read = string(read)
+
+		freshNodes, err := loadNodes()
+		if err != nil {
+			return nil, err
+		}
+		if len(freshNodes) != len(nodes) {
+			return nil, fmt.Errorf("node count changed between parses: %d vs %d", len(nodes), len(freshNodes))
+		}
+		fresh := freshNodes[i]
+		rec.ColumnBefore = tokenColumn(fresh.GetToken())
+		fresh.AddColumn(3)
+		rec.ColumnAfter = tokenColumn(fresh.GetToken())
+		out = append(out, rec)
+	}
+	return out, nil
+}
+
+// FormatResult captures the byte output of the public formatting entry points.
+type FormatResult struct {
+	PrintNode          string `json:"print_node"`
+	Marshal            string `json:"marshal"`
+	MarshalError       string `json:"marshal_error"`
+	BodyString         string `json:"body_string"`
+	FileString         string `json:"file_string"`
+	CustomUnmarshal    string `json:"custom_unmarshal"`
+	CustomUnmarshalErr string `json:"custom_unmarshal_error"`
+}
+
+// rawCapture is a BytesUnmarshaler that captures the raw document bytes
+// produced through the module's internal formatting path.
+type rawCapture struct {
+	data []byte
+}
+
+// UnmarshalYAML implements yaml.BytesUnmarshaler.
+func (r *rawCapture) UnmarshalYAML(b []byte) error {
+	r.data = b
+	return nil
+}
+
+// FormatOutputRecords returns formatting output records per corpus.
+func FormatOutputRecords() (map[string]FormatResult, error) {
+	out := map[string]FormatResult{}
+	for _, name := range CorpusNames {
+		file, err := ParseCorpus(name)
+		if err != nil {
+			return nil, err
+		}
+		doc := file.Docs[0]
+		var marshaled []byte
+		marshalErr := ""
+		if b, err := yaml.Marshal(doc); err != nil {
+			marshalErr = err.Error()
+		} else {
+			marshaled = b
+		}
+		capture := &rawCapture{}
+		customErr := ""
+		if err := yaml.Unmarshal([]byte(CorpusDocs[name]), capture); err != nil {
+			customErr = err.Error()
+		}
+		out[name] = FormatResult{
+			PrintNode:          string((&printer.Printer{}).PrintNode(doc)),
+			Marshal:            string(marshaled),
+			MarshalError:       marshalErr,
+			BodyString:         doc.Body.String(),
+			FileString:         file.String(),
+			CustomUnmarshal:    string(capture.data),
+			CustomUnmarshalErr: customErr,
+		}
+	}
+	return out, nil
+}
+
+// DecodeCase describes one deterministic decode scenario.
+type DecodeCase struct {
+	Name   string
+	Source string
+	Target string
+}
+
+// DecodeValueRecord captures a successful decode outcome.
+type DecodeValueRecord struct {
+	Value string `json:"value"`
+	Error string `json:"error"`
+}
+
+// DecodeErrorRecord captures a failing decode outcome.
+type DecodeErrorRecord struct {
+	Error            string `json:"error"`
+	IsSyntax         bool   `json:"is_syntax"`
+	IsType           bool   `json:"is_type"`
+	IsOverflow       bool   `json:"is_overflow"`
+	IsUnexpectedNode bool   `json:"is_unexpected_node"`
+	IsDuplicateKey   bool   `json:"is_duplicate_key"`
+	IsUnknownField   bool   `json:"is_unknown_field"`
+	IsMaxDepth       bool   `json:"is_max_depth"`
+}
+
+// DecodeValueCases lists decode scenarios expected to succeed.
+var DecodeValueCases = []DecodeCase{
+	{"tagged_seq", "a: !!seq\n  - 1\n  - 2\n", "struct_a_slice_int"},
+	{"tagged_map", "a: !!map\n  k: v\n", "struct_a_map_string_string"},
+	{"tagged_null", "a: !!null null\n", "struct_a_ptr_string"},
+	{"tagged_str_null", "a: !!str null\n", "struct_a_ptr_string"},
+	{"anchor_alias_scalar", "a: &x 5\nb: *x\n", "map_string_int"},
+	{"anchor_alias_list", "a: &x [1, 2]\nb: *x\n", "any"},
+	{"repeated_alias", "a: &x {k: v}\nb: *x\nc: *x\n", "any"},
+	{"tag_and_anchor", "a: !!str &x 42\n", "map_string_string"},
+	{"anchor_then_tag", "a: &x !!str 42\n", "map_string_string"},
+	{"nested_tags", "a: !!seq [!!int 1, !!str 2]\n", "any"},
+	{"merge_single", "base: &b\n  a: 1\n  b: 2\nm:\n  <<: *b\n  c: 3\n", "any"},
+	{"merge_list", "x: &x {a: 1}\ny: &y {b: 2}\nm:\n  <<: [*x, *y]\n", "any"},
+	{"merge_override", "base: &b\n  a: 1\nm:\n  <<: *b\n  a: 2\n", "any"},
+	{"anchored_key", "&k foo: 1\n", "any"},
+	{"tagged_key", "!!str foo: 1\n", "any"},
+	{"explicit_anchored_key", "? &k foo\n: 1\n", "any"},
+	{"plain_values", "a: 1\nb: two\nc: [true, null]\n", "any"},
+	{"literal_block", "a: |\n  x\n  y\n", "map_string_string"},
+	{"json_compatible", "a: 1\nb: [x, y]\n", "any"},
+}
+
+// DecodeErrorCases lists decode scenarios expected to fail.
+var DecodeErrorCases = []DecodeCase{
+	{"unresolved_alias", "a: *missing\n", "any"},
+	{"unresolved_alias_seq", "- *missing\n", "any"},
+	{"duplicate_key", "a: 1\na: 2\n", "map_string_int"},
+	{"bad_bool_tag", "a: !!bool notabool\n", "any"},
+	{"binary_non_string", "a: !!binary [1]\n", "any"},
+	{"merge_scalar", "a: &a 1\nb:\n  <<: *a\n", "any"},
+	{"merge_literal_seq", "b:\n  <<: [1, 2]\n", "any"},
+	{"tag_scalar_to_map", "items: !!str scalar\n", "struct_items_map"},
+	{"alias_key", "&k foo: 1\n*k: 2\n", "any"},
+	{"tag_on_alias", "a: &x 1\nb: !!int *x\n", "map_string_int"},
+}
+
+// NewDecodeTarget builds the decode destination for a target kind.
+func NewDecodeTarget(kind string) any {
+	switch kind {
+	case "any":
+		return new(any)
+	case "map_string_int":
+		return new(map[string]int)
+	case "map_string_string":
+		return new(map[string]string)
+	case "struct_a_slice_int":
+		return new(struct {
+			A []int `yaml:"a"`
+		})
+	case "struct_a_map_string_string":
+		return new(struct {
+			A map[string]string `yaml:"a"`
+		})
+	case "struct_a_ptr_string":
+		return new(struct {
+			A *string `yaml:"a"`
+		})
+	case "struct_items_map":
+		return new(struct {
+			Items map[string]string `yaml:"items"`
+		})
+	}
+	panic("unknown decode target: " + kind)
+}
+
+func runDecodeValue(c DecodeCase) (DecodeValueRecord, error) {
+	ptr := NewDecodeTarget(c.Target)
+	if err := yaml.Unmarshal([]byte(c.Source), ptr); err != nil {
+		return DecodeValueRecord{Error: err.Error()}, nil
+	}
+	v := reflect.ValueOf(ptr).Elem().Interface()
+	b, err := json.Marshal(v)
+	if err != nil {
+		return DecodeValueRecord{}, fmt.Errorf("%s: json marshal: %w", c.Name, err)
+	}
+	return DecodeValueRecord{Value: string(b)}, nil
+}
+
+// DecodeValueRecords computes the successful decode outcomes.
+func DecodeValueRecords() (map[string]DecodeValueRecord, error) {
+	out := map[string]DecodeValueRecord{}
+	for _, c := range DecodeValueCases {
+		rec, err := runDecodeValue(c)
+		if err != nil {
+			return nil, err
+		}
+		out[c.Name] = rec
+	}
+	return out, nil
+}
+
+func runDecodeError(c DecodeCase) (DecodeErrorRecord, error) {
+	ptr := NewDecodeTarget(c.Target)
+	err := yaml.Unmarshal([]byte(c.Source), ptr)
+	if err == nil {
+		return DecodeErrorRecord{}, fmt.Errorf("%s: expected an error, got none", c.Name)
+	}
+	rec := DecodeErrorRecord{Error: err.Error()}
+	var syntaxErr *yaml.SyntaxError
+	rec.IsSyntax = errors.As(err, &syntaxErr)
+	var typeErr *yaml.TypeError
+	rec.IsType = errors.As(err, &typeErr)
+	var overflowErr *yaml.OverflowError
+	rec.IsOverflow = errors.As(err, &overflowErr)
+	var nodeErr *yaml.UnexpectedNodeTypeError
+	rec.IsUnexpectedNode = errors.As(err, &nodeErr)
+	var dupErr *yaml.DuplicateKeyError
+	rec.IsDuplicateKey = errors.As(err, &dupErr)
+	var unknownErr *yaml.UnknownFieldError
+	rec.IsUnknownField = errors.As(err, &unknownErr)
+	rec.IsMaxDepth = errors.Is(err, yaml.ErrExceededMaxDepth)
+	return rec, nil
+}
+
+// DecodeErrorRecords computes the failing decode outcomes.
+func DecodeErrorRecords() (map[string]DecodeErrorRecord, error) {
+	out := map[string]DecodeErrorRecord{}
+	for _, c := range DecodeErrorCases {
+		rec, err := runDecodeError(c)
+		if err != nil {
+			return nil, err
+		}
+		out[c.Name] = rec
+	}
+	return out, nil
+}
+
+// DepthLimitRecord captures the depth-limit sentinel error text.
+type DepthLimitRecord struct {
+	Error string `json:"error"`
+}
+
+// DepthLimitRecords decodes a document nested below the internal limit.
+func DepthLimitRecords() (DepthLimitRecord, error) {
+	src := strings.Repeat("[", 10005) + strings.Repeat("]", 10005)
+	var v any
+	err := yaml.Unmarshal([]byte(src), &v)
+	if err == nil {
+		return DepthLimitRecord{}, errors.New("expected depth limit error, got nil")
+	}
+	if !errors.Is(err, yaml.ErrExceededMaxDepth) {
+		return DepthLimitRecord{}, fmt.Errorf("expected ErrExceededMaxDepth, got %T: %v", err, err)
+	}
+	return DepthLimitRecord{Error: err.Error()}, nil
+}
+
+// PathFilterRecord captures one path selection outcome.
+type PathFilterRecord struct {
+	Node                string `json:"node"`
+	Error               string `json:"error"`
+	IsInvalidPathString bool   `json:"is_invalid_path_string"`
+	IsInvalidQuery      bool   `json:"is_invalid_query"`
+	IsNotFoundNode      bool   `json:"is_not_found_node"`
+}
+
+// PathFilterCase describes one path selection scenario.
+type PathFilterCase struct {
+	Name   string
+	Source string
+	Path   string
+	Mode   string // "file" (Path.FilterFile) or "node" (Path.FilterNode)
+}
+
+// PathFilterCases lists path selection scenarios.
+var PathFilterCases = []PathFilterCase{
+	{"map_value", "a:\n  b: 1\n", "$.a.b", "file"},
+	{"index", "list:\n  - x\n  - y\n", "$.list[1]", "file"},
+	{"index_all", "list:\n  - x\n  - y\n", "$.list[*]", "file"},
+	{"recursive", "a:\n  name: x\nb:\n  name: y\n", "$..name", "file"},
+	{"no_match", "a:\n  b: 1\n", "$.zzz", "file"},
+	{"no_match_deep", "a:\n  b: 1\n", "$.a.zzz.yyy", "file"},
+	{"no_match_node", "a:\n  b: 1\n", "$.zzz", "node"},
+	{"no_match_node_deep", "a:\n  b: 1\n", "$.a.zzz.yyy", "node"},
+	{"anchored_key", "&k foo: 1\n", "$.foo", "file"},
+	{"tagged_key", "!!str foo: 1\n", "$.foo", "file"},
+	{"explicit_anchored_key", "? &k foo\n: 1\n", "$.foo", "file"},
+	{"root", "a:\n  b: 1\n", "$", "file"},
+	{"invalid_empty_key", "a: 1\n", "$.", "file"},
+	{"invalid_missing_dollar", "a: 1\n", "a.b", "file"},
+	{"invalid_unclosed_index", "a: 1\n", "$.a[", "file"},
+	{"invalid_index_char", "a: 1\n", "$[a]", "file"},
+	{"invalid_recursive", "a: 1\n", "$..", "file"},
+	{"invalid_star", "a: 1\n", "$.*", "file"},
+	{"index_on_mapping", "a:\n  b: 1\n", "$.a[0]", "file"},
+	{"key_on_sequence", "list:\n  - x\n", "$.list.k", "file"},
+}
+
+func runPathFilter(c PathFilterCase) (PathFilterRecord, error) {
+	rec := PathFilterRecord{}
+	p, err := yaml.PathString(c.Path)
+	if err != nil {
+		rec.Error = err.Error()
+		rec.IsInvalidPathString = yaml.IsInvalidPathStringError(err)
+		rec.IsInvalidQuery = yaml.IsInvalidQueryError(err)
+		return rec, nil
+	}
+	file, err := parseBytesWithComments([]byte(c.Source))
+	if err != nil {
+		return rec, fmt.Errorf("%s: parse: %w", c.Name, err)
+	}
+	var node ast.Node
+	switch c.Mode {
+	case "", "file":
+		node, err = p.FilterFile(file)
+	case "node":
+		node, err = p.FilterNode(file.Docs[0].Body)
+	default:
+		return rec, fmt.Errorf("%s: unknown mode %q", c.Name, c.Mode)
+	}
+	if err != nil {
+		rec.Error = err.Error()
+		rec.IsInvalidPathString = yaml.IsInvalidPathStringError(err)
+		rec.IsInvalidQuery = yaml.IsInvalidQueryError(err)
+		rec.IsNotFoundNode = errors.Is(err, yaml.ErrNotFoundNode)
+		return rec, nil
+	}
+	if node == nil {
+		rec.Node = "<nil>"
+	} else {
+		rec.Node = node.String()
+	}
+	return rec, nil
+}
+
+// PathFilterRecords computes path selection records.
+func PathFilterRecords() (map[string]PathFilterRecord, error) {
+	out := map[string]PathFilterRecord{}
+	for _, c := range PathFilterCases {
+		rec, err := runPathFilter(c)
+		if err != nil {
+			return nil, err
+		}
+		out[c.Name] = rec
+	}
+	return out, nil
+}
+
+// PathReplaceRecord captures one path replacement outcome.
+type PathReplaceRecord struct {
+	Output     string `json:"output"`
+	Error      string `json:"error"`
+	IsNotFound bool   `json:"is_not_found"`
+}
+
+// PathReplaceCase describes one path replacement scenario.
+type PathReplaceCase struct {
+	Name   string
+	Dest   string
+	Path   string
+	Source string
+	Mode   string
+}
+
+// PathReplaceCases lists path replacement scenarios.
+var PathReplaceCases = []PathReplaceCase{
+	{"replace_scalar", "a: 1\nb: 2\n", "$.a", "3\n", "reader"},
+	{"replace_mapping", "b: 1\nc: 2\n", "$.b", "d: e\nf:\n  g: h\n", "reader"},
+	{"replace_index", "a:\n  b:\n  - hello\nc: 2\n", "$.a.b[0]", "world\n", "reader"},
+	{"replace_index_all", "list:\n  - x\n  - y\ntail: z\n", "$.list[*]", "9\n", "reader"},
+	{"replace_recursive", "a:\n  name: x\nb:\n  name: y\n", "$..name", "r\n", "reader"},
+	{"replace_anchored_key", "&k foo: 1\nother: 2\n", "$.foo", "9\n", "reader"},
+	{"replace_tagged_key", "!!str foo: 1\nother: 2\n", "$.foo", "9\n", "reader"},
+	{"replace_no_match", "a: 1\n", "$.zzz", "9\n", "reader"},
+	{"replace_node", "a: 1\n", "$.a", "7\n", "node"},
+}
+
+func runPathReplace(c PathReplaceCase) (PathReplaceRecord, error) {
+	rec := PathReplaceRecord{}
+	p, err := yaml.PathString(c.Path)
+	if err != nil {
+		rec.Error = err.Error()
+		return rec, nil
+	}
+	dst, err := parseBytes([]byte(c.Dest))
+	if err != nil {
+		return rec, fmt.Errorf("%s: parse dest: %w", c.Name, err)
+	}
+	switch c.Mode {
+	case "reader":
+		err = p.ReplaceWithReader(dst, strings.NewReader(c.Source))
+	case "node":
+		src, perr := parseBytes([]byte(c.Source))
+		if perr != nil {
+			return rec, fmt.Errorf("%s: parse src: %w", c.Name, perr)
+		}
+		err = p.ReplaceWithNode(dst, src.Docs[0].Body)
+	default:
+		return rec, fmt.Errorf("%s: unknown mode %q", c.Name, c.Mode)
+	}
+	if err != nil {
+		rec.Error = err.Error()
+		rec.IsNotFound = errors.Is(err, yaml.ErrNotFoundNode)
+		return rec, nil
+	}
+	rec.Output = dst.String()
+	return rec, nil
+}
+
+// PathReplaceRecords computes path replacement records.
+func PathReplaceRecords() (map[string]PathReplaceRecord, error) {
+	out := map[string]PathReplaceRecord{}
+	for _, c := range PathReplaceCases {
+		rec, err := runPathReplace(c)
+		if err != nil {
+			return nil, err
+		}
+		out[c.Name] = rec
+	}
+	return out, nil
+}
+
+// APIPackages lists the importable module packages whose exported surface is
+// pinned by the supplemental regression tests.
+var APIPackages = []string{".", "ast", "lexer", "parser", "printer", "scanner", "token"}
+
+// SurfaceEntry describes one exported symbol of a package surface.
+// For struct types, Fields lists the exported field descriptors; for interface
+// types, Methods lists the method/embedding descriptors. The comparison only
+// requires baseline entries to still be present: additive fields and methods
+// are allowed, removals and signature changes are not.
+type SurfaceEntry struct {
+	Kind       string   `json:"kind"`
+	Descriptor string   `json:"descriptor,omitempty"`
+	Fields     []string `json:"fields,omitempty"`
+	Methods    []string `json:"methods,omitempty"`
+}
+
+// ExportedAPISurface parses the non-test Go files of a package directory and
+// returns a map from "package|symbol" to a descriptor of the exported symbol.
+// Additions are allowed by the comparison; removals or narrowing are not.
+func ExportedAPISurface(root, pkgDir string) (map[string]SurfaceEntry, error) {
+	dir := filepath.Join(root, pkgDir)
+	fset := gotoken.NewFileSet()
+	pkgs, err := goparser.ParseDir(fset, dir, func(fi os.FileInfo) bool {
+		return !strings.HasSuffix(fi.Name(), "_test.go")
+	}, 0)
+	if err != nil {
+		return nil, err
+	}
+	out := map[string]SurfaceEntry{}
+	for _, pkg := range pkgs {
+		for _, file := range pkg.Files {
+			for _, decl := range file.Decls {
+				switch d := decl.(type) {
+				case *goast.FuncDecl:
+					if !goast.IsExported(d.Name.Name) {
+						continue
+					}
+					if d.Recv != nil && len(d.Recv.List) > 0 {
+						recv := receiverName(d.Recv.List[0].Type)
+						if recv == "" || !goast.IsExported(recv) {
+							continue
+						}
+						out[pkgDir+"|method "+recv+"."+d.Name.Name] = SurfaceEntry{Kind: "func", Descriptor: funcSignature(d.Type)}
+						continue
+					}
+					out[pkgDir+"|func "+d.Name.Name] = SurfaceEntry{Kind: "func", Descriptor: funcSignature(d.Type)}
+				case *goast.GenDecl:
+					for _, spec := range d.Specs {
+						switch s := spec.(type) {
+						case *goast.TypeSpec:
+							if !goast.IsExported(s.Name.Name) {
+								continue
+							}
+							out[pkgDir+"|type "+s.Name.Name] = typeDescriptor(s)
+						case *goast.ValueSpec:
+							for _, name := range s.Names {
+								if !goast.IsExported(name.Name) {
+									continue
+								}
+								kind := "var"
+								if d.Tok == gotoken.CONST {
+									kind = "const"
+								}
+								desc := ""
+								if s.Type != nil {
+									desc = types.ExprString(s.Type)
+								}
+								out[pkgDir+"|"+kind+" "+name.Name] = SurfaceEntry{Kind: kind, Descriptor: desc}
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+	return out, nil
+}
+
+func receiverName(expr goast.Expr) string {
+	switch e := expr.(type) {
+	case *goast.StarExpr:
+		return receiverName(e.X)
+	case *goast.Ident:
+		return e.Name
+	case *goast.IndexExpr:
+		return receiverName(e.X)
+	case *goast.IndexListExpr:
+		return receiverName(e.X)
+	}
+	return ""
+}
+
+func funcSignature(ft *goast.FuncType) string {
+	return "(" + fieldListString(ft.Params) + ") (" + fieldListString(ft.Results) + ")"
+}
+
+func fieldListString(fl *goast.FieldList) string {
+	if fl == nil || len(fl.List) == 0 {
+		return ""
+	}
+	var parts []string
+	for _, f := range fl.List {
+		t := types.ExprString(f.Type)
+		if len(f.Names) == 0 {
+			parts = append(parts, t)
+			continue
+		}
+		for range f.Names {
+			parts = append(parts, t)
+		}
+	}
+	return strings.Join(parts, ", ")
+}
+
+func typeDescriptor(s *goast.TypeSpec) SurfaceEntry {
+	if s.Assign.IsValid() {
+		return SurfaceEntry{Kind: "alias", Descriptor: types.ExprString(s.Type)}
+	}
+	switch t := s.Type.(type) {
+	case *goast.StructType:
+		var fields []string
+		for _, f := range t.Fields.List {
+			if len(f.Names) == 0 {
+				fields = append(fields, "embedded "+types.ExprString(f.Type))
+				continue
+			}
+			for _, name := range f.Names {
+				if !goast.IsExported(name.Name) {
+					continue
+				}
+				fields = append(fields, name.Name+" "+types.ExprString(f.Type))
+			}
+		}
+		sort.Strings(fields)
+		return SurfaceEntry{Kind: "struct", Fields: fields}
+	case *goast.InterfaceType:
+		var methods []string
+		for _, m := range t.Methods.List {
+			if len(m.Names) == 0 {
+				methods = append(methods, "embedded "+types.ExprString(m.Type))
+				continue
+			}
+			ft, ok := m.Type.(*goast.FuncType)
+			if !ok {
+				continue
+			}
+			for _, name := range m.Names {
+				if !goast.IsExported(name.Name) {
+					continue
+				}
+				methods = append(methods, name.Name+funcSignature(ft))
+			}
+		}
+		sort.Strings(methods)
+		return SurfaceEntry{Kind: "interface", Methods: methods}
+	default:
+		return SurfaceEntry{Kind: "type", Descriptor: types.ExprString(s.Type)}
+	}
+}
+
+// CompareAPISurface checks that every symbol of the baseline surface is still
+// present and not narrowed. Additions (new symbols, new struct fields, new
+// interface methods) are allowed.
+func CompareAPISurface(baseline, current map[string]SurfaceEntry) []string {
+	var problems []string
+	for symbol, want := range baseline {
+		got, ok := current[symbol]
+		if !ok {
+			problems = append(problems, "removed: "+symbol)
+			continue
+		}
+		if got.Kind != want.Kind {
+			problems = append(problems, fmt.Sprintf("changed kind: %s: want %q got %q", symbol, want.Kind, got.Kind))
+			continue
+		}
+		switch want.Kind {
+		case "struct":
+			present := map[string]bool{}
+			for _, f := range got.Fields {
+				present[f] = true
+			}
+			for _, f := range want.Fields {
+				if !present[f] {
+					problems = append(problems, fmt.Sprintf("removed struct field: %s: %s", symbol, f))
+				}
+			}
+		case "interface":
+			present := map[string]bool{}
+			for _, m := range got.Methods {
+				present[m] = true
+			}
+			for _, m := range want.Methods {
+				if !present[m] {
+					problems = append(problems, fmt.Sprintf("removed interface method: %s: %s", symbol, m))
+				}
+			}
+		default:
+			if got.Descriptor != want.Descriptor {
+				problems = append(problems, fmt.Sprintf("changed: %s: want %q got %q", symbol, want.Descriptor, got.Descriptor))
+			}
+		}
+	}
+	sort.Strings(problems)
+	return problems
+}
diff --git a/tests/p2p_traversal_test.go b/tests/p2p_traversal_test.go
