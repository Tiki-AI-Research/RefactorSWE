+const probeSource = `package main
+import (
+ "encoding/json"
+ "fmt"
+ "os"
+ "strings"
+ yaml "github.com/goccy/go-yaml"
+ "github.com/goccy/go-yaml/ast"
+ "github.com/goccy/go-yaml/parser"
+)
+type counter struct { calls int }
+func (v *counter) Visit(n ast.Node) ast.Visitor { if n != nil { v.calls++ }; return v }
+func total() int { n:=0; for _, count := range ast.QCVisits() { n+=count }; return n }
+func main() {
+ samples:=[]map[string]interface{}{}
+ for _, size := range []int{32,128} {
+  text:="a: ["+strings.Repeat("1, ", size)+"2]\n"
+  file, err:=parser.ParseBytes([]byte(text),0); if err!=nil { panic(err) }
+  node:=file.Docs[0]
+  ast.QCResetVisits()
+  visitor:=&counter{}
+  ast.Walk(visitor,node)
+  calls:=total()
+  once:=calls>0 && calls==visitor.calls
+  for _, count:=range ast.QCVisits() { once=once && count==1 }
+  // Both public decoding entry points are measured separately, after parsing.
+  ast.QCResetVisits()
+  var first map[string][]uint64
+  e1:=yaml.NodeToValue(node.Body,&first)
+  n1:=total()
+  ast.QCResetVisits()
+  var second map[string][]uint64
+  e2:=yaml.NewDecoder(strings.NewReader("")).DecodeFromNode(node.Body,&second)
+  n2:=total()
+  valuesOK:=len(first["a"])==size+1 && len(second["a"])==size+1
+  if valuesOK { valuesOK=first["a"][size]==2 && second["a"][size]==2 }
+  samples=append(samples,map[string]interface{}{"size":size,"walk_calls":calls,"user_calls":visitor.calls,"decode_calls":[]int{n1,n2},"decode_errors":[]string{fmt.Sprint(e1),fmt.Sprint(e2)},"values_ok":valuesOK,"walk_pass":once,"decode_pass":e1==nil && e2==nil && valuesOK && n1==0 && n2==0})
+ }
+ json.NewEncoder(os.Stdout).Encode(map[string]interface{}{"schema":"case30-internal-work-v1","samples":samples})
+}
