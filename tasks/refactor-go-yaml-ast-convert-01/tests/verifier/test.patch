+#!/usr/bin/env python3
+"""Execute the frozen P2P+F2P selector set with the Go toolchain and emit JUnit.
+
+The runner is the aggregate producer: it reads the canonical verifier config
+(`{config}`, also discoverable as a well-known `config.json`) and executes the
+exact selectors declared by its `p2p` and `f2p` arrays, together with any
+P2P/F2P gates carrying a `tests` list. It never replaces the final selection
+with a test file, a wide pattern or the P2P collection inventory: selector
+sources are config/selector files only, and the embedded frozen F2P catalog is
+used just as a self-contained last resort together with the materialized
+`p2p_select.txt` when no config can be resolved at all.
+
+The runner writes a conventional JUnit XML report to {report}. It never installs
+anything and never touches the network: only repository files and the frozen
+image toolchain are used.
+"""
+
+from __future__ import annotations
+
+import argparse
+import atexit
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+ROLE_KEYS = {
+    "p2p": ("p2p", "p2p_select", "p2p_selectors", "p2p_tests"),
+    "f2p": ("f2p", "f2p_select", "f2p_selectors", "f2p_tests"),
+}
+FALLBACK_KEYS = ("selectors", "tests")
+
+DECLARED_F2P_SELECTORS = (
+    "tests/f2p/f2p_capability_surface_test.go::TestChildCapabilityPresentOnEveryNodeKind",
+    "tests/f2p/f2p_capability_surface_test.go::TestChildCapabilityUniformMethodAcrossNodeKinds",
+    "tests/f2p/f2p_capability_surface_test.go::TestFirstTokenCapabilityPresentOnEveryNodeKind",
+    "tests/f2p/f2p_capability_surface_test.go::TestFirstTokenCapabilityUniformMethodAcrossNodeKinds",
+    "tests/f2p/f2p_capability_surface_test.go::TestChildCapabilityPresentOnEveryParsedNodeKind",
+    "tests/f2p/f2p_capability_surface_test.go::TestFirstTokenCapabilityPresentOnEveryParsedNodeKind",
+    "tests/f2p/f2p_child_semantics_test.go::TestChildCapabilityMatchesWalkChildrenForScalarKinds",
+    "tests/f2p/f2p_child_semantics_test.go::TestChildCapabilityMatchesWalkChildrenForMappingKinds",
+    "tests/f2p/f2p_child_semantics_test.go::TestChildCapabilityMatchesWalkChildrenForSequenceKinds",
+    "tests/f2p/f2p_child_semantics_test.go::TestChildCapabilityMatchesWalkChildrenForWrapperKinds",
+    "tests/f2p/f2p_child_semantics_test.go::TestChildCapabilityKeepsCommentKindsAsLeaves",
+    "tests/f2p/f2p_capability_consistency_test.go::TestChildCapabilityMatchesParentLookupForParsedTree",
+    "tests/f2p/f2p_capability_consistency_test.go::TestChildCapabilityOrderMatchesFilterOutput",
+    "tests/f2p/f2p_capability_consistency_test.go::TestChildCapabilityOrderMatchesFilterFileAcrossDocuments",
+    "tests/f2p/f2p_promoted_capability_test.go::TestTraversalConsumesNodeCapabilities",
+    "tests/f2p/f2p_promoted_capability_test.go::TestFormattingConsumesNodeCapabilities",
+    "tests/f2p/f2p_promoted_capability_test.go::TestKeyExtractionConsumesNodeCapabilities",
+    "tests/f2p/f2p_promoted_capability_test.go::TestDecodingConsumesNodeCapabilities",
+    "tests/f2p/f2p_first_token_test.go::TestFirstTokenCapabilityMatchesScalarAndMergeKeyTokens",
+    "tests/f2p/f2p_first_token_test.go::TestFirstTokenCapabilityMatchesMappingHeadRules",
+    "tests/f2p/f2p_first_token_test.go::TestFirstTokenCapabilityMatchesWrapperHeadRules",
+    "tests/f2p/f2p_first_token_test.go::TestFirstTokenCapabilityIsNilForHeadlessKinds",
+)
+
+CONFIG_ENV_KEYS = ("VERIFIER_CONFIG", "F2P_CONFIG", "F2P_CONFIG_FILE", "VERIFIER_F2P_CONFIG", "CONFIG_PATH")
+SELECT_ENV_KEYS = ("F2P_SELECT", "F2P_SELECT_FILE", "VERIFIER_F2P_SELECT", "SELECTOR_FILE")
+CONFIG_FILE_NAMES = ("config.json",)
+SELECTOR_FILE_NAMES = ("f2p_select.txt", "f2p_select")
+P2P_SELECTOR_FILE_NAMES = ("p2p_select.txt", "p2p_select")
+
+PLACEHOLDER_RE = re.compile(r"^\{[^{}]+\}$")
+
+
+def fail(message: str, code: int = 2) -> "None":
+    sys.stderr.write("f2p_junit_runner: %s\n" % message)
+    raise SystemExit(code)
+
+
+def find_go() -> str:
+    go = shutil.which("go")
+    if go:
+        return go
+    for candidate in (
+        "/opt/envpipe/runtime/bin/go",
+        "/usr/local/go/bin/go",
+        "/usr/lib/go/bin/go",
+    ):
+        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    fail("go toolchain not found on PATH or in known image locations")
+
+
+def find_repo_root() -> Path:
+    script_dir = Path(__file__).resolve().parent
+    for base in (script_dir, Path.cwd()):
+        for candidate in (base,) + tuple(base.parents):
+            if (candidate / "go.mod").is_file():
+                return candidate
+    return script_dir.parent
+
+
+class SelectorError(RuntimeError):
+    """Raised when a selector source is unreadable or malformed."""
+
+
+def parse_selector_text(text: str):
+    selectors = []
+    seen = set()
+    for raw in text.splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        if "::" not in line:
+            raise SelectorError("invalid selector (missing '::'): %r" % line)
+        file_part, leaf = line.split("::", 1)
+        if not file_part.strip() or not leaf.strip():
+            raise SelectorError("invalid selector: %r" % line)
+        if line in seen:
+            continue
+        seen.add(line)
+        selectors.append(line)
+    if not selectors:
+        raise SelectorError("selector source contains no selectors")
+    return selectors
+
+
+def read_selector_file(path: Path):
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as exc:
+        raise SelectorError("cannot read selector file %s: %s" % (path, exc))
+    return parse_selector_text(text)
+
+
+def collect_selector_strings(value):
+    found = []
+    if isinstance(value, str):
+        if "::" in value:
+            found.append(value.strip())
+    elif isinstance(value, list):
+        for item in value:
+            found.extend(collect_selector_strings(item))
+    elif isinstance(value, dict):
+        for key in ("selector", "test"):
+            if isinstance(value.get(key), str):
+                found.extend(collect_selector_strings(value[key]))
+        for key in ("tests", "selectors", "selection"):
+            if key in value:
+                found.extend(collect_selector_strings(value[key]))
+        for key in ("selector", "test", "tests", "selectors", "selection"):
+            value.pop(key, None)
+        for item in value.values():
+            found.extend(collect_selector_strings(item))
+    return found
+
+
+def collect_role_selectors(value, keys):
+    found = []
+    if isinstance(value, dict):
+        for key in keys:
+            if key in value:
+                found.extend(collect_selector_strings(value[key]))
+        for key, item in value.items():
+            if key in keys:
+                continue
+            found.extend(collect_role_selectors(item, keys))
+    elif isinstance(value, list):
+        for item in value:
+            found.extend(collect_role_selectors(item, keys))
+    return found
+
+
+def collect_gate_selectors(value):
+    found = []
+    if isinstance(value, dict):
+        kind = str(value.get("kind", "")).upper()
+        if kind in ("P2P", "F2P") and isinstance(value.get("tests"), list):
+            found.extend(collect_selector_strings(value["tests"]))
+        for item in value.values():
+            found.extend(collect_gate_selectors(item))
+    elif isinstance(value, list):
+        for item in value:
+            found.extend(collect_gate_selectors(item))
+    return found
+
+
+def dedupe(selectors):
+    out = []
+    seen = set()
+    for selector in selectors:
+        selector = (selector or "").strip()
+        if selector and selector not in seen:
+            seen.add(selector)
+            out.append(selector)
+    return out
+
+
+def read_selector_config(path: Path):
+    import copy
+
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise SelectorError("cannot read selector config %s: %s" % (path, exc))
+    selectors = []
+    for role in ("p2p", "f2p"):
+        snapshot = copy.deepcopy(data)
+        role_selectors = dedupe(collect_role_selectors(snapshot, ROLE_KEYS[role]))
+        if not role_selectors:
+            snapshot = copy.deepcopy(data)
+            role_selectors = dedupe(collect_role_selectors(snapshot, FALLBACK_KEYS))
+        selectors.extend(role_selectors)
+    selectors.extend(dedupe(collect_gate_selectors(copy.deepcopy(data))))
+    # Metadata such as selector_format="path::testcase" is not a test.
+    if not selectors:
+        selectors.extend(dedupe(collect_selector_strings(copy.deepcopy(data))))
+    selectors = dedupe(selectors)
+    if not selectors:
+        raise SelectorError("selector config %s declares no selectors" % path)
+    return selectors
+
+
+def ascend(base: Path, depth: int = 4):
+    base = Path(os.path.abspath(str(base)))
+    yield base
+    for _ in range(depth):
+        parent = base.parent
+        if parent == base:
+            return
+        base = parent
+        yield base
+
+
+def well_known_configs(root: Path, script_dir: Path):
+    seen = set()
+    bases = []
+    for anchor in (script_dir, root, Path.cwd()):
+        bases.extend(ascend(anchor))
+    bases.extend([Path("/workspace"), Path("/workspace/verifier"), Path("/verifier"), Path("/")])
+    for base in bases:
+        base = Path(os.path.abspath(str(base)))
+        if base in seen:
+            continue
+        seen.add(base)
+        for name in CONFIG_FILE_NAMES:
+            yield base / name
+
+
+def well_known_files(names, root: Path, script_dir: Path):
+    seen = set()
+    for base in (script_dir, script_dir.parent, root, root / "verifier", Path.cwd()):
+        base = Path(os.path.abspath(str(base)))
+        if base in seen:
+            continue
+        seen.add(base)
+        for name in names:
+            yield base / name
+
+
+def resolve_selectors(explicit_config: str, explicit_select: str, root: Path, script_dir: Path, warn):
+    explicit_config = (explicit_config or "").strip()
+    explicit_select = (explicit_select or "").strip()
+    config_candidates = []
+    if explicit_config and not PLACEHOLDER_RE.match(explicit_config):
+        config_candidates.append(Path(explicit_config))
+    for key in CONFIG_ENV_KEYS:
+        value = os.environ.get(key, "").strip()
+        if value and not PLACEHOLDER_RE.match(value):
+            config_candidates.append(Path(value))
+    config_candidates.extend(well_known_configs(root, script_dir))
+    seen = set()
+    for path in config_candidates:
+        path = Path(os.path.abspath(str(path)))
+        if path in seen:
+            continue
+        seen.add(path)
+        if path.is_file():
+            try:
+                return read_selector_config(path), str(path)
+            except SelectorError as exc:
+                warn(str(exc))
+
+    select_candidates = []
+    if explicit_select and not PLACEHOLDER_RE.match(explicit_select):
+        select_candidates.append(Path(explicit_select))
+    for key in SELECT_ENV_KEYS:
+        value = os.environ.get(key, "").strip()
+        if value and not PLACEHOLDER_RE.match(value):
+            select_candidates.append(Path(value))
+    select_candidates.extend(well_known_files(SELECTOR_FILE_NAMES, root, script_dir))
+    for path in select_candidates:
+        if path.is_file():
+            try:
+                return read_selector_file(path), str(path)
+            except SelectorError as exc:
+                warn(str(exc))
+
+    fallback = list(DECLARED_F2P_SELECTORS)
+    p2p_source = ""
+    for path in well_known_files(P2P_SELECTOR_FILE_NAMES, root, script_dir):
+        if path.is_file():
+            try:
+                fallback = read_selector_file(path) + fallback
+                p2p_source = str(path)
+                break
+            except SelectorError as exc:
+                warn(str(exc))
+    warn(
+        "no verifier config resolved; using the embedded frozen F2P catalog (%d selectors)%s"
+        % (
+            len(DECLARED_F2P_SELECTORS),
+            " plus %s" % p2p_source if p2p_source else " without a P2P selector file",
+        )
+    )
+    return dedupe(fallback), "embedded-f2p-catalog"
+
+
+def run_pattern(leaf: str) -> str:
+    parts = leaf.split("/")
+    return "/".join("^(%s)$" % re.escape(part) for part in parts)
+
+
+EXEC_PROBE_TEXT = "#!/bin/sh\nexit 0\n"
+
+
+def probe_exec(base: Path) -> bool:
+    try:
+        base.mkdir(parents=True, exist_ok=True)
+    except OSError:
+        return False
+    probe = base / ("exec-probe-%d.sh" % os.getpid())
+    try:
+        probe.write_text(EXEC_PROBE_TEXT, encoding="utf-8")
+        os.chmod(str(probe), 0o755)
+        proc = subprocess.run(
+            [str(probe)],
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            timeout=15,
+        )
+        return proc.returncode == 0
+    except (OSError, subprocess.SubprocessError):
+        return False
+    finally:
+        try:
+            probe.unlink()
+        except OSError:
+            pass
+
+
+def resolve_exec_root(tmp_root: Path, warn) -> Path:
+    candidates = []
+    exec_dir = (os.environ.get("VERIFIER_EXEC_DIR") or "").strip()
+    if exec_dir and not PLACEHOLDER_RE.match(exec_dir):
+        candidates.append((Path(exec_dir), "VERIFIER_EXEC_DIR"))
+    candidates.append((Path(tmp_root), "TMPDIR"))
+    for fallback in ("/tmp", "/var/tmp", "/run"):
+        candidates.append((Path(fallback), fallback))
+    for base, label in candidates:
+        if probe_exec(base):
+            if exec_dir and label != "VERIFIER_EXEC_DIR":
+                warn("VERIFIER_EXEC_DIR %s is not exec-capable; using %s" % (exec_dir, base))
+            return base
+    warn("no exec-capable temporary directory could be verified; using TMPDIR")
+    return Path(tmp_root)
+
+
+def go_env(tmp_root: Path, exec_root: Path) -> tuple:
+    env = dict(os.environ)
+    env.setdefault("GO111MODULE", "on")
+    env["GOTOOLCHAIN"] = "local"
+    env["GOPROXY"] = "off"
+    env["GOFLAGS"] = "-mod=readonly"
+    env["GOWORK"] = "off"
+    cache = tmp_root / "go-build-cache"
+    gopath = tmp_root / "go-path"
+    cache.mkdir(parents=True, exist_ok=True)
+    (gopath / "pkg" / "mod").mkdir(parents=True, exist_ok=True)
+    work = exec_root / ("f2p-go-work-%d" % os.getpid())
+    work.mkdir(parents=True, exist_ok=True)
+    env["GOCACHE"] = str(cache)
+    env["GOPATH"] = str(gopath)
+    env["GOMODCACHE"] = str(gopath / "pkg" / "mod")
+    env["GOTMPDIR"] = str(work)
+    env["CGO_ENABLED"] = "0"
+    return env, work
+
+
+class PackageRun:
+    def __init__(self, pkg_dir: str):
+        self.pkg_dir = pkg_dir
+        self.results = {}
+        self.build_output = []
+        self.build_failed = False
+        self.process_error = ""
+        self.elapsed = 0.0
+
+
+def run_package(go: str, root: Path, env: dict, pkg_dir: str, leaves, timeout: int) -> PackageRun:
+    run = PackageRun(pkg_dir)
+    pattern = "^(" + "|".join(re.escape(leaf) for leaf in sorted(set(leaves))) + ")$"
+    cmd = [
+        go,
+        "test",
+        "-json",
+        "-count=1",
+        "-timeout",
+        "%ds" % max(timeout - 30, 30),
+        "-run",
+        pattern,
+        "./" + pkg_dir if pkg_dir not in ("", ".") else ".",
+    ]
+    started = time.time()
+    try:
+        proc = subprocess.run(
+            cmd,
+            cwd=str(root),
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        run.process_error = "go test timed out after %ds" % timeout
+        return run
+    except OSError as exc:
+        run.process_error = "cannot execute go test: %s" % exc
+        return run
+
+    stderr = proc.stderr.decode("utf-8", "replace")
+    if stderr.strip():
+        run.build_output.append(stderr.strip())
+
+    decoder = json.JSONDecoder()
+    stdout = proc.stdout.decode("utf-8", "replace")
+    idx = 0
+    length = len(stdout)
+    events = []
+    while idx < length:
+        while idx < length and stdout[idx] in " \t\r\n":
+            idx += 1
+        if idx >= length:
+            break
+        try:
+            obj, end = decoder.raw_decode(stdout, idx)
+        except ValueError:
+            break
+        events.append(obj)
+        idx = end
+
+    for ev in events:
+        action = ev.get("Action")
+        name = ev.get("Test")
+        out = ev.get("Output", "")
+        if not name:
+            if action in ("build-output", "build-fail"):
+                if out.strip():
+                    run.build_output.append(out.rstrip("\n"))
+                if action == "build-fail":
+                    run.build_failed = True
+                continue
+            if action == "output" and out.strip() and not out.startswith("=== RUN") and not out.startswith("ok ") and not out.startswith("FAIL"):
+                run.build_output.append(out.rstrip("\n"))
+            continue
+        entry = run.results.setdefault(name, {"status": None, "output": [], "elapsed": 0.0})
+        if action == "output":
+            entry["output"].append(out)
+        elif action in ("pass", "fail", "skip"):
+            entry["status"] = action
+            entry["elapsed"] = ev.get("Elapsed", 0.0)
+    if run.build_failed and not run.process_error:
+        run.process_error = "go test could not build the test package"
+    if proc.returncode != 0 and not run.results and not run.process_error:
+        run.process_error = "go test exited with status %d" % proc.returncode
+    if proc.returncode != 0 and stderr.strip() and run.process_error:
+        run.process_error += ": " + stderr.strip().splitlines()[0]
+    run.elapsed = time.time() - started
+    return run
+
+
+def testcase_for(selector: str, file_part: str, leaf: str, run: PackageRun) -> ET.Element:
+    case = ET.Element(
+        "testcase",
+        {
+            "classname": file_part,
+            "name": leaf,
+            "file": file_part,
+        },
+    )
+    props = ET.SubElement(case, "properties")
+    ET.SubElement(props, "property", {"name": "selector", "value": selector})
+    entry = run.results.get(leaf)
+    if entry is None:
+        err = ET.SubElement(
+            case,
+            "error",
+            {"message": "selector did not produce a test result", "type": "NotRun"},
+        )
+        detail = run.process_error or "no go test event matched %r in package %r" % (leaf, run.pkg_dir)
+        err.text = detail + "\n" + "\n".join(run.build_output[-20:])
+        case.set("time", "0")
+        return case
+    case.set("time", "%.3f" % float(entry.get("elapsed") or 0.0))
+    status = entry.get("status")
+    output = "".join(entry.get("output") or [])
+    if status == "pass":
+        return case
+    if status == "skip":
+        err = ET.SubElement(case, "error", {"message": "test was skipped", "type": "Skipped"})
+        err.text = output
+        return case
+    # Only a completed native Go test failure is an assertion result. Preserve
+    # incomplete, operational and runtime-crash evidence for strict classification.
+    assertion_failure = (
+        status == "fail" and not run.process_error and bool(output.strip())
+        and not re.search(r"(?m)^(?:panic:|fatal error:|runtime:|\[signal )", output)
+    )
+    failure = ET.SubElement(
+        case,
+        "failure",
+        {"message": "go test reported failure",
+         "type": "AssertionError" if assertion_failure else "GoTestFailure"},
+    )
+    failure.text = output
+    return case
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="P2P+F2P JUnit runner")
+    ap.add_argument("--config", default="", help="path to the verifier config ({config})")
+    ap.add_argument("--select", default="", help="path to a selector list as a fallback")
+    ap.add_argument("--report", required=True, help="path of the JUnit report to write ({report})")
+    ap.add_argument("--timeout", type=int, default=180, help="per-package timeout in seconds")
+    args = ap.parse_args()
+
+    def warn(message: str) -> None:
+        sys.stderr.write("f2p_junit_runner: %s\n" % message)
+
+    script_dir = Path(__file__).resolve().parent
+    root = find_repo_root()
+    selector_lines, source = resolve_selectors(args.config, args.select, root, script_dir, warn)
+    warn("selector source: %s (%d selectors)" % (source, len(selector_lines)))
+
+    selectors = []
+    seen = set()
+    for line in selector_lines:
+        if "::" not in line:
+            fail("invalid selector (missing '::'): %r" % line)
+        file_part, leaf = line.split("::", 1)
+        file_part, leaf = file_part.strip(), leaf.strip()
+        if not file_part or not leaf:
+            fail("invalid selector: %r" % line)
+        if line in seen:
+            continue
+        seen.add(line)
+        selectors.append((line, file_part, leaf))
+    if not selectors:
+        fail("no selectors to execute")
+
+    tmp_root = Path(os.environ.get("TMPDIR") or "/tmp")
+    exec_root = resolve_exec_root(tmp_root, warn)
+    env, work_dir = go_env(tmp_root, exec_root)
+    atexit.register(shutil.rmtree, str(work_dir), ignore_errors=True)
+    go = find_go()
+
+    by_package = {}
+    for selector, file_part, leaf in selectors:
+        pkg_dir = os.path.dirname(file_part)
+        if pkg_dir in ("", "."):
+            pkg_dir = "."
+        if not (root / file_part).is_file():
+            fail("selector file %s does not exist in the repository" % file_part)
+        by_package.setdefault(pkg_dir, []).append((selector, file_part, leaf))
+
+    suites = []
+    total = failures = errors = 0
+    started = time.time()
+    for pkg_dir, items in sorted(by_package.items()):
+        run = run_package(go, root, env, pkg_dir, [leaf for _, _, leaf in items], args.timeout)
+        suite = ET.Element(
+            "testsuite",
+            {
+                "name": pkg_dir,
+                "package": pkg_dir,
+            },
+        )
+        s_tests = s_failures = s_errors = 0
+        for selector, file_part, leaf in items:
+            case = testcase_for(selector, file_part, leaf, run)
+            suite.append(case)
+            s_tests += 1
+            if case.find("failure") is not None:
+                s_failures += 1
+            elif case.find("error") is not None:
+                s_errors += 1
+            status = run.results.get(leaf, {}).get("status", "notrun")
+            print("%-6s %s" % (str(status).upper(), selector))
+        suite.set("tests", str(s_tests))
+        suite.set("failures", str(s_failures))
+        suite.set("errors", str(s_errors))
+        suite.set("skipped", "0")
+        suite.set("time", "%.3f" % run.elapsed)
+        suites.append(suite)
+        total += s_tests
+        failures += s_failures
+        errors += s_errors
+
+    root_el = ET.Element(
+        "testsuites",
+        {
+            "name": "p2p-f2p",
+            "tests": str(total),
+            "failures": str(failures),
+            "errors": str(errors),
+            "skipped": "0",
+            "time": "%.3f" % (time.time() - started),
+        },
+    )
+    for suite in suites:
+        root_el.append(suite)
+    tree = ET.ElementTree(root_el)
+    try:
+        ET.indent(tree, space="  ")
+    except AttributeError:
+        pass
+    report_path = Path(args.report)
+    if report_path.parent != Path(""):
+        report_path.parent.mkdir(parents=True, exist_ok=True)
+    tmp_report = report_path.with_name(report_path.name + ".tmp")
+    tree.write(str(tmp_report), encoding="UTF-8", xml_declaration=True)
+    os.replace(str(tmp_report), str(report_path))
+
+    print(
+        "f2p_junit_runner: wrote %s (tests=%d failures=%d errors=%d)"
+        % (report_path, total, failures, errors)
+    )
+    return 1 if failures or errors else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
