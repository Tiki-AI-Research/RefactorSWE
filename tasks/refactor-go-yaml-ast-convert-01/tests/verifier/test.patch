+++ b/tests/f2p/dispatch/main.go
@@ -0,0 +1,570 @@
+// Resolve production Go symbols and callable edges. Generated evaluator bridges
+// and candidate tests are excluded; private helper names are not gate inputs.
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	syntax "go/ast"
+	"go/importer"
+	"go/parser"
+	"go/printer"
+	"go/token"
+	"go/types"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+const module = "github.com/goccy/go-yaml"
+
+var kinds = strings.Fields("DocumentNode NullNode BoolNode IntegerNode FloatNode InfinityNode NanNode StringNode MergeKeyNode LiteralNode MappingNode MappingKeyNode MappingValueNode SequenceNode SequenceEntryNode AnchorNode AliasNode DirectiveNode TagNode CommentNode CommentGroupNode")
+
+type packageMeta struct {
+	ImportPath, Dir, Export string
+	GoFiles                 []string
+}
+type sourcePackage struct {
+	P     *types.Package
+	Info  *types.Info
+	Files []*syntax.File
+}
+type loader struct {
+	meta   map[string]packageMeta
+	source map[string]*sourcePackage
+	binary types.Importer
+	fs     *token.FileSet
+}
+
+func (l *loader) Import(path string) (*types.Package, error) {
+	if p := l.source[path]; p != nil && p.P != nil {
+		return p.P, nil
+	}
+	if path != module && !strings.HasPrefix(path, module+"/") {
+		return l.binary.Import(path)
+	}
+	m, ok := l.meta[path]
+	if !ok {
+		return nil, fmt.Errorf("missing package %s", path)
+	}
+	info := &types.Info{Types: map[syntax.Expr]types.TypeAndValue{}, Defs: map[*syntax.Ident]types.Object{}, Uses: map[*syntax.Ident]types.Object{}, Selections: map[*syntax.SelectorExpr]*types.Selection{}}
+	var files []*syntax.File
+	for _, name := range m.GoFiles {
+		if name == "zz_benchmark_capabilities.go" {
+			continue
+		}
+		f, e := parser.ParseFile(l.fs, filepath.Join(m.Dir, name), nil, 0)
+		if e != nil {
+			return nil, e
+		}
+		files = append(files, f)
+	}
+	cfg := types.Config{Importer: l}
+	p, e := cfg.Check(path, l.fs, files, info)
+	if e != nil {
+		return nil, e
+	}
+	l.source[path] = &sourcePackage{p, info, files}
+	return p, nil
+}
+
+type function struct {
+	Key, Package, Name, Position, SourceHash string
+	Obj                                      *types.Func
+	Sig                                      *types.Signature
+	Body                                     *syntax.BlockStmt
+	Info                                     *types.Info
+	Edges                                    map[string]bool
+	Roles                                    map[string]bool
+	Residue                                  []string
+}
+
+func namedNode(t types.Type) string {
+	if p, ok := t.(*types.Pointer); ok {
+		t = p.Elem()
+	}
+	n, ok := types.Unalias(t).(*types.Named)
+	if !ok || n.Obj().Pkg() == nil || n.Obj().Pkg().Path() != module+"/ast" {
+		return ""
+	}
+	for _, k := range kinds {
+		if n.Obj().Name() == k {
+			return k
+		}
+	}
+	return ""
+}
+func isNode(t types.Type) bool {
+	n, ok := types.Unalias(t).(*types.Named)
+	return ok && n.Obj().Pkg() != nil && n.Obj().Pkg().Path() == module+"/ast" && n.Obj().Name() == "Node"
+}
+func isToken(t types.Type) bool {
+	p, ok := t.(*types.Pointer)
+	if !ok {
+		return false
+	}
+	n, ok := types.Unalias(p.Elem()).(*types.Named)
+	return ok && n.Obj().Pkg() != nil && n.Obj().Pkg().Path() == module+"/token" && n.Obj().Name() == "Token"
+}
+func childCallback(t types.Type) bool {
+	if sig, ok := t.Underlying().(*types.Signature); ok && sig.Params().Len() == 1 {
+		x := sig.Params().At(0).Type()
+		if isNode(x) {
+			return true
+		}
+		if st, ok := x.Underlying().(*types.Struct); ok {
+			for i := 0; i < st.NumFields(); i++ {
+				if isNode(st.Field(i).Type()) {
+					return true
+				}
+			}
+		}
+	}
+	if it, ok := t.Underlying().(*types.Interface); ok && it.NumMethods() == 1 {
+		sig := it.Method(0).Type().(*types.Signature)
+		r := sig.Results()
+		return sig.Params().Len() == 1 && isNode(sig.Params().At(0).Type()) && (r.Len() == 0 || r.Len() == 1 && types.Identical(r.At(0).Type(), types.Typ[types.Bool]))
+	}
+	return false
+}
+func childSignature(sig *types.Signature) bool {
+	p, r := sig.Params(), sig.Results()
+	if p.Len() == 1 && childCallback(p.At(0).Type()) {
+		return true
+	}
+	if p.Len() == 1 && types.Identical(p.At(0).Type(), types.Typ[types.Int]) && r.Len() > 0 && isNode(r.At(0).Type()) {
+		return true
+	}
+	if p.Len() == 0 && r.Len() == 1 {
+		if s, ok := r.At(0).Type().(*types.Slice); ok && isNode(s.Elem()) {
+			return true
+		}
+		if st, ok := r.At(0).Type().Underlying().(*types.Struct); ok {
+			for i := 0; i < st.NumFields(); i++ {
+				if f, ok := st.Field(i).Type().Underlying().(*types.Signature); ok && f.Params().Len() == 1 && childCallback(f.Params().At(0).Type()) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// A single eligibility guard is compatible with keeping external embedded
+// Node implementations as leaves. It does not choose per-kind behavior.
+func membershipGuard(s *syntax.TypeSwitchStmt, info *types.Info) bool {
+	groups := 0
+	seen := map[string]bool{}
+	for _, clause := range s.Body.List {
+		c := clause.(*syntax.CaseClause)
+		if len(c.List) == 0 {
+			continue
+		}
+		groups++
+		for _, expr := range c.List {
+			kind := namedNode(info.TypeOf(expr))
+			if kind == "" {
+				return false
+			}
+			seen[kind] = true
+		}
+	}
+	return groups == 1 && len(seen) == len(kinds)
+}
+func main() {
+	root, e := filepath.Abs(os.Args[1])
+	if e != nil {
+		panic(e)
+	}
+	if e = os.Chdir(root); e != nil {
+		panic(e)
+	}
+	cmd := exec.Command("go", "list", "-deps", "-export", "-json", ".", "./ast", "./parser", "./internal/format")
+	raw, e := cmd.Output()
+	if e != nil {
+		panic(e)
+	}
+	l := &loader{meta: map[string]packageMeta{}, source: map[string]*sourcePackage{}, fs: token.NewFileSet()}
+	dec := json.NewDecoder(strings.NewReader(string(raw)))
+	for {
+		var m packageMeta
+		if e = dec.Decode(&m); e == io.EOF {
+			break
+		}
+		if e != nil {
+			panic(e)
+		}
+		l.meta[m.ImportPath] = m
+	}
+	l.binary = importer.ForCompiler(l.fs, "gc", func(path string) (io.ReadCloser, error) { return os.Open(l.meta[path].Export) })
+	for _, p := range []string{module, module + "/ast", module + "/parser", module + "/internal/format"} {
+		if _, e = l.Import(p); e != nil {
+			panic(e)
+		}
+	}
+	funcs := map[string]*function{}
+	objects := map[*types.Func]string{}
+	literals := map[*syntax.FuncLit]string{}
+	values := map[types.Object]map[string]bool{}
+	for path, p := range l.source {
+		for _, file := range p.Files {
+			for _, d := range file.Decls {
+				f, ok := d.(*syntax.FuncDecl)
+				if !ok || f.Body == nil {
+					continue
+				}
+				obj := p.Info.Defs[f.Name].(*types.Func)
+				key := obj.FullName()
+				position := l.fs.Position(f.Pos())
+				rel, _ := filepath.Rel(root, position.Filename)
+				var canonical bytes.Buffer
+				if e := printer.Fprint(&canonical, l.fs, f); e != nil {
+					panic(e)
+				}
+				sourceHash := fmt.Sprintf("%x", sha256.Sum256(canonical.Bytes()))
+				funcs[key] = &function{Key: key, Package: path, Name: f.Name.Name, Position: fmt.Sprintf("%s:%d", rel, position.Line), SourceHash: sourceHash, Obj: obj, Sig: obj.Type().(*types.Signature), Body: f.Body, Info: p.Info, Edges: map[string]bool{}, Roles: map[string]bool{}}
+				objects[obj] = key
+				syntax.Inspect(f.Body, func(n syntax.Node) bool {
+					lit, ok := n.(*syntax.FuncLit)
+					if ok {
+						key := fmt.Sprintf("%s@%d", path, lit.Pos())
+						literals[lit] = key
+						funcs[key] = &function{Key: key, Package: path, Name: "closure", Position: l.fs.Position(lit.Pos()).String(), Sig: p.Info.TypeOf(lit).(*types.Signature), Body: lit.Body, Info: p.Info, Edges: map[string]bool{}, Roles: map[string]bool{}}
+					}
+					return true
+				})
+			}
+		}
+	}
+	// Exact source bindings for function values, including typed visitor fields.
+	valueTargets := func(expr syntax.Expr, info *types.Info) []string {
+		if lit, ok := expr.(*syntax.FuncLit); ok {
+			return []string{literals[lit]}
+		}
+		var obj types.Object
+		switch x := expr.(type) {
+		case *syntax.Ident:
+			obj = info.ObjectOf(x)
+		case *syntax.SelectorExpr:
+			if s := info.Selections[x]; s != nil {
+				obj = s.Obj()
+			} else {
+				obj = info.ObjectOf(x.Sel)
+			}
+		}
+		if f, ok := obj.(*types.Func); ok && objects[f] != "" {
+			return []string{objects[f]}
+		}
+		out := []string{}
+		for k := range values[obj] {
+			out = append(out, k)
+		}
+		return out
+	}
+	bind := func(obj types.Object, targets []string) {
+		if obj == nil {
+			return
+		}
+		if values[obj] == nil {
+			values[obj] = map[string]bool{}
+		}
+		for _, k := range targets {
+			if k != "" {
+				values[obj][k] = true
+			}
+		}
+	}
+	for iteration := 0; iteration < 4; iteration++ {
+		for _, p := range l.source {
+			for _, file := range p.Files {
+				syntax.Inspect(file, func(n syntax.Node) bool {
+					switch x := n.(type) {
+					case *syntax.AssignStmt:
+						if len(x.Lhs) == len(x.Rhs) {
+							for i, left := range x.Lhs {
+								var obj types.Object
+								switch v := left.(type) {
+								case *syntax.Ident:
+									obj = p.Info.ObjectOf(v)
+								case *syntax.SelectorExpr:
+									if s := p.Info.Selections[v]; s != nil {
+										obj = s.Obj()
+									}
+								}
+								bind(obj, valueTargets(x.Rhs[i], p.Info))
+							}
+						}
+					case *syntax.ValueSpec:
+						if len(x.Names) == len(x.Values) {
+							for i, id := range x.Names {
+								bind(p.Info.ObjectOf(id), valueTargets(x.Values[i], p.Info))
+							}
+						}
+					case *syntax.CompositeLit:
+						t := p.Info.TypeOf(x)
+						if pt, ok := t.(*types.Pointer); ok {
+							t = pt.Elem()
+						}
+						if st, ok := t.Underlying().(*types.Struct); ok {
+							for _, elem := range x.Elts {
+								kv, ok := elem.(*syntax.KeyValueExpr)
+								if !ok {
+									continue
+								}
+								id, ok := kv.Key.(*syntax.Ident)
+								if !ok {
+									continue
+								}
+								for i := 0; i < st.NumFields(); i++ {
+									if st.Field(i).Name() == id.Name {
+										bind(st.Field(i), valueTargets(kv.Value, p.Info))
+									}
+								}
+							}
+						}
+					}
+					return true
+				})
+			}
+		}
+	}
+	astPkg := l.source[module+"/ast"].P
+	common := map[string]int{}
+	allMethods := map[string][]*types.Func{}
+	for _, kind := range kinds {
+		t := astPkg.Scope().Lookup(kind).Type()
+		ms := types.NewMethodSet(types.NewPointer(t))
+		seen := map[string]bool{}
+		for i := 0; i < ms.Len(); i++ {
+			m := ms.At(i).Obj().(*types.Func)
+			if !seen[m.Name()] {
+				common[m.Name()]++
+				seen[m.Name()] = true
+			}
+			allMethods[m.Name()] = append(allMethods[m.Name()], m)
+		}
+	}
+	legacy := map[string]bool{}
+	for _, n := range strings.Fields("Type GetToken GetComment SetComment AddColumn GetPath SetPath String MarshalYAML Read readLen clearLen addReadLen") {
+		legacy[n] = true
+	}
+	for name, methods := range allMethods {
+		if common[name] != len(kinds) || legacy[name] {
+			continue
+		}
+		uniform := true
+		for _, m := range methods {
+			uniform = uniform && types.Identical(methods[0].Type(), m.Type())
+		}
+		if !uniform {
+			continue
+		}
+		for _, m := range methods {
+			f := funcs[objects[m]]
+			if f == nil {
+				continue
+			}
+			sig := m.Type().(*types.Signature)
+			if childSignature(sig) {
+				f.Roles["children"] = true
+			} else if sig.Params().Len() == 0 && sig.Results().Len() == 1 && isToken(sig.Results().At(0).Type()) {
+				f.Roles["first_token"] = true
+			} else if sig.Params().Len() > 0 {
+				f.Roles["visitor"] = true
+			} else {
+				f.Roles["behavior"] = true
+			}
+		}
+	}
+	var concrete []types.Type
+	for _, p := range l.source {
+		for _, name := range p.P.Scope().Names() {
+			obj, ok := p.P.Scope().Lookup(name).(*types.TypeName)
+			if !ok {
+				continue
+			}
+			t := obj.Type()
+			if _, ok := t.Underlying().(*types.Interface); ok {
+				continue
+			}
+			concrete = append(concrete, t, types.NewPointer(t))
+		}
+	}
+	for _, f := range funcs {
+		rawKinds := map[string]bool{}
+		syntax.Inspect(f.Body, func(n syntax.Node) bool {
+			if _, ok := n.(*syntax.FuncLit); ok {
+				return false
+			}
+			if a, ok := n.(*syntax.TypeAssertExpr); ok && a.Type != nil {
+				if kind := namedNode(f.Info.TypeOf(a.Type)); kind != "" {
+					rawKinds[kind] = true
+				}
+			}
+			if s, ok := n.(*syntax.TypeSwitchStmt); ok && !membershipGuard(s, f.Info) {
+				for _, clause := range s.Body.List {
+					for _, expr := range clause.(*syntax.CaseClause).List {
+						if kind := namedNode(f.Info.TypeOf(expr)); kind != "" {
+							rawKinds[kind] = true
+						}
+					}
+				}
+			}
+			if s, ok := n.(*syntax.SwitchStmt); ok {
+				for _, clause := range s.Body.List {
+					for _, expr := range clause.(*syntax.CaseClause).List {
+						syntax.Inspect(expr, func(n syntax.Node) bool {
+							if id, ok := n.(*syntax.Ident); ok {
+								if c, ok := f.Info.ObjectOf(id).(*types.Const); ok && c.Pkg() != nil && c.Pkg().Path() == module+"/ast" {
+									for _, kind := range kinds {
+										if c.Name() == strings.TrimSuffix(kind, "Node")+"Type" {
+											rawKinds[kind] = true
+										}
+									}
+								}
+							}
+							return true
+						})
+					}
+				}
+			}
+			call, ok := n.(*syntax.CallExpr)
+			if !ok {
+				return true
+			}
+			for _, k := range valueTargets(call.Fun, f.Info) {
+				f.Edges[k] = true
+			}
+			if selector, ok := call.Fun.(*syntax.SelectorExpr); ok {
+				if selection := f.Info.Selections[selector]; selection != nil {
+					if method, ok := selection.Obj().(*types.Func); ok {
+						recv := selection.Recv()
+						if p, ok := recv.(*types.Pointer); ok {
+							recv = p.Elem()
+						}
+						if iface, ok := recv.Underlying().(*types.Interface); ok {
+							for _, typ := range concrete {
+								if types.Implements(typ, iface) {
+									if actual := types.NewMethodSet(typ).Lookup(method.Pkg(), method.Name()); actual != nil {
+										if target, ok := actual.Obj().(*types.Func); ok && objects[target] != "" {
+											f.Edges[objects[target]] = true
+										}
+									}
+								}
+							}
+						}
+					}
+				}
+			}
+			return true
+		})
+		// A list of alternatives is dispatch residue, not a code-size heuristic.
+		// Void comment-attachment policies are outside common value conversion.
+		if len(rawKinds) > 1 && f.Sig.Results().Len() > 0 {
+			for k := range rawKinds {
+				f.Residue = append(f.Residue, k)
+			}
+			sort.Strings(f.Residue)
+		}
+	}
+	groups := map[string]struct {
+		Package  string
+		Roots    []string
+		Required []string
+	}{
+		"traversal":  {module + "/ast", []string{"Walk", "Parent", "Filter", "FilterFile"}, []string{"children"}},
+		"formatting": {module + "/internal/format", []string{"FormatNode", "FormatNodeWithResolvedAlias", "FormatFile"}, []string{"first_token", "visitor"}},
+		"keys":       {module + "/parser", []string{"Parse", "ParseBytes", "ParseFile"}, []string{"visitor|behavior|first_token"}},
+		"decoding":   {module, []string{"Decode", "DecodeContext", "DecodeFromNode", "DecodeFromNodeContext"}, []string{"visitor"}},
+	}
+	results := map[string]any{}
+	frozenOutside := map[string]string{}
+	if raw, e := os.ReadFile("tests/testdata/case30_nontransition_functions.json"); e == nil {
+		if e = json.Unmarshal(raw, &frozenOutside); e != nil {
+			panic(e)
+		}
+	} else if !os.IsNotExist(e) {
+		panic(e)
+	}
+	for role, g := range groups {
+		roots := []string{}
+		for k, f := range funcs {
+			if f.Package != g.Package {
+				continue
+			}
+			for _, n := range g.Roots {
+				if f.Name == n {
+					roots = append(roots, k)
+				}
+			}
+		}
+		sort.Strings(roots)
+		checks := []map[string]any{}
+		pass := len(roots) == len(g.Roots)
+		for _, root := range roots {
+			visited := map[string]bool{}
+			roles := map[string]bool{}
+			residue := []map[string]any{}
+			var walk func(string)
+			walk = func(k string) {
+				if visited[k] {
+					return
+				}
+				visited[k] = true
+				f := funcs[k]
+				if f == nil {
+					return
+				}
+				for r := range f.Roles {
+					roles[r] = true
+				}
+				relevant := f.Package == g.Package
+				if role == "keys" {
+					relevant = relevant && f.Sig.Results().Len() == 1 && types.Identical(f.Sig.Results().At(0).Type(), types.Typ[types.String])
+				}
+				if role == "decoding" && f.SourceHash != "" && frozenOutside[k] == f.SourceHash {
+					relevant = false
+				}
+				if relevant && len(f.Residue) > 0 {
+					residue = append(residue, map[string]any{"function": k, "position": f.Position, "node_alternatives": f.Residue})
+				}
+				for target := range f.Edges {
+					walk(target)
+				}
+			}
+			walk(root)
+			missing := []string{}
+			for _, required := range g.Required {
+				found := false
+				for _, alternative := range strings.Split(required, "|") {
+					found = found || roles[alternative]
+				}
+				if !found {
+					missing = append(missing, required)
+				}
+			}
+			ok := len(missing) == 0 && len(residue) == 0
+			pass = pass && ok
+			sort.Slice(residue, func(i, j int) bool { return fmt.Sprint(residue[i]["function"]) < fmt.Sprint(residue[j]["function"]) })
+			checks = append(checks, map[string]any{"root": root, "pass": ok, "missing_capabilities": missing, "reachable_roles": roles, "dispatch_residue": residue})
+		}
+		results[role] = map[string]any{"pass": pass, "roots": checks}
+	}
+	catalog := map[string]any{}
+	for key, f := range funcs {
+		if f.SourceHash != "" {
+			catalog[key] = map[string]string{"position": f.Position, "source_sha256": f.SourceHash}
+		}
+	}
+	out := map[string]any{"schema": "case30-typed-dispatch-v1", "groups": results, "production_functions": len(funcs), "excluded_generated_bridges": true, "source_functions": catalog, "frozen_nontransition_functions": frozenOutside}
+	b, e := json.MarshalIndent(out, "", "  ")
+	if e != nil {
+		panic(e)
+	}
+	fmt.Println(string(b))
+}
