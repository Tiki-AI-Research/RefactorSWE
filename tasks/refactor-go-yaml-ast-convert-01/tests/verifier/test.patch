+const counterSource = `
+var qcObservedVisits = map[Node]int{}
+func QCResetVisits() { qcObservedVisits = map[Node]int{} }
+func QCVisits() map[Node]int { return qcObservedVisits }
+func qcObserveVisit(v Visitor, n Node) Visitor {
+ if n != nil { qcObservedVisits[n]++ }
+ return v.Visit(n)
+}
+func qcBindVisit(v Visitor) func(Node) Visitor {
+ return func(n Node) Visitor { return qcObserveVisit(v, n) }
+}
+`
