+package p2p_test
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	p2p "github.com/goccy/go-yaml/tests"
+)
+
+// TestExportedAPISurfacePreserved pins the exported API surface of every
+// importable module package: no exported function, method, type, constant or
+// variable may be removed, renamed or narrowed (signature/field/method-set
+// changes) by the refactor. Additions are allowed.
+func TestExportedAPISurfacePreserved(t *testing.T) {
+	fx := loadFixture(t)
+	var want map[string]p2p.SurfaceEntry
+	fixtureValue(t, fx, "api_surface", &want)
+
+	const root = ".."
+	for _, pkg := range p2p.APIPackages {
+		baseline := map[string]p2p.SurfaceEntry{}
+		for symbol, entry := range want {
+			// Keys are stored as "<pkgdir>|<symbol>".
+			parts := strings.SplitN(symbol, "|", 2)
+			if len(parts) != 2 || parts[0] != pkg {
+				continue
+			}
+			baseline[parts[1]] = entry
+		}
+		current, err := p2p.ExportedAPISurface(root, pkg)
+		if err != nil {
+			t.Fatalf("package %q: %v", pkg, err)
+		}
+		if len(baseline) == 0 {
+			t.Fatalf("fixture has no api_surface entries for package %q", pkg)
+		}
+		for _, problem := range p2p.CompareAPISurface(baseline, current) {
+			t.Fatalf("package %q: exported API regression: %s", pkg, problem)
+		}
+	}
+}
+
+// TestModuleDependencyGraphUnchanged pins REQ-INTEGRITY-003: the module must
+// not gain third-party dependencies or otherwise change its dependency graph.
+func TestModuleDependencyGraphUnchanged(t *testing.T) {
+	root := filepath.Join("..")
+	mod, err := os.ReadFile(filepath.Join(root, "go.mod"))
+	if err != nil {
+		t.Fatalf("read go.mod: %v", err)
+	}
+	for _, line := range strings.Split(string(mod), "\n") {
+		fields := strings.Fields(strings.TrimSpace(line))
+		if len(fields) == 0 {
+			continue
+		}
+		switch fields[0] {
+		case "require", "replace", "exclude", "retract":
+			t.Fatalf("go.mod dependency graph changed: %q", strings.TrimSpace(line))
+		}
+	}
+	sum, err := os.ReadFile(filepath.Join(root, "go.sum"))
+	if err != nil {
+		t.Fatalf("read go.sum: %v", err)
+	}
+	if strings.TrimSpace(string(sum)) != "" {
+		t.Fatalf("go.sum is no longer empty:\n%s", sum)
+	}
+}
