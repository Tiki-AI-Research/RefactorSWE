+package p2p_test
+
+import (
+	"testing"
+
+	p2p "github.com/goccy/go-yaml/tests"
+)
+
+// TestNodeMethodsForEveryNodeKind exercises the full Node interface (type
+// identification, token access, path get/set, comment get/set, text rendering,
+// YAML marshaling and read behaviour) on every node visited in the rich
+// fixture and compares the results with the frozen baseline snapshot.
+func TestNodeMethodsForEveryNodeKind(t *testing.T) {
+	fx := loadFixture(t)
+	var want []p2p.NodeMethodRecord
+	fixtureValue(t, fx, "node_methods", &want)
+
+	got, err := p2p.NodeMethodRecords()
+	check(t, err)
+	if len(got) != len(want) {
+		t.Fatalf("node count: want %d got %d", len(want), len(got))
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("node %d (%s) mismatch:\nwant %+v\ngot  %+v", i, want[i].Type, want[i], got[i])
+		}
+	}
+}
+
+// TestFormatOutputSnapshot pins the byte output of the public formatting entry
+// points for every fixture: node text rendering, YAML marshaling, printer
+// output, file rendering and the internal formatting path used when decoding
+// through a bytes unmarshaler.
+func TestFormatOutputSnapshot(t *testing.T) {
+	fx := loadFixture(t)
+	var want map[string]p2p.FormatResult
+	fixtureValue(t, fx, "format_output", &want)
+
+	got, err := p2p.FormatOutputRecords()
+	check(t, err)
+	for _, name := range p2p.CorpusNames {
+		expected, ok := want[name]
+		if !ok {
+			t.Fatalf("fixture has no format_output entry for %q", name)
+		}
+		if got[name] != expected {
+			t.Fatalf("%s: format output mismatch:\nwant %+v\ngot  %+v", name, expected, got[name])
+		}
+	}
+}
