+package f2p_test
+
+import (
+	"testing"
+
+	"github.com/goccy/go-yaml/ast"
+)
+
+var f2pFilterOrderTypes = []ast.NodeType{
+	ast.MappingType,
+	ast.MappingValueType,
+	ast.SequenceType,
+	ast.StringType,
+	ast.IntegerType,
+	ast.CommentType,
+}
+
+func f2pFilterByType(order []ast.Node, typ ast.NodeType) []ast.Node {
+	var out []ast.Node
+	for _, n := range order {
+		if n.Type() == typ {
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// TestChildCapabilityMatchesParentLookupForParsedTree ties the parent lookup
+// entry point to the child capability: every visited non-comment node must
+// appear in the child enumeration of the node ast.Parent reports, and every
+// enumerated non-comment child must resolve back to its enumerating parent.
+func TestChildCapabilityMatchesParentLookupForParsedTree(t *testing.T) {
+	file := f2pParseCorpus(t)
+	checked := 0
+	childrenChecked := 0
+	for _, doc := range file.Docs {
+		order := f2pWalkOrder(doc)
+		for _, node := range order {
+			if node == ast.Node(doc) {
+				continue
+			}
+			if node.Type() == ast.CommentType {
+				if parent := ast.Parent(doc, node); parent != nil {
+					t.Fatalf("parent lookup must keep comments parentless, comment %s resolved to %s", f2pNodeLabel(node), f2pNodeLabel(parent))
+				}
+				continue
+			}
+			parent := ast.Parent(doc, node)
+			if parent == nil {
+				t.Fatalf("parent lookup returned nil for visited node %s", f2pNodeLabel(node))
+			}
+			children, capability, ok := f2pTraversalChildren(parent)
+			if !ok {
+				t.Fatalf("parent lookup: node kind %T declares no child-enumeration capability (a method returning []ast.Node)", parent)
+			}
+			if !f2pContainsNode(children, node) {
+				t.Fatalf("parent lookup: capability %s of node %s does not enumerate its visited child %s",
+					capability.name, f2pNodeLabel(parent), f2pNodeLabel(node))
+			}
+			checked++
+		}
+		for _, parent := range order {
+			children, _, ok := f2pTraversalChildren(parent)
+			if !ok {
+				t.Fatalf("parent lookup: node kind %T declares no child-enumeration capability (a method returning []ast.Node)", parent)
+			}
+			for _, child := range children {
+				if child.Type() == ast.CommentType {
+					continue
+				}
+				if resolved := ast.Parent(doc, child); resolved != parent {
+					t.Fatalf("parent lookup: child %s enumerated by %s resolved to %s",
+						f2pNodeLabel(child), f2pNodeLabel(parent), f2pNodeLabel(resolved))
+				}
+				childrenChecked++
+			}
+		}
+	}
+	if checked == 0 || childrenChecked == 0 {
+		t.Fatalf("parent lookup consistency was not exercised: nodes=%d children=%d", checked, childrenChecked)
+	}
+}
+
+// f2pFrozenDepthFirst returns the depth-first visit order of the frozen
+// pre-refactor traversal, derived from the frozen structural-children rule
+// alone so it stays independent of the implementation under test: a node's
+// own comment group is visited first (except for comment kinds, which the
+// frozen walk keeps as leaves), followed by its frozen structural children.
+func f2pFrozenDepthFirst(root ast.Node) []ast.Node {
+	var out []ast.Node
+	var visit func(node ast.Node)
+	visit = func(node ast.Node) {
+		if node == nil {
+			return
+		}
+		out = append(out, node)
+		switch node.(type) {
+		case *ast.CommentNode, *ast.CommentGroupNode:
+			return
+		}
+		if comment := node.GetComment(); comment != nil {
+			visit(comment)
+		}
+		children, known := f2pFrozenStructuralChildren(node)
+		if !known {
+			return
+		}
+		for _, child := range children {
+			visit(child)
+		}
+	}
+	visit(root)
+	return out
+}
+
+// TestChildCapabilityOrderMatchesFilterOutput ties the typed filtering entry
+// point to the frozen traversal: for every document of the frozen corpus and
+// every covered node type, ast.Filter must return exactly the nodes the
+// frozen pre-refactor depth-first traversal yields for that type, in the same
+// order, and the order derived from the node capability graph alone must
+// reproduce that same sequence. Each covered node type must contribute at
+// least one matched node, so no declared type is compared vacuously.
+func TestChildCapabilityOrderMatchesFilterOutput(t *testing.T) {
+	file := f2pParseCorpus(t)
+	compared := map[ast.NodeType]int{}
+	for docIndex, doc := range file.Docs {
+		frozen := f2pFrozenDepthFirst(doc)
+		derived := f2pCapabilityDepthFirst(t, "filter", doc)
+		for _, typ := range f2pFilterOrderTypes {
+			frozenOrder := f2pFilterByType(frozen, typ)
+			derivedOrder := f2pFilterByType(derived, typ)
+			if !f2pSameNodes(derivedOrder, frozenOrder) {
+				t.Fatalf("filter(%s) document %d: capability traversal yields %s, the frozen traversal yields %s",
+					typ, docIndex, f2pNodeLabels(derivedOrder), f2pNodeLabels(frozenOrder))
+			}
+			got := ast.Filter(typ, doc)
+			if !f2pSameNodes(got, frozenOrder) {
+				t.Fatalf("filter(%s) document %d: ast.Filter returns %s, the frozen traversal yields %s",
+					typ, docIndex, f2pNodeLabels(got), f2pNodeLabels(frozenOrder))
+			}
+			compared[typ] += len(got)
+		}
+	}
+	for _, typ := range f2pFilterOrderTypes {
+		if compared[typ] == 0 {
+			t.Fatalf("filter order comparison for node type %s was not exercised by the F2P fixture corpus", typ)
+		}
+	}
+}
+
+// TestChildCapabilityOrderMatchesFilterFileAcrossDocuments ties the
+// multi-document filtering entry point to the child capability: the ordered
+// capability traversal of each document, concatenated, must reproduce exactly
+// the nodes ast.FilterFile reports.
+func TestChildCapabilityOrderMatchesFilterFileAcrossDocuments(t *testing.T) {
+	file := f2pParseCorpus(t)
+	if len(file.Docs) < 2 {
+		t.Fatalf("F2P fixture corpus must contain multiple documents, got %d", len(file.Docs))
+	}
+	perDocument := map[ast.NodeType][][]ast.Node{}
+	for _, doc := range file.Docs {
+		derived := f2pCapabilityDepthFirst(t, "filter-file", doc)
+		for _, typ := range []ast.NodeType{ast.MappingValueType, ast.SequenceType, ast.StringType} {
+			perDocument[typ] = append(perDocument[typ], f2pFilterByType(derived, typ))
+		}
+	}
+	for _, typ := range []ast.NodeType{ast.MappingValueType, ast.SequenceType, ast.StringType} {
+		var expected []ast.Node
+		documentsWithMatches := 0
+		for _, nodes := range perDocument[typ] {
+			if len(nodes) > 0 {
+				documentsWithMatches++
+			}
+			expected = append(expected, nodes...)
+		}
+		if documentsWithMatches < 2 {
+			t.Fatalf("filter-file(%s): F2P fixture corpus must exercise multiple documents, matched documents=%d", typ, documentsWithMatches)
+		}
+		got := ast.FilterFile(typ, file)
+		if !f2pSameNodes(expected, got) {
+			t.Fatalf("filter-file(%s): capability traversal across documents yields %s, ast.FilterFile returns %s",
+				typ, f2pNodeLabels(expected), f2pNodeLabels(got))
+		}
+	}
+}
diff --git a/tests/f2p/f2p_capability_surface_test.go b/tests/f2p/f2p_capability_surface_test.go
new file mode 100644
index 0000000..eb5b668
--- /dev/null
+++ b/tests/f2p/f2p_capability_surface_test.go
@@ -0,0 +1,173 @@
+package f2p_test
+
+import (
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/goccy/go-yaml/ast"
+)
+
+// TestChildCapabilityPresentOnEveryNodeKind requires every concrete node kind
+// shipped by the module to declare child enumeration once.
+func TestChildCapabilityPresentOnEveryNodeKind(t *testing.T) {
+	if len(f2pNodeKinds) == 0 {
+		t.Fatalf("F2P node-kind inventory is empty")
+	}
+	for _, kind := range f2pNodeKinds {
+		if _, ok := f2pChildrenCapability(kind.node); !ok {
+			t.Fatalf("node kind %s declares no child-enumeration capability (expected a method returning []ast.Node so traversal can enumerate children polymorphically)", kind.name)
+		}
+	}
+}
+
+// TestChildCapabilityUniformMethodAcrossNodeKinds requires the child
+// enumeration to be one capability implemented once per node kind, not a
+// per-kind collection of differently named helpers.
+func TestChildCapabilityUniformMethodAcrossNodeKinds(t *testing.T) {
+	namesByKind := map[string][]string{}
+	for _, kind := range f2pNodeKinds {
+		names := f2pChildCapabilityNames(reflect.TypeOf(kind.node))
+		if len(names) == 0 {
+			t.Fatalf("node kind %s declares no child-enumeration capability (expected a method returning []ast.Node)", kind.name)
+		}
+		namesByKind[kind.name] = names
+	}
+	uniform := f2pUniformCapabilityName(namesByKind)
+	if uniform == "" {
+		report := make([]string, 0, len(namesByKind))
+		for name, names := range namesByKind {
+			report = append(report, name+"="+strings.Join(names, "|"))
+		}
+		sort.Strings(report)
+		t.Fatalf("child-enumeration capability is not uniform across node kinds, every kind must implement the same capability: %s", strings.Join(report, ", "))
+	}
+}
+
+// TestFirstTokenCapabilityPresentOnEveryNodeKind requires every concrete node
+// kind to declare head-token lookup independently of the frozen GetToken.
+func TestFirstTokenCapabilityPresentOnEveryNodeKind(t *testing.T) {
+	if len(f2pNodeKinds) == 0 {
+		t.Fatalf("F2P node-kind inventory is empty")
+	}
+	for _, kind := range f2pNodeKinds {
+		if _, ok := f2pFirstTokenCapability(kind.node); !ok {
+			t.Fatalf("node kind %s declares no first-token capability (expected a method returning *token.Token distinct from GetToken so the formatter can look up its head token polymorphically)", kind.name)
+		}
+	}
+}
+
+// TestFirstTokenCapabilityUniformMethodAcrossNodeKinds requires the head-token
+// lookup to be one capability implemented once per node kind.
+func TestFirstTokenCapabilityUniformMethodAcrossNodeKinds(t *testing.T) {
+	namesByKind := map[string][]string{}
+	for _, kind := range f2pNodeKinds {
+		names := f2pFirstTokenCapabilityNames(reflect.TypeOf(kind.node))
+		if len(names) == 0 {
+			t.Fatalf("node kind %s declares no first-token capability (expected a method returning *token.Token distinct from GetToken)", kind.name)
+		}
+		namesByKind[kind.name] = names
+	}
+	uniform := f2pUniformCapabilityName(namesByKind)
+	if uniform == "" {
+		report := make([]string, 0, len(namesByKind))
+		for name, names := range namesByKind {
+			report = append(report, name+"="+strings.Join(names, "|"))
+		}
+		sort.Strings(report)
+		t.Fatalf("first-token capability is not uniform across node kinds, every kind must implement the same capability: %s", strings.Join(report, ", "))
+	}
+}
+
+var f2pRequiredCorpusKinds = []struct {
+	name string
+	typ  ast.NodeType
+}{
+	{"Document", ast.DocumentType},
+	{"Mapping", ast.MappingType},
+	{"MappingValue", ast.MappingValueType},
+	{"MappingKey", ast.MappingKeyType},
+	{"Sequence", ast.SequenceType},
+	{"Anchor", ast.AnchorType},
+	{"Alias", ast.AliasType},
+	{"Tag", ast.TagType},
+	{"Directive", ast.DirectiveType},
+	{"Literal", ast.LiteralType},
+	{"Null", ast.NullType},
+	{"Bool", ast.BoolType},
+	{"Integer", ast.IntegerType},
+	{"Float", ast.FloatType},
+	{"Infinity", ast.InfinityType},
+	{"Nan", ast.NanType},
+	{"String", ast.StringType},
+	{"MergeKey", ast.MergeKeyType},
+	{"Comment", ast.CommentType},
+}
+
+func f2pParsedKinds(t *testing.T) (map[string]reflect.Type, map[ast.NodeType]int) {
+	t.Helper()
+	file := f2pParseCorpus(t)
+	declared := map[string]reflect.Type{}
+	counts := map[ast.NodeType]int{}
+	for _, doc := range file.Docs {
+		for _, node := range f2pWalkOrder(doc) {
+			declared[reflect.TypeOf(node).String()] = reflect.TypeOf(node)
+			counts[node.Type()]++
+		}
+	}
+	if len(declared) == 0 {
+		t.Fatalf("F2P fixture corpus produced no visited nodes")
+	}
+	return declared, counts
+}
+
+func f2pRequireCorpusKinds(t *testing.T, counts map[ast.NodeType]int) {
+	t.Helper()
+	var missing []string
+	for _, required := range f2pRequiredCorpusKinds {
+		if counts[required.typ] == 0 {
+			missing = append(missing, required.name)
+		}
+	}
+	if len(missing) > 0 {
+		t.Fatalf("F2P fixture corpus did not exercise node kinds %s", strings.Join(missing, ", "))
+	}
+}
+
+// TestChildCapabilityPresentOnEveryParsedNodeKind requires the child
+// enumeration capability on every node kind the parser actually produces, not
+// only on the kinds enumerated statically.
+func TestChildCapabilityPresentOnEveryParsedNodeKind(t *testing.T) {
+	declared, counts := f2pParsedKinds(t)
+	f2pRequireCorpusKinds(t, counts)
+	var names []string
+	for name := range declared {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		node := reflect.New(declared[name].Elem()).Interface().(ast.Node)
+		if _, ok := f2pChildrenCapability(node); !ok {
+			t.Fatalf("parsed node kind %s declares no child-enumeration capability (expected a method returning []ast.Node)", name)
+		}
+	}
+}
+
+// TestFirstTokenCapabilityPresentOnEveryParsedNodeKind requires the head-token
+// capability on every node kind the parser actually produces.
+func TestFirstTokenCapabilityPresentOnEveryParsedNodeKind(t *testing.T) {
+	declared, counts := f2pParsedKinds(t)
+	f2pRequireCorpusKinds(t, counts)
+	var names []string
+	for name := range declared {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		node := reflect.New(declared[name].Elem()).Interface().(ast.Node)
+		if _, ok := f2pFirstTokenCapability(node); !ok {
+			t.Fatalf("parsed node kind %s declares no first-token capability (expected a method returning *token.Token distinct from GetToken)", name)
+		}
+	}
+}
diff --git a/tests/f2p/f2p_child_semantics_test.go b/tests/f2p/f2p_child_semantics_test.go
new file mode 100644
index 0000000..69a44a2
--- /dev/null
+++ b/tests/f2p/f2p_child_semantics_test.go
@@ -0,0 +1,154 @@
+package f2p_test
+
+import (
+	"testing"
+
+	"github.com/goccy/go-yaml/ast"
+)
+
+// TestChildCapabilityMatchesWalkChildrenForScalarKinds pins the scalar node
+// families: a scalar has no structural children, so the capability must
+// enumerate nothing (or only the scalar's own comment group).
+func TestChildCapabilityMatchesWalkChildrenForScalarKinds(t *testing.T) {
+	file := f2pParseCorpus(t)
+	_, order, observed := f2pCollectDocs(t, file)
+	scalars := f2pNodesWhere(order, func(n ast.Node) bool {
+		switch n.Type() {
+		case ast.NullType, ast.BoolType, ast.IntegerType, ast.FloatType,
+			ast.InfinityType, ast.NanType, ast.StringType, ast.MergeKeyType, ast.LiteralType:
+			return true
+		}
+		return false
+	})
+	if len(scalars) == 0 {
+		t.Fatalf("F2P fixture corpus produced no scalar nodes")
+	}
+	commented := 0
+	bare := 0
+	for _, node := range scalars {
+		if node.GetComment() != nil {
+			commented++
+		} else {
+			bare++
+		}
+		f2pAssertChildCapabilityMatchesTraversal(t, "scalar", node, observed[node])
+	}
+	if commented == 0 || bare == 0 {
+		t.Fatalf("F2P fixture corpus must exercise commented and bare scalars, got commented=%d bare=%d", commented, bare)
+	}
+}
+
+// TestChildCapabilityMatchesWalkChildrenForMappingKinds pins the mapping
+// families: a mapping enumerates its mapping values, a mapping value
+// enumerates key then value, and a mapping key enumerates the value it wraps.
+func TestChildCapabilityMatchesWalkChildrenForMappingKinds(t *testing.T) {
+	file := f2pParseCorpus(t)
+	_, order, observed := f2pCollectDocs(t, file)
+	nodes := f2pNodesWhere(order, func(n ast.Node) bool {
+		switch n.Type() {
+		case ast.MappingType, ast.MappingValueType, ast.MappingKeyType:
+			return true
+		}
+		return false
+	})
+	if len(nodes) == 0 {
+		t.Fatalf("F2P fixture corpus produced no mapping nodes")
+	}
+	kinds := map[ast.NodeType]int{}
+	for _, node := range nodes {
+		kinds[node.Type()]++
+		f2pAssertChildCapabilityMatchesTraversal(t, "mapping", node, observed[node])
+	}
+	for _, required := range []ast.NodeType{ast.MappingType, ast.MappingValueType, ast.MappingKeyType} {
+		if kinds[required] == 0 {
+			t.Fatalf("F2P fixture corpus produced no %s node", required)
+		}
+	}
+}
+
+// TestChildCapabilityMatchesWalkChildrenForSequenceKinds pins the sequence
+// families: a sequence enumerates its entries, while a sequence entry node is
+// a traversal leaf exactly as in the frozen walk.
+func TestChildCapabilityMatchesWalkChildrenForSequenceKinds(t *testing.T) {
+	file := f2pParseCorpus(t)
+	_, order, observed := f2pCollectDocs(t, file)
+	sequences := f2pNodesWhere(order, func(n ast.Node) bool { return n.Type() == ast.SequenceType })
+	if len(sequences) == 0 {
+		t.Fatalf("F2P fixture corpus produced no sequence nodes")
+	}
+	for _, node := range sequences {
+		f2pAssertChildCapabilityMatchesTraversal(t, "sequence", node, observed[node])
+	}
+
+	entryValue := f2pStringNode("entry-value")
+	entry := ast.SequenceEntry(f2pTestToken("-"), entryValue, nil)
+	synthetic := ast.Sequence(f2pTestToken("["), true)
+	synthetic.Values = []ast.Node{entry}
+	order = f2pWalkOrder(synthetic)
+	if f2pIndexNode(order, entry) < 0 {
+		t.Fatalf("synthetic sequence entry node was not visited by ast.Walk: %s", f2pNodeLabels(order))
+	}
+	if f2pIndexNode(order, entryValue) >= 0 {
+		t.Fatalf("frozen traversal must not descend into a sequence entry, visited order: %s", f2pNodeLabels(order))
+	}
+	observed = f2pObservedChildren(synthetic, order)
+	for _, node := range order {
+		switch node.Type() {
+		case ast.SequenceType, ast.SequenceEntryType:
+			f2pAssertChildCapabilityMatchesTraversal(t, "sequence", node, observed[node])
+		}
+	}
+}
+
+// TestChildCapabilityMatchesWalkChildrenForWrapperKinds pins the wrapper
+// families: documents enumerate their body, anchors name then value, aliases
+// and tags enumerate the wrapped value, directives enumerate name and values.
+func TestChildCapabilityMatchesWalkChildrenForWrapperKinds(t *testing.T) {
+	file := f2pParseCorpus(t)
+	_, order, observed := f2pCollectDocs(t, file)
+	nodes := f2pNodesWhere(order, func(n ast.Node) bool {
+		switch n.Type() {
+		case ast.DocumentType, ast.AnchorType, ast.AliasType, ast.TagType, ast.DirectiveType:
+			return true
+		}
+		return false
+	})
+	if len(nodes) == 0 {
+		t.Fatalf("F2P fixture corpus produced no wrapper nodes")
+	}
+	kinds := map[ast.NodeType]int{}
+	for _, node := range nodes {
+		kinds[node.Type()]++
+		f2pAssertChildCapabilityMatchesTraversal(t, "wrapper", node, observed[node])
+	}
+	for _, required := range []ast.NodeType{ast.DocumentType, ast.AnchorType, ast.AliasType, ast.TagType, ast.DirectiveType} {
+		if kinds[required] == 0 {
+			t.Fatalf("F2P fixture corpus produced no %s node", required)
+		}
+	}
+}
+
+// TestChildCapabilityKeepsCommentKindsAsLeaves pins comment handling: every
+// comment node is a traversal leaf, so its child enumeration must stay empty
+// and comment groups must not expose their inner comment nodes as children.
+func TestChildCapabilityKeepsCommentKindsAsLeaves(t *testing.T) {
+	file := f2pParseCorpus(t)
+	_, order, observed := f2pCollectDocs(t, file)
+	comments := f2pNodesWhere(order, func(n ast.Node) bool { return n.Type() == ast.CommentType })
+	if len(comments) == 0 {
+		t.Fatalf("F2P fixture corpus produced no comment nodes")
+	}
+	withInner := 0
+	for _, node := range comments {
+		if group, ok := node.(*ast.CommentGroupNode); ok && len(group.Comments) > 0 {
+			withInner++
+		}
+		f2pAssertChildCapabilityMatchesTraversal(t, "comment", node, observed[node])
+	}
+	if withInner == 0 {
+		t.Fatalf("F2P fixture corpus produced no comment groups carrying inner comment nodes")
+	}
+	synthetic := ast.Comment(f2pTestToken("# synthetic comment"))
+	observedSynthetic := f2pObservedChildren(synthetic, f2pWalkOrder(synthetic))
+	f2pAssertChildCapabilityMatchesTraversal(t, "comment", synthetic, observedSynthetic[synthetic])
+}
diff --git a/tests/f2p/f2p_first_token_test.go b/tests/f2p/f2p_first_token_test.go
new file mode 100644
index 0000000..e6bfb4e
--- /dev/null
+++ b/tests/f2p/f2p_first_token_test.go
@@ -0,0 +1,153 @@
+package f2p_test
+
+import (
+	"testing"
+
+	"github.com/goccy/go-yaml/ast"
+	"github.com/goccy/go-yaml/token"
+)
+
+func f2pAssertFirstToken(t *testing.T, family string, node ast.Node, expected *token.Token) {
+	t.Helper()
+	candidates := f2pFirstTokenCapabilities(node)
+	if len(candidates) == 0 {
+		t.Fatalf("%s: node kind %T declares no first-token capability (expected a method returning *token.Token distinct from GetToken)", family, node)
+	}
+	for _, candidate := range candidates {
+		if f2pTokenEqual(candidate.callFirstToken(node), expected) {
+			return
+		}
+	}
+	got := candidates[0].callFirstToken(node)
+	t.Fatalf("%s: node kind %T: first-token declarations %s return %s, want head token %s",
+		family, node, candidates[0].name, f2pTokenLabel(got), f2pTokenLabel(expected))
+}
+
+// TestFirstTokenCapabilityMatchesScalarAndMergeKeyTokens pins the scalar
+// families: their head token is the scalar's own token, with and without an
+// attached comment.
+func TestFirstTokenCapabilityMatchesScalarAndMergeKeyTokens(t *testing.T) {
+	file := f2pParseCorpus(t)
+	_, order, _ := f2pCollectDocs(t, file)
+	nodes := f2pNodesWhere(order, func(n ast.Node) bool {
+		switch n.Type() {
+		case ast.NullType, ast.BoolType, ast.IntegerType, ast.FloatType,
+			ast.InfinityType, ast.NanType, ast.StringType, ast.MergeKeyType:
+			return true
+		}
+		return false
+	})
+	if len(nodes) == 0 {
+		t.Fatalf("F2P fixture corpus produced no scalar nodes")
+	}
+	commented := 0
+	for _, node := range nodes {
+		if node.GetComment() != nil {
+			commented++
+		}
+		f2pAssertFirstToken(t, "scalar", node, node.GetToken())
+	}
+	if commented == 0 {
+		t.Fatalf("F2P fixture corpus must exercise scalars carrying a comment group")
+	}
+}
+
+// TestFirstTokenCapabilityMatchesMappingHeadRules pins the mapping families:
+// flow mappings and empty mappings start at their start token, block mappings
+// start at the head token of their first key, and mapping keys start at their
+// own start token.
+func TestFirstTokenCapabilityMatchesMappingHeadRules(t *testing.T) {
+	file := f2pParseCorpus(t)
+	_, order, _ := f2pCollectDocs(t, file)
+	flowSeen := 0
+	blockSeen := 0
+	keySeen := 0
+	for _, node := range order {
+		switch n := node.(type) {
+		case *ast.MappingNode:
+			if n.IsFlowStyle || len(n.Values) == 0 {
+				flowSeen++
+			} else {
+				blockSeen++
+			}
+			f2pAssertFirstToken(t, "mapping", node, f2pFrozenFirstToken(node))
+		case *ast.MappingKeyNode:
+			keySeen++
+			f2pAssertFirstToken(t, "mapping-key", node, n.Start)
+		}
+	}
+	if flowSeen == 0 || blockSeen == 0 || keySeen == 0 {
+		t.Fatalf("F2P fixture corpus must exercise flow mappings, block mappings and explicit keys, got flow=%d block=%d keys=%d", flowSeen, blockSeen, keySeen)
+	}
+	empty := ast.Mapping(f2pTestToken("{"), false)
+	f2pAssertFirstToken(t, "empty-mapping", empty, empty.Start)
+}
+
+// TestFirstTokenCapabilityMatchesWrapperHeadRules pins the document and
+// wrapper families: documents start at their header or fall back to the body,
+// while literal, directive, tag, anchor and alias nodes start at their own
+// start token.
+func TestFirstTokenCapabilityMatchesWrapperHeadRules(t *testing.T) {
+	file := f2pParseCorpus(t)
+	_, order, _ := f2pCollectDocs(t, file)
+	withHeader := 0
+	wrappers := map[ast.NodeType]int{}
+	for _, node := range order {
+		switch n := node.(type) {
+		case *ast.DocumentNode:
+			if n.Start != nil {
+				withHeader++
+			}
+		case *ast.LiteralNode, *ast.DirectiveNode, *ast.TagNode, *ast.AnchorNode, *ast.AliasNode:
+			wrappers[node.Type()]++
+		}
+		if node.Type() == ast.DocumentType || node.Type() == ast.LiteralType ||
+			node.Type() == ast.DirectiveType || node.Type() == ast.TagType ||
+			node.Type() == ast.AnchorType || node.Type() == ast.AliasType {
+			f2pAssertFirstToken(t, "wrapper", node, f2pFrozenFirstToken(node))
+		}
+	}
+	if withHeader == 0 {
+		t.Fatalf("F2P fixture corpus produced no document carrying a header")
+	}
+	for _, required := range []ast.NodeType{ast.LiteralType, ast.DirectiveType, ast.TagType, ast.AnchorType, ast.AliasType} {
+		if wrappers[required] == 0 {
+			t.Fatalf("F2P fixture corpus produced no %s node", required)
+		}
+	}
+	single := f2pParseSingle(t)
+	doc := single.Docs[0]
+	if doc.Start != nil {
+		t.Fatalf("F2P single-document fixture must not carry a document header")
+	}
+	f2pAssertFirstToken(t, "document-without-header", doc, f2pFrozenFirstToken(doc))
+}
+
+// TestFirstTokenCapabilityIsNilForHeadlessKinds pins the structure-only
+// families: mapping values, sequence entries, comments and comment groups have
+// no head token of their own.
+func TestFirstTokenCapabilityIsNilForHeadlessKinds(t *testing.T) {
+	file := f2pParseCorpus(t)
+	_, order, _ := f2pCollectDocs(t, file)
+	mappingValues := 0
+	comments := 0
+	for _, node := range order {
+		switch node.Type() {
+		case ast.MappingValueType:
+			mappingValues++
+			f2pAssertFirstToken(t, "headless", node, nil)
+		case ast.CommentType:
+			comments++
+			f2pAssertFirstToken(t, "headless", node, nil)
+		}
+	}
+	if mappingValues == 0 || comments == 0 {
+		t.Fatalf("F2P fixture corpus must exercise mapping values and comments, got mappingValues=%d comments=%d", mappingValues, comments)
+	}
+	entry := ast.SequenceEntry(f2pTestToken("-"), f2pStringNode("entry"), nil)
+	f2pAssertFirstToken(t, "headless", entry, nil)
+	comment := ast.Comment(f2pTestToken("# headless comment"))
+	f2pAssertFirstToken(t, "headless", comment, nil)
+	group := ast.CommentGroup([]*token.Token{f2pTestToken("# group comment")})
+	f2pAssertFirstToken(t, "headless", group, nil)
+}
