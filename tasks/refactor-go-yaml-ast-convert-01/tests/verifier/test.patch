--- /dev/null
+++ b/tests/p2p_work_test.go
@@ -0,0 +1,40 @@
+package p2p_test
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+)
+
+// Produced by the verifier, using an overlay rather than modifying production
+// files. It counts ALL ast.Visitor.Visit calls, including private pre-scans.
+func assertInternalWork(t *testing.T, operation string) {
+	t.Helper()
+	raw, err := os.ReadFile("testdata/case30_work.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var report struct {
+		Schema  string `json:"schema"`
+		Samples []struct {
+			Size       int  `json:"size"`
+			WalkPass   bool `json:"walk_pass"`
+			DecodePass bool `json:"decode_pass"`
+		} `json:"samples"`
+	}
+	if err := json.Unmarshal(raw, &report); err != nil {
+		t.Fatal(err)
+	}
+	if report.Schema != "case30-internal-work-v1" || len(report.Samples) != 2 {
+		t.Fatalf("invalid work observation: %s", raw)
+	}
+	for _, sample := range report.Samples {
+		pass := sample.WalkPass
+		if operation == "decode" {
+			pass = sample.DecodePass
+		}
+		if !pass {
+			t.Errorf("%s adds hidden traversal work at size %d: %s", operation, sample.Size, raw)
+		}
+	}
+}
