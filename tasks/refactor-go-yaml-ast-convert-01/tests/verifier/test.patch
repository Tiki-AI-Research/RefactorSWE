diff --git a/case30_boundary_test.go b/case30_boundary_test.go
new file mode 100644
index 0000000..d2bb598
--- /dev/null
+++ b/case30_boundary_test.go
@@ -0,0 +1,214 @@
+package yaml
+
+import (
+	_ "embed"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/goccy/go-yaml/ast"
+	"github.com/goccy/go-yaml/parser"
+	"github.com/goccy/go-yaml/printer"
+	"github.com/goccy/go-yaml/token"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func auditObserve(fn func() interface{}) (out interface{}) {
+	defer func() {
+		if p := recover(); p != nil {
+			out = map[string]interface{}{"panic": fmt.Sprint(p)}
+		}
+	}()
+	return fn()
+}
+func auditErr(e error) interface{} {
+	if e == nil {
+		return nil
+	}
+	return map[string]interface{}{"type": fmt.Sprintf("%T", e), "text": e.Error(), "depth": errors.Is(e, ErrExceededMaxDepth), "not_found": errors.Is(e, ErrNotFoundNode)}
+}
+
+//go:embed tests/testdata/case30_boundary.json
+var case30BoundaryJSON []byte
+
+func auditSnap(t *testing.T, key string, v interface{}) {
+	t.Helper()
+	var expected map[string]json.RawMessage
+	if err := json.Unmarshal(case30BoundaryJSON, &expected); err != nil {
+		t.Fatal(err)
+	}
+	frozen, ok := expected[key]
+	if !ok {
+		t.Fatalf("missing frozen observation %s", key)
+	}
+	actual, err := json.Marshal(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var want, got interface{}
+	if err := json.Unmarshal(frozen, &want); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(actual, &got); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(want, got) {
+		t.Errorf("preserved %s observation changed\nwant %s\ngot %s", key, frozen, actual)
+	}
+}
+
+func auditDecode(source string, kind int) interface{} {
+	return auditObserve(func() interface{} {
+		var dst interface{}
+		switch kind {
+		case 0:
+			dst = new(interface{})
+		case 1:
+			dst = new(struct {
+				A []int `yaml:"a"`
+				B []int `yaml:"b"`
+				C []int `yaml:"c"`
+			})
+		case 2:
+			dst = new(struct {
+				A map[string]int `yaml:"a"`
+				B map[string]int `yaml:"b"`
+				C map[string]int `yaml:"c"`
+			})
+		case 3:
+			dst = new(struct {
+				A *string `yaml:"a"`
+				B *string `yaml:"b"`
+				C *string `yaml:"c"`
+			})
+		case 4:
+			dst = new(MapSlice)
+		}
+		e := Unmarshal([]byte(source), dst)
+		b, marshalErr := json.Marshal(dst)
+		return map[string]interface{}{"value": string(b), "error": auditErr(e), "json_error": auditErr(marshalErr)}
+	})
+}
+func TestP2PBoundaryDecodeMatrix(t *testing.T) {
+	rows := []interface{}{}
+	for _, value := range []string{"null", "[1, 2]", "{k: 3}", "42", "word"} {
+		for _, wrap := range []string{"", "&x ", "!!seq ", "!!map ", "!!str ", "!!null ", "&x !!seq ", "!!seq &x ", "&x !!map ", "!!map &x "} {
+			source := "a: " + wrap + value + "\n"
+			if strings.Contains(wrap, "&x") {
+				source += "b: *x\nc: *x\n"
+			}
+			for kind := 0; kind < 5; kind++ {
+				rows = append(rows, map[string]interface{}{"source": source, "target": kind, "result": auditDecode(source, kind)})
+			}
+		}
+	}
+	for _, source := range []string{"a: *missing\n", "a: &x [*x]\nb: *x\n", "a: &x {k: 1}\nb: &x {k: 2}\nc: *x\n", "x: &x {k: 1}\ny: &y {j: 2}\na: {<<: [*x, *y], k: 9}\n", "a: {<<: [1, 2]}\n", "a: &x null\nb: !!seq *x\n", "a: &x [1, 2]\nb: !!seq *x\n"} {
+		for kind := 0; kind < 5; kind++ {
+			rows = append(rows, map[string]interface{}{"source": source, "target": kind, "result": auditDecode(source, kind)})
+		}
+	}
+	auditSnap(t, "decode", rows)
+}
+
+type auditRaw struct{ Text string }
+
+func (r *auditRaw) UnmarshalYAML(b []byte) error { r.Text = string(b); return nil }
+func TestP2PBoundaryFormatAndPathMatrix(t *testing.T) {
+	sources := []string{"# head\na: [1, 2] # line\n# foot\n", "---\na: &x {name: one}\nb: *x\n...\n", "!!str name: one\nother: 2\n", "&key name: one\nother: 2\n", "? &key name\n: one\n", "root: [{name: one}, {name: two}]\n", "root: {a: {name: one}, b: {name: two}}\n", "root: !!map {name: one}\n", "root: &x {name: one}\n", "a: |\n  one\n  two\nb: >\n  three\n  four\n", "# h\n---\na: 1\n---\nb: 2\n"}
+	rows := []interface{}{}
+	for _, source := range sources {
+		result := auditObserve(func() interface{} {
+			f, e := parser.ParseBytes([]byte(source), parser.ParseComments)
+			if e != nil {
+				return auditErr(e)
+			}
+			var raw auditRaw
+			err := Unmarshal([]byte(source), &raw)
+			b, me := f.Docs[0].MarshalYAML()
+			return map[string]interface{}{"file": f.String(), "printer": string((&printer.Printer{}).PrintNode(f.Docs[0])), "marshal": string(b), "marshal_error": auditErr(me), "custom": raw.Text, "custom_error": auditErr(err)}
+		})
+		rows = append(rows, map[string]interface{}{"source": source, "format": result})
+		for _, path := range []string{"$", "$.name", "$..name", "$.root.name", "$.root[*].name", "$.missing", "$.root.missing.deep"} {
+			for _, action := range []string{"file", "node", "replace"} {
+				result := auditObserve(func() interface{} {
+					f, e := parser.ParseBytes([]byte(source), parser.ParseComments)
+					if e != nil {
+						return auditErr(e)
+					}
+					p, e := PathString(path)
+					if e != nil {
+						return auditErr(e)
+					}
+					if action == "replace" {
+						e = p.ReplaceWithReader(f, strings.NewReader("replacement\n"))
+						return map[string]interface{}{"file": f.String(), "error": auditErr(e)}
+					}
+					var n ast.Node
+					if action == "file" {
+						n, e = p.FilterFile(f)
+					} else {
+						n, e = p.FilterNode(f.Docs[0].Body)
+					}
+					text := "<nil>"
+					if n != nil {
+						text = n.String()
+					}
+					return map[string]interface{}{"node": text, "error": auditErr(e)}
+				})
+				rows = append(rows, map[string]interface{}{"source": source, "path": path, "action": action, "result": result})
+			}
+		}
+	}
+	auditSnap(t, "format-path", rows)
+}
+
+// This external-to-ast node implements only the old public surface and embeds
+// the exported BaseNode to inherit its sealed bookkeeping methods.
+// Reflect before conversion so a narrowed interface remains measurable.
+type auditLegacyNode struct{ *ast.BaseNode }
+
+func (*auditLegacyNode) String() string { return "legacy" }
+func (*auditLegacyNode) GetToken() *token.Token {
+	return token.New("legacy", "legacy", &token.Position{Line: 1, Column: 1})
+}
+func (*auditLegacyNode) Type() ast.NodeType           { return ast.StringType }
+func (*auditLegacyNode) AddColumn(int)                {}
+func (*auditLegacyNode) MarshalYAML() ([]byte, error) { return []byte("legacy"), nil }
+func (*auditLegacyNode) Read([]byte) (int, error)     { return 0, io.EOF }
+
+type auditVisitor struct {
+	seen  []string
+	prune bool
+}
+
+func (v *auditVisitor) Visit(n ast.Node) ast.Visitor {
+	v.seen = append(v.seen, fmt.Sprintf("%T", n))
+	if v.prune {
+		return nil
+	}
+	return v
+}
+func TestP2PBoundaryOldNodeCompatibility(t *testing.T) {
+	c := ast.CommentGroup([]*token.Token{token.New("# legacy", "# legacy", &token.Position{Line: 1, Column: 1})})
+	n := &auditLegacyNode{&ast.BaseNode{Comment: c}}
+	node, ok := interface{}(n).(ast.Node)
+	result := map[string]interface{}{"implements_old_node": ok}
+	if ok {
+		v := &auditVisitor{}
+		result["walk"] = auditObserve(func() interface{} { ast.Walk(v, node); return v.seen })
+		result["parent"] = auditObserve(func() interface{} { return ast.Parent(node, c) != nil })
+	}
+	auditSnap(t, "old-node", result)
+}
+func TestP2PBoundaryNilPruning(t *testing.T) {
+	nodes := []ast.Node{nil, (*ast.DocumentNode)(nil), (*ast.StringNode)(nil), (*ast.SequenceNode)(nil), (*ast.MappingNode)(nil), (*ast.CommentNode)(nil)}
+	rows := []interface{}{}
+	for _, n := range nodes {
+		v := &auditVisitor{prune: true}
+		result := auditObserve(func() interface{} { ast.Walk(v, n); return v.seen })
+		rows = append(rows, map[string]interface{}{"kind": fmt.Sprint(reflect.TypeOf(n)), "result": result})
+	}
+	auditSnap(t, "nil-pruning", rows)
+}
diff --git a/case30_legacy_wrapper_test.go b/case30_legacy_wrapper_test.go
new file mode 100644
index 0000000..95969e0
--- /dev/null
+++ b/case30_legacy_wrapper_test.go
@@ -0,0 +1,64 @@
+package yaml_test
+
+import (
+	"fmt"
+	"github.com/goccy/go-yaml/ast"
+	"github.com/goccy/go-yaml/parser"
+	"testing"
+)
+
+type auditWrappedSequence struct{ *ast.SequenceNode }
+type auditWrappedMapping struct{ *ast.MappingNode }
+type auditWrapperVisitor struct{ names *[]string }
+
+func (v auditWrapperVisitor) Visit(n ast.Node) ast.Visitor {
+	*v.names = append(*v.names, fmt.Sprintf("%T", n))
+	return v
+}
+func TestP2PLegacyEmbeddedWrapperBehavior(t *testing.T) {
+	snapshots := map[string]interface{}{}
+	for _, source := range []string{"[first, second]", "{key: value}"} {
+		f, e := parser.ParseBytes([]byte(source), 0)
+		if e != nil {
+			t.Fatal(e)
+		}
+		var inner, outer, child ast.Node
+		switch n := f.Docs[0].Body.(type) {
+		case *ast.SequenceNode:
+			inner = n
+			outer = &auditWrappedSequence{n}
+			child = n.Values[0]
+		case *ast.MappingNode:
+			inner = n
+			outer = &auditWrappedMapping{n}
+			child = n.Values[0]
+		default:
+			t.Fatalf("unexpected parsed node %T", n)
+		}
+		observe := func(root ast.Node) interface{} {
+			visits := []string{}
+			ast.Walk(auditWrapperVisitor{&visits}, root)
+			parent := ast.Parent(root, child)
+			identity := "nil"
+			if parent == outer {
+				identity = "outer"
+			} else if parent == inner {
+				identity = "inner"
+			} else if parent != nil {
+				identity = fmt.Sprintf("%T", parent)
+			}
+			filtered := []string{}
+			for _, n := range ast.Filter(ast.StringType, root) {
+				filtered = append(filtered, n.String())
+			}
+			return map[string]interface{}{"walk": visits, "parent": identity, "filter": filtered}
+		}
+		snapshots[source] = map[string]interface{}{"builtin": observe(inner), "wrapper": observe(outer)}
+	}
+	for source, snapshot := range snapshots {
+		wrapper := snapshot.(map[string]interface{})["wrapper"].(map[string]interface{})
+		if wrapper["parent"] != "nil" || len(wrapper["filter"].([]string)) != 0 || len(wrapper["walk"].([]string)) != 1 {
+			t.Errorf("legacy wrapper became traversable for %s: %#v", source, wrapper)
+		}
+	}
+}
diff --git a/tests/f2p/capgen/main.go b/tests/f2p/capgen/main.go
new file mode 100644
index 0000000..656a5b6
--- /dev/null
+++ b/tests/f2p/capgen/main.go
@@ -0,0 +1,243 @@
+// capgen emits free evaluator bridges into package ast. It never adds methods
+// to candidate types and never supplies expected children or token values.
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/format"
+	"go/parser"
+	"go/printer"
+	"go/token"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+var fs = token.NewFileSet()
+var named = map[string]ast.Expr{}
+
+func text(x ast.Node) string {
+	var b bytes.Buffer
+	if err := printer.Fprint(&b, fs, x); err != nil {
+		panic(err)
+	}
+	return b.String()
+}
+func fields(f *ast.FieldList) []ast.Expr {
+	var out []ast.Expr
+	if f != nil {
+		for _, x := range f.List {
+			n := len(x.Names)
+			if n == 0 {
+				n = 1
+			}
+			for i := 0; i < n; i++ {
+				out = append(out, x.Type)
+			}
+		}
+	}
+	return out
+}
+func underlying(e ast.Expr) ast.Expr {
+	for i := 0; i < 8; i++ {
+		id, ok := e.(*ast.Ident)
+		if !ok {
+			return e
+		}
+		v, ok := named[id.Name]
+		if !ok {
+			return e
+		}
+		e = v
+	}
+	return e
+}
+func eq(e ast.Expr, s string) bool   { return text(e) == s }
+func optionalBool(r []ast.Expr) bool { return len(r) == 0 || len(r) == 1 && eq(r[0], "bool") }
+func callback(e ast.Expr) (string, bool) {
+	f, ok := underlying(e).(*ast.FuncType)
+	if !ok {
+		return "", false
+	}
+	p, r := fields(f.Params), fields(f.Results)
+	if len(p) != 1 || !optionalBool(r) {
+		return "", false
+	}
+	node := ""
+	if eq(p[0], "Node") {
+		node = "item"
+	} else if s, ok := underlying(p[0]).(*ast.StructType); ok {
+		for _, field := range s.Fields.List {
+			if eq(field.Type, "Node") && len(field.Names) == 1 {
+				if node != "" {
+					return "", false
+				}
+				node = "item." + field.Names[0].Name
+			}
+		}
+	}
+	if node == "" {
+		return "", false
+	}
+	ret := ""
+	suffix := ""
+	if len(r) == 1 {
+		ret = " bool"
+		suffix = ";return true"
+	}
+	return "func(item " + text(p[0]) + ")" + ret + " { values=append(values," + node + ")" + suffix + " }", true
+}
+
+type method struct {
+	Name, Signature string
+	T               *ast.FuncType
+}
+
+func main() {
+	if len(os.Args) != 2 {
+		panic("usage: capgen repository")
+	}
+	root := os.Args[1]
+	paths, err := filepath.Glob(filepath.Join(root, "ast", "*.go"))
+	if err != nil {
+		panic(err)
+	}
+	methods := map[string]method{}
+	inputs := map[string]string{}
+	for _, p := range paths {
+		if strings.HasSuffix(p, "_test.go") || filepath.Base(p) == "zz_benchmark_capabilities.go" {
+			continue
+		}
+		raw, err := os.ReadFile(p)
+		if err != nil {
+			panic(err)
+		}
+		h := sha256.Sum256(raw)
+		inputs[filepath.Base(p)] = hex.EncodeToString(h[:])
+		file, err := parser.ParseFile(fs, p, raw, 0)
+		if err != nil {
+			panic(err)
+		}
+		for _, d := range file.Decls {
+			if gd, ok := d.(*ast.GenDecl); ok {
+				for _, s := range gd.Specs {
+					if ts, ok := s.(*ast.TypeSpec); ok {
+						named[ts.Name.Name] = ts.Type
+					}
+				}
+			}
+			if f, ok := d.(*ast.FuncDecl); ok && f.Recv != nil {
+				sig := f.Name.Name + strings.TrimPrefix(text(f.Type), "func")
+				methods[sig] = method{f.Name.Name, sig, f.Type}
+			}
+		}
+	}
+	keys := []string{}
+	for k := range methods {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var body, first, helpers strings.Builder
+	bindings := []map[string]string{}
+	helperN := 0
+	add := func(m method, name, extra, code string) {
+		fmt.Fprintf(&body, "if cap, ok:=node.(interface{%s%s});ok {out=append(out,Case30ChildCapability{Name:%q,Apply:func() []Node {%s}})}\n", m.Signature, extra, name, code)
+		bindings = append(bindings, map[string]string{"role": "children", "binding": name, "signature": m.Signature + extra})
+	}
+	for _, k := range keys {
+		m := methods[k]
+		p, r := fields(m.T.Params), fields(m.T.Results)
+		if len(p) == 0 && len(r) == 1 && eq(r[0], "*token.Token") && m.Name != "GetToken" {
+			fmt.Fprintf(&first, "if cap,ok:=node.(interface{%s});ok {out=append(out,Case30TokenCapability{Name:%q,Apply:func()*token.Token{return cap.%s()}})}\n", m.Signature, m.Name, m.Name)
+			bindings = append(bindings, map[string]string{"role": "first_token", "binding": m.Name, "signature": m.Signature})
+			continue
+		}
+		if len(p) == 0 && len(r) == 1 && eq(r[0], "[]Node") {
+			add(m, m.Name, "", "return cap."+m.Name+"()")
+			continue
+		}
+		if len(p) == 1 && eq(p[0], "int") && len(r) > 0 && eq(r[0], "Node") {
+			if len(r) == 2 && eq(r[1], "bool") {
+				add(m, m.Name, "", "var values []Node;for i:=0;i<1000000;i++{value,ok:=cap."+m.Name+"(i);if !ok{return values};values=append(values,value)};panic(\"non-terminating child enumeration\")")
+			} else if len(r) == 1 {
+				for _, key := range keys {
+					count := methods[key]
+					cp, cr := fields(count.T.Params), fields(count.T.Results)
+					if len(cp) == 0 && len(cr) == 1 && eq(cr[0], "int") {
+						add(m, count.Name+"/"+m.Name, ";"+count.Signature, "n:=cap."+count.Name+"();if n<0||n>1000000{panic(\"invalid child count\")};var values []Node;for i:=0;i<n;i++{values=append(values,cap."+m.Name+"(i))};return values")
+					}
+				}
+			}
+			continue
+		}
+		if len(p) == 1 && optionalBool(r) {
+			if cb, ok := callback(p[0]); ok {
+				add(m, m.Name, "", "var values []Node;cap."+m.Name+"("+cb+");return values")
+				continue
+			}
+			if iface, ok := underlying(p[0]).(*ast.InterfaceType); ok && len(iface.Methods.List) == 1 {
+				field := iface.Methods.List[0]
+				f, ok := field.Type.(*ast.FuncType)
+				if ok && len(field.Names) == 1 {
+					ap, ar := fields(f.Params), fields(f.Results)
+					if len(ap) == 1 && eq(ap[0], "Node") && optionalBool(ar) {
+						helperN++
+						n := fmt.Sprintf("case30ChildSink%d", helperN)
+						ret, ending := "", ""
+						if len(ar) == 1 {
+							ret = " bool"
+							ending = ";return true"
+						}
+						fmt.Fprintf(&helpers, "type %s struct{values *[]Node};func(s %s)%s(item Node)%s{*s.values=append(*s.values,item)%s}\n", n, n, field.Names[0].Name, ret, ending)
+						add(m, m.Name, "", "var values []Node;cap."+m.Name+"("+n+"{&values});return values")
+					}
+				}
+			}
+		}
+		if len(p) == 0 && len(r) == 1 {
+			if st, ok := underlying(r[0]).(*ast.StructType); ok {
+				var comments, loops []string
+				for _, field := range st.Fields.List {
+					if len(field.Names) != 1 {
+						continue
+					}
+					name := field.Names[0].Name
+					if eq(field.Type, "*CommentGroupNode") {
+						comments = append(comments, "if value."+name+"!=nil{values=append(values,value."+name+")}")
+					}
+					if f, ok := underlying(field.Type).(*ast.FuncType); ok {
+						ap, ar := fields(f.Params), fields(f.Results)
+						if len(ap) == 1 && optionalBool(ar) {
+							if cb, ok := callback(ap[0]); ok {
+								loops = append(loops, "if value."+name+"!=nil{value."+name+"("+cb+")}")
+							}
+						}
+					}
+				}
+				if len(loops) == 1 {
+					add(m, m.Name, "", "value:=cap."+m.Name+"();var values []Node;"+strings.Join(comments, ";")+";"+loops[0]+";return values")
+				}
+			}
+		}
+	}
+	src := "// Generated evaluator free bridges; candidate methods are unchanged.\npackage ast\nimport \"github.com/goccy/go-yaml/token\"\ntype Case30ChildCapability struct{Name string;Apply func()[]Node}\ntype Case30TokenCapability struct{Name string;Apply func()*token.Token}\n" + helpers.String() + "\nfunc Case30ChildCapabilities(node Node) []Case30ChildCapability {var out []Case30ChildCapability;" + body.String() + ";return out}\nfunc Case30TokenCapabilities(node Node) []Case30TokenCapability {var out []Case30TokenCapability;" + first.String() + ";return out}\n"
+	formatted, err := format.Source([]byte(src))
+	if err != nil {
+		fmt.Fprintln(os.Stderr, src)
+		panic(err)
+	}
+	dst := filepath.Join(root, "ast", "zz_benchmark_capabilities.go")
+	if err := os.WriteFile(dst, formatted, 0644); err != nil {
+		panic(err)
+	}
+	h := sha256.Sum256(formatted)
+	receipt := map[string]any{"generator": "case30-free-bridges-v1", "source_sha256": inputs, "output_sha256": hex.EncodeToString(h[:]), "bindings": bindings, "candidate_method_sets_modified": false}
+	b, _ := json.MarshalIndent(receipt, "", "  ")
+	fmt.Println(string(b))
+}
diff --git a/tests/f2p/dispatch/main.go b/tests/f2p/dispatch/main.go
