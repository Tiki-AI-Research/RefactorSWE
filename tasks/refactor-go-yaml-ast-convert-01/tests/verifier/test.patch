@@ -0,0 +1,83 @@
+package p2p_test
+
+import (
+	"strings"
+	"testing"
+
+	yaml "github.com/goccy/go-yaml"
+	"github.com/goccy/go-yaml/ast"
+	"github.com/goccy/go-yaml/parser"
+	p2p "github.com/goccy/go-yaml/tests"
+)
+
+// TestPathFilterSnapshot pins path selection results and invalid-path errors
+// for recursive, indexed and wrapped-key selectors.
+func TestPathFilterSnapshot(t *testing.T) {
+	assertWrappedKeyPath(t, false)
+	fx := loadFixture(t)
+	var want map[string]p2p.PathFilterRecord
+	fixtureValue(t, fx, "path_filter", &want)
+
+	got, err := p2p.PathFilterRecords()
+	check(t, err)
+	for _, c := range p2p.PathFilterCases {
+		expected, ok := want[c.Name]
+		if !ok {
+			t.Fatalf("fixture has no path_filter entry for %q", c.Name)
+		}
+		if got[c.Name] != expected {
+			t.Fatalf("%s: path filter mismatch:\nwant %+v\ngot  %+v", c.Name, expected, got[c.Name])
+		}
+	}
+}
+
+// TestPathReplaceSnapshot pins that recursive path replacement writes the same
+// locations and leaves the rest of the document untouched.
+func TestPathReplaceSnapshot(t *testing.T) {
+	assertWrappedKeyPath(t, true)
+	fx := loadFixture(t)
+	var want map[string]p2p.PathReplaceRecord
+	fixtureValue(t, fx, "path_replace", &want)
+
+	got, err := p2p.PathReplaceRecords()
+	check(t, err)
+	for _, c := range p2p.PathReplaceCases {
+		expected, ok := want[c.Name]
+		if !ok {
+			t.Fatalf("fixture has no path_replace entry for %q", c.Name)
+		}
+		if got[c.Name] != expected {
+			t.Fatalf("%s: path replace mismatch:\nwant %+v\ngot  %+v", c.Name, expected, got[c.Name])
+		}
+	}
+}
+
+// The preserved selector text is the parsed key's original token, not its
+// rendering or resolved value. Filter and replacement are separate checks.
+func assertWrappedKeyPath(t *testing.T, replace bool) {
+	t.Helper()
+	for _, prefix := range []string{"&key name", "!!str name"} {
+		t.Run(prefix, func(t *testing.T) {
+			file, err := parser.ParseBytes([]byte(prefix+": one\nother: 7\n"), 0)
+			check(t, err)
+			mapping := file.Docs[0].Body.(*ast.MappingNode)
+			keyText := mapping.Values[0].Key.GetToken().Value
+			path, err := yaml.PathString("$.." + keyText)
+			check(t, err)
+			if replace {
+				check(t, path.ReplaceWithReader(file, strings.NewReader("replacement")))
+				want := prefix + ": replacement\nother: 7\n"
+				if file.String() != want {
+					t.Fatalf("wrong replacement location: got %q, want %q", file.String(), want)
+				}
+			} else {
+				node, err := path.FilterFile(file)
+				check(t, err)
+				selected, ok := node.(*ast.SequenceNode)
+				if !ok || len(selected.Values) != 1 || selected.Values[0].String() != "one" {
+					t.Fatalf("original token %q must select only one, got %v", keyText, node)
+				}
+			}
+		})
+	}
+}
