+package f2p_test
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+)
+
+// This artifact is generated by the frozen verifier from typed production
+// source before tests run. It records symbol-resolved public consumer paths.
+func assertCommonDispatch(t *testing.T, group string) {
+	t.Helper()
+	raw, err := os.ReadFile("../testdata/case30_dispatch.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var report struct {
+		Schema string `json:"schema"`
+		Groups map[string]struct {
+			Pass  bool            `json:"pass"`
+			Roots json.RawMessage `json:"roots"`
+		} `json:"groups"`
+	}
+	if err := json.Unmarshal(raw, &report); err != nil {
+		t.Fatal(err)
+	}
+	if report.Schema != "case30-typed-dispatch-v1" {
+		t.Fatalf("unexpected analyzer schema: %s", report.Schema)
+	}
+	result, ok := report.Groups[group]
+	if !ok || !result.Pass {
+		t.Fatalf("%s consumers do not delegate common node dispatch: %s", group, result.Roots)
+	}
+}
+
+func TestTraversalConsumesNodeCapabilities(t *testing.T)     { assertCommonDispatch(t, "traversal") }
+func TestFormattingConsumesNodeCapabilities(t *testing.T)    { assertCommonDispatch(t, "formatting") }
+func TestKeyExtractionConsumesNodeCapabilities(t *testing.T) { assertCommonDispatch(t, "keys") }
+func TestDecodingConsumesNodeCapabilities(t *testing.T)      { assertCommonDispatch(t, "decoding") }
diff --git a/tests/f2p/f2p_support_test.go b/tests/f2p/f2p_support_test.go
new file mode 100644
index 0000000..377a88b
--- /dev/null
+++ b/tests/f2p/f2p_support_test.go
@@ -0,0 +1,633 @@
+// Package f2p_test contains the supplemental F2P acceptance tests for the
+// polymorphic node capability set required by REQ-STRUCT-001: every node kind
+// shipped by the module must declare child enumeration and first-token lookup
+// once, and the public traversal entry points (Walk, Parent, Filter,
+// FilterFile) must consume that capability instead of enumerating concrete
+// node types.
+//
+// The package contains no production logic: it drives the module's exported
+// API plus reflection over the declared method shapes. Method names are
+// intentionally discovered by shape, because REQ-STRUCT-003 leaves naming and
+// internal organization free.
+package f2p_test
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/goccy/go-yaml/ast"
+	"github.com/goccy/go-yaml/parser"
+	"github.com/goccy/go-yaml/token"
+)
+
+// f2pCorpus is the multi-document fixture used by the capability tests. It
+// exercises every node kind shipped by the module: documents with and without
+// a header, directives, block and flow mappings, block and flow sequences,
+// every scalar kind, merge keys, anchors, aliases, tags, literal scalars and
+// comments in the positions the frozen traversal records.
+const f2pCorpus = `%YAML 1.2
+---
+# head comment for the first document
+null_value: null
+bool_value: true
+int_value: 42
+float_value: 3.14
+inf_value: .inf
+nan_value: .nan
+str_value: hello # line comment for a scalar
+literal_value: |
+  line one
+  line two
+anchor_source: &anchor
+  inner: 1
+merge_source: &merge_source
+  m: 1
+merged:
+  <<: *merge_source
+aliased: *anchor
+tagged: !!str tagged-value
+tagged_seq: !!seq
+  - x
+  - y
+flow_map: {k: v}
+empty_flow_map: {}
+flow_seq: [p, q]
+block_seq:
+  - one
+  - two
+explicit:
+  ? explicit_key
+  : explicit_value
+...
+---
+# head comment for the second document
+second_document: [1, 2]
+...
+`
+
+// f2pSingleDocument has no document header so the first token lookup must fall
+// back to the body of the document.
+const f2pSingleDocument = `alpha: beta
+`
+
+// f2pNodeKinds enumerates every concrete node kind shipped by the module.
+var f2pNodeKinds = []struct {
+	name string
+	node ast.Node
+}{
+	{"DocumentNode", &ast.DocumentNode{}},
+	{"NullNode", &ast.NullNode{}},
+	{"BoolNode", &ast.BoolNode{}},
+	{"IntegerNode", &ast.IntegerNode{}},
+	{"FloatNode", &ast.FloatNode{}},
+	{"InfinityNode", &ast.InfinityNode{}},
+	{"NanNode", &ast.NanNode{}},
+	{"StringNode", &ast.StringNode{}},
+	{"MergeKeyNode", &ast.MergeKeyNode{}},
+	{"LiteralNode", &ast.LiteralNode{}},
+	{"MappingNode", &ast.MappingNode{}},
+	{"MappingKeyNode", &ast.MappingKeyNode{}},
+	{"MappingValueNode", &ast.MappingValueNode{}},
+	{"SequenceNode", &ast.SequenceNode{}},
+	{"SequenceEntryNode", &ast.SequenceEntryNode{}},
+	{"AnchorNode", &ast.AnchorNode{}},
+	{"AliasNode", &ast.AliasNode{}},
+	{"DirectiveNode", &ast.DirectiveNode{}},
+	{"TagNode", &ast.TagNode{}},
+	{"CommentNode", &ast.CommentNode{}},
+	{"CommentGroupNode", &ast.CommentGroupNode{}},
+}
+
+var (
+	f2pNodeSliceType = reflect.TypeOf([]ast.Node{})
+	f2pTokenPtrType  = reflect.TypeOf((*token.Token)(nil))
+)
+
+// f2pMethod delegates actual candidate operations through evaluator free bridges.
+// The bridges never change candidate method sets or manufacture child/token values.
+type f2pMethod struct {
+	name       string
+	children   func() []ast.Node
+	firstToken func() *token.Token
+}
+
+func f2pChildrenCapabilities(node ast.Node) []f2pMethod {
+	var out []f2pMethod
+	for _, m := range ast.Case30ChildCapabilities(node) {
+		out = append(out, f2pMethod{name: m.Name, children: m.Apply})
+	}
+	return out
+}
+func f2pChildrenCapability(node ast.Node) (f2pMethod, bool) {
+	all := f2pChildrenCapabilities(node)
+	if len(all) == 0 {
+		return f2pMethod{}, false
+	}
+	return all[0], true
+}
+func f2pFirstTokenCapabilities(node ast.Node) []f2pMethod {
+	var out []f2pMethod
+	for _, m := range ast.Case30TokenCapabilities(node) {
+		out = append(out, f2pMethod{name: m.Name, firstToken: m.Apply})
+	}
+	return out
+}
+
+// f2pExpectedChildren is the frozen traversal child list of a node: its own
+// comment group first (when attached) followed by the frozen structural
+// children.
+func f2pExpectedChildren(node ast.Node) ([]ast.Node, bool) {
+	structural, known := f2pFrozenStructuralChildren(node)
+	if !known {
+		return nil, false
+	}
+	var expected []ast.Node
+	if comment := node.GetComment(); comment != nil {
+		expected = append(expected, comment)
+	}
+	expected = append(expected, structural...)
+	return expected, true
+}
+
+// f2pMatchingChildEnumeration returns the child enumeration declared by node
+// that reproduces the frozen traversal children, accepting both frozen comment
+// conventions (comment first, or structural children only).
+func f2pMatchingChildEnumeration(node ast.Node) ([]ast.Node, f2pMethod, bool) {
+	expected, known := f2pExpectedChildren(node)
+	if !known {
+		return nil, f2pMethod{}, false
+	}
+	comment := node.GetComment()
+	var withoutComment []ast.Node
+	if comment != nil && len(expected) > 0 && expected[0] == comment {
+		withoutComment = expected[1:]
+	}
+	for _, candidate := range f2pChildrenCapabilities(node) {
+		children := candidate.callChildren(node)
+		if f2pSameNodes(children, expected) {
+			return children, candidate, true
+		}
+		if comment != nil && f2pSameNodes(children, withoutComment) {
+			return children, candidate, true
+		}
+	}
+	return nil, f2pMethod{}, false
+}
+
+// f2pMatchingFirstToken returns the first-token declaration of node that
+// reproduces the frozen head token.
+func f2pMatchingFirstToken(node ast.Node) (*token.Token, f2pMethod, bool) {
+	expected := f2pFrozenFirstToken(node)
+	for _, candidate := range f2pFirstTokenCapabilities(node) {
+		if f2pTokenEqual(candidate.callFirstToken(node), expected) {
+			return expected, candidate, true
+		}
+	}
+	return nil, f2pMethod{}, false
+}
+
+func f2pFirstTokenCapability(node ast.Node) (f2pMethod, bool) {
+	all := f2pFirstTokenCapabilities(node)
+	if len(all) == 0 {
+		return f2pMethod{}, false
+	}
+	return all[0], true
+}
+func (m f2pMethod) callChildren(node ast.Node) []ast.Node     { return m.children() }
+func (m f2pMethod) callFirstToken(node ast.Node) *token.Token { return m.firstToken() }
+func f2pChildCapabilityNames(t reflect.Type) []string {
+	var out []string
+	node := reflect.New(t.Elem()).Interface().(ast.Node)
+	for _, m := range f2pChildrenCapabilities(node) {
+		out = append(out, m.name)
+	}
+	return out
+}
+func f2pFirstTokenCapabilityNames(t reflect.Type) []string {
+	var out []string
+	node := reflect.New(t.Elem()).Interface().(ast.Node)
+	for _, m := range f2pFirstTokenCapabilities(node) {
+		out = append(out, m.name)
+	}
+	return out
+}
+
+// f2pUniformCapabilityName returns the single capability name shared by every
+// supplied node kind, or "" when the declared capabilities are not uniform.
+func f2pUniformCapabilityName(namesByKind map[string][]string) string {
+	var shared []string
+	for _, names := range namesByKind {
+		if len(names) == 0 {
+			return ""
+		}
+		if shared == nil {
+			shared = append(shared, names...)
+			continue
+		}
+		var next []string
+		for _, candidate := range shared {
+			for _, name := range names {
+				if name == candidate {
+					next = append(next, candidate)
+					break
+				}
+			}
+		}
+		shared = next
+	}
+	sort.Strings(shared)
+	if len(shared) == 0 {
+		return ""
+	}
+	return shared[0]
+}
+
+type f2pCollector struct {
+	nodes []ast.Node
+}
+
+func (c *f2pCollector) Visit(n ast.Node) ast.Visitor {
+	if n == nil {
+		return c
+	}
+	c.nodes = append(c.nodes, n)
+	return c
+}
+
+// f2pWalkOrder returns the nodes visited by ast.Walk from root in visit order.
+func f2pWalkOrder(root ast.Node) []ast.Node {
+	c := &f2pCollector{}
+	ast.Walk(c, root)
+	return c.nodes
+}
+
+// f2pObservedChildren returns, for every node visited from root, the direct
+// children the traversal actually visits: the node's own comment group first
+// (when present), followed by the nodes whose ast.Parent is that node.
+func f2pObservedChildren(root ast.Node, order []ast.Node) map[ast.Node][]ast.Node {
+	out := map[ast.Node][]ast.Node{}
+	for _, n := range order {
+		var children []ast.Node
+		if comment := n.GetComment(); comment != nil {
+			children = append(children, comment)
+		}
+		for _, candidate := range order {
+			if candidate == n {
+				continue
+			}
+			if ast.Parent(root, candidate) == n {
+				children = append(children, candidate)
+			}
+		}
+		out[n] = children
+	}
+	return out
+}
+
+// f2pTraversalChildren returns the frozen traversal children of node as
+// declared by the capability set, normalised so the node's own comment group
+// is listed first even when the capability reports structural children only.
+func f2pTraversalChildren(node ast.Node) ([]ast.Node, f2pMethod, bool) {
+	children, capability, ok := f2pMatchingChildEnumeration(node)
+	if !ok {
+		return nil, f2pMethod{}, false
+	}
+	if comment := node.GetComment(); comment != nil && !f2pContainsNode(children, comment) {
+		children = append([]ast.Node{comment}, children...)
+	}
+	return children, capability, true
+}
+
+// f2pFrozenStructuralChildren is the frozen child enumeration of ast.Walk
+// before the refactor (ast/ast.go:2161): the direct children visited for each
+// node kind, without the node's own comment group.
+func f2pFrozenStructuralChildren(node ast.Node) ([]ast.Node, bool) {
+	switch n := node.(type) {
+	case *ast.DocumentNode:
+		if n.Body == nil {
+			return nil, true
+		}
+		return []ast.Node{n.Body}, true
+	case *ast.NullNode, *ast.BoolNode, *ast.IntegerNode, *ast.FloatNode,
+		*ast.StringNode, *ast.InfinityNode, *ast.NanNode, *ast.MergeKeyNode:
+		return nil, true
+	case *ast.LiteralNode:
+		if n.Value == nil {
+			return nil, true
+		}
+		return []ast.Node{n.Value}, true
+	case *ast.DirectiveNode:
+		children := []ast.Node{}
+		if n.Name != nil {
+			children = append(children, n.Name)
+		}
+		children = append(children, n.Values...)
+		return children, true
+	case *ast.TagNode:
+		if n.Value == nil {
+			return nil, true
+		}
+		return []ast.Node{n.Value}, true
+	case *ast.MappingNode:
+		children := make([]ast.Node, 0, len(n.Values))
+		for _, value := range n.Values {
+			children = append(children, value)
+		}
+		return children, true
+	case *ast.MappingKeyNode:
+		if n.Value == nil {
+			return nil, true
+		}
+		return []ast.Node{n.Value}, true
+	case *ast.MappingValueNode:
+		children := []ast.Node{}
+		if n.Key != nil {
+			children = append(children, n.Key)
+		}
+		if n.Value != nil {
+			children = append(children, n.Value)
+		}
+		return children, true
+	case *ast.SequenceNode:
+		children := make([]ast.Node, 0, len(n.Values))
+		children = append(children, n.Values...)
+		return children, true
+	case *ast.SequenceEntryNode:
+		return nil, true
+	case *ast.AnchorNode:
+		children := []ast.Node{}
+		if n.Name != nil {
+			children = append(children, n.Name)
+		}
+		if n.Value != nil {
+			children = append(children, n.Value)
+		}
+		return children, true
+	case *ast.AliasNode:
+		if n.Value == nil {
+			return nil, true
+		}
+		return []ast.Node{n.Value}, true
+	case *ast.CommentNode, *ast.CommentGroupNode:
+		return nil, true
+	}
+	return nil, false
+}
+
+// f2pFrozenFirstToken is the frozen head-token lookup used by the formatter
+// before the refactor (internal/format/format.go:134).
+func f2pFrozenFirstToken(node ast.Node) *token.Token {
+	switch n := node.(type) {
+	case *ast.DocumentNode:
+		if n.Start != nil {
+			return n.Start
+		}
+		return f2pFrozenFirstToken(n.Body)
+	case *ast.NullNode:
+		return n.Token
+	case *ast.BoolNode:
+		return n.Token
+	case *ast.IntegerNode:
+		return n.Token
+	case *ast.FloatNode:
+		return n.Token
+	case *ast.StringNode:
+		return n.Token
+	case *ast.InfinityNode:
+		return n.Token
+	case *ast.NanNode:
+		return n.Token
+	case *ast.MergeKeyNode:
+		return n.Token
+	case *ast.LiteralNode:
+		return n.Start
+	case *ast.DirectiveNode:
+		return n.Start
+	case *ast.TagNode:
+		return n.Start
+	case *ast.MappingNode:
+		if n.IsFlowStyle || len(n.Values) == 0 {
+			return n.Start
+		}
+		return f2pFrozenFirstToken(n.Values[0].Key)
+	case *ast.MappingKeyNode:
+		return n.Start
+	case *ast.SequenceNode:
+		return n.Start
+	case *ast.AnchorNode:
+		return n.Start
+	case *ast.AliasNode:
+		return n.Start
+	}
+	return nil
+}
+
+func f2pParseCorpus(t *testing.T) *ast.File {
+	t.Helper()
+	file, err := parser.ParseBytes([]byte(f2pCorpus), parser.ParseComments)
+	if err != nil {
+		t.Fatalf("F2P fixture corpus must parse, got error: %v", err)
+	}
+	if len(file.Docs) < 2 {
+		t.Fatalf("F2P fixture corpus must contain multiple documents, got %d", len(file.Docs))
+	}
+	return file
+}
+
+func f2pParseSingle(t *testing.T) *ast.File {
+	t.Helper()
+	file, err := parser.ParseBytes([]byte(f2pSingleDocument), parser.ParseComments)
+	if err != nil {
+		t.Fatalf("F2P single-document fixture must parse, got error: %v", err)
+	}
+	if len(file.Docs) != 1 {
+		t.Fatalf("F2P single-document fixture must contain one document, got %d", len(file.Docs))
+	}
+	return file
+}
+
+func f2pCollectDocs(t *testing.T, file *ast.File) ([]ast.Node, []ast.Node, map[ast.Node][]ast.Node) {
+	t.Helper()
+	var docs []ast.Node
+	var order []ast.Node
+	observed := map[ast.Node][]ast.Node{}
+	for _, doc := range file.Docs {
+		docOrder := f2pWalkOrder(doc)
+		docs = append(docs, doc)
+		order = append(order, docOrder...)
+		for node, children := range f2pObservedChildren(doc, docOrder) {
+			observed[node] = children
+		}
+	}
+	return docs, order, observed
+}
+
+func f2pNodesWhere(order []ast.Node, match func(ast.Node) bool) []ast.Node {
+	var out []ast.Node
+	for _, n := range order {
+		if match(n) {
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+func f2pContainsNode(nodes []ast.Node, target ast.Node) bool {
+	for _, n := range nodes {
+		if n == target {
+			return true
+		}
+	}
+	return false
+}
+
+func f2pIndexNode(nodes []ast.Node, target ast.Node) int {
+	for i, n := range nodes {
+		if n == target {
+			return i
+		}
+	}
+	return -1
+}
+
+func f2pSameNodes(a, b []ast.Node) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func f2pNodeLabel(n ast.Node) string {
+	if n == nil {
+		return "<nil>"
+	}
+	tk := n.GetToken()
+	if tk == nil {
+		return fmt.Sprintf("%s(no-token)", n.Type())
+	}
+	return fmt.Sprintf("%s(%q)", n.Type(), tk.Value)
+}
+
+func f2pNodeLabels(nodes []ast.Node) string {
+	labels := make([]string, 0, len(nodes))
+	for _, n := range nodes {
+		labels = append(labels, f2pNodeLabel(n))
+	}
+	return "[" + strings.Join(labels, ", ") + "]"
+}
+
+// f2pCapabilityChildrenMatch reports whether the capability children of a node
+// describe exactly the traversal children, accepting both frozen comment
+// conventions (comment included as the first child, or excluded).
+func f2pCapabilityChildrenMatch(expected []ast.Node, capabilityChildren []ast.Node, comment *ast.CommentGroupNode) bool {
+	if f2pSameNodes(expected, capabilityChildren) {
+		return true
+	}
+	if comment != nil && len(expected) > 0 && expected[0] == comment {
+		return f2pSameNodes(expected[1:], capabilityChildren)
+	}
+	return false
+}
+
+func f2pTokenEqual(a, b *token.Token) bool {
+	if a == b {
+		return true
+	}
+	if a == nil || b == nil {
+		return false
+	}
+	return a.Type == b.Type && a.Value == b.Value
+}
+
+func f2pTokenLabel(tk *token.Token) string {
+	if tk == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("%s(%q)", tk.Type, tk.Value)
+}
+
+// f2pAssertChildCapabilityMatchesTraversal checks one node family: the
+// capability must exist and enumerate exactly the children ast.Walk visits,
+// and the observed traversal must still match the frozen structural rule.
+func f2pAssertChildCapabilityMatchesTraversal(t *testing.T, family string, node ast.Node, observed []ast.Node) {
+	t.Helper()
+	structural, known := f2pFrozenStructuralChildren(node)
+	if !known {
+		t.Fatalf("%s: node kind %T is not covered by the frozen child enumeration", family, node)
+	}
+	var expected []ast.Node
+	if comment := node.GetComment(); comment != nil {
+		expected = append(expected, comment)
+	}
+	expected = append(expected, structural...)
+	if !f2pSameNodes(observed, expected) {
+		t.Fatalf("%s: node kind %T: frozen traversal children are %s, got %s", family, node, f2pNodeLabels(expected), f2pNodeLabels(observed))
+	}
+	capabilityChildren, capability, ok := f2pMatchingChildEnumeration(node)
+	if !ok {
+		if len(f2pChildrenCapabilities(node)) == 0 {
+			t.Fatalf("%s: node kind %T declares no child-enumeration capability (a method returning []ast.Node)", family, node)
+		}
+		t.Fatalf("%s: node kind %T declares child-enumeration methods, but none enumerates the frozen traversal children %s",
+			family, node, f2pNodeLabels(expected))
+	}
+	_ = capability
+	normalized := capabilityChildren
+	if comment := node.GetComment(); comment != nil && !f2pContainsNode(normalized, comment) {
+		normalized = append([]ast.Node{comment}, normalized...)
+	}
+	if !f2pSameNodes(normalized, expected) {
+		t.Fatalf("%s: node kind %T: capability %s enumerates %s, but the traversal children are %s",
+			family, node, capability.name, f2pNodeLabels(capabilityChildren), f2pNodeLabels(expected))
+	}
+}
+
+// f2pCapabilityDepthFirst returns the traversal order derived from the
+// capability set alone (with the comment convention normalised), starting at
+// root.
+func f2pCapabilityDepthFirst(t *testing.T, label string, root ast.Node) []ast.Node {
+	t.Helper()
+	var out []ast.Node
+	seen := map[ast.Node]bool{}
+	var visit func(node ast.Node)
+	visit = func(node ast.Node) {
+		if node == nil || seen[node] {
+			return
+		}
+		seen[node] = true
+		out = append(out, node)
+		children, _, ok := f2pTraversalChildren(node)
+		if !ok {
+			t.Fatalf("%s: node kind %T declares no child-enumeration capability (a method returning []ast.Node)", label, node)
+		}
+		for _, child := range children {
+			visit(child)
+		}
+	}
+	visit(root)
+	return out
+}
+
+// f2pWrapper types embed a concrete node kind. They satisfy ast.Node through
+// the promoted methods, so a traversal that dispatches on the concrete type
+// list cannot see through them, while a traversal that consumes the node
+// capability set traverses them exactly like the embedded kind.
+type f2pSequenceWrapper struct{ *ast.SequenceNode }
+
+type f2pMappingWrapper struct{ *ast.MappingNode }
+
+func f2pTestToken(value string) *token.Token {
+	return token.New(value, value, &token.Position{Line: 1, Column: 1})
+}
+
+func f2pStringNode(value string) *ast.StringNode {
+	return ast.String(f2pTestToken(value))
+}
