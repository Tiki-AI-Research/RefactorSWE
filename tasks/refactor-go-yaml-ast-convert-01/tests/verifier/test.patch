@@ -0,0 +1,58 @@
+package p2p_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// fixture is the decoded contents of testdata/p2p_snapshots.json.
+type fixture map[string]json.RawMessage
+
+func loadFixture(t *testing.T) fixture {
+	t.Helper()
+	b, err := os.ReadFile(filepath.Join("testdata", "p2p_snapshots.json"))
+	if err != nil {
+		t.Fatalf("read fixture: %v", err)
+	}
+	var f fixture
+	if err := json.Unmarshal(b, &f); err != nil {
+		t.Fatalf("decode fixture: %v", err)
+	}
+	return f
+}
+
+// fixtureValue decodes the fixture entry key into v.
+func fixtureValue(t *testing.T, f fixture, key string, v any) {
+	t.Helper()
+	raw, ok := f[key]
+	if !ok {
+		t.Fatalf("fixture key %q missing", key)
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		t.Fatalf("fixture key %q: %v", key, err)
+	}
+}
+
+// check fails the test when a record computation returned an error.
+func check(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("record computation failed: %v", err)
+	}
+}
+
+// firstDiff describes the first differing element of two string slices.
+func firstDiff(want, got []string) string {
+	for i := range want {
+		if i >= len(got) || want[i] != got[i] {
+			return fmt.Sprintf("index %d: want %q got %v", i, want[i], got)
+		}
+	}
+	if len(want) != len(got) {
+		return fmt.Sprintf("length: want %d got %d", len(want), len(got))
+	}
+	return ""
+}
