index 0000000..031914c
--- /dev/null
+++ b/tests/p2p_traversal_test.go
@@ -0,0 +1,179 @@
+package p2p_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/goccy/go-yaml/ast"
+	p2p "github.com/goccy/go-yaml/tests"
+)
+
+// TestWalkVisitOrderSnapshot pins the depth-first visit sequence produced by
+// ast.Walk for every fixture document (node type, token type and token value
+// of each visited node, in order).
+func TestWalkVisitOrderSnapshot(t *testing.T) {
+	fx := loadFixture(t)
+	var want map[string][][]string
+	fixtureValue(t, fx, "walk_order", &want)
+
+	got, err := p2p.WalkOrderRecords()
+	check(t, err)
+	if len(got) != len(want) {
+		t.Fatalf("corpus count: want %d got %d", len(want), len(got))
+	}
+	for _, name := range p2p.CorpusNames {
+		expected, ok := want[name]
+		if !ok {
+			t.Fatalf("fixture has no walk_order entry for %q", name)
+		}
+		if len(got[name]) != len(expected) {
+			t.Fatalf("%s: document count: want %d got %d", name, len(expected), len(got[name]))
+		}
+		for i := range expected {
+			if d := firstDiff(expected[i], got[name][i]); d != "" {
+				t.Fatalf("%s doc %d: walk order mismatch: %s", name, i, d)
+			}
+		}
+	}
+}
+
+// TestParentIdentitySnapshot pins ast.Parent identity for every node of the
+// richest fixture: for each node in visit order the snapshot records the
+// index (in the same order) of the node returned by ast.Parent, or -1 when the
+// parent is nil.
+func TestParentIdentitySnapshot(t *testing.T) {
+	fx := loadFixture(t)
+	var want []int
+	fixtureValue(t, fx, "parent_index", &want)
+
+	got, err := p2p.ParentIndexRecords()
+	check(t, err)
+	if len(got) != len(want) {
+		t.Fatalf("parent count: want %d got %d", len(want), len(got))
+	}
+	for i := range want {
+		if want[i] != got[i] {
+			t.Fatalf("parent index %d: want %d got %d", i, want[i], got[i])
+		}
+	}
+}
+
+// TestFilterOrderSnapshot pins ast.Filter results (order included) for the
+// mapping values, string scalars, comments and sequences of every fixture.
+func TestFilterOrderSnapshot(t *testing.T) {
+	fx := loadFixture(t)
+	var want map[string]p2p.FilterResult
+	fixtureValue(t, fx, "filter_results", &want)
+
+	got, err := p2p.FilterRecords()
+	check(t, err)
+	for _, name := range p2p.CorpusNames {
+		expected, ok := want[name]
+		if !ok {
+			t.Fatalf("fixture has no filter_results entry for %q", name)
+		}
+		for _, diff := range []struct {
+			field string
+			want  []string
+			got   []string
+		}{
+			{"mapping_values", expected.MappingValues, got[name].MappingValues},
+			{"strings", expected.Strings, got[name].Strings},
+			{"comments", expected.Comments, got[name].Comments},
+			{"sequences", expected.Sequences, got[name].Sequences},
+		} {
+			if d := firstDiff(diff.want, diff.got); d != "" {
+				t.Fatalf("%s: filter(%s) mismatch: %s", name, diff.field, d)
+			}
+		}
+	}
+}
+
+// TestFilterFileSnapshot pins ast.FilterFile results collected across all
+// documents of a multi-document file.
+func TestFilterFileSnapshot(t *testing.T) {
+	fx := loadFixture(t)
+	var want p2p.FilterFileResult
+	fixtureValue(t, fx, "filter_file", &want)
+
+	got, err := p2p.FilterFileRecords()
+	check(t, err)
+	if d := firstDiff(want.MappingValues, got.MappingValues); d != "" {
+		t.Fatalf("FilterFile(mapping values) mismatch: %s", d)
+	}
+	if d := firstDiff(want.Strings, got.Strings); d != "" {
+		t.Fatalf("FilterFile(strings) mismatch: %s", d)
+	}
+}
+
+// TestVisitorProtocolCalls pins the visitor call protocol: how many Visit
+// calls happen for a full walk and what happens when a visitor stops
+// descending into a subtree.
+func TestVisitorProtocolCalls(t *testing.T) {
+	// Returning nil prunes before any node fields are read. This also lets a
+	// visitor safely handle typed-nil nodes using the existing public API.
+	pruned := []ast.Node{
+		(*ast.DocumentNode)(nil), (*ast.NullNode)(nil), (*ast.IntegerNode)(nil),
+		(*ast.FloatNode)(nil), (*ast.StringNode)(nil), (*ast.LiteralNode)(nil),
+		(*ast.MergeKeyNode)(nil), (*ast.BoolNode)(nil), (*ast.InfinityNode)(nil),
+		(*ast.NanNode)(nil), (*ast.MappingNode)(nil), (*ast.MappingKeyNode)(nil),
+		(*ast.MappingValueNode)(nil), (*ast.SequenceNode)(nil), (*ast.SequenceEntryNode)(nil),
+		(*ast.AnchorNode)(nil), (*ast.AliasNode)(nil), (*ast.DirectiveNode)(nil),
+		(*ast.TagNode)(nil), (*ast.CommentNode)(nil), (*ast.CommentGroupNode)(nil),
+	}
+	for _, node := range pruned {
+		t.Run("prune_"+reflect.TypeOf(node).Elem().Name(), func(t *testing.T) {
+			defer func() {
+				if err := recover(); err != nil {
+					t.Fatalf("Walk must honor visitor pruning before reading node fields: %v", err)
+				}
+			}()
+			visitor := &pruningVisitor{}
+			ast.Walk(visitor, node)
+			if len(visitor.seen) != 1 || visitor.seen[0] != node {
+				t.Fatal("pruned Walk must call Visit exactly once with the original node")
+			}
+		})
+	}
+
+	fx := loadFixture(t)
+	var want p2p.VisitorProtocolRecord
+	fixtureValue(t, fx, "visitor_protocol", &want)
+
+	got, err := p2p.VisitorProtocolRecords()
+	check(t, err)
+	if got.Visits != want.Visits || got.NilVisits != want.NilVisits || got.StopStopped != want.StopStopped {
+		t.Fatalf("visitor protocol mismatch: want visits=%d nils=%d stopped=%v, got visits=%d nils=%d stopped=%v",
+			want.Visits, want.NilVisits, want.StopStopped, got.Visits, got.NilVisits, got.StopStopped)
+	}
+	if d := firstDiff(want.StopSeen, got.StopSeen); d != "" {
+		t.Fatalf("visitor stop sequence mismatch: %s", d)
+	}
+}
+
+// TestWalkVisitsEachNodeOnce guards against repeated traversal work: every
+// node pointer must be visited at most once by Walk, and the total visit count
+// for the fixtures and for a larger generated document must match the frozen
+// baseline.
+func TestWalkVisitsEachNodeOnce(t *testing.T) {
+	assertInternalWork(t, "walk")
+	fx := loadFixture(t)
+	var want map[string]int
+	fixtureValue(t, fx, "walk_counts", &want)
+
+	got, err := p2p.WalkCountRecords()
+	check(t, err)
+	if !reflect.DeepEqual(want, got) {
+		t.Fatalf("walk counts mismatch:\nwant %v\ngot  %v", want, got)
+	}
+}
+
+// pruningVisitor exercises only the pre-existing Visitor and Walk API.
+type pruningVisitor struct {
+	seen []ast.Node
+}
+
+func (v *pruningVisitor) Visit(node ast.Node) ast.Visitor {
+	v.seen = append(v.seen, node)
+	return nil
+}
diff --git a/tests/p2p_work_test.go b/tests/p2p_work_test.go
