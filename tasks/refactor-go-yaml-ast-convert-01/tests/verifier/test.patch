index 0000000..38fda2b
--- /dev/null
+++ b/tests/workcheck/main.go
@@ -0,0 +1,213 @@
+// Observe private traversal work without changing the candidate or its ABI.
+// Only calls resolved to the existing ast.Visitor.Visit method are wrapped.
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/importer"
+	"go/parser"
+	"go/printer"
+	"go/token"
+	"go/types"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+)
+
+const module = "github.com/goccy/go-yaml"
+
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}
+
+func main() {
+	root, err := filepath.Abs(os.Args[1])
+	must(err)
+	cmd := exec.Command("go", "list", "-deps", "-export", "-json", "./ast")
+	cmd.Dir = root
+	raw, err := cmd.Output()
+	must(err)
+	var target struct {
+		ImportPath, Dir string
+		GoFiles         []string
+	}
+	exports := map[string]string{}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	for {
+		var meta struct {
+			ImportPath, Dir, Export string
+			GoFiles                 []string
+		}
+		err := decoder.Decode(&meta)
+		if err == io.EOF {
+			break
+		}
+		must(err)
+		exports[meta.ImportPath] = meta.Export
+		if meta.ImportPath == module+"/ast" {
+			target.ImportPath, target.Dir, target.GoFiles = meta.ImportPath, meta.Dir, meta.GoFiles
+		}
+	}
+	if target.Dir == "" {
+		panic("missing ast package")
+	}
+	fs := token.NewFileSet()
+	var files []*ast.File
+	for _, name := range target.GoFiles {
+		file, err := parser.ParseFile(fs, filepath.Join(target.Dir, name), nil, parser.ParseComments|parser.SkipObjectResolution)
+		must(err)
+		files = append(files, file)
+	}
+	info := &types.Info{Selections: map[*ast.SelectorExpr]*types.Selection{}}
+	imp := importer.ForCompiler(fs, "gc", func(path string) (io.ReadCloser, error) { return os.Open(exports[path]) })
+	cfg := types.Config{Importer: imp}
+	_, err = cfg.Check(target.ImportPath, fs, files, info)
+	must(err)
+	tmp, err := os.MkdirTemp("", "case30-work-")
+	must(err)
+	defer os.RemoveAll(tmp)
+	replacements := map[string]string{}
+	wrapped := 0
+	for i, file := range files {
+		// Rewrite method values as well as direct calls. A local alias such as
+		// visit := visitor.Visit must remain a legal equivalent implementation.
+		var rewrite func(reflect.Value)
+		rewrite = func(value reflect.Value) {
+			switch value.Kind() {
+			case reflect.Interface:
+				if value.IsNil() {
+					return
+				}
+				rewrite(value.Elem())
+				sel, ok := value.Interface().(*ast.SelectorExpr)
+				if !ok {
+					return
+				}
+				selection := info.Selections[sel]
+				if selection == nil {
+					return
+				}
+				method := selection.Obj()
+				if method.Pkg() == nil || method.Pkg().Path() != module+"/ast" || method.Name() != "Visit" {
+					return
+				}
+				sig, ok := method.Type().(*types.Signature)
+				if !ok || sig.Params().Len() != 1 || sig.Results().Len() != 1 {
+					return
+				}
+				// Restrict instrumentation to the original public visitor contract.
+				if types.TypeString(sig.Params().At(0).Type(), nil) != module+"/ast.Node" || types.TypeString(sig.Results().At(0).Type(), nil) != module+"/ast.Visitor" {
+					return
+				}
+				var replacement ast.Expr = &ast.CallExpr{Fun: ast.NewIdent("qcBindVisit"), Args: []ast.Expr{sel.X}}
+				if selection.Kind() == types.MethodExpr {
+					replacement = ast.NewIdent("qcObserveVisit")
+				}
+				value.Set(reflect.ValueOf(replacement))
+				wrapped++
+			case reflect.Ptr:
+				if !value.IsNil() {
+					rewrite(value.Elem())
+				}
+			case reflect.Struct:
+				for i := 0; i < value.NumField(); i++ {
+					rewrite(value.Field(i))
+				}
+			case reflect.Slice:
+				for i := 0; i < value.Len(); i++ {
+					rewrite(value.Index(i))
+				}
+			}
+		}
+		rewrite(reflect.ValueOf(file))
+		var source bytes.Buffer
+		must(printer.Fprint(&source, fs, file))
+		if i == 0 {
+			source.WriteString(counterSource)
+		}
+		path := filepath.Join(tmp, filepath.Base(target.GoFiles[i]))
+		must(os.WriteFile(path, source.Bytes(), 0600))
+		replacements[filepath.Join(target.Dir, target.GoFiles[i])] = path
+	}
+	if wrapped == 0 {
+		panic("no ast.Visitor.Visit observation sites")
+	}
+	overlay, err := json.Marshal(map[string]any{"Replace": replacements})
+	must(err)
+	overlayPath := filepath.Join(tmp, "overlay.json")
+	must(os.WriteFile(overlayPath, overlay, 0600))
+	probePath := filepath.Join(tmp, "probe.go")
+	must(os.WriteFile(probePath, []byte(probeSource), 0600))
+	cmd = exec.Command("go", "run", "-overlay", overlayPath, probePath)
+	cmd.Dir, cmd.Stderr = root, os.Stderr
+	output, err := cmd.Output()
+	must(err)
+	var result map[string]any
+	must(json.Unmarshal(output, &result))
+	result["instrumented_sites"] = wrapped
+	output, err = json.MarshalIndent(result, "", "  ")
+	must(err)
+	fmt.Println(string(output))
+}
