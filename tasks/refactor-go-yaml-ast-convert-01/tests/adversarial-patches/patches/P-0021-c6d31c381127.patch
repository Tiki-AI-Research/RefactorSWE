+// KindNode is the set of capabilities supplied by every node kind of this package.
+// It is separate from Node so that a type outside of this package that satisfies Node
+// keeps compiling; such a type is handled like a leaf without a first token.
+// That includes a type that embeds a node kind and so inherits these methods.
+type KindNode interface {
+	Node
+	// EachChild calls yield for each child, in Walk order, until yield returns false.
+	// A child that is not set is still passed to yield. Comments are not children.
+	EachChild(yield func(Node) bool)
+	// FirstToken returns the token where the text of the node starts.
+	// It returns nil if the node cannot be formatted on its own.
+	FirstToken() *token.Token
+	// Accept calls the method of v for the kind of this node.
+	Accept(v KindVisitor)
+	// walkedComment returns the comment that Walk visits ahead of the children.
+	walkedComment() *CommentGroupNode
+	// self returns the node of the kind that supplies these methods.
+	self() Node
+}
+
+// kindOf returns node as a KindNode, unless it only inherits the methods by embedding a node kind.
+func kindOf(node Node) (KindNode, bool) {
+	n, ok := node.(KindNode)
+	if !ok || n.self() != node {
+		return nil, false
+	}
+	return n, true
+}
+
+// FirstToken returns the first token of node.
+// It returns nil for a nil node and for a node that is not one of the kinds of this package.
+func FirstToken(node Node) *token.Token {
+	if n, ok := kindOf(node); ok {
+		return n.FirstToken()
+	}
+	return nil
+}
+
+// Accept calls the method of v for the kind of node.
+// It does nothing for a nil node and for a node that is not one of the kinds of this package.
+func Accept(node Node, v KindVisitor) {
+	if n, ok := kindOf(node); ok {
+		n.Accept(v)
+	}
+}
