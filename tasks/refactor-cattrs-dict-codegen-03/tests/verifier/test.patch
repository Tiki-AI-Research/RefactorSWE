+def test_converted_default_effects_preserved():
+    # A static default's attribute converter runs while the hook is generated; how
+    # many times it runs there is not part of the contract. The omission check uses
+    # the converted default produced during generation, the hook never calls the
+    # converter, and a failure on the converter's first call aborts generation.
+    for a in [False, True]:
+        assert default_case(a, 1) == EXPECTED['defaults'][f'{a}/1']
+        observed = default_case(a, 0)
+        generation = observed['generation_calls']
+        assert generation and all(v == 0 for v in generation)
+        assert observed['final_calls'] == generation
+        converted = len(generation) * 10
+        assert observed['outputs'] == [{'value': {} if v == converted else {'value': v}} for v in [10, 20, 30]]
