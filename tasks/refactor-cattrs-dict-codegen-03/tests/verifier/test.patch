+++ b/tests/f2p_support/operations.py
@@ -0,0 +1,269 @@
+"""In-memory expression provenance for the structural F2P oracle.
+
+The loader leaves production files untouched. Every probe returns its input;
+assignment probes perform the original assignment once and preserve evaluation
+order. Only a Trace.run context retains events. Data edges follow the actual
+returned values, including strings inside containers, rather than all events
+seen in an enclosing function. In particular a caller does not inherit unused
+expressions executed by its callees.
+"""
+
+import ast
+from dataclasses import dataclass, field
+import importlib.abc
+import importlib.machinery
+import inspect
+import copy
+from pathlib import Path
+import sys
+
+ACTIVE = None
+SITES = {}
+PREFIX = '_f2p_operation_'
+
+
+def leaves(value, seen=None):
+    """Retain text objects by identity, through containers and generator state."""
+    if isinstance(value, (str, bytes)):
+        yield value
+        return
+    if seen is None:
+        seen = set()
+    if id(value) in seen:
+        return
+    seen.add(id(value))
+    if isinstance(value, dict):
+        values = tuple(value.keys()) + tuple(value.values())
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        values = tuple(value)
+    elif type(value).__module__.startswith('cattrs.gen'):
+        values = list(vars(value).values()) if hasattr(value, '__dict__') else []
+        for cls in type(value).__mro__:
+            slots = cls.__dict__.get('__slots__', ())
+            for name in ([slots] if isinstance(slots, str) else slots):
+                if name not in ('__dict__', '__weakref__') and hasattr(value, name):
+                    values.append(getattr(value, name))
+    else:
+        return
+    for item in values:
+        yield from leaves(item, seen)
+
+
+def text(value):
+    if isinstance(value, bytes):
+        return value.decode('utf8', errors='replace')
+    return value
+
+
+@dataclass(eq=False)
+class Expression:
+    site: int
+    code: object
+    frame: object
+    children: list = field(default_factory=list)
+    dependencies: list = field(default_factory=list)
+    values: tuple = ()
+
+    def contains(self, snippet):
+        return any(snippet in text(v) for v in self.values)
+
+
+class Recorder:
+    def __init__(self):
+        self.pending = []
+        self.origins = {}
+        self.events = []
+        self.assignments = []
+
+    def begin(self, site, frame):
+        event = Expression(site, frame.f_code, frame)
+        self.pending.append(event)
+        return event
+
+    def end(self, event, value):
+        # An exception can leave unfinished expressions behind. Remove them,
+        # never turn their partial execution into a value/dependency witness.
+        while self.pending and self.pending[-1] is not event:
+            self.pending.pop()
+        if self.pending:
+            self.pending.pop()
+        event.values = tuple(leaves(value))
+        node = SITES[event.site][1]
+        prior_values = []
+        for leaf in event.values:
+            prior = self.origins.get(id(leaf))
+            if prior is not None and any(v is leaf for v in prior.values):
+                prior_values.append(prior)
+        # A read of an already tracked member depends on THAT member, not
+        # unrelated strings in its containing object. A slice/extraction that
+        # creates a new object must keep its input expression ancestry.
+        member_read = isinstance(node, (ast.Name, ast.Attribute, ast.Subscript))
+        known = bool(event.values) and len(prior_values) == len(event.values)
+        event.dependencies = ([] if member_read and known else list(event.children))
+        if not isinstance(node, ast.Constant):
+            event.dependencies.extend(prior_values)
+        if isinstance(value, (str, bytes)):
+            self.origins[id(value)] = event
+        else:
+            # A split/decoder can return newly allocated strings in a list.
+            # Bind each new member to the transforming expression so a later
+            # subscript cannot sever its ancestry to the original string.
+            for leaf in event.values:
+                if id(leaf) not in self.origins:
+                    member = Expression(event.site, event.code, event.frame,
+                                        dependencies=list(event.dependencies), values=(leaf,))
+                    self.origins[id(leaf)] = member
+        self.events.append(event)
+        if self.pending and self.pending[-1].frame is event.frame:
+            self.pending[-1].children.append(event)
+        return value
+
+    def root(self, value):
+        return self.origins.get(id(value))
+
+    def producers(self, root, snippet):
+        """Find actual construction along value dependencies, through codecs.
+
+        A read, join, decoder or extractor cannot become an origin when its
+        input already derives from a construction containing this snippet.
+        This searches the complete ancestry, not only the immediate inputs.
+        """
+        memo = {}
+        def visit(event):
+            if event is None:
+                return set()
+            if id(event) in memo:
+                return memo[id(event)]
+            inherited = set()
+            for dependency in event.dependencies:
+                inherited.update(visit(dependency))
+            found = inherited or ({event} if event.contains(snippet) else set())
+            memo[id(event)] = found
+            return found
+        return visit(root)
+
+
+def begin(site):
+    return None if ACTIVE is None else ACTIVE.begin(site, inspect.currentframe().f_back)
+
+
+def end(event, value):
+    return value if event is None or ACTIVE is None else ACTIVE.end(event, value)
+
+
+def assign(value, target, name):
+    # RHS, target expression, attribute name: Python's STORE_ATTR order.
+    setattr(target, name, value)
+    if ACTIVE is not None:
+        ACTIVE.assignments.append((inspect.currentframe().f_back.f_code, target, name, value))
+
+
+class Instrument(ast.NodeTransformer):
+    def __init__(self, filename):
+        self.filename = filename
+        self.in_function = 0
+        self.classes = []
+
+    def visit_ClassDef(self, node):
+        self.classes.append(node.name)
+        node = self.generic_visit(node)
+        self.classes.pop()
+        return node
+
+    def visit_FunctionDef(self, node):
+        # Decorators, defaults and annotations keep their original scope.
+        self.in_function += 1
+        body = []
+        for statement in node.body:
+            changed = self.visit(statement)
+            body.extend(changed if isinstance(changed, list) else [changed])
+        node.body = body
+        self.in_function -= 1
+        return node
+
+    visit_AsyncFunctionDef = visit_FunctionDef
+
+    def visit_Expr(self, node):
+        if isinstance(node.value, ast.Constant):  # docstrings
+            return node
+        return self.generic_visit(node)
+
+    def visit_JoinedStr(self, node):
+        # JoinedStr requires raw Constant/FormattedValue children.
+        for item in node.values:
+            if isinstance(item, ast.FormattedValue):
+                item.value = self.visit(item.value)
+                if item.format_spec is not None:
+                    item.format_spec = self.visit_format(item.format_spec)
+        return node
+
+    def visit_format(self, node):
+        return self.visit_JoinedStr(node)
+
+    def visit_AugAssign(self, node):
+        # Record the result of in-place string/name formation at the operation,
+        # before a later reader or substring extractor can claim ownership.
+        updated = self.generic_visit(node)
+        if self.in_function and isinstance(node.target, (ast.Name, ast.Attribute)):
+            read = copy.deepcopy(node.target)
+            read.ctx = ast.Load()
+            site = len(SITES)
+            SITES[site] = (self.filename, node)
+            observation = ast.Expr(ast.Call(ast.Name(PREFIX + 'end', ast.Load()), [
+                ast.Call(ast.Name(PREFIX + 'begin', ast.Load()), [ast.Constant(site)], []), read
+            ], []))
+            return [updated, ast.copy_location(observation, node)]
+        return updated
+
+    def visit_Assign(self, node):
+        if self.in_function and len(node.targets) == 1 and isinstance(node.targets[0], ast.Attribute):
+            target = node.targets[0]
+            attr = target.attr
+            if self.classes and attr.startswith('__') and not attr.endswith('__'):
+                attr = '_' + self.classes[-1].lstrip('_') + attr
+            return ast.copy_location(ast.Expr(ast.Call(
+                ast.Name(PREFIX + 'assign', ast.Load()),
+                [self.visit(node.value), self.visit(target.value), ast.Constant(attr)], [])), node)
+        return self.generic_visit(node)
+
+    def visit(self, node):
+        original = node
+        node = super().visit(node)
+        if (self.in_function and isinstance(node, ast.expr)
+                and not isinstance(node, (ast.Starred, ast.FormattedValue, ast.Yield, ast.YieldFrom))
+                and not (hasattr(node, 'ctx') and not isinstance(node.ctx, ast.Load))):
+            site = len(SITES)
+            SITES[site] = (self.filename, original)
+            node = ast.copy_location(ast.Call(ast.Name(PREFIX + 'end', ast.Load()), [
+                ast.Call(ast.Name(PREFIX + 'begin', ast.Load()), [ast.Constant(site)], []), node
+            ], []), original)
+        return node
+
+
+class Loader(importlib.machinery.SourceFileLoader):
+    def get_code(self, fullname):
+        filename = self.get_filename(fullname)
+        tree = ast.parse(self.get_data(filename), filename)
+        tree = Instrument(filename).visit(tree)
+        ast.fix_missing_locations(tree)
+        return compile(tree, filename, 'exec', dont_inherit=True)
+
+    def exec_module(self, module):
+        module.__dict__.update({PREFIX + 'begin': begin, PREFIX + 'end': end,
+                                PREFIX + 'assign': assign})
+        super().exec_module(module)
+
+
+class Finder(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname != 'cattrs' and not fullname.startswith('cattrs.'):
+            return None
+        spec = importlib.machinery.PathFinder.find_spec(fullname, path)
+        if spec and isinstance(spec.loader, importlib.machinery.SourceFileLoader):
+            spec.loader = Loader(fullname, spec.origin)
+        return spec
+
+
+def install():
+    assert 'cattrs.gen' not in sys.modules, 'Provenance loader must precede cattrs imports'
+    sys.meta_path.insert(0, Finder())
