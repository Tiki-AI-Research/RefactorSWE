@@ -0,0 +1,428 @@
+"""Independent structural obligations exercised through real public dict factories.
+
+No private class, method, module, argument, or generated identifier is prescribed.
+The oracle is the observed ownership/dataflow of each shared responsibility plus
+the public hook's behavior. Probe edits exist only in process memory.
+"""
+
+import ast
+from dataclasses import make_dataclass
+import inspect
+import linecache
+from typing import Generic, TypeVar
+
+from attrs import define, fields
+from typing_extensions import TypedDict
+
+from cattrs import Converter
+from cattrs.errors import AttributeValidationNote, ClassValidationError, ForbiddenExtraKeysError
+from cattrs.gen import (
+    make_dict_structure_fn, make_dict_structure_fn_from_attrs,
+    make_dict_unstructure_fn, make_dict_unstructure_fn_from_attrs, override,
+)
+from cattrs.gen.typeddicts import make_dict_structure_fn as td_structure
+from cattrs.gen.typeddicts import make_dict_unstructure_fn as td_unstructure
+from tests.f2p_support.provenance import (
+    Trace, common, contains_code, emitted_common, patch_emitter,
+)
+
+
+@define
+class Record:
+    value: int
+    other: int = 2
+
+
+class MappingRecord(TypedDict):
+    value: int
+    other: int
+
+
+T = TypeVar("T")
+
+
+@define
+class GenericRecord(Generic[T]):
+    value: T
+
+
+class GenericMapping(TypedDict, Generic[T]):
+    value: T
+
+
+def convert_value(value, _):
+    return int(value) + 10
+
+
+def unconvert_value(value):
+    return value + 20
+
+
+def factories(operation="structure", detailed=True, linecache_enabled=True, forbid=False,
+              all_entries=False, struct_hook=convert_value, wire_name="wire"):
+    opts = {"_cattrs_use_linecache": linecache_enabled,
+            "value": override(rename=wire_name, struct_hook=struct_hook,
+                              unstruct_hook=unconvert_value)}
+    if operation == "structure":
+        opts.update(_cattrs_detailed_validation=detailed, _cattrs_forbid_extra_keys=forbid)
+        a_factory, td_factory, fields_factory = make_dict_structure_fn, td_structure, make_dict_structure_fn_from_attrs
+    else:
+        a_factory, td_factory, fields_factory = make_dict_unstructure_fn, td_unstructure, make_dict_unstructure_fn_from_attrs
+    makers = [lambda: a_factory(Record, Converter(), **opts),
+              lambda: td_factory(MappingRecord, Converter(), **opts)]
+    if all_entries:
+        dc = make_dataclass("DataclassRecord", [("value", int), ("other", int)])
+        makers.extend([lambda: a_factory(dc, Converter(), **opts),
+                       lambda: fields_factory(list(fields(Record)), Record, Converter(), **opts)])
+    return makers
+
+
+def observe(makers):
+    return [Trace().run(m) for m in makers]
+
+
+def assert_values(traces, operation="structure"):
+    for t in traces:
+        if operation == "structure":
+            result = t.hook({"wire": "3", "other": "4"}, None)
+            actual = result if isinstance(result, dict) else {"value": result.value, "other": result.other}
+            assert actual == {"value": 13, "other": 4}
+        else:
+            assert t.hook(Record(3, 4) if t is traces[0] else {"value": 3, "other": 4}) == {"wire": 23, "other": 4}
+
+
+def errors(hook, payload):
+    try:
+        hook(payload, None)
+    except ClassValidationError as exc:
+        return list(exc.exceptions)
+    raise AssertionError("Expected a ClassValidationError containing actual field failures")
+
+
+def field_handler(trace):
+    return next(n for n in ast.walk(trace.tree) if isinstance(n, ast.ExceptHandler)
+                and any(isinstance(x, ast.Attribute) and x.attr == "__notes__" for x in ast.walk(n)))
+
+
+def collect_statement(trace):
+    handler = field_handler(trace)
+    return next(n for n in ast.walk(handler) if isinstance(n, ast.Expr)
+                and isinstance(n.value, ast.Call) and isinstance(n.value.func, ast.Attribute)
+                and n.value.func.attr == "append" and len(n.value.args) == 1
+                and isinstance(n.value.args[0], ast.Name) and n.value.args[0].id == handler.name)
+
+
+def aggregate_call(trace):
+    for call in trace.call_nodes(ClassValidationError):
+        if len(call.args) >= 2 and isinstance(call.args[1], ast.Name):
+            return call
+    raise AssertionError("No ClassValidationError uses the collected field-error variable")
+
+
+def test_common_source_assembly_consumes_family_bodies():
+    """Both distinct bodies acquire their final function header in shared code."""
+    traces = observe(factories("unstructure"))
+    owners = []
+    for t in traces:
+        header = t.compilation.source.splitlines()[0]
+        owners.append(t.emission_owners([header]))
+    common([t.emission_owners([t.compilation.source]) for t in traces],
+           "joining the actual header and family body into compiler input")
+    common(owners, "assembly of the final source header and family-specific body")
+    assert_values(traces, "unstructure")
+
+
+def test_public_entries_delegate_dynamic_compilation():
+    """Class, dataclass, from_attrs and TypedDict entry points share compilation."""
+    makers = factories(all_entries=True)
+    traces = observe(makers)
+    owner, = common([{t.compilation.stack[0].code} for t in traces],
+                    "dynamic compilation of the returned hook")
+    assert_values(traces)
+
+    class CompileProbe(Exception):
+        pass
+
+    sentinel = CompileProbe("public generation reached the shared compiler")
+
+    def stop_at_owner(stack, source, filename):
+        if stack[0].code is owner:
+            raise sentinel
+
+    for make in makers:
+        try:
+            Trace().run(make, before_compile=stop_at_owner)
+        except CompileProbe as exc:
+            assert exc is sentinel
+        else:
+            raise AssertionError("The public entry bypassed its observed shared compiler")
+
+
+def test_shared_binding_namespace_executes_bound_field_hook():
+    """The shared executor consumes the namespace that binds the effective hook."""
+    makers = factories("unstructure")
+    traces = observe(makers)
+    owners = []
+    for t in traces:
+        bound = [e for e in t.executions
+                 if e.namespace is t.hook.__globals__
+                 and e.code is t.compilation.code
+                 and contains_code(e.code, t.hook.__code__)
+                 and unconvert_value in e.namespace.values()]
+        assert bound, "The overridden handler must flow through the actual execution namespace"
+        owners.append({e.stack[0].code for e in bound})
+    owner, = common(owners, "execution using the hook's bound namespace")
+    assert_values(traces, "unstructure")
+
+    # Change only the namespace at this executor, BEFORE it evaluates the hook
+    # definition. Generated default arguments can then capture this exact spy.
+    for make, payload in zip(makers, (Record(3, 4), {"value": 3, "other": 4})):
+        calls = []
+        namespaces = []
+
+        def bound_spy(value):
+            frame = inspect.currentframe().f_back
+            callers = []
+            while frame is not None:
+                callers.append(frame.f_code)
+                frame = frame.f_back
+            calls.append((value, callers))
+            return value + 100
+
+        def replace_binding(stack, code, namespace):
+            if stack[0].code is owner and unconvert_value in namespace.values():
+                namespaces.append(namespace)
+                for name, value in list(namespace.items()):
+                    if value is unconvert_value:
+                        namespace[name] = bound_spy
+
+        observed = Trace().run(make, before_execute=replace_binding)
+        assert any(ns is observed.hook.__globals__ for ns in namespaces)
+        assert observed.hook(payload) == {"wire": 103, "other": 4}
+        assert len(calls) == 1 and calls[0][0] == 3
+        assert observed.hook.__code__ in calls[0][1]
+
+
+def test_shared_finalizer_attaches_effective_overrides():
+    """The exact returned hooks acquire overrides inside the common finalizer."""
+    traces = observe(factories())
+    common([t.attachment_owners() for t in traces],
+           "attaching effective overrides to the returned hook")
+    for t in traces:
+        assert t.hook.overrides == {"value": override(rename="wire", struct_hook=convert_value,
+                                                      unstruct_hook=unconvert_value)}
+    assert_values(traces)
+
+
+def test_generic_hook_name_is_formed_by_shared_generation(monkeypatch):
+    """The actual generic hook identifier originates in common naming code."""
+    makers = [lambda: make_dict_structure_fn(GenericRecord[int], Converter()),
+              lambda: td_structure(GenericMapping[int], Converter())]
+    traces = observe(makers)
+    owners = []
+    for t in traces:
+        name = t.hook.__name__
+        owners.append(t.name_owners())
+        assert t.hook({"value": "7"}, None) in (GenericRecord(7), {"value": 7})
+    owner = next(iter(common(owners, "forming the identifier used for the generic generated hook")))
+    names = {t.hook.__name__: t.hook.__name__ + "_f2p_name" for t in traces}
+    with monkeypatch.context() as patch:
+        patch_emitter(patch, owner, names)
+        for make, trace in zip(makers, traces):
+            hook = make()
+            assert hook.__name__ == names[trace.hook.__name__]
+            assert hook({"value": "7"}, None) in (GenericRecord(7), {"value": 7})
+
+
+def test_shared_source_registration_uses_actual_compiled_lines():
+    """Registration is delegated from common code using this hook's source."""
+    traces = observe(factories())
+    owners = []
+    for t in traces:
+        filename = t.hook.__code__.co_filename
+        source = t.compilation.source
+        owners.append(t.registration_owners())
+        assert "\n".join(linecache.cache[filename][2]) == source
+    common(owners, "handing the actual compiled source to traceback registration")
+
+
+def test_shared_field_wrapper_collects_the_caught_exception(monkeypatch):
+    """A probe to common emission changes the same field accumulator later raised."""
+    sentinel = ValueError("the original field exception")
+
+    def failing_field(value, type_):
+        raise sentinel
+
+    makers = factories(struct_hook=failing_field)
+    traces = observe(makers)
+    snippets = []
+    for t in traces:
+        statement = collect_statement(t)
+        collector = statement.value.func.value
+        assert isinstance(collector, ast.Name)
+        assert aggregate_call(t).args[1].id == collector.id
+        snippets.append([t.segment(statement)])
+        caught = errors(t.hook, {"wire": "bad", "other": "bad"})
+        assert len(caught) == 2 and caught[0] is sentinel
+    owner = next(iter(emitted_common(traces, snippets, "collecting each caught field exception")))
+    with monkeypatch.context() as patch:
+        # Duplicating one collected exception is observable in the actual aggregate.
+        patch_emitter(patch, owner, {parts[0]: parts[0] + "; " + parts[0] for parts in snippets})
+        for make in makers:
+            caught = errors(make(), {"wire": "bad", "other": "bad"})
+            assert len(caught) == 4
+            assert caught[0] is caught[1] is sentinel
+            assert caught[2] is caught[3]
+
+
+def test_shared_note_emission_annotates_the_actual_failure(monkeypatch):
+    """The common note constructor supplies annotations on the propagated errors."""
+    raised = []
+
+    def failing_field(value, type_):
+        failure = ValueError("annotated original")
+        failure.__notes__ = ["original note"]
+        raised.append(failure)
+        raise failure
+
+    makers = factories(struct_hook=failing_field)
+    traces = observe(makers)
+    snippets = []
+    for t in traces:
+        notes = t.call_nodes(AttributeValidationNote)
+        assert notes
+        snippets.append([t.segment(notes[0])])
+        failure = errors(t.hook, {"wire": "bad", "other": 2})[0]
+        assert failure is raised[-1]
+        assert failure.__notes__[0] == "original note"
+        assert any(isinstance(n, AttributeValidationNote) and n.name == "value"
+                   and n.type is int for n in failure.__notes__)
+    owner = next(iter(emitted_common(traces, snippets, "annotating caught field errors")))
+    with monkeypatch.context() as patch:
+        patch_emitter(patch, owner, " @ attribute ", " [F2P-note] @ attribute ")
+        for make in makers:
+            failure = errors(make(), {"wire": "bad", "other": 2})[0]
+            assert failure is raised[-1]
+            assert failure.__notes__[0] == "original note"
+            assert any("[F2P-note]" in n for n in failure.__notes__)
+
+
+def test_shared_aggregate_wrapper_uses_the_collected_errors(monkeypatch):
+    """The shared error expression receives the real accumulator, not unrelated state."""
+    raised = []
+
+    def failing_field(value, type_):
+        failure = ValueError("original aggregate member")
+        raised.append(failure)
+        raise failure
+
+    makers = factories(struct_hook=failing_field)
+    traces = observe(makers)
+    snippets = []
+    for t in traces:
+        call = aggregate_call(t)
+        statement = collect_statement(t)
+        assert call.args[1].id == statement.value.func.value.id
+        snippets.append([t.segment(call)])
+    owner = next(iter(emitted_common(traces, snippets, "wrapping the actual field-error accumulator")))
+    with monkeypatch.context() as patch:
+        patch_emitter(patch, owner, "While structuring ", "F2P aggregate for ")
+        for make in makers:
+            try:
+                make()({"wire": "bad", "other": "bad"}, None)
+            except ClassValidationError as exc:
+                assert exc.message.startswith("F2P aggregate for ")
+                assert len(exc.exceptions) == 2
+                assert exc.exceptions[0] is raised[-1]
+            else:
+                raise AssertionError("The aggregate must propagate both field failures")
+
+
+def extra_parts(trace, detailed):
+    call = trace.call_nodes(ForbiddenExtraKeysError)[0]
+    unknown = call.args[-1]
+    assert isinstance(unknown, ast.Name)
+    assignment = next(n for n in ast.walk(trace.tree) if isinstance(n, ast.Assign)
+                      and any(isinstance(t, ast.Name) and t.id == unknown.id for t in n.targets))
+    if detailed:
+        action = next(n for n in ast.walk(trace.tree) if isinstance(n, ast.Call)
+                      and isinstance(n.func, ast.Attribute) and n.func.attr == "append"
+                      and call in n.args)
+        assert isinstance(action.func.value, ast.Name)
+        assert action.func.value.id == aggregate_call(trace).args[1].id
+    else:
+        action = next(n for n in ast.walk(trace.tree) if isinstance(n, ast.Raise) and n.exc is call)
+    call_text = trace.segment(call)
+    message_text = trace.segment(call.args[0])
+    # Derive the actual literal spelling; quotes in generated source are free.
+    probe = call_text.replace(message_text, repr("F2P-extra-detail" if detailed else "F2P-extra-fast"), 1)
+    return [trace.segment(assignment), trace.segment(action)], call_text, probe
+
+
+def test_shared_extra_key_error_joins_detailed_failures(monkeypatch):
+    """Shared emitters connect unknown-key computation to detailed aggregation."""
+    makers = factories(forbid=True)
+    traces = observe(makers)
+    parts = [extra_parts(t, True) for t in traces]
+    owner = next(iter(emitted_common(traces, [p[0] for p in parts],
+                                    "computing unknown keys and appending their detailed error")))
+    for t in traces:
+        failure = errors(t.hook, {"wire": "bad", "other": 2, "alien": 3})
+        assert len(failure) == 2
+        assert isinstance(failure[-1], ForbiddenExtraKeysError)
+        assert failure[-1].extra_fields == {"alien"}
+    # Change the matched-key state through the public override. The same
+    # observed emitter must consume that change in its error-producing hook;
+    # no particular container or generated binding name is required.
+    renamed = observe(factories(forbid=True, wire_name="fresh"))
+    renamed_parts = [extra_parts(t, True) for t in renamed]
+    assert owner in emitted_common(renamed, [p[0] for p in renamed_parts],
+                                   "detailed unknown-key handling after changing the matched key")
+    for trace in renamed:
+        failure = errors(trace.hook, {"fresh": "3", "other": 2, "wire": 3, "alien": 4})
+        assert len(failure) == 1
+        assert failure[0].extra_fields == {"wire", "alien"}
+    with monkeypatch.context() as patch:
+        patch_emitter(patch, owner, {p[1]: p[2] for p in parts})
+        for make in makers:
+            failure = errors(make(), {"wire": "bad", "other": 2, "alien": 3})
+            assert failure[-1].args[0] == "F2P-extra-detail"
+
+
+def test_shared_extra_key_fast_error_preserves_precedence(monkeypatch):
+    """Fast-mode common emission raises its own error before class construction."""
+    makers = factories(detailed=False, forbid=True)
+    traces = observe(makers)
+    parts = [extra_parts(t, False) for t in traces]
+    owner = next(iter(emitted_common(traces, [p[0] for p in parts],
+                                    "computing unknown keys and raising the fast-mode error")))
+    # The class constructor's required conversion runs after its extra-key check;
+    # TypedDict required conversion runs before that check. Preserve both orders.
+    for trace, expected in zip(traces, (ForbiddenExtraKeysError, ValueError)):
+        try:
+            trace.hook({"wire": "bad", "other": 2, "alien": 3}, None)
+        except Exception as exc:
+            assert type(exc) is expected
+        else:
+            raise AssertionError("The first fast-mode failure must propagate")
+    renamed = observe(factories(detailed=False, forbid=True, wire_name="fresh"))
+    renamed_parts = [extra_parts(t, False) for t in renamed]
+    assert owner in emitted_common(renamed, [p[0] for p in renamed_parts],
+                                   "fast unknown-key handling after changing the matched key")
+    for trace in renamed:
+        try:
+            trace.hook({"fresh": "3", "other": 2, "wire": 3, "alien": 4}, None)
+        except ForbiddenExtraKeysError as exc:
+            assert exc.extra_fields == {"wire", "alien"}
+        else:
+            raise AssertionError("The direct error must use its own matched-key state")
+    with monkeypatch.context() as patch:
+        patch_emitter(patch, owner, {p[1]: p[2] for p in parts})
+        for make in makers:
+            try:
+                make()({"wire": "3", "other": 2, "alien": 3}, None)
+            except ForbiddenExtraKeysError as exc:
+                assert exc.extra_fields == {"alien"}
+                assert exc.args[0] == "F2P-extra-fast"
+            else:
+                raise AssertionError("Fast-mode extra keys must raise directly")
