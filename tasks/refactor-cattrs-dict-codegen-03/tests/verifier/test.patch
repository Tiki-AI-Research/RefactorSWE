index 0000000000000000000000000000000000000000..6c9863f88e53c6c3ed5b3ca77caffc87515bacce
--- /dev/null
+++ b/tests/f2p_support/provenance.py
@@ -0,0 +1,263 @@
+"""Observe responsibility ownership without requiring private helper names.
+
+Only real calls below public factories count. Compiler input, returned hooks,
+emitted source, and binding namespaces are correlated within the SAME invocation.
+Emission probes modify a discovered helper's output and require the resulting hook
+to exhibit the change, ruling out dead helpers and discarded duplicate scaffolds.
+"""
+
+import ast
+import builtins
+from dataclasses import dataclass
+import inspect
+from pathlib import Path
+import sys
+from types import FunctionType, ModuleType, SimpleNamespace
+import linecache
+
+import f2p_operations as operations
+
+import cattrs.gen
+
+
+GEN = Path(cattrs.gen.__file__).resolve().parent
+
+
+def in_gen(code):
+    return (code.co_name not in {"<genexpr>", "<listcomp>", "<dictcomp>", "<setcomp>"}
+            and code.co_filename.endswith(".py")
+            and Path(code.co_filename).resolve().is_relative_to(GEN))
+
+
+def contains_code(container, target):
+    """Correlate compile output with the actual returned function, by identity."""
+    return container is target or any(
+        contains_code(value, target) for value in getattr(container, "co_consts", ())
+        if hasattr(value, "co_consts")
+    )
+
+
+@dataclass
+class Compilation:
+    source: str
+    filename: str
+    stack: list
+    code: object
+    origin: object
+
+
+@dataclass
+class Execution:
+    stack: list
+    code: object
+    namespace: dict
+
+
+class Trace:
+    def __init__(self):
+        self.compiles = []
+        self.executions = []
+        self.hook = None
+        self.operations = operations.Recorder()
+        self.registrations = []
+
+    def stack(self):
+        # Skip only this method and our intercepting wrapper. NEVER filter by
+        # package: a dispatcher may delegate to different out-of-gen workers.
+        frame = inspect.currentframe().f_back.f_back
+        out = []
+        while frame is not None:
+            out.append(SimpleNamespace(code=frame.f_code))
+            frame = frame.f_back
+        return out
+
+    def run(self, make, before_execute=None, before_compile=None):
+        compile_fn, eval_fn, exec_fn = builtins.compile, builtins.eval, builtins.exec
+        setattr_fn = builtins.setattr
+
+        def compiling(source, filename, mode, *args, **kwargs):
+            stack = self.stack()
+            code = compile_fn(source, filename, mode, *args, **kwargs)
+            if stack and isinstance(source, str) and mode == "exec":
+                self.compiles.append(Compilation(source, filename, stack, code, self.operations.root(source)))
+                if before_compile is not None:
+                    before_compile(stack, source, filename)
+            return code
+
+        def evaluating(source, *args, **kwargs):
+            stack = self.stack()
+            if stack and args:
+                self.executions.append(Execution(stack, source, args[0]))
+                if before_execute is not None:
+                    before_execute(stack, source, args[0])
+            if not args and not kwargs:
+                caller = inspect.currentframe().f_back
+                return eval_fn(source, caller.f_globals, caller.f_locals)
+            return eval_fn(source, *args, **kwargs)
+
+        def executing(source, *args, **kwargs):
+            stack = self.stack()
+            if stack and args:
+                self.executions.append(Execution(stack, source, args[0]))
+                if before_execute is not None:
+                    before_execute(stack, source, args[0])
+            if not args and not kwargs:
+                caller = inspect.currentframe().f_back
+                return exec_fn(source, caller.f_globals, caller.f_locals)
+            return exec_fn(source, *args, **kwargs)
+
+        def setting_attribute(target, name, value):
+            result = setattr_fn(target, name, value)
+            self.operations.assignments.append(
+                (inspect.currentframe().f_back.f_code, target, name, value))
+            return result
+
+        recorder = self
+        original_cache = linecache.cache
+
+        class ObservedCache(dict):
+            def __setitem__(self, key, value):
+                recorder.registrations.append((key, value, recorder.stack()))
+                return super().__setitem__(key, value)
+
+            def setdefault(self, key, value=None):
+                recorder.registrations.append((key, value, recorder.stack()))
+                return super().setdefault(key, value)
+
+            def update(self, *args, **kwargs):
+                for key, value in dict(*args, **kwargs).items():
+                    recorder.registrations.append((key, value, recorder.stack()))
+                    super().__setitem__(key, value)
+
+        try:
+            linecache.cache = ObservedCache(original_cache)
+            operations.ACTIVE = self.operations
+            builtins.setattr = setting_attribute
+            builtins.compile, builtins.eval, builtins.exec = compiling, evaluating, executing
+            self.hook = make()
+        finally:
+            operations.ACTIVE = None
+            builtins.setattr = setattr_fn
+            original_cache.update(linecache.cache)
+            linecache.cache = original_cache
+            builtins.compile, builtins.eval, builtins.exec = compile_fn, eval_fn, exec_fn
+        matching = [c for c in self.compiles if contains_code(c.code, self.hook.__code__)]
+        assert matching, "No observed compilation produced the returned public hook"
+        self.compilation = matching[-1]
+        self.tree = ast.parse(self.compilation.source)
+        self.bindings = dict(self.hook.__globals__)
+        self.bindings.update({k: p.default for k, p in inspect.signature(self.hook).parameters.items()
+                              if p.default is not inspect.Parameter.empty})
+        return self
+
+    def call_nodes(self, target):
+        return [n for n in ast.walk(self.tree) if isinstance(n, ast.Call)
+                and isinstance(n.func, ast.Name) and self.bindings.get(n.func.id) is target]
+
+    def segment(self, node):
+        return ast.get_source_segment(self.compilation.source, node)
+
+    def emission_events(self, snippet):
+        return self.operations.producers(self.compilation.origin, snippet)
+
+    def emission_owners(self, snippets):
+        # Only events on the ACTUAL compile-source dependency graph count.
+        # Encoding, extraction and transport follow the earlier producer.
+        events = [self.emission_events(part) for part in snippets]
+        # Mixed construction origins are inconclusive; a shared decoy must not
+        # hide a second live family-local emitter through a set intersection.
+        if any(len({event.code for event in group}) != 1 for group in events):
+            return set()
+        groups = [{event.frame for event in group} for group in events]
+        frames = set.intersection(*groups) if groups else set()
+        return {frame.f_code for frame in frames}
+
+    def name_owners(self):
+        return self.emission_owners([self.hook.__name__])
+
+    def attachment_owners(self):
+        return {code for code, target, name, value in self.operations.assignments
+                if target is self.hook and name == 'overrides'
+                and value is self.hook.overrides}
+
+    def registration_owners(self):
+        result = set()
+        for filename, entry, stack in self.registrations:
+            if (filename != self.compilation.filename or not isinstance(entry, tuple)
+                    or len(entry) != 4 or '\n'.join(entry[2]) != self.compilation.source):
+                continue
+            # Attribute the request to the immediate caller of the pre-existing
+            # cache primitive, or the direct writer if a generator writes itself.
+            # An echo returning a filename never appears in this effect stack.
+            primitive = (Path(stack[0].code.co_filename).resolve() == GEN / '_lc.py')
+            owner = stack[1].code if primitive else stack[0].code
+            result.add(owner)
+        return result
+
+
+def common(sets, responsibility):
+    found = {code for code in set.intersection(*sets) if in_gen(code)}
+    assert found, f"Both families must delegate {responsibility} to the same gen implementation"
+    return found
+
+
+def patch_emitter(monkeypatch, code, old, new=None):
+    """Replace source output at its discovered function/method, including list sinks."""
+    sites = []
+    for module in list(sys.modules.values()):
+        if not isinstance(module, ModuleType) or not module.__name__.startswith("cattrs.gen"):
+            continue
+        owners = [module] + [v for v in vars(module).values()
+                              if isinstance(v, type) and v.__module__.startswith("cattrs.gen")]
+        for owner in owners:
+            for name, value in list(vars(owner).items()):
+                fn = value.__func__ if isinstance(value, (classmethod, staticmethod)) else value
+                if isinstance(fn, FunctionType) and fn.__code__ is code:
+                    sites.append((owner, name, value, fn))
+    assert sites, "Observed emission has no patchable binding; delegation proof is inconclusive"
+
+    def rewrite(value):
+        if isinstance(value, str):
+            for before, after in (old.items() if isinstance(old, dict) else [(old, new)]):
+                value = after.join(part.replace(before, after) for part in value.split(after))
+            return value
+        if isinstance(value, list):
+            value[:] = [rewrite(v) for v in value]
+        if isinstance(value, tuple):
+            return tuple(rewrite(v) for v in value)
+        if type(value).__module__.startswith("cattrs.gen"):
+            names = set(vars(value)) if hasattr(value, "__dict__") else set()
+            for cls in type(value).__mro__:
+                slots = cls.__dict__.get("__slots__", ())
+                names.update([slots] if isinstance(slots, str) else slots)
+            for name in names:
+                current = getattr(value, name, None)
+                if isinstance(current, (str, list, tuple)):
+                    setattr(value, name, rewrite(current))
+        return value
+
+    for owner, name, descriptor, fn in sites:
+        def wrapped(*args, __fn=fn, **kwargs):
+            result = __fn(*args, **kwargs)
+            for value in (*args, *kwargs.values()):
+                if isinstance(value, list) or type(value).__module__.startswith("cattrs.gen"):
+                    rewrite(value)
+            return rewrite(result)
+        if isinstance(descriptor, staticmethod):
+            wrapped = staticmethod(wrapped)
+        elif isinstance(descriptor, classmethod):
+            wrapped = classmethod(wrapped)
+        monkeypatch.setattr(owner, name, wrapped)
+
+
+def emitted_common(traces, snippets, responsibility):
+    # A shared generator may delegate linked pieces to distinct shared methods.
+    # Certify EACH live piece across families; never infer B from an unrelated
+    # shared method A. The generated AST and behavioral checks establish the
+    # collector/unknown-variable connection between these source pieces.
+    assert snippets and len({len(parts) for parts in snippets}) == 1
+    owners = set()
+    for index in range(len(snippets[0])):
+        owners = common([t.emission_owners([parts[index]])
+                         for t, parts in zip(traces, snippets)], responsibility)
+    return owners
