+def test_detailed_validation_aggregates_and_preserves_notes(family):
+    cl, structure, _, kind = family
+
+    def fail(value, _):
+        exc = ValueError(f"bad value: {value}")
+        exc.add_note("upstream diagnostic")
+        raise exc
+
+    hook = structure(cl, Converter(), _cattrs_forbid_extra_keys=True,
+                     count=override(rename="wire_count", struct_hook=fail),
+                     spare=override(struct_hook=fail))
+    with pytest.raises(ClassValidationError) as ctx:
+        hook({"wire_count": "first", "spare": "second", "unexpected": 1}, cl)
+    error = ctx.value
+    assert error.cl is cl
+    assert error.message == f"While structuring {cl.__name__}"
+    assert len(error.exceptions) == 3
+    for name, value, child in zip(("count", "spare"), ("first", "second"), error.exceptions[:2]):
+        assert type(child) is ValueError
+        assert str(child) == f"bad value: {value}"
+        assert len(child.__notes__) == 2
+        assert child.__notes__[0] == "upstream diagnostic"
+        note = child.__notes__[1]
+        assert type(note) is AttributeValidationNote
+        assert str(note) == f"Structuring {kind} {cl.__qualname__} @ attribute {name}"
+        assert note.name == name
+        expected_type = Annotated[int, override(rename="wire_count")] if name == "count" else int
+        assert note.type == expected_type
+    extra = error.exceptions[2]
+    assert type(extra) is ForbiddenExtraKeysError
+    assert extra.cl is cl
+    assert extra.extra_fields == {"unexpected"}
