+                 "omitted": override(omit=True)}
+    unstructure = td_unstructure(Payload, converter, **overrides)
+    structure = td_structure(Payload, converter, _cattrs_forbid_extra_keys=True, **overrides)
+    for optional in ({}, {"optional": 6}):
+        value = {"required": 5, "omitted": 9, **optional}
+        before = dict(value)
+        raw = unstructure(value)
+        expected = {"wire_required": 5, **({"wire_optional": "6"} if optional else {})}
+        assert raw == expected
+        assert raw is not value
+        assert value == before
+        restored = structure(raw, Payload)
+        assert restored == {"required": 5, **optional}
+        assert restored is not raw
+        assert raw == expected
+        bad = {**raw, "stray": 11}
+        with pytest.raises(ClassValidationError if detailed else ForbiddenExtraKeysError) as ctx:
+            structure(bad, Payload)
+        if detailed:
+            assert len(ctx.value.exceptions) == 1
+            error = ctx.value.exceptions[0]
+        else:
+            error = ctx.value
+        assert type(error) is ForbiddenExtraKeysError
+        assert error.extra_fields == {"stray"}
+        assert error.cl is Payload
