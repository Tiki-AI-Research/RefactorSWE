+"""Keep native pytest and Hypothesis temporary data under TMPDIR.
+
+Test selection and JUnit generation are handled by pytest's command-line options.
+This plugin does not collect, select, or alter tests or their results.
+"""
+
+import os
+from pathlib import Path
+import tempfile
+
+
+def pytest_load_initial_conftests(early_config):
+    workspace = tempfile.TemporaryDirectory(
