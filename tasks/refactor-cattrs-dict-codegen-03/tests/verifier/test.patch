+"""Offline entry point for the case's real pytest producer.
+
+Use the case venv when present. The image also retains uv's extracted dependency
+archives; adding those existing directories to sys.path does not install or fetch
+anything. An unavailable dependency remains an import/setup error.
+"""
+
+import importlib.util
+import os
+from pathlib import Path
+import sys
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    os.chdir(root)
+    venv = root / ".venv/bin/python"
+    if venv.is_file() and Path(sys.prefix).resolve() != (root / ".venv").resolve():
+        os.execv(str(venv), [str(venv), str(Path(__file__).resolve()), *sys.argv[1:]])
+    sys.dont_write_bytecode = True
+    os.environ["PYTEST_DISABLE_PLUGIN_AUTOLOAD"] = "1"
+    sys.path[:0] = [str(root / "src"), str(root)]
+    if any(importlib.util.find_spec(name) is None for name in ("pytest", "attrs", "hypothesis")):
+        cache = Path(os.environ.get("UV_CACHE_DIR", str(Path.home() / ".cache/uv"))) / "archive-v0"
+        if cache.is_dir():
+            sys.path.extend(str(p) for p in sorted(cache.iterdir()) if p.is_dir())
+    # Load the instrumentation before tests/__init__.py imports cattrs.
+    spec = importlib.util.spec_from_file_location(
+        "f2p_operations", root / "tests/f2p_support/operations.py")
+    operations = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = operations
+    spec.loader.exec_module(operations)
+    operations.install()
+    import pytest
+
+    return pytest.main([
+        "-q", "-o", "addopts=", "-o", "junit_family=xunit2",
+        "-p", "no:cacheprovider", "-p", "tests.p2p_pytest", *sys.argv[1:]
+    ])
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
