+def norm(v):
+ if isinstance(v,dict):return {str(k):norm(x) for k,x in v.items()}
+ if isinstance(v,(list,tuple)):return [norm(x) for x in v]
+ if isinstance(v,(set,frozenset)):return sorted(map(str,v))
+ if isinstance(v,type):return v.__name__
+ if is_dataclass(v):return norm(asdict(v))
+ if has(type(v)):return norm(attrs_asdict(v))
+ if v is None or isinstance(v,(str,int,float,bool)):return v
+ return type(v).__name__
+def error(e):
+ out={'type':type(e).__name__,'message':getattr(e,'message',str(e))}
+ if hasattr(e,'exceptions'):out['children']=[error(x) for x in e.exceptions]
+ if hasattr(e,'__notes__'):out['notes']=[{'text':str(n),'kind':type(n).__name__,'field':getattr(n,'name',None)} for n in e.__notes__]
+ if hasattr(e,'extra_fields'):out['extra_fields']=norm(e.extra_fields)
+ return out
+def observe(f):
+ try:return {'value':norm(f())}
+ except Exception as e:return {'error':error(e)}
+
+def default_case(from_attrs,fail_on):
+ calls=[]
+ def converter(v):
+  calls.append(v)
+  if len(calls)==fail_on:raise ValueError('audit default conversion failure')
+  return len(calls)*10
+ @define
+ class DefaultRecord:
+  value:int=field(default=0,converter=converter)
+ gen=(lambda:fun(list(fields(DefaultRecord)),DefaultRecord,Converter(),_cattrs_omit_if_default=True)) if from_attrs else (lambda:un(DefaultRecord,Converter(),_cattrs_omit_if_default=True))
+ try:hook=gen()
+ except Exception as e:return {'generation_error':error(e),'calls':calls}
+ after=list(calls);outputs=[]
+ for v in [10,20,30]:
+  obj=object.__new__(DefaultRecord);object.__setattr__(obj,'value',v);outputs.append(observe(lambda:hook(obj)))
+ return {'generation_calls':after,'outputs':outputs,'final_calls':calls}
+@define
+class AttrRecord:
+ value:int
+ optional:int=5
+@dataclass
+class DataRecord:
+ value:int
+ optional:int=5
+class MappingRecord(TypedDict):
+ value:int
+ optional:NotRequired[int]
+class FalseHook:
+ def __bool__(self):return False
+ def __call__(self,v,t):return int(v)+100
+@define
+class HookRecord:
+ value:int
+ optional:int=5
+ cache:int=field(default=0,init=False)
