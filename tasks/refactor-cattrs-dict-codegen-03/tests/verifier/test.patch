+def test_converted_defaults_and_self_factory_omission():
+    @define
+    class Item:
+        base: int = 3
+        converted: int = field(default="4", converter=int)
+        values: list[int] = field(factory=list)
+        derived: int = field(default=Factory(lambda self: self.base + 1, takes_self=True))
+    hook = make_dict_unstructure_fn(Item, Converter(), _cattrs_omit_if_default=True,
+                                   base=override(omit_if_default=False))
+    assert hook(Item()) == {"base": 3}
+    assert hook(Item(base=8)) == {"base": 8}
+    assert hook(Item(converted=9, values=[1], derived=10)) == {
+        "base": 3, "converted": 9, "values": [1], "derived": 10
+    }
+
+    # Attribute converters also apply to the default used for omission.
+    # Check public results through both entry points, without inspecting bindings
+    # or how many times the converter runs while the hook is generated.
+    for from_attrs in (False, True):
+        calls = []
+
+        def convert(value):
+            calls.append(value)
+            return value + 1
+
+        @define
+        class Sequenced:
+            value: int = field(default=0, converter=convert)
+
+        omitted = Sequenced(0)
+        included = Sequenced(5)
+        calls.clear()
+        if from_attrs:
