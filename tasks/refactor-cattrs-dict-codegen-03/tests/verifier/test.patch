+"""Baseline regressions for public dict-hook generation contracts."""
+
+from dataclasses import dataclass, field as dc_field
+from inspect import Parameter, signature
+import linecache
+import traceback
+from typing import Annotated, Generic, TypeVar
+
+from attrs import Factory, define, field, fields
+import pytest
+from typing_extensions import NotRequired, Required, TypedDict
+
+from cattrs import BaseConverter, Converter
+from cattrs.errors import AttributeValidationNote, ClassValidationError, ForbiddenExtraKeysError
+from cattrs.gen import (
+    AttributeOverride, make_dict_structure_fn, make_dict_structure_fn_from_attrs,
+    make_dict_unstructure_fn, make_dict_unstructure_fn_from_attrs, override,
+)
+from cattrs.gen.typeddicts import make_dict_structure_fn as td_structure
+from cattrs.gen.typeddicts import make_dict_unstructure_fn as td_unstructure
+
+
+_REQUIRED = Parameter.empty
+_UNSTRUCT = [("_cattrs_omit_if_default", False), ("_cattrs_use_linecache", True),
+             ("_cattrs_use_alias", "from_converter"), ("_cattrs_include_init_false", False)]
+_STRUCT = [("_cattrs_forbid_extra_keys", "from_converter"), ("_cattrs_use_linecache", True),
+           ("_cattrs_prefer_attrib_converters", "from_converter"),
+           ("_cattrs_detailed_validation", "from_converter"),
+           ("_cattrs_use_alias", "from_converter"), ("_cattrs_include_init_false", False)]
+_HEAD = [("cl", _REQUIRED), ("converter", _REQUIRED)]
+_FROM_HEAD = [("attrs", _REQUIRED), *_HEAD, ("typevar_map", {})]
+
+
+@pytest.mark.parametrize("factory,expected", [
+    (make_dict_unstructure_fn_from_attrs, _FROM_HEAD + _UNSTRUCT),
+    (make_dict_structure_fn_from_attrs, _FROM_HEAD + _STRUCT),
+    (make_dict_unstructure_fn, _HEAD + _UNSTRUCT),
+    (make_dict_structure_fn, _HEAD + _STRUCT),
+    (td_unstructure, _HEAD + [("_cattrs_use_linecache", True)]),
+    (td_structure, _HEAD + _STRUCT[:2] + [("_cattrs_detailed_validation", "from_converter")]),
+], ids=["attrs_fields_unstructure", "attrs_fields_structure", "class_unstructure",
+        "class_structure", "typeddict_unstructure", "typeddict_structure"])
+def test_public_factory_parameters(factory, expected):
+    params = list(signature(factory).parameters.values())
+    assert [(p.name, p.default) for p in params[:-1]] == expected
+    assert all(p.kind is Parameter.POSITIONAL_OR_KEYWORD for p in params[:-1])
+    assert params[-1].name == "kwargs"
+    assert params[-1].kind is Parameter.VAR_KEYWORD
+
+
+def test_public_override_value_contract():
+    names = ["omit_if_default", "rename", "omit", "struct_hook", "unstruct_hook"]
+    for factory in (AttributeOverride, override):
+        params = list(signature(factory).parameters.values())
+        assert [p.name for p in params] == names
+        assert all(p.default is None for p in params)
+        assert all(p.kind is Parameter.POSITIONAL_OR_KEYWORD for p in params)
+    struct = lambda value, _: int(value)
+    unstruct = str
+    result = override(True, "wire", False, struct, unstruct)
+    assert type(result) is AttributeOverride
+    assert result == AttributeOverride(True, "wire", False, struct, unstruct)
+    assert [getattr(override(), name) for name in names] == [None] * 5
+
+
+@pytest.fixture(params=["attrs", "dataclass", "attrs_fields", "typeddict"])
+def family(request):
+    if request.param == "typeddict":
+        class Record(TypedDict):
+            count: Annotated[int, override(rename="wire_count")]
+            spare: int
+        return Record, td_structure, td_unstructure, "typeddict"
+
+    class Record:
+        count: Annotated[int, override(rename="wire_count")]
+        spare: int
+    Record = dataclass(Record) if request.param == "dataclass" else define(Record)
+    if request.param == "attrs_fields":
+        def structure(cl, converter, **kwargs):
+            return make_dict_structure_fn_from_attrs(list(fields(cl)), cl, converter, **kwargs)
+        def unstructure(cl, converter, **kwargs):
+            return make_dict_unstructure_fn_from_attrs(list(fields(cl)), cl, converter, **kwargs)
+        return Record, structure, unstructure, "class"
+    return Record, make_dict_structure_fn, make_dict_unstructure_fn, "class"
+
+
+def _instance(cl, kind, count=3, spare=7):
+    return {"count": count, "spare": spare} if kind == "typeddict" else cl(count, spare)
+
+
+@pytest.mark.parametrize("operation", ["structure", "unstructure"])
+def test_linecache_registration_collision_and_traceback(family, operation, monkeypatch):
+    cl, structure, unstructure, kind = family
+    converter = Converter(detailed_validation=False)
+    factory = structure if operation == "structure" else unstructure
+    monkeypatch.setattr(linecache, "cache", {})
+    first = factory(cl, converter)
+    filename = first.__code__.co_filename
+    source = linecache.getlines(filename)
+    assert source
+    snapshot = dict(linecache.cache)
+    duplicate = factory(cl, converter)
+    assert duplicate.__code__.co_filename == filename
+    assert linecache.cache == snapshot
+
