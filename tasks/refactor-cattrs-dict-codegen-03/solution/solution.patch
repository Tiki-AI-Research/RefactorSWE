+
+
+class _DictHookGenerator:
+    """Shared generator for dictionary structuring and unstructuring hooks."""
+
+    __slots__ = ("cl", "fn_name", "internal_arg_parts", "operation", "use_linecache")
+
+    def __init__(
+        self,
+        cl: type,
+        operation: str,
+        use_linecache: bool = True,
+        typevar_map: Mapping[str, Any] | None = None,
+        fn_name_prefix: str | None = None,
+    ):
+        self.cl = cl
+        self.operation = operation
+        self.use_linecache = use_linecache
+        self.internal_arg_parts: dict[str, Any] = {}
+        if operation == "structure":
+            cl_name = cl.__name__
+            base_name = (
+                f"{fn_name_prefix}_{cl_name}"
+                if fn_name_prefix
+                else f"structure_{cl_name}"
+            )
+            for p in getattr(cl, "__parameters__", ()):
+                try:
+                    if typevar_map is None:
+                        raise KeyError(p.__name__)
+                    name_base = typevar_map[p.__name__]
+                except KeyError:
+                    pn = p.__name__
+                    raise StructureHandlerNotFoundError(
+                        f"Missing type for generic argument {pn}, specify it when structuring.",
+                        p,
+                    ) from None
+                name = getattr(name_base, "__name__", None) or str(name_base)
+                name = re.sub(r"\|", "u", name)
+                name = re.sub(r"[\[\.\] ,<>]", "_", name)
+                name = re.sub(r"[^\w]", "_", name)
+                base_name += f"_{name}"
+            self.fn_name = base_name
+        elif fn_name_prefix:
+            self.fn_name = f"{fn_name_prefix}_{cl.__name__}"
+        else:
+            self.fn_name = f"unstructure_{cl.__name__}"
+
+    def add_binding(self, name: str, val: Any) -> str:
+        self.internal_arg_parts[name] = val
+        return name
+
+    def ensure_cl(self) -> str:
+        return self.add_binding("__cl", self.cl)
+
+    def ensure_cve(self) -> str:
+        return self.add_binding("__c_cve", ClassValidationError)
+
+    def ensure_avn(self) -> str:
+        return self.add_binding("__c_avn", AttributeValidationNote)
+
+    def add_non_mapping_check(self, target_lines: list[str]) -> None:
+        self.ensure_cl()
+        self.ensure_cve()
+        self.add_binding("__c_mapping", Mapping)
+        target_lines.append("  if not isinstance(o, __c_mapping):")
+        te = "TypeError(f'expected a mapping, not {o.__class__.__name__}')"
+        target_lines.append(
+            f"    raise __c_cve('While structuring ' + {self.cl.__name__!r}, [{te}], __cl)"
+        )
+
+    def wrap_field_try_except(
+        self,
+        body_lines: list[str],
+        note_text: str,
+        attr_name: str,
+        type_arg_name: str,
+        indent: str = "  ",
+        use_unpack: bool = False,
+    ) -> list[str]:
+        self.ensure_avn()
+        out = [f"{indent}try:"]
+        for bl in body_lines:
+            out.append(f"{indent}  {bl}")
+        out.append(f"{indent}except Exception as e:")
+        if use_unpack:
+            out.append(
+                f"{indent}  e.__notes__ = [*getattr(e, '__notes__', []), "
+                f"__c_avn({note_text!r}, {attr_name!r}, {type_arg_name})]"
+            )
+        else:
+            out.append(
+                f"{indent}  e.__notes__ = getattr(e, '__notes__', []) + "
+                f'[__c_avn("{note_text}", "{attr_name}", {type_arg_name})]'
+            )
+        out.append(f"{indent}  errors.append(e)")
+        return out
+
+    def add_extra_keys_check(
+        self,
+        allowed_fields: set[str],
+        diff_expr: str,
+        detailed: bool,
+        target_lines: list[str],
+    ) -> None:
+        self.ensure_cl()
+        self.add_binding("__c_a", allowed_fields)
+        self.add_binding("__c_feke", ForbiddenExtraKeysError)
+        target_lines.append(f"  unknown_fields = {diff_expr}")
+        target_lines.append("  if unknown_fields:")
+        if detailed:
+            target_lines.append("    errors.append(__c_feke('', __cl, unknown_fields))")
+        else:
+            target_lines.append("    raise __c_feke('', __cl, unknown_fields)")
+
+    def add_errors_check(self, target_lines: list[str]) -> None:
+        self.ensure_cl()
+        self.ensure_cve()
+        target_lines.append(
+            f"  if errors: raise __c_cve('While structuring ' + {self.cl.__name__!r}, errors, __cl)"
+        )
+
+    def wrap_instantiation(
+        self,
+        invocation_lines: list[str],
+        assign_to_instance: bool = False,
+        detailed: bool = True,
+    ) -> list[str]:
+        self.ensure_cl()
+        if not detailed:
+            if not assign_to_instance:
+                return (
+                    ["  return __cl("]
+                    + [f"    {line}" for line in invocation_lines]
+                    + ["  )"]
+                )
+            return (
+                ["  instance = __cl("]
+                + [f"    {line}" for line in invocation_lines]
+                + ["  )"]
+            )
+        self.ensure_cve()
+        cl_name = self.cl.__name__
+        if not assign_to_instance:
+            return (
+                ["  try:"]
+                + ["    return __cl("]
+                + [f"      {line}" for line in invocation_lines]
+                + ["    )"]
+                + [
+                    f"  except Exception as exc: raise __c_cve('While structuring ' + {cl_name!r}, [exc], __cl)"
+                ]
+            )
+        return (
+            ["  try:"]
+            + ["    instance = __cl("]
+            + [f"      {line}" for line in invocation_lines]
+            + ["    )"]
+            + [
+                f"  except Exception as exc: raise __c_cve('While structuring ' + {cl_name!r}, [exc], __cl)"
+            ]
+        )
+
+    def compile(
+        self,
+        body_lines: list[str],
+        header_args: str = "instance",
+        overrides: dict[str, AttributeOverride] | None = None,
+    ) -> Any:
+        parts = self.internal_arg_parts
+        fn_name = self.fn_name
+        cl = self.cl
+        op = self.operation
+
+        if parts:
+            internal_arg_line = ", ".join([f"{i}={i}" for i in parts])
+            header = f"def {fn_name}({header_args}, {internal_arg_line}):"
+            globs = dict(parts)
+        else:
+            header = f"def {fn_name}({header_args}):"
+            globs = {}
+
+        total_lines = [header, *body_lines]
+        script = "\n".join(total_lines)
+
+        fname = generate_unique_filename(
+            cl, op, lines=total_lines if self.use_linecache else []
+        )
+
+        eval(compile(script, fname, "exec"), globs)
+
+        res = globs[fn_name]
+        res.overrides = overrides if overrides is not None else {}
+        return res
