+def test_typeddict_structure_optional_copy_and_fast_mode():
+    """Structure hook with optional keys in both fast and detailed modes: returns copy, tolerates missing keys, preserves extra keys."""
+
+    class OptTD(TypedDict, total=False):
+        a: int
+        b: str
+        c: int
+
+    for detailed in (False, True):
+        c = Converter(detailed_validation=detailed)
+        fn = make_dict_structure_fn(
+            OptTD,
+            c,
+            _cattrs_detailed_validation=detailed,
+            b=override(rename="renamed_b"),
+            c=override(omit=True),
+        )
+
+        # 1. Missing optional keys: does not raise, does not insert missing keys, returns copy, input unchanged
+        inp1 = {"a": 10, "extra": "allowed"}
+        inp1_snapshot = dict(inp1)
+        res1 = fn(inp1, OptTD)
+        assert res1 is not inp1
+        assert inp1 == inp1_snapshot
+        assert res1["a"] == 10
+        assert "b" not in res1
+        assert "c" not in res1
+        assert "renamed_b" not in res1
+        assert res1["extra"] == "allowed"
+
+        # 2. Present optional keys: renaming moves to declared name; omit skips conversion but keeps extra key if allowed
+        inp2 = {"a": 20, "renamed_b": "b_val", "c": "keep_raw", "extra": 99}
+        inp2_snapshot = dict(inp2)
+        res2 = fn(inp2, OptTD)
+        assert res2 is not inp2
+        assert inp2 == inp2_snapshot
+        assert res2["a"] == 20
+        assert res2["b"] == "b_val"
+        assert "renamed_b" not in res2
+        assert res2["c"] == "keep_raw"
+        assert res2["extra"] == 99
