+        a=override(struct_hook=handler_with_note),
+    )
+    with raises(ClassValidationError) as exc_pre:
+        fn_pre({"a": "bad", "b": 1}, TDMulti)
+    notes_list = exc_pre.value.exceptions[0].__notes__
+    assert "pre-existing custom note" in notes_list
+    assert any(isinstance(n, AttributeValidationNote) for n in notes_list)
+
+    # Missing required field in detailed validation
+    with raises(ClassValidationError) as exc_req:
+        c.structure({"b": 1}, TDMulti)
+    req_err = exc_req.value.exceptions[0]
+    assert isinstance(req_err, KeyError)
+    assert req_err.__notes__[0].name == "a"
+
+    # Fast mode (detailed_validation=False) field failure propagation without wrapping
+    c_fast = Converter(detailed_validation=False)
+    with raises(ValueError) as exc_fast:
+        c_fast.structure({"a": "bad_a", "b": 1}, TDMulti)
+    assert not isinstance(exc_fast.value, ClassValidationError)
+    assert getattr(exc_fast.value, "__notes__", None) is None or not any(
+        isinstance(n, AttributeValidationNote) for n in exc_fast.value.__notes__
+    )
+
+    with raises(KeyError) as exc_fast_key:
+        c_fast.structure({"b": 1}, TDMulti)
+    assert not isinstance(exc_fast_key.value, ClassValidationError)
+
