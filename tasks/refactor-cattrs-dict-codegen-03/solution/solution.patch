+def test_typeddict_unstructure_identity_and_failure_input_immutability():
+    """Empty TypedDict, neutral overrides, equivalent copy, and unstructure failure input non-mutation."""
+
+    class EmptyTD(TypedDict):
+        pass
+
+    class SimpleTD(TypedDict):
+        a: int
+        b: str
+
+    c = Converter()
+
+    # 1. Empty TypedDict preserves identity
+    empty_fn = make_dict_unstructure_fn(EmptyTD, c)
+    assert empty_fn is identity
+    empty_in = {}
+    assert empty_fn(empty_in) is empty_in
+
+    # 2. Neutral overrides preserve identity when handlers are identity
+    neutral_fn = make_dict_unstructure_fn(SimpleTD, c, a=override(), b=neutral)
+    assert neutral_fn is identity
+    simple_in = {"a": 1, "b": "hello"}
+    assert neutral_fn(simple_in) is simple_in
+
+    # 3. Custom handler returning same value creates a new copy (is not input)
+    copy_fn = make_dict_unstructure_fn(
+        SimpleTD, c, a=override(unstruct_hook=lambda x: x)
+    )
+    assert copy_fn is not identity
+    copy_out = copy_fn(simple_in)
+    assert copy_out == simple_in
+    assert copy_out is not simple_in
+
+    # 4. Handler failure during unstructuring does not mutate caller's input mapping
+    def bad_unstructure(_):
+        raise ValueError("unstructure handler failed")
+
+    fail_fn = make_dict_unstructure_fn(
+        SimpleTD,
+        c,
+        a=override(unstruct_hook=bad_unstructure),
+        b=override(rename="b_new"),
+    )
+    fail_in = {"a": 42, "b": "preserved"}
+    fail_snapshot = dict(fail_in)
+    with raises(ValueError, match="unstructure handler failed"):
+        fail_fn(fail_in)
+    assert fail_in == fail_snapshot
+
