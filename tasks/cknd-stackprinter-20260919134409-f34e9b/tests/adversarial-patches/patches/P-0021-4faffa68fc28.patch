@@ -0,0 +1,242 @@
+"""
+Output styler abstraction for plain-text and ANSI-colored rendering.
+"""
+import os
+from collections import OrderedDict
+import stackprinter.source_inspection as sc
+import stackprinter.colorschemes as colorschemes
+from stackprinter.prettyprinting import format_value
+from stackprinter.utils import get_ansi_tpl
+
+
+class Styler:
+    """
+    Base styler defining frame templates and text styling hooks.
+    """
+    headline_tpl = 'File "%s", line %s, in %s\n'
+    sourceline_tpl = "    %-3s  %s"
+    single_sourceline_tpl = "    %s"
+    marked_sourceline_tpl = "--> %-3s  %s"
+    elipsis_tpl = " (...)\n"
+    var_indent = 5
+    sep_vars = "%s%s" % ((' ') * 4, ('.' * 50))
+    sep_source_below = ""
+    val_tpl = ' ' * var_indent + "%s = %s\n"
+
+    def format_headline(self, fi):
+        raise NotImplementedError
+
+    def format_source(self, source_map, colormap=None, lineno=None):
+        raise NotImplementedError
+
+    def format_listing(self, lines, lineno):
+        ln_prev = None
+        msg = ""
+        n_lines = len(lines)
+        for ln in sorted(lines):
+            line = lines[ln]
+            if ln_prev and ln_prev != ln - 1:
+                msg += self.elipsis_tpl
+            ln_prev = ln
+
+            if n_lines > 1:
+                if ln == lineno:
+                    tpl = self.marked_sourceline_tpl
+                else:
+                    tpl = self.sourceline_tpl
+                msg += tpl % (ln, line)
+            else:
+                msg += self.single_sourceline_tpl % line
+
+        msg += self.sep_source_below
+        return msg
+
+    def format_assignments(self, assignments, colormap=None, truncate_vals=500, line_wrap=60):
+        raise NotImplementedError
+
+    def pick_colors(self, source_map, name2lines, assignments, lineno):
+        return {}
+
+    def format_exception_message(self, etype, evalue, tb=None):
+        raise NotImplementedError
+
+    def format_chain_hint(self, hint):
+        raise NotImplementedError
+
+
+class PlaintextStyler(Styler):
+    """
+    Plain-text styling without ANSI color escape codes.
+    """
+
+    def format_headline(self, fi):
+        return self.headline_tpl % (fi.filename, fi.lineno, fi.function)
+
+    def format_source(self, source_map, colormap=None, lineno=None):
+        lines = OrderedDict()
+        for ln in sorted(source_map):
+            lines[ln] = ''.join(st for st, _ in source_map[ln])
+        return lines
+
+    def format_assignments(self, assignments, colormap=None, truncate_vals=500, line_wrap=60):
+        msgs = []
+        for name, value in assignments.items():
+            val_str = format_value(value,
+                                   indent=len(name) + self.var_indent + 3,
+                                   truncation=truncate_vals,
+                                   wrap=line_wrap)
+            assign_str = self.val_tpl % (name, val_str)
+            msgs.append(assign_str)
+        if len(msgs) > 0:
+            return self.sep_vars + '\n' + ''.join(msgs) + self.sep_vars + '\n\n'
+        return ''
+
+    def format_exception_message(self, etype, evalue, tb=None):
+        if etype is None:
+            etype = type(None)
+        type_str = etype.__name__
+        val_str = str(evalue)
+        if etype == SyntaxError and getattr(evalue, 'text', None):
+            val_str += '\n    %s\n   %s^' % (evalue.text.rstrip(), ' ' * evalue.offset)
+        if val_str:
+            type_str += ": "
+        return type_str + val_str
+
+    def format_chain_hint(self, hint):
+        return hint
+
+
+class AnsiStyler(Styler):
+    """
+    ANSI color sequence styling using selected color schemes.
+    """
+
+    def __init__(self, style_name='darkbg'):
+        if style_name is True or style_name == 'color':
+            style_name = 'color'
+        elif style_name == 'dark':
+            style_name = 'darkbg'
+        elif style_name == 'light':
+            style_name = 'lightbg'
+        self.style_name = style_name
+        self.colors = getattr(colorschemes, style_name)()
+
+        highlight = self.tpl('highlight')
+        header = self.tpl('header')
+        arrow_lineno = self.tpl('arrow_lineno')
+        dots = self.tpl('dots')
+        lineno = self.tpl('lineno')
+
+        self.headline_tpl = header % 'File "%s%s' + highlight % '%s' + header % '", line %s, in %s\n'
+        self.sourceline_tpl = lineno % Styler.sourceline_tpl
+        self.marked_sourceline_tpl = arrow_lineno % Styler.marked_sourceline_tpl
+        self.elipsis_tpl = dots % Styler.elipsis_tpl
+        self.sep_vars = dots % Styler.sep_vars
+
+    def tpl(self, name):
+        return get_ansi_tpl(*self.colors[name])
+
+    def format_headline(self, fi):
+        basepath, filename = os.path.split(fi.filename)
+        sep = os.sep if basepath else ''
+        return self.headline_tpl % (basepath, sep, filename, fi.lineno, fi.function)
+
+    def format_source(self, source_map, colormap=None, lineno=None):
+        bold_tp = self.tpl('source_bold')
+        default_tpl = self.tpl('source_default')
+        comment_tpl = self.tpl('source_comment')
+        colormap = colormap or {}
+
+        source_lines = OrderedDict()
+        for ln in source_map:
+            line = ''
+            for snippet, ttype in source_map[ln]:
+                if ttype in [sc.KEYWORD, sc.OP]:
+                    line += bold_tp % snippet
+                elif ttype == sc.VAR:
+                    if snippet not in colormap:
+                        line += default_tpl % snippet
+                    else:
+                        hue, sat, val, bold = colormap[snippet]
+                        var_tpl = get_ansi_tpl(hue, sat, val, bold)
+                        line += var_tpl % snippet
+                elif ttype == sc.CALL:
+                    line += bold_tp % snippet
+                elif ttype == sc.COMMENT:
+                    line += comment_tpl % snippet
+                else:
+                    line += default_tpl % snippet
+            source_lines[ln] = line
+        return source_lines
+
+    def format_assignments(self, assignments, colormap=None, truncate_vals=500, line_wrap=60):
+        colormap = colormap or {}
+        msgs = []
+        for name, value in assignments.items():
+            val_str = format_value(value,
+                                   indent=len(name) + self.var_indent + 3,
+                                   truncation=truncate_vals,
+                                   wrap=line_wrap)
+            assign_str = self.val_tpl % (name, val_str)
+            hue, sat, val, bold = colormap.get(name, self.colors['var_invisible'])
+            clr_str = get_ansi_tpl(hue, sat, val, bold) % assign_str
+            msgs.append(clr_str)
+        if len(msgs) > 0:
+            return self.sep_vars + '\n' + ''.join(msgs) + self.sep_vars + '\n\n'
+        return ''
+
+    def pick_colors(self, source_map, name2lines, assignments, lineno):
+        colormap = {}
+        for line in source_map.values():
+            for name, ttype in line:
+                if name not in colormap and ttype == sc.VAR and name in assignments:
+                    value = assignments[name]
+                    highlight = lineno in name2lines.get(name, [])
+                    colormap[name] = self._pick_color(name, value, highlight)
+        return colormap
+
+    def _pick_color(self, name, val, highlight=False, method='id'):
+        if method == 'formatted':
+            seed = format_value(val)
+        elif method == 'repr':
+            seed = repr(val)
+        elif method == 'id':
+            seed = id(val)
+        elif method == 'name':
+            seed = name
+        else:
+            raise ValueError('%r' % method)
+        return self.colors.get_random(seed, highlight)
+
+    def format_exception_message(self, etype, evalue, tb=None):
+        if etype is None:
+            etype = type(None)
+        type_str = etype.__name__
+        val_str = str(evalue)
+        if etype == SyntaxError and getattr(evalue, 'text', None):
+            val_str += '\n    %s\n   %s^' % (evalue.text.rstrip(), ' ' * evalue.offset)
+        if val_str:
+            type_str += ": "
+
+        clr_head = self.tpl('exception_type')
+        clr_msg = self.tpl('exception_msg')
+        return clr_head % type_str + clr_msg % val_str
+
+    def format_chain_hint(self, hint):
+        clr = self.tpl('exception_type')
+        return clr % hint
+
+
+def get_styler(style='plaintext'):
+    """
+    Factory resolving style name to Styler instance.
+    """
+    if not style or style in ('plaintext', 'plain', 'none'):
+        return PlaintextStyler()
+    if style is True or style == 'color':
+        return AnsiStyler('color')
+    if style == 'dark':
+        return AnsiStyler('darkbg')
+    if style == 'light':
+        return AnsiStyler('lightbg')
+    return AnsiStyler(style)
