+class ExceptionRenderer:
+    """
+    Renders an exception traceback chain, including chained causes,
+    contexts, summaries, exception messages, and error fallbacks.
+    """
+
+    def __init__(self, config=None, styler=None):
+        self.config = config or FormatConfig()
+        self.cfg = self.config
+        self.styler = styler or get_styler(self.config.style)
+
+    def _get_frame_formatter(self, cfg):
+        return get_formatter(
+            style=cfg.style,
+            source_lines=cfg.source_lines,
+            source_lines_after=cfg.source_lines_after,
+            show_signature=cfg.show_signature,
+            show_vals=cfg.show_vals,
+            truncate_vals=cfg.truncate_vals,
+            line_wrap=cfg.line_wrap,
+            suppressed_paths=cfg.suppressed_paths,
+            suppressed_vars=cfg.suppressed_vars,
+            indent=cfg.indent,
+        )
+
+    def render_stack(self, frameinfos):
+        minimal_fmt = self._get_frame_formatter(self.config.as_minimal())
+        reduced_fmt = self._get_frame_formatter(self.config.as_reduced())
+        verbose_fmt = self._get_frame_formatter(self.config)
+
+        frame_msgs = []
+        parent_is_boring = True
+        for fi in frameinfos:
+            is_boring = match(fi.filename, self.config.suppressed_paths)
+            if is_boring:
+                if parent_is_boring:
+                    formatter = minimal_fmt
+                else:
+                    formatter = reduced_fmt
+            else:
+                formatter = verbose_fmt
+            parent_is_boring = is_boring
+            frame_msgs.append(formatter(fi))
+
+        if self.config.reverse:
+            frame_msgs = reversed(frame_msgs)
+
+        return ''.join(frame_msgs)
+
+    def render_summary(self, frameinfos):
+        cfg = self.config.as_minimal()
+        fmt = self._get_frame_formatter(cfg)
+        frames = reversed(frameinfos) if self.config.reverse else frameinfos
+        return ''.join(fmt(f) for f in frames)
+
+    def render(self, etype, evalue, tb):
+        prefix = getattr(self.config, 'indent', '')
+        if prefix:
+            inner = ExceptionRenderer(self.config.with_overrides(indent=''), styler=self.styler)
+            return indent_text(inner.render(etype, evalue, tb), prefix)
+
+        if etype is None:
+            etype = type(None)
+
+        if etype is not None and getattr(etype, '__name__', '') == 'ExceptionGroup':
