+            # but at least we fall back on the default message.
+            return ''.join(traceback.format_exception(etype, evalue, tb))
+
+        msg = ''
+        try:
+            # First, recursively format any chained exceptions (exceptions
+            # during whose handling the given one happened).
+            context = getattr(evalue, '__context__', None)
+            cause = getattr(evalue, '__cause__', None)
+            suppress_context = getattr(evalue, '__suppress_context__', False)
+            if cause:
+                chained_exc = cause
+                chain_hint = ("\n\nThe above exception was the direct cause "
+                              "of the following exception:\n\n")
+            elif context and not suppress_context:
+                chained_exc = context
+                chain_hint = ("\n\nWhile handling the above exception, "
+                              "another exception occurred:\n\n")
+            else:
+                chained_exc = None
+
+            if chained_exc:
+                nested_renderer = ExceptionRenderer(self.config, styler=self.styler)
+                msg += nested_renderer.render(
+                    chained_exc.__class__,
+                    chained_exc,
+                    chained_exc.__traceback__,
+                )
+                msg += self.styler.format_chain_hint(chain_hint)
+
+            # Now, actually do some formatting:
+            parts = []
+            omitted_frames = 0
+            if tb:
+                frameinfos = []
+                for tb_ in _walk_traceback(tb):
+                    try:
+                        frameinfos.append(
+                            ex.get_info(tb_, suppressed_vars=self.config.suppressed_vars)
+                        )
+                    except Exception as exc_extract:
+                        exc_extract.where = tb_
+                        raise
+
+                total_frames = len(frameinfos)
+                if self.config.max_frames is not None and total_frames > self.config.max_frames:
+                    omitted_frames = total_frames - self.config.max_frames
+                    frameinfos = frameinfos[-self.config.max_frames:]
+
+                supp_exc = self.config.suppressed_exceptions
+                is_suppressed = False
+                if supp_exc:
+                    if isinstance(supp_exc, type):
+                        supp_tuple = (supp_exc,)
+                    elif isinstance(supp_exc, tuple):
+                        supp_tuple = supp_exc
+                    else:
+                        try:
+                            supp_tuple = tuple(supp_exc)
+                        except TypeError:
