+"""
+Formatting configuration parameter object.
+"""
+import copy
+
+
+VALID_SHOW_VALS = ('all', 'like_source', 'line', None, False)
+_DEFAULT_SUPPRESSED_EXCEPTIONS = object()
+
+
+def _normalize_patterns(patterns):
+    if patterns is None:
+        return None
+
+    if isinstance(patterns, (str, bytes)):
+        return [patterns]
+
+    if hasattr(patterns, "search") or hasattr(patterns, "pattern"):
+        return [patterns]
+
+    if isinstance(patterns, (list, tuple, set)) or hasattr(patterns, "__iter__"):
+        return list(patterns)
+
+    return [patterns]
+
+
+class FormatConfig:
+    """
+    Encapsulates all formatting configuration options.
+    """
+
+    def __init__(
+        self,
+        style='plaintext',
+        source_lines=5,
+        source_lines_after=1,
+        show_signature=True,
+        show_vals='like_source',
+        truncate_vals=500,
+        line_wrap=60,
+        suppressed_paths=None,
+        suppressed_vars=None,
+        suppressed_exceptions=_DEFAULT_SUPPRESSED_EXCEPTIONS,
+        reverse=False,
+        add_summary='auto',
+        max_frames=None,
+        indent='',
+    ):
+        object.__setattr__(self, '_frozen', False)
+        if not (isinstance(source_lines, int) or source_lines == 'all'):
+            raise ValueError(
+                "source_lines must be an integer or 'all', was %r" % (source_lines,)
+            )
+
+        if show_vals not in VALID_SHOW_VALS:
+            raise ValueError(
+                "show_vals must be one of %s, was %r" % (str(list(VALID_SHOW_VALS)), show_vals)
+            )
+
+        self.style = style
+        self.source_lines = source_lines
+        self.source_lines_after = source_lines_after
+        self.show_signature = show_signature
+        self.show_vals = show_vals
+        self.truncate_vals = truncate_vals
+        self.line_wrap = line_wrap
+
+        self.suppressed_paths = _normalize_patterns(suppressed_paths)
+        self.suppressed_vars = _normalize_patterns(suppressed_vars)
+
+        if suppressed_exceptions is _DEFAULT_SUPPRESSED_EXCEPTIONS:
+            self.suppressed_exceptions = [KeyboardInterrupt]
+        elif suppressed_exceptions is None:
+            self.suppressed_exceptions = None
+        elif isinstance(suppressed_exceptions, (list, tuple, set)):
+            self.suppressed_exceptions = list(suppressed_exceptions)
+        elif isinstance(suppressed_exceptions, type) and issubclass(suppressed_exceptions, BaseException):
+            self.suppressed_exceptions = [suppressed_exceptions]
+        else:
+            try:
+                self.suppressed_exceptions = list(suppressed_exceptions)
+            except TypeError:
+                self.suppressed_exceptions = [suppressed_exceptions]
+
+        if max_frames is not None and (not isinstance(max_frames, int) or isinstance(max_frames, bool) or max_frames < 1):
+            raise ValueError(
+                "max_frames must be a positive integer or None, was %r" % (max_frames,)
+            )
+
+        if indent is not None and not isinstance(indent, str):
+            raise ValueError(
+                "indent must be a string, was %r" % (indent,)
+            )
+
+        self.reverse = reverse
+        self.add_summary = add_summary
+        self.max_frames = max_frames
+        self.indent = '' if indent is None else indent
+        object.__setattr__(self, '_frozen', True)
+
+    def __setattr__(self, name, value):
+        if getattr(self, '_frozen', False):
+            raise AttributeError(f"FormatConfig is immutable; cannot set attribute '{name}'")
+        super().__setattr__(name, value)
+
+    @classmethod
+    def from_kwargs(cls, config=None, **kwargs):
+        if isinstance(config, cls):
+            if kwargs:
+                return config.with_overrides(**kwargs)
+            return config
+        if config is not None:
+            raise TypeError("config must be a FormatConfig instance or None, got %r" % (type(config),))
+        return cls(**kwargs)
+
+    def with_overrides(self, **kwargs):
+        current = {
+            'style': self.style,
+            'source_lines': self.source_lines,
+            'source_lines_after': self.source_lines_after,
+            'show_signature': self.show_signature,
+            'show_vals': self.show_vals,
+            'truncate_vals': self.truncate_vals,
+            'line_wrap': self.line_wrap,
+            'suppressed_paths': copy.copy(self.suppressed_paths) if self.suppressed_paths is not None else None,
+            'suppressed_vars': copy.copy(self.suppressed_vars) if self.suppressed_vars is not None else None,
+            'suppressed_exceptions': copy.copy(self.suppressed_exceptions) if isinstance(self.suppressed_exceptions, (list, tuple, set)) else self.suppressed_exceptions,
+            'reverse': self.reverse,
+            'add_summary': self.add_summary,
+            'max_frames': self.max_frames,
+            'indent': self.indent,
+        }
+        current.update(kwargs)
+        return FormatConfig(**current)
+
+    def copy(self, **kwargs):
+        return self.with_overrides(**kwargs)
+
+    def as_minimal(self):
+        min_src = 0 if self.source_lines == 0 else 1
+        return self.with_overrides(
+            source_lines=min_src,
+            show_signature=False,
+            show_vals=False,
+        )
+
+    def as_reduced(self):
+        min_src = 0 if self.source_lines == 0 else 1
+        return self.with_overrides(
+            source_lines=min_src,
+            show_signature=self.show_signature,
+            show_vals=self.show_vals,
+        )
