+class ThreadStackFormatter:
+    """
+    Handles call stack inspection and formatting for threading.Thread objects.
+    """
+
+    def __init__(self, config=None, styler=None):
+        self.config = config or FormatConfig()
+        self.cfg = self.config
+        self.styler = styler or get_styler(self.config.style)
+
+    def format_thread(self, thread):
+        prefix = getattr(self.config, 'indent', '')
+        ident = getattr(thread, 'ident', None)
+        if ident is None:
+            return indent_text("%r: no frames found" % thread, prefix)
+
+        if hasattr(thread, 'is_alive') and not thread.is_alive():
+            return indent_text("%r: no frames found" % thread, prefix)
+
+        try:
+            frames = sys._current_frames()
+        except Exception:
+            return indent_text("%r: no frames found" % thread, prefix)
+
+        if ident not in frames:
+            return indent_text("%r: no frames found" % thread, prefix)
+
+        fr = frames[ident]
+        if fr is None:
+            return indent_text("%r: no frames found" % thread, prefix)
+
+        stack = []
+        curr = fr
+        while curr is not None:
+            stack.append(curr)
+            curr = curr.f_back
+
+        if not stack:
+            return indent_text("%r: no frames found" % thread, prefix)
+
+        stack = list(reversed(stack))
+        suppressed = list(self.config.suppressed_paths or []) + [r"lib/python.*/threading\.py"]
+        thread_cfg = self.config.with_overrides(
+            suppressed_paths=suppressed,
+            add_summary=False,
+            suppressed_exceptions=None,
+            indent='',
+        )
+
+        total = len(stack)
+        omitted = 0
+        if thread_cfg.max_frames is not None and total > thread_cfg.max_frames:
+            omitted = total - thread_cfg.max_frames
+            stack = stack[-thread_cfg.max_frames:]
+
+        renderer = ExceptionRenderer(thread_cfg, styler=self.styler)
+        frameinfos = [
+            ex.get_info(f, suppressed_vars=thread_cfg.suppressed_vars)
+            for f in stack
+        ]
+        msg = renderer.render_stack(frameinfos)
+        msg_indented = '    ' + '\n    '.join(msg.split('\n')).strip()
+        if omitted > 0:
+            msg_indented += '\n    ... (%d frames omitted)' % omitted
+        return indent_text("%r\n\n%s" % (thread, msg_indented), prefix)
 
 
