+def test_public_entrypoints_config_and_unknown_kwargs():
+    try:
+        from stackprinter.config import FormatConfig
+        cfg = FormatConfig(style='plaintext', source_lines=2)
+    except ImportError:
+        cfg = None
+
+    # 1. format(exc)
+    exc = ValueError("entry_boundary_exc")
+    if cfg is not None:
+        out = stackprinter.format(exc, _config=cfg)
+        assert "ValueError: entry_boundary_exc" in out
+        with pytest.raises(TypeError):
+            stackprinter.format(exc, config=cfg)
+        # _config merge / override order: explicit kwarg overrides _config
+        out_override = stackprinter.format(exc, _config=cfg, style='darkbg')
+        out_direct = stackprinter.format(exc, _config=cfg.with_overrides(style='darkbg'))
+        assert out_override == out_direct
+        # _config must be a FormatConfig instance
+        with pytest.raises(TypeError):
+            stackprinter.format(exc, _config=object())
+        # source_lines_after accepted on exception target
+        out_sla = stackprinter.format(exc, source_lines_after=2)
+        assert "ValueError: entry_boundary_exc" in out_sla
+    else:
+        try:
+            res = stackprinter.format(exc, config="not_allowed")
+            assert "ValueError: entry_boundary_exc" in res or "Stackprinter failed" in res
+        except TypeError:
+            pass
+
+    # 2. format(frame)
+    fr = sys._getframe()
+    if cfg is not None:
+        out_fr = stackprinter.format(fr, _config=cfg)
+        assert "test_public_entrypoints_config_and_unknown_kwargs" in out_fr
+        with pytest.raises(TypeError):
+            stackprinter.format(fr, config=cfg)
+        with pytest.raises(TypeError):
+            stackprinter.format(fr, unknown_frame_kw="invalid")
+        with pytest.raises(TypeError):
+            stackprinter.format(fr, suppressed_exceptions=[])
+        with pytest.raises(TypeError):
+            stackprinter.format(fr, _config=object())
+        out_fr_sla = stackprinter.format(fr, source_lines_after=2)
+        assert "test_public_entrypoints_config_and_unknown_kwargs" in out_fr_sla
+    else:
+        out_fr = stackprinter.format(fr)
+        assert "test_public_entrypoints_config_and_unknown_kwargs" in out_fr
+        with pytest.raises(TypeError):
+            stackprinter.format(fr, config="not_allowed")
+        with pytest.raises(TypeError):
+            stackprinter.format(fr, unknown_frame_kw="invalid")
+        with pytest.raises(TypeError):
+            stackprinter.format(fr, suppressed_exceptions=[])
+
+    # 3. format(thread)
+    t = threading.Thread(target=lambda: None)
+    if cfg is not None:
+        out_th = stackprinter.format(t, _config=cfg)
+        assert "%r: no frames found" % t == out_th
+        with pytest.raises(TypeError):
+            stackprinter.format(t, config=cfg)
+        with pytest.raises(TypeError):
+            stackprinter.format(t, unknown_th_kw="invalid")
+        with pytest.raises(TypeError):
+            stackprinter.format(t, suppressed_exceptions=[])
+        with pytest.raises(TypeError):
+            stackprinter.format(t, _config=object())
+        out_th_sla = stackprinter.format(t, source_lines_after=2)
+        assert "%r: no frames found" % t == out_th_sla
+    else:
+        out_th = stackprinter.format(t)
+        assert "%r: no frames found" % t == out_th
+        try:
+            stackprinter.format(t, config="not_allowed")
+        except TypeError:
+            pass
+
+    # 4. format_current_stack
+    if cfg is not None:
+        out_stk = stackprinter.format_current_stack(_config=cfg)
+        assert "test_public_entrypoints_config_and_unknown_kwargs" in out_stk
+        with pytest.raises(TypeError):
+            stackprinter.format_current_stack(config=cfg)
+        with pytest.raises(TypeError):
+            stackprinter.format_current_stack(unknown_stk_kw="invalid")
+    else:
+        out_stk = stackprinter.format_current_stack()
+        assert "test_public_entrypoints_config_and_unknown_kwargs" in out_stk
+        with pytest.raises(TypeError):
+            stackprinter.format_current_stack(config="not_allowed")
+        with pytest.raises(TypeError):
+            stackprinter.format_current_stack(unknown_stk_kw="invalid")
+
+    # 5. format_current_exception
+    try:
+        raise KeyError("current_exc_boundary")
+    except KeyError:
+        if cfg is not None:
+            out_ce = stackprinter.format_current_exception(_config=cfg)
+            assert "KeyError: 'current_exc_boundary'" in out_ce
+            with pytest.raises(TypeError):
+                stackprinter.format_current_exception(config=cfg)
+        else:
+            out_ce = stackprinter.format_current_exception()
+            assert "KeyError: 'current_exc_boundary'" in out_ce
+            with pytest.raises(TypeError):
+                stackprinter.format_current_exception(config="not_allowed")
+
+    # 6. show() entrypoints accept _config and reject public config=
+    buf = io.StringIO()
+    if cfg is not None:
+        stackprinter.show(exc, file=buf, _config=cfg)
+        assert "ValueError: entry_boundary_exc" in buf.getvalue()
+        with pytest.raises(TypeError):
+            stackprinter.show(exc, config=cfg)
+    else:
+        try:
+            stackprinter.show(exc, file=buf, config="not_allowed")
+        except TypeError:
+            pass
+
+    buf_stk = io.StringIO()
+    if cfg is not None:
+        stackprinter.show_current_stack(file=buf_stk, _config=cfg)
+        assert "test_public_entrypoints_config_and_unknown_kwargs" in buf_stk.getvalue()
+        with pytest.raises(TypeError):
+            stackprinter.show_current_stack(config=cfg)
+    else:
+        buf_stk = io.StringIO()
+        stackprinter.show_current_stack(file=buf_stk)
+        assert "test_public_entrypoints_config_and_unknown_kwargs" in buf_stk.getvalue()
+        with pytest.raises(TypeError):
+            stackprinter.show_current_stack(config="not_allowed")
+
+    buf_ce = io.StringIO()
+    try:
+        raise IndexError("show_current_exc_boundary")
+    except IndexError:
+        if cfg is not None:
+            stackprinter.show_current_exception(file=buf_ce, _config=cfg)
+            assert "IndexError: show_current_exc_boundary" in buf_ce.getvalue()
+            with pytest.raises(TypeError):
+                stackprinter.show_current_exception(config=cfg)
+        else:
+            buf_ce = io.StringIO()
+            stackprinter.show_current_exception(file=buf_ce)
+            assert "IndexError: show_current_exc_boundary" in buf_ce.getvalue()
+            with pytest.raises(TypeError):
+                stackprinter.show_current_exception(config="not_allowed")
+
+    # 7. Exception target without traceback keeps baseline unvalidated behavior for kwargs
+    exc_no_tb = ValueError("no_tb_unvalidated_kwarg")
+    out_no_tb = stackprinter.format(exc_no_tb, unknown_kwarg_unvalidated=999)
+    assert "ValueError: no_tb_unvalidated_kwarg" in out_no_tb
+
+    # 8. show() with default 'stderr' and sys.stderr is None silently returns None before checking kwargs
+    old_stderr = sys.stderr
+    try:
+        sys.stderr = None
+        res_silent = stackprinter.show(ValueError("silent_err"), unknown_kwarg_silent=999)
+        assert res_silent is None
+    finally:
+        sys.stderr = old_stderr
+
