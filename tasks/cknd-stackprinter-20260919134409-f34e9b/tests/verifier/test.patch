+import io
+import sys
+import threading
+import pytest
+import stackprinter
+
+def _probe_boom():
+    probe_value = 3
+    return 1 / (probe_value - 3)
+
+def _probe_traced_call():
+    traced_value = 5
+    return traced_value + 1
+
+def _probe_exc():
+    try:
+        _probe_boom()
+    except ZeroDivisionError as exc:
+        return exc
+    raise AssertionError("expected ZeroDivisionError")
+
+def _assert_prefixed(text, prefix, label):
+    assert isinstance(text, str) and text, "%s: empty output" % label
+    for line in text.split("\n"):
+        if not line:
+            continue
+        assert line.startswith(prefix), "%s: line not prefixed: %r" % (label, line[:100])
+        assert not line.startswith(prefix + prefix), "%s: prefix applied twice: %r" % (label, line[:100])
+
+# ================= Integration tests (preserved, not in config) =================
+
+def test_integration_indent_config_validation_and_routing():
+    from stackprinter.config import FormatConfig
+
+    assert FormatConfig().indent == ""
+    assert FormatConfig(indent="  ").indent == "  "
+    assert FormatConfig(indent=None).indent == ""
+
+    for bad in (1, 1.5, b"  ", [], object()):
+        expected = "indent must be a string, was %r" % (bad,)
+        with pytest.raises(ValueError) as info:
+            FormatConfig(indent=bad)
+        assert str(info.value) == expected
+
+    frame = sys._getframe()
+    with pytest.raises(ValueError):
+        stackprinter.format(frame, indent=1)
+
+    exc = _probe_exc()
+    cfg = FormatConfig(indent="> ")
+    _assert_prefixed(stackprinter.format(exc, _config=cfg), "> ", "exc with _config")
+    assert stackprinter.format(exc, _config=cfg, indent="") == stackprinter.format(
+        exc, style="plaintext"
+    )
+
+def test_integration_indent_exception_and_frame_rendering():
+    from stackprinter.config import FormatConfig
+    from stackprinter.formatting import ExceptionRenderer
+
+    prefix = "|| "
+    exc = _probe_exc()
+    out = stackprinter.format(exc, indent=prefix)
+    _assert_prefixed(out, prefix, "exception target")
+    assert "ZeroDivisionError" in out
+
+    cfg = FormatConfig(indent=prefix)
+    expected = stackprinter.format(exc, _config=cfg)
+    assert ExceptionRenderer(cfg).render(type(exc), exc, exc.__traceback__) == expected
+
+    frame_out = stackprinter.format(sys._getframe(), indent=prefix)
+    _assert_prefixed(frame_out, prefix, "frame target")
+
+def test_integration_indent_thread_and_current_stack_rendering():
+    prefix = ".. "
+    release = threading.Event()
+
+    def worker_body():
+        release.wait(5)
+
+    thread = threading.Thread(target=worker_body, name="indent-probe")
+    thread.start()
+    try:
+        out = stackprinter.format(thread, indent=prefix)
+    finally:
+        release.set()
+        thread.join(5)
+    _assert_prefixed(out, prefix, "thread target")
+
+    dead = threading.Thread(target=lambda: None)
+    dead_out = stackprinter.format(dead, indent=prefix)
+    _assert_prefixed(dead_out, prefix, "dead thread")
+    assert "no frames found" in dead_out
+
+    _assert_prefixed(stackprinter.format_current_stack(indent=prefix), prefix, "current stack")
+
+def test_integration_indent_trace_and_show_rendering():
+    prefix = ":: "
+
+    buf = io.StringIO()
+    with stackprinter.TracePrinter(print_function=buf.write, style="plaintext", indent=prefix):
+        _probe_traced_call()
+    events = buf.getvalue()
+    assert events.strip(), "trace emitted no events"
+    _assert_prefixed(events, prefix, "TracePrinter events")
+
+    deco_buf = io.StringIO()
+    wrapped = stackprinter.trace(print_function=deco_buf.write, style="plaintext", indent=prefix)(
+        _probe_traced_call
+    )
+    wrapped()
+    deco_events = deco_buf.getvalue()
+    assert deco_events.strip(), "@trace emitted no events"
+    _assert_prefixed(deco_events, prefix, "@trace events")
+
+    show_buf = io.StringIO()
+    exc = _probe_exc()
+    stackprinter.show(exc, file=show_buf, indent=prefix)
+    _assert_prefixed(show_buf.getvalue(), prefix, "show")
+    assert show_buf.getvalue().rstrip("\n") == stackprinter.format(exc, indent=prefix).rstrip("\n")
+
+def test_integration_indent_frame_budget_and_summary_blocks():
+    prefix = "# "
+    exc = _probe_exc()
+
+    budgeted = stackprinter.format(exc, indent=prefix, max_frames=1)
+    _assert_prefixed(budgeted, prefix, "max_frames")
+    assert "frames omitted" in budgeted
+
+    summarized = stackprinter.format(exc, indent=prefix, add_summary=True)
+    _assert_prefixed(summarized, prefix, "add_summary")
+    assert "(full traceback" in summarized
+
+    assert stackprinter.format(exc, indent="") == stackprinter.format(exc)
+    _assert_prefixed(stackprinter.format(exc, indent=prefix, style="darkbg"), prefix, "ansi")
+
+# ================= Atomic tests (Table 11.2) =================
+
+def test_atomic_indent_default_and_validation():
+    from stackprinter.config import FormatConfig
+    assert FormatConfig().indent == ""
+    assert FormatConfig(indent="  ").indent == "  "
+    assert FormatConfig(indent=None).indent == ""
+    for bad in (1, 1.5, b"  ", [], object()):
+        expected = "indent must be a string, was %r" % (bad,)
+        with pytest.raises(ValueError) as info:
+            FormatConfig(indent=bad)
+        assert str(info.value) == expected
+    frame = sys._getframe()
+    with pytest.raises(ValueError):
+        stackprinter.format(frame, indent=1)
+
+def test_atomic_indent_config_routing():
+    from stackprinter.config import FormatConfig
+    exc = _probe_exc()
+    cfg = FormatConfig(indent="> ")
+    _assert_prefixed(stackprinter.format(exc, _config=cfg), "> ", "exc with _config")
+    assert stackprinter.format(exc, _config=cfg, indent="") == stackprinter.format(
+        exc, style="plaintext"
+    )
+
+def test_atomic_indent_exception():
+    prefix = "|| "
+    exc = _probe_exc()
+    out = stackprinter.format(exc, indent=prefix)
+    _assert_prefixed(out, prefix, "exception target")
+    assert "ZeroDivisionError" in out
+
+def test_atomic_indent_frame():
+    prefix = "|| "
+    frame_out = stackprinter.format(sys._getframe(), indent=prefix)
+    _assert_prefixed(frame_out, prefix, "frame target")
+
+def test_atomic_indent_renderer_parity():
+    from stackprinter.config import FormatConfig
+    from stackprinter.formatting import ExceptionRenderer
+    prefix = "|| "
+    exc = _probe_exc()
+    cfg = FormatConfig(indent=prefix)
+    expected = stackprinter.format(exc, _config=cfg)
+    assert ExceptionRenderer(cfg).render(type(exc), exc, exc.__traceback__) == expected
+
+def test_atomic_indent_thread():
+    prefix = ".. "
+    release = threading.Event()
+    def worker_body():
+        release.wait(5)
+    thread = threading.Thread(target=worker_body, name="indent-probe")
+    thread.start()
+    try:
+        out = stackprinter.format(thread, indent=prefix)
+    finally:
+        release.set()
+        thread.join(5)
+    _assert_prefixed(out, prefix, "thread target")
+
+def test_atomic_indent_dead_thread():
+    prefix = ".. "
+    dead = threading.Thread(target=lambda: None)
+    dead_out = stackprinter.format(dead, indent=prefix)
+    _assert_prefixed(dead_out, prefix, "dead thread")
+    assert "no frames found" in dead_out
+
+def test_atomic_indent_current_stack():
+    prefix = ".. "
+    _assert_prefixed(stackprinter.format_current_stack(indent=prefix), prefix, "current stack")
+
+def test_atomic_indent_traceprinter():
+    prefix = ":: "
+    buf = io.StringIO()
+    with stackprinter.TracePrinter(print_function=buf.write, style="plaintext", indent=prefix):
+        _probe_traced_call()
+    events = buf.getvalue()
+    assert events.strip(), "trace emitted no events"
+    _assert_prefixed(events, prefix, "TracePrinter events")
+
+def test_atomic_indent_trace_decorator():
+    prefix = ":: "
+    deco_buf = io.StringIO()
+    wrapped = stackprinter.trace(print_function=deco_buf.write, style="plaintext", indent=prefix)(
+        _probe_traced_call
+    )
+    wrapped()
+    deco_events = deco_buf.getvalue()
+    assert deco_events.strip(), "@trace emitted no events"
+    _assert_prefixed(deco_events, prefix, "@trace events")
+
+def test_atomic_indent_show():
+    prefix = ":: "
+    show_buf = io.StringIO()
+    exc = _probe_exc()
+    stackprinter.show(exc, file=show_buf, indent=prefix)
+    _assert_prefixed(show_buf.getvalue(), prefix, "show")
+    assert show_buf.getvalue().rstrip("\n") == stackprinter.format(exc, indent=prefix).rstrip("\n")
+
+def test_atomic_indent_max_frames():
+    prefix = "# "
+    exc = _probe_exc()
+    budgeted = stackprinter.format(exc, indent=prefix, max_frames=1)
+    _assert_prefixed(budgeted, prefix, "max_frames")
+    assert "frames omitted" in budgeted
+
+def test_atomic_indent_summary():
+    prefix = "# "
+    exc = _probe_exc()
+    summarized = stackprinter.format(exc, indent=prefix, add_summary=True)
+    _assert_prefixed(summarized, prefix, "add_summary")
+    assert "(full traceback" in summarized
+
+def test_atomic_indent_line_wrap():
+    exc = _probe_exc()
+    prefix = ">>>> "
+    indented = stackprinter.format(exc, style="plaintext", line_wrap=30, indent=prefix)
+    plain = stackprinter.format(exc, style="plaintext", line_wrap=30)
+    stripped = "\n".join(
+        line[len(prefix):] if line.startswith(prefix) else line
+        for line in indented.split("\n")
+    )
+    assert stripped == plain
+    assert max(len(line) for line in indented.split("\n")) > 30
