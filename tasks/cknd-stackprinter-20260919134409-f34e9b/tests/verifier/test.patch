+import io
+import os
+import re
+import sys
+import threading
+import types
+import pytest
+import stackprinter
+
+
+def test_format_exception_instance_value_error():
+    try:
+        raise ValueError("explicit_exception_instance")
+    except ValueError as exc:
+        output = stackprinter.format(exc)
+    assert "ValueError: explicit_exception_instance" in output
+    assert "-->" in output
+
+
+def test_format_exception_instance_key_error():
+    try:
+        raise KeyError("explicit_key_error")
+    except KeyError as exc:
+        out_key = stackprinter.format(exc)
+    assert "KeyError: 'explicit_key_error'" in out_key
+
+
+def test_format_exception_instance_no_tb():
+    exc_no_tb = ValueError("no_tb_msg")
+    out_no_tb = stackprinter.format(exc_no_tb)
+    assert out_no_tb == "ValueError: no_tb_msg"
+
+
+def test_format_exception_instance_config_rejected():
+    try:
+        raise RuntimeError("test_tb_error")
+    except RuntimeError as exc:
+        with pytest.raises(TypeError):
+            stackprinter.format(exc, config="not_allowed")
+
+
+def test_format_current_stack():
+    output = stackprinter.format_current_stack()
+    assert "test_format_current_stack" in output
+    assert "File " in output
+    assert "-->" in output
+
+
+def test_show_current_stack_file():
+    buf = io.StringIO()
+    stackprinter.show_current_stack(file=buf)
+    content = buf.getvalue()
+    assert "test_show_current_stack_file" in content
+    assert "File " in content
+
+
+def test_format_current_exception():
+    try:
+        raise ZeroDivisionError("division by zero test")
+    except ZeroDivisionError:
+        output = stackprinter.format_current_exception()
+    assert "ZeroDivisionError: division by zero test" in output
+    assert "-->" in output
+
+
+def test_show_current_exception_file():
+    buf = io.StringIO()
+    try:
+        raise KeyError("custom_missing_key")
+    except KeyError:
+        stackprinter.show_current_exception(file=buf)
+    content = buf.getvalue()
+    assert "KeyError: 'custom_missing_key'" in content
+
+
+def test_show_file_stdout():
+    old_stdout = sys.stdout
+    sys.stdout = io.StringIO()
+    try:
+        try:
+            raise IndexError("stdout_capture_test")
+        except IndexError as exc:
+            stackprinter.show(exc, file="stdout")
+        captured = sys.stdout.getvalue()
+        assert "IndexError: stdout_capture_test" in captured
+    finally:
+        sys.stdout = old_stdout
+
+
+def test_show_silent_when_stderr_none():
+    old_stderr = sys.stderr
+    sys.stderr = None
+    try:
+        try:
+            raise ValueError("silent_stderr_test")
+        except ValueError as exc:
+            ret = stackprinter.show(exc)
+            assert ret is None
+    finally:
+        sys.stderr = old_stderr
+
+
+def test_format_guess_thing_in_except():
+    try:
+        raise RuntimeError("guess_in_except_msg")
+    except RuntimeError:
+        output = stackprinter.format()
+    assert "RuntimeError: guess_in_except_msg" in output
+    assert "-->" in output
+
+
+def test_format_guess_thing_outside_except():
+    output = stackprinter.format()
+    assert "test_format_guess_thing_outside_except" in output
+    assert "-->" in output
+
+
+def test_format_invalid_target_type_int():
+    with pytest.raises(ValueError, match="Can't format"):
+        stackprinter.format(12345)
+
+
+def test_format_invalid_target_type_string():
+    with pytest.raises(ValueError, match="Can't format"):
+        stackprinter.format("plain string target")
+
+
+def test_format_invalid_target_type_exception_class():
+    with pytest.raises(ValueError, match="Can't format"):
+        stackprinter.format(KeyboardInterrupt)
+
+
+def test_format_invalid_source_lines():
+    fr = sys._getframe()
+    with pytest.raises(ValueError, match="source_lines must be an integer or 'all'"):
+        stackprinter.format(fr, source_lines="unsupported")
+
+
+def test_format_invalid_show_vals():
+    fr = sys._getframe()
+    with pytest.raises(ValueError, match="show_vals must be one of"):
+        stackprinter.format(fr, show_vals="unsupported")
+
+
+def test_format_frame_unexpected_keyword():
+    fr = sys._getframe()
+    with pytest.raises(TypeError):
+        stackprinter.format(fr, unexpected_keyword="invalid")
+
+
+def test_format_frame_suppressed_exceptions_rejected():
+    fr = sys._getframe()
+    with pytest.raises(TypeError):
+        stackprinter.format(fr, suppressed_exceptions=[])
+
+
+def test_format_frame_config_rejected():
+    fr = sys._getframe()
+    with pytest.raises(TypeError):
+        stackprinter.format(fr, config="not_a_config_instance")
+
+
+def test_format_current_stack_unexpected_keyword():
+    with pytest.raises(TypeError):
+        stackprinter.format_current_stack(unexpected_keyword="invalid")
+
+
+def test_format_thread_unexpected_keyword():
+    ev = threading.Event()
+    active_thread = threading.Thread(target=ev.wait)
+    active_thread.start()
+    try:
+        with pytest.raises(TypeError):
+            stackprinter.format_thread(active_thread, unexpected_keyword="invalid")
+    finally:
+        ev.set()
+        active_thread.join()
+
+
+def test_format_thread_suppressed_exceptions_rejected():
+    ev = threading.Event()
+    active_thread = threading.Thread(target=ev.wait)
+    active_thread.start()
+    try:
+        with pytest.raises(TypeError):
+            stackprinter.format_thread(active_thread, suppressed_exceptions=[])
+    finally:
+        ev.set()
+        active_thread.join()
+
+
+def test_format_thread_config_rejected():
+    ev = threading.Event()
+    active_thread = threading.Thread(target=ev.wait)
+    active_thread.start()
+    try:
+        with pytest.raises(TypeError):
+            stackprinter.format_thread(active_thread, config="not_a_config_instance")
+    finally:
+        ev.set()
+        active_thread.join()
+
+
+def test_format_exception_debug_fallback():
+    old_dbg = os.environ.pop("PY_STACKPRINTER_DEBUG", None)
+    try:
+        try:
+            1 / 0
+        except ZeroDivisionError as exc:
+            fallback_out = stackprinter.format(exc, unexpected_keyword="invalid")
+            assert "Stackprinter failed:" in fallback_out
+            assert "So here is your original traceback at least:" in fallback_out
+            assert "ZeroDivisionError: division by zero" in fallback_out
+    finally:
+        if old_dbg is not None:
+            os.environ["PY_STACKPRINTER_DEBUG"] = old_dbg
+
+
+def test_format_source_lines_zero():
+    try:
+        raise ValueError("error_with_zero_source_lines")
+    except ValueError as exc:
+        output = stackprinter.format(exc, source_lines=0)
+    assert "ValueError: error_with_zero_source_lines" in output
+    assert "-->" not in output
+
+
+def test_format_source_lines_all():
+    fr = sys._getframe()
+    output = stackprinter.format(fr, source_lines="all")
+    assert "test_format_source_lines_all" in output
+    assert "-->" in output
+
+
+def test_format_show_signature_false():
+    fr = sys._getframe()
+    output = stackprinter.format(fr, source_lines=2, show_signature=False)
+    expected_sig = "def " + "test_format_show_signature_false():"
+    assert expected_sig not in output
+    assert "-->" in output
+
+
+def test_format_show_vals_modes():
+    def dummy(val):
+        dummy_var = val
+        return sys._getframe(), dummy_var
+
+    val_marker = "visible_marker_" + "123"
+    fr, _ = dummy(val_marker)
+    out_none = stackprinter.format(fr, show_vals=None)
+    assert val_marker not in out_none
+    out_line = stackprinter.format(fr, show_vals="line")
+    assert val_marker in out_line
+    assert "dummy_var =" in out_line
+
+
+def test_format_truncate_vals():
+    def dummy():
+        long_string_var = "a" * 500
+        return sys._getframe()
+
+    fr = dummy()
+    output = stackprinter.format(fr, truncate_vals=30)
+    assert "long_string_var =" in output
+    assert "..." in output
+    assert "a" * 500 not in output
+
+    from stackprinter.prettyprinting import truncate
+
+    fixed_str = "x" * 20
+    # Fixed-length string boundary assertions at n, n+1, n+3, n+4
+    assert truncate(fixed_str, 20) == fixed_str
+    assert truncate(fixed_str, 19) == fixed_str
+    assert truncate(fixed_str, 17) == fixed_str
+    assert truncate(fixed_str, 16) == "x" * 16 + "..."
+    assert truncate(fixed_str, 0) == fixed_str
+
+
+def test_format_line_wrap_disabled():
+    def dummy():
+        long_line_var = "abcdefghij" * 10
+        return sys._getframe()
+
+    fr = dummy()
+    out_nowrap = stackprinter.format(fr, line_wrap=0)
+    assert "abcdefghij" * 10 in out_nowrap
+
+
+def test_format_suppressed_vars_list():
