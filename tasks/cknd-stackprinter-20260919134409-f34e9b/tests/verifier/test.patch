+        out_fallback = r_fallback.render(exc_fb.__class__, exc_fb, exc_fb.__traceback__)
+        assert "Stackprinter failed" in out_fallback
+        assert "So here is your original traceback at least:" in out_fallback
+        assert "ZeroDivisionError: division by zero" in out_fallback
