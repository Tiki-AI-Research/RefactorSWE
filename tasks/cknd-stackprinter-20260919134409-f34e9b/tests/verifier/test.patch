+def test_integration_exception_renderer_pipeline_features(monkeypatch):
+    from stackprinter.formatting import ExceptionRenderer
+    from stackprinter.config import FormatConfig
+
+    captured_exc = None
+    try:
+        try:
+            raise KeyError("root_pipeline_error")
+        except KeyError as err:
