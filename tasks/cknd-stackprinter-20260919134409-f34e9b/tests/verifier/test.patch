+    assert "KeyError: 'root_pipeline_error'" in out_chain
+    assert "ValueError: derived_pipeline_error" in out_chain
+
+    r_summary = ExceptionRenderer(FormatConfig(style='plaintext', add_summary=True))
+    out_summary = r_summary.render(captured_exc.__class__, captured_exc, captured_exc.__traceback__)
+    assert "---- (full traceback above) ----" in out_summary
+    assert "ValueError: derived_pipeline_error" in out_summary
+
+    def outer():
+        inner()
+
+    def inner():
+        raise ValueError("pipeline_reverse_error")
+
+    try:
+        outer()
+    except ValueError as exc_rev:
+        r_rev = ExceptionRenderer(FormatConfig(style='plaintext', reverse=True))
+        out_rev = r_rev.render(exc_rev.__class__, exc_rev, exc_rev.__traceback__)
+        assert out_rev.find("in inner") < out_rev.find("in outer")
+
+    class ExceptionGroup(Exception):
+        pass
+
+    eg = ExceptionGroup("pipeline_eg_fallback")
