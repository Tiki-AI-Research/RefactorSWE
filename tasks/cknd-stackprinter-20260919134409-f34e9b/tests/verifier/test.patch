+def test_format_thread_reverse_and_ansi():
+    started = threading.Event()
+    stop = threading.Event()
+
+    def live_worker():
+        started.set()
+        while not stop.is_set():
+            pass
+
+    thread = threading.Thread(target=live_worker, name="ReverseAnsiThread")
+    thread.start()
+    try:
+        assert started.wait(3.0)
+        live_repr = "%r" % thread
+        forward = stackprinter.format(thread)
+        reversed_out = stackprinter.format(thread, reverse=True)
+        ansi_out = stackprinter.format(thread, style="darkbg")
+    finally:
+        stop.set()
+        thread.join(3.0)
+
+    assert forward.startswith(live_repr)
+    assert " in live_worker" in forward
+    assert "\x1b[" not in forward
+    assert reversed_out != forward
+    assert " in live_worker" in reversed_out
+    assert "\x1b[" in ansi_out
+    assert " in live_worker" in ansi_out
+    body_lines = [ln for ln in forward.splitlines()[1:] if ln.strip()]
+    assert body_lines, "thread stack body must not be empty"
+    assert body_lines[0].startswith("    "), (
+        "thread stack body must be indented relative to the thread header, got %r"
+        % (body_lines[0][:40],)
+    )
