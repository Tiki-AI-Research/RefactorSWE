+def test_integration_equivalent_config_consistent_output():
+    from stackprinter.config import FormatConfig
+
+    try:
+        raise ValueError("consistency_check_message")
+    except ValueError as exc:
+        out_kwargs_exc = stackprinter.format(
+            exc,
+            style='plaintext',
+            source_lines=3,
+            show_vals='line',
+            truncate_vals=300,
+        )
+        cfg_exc = FormatConfig(
+            style='plaintext',
+            source_lines=3,
+            show_vals='line',
+            truncate_vals=300,
+        )
+        out_cfg_exc = stackprinter.format(exc, _config=cfg_exc)
+        assert out_kwargs_exc == out_cfg_exc
+
+    def dummy_frame():
+        local_marker = "consistent_frame_local"
+        return sys._getframe()
+
+    fr = dummy_frame()
+    cfg_fr = FormatConfig(style='plaintext', source_lines=2, add_summary=False)
+    out_kwargs_fr = stackprinter.format(fr, style='plaintext', source_lines=2, add_summary=False)
+    out_cfg_fr = stackprinter.format(fr, _config=cfg_fr)
+    assert "consistent_frame_local" in out_kwargs_fr
+    assert "consistent_frame_local" in out_cfg_fr
+    assert out_kwargs_fr.split("dummy_frame")[-1] == out_cfg_fr.split("dummy_frame")[-1]
+
+    started = threading.Event()
+    stop = threading.Event()
+
+    def worker():
+        started.set()
+        stop.wait(5.0)
+
+    worker_th = threading.Thread(target=worker, name="EquivalentWorkerThread")
+    worker_th.start()
+    try:
+        assert started.wait(2.0)
+        out_kwargs_th = stackprinter.format(worker_th, style='plaintext', add_summary=False)
+        cfg_th = FormatConfig(style='plaintext', add_summary=False)
+        out_cfg_th = stackprinter.format(worker_th, _config=cfg_th)
+        assert out_kwargs_th == out_cfg_th
+    finally:
+        stop.set()
+        worker_th.join(timeout=2.0)
