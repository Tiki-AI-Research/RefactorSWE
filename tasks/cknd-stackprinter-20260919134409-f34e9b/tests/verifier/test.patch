+def test_integration_refactoring_manifest_responsibilities_and_migration():
+    pkg_dir = Path(stackprinter.__file__).resolve().parent
+    repo_root = pkg_dir.parent
+    manifest_path = repo_root / "REFACTORING.md"
+
+    assert manifest_path.exists(), "REFACTORING.md must exist in repository root"
+    content = manifest_path.read_text(encoding="utf-8")
+
+    required_modules = [
+        "stackprinter.config",
+        "stackprinter.styling",
+        "stackprinter.formatting",
+        "stackprinter.frame_formatting",
+        "stackprinter.tracing",
+    ]
+    for mod in required_modules:
+        assert mod in content, f"Manifest must document responsibility of module {mod}"
+
+    required_components = [
+        "FormatConfig",
+        "Styler",
+        "PlaintextStyler",
+        "AnsiStyler",
+        "ExceptionRenderer",
+        "ThreadStackFormatter",
+        "TraceEventFormatter",
+    ]
+    comp_names = set(required_components)
+    for comp in required_components:
+        pattern = rf"{comp}[^\n]{{0,50}}(?::|\||-)\s*([^\n]+)"
+        matches = re.findall(pattern, content)
+        valid = False
+        for m in matches:
+            words = [w.strip('`*.,()') for w in m.split() if w.strip('`*.,()')]
+            non_comp_words = [w for w in words if w not in comp_names]
+            if len(non_comp_words) >= 5:
+                valid = True
+                break
+        assert valid, f"Manifest must document responsibility of component {comp} with descriptive text"
+
+    assert "migration capabilities & integration guidance" in content.casefold()
+    assert any(term in content.casefold() for term in ("backward compat", "backwards compat", "compatibility"))
+    assert "_config" in content
+
+    mig_idx = content.casefold().find("migration capabilities & integration guidance")
+    mig_section = content[mig_idx:] if mig_idx != -1 else ""
+
+    steps = []
+    for line in mig_section.splitlines():
+        m = re.match(r"^\s*\d+[.)]\s+(.*)$", line)
+        if m:
+            steps.append(m.group(1).strip())
+    assert len(steps) >= 3
+
+    code_blocks = re.findall(r"```[^\n]*\n(.*?)```", mig_section, re.DOTALL)
+    assert code_blocks
+    example_lines = [ln for ln in code_blocks[0].splitlines() if ln.strip()]
+    assert len(example_lines) >= 2
