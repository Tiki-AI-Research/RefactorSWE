@@ -0,0 +1,473 @@
+#!/usr/bin/env python3
+"""F2P runner for the frozen verifier plan.
+
+Runs the F2P selector set declared by the F2P draft with the real Go test
+runner and writes a conventional JUnit report to the path given by --report.
+Every selector is an exact leaf of a declared test file; the runner never
+falls back to package patterns, whole test files or collection inventories.
+
+The selector set is the frozen F2P declaration embedded below. When the
+pipeline materialises the canonical plan as config.json, its ``f2p`` array is
+used instead, mirroring how the frozen P2P runner consumes its selector file;
+the embedded list keeps the runner self-sufficient on the Baseline and in
+replay containers. Selection input is discovered through --config/--selectors,
+the F2P_CONFIG / F2P_SELECT / F2P_SELECT_FILE environment variables, and
+config.json / f2p_select.txt next to the working directory, the repository
+root or this script.
+
+The runner never installs anything and never touches the network: the Go
+toolchain, module cache and repository files are expected to be provided by
+the frozen environment image. Go build and temporary data are staged inside
+VERIFIER_EXEC_DIR (or TMPDIR) when the pipeline provides them.
+"""
+
+import argparse
+import json
+import os
+import re
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+# (repo-relative test file path, exact Go test leaf)
+SELECTORS = [
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PMappingEntryPointHasNoLayoutLoops"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PMappingEntryPointDelegatesLowLevelPrimitives"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PRootIdentificationOwnedByDedicatedUnit"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PRootSeparationOwnedByDedicatedUnit"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PLevelReservationStateOwnedByDedicatedType"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PNodePlacementOwnedByDedicatedUnit"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PColumnRowSizingOwnedByLabelAwareUnit"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PEdgeFinalizationOwnedByDedicatedUnit"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PGridToDrawingConversionOwnedByDedicatedUnit"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PMappingEntryPointBuildsNoCoordinatesInline"),
+    ("pkg/graph/f2p_mapping_structure_test.go", "TestF2PMappingStepsCoverResponsibilitiesWithDistinctOwners"),
+]
+
+INTERNAL_TIMEOUT_SECONDS = 240
+
+SELECTOR_ENV_VARS = ("F2P_SELECT", "F2P_SELECT_FILE", "F2P_CONFIG", "VERIFIER_CONFIG")
+DECLARED = {f"{path}::{leaf}" for path, leaf in SELECTORS}
+
+
+def repo_root():
+    here = Path(__file__).resolve()
+    for candidate in (here.parent, *here.parents):
+        if (candidate / "go.mod").is_file():
+            return candidate
+    raise RuntimeError("f2p runner: repository root (go.mod) not found")
+
+
+def parse_selector_text(text, strict=False):
+    selectors = []
+    skipped = 0
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        for token in re.split(r"[\s,]+", line):
+            token = token.strip().strip("\"'[]{}")
+            if not token:
+                continue
+            path, sep, leaf = token.partition("::")
+            if not sep or not path or not leaf:
+                if strict:
+                    raise RuntimeError(f"f2p runner: invalid selector line: {line!r}")
+                skipped += 1
+                continue
+            selectors.append((path.replace("\\", "/"), leaf))
+    return selectors, skipped
+
+
+def parse_config_selectors(text):
+    """Extract exact selectors from a canonical plan config.
+
+    The canonical plan stores the F2P selection in an ``f2p`` array of
+    selector strings (or rows carrying a ``selector``/``test`` field). An
+    ``f2p_points`` array of rows carrying ``test`` is accepted as well. Broad
+    material such as test files, patterns or collection inventories is never
+    turned into a selection here.
+    """
+    try:
+        data = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise RuntimeError(f"f2p runner: invalid config json: {exc}") from exc
+    if not isinstance(data, dict):
+        return []
+    rows = []
+    for key in ("f2p", "f2p_select", "f2p_points"):
+        value = data.get(key)
+        if isinstance(value, list) and value:
+            rows = value
+            break
+    selectors = []
+    for row in rows:
+        if isinstance(row, str):
+            token = row
+        elif isinstance(row, dict):
+            token = row.get("selector") or row.get("test") or ""
+        else:
+            continue
+        token = str(token).strip()
+        if not token:
+            continue
+        path, sep, leaf = token.partition("::")
+        if not sep or not path or not leaf:
+            continue
+        selectors.append((path.replace("\\", "/"), leaf))
+    return selectors
+
+
+def normalize_selector_path(path, root):
+    cleaned = path.strip()
+    while cleaned.startswith("./"):
+        cleaned = cleaned[2:]
+    if cleaned.startswith("/"):
+        parts = cleaned.split("/")
+        for start in range(1, len(parts)):
+            candidate = "/".join(parts[start:])
+            if (root / candidate).is_file():
+                return candidate
+    return cleaned
+
+
+def discover_selection_file(root):
+    candidates = []
+    for var in SELECTOR_ENV_VARS:
+        value = os.environ.get(var)
+        if value:
+            candidates.append(Path(value))
+    here = Path(__file__).resolve()
+    for base in (Path.cwd(), root, here.parent, here.parent.parent):
+        candidates.append(base / "config.json")
+        candidates.append(base / "verifier" / "config.json")
+        candidates.append(base / "f2p_select.txt")
+        candidates.append(base / "verifier" / "f2p_select.txt")
+    seen = set()
+    for candidate in candidates:
+        key = str(candidate)
+        if key in seen:
+            continue
+        seen.add(key)
+        if candidate.is_file():
+            return candidate
+    return None
+
+
+def load_selectors(source, root, strict=True):
+    if source is None:
+        return list(SELECTORS)
+    text = Path(source).read_text(encoding="utf-8")
+    if Path(source).suffix == ".json":
+        selectors = parse_config_selectors(text)
+    else:
+        selectors, _ = parse_selector_text(text, strict=strict)
+    return [(normalize_selector_path(path, root), leaf) for path, leaf in selectors]
+
+
+def validate(root, selectors):
+    """Return {selector: reason} for selectors that cannot be collected."""
+    problems = {}
+    for path, leaf in selectors:
+        test_file = root / path
+        selector = f"{path}::{leaf}"
+        if not test_file.is_file():
+            problems[selector] = f"missing test file: {path}"
+            continue
+        source = test_file.read_text(encoding="utf-8", errors="replace")
+        if not re.search(rf"^func {re.escape(leaf)}\(", source, re.M):
+            problems[selector] = f"{path} does not define {leaf}"
+    return problems
+
+
+def stage_exec_environment(env):
+    """Place Go build/temp data inside the provided exec or temp area.
+
+    The pipeline supplies VERIFIER_EXEC_DIR for executions declared with
+    require_exec=true and TMPDIR for temporary data; falling back to the image
+    defaults only when neither is usable. No installation, download or
+    registry access happens here.
+    """
+    bases = [env.get("VERIFIER_EXEC_DIR"), env.get("TMPDIR")]
+    for name, sub in (("GOCACHE", "go-build-cache"), ("GOTMPDIR", "go-tmp")):
+        if env.get(name):
+            continue
+        for base in bases:
+            if not base:
+                continue
+            candidate = Path(base) / sub
+            try:
+                candidate.mkdir(parents=True, exist_ok=True)
+            except OSError:
+                continue
+            env[name] = str(candidate)
+            break
+
+
+def run_go_test(root, selectors):
+    leaves = sorted({leaf for _, leaf in selectors})
+    pattern = "^(" + "|".join(leaves) + ")$"
+    packages = sorted({"./" + str(Path(path).parent) for path, _ in selectors})
+    command = ["go", "test", "-json", "-count=1", "-run", pattern, *packages]
+    env = dict(os.environ)
+    env["GOPROXY"] = "off"
+    env.setdefault("GOTOOLCHAIN", "local")
+    stage_exec_environment(env)
+    try:
+        proc = subprocess.run(
+            command,
+            cwd=str(root),
+            env=env,
+            capture_output=True,
+            text=True,
+            timeout=INTERNAL_TIMEOUT_SECONDS,
+        )
+    except FileNotFoundError as exc:
+        return command, "", str(exc), None, "exec"
+    except subprocess.TimeoutExpired as exc:
+        stdout = exc.stdout or ""
+        stderr = exc.stderr or ""
+        if isinstance(stdout, bytes):
+            stdout = stdout.decode("utf-8", "replace")
+        if isinstance(stderr, bytes):
+            stderr = stderr.decode("utf-8", "replace")
+        return command, stdout, stderr, None, "timeout"
+    return command, proc.stdout, proc.stderr, proc.returncode, None
+
+
+def parse_go_json(stdout):
+    tests = {}
+    packages = {}
+    for line in stdout.splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            event = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        action = event.get("Action")
+        package = event.get("Package") or event.get("ImportPath") or ""
+        output = event.get("Output")
+        test = event.get("Test")
+        if test is None:
+            record = packages.setdefault(package, {"actions": set(), "output": []})
+            if action:
+                record["actions"].add(action)
+            if output:
+                record["output"].append(output)
+            continue
+        leaf = test.split("/")[0]
+        record = tests.setdefault(leaf, {"action": None, "output": [], "elapsed": 0.0})
+        if action in ("pass", "fail", "skip"):
+            record["action"] = action
+            elapsed = event.get("Elapsed")
+            if isinstance(elapsed, (int, float)):
+                record["elapsed"] = max(record["elapsed"], float(elapsed))
+        if output:
+            record["output"].append(output)
+    return tests, packages
+
+
+def package_output_for(packages, path, stderr_text):
+    chunks = []
+    for name, record in sorted(packages.items()):
+        if name.endswith(str(Path(path).parent)):
+            chunks.append("".join(record["output"]))
+    chunks.append(stderr_text)
+    return "".join(chunks)[-40000:]
+
+
+def build_rows(selectors, tests, packages, stderr_text, first_cause, problems):
+    rows = []
+    for path, leaf in selectors:
+        selector = f"{path}::{leaf}"
+        record = tests.get(leaf)
+        row = {"path": path, "leaf": leaf, "status": "fail", "message": "", "output": "", "elapsed": 0.0}
+        if selector in problems:
+            row["message"] = problems[selector]
+        elif first_cause == "timeout":
+            row["message"] = "f2p runner timed out before the Go test run finished"
+            row["output"] = stderr_text
+        elif first_cause == "exec":
+            row["message"] = "go toolchain unavailable: " + stderr_text
+            row["output"] = stderr_text
+        elif record is None or record["action"] is None:
+            row["message"] = "test was not executed (build, crash or collection failure)"
+            row["output"] = package_output_for(packages, path, stderr_text)
+        elif record["action"] == "pass":
+            row["status"] = "pass"
+        elif record["action"] == "skip":
+            row["message"] = "test was skipped; a skip cannot stand in for a real F2P run"
+            row["output"] = "".join(record["output"])[-40000:]
+        else:
+            row["message"] = "test failed"
+            row["output"] = "".join(record["output"])[-40000:]
+        if record is not None:
+            row["elapsed"] = record.get("elapsed", 0.0)
+        rows.append(row)
+    return rows
+
+
+def write_junit(report_path, rows):
+    tests = len(rows)
+    failures = sum(1 for row in rows if row["status"] != "pass")
+    root = ET.Element(
+        "testsuites",
+        {"name": "f2p", "tests": str(tests), "failures": str(failures), "errors": "0", "skipped": "0"},
+    )
+    by_path = {}
+    for row in rows:
+        by_path.setdefault(row["path"], []).append(row)
+    for path, path_rows in by_path.items():
+        path_failures = sum(1 for row in path_rows if row["status"] != "pass")
+        suite = ET.SubElement(
+            root,
+            "testsuite",
+            {
+                "name": path,
+                "tests": str(len(path_rows)),
+                "failures": str(path_failures),
+                "errors": "0",
+                "skipped": "0",
+            },
+        )
+        for row in path_rows:
+            case = ET.SubElement(
+                suite,
+                "testcase",
+                {
+                    "classname": row["path"],
+                    "name": row["leaf"],
+                    "file": row["path"],
+                    "time": f"{row.get('elapsed', 0.0):.3f}",
+                },
+            )
+            if row["status"] != "pass":
+                failure = ET.SubElement(case, "failure", {"message": row["message"] or "failed"})
+                if row["message"] == "test failed" and not re.search(
+                    r"(?m)^(?:panic:|fatal error:|signal:|SIG[A-Z]+:)", row["output"]
+                ):
+                    failure.set("type", "AssertionError")
+                failure.text = row["output"]
+    tree = ET.ElementTree(root)
+    ET.indent(tree, space="  ")
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    tree.write(str(report_path), encoding="utf-8", xml_declaration=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Run the frozen F2P selector set and write JUnit.")
+    parser.add_argument("--report", required=True, help="path of the JUnit XML report to write")
+    parser.add_argument("--config", default=None, help="optional canonical plan config.json with the f2p selection")
+    parser.add_argument("--selectors", default=None, help="optional selector override file (debug only)")
+    args = parser.parse_args()
+
+    root = repo_root()
+    source = None
+    if args.selectors:
+        source = Path(args.selectors)
+    elif args.config and Path(args.config).is_file():
+        source = Path(args.config)
+    elif args.config:
+        print(
+            f"f2p runner: config path {args.config!r} is not a file; discovering selection input instead",
+            file=sys.stderr,
+        )
+        source = discover_selection_file(root)
+    else:
+        source = discover_selection_file(root)
+
+    if source is not None:
+        try:
+            selectors = load_selectors(source, root=root, strict=False)
+        except (RuntimeError, OSError) as exc:
+            print(
+                f"f2p runner: cannot read selection input {source}: {exc};"
+                " falling back to the embedded frozen F2P declaration",
+                file=sys.stderr,
+            )
+            selectors = list(SELECTORS)
+        if selectors:
+            print(f"f2p runner: selection input from {source}", file=sys.stderr)
+            discovered = {f"{p}::{l}" for p, l in selectors}
+            missing = sorted(DECLARED - discovered)
+            extra = sorted(discovered - DECLARED)
+            if missing or extra:
+                print(
+                    "f2p runner: WARNING selection input differs from the embedded frozen F2P declaration"
+                    f" (missing={len(missing)}, extra={len(extra)})",
+                    file=sys.stderr,
+                )
+                for item in missing[:50]:
+                    print(f"f2p runner: WARNING missing {item}", file=sys.stderr)
+                for item in extra[:50]:
+                    print(f"f2p runner: WARNING extra {item}", file=sys.stderr)
+        else:
+            print(
+                f"f2p runner: {source} yielded no usable selectors;"
+                " falling back to the embedded frozen F2P declaration",
+                file=sys.stderr,
+            )
+            selectors = list(SELECTORS)
+    else:
+        print(
+            "f2p runner: no config.json/f2p_select.txt found; using the embedded frozen F2P declaration",
+            file=sys.stderr,
+        )
+        selectors = list(SELECTORS)
+
+    problems = validate(root, selectors)
+    for reason in sorted(set(problems.values())):
+        print(f"f2p runner: selector problem: {reason}", file=sys.stderr)
+
+    runnable = [(path, leaf) for path, leaf in selectors if f"{path}::{leaf}" not in problems]
+    if runnable:
+        command, stdout, stderr_text, returncode, first_cause = run_go_test(root, runnable)
+        print("f2p runner: $ " + " ".join(command), file=sys.stderr)
+    else:
+        command, stdout, stderr_text, returncode, first_cause = [], "", "", None, None
+
+    if first_cause == "exec":
+        print(f"f2p runner: cannot run the Go test runner: {stderr_text}", file=sys.stderr)
+        return 2
+
+    tests, packages = parse_go_json(stdout)
+    if first_cause is None and not tests:
+        combined = (stdout + "\n" + stderr_text).lower()
+        infra_markers = (
+            "module lookup disabled by goproxy=off",
+            "missing go.sum entry",
+            "go: downloading",
+            "dial tcp",
+            "connection refused",
+            "i/o timeout",
+        )
+        if any(marker in combined for marker in infra_markers):
+            print(
+                "f2p runner: missing dependencies in the frozen environment image: " + stderr_text[-2000:],
+                file=sys.stderr,
+            )
+            return 2
+
+    rows = build_rows(selectors, tests, packages, stderr_text, first_cause, problems)
+    report_path = Path(args.report)
+    write_junit(report_path, rows)
+
+    passed = sum(1 for row in rows if row["status"] == "pass")
+    failed = len(rows) - passed
+    print(f"f2p runner: {passed}/{len(rows)} selectors passed; report written to {report_path}", file=sys.stderr)
+    for row in rows:
+        if row["status"] != "pass":
+            print(f"f2p runner: FAIL {row['path']}::{row['leaf']}: {row['message']}", file=sys.stderr)
+    if failed:
+        return 1
+    if returncode not in (0, None):
+        print(f"f2p runner: go test exited with {returncode} although all selectors passed", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
