+package graph_test
+
+// Supplemental P2P contract tests for the mapping phase.
+//
+// These tests only use the frozen public API (graph.Parse, graph.Draw,
+// graph.Properties, graph.Properties.ShowCoords) so that any internal
+// reorganisation of the mapping phase stays allowed, and they pin the
+// observable results that the frozen requirements must preserve:
+// byte-identical rendering, the coordinate overlay, root separation,
+// collision advancement, fanout/edge/label routing, subgraph boxes and
+// offsets, parse/error behaviour and the exported surface.
+
+import (
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/AlexanderGrooff/mermaid-ascii/pkg/diagram"
+	"github.com/AlexanderGrooff/mermaid-ascii/pkg/graph"
+)
+
+// Compile-time checks that the frozen signatures still exist (REQ-BEH-T3:C1,
+// REQ-BEH-T3:C2, REQ-BEH-T3:C6).
+var (
+	_ func(mermaid string, styleType string) (*graph.Properties, error) = graph.Parse
+	_ func(properties *graph.Properties) string                         = graph.Draw
+)
+
+type p2pCase struct {
+	mermaid  string
+	ascii    bool
+	coords   bool
+	paddingX int
+	paddingY int
+}
+
+func p2pRender(t *testing.T, name string, tc p2pCase) string {
+	t.Helper()
+	properties, err := graph.Parse(tc.mermaid, "cli")
+	if err != nil {
+		t.Fatalf("%s: Parse() error = %v", name, err)
+	}
+	config := &diagram.Config{
+		UseAscii:         tc.ascii,
+		ShowCoords:       tc.coords,
+		BoxBorderPadding: 1,
+		PaddingBetweenX:  tc.paddingX,
+		PaddingBetweenY:  tc.paddingY,
+		StyleType:        "cli",
+	}
+	properties.Apply(config)
+	return graph.Draw(properties)
+}
+
+func p2pVisualize(s string) string {
+	return strings.ReplaceAll(s, " ", "\u00b7")
+}
+
+func p2pAssertGolden(t *testing.T, name string, tc p2pCase) {
+	t.Helper()
+	want, ok := p2pGoldens[name]
+	if !ok {
+		t.Fatalf("missing golden for case %q", name)
+	}
+	got := p2pRender(t, name, tc)
+	if got != want {
+		t.Errorf("%s: rendered mapping changed\nwant:\n%s\ngot:\n%s", name, p2pVisualize(want), p2pVisualize(got))
+	}
+}
+
+func p2pNames(cases map[string]p2pCase) []string {
+	names := make([]string, 0, len(cases))
+	for name := range cases {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+func p2pModuleRoot(t *testing.T) string {
+	t.Helper()
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd() error = %v", err)
+	}
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatalf("go.mod not found above %s", dir)
+		}
+		dir = parent
+	}
+}
