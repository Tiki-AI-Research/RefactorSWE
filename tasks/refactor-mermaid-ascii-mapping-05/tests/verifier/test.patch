+#!/usr/bin/env python3
+"""P2P runner for the frozen verifier plan.
+
+Runs the frozen P2P selector set with the real Go test runner and writes a
+conventional JUnit report to the path given by --report. The selector list
+below is the frozen plan selection (original Baseline regression nodes plus the
+supplemental P2P nodes). Selection input is taken from the materialized
+p2p_select.txt (env P2P_SELECT / P2P_SELECT_FILE, then p2p_select.txt or
+verifier/p2p_select.txt relative to the working directory, repository root or
+this script); when that file is absent the embedded frozen list is used, so the
+runner is self-sufficient on the Baseline. No extra selection manifest is
+required and an optional --selectors override exists for debugging only.
+
+The runner never installs anything and never touches the network: the Go
+toolchain, module cache and repository files are expected to be provided by
+the frozen environment image. Go build and temporary data are staged inside
+VERIFIER_EXEC_DIR (or TMPDIR) when the pipeline provides them.
+"""
+
+import argparse
+import json
+import os
+import re
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+# (repo-relative test file path, exact Go test leaf)
+SELECTORS = [
+    ("pkg/graph/graph_test.go", "TestASCII"),
+    ("pkg/graph/graph_test.go", "TestExtendedChars"),
+    ("pkg/graph/graph_test.go", "TestMultibyte"),
+    ("pkg/graph/graph_test.go", "TestGraphUseAsciiConfig"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphHandlesLongChainWithoutPanic"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphKeepsDisplayWidthForWideNodeLabels"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphHandlesUnicodeClusterNodeLabels"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PCoordinateOverlayMatchesBaseline"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PShowCoordsFieldControlsOverlay"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PRootSeparationMixedSubgraphRootsLR"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PCollisionAdvanceAndPerLevelReservation"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphSeparatesDuplicateEdgeLabels"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphSeparatesBidirectionalEdgeLabelsLR"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphSeparatesBidirectionalEdgeLabelsTD"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphAlignsFanoutLabels"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PFanoutLayoutAndLabelAlignment"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PBackEdgeAndLabelLineRouting"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphKeepsDisplayWidthForWideSubgraphTitles"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphKeepsStandaloneSubgraphLabelWhenReferencedLater"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PSubgraphBoundingBoxAndOffset"),
+    ("pkg/graph/label_test.go", "TestNewGraphLabel"),
+    ("pkg/graph/parse_test.go", "TestSplitGraphLines"),
+    ("pkg/graph/parse_test.go", "TestSplitGraphLinesKeepsLiteralNewlineInsideNodeLabel"),
+    ("pkg/graph/parse_test.go", "TestParseNodeWithExplicitLabel"),
+    ("pkg/graph/parse_test.go", "TestParseNodePreservesLiteralBoundaryQuote"),
+    ("pkg/graph/parse_test.go", "TestParseNodeFallsBackForExtraClosingDelimiter"),
+    ("pkg/graph/parse_test.go", "TestParseNodeFallsBackForUnmatchedQuoteBeforeClosingDelimiter"),
+    ("pkg/graph/parse_test.go", "TestParseNodeShapes"),
+    ("pkg/graph/parse_test.go", "TestMermaidFileToMapKeepsShapedNodeLabelsAcrossBareReferences"),
+    ("pkg/graph/parse_test.go", "TestMermaidFileToMapPreservesEscapedLabelNewlines"),
+    ("pkg/graph/parse_test.go", "TestMermaidFileToMapPreservesLiteralLabelNewlines"),
+    ("pkg/graph/parse_test.go", "TestParseSubgraphHeader"),
+    ("pkg/graph/parse_test.go", "TestMermaidFileToMapParsesSubgraphIDAndTitle"),
+    ("pkg/graph/parse_test.go", "TestMermaidFileToMapKeepsExplicitNodeLabelAcrossBareReferences"),
+    ("pkg/graph/parse_test.go", "TestMermaidFileToMapUsesLatestExplicitLabel"),
+    ("pkg/graph/parse_test.go", "TestMermaidFileToMapParsesNonStandardEdgeOperators"),
+    ("pkg/graph/parse_test.go", "TestMermaidFileToMapParsesChainedNonStandardEdges"),
+    ("pkg/graph/parse_test.go", "TestParsePreservesQuotedLabelMarkersAndUnquotedClassShorthand"),
+    ("pkg/graph/parse_test.go", "TestParseNodeDoesNotTreatQuotedClassMarkerAsShorthand"),
+    ("pkg/graph/parse_test.go", "TestParseRejectsMalformedClassDefWithoutPanicking"),
+    ("pkg/graph/parse_test.go", "TestGraphTypeDetection"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphKeepsExplicitTargetLabelAfterBareReference"),
+    ("pkg/graph/render_graph_test.go", "TestRenderGraphSupportsLiteralNewlineInNodeLabel"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PParseContractAndErrorBehavior"),
+    ("cmd/root_test.go", "TestResolveMaxWidth"),
+    ("cmd/p2p_cli_contract_test.go", "TestP2PCLIFlagContractAndRendering"),
+    ("cmd/p2p_cli_contract_test.go", "TestP2PCLIErrorExitStatusAndDiagnostics"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PPublicApiSurfaceAvailable"),
+    ("pkg/graph/p2p_mapping_contract_test.go", "TestP2PModuleRequirementsUnchanged"),
+]
+
+INTERNAL_TIMEOUT_SECONDS = 420
+
+SELECTOR_ENV_VARS = ("P2P_SELECT", "P2P_SELECT_FILE")
+
+
+def repo_root():
+    here = Path(__file__).resolve()
+    for candidate in (here.parent, *here.parents):
+        if (candidate / "go.mod").is_file():
+            return candidate
+    raise RuntimeError("p2p runner: repository root (go.mod) not found")
+
+
+def parse_selector_text(text, strict=False):
+    selectors = []
+    skipped = 0
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        for token in re.split(r"[\s,]+", line):
+            token = token.strip().strip("\"'[]")
+            if not token:
+                continue
+            path, sep, leaf = token.partition("::")
+            if not sep or not path or not leaf:
+                if strict:
+                    raise RuntimeError(f"p2p runner: invalid selector line: {line!r}")
+                skipped += 1
+                continue
+            selectors.append((path.replace("\\", "/"), leaf))
+    return selectors, skipped
+
+
+def normalize_selector_path(path, root):
+    """Best-effort normalization of absolute or ./ prefixed selector paths."""
+    cleaned = path.strip()
+    while cleaned.startswith("./"):
+        cleaned = cleaned[2:]
+    if cleaned.startswith("/"):
+        parts = cleaned.split("/")
+        for start in range(1, len(parts)):
+            candidate = "/".join(parts[start:])
+            if (root / candidate).is_file():
+                return candidate
+    return cleaned
+
+
+def discover_selector_file(root):
+    candidates = []
+    for var in SELECTOR_ENV_VARS:
+        value = os.environ.get(var)
+        if value:
+            candidates.append(Path(value))
+    here = Path(__file__).resolve()
+    for base in (Path.cwd(), root, here.parent, here.parent.parent):
+        candidates.append(base / "p2p_select.txt")
+        candidates.append(base / "verifier" / "p2p_select.txt")
+    seen = set()
+    for candidate in candidates:
+        key = str(candidate)
+        if key in seen:
+            continue
+        seen.add(key)
+        if candidate.is_file():
+            return candidate
+    return None
+
+
+def load_selectors(override, root=None, strict=True):
+    if override is None:
+        return list(SELECTORS)
+    selectors, _ = parse_selector_text(Path(override).read_text(encoding="utf-8"), strict=strict)
+    if root is not None:
+        selectors = [(normalize_selector_path(path, root), leaf) for path, leaf in selectors]
+    return selectors
+
+
+def validate(root, selectors):
+    """Return {selector: reason} for selectors that cannot be collected."""
+    problems = {}
+    for path, leaf in selectors:
+        test_file = root / path
+        selector = f"{path}::{leaf}"
+        if not test_file.is_file():
+            problems[selector] = f"missing test file: {path}"
+            continue
+        source = test_file.read_text(encoding="utf-8", errors="replace")
+        if not re.search(rf"^func {re.escape(leaf)}\(", source, re.M):
+            problems[selector] = f"{path} does not define {leaf}"
+    return problems
+
+
+def stage_exec_environment(env):
+    """Place Go build/temp data inside the provided exec or temp area.
+
+    The pipeline supplies VERIFIER_EXEC_DIR for executions declared with
+    require_exec=true and TMPDIR for temporary data; falling back to the
+    image defaults only when neither is usable. No installation, download or
+    registry access happens here.
+    """
+    bases = [env.get("VERIFIER_EXEC_DIR"), env.get("TMPDIR")]
+    for name, sub in (("GOCACHE", "go-build-cache"), ("GOTMPDIR", "go-tmp")):
+        if env.get(name):
+            continue
+        for base in bases:
+            if not base:
+                continue
+            candidate = Path(base) / sub
+            try:
+                candidate.mkdir(parents=True, exist_ok=True)
+            except OSError:
+                continue
+            env[name] = str(candidate)
+            break
+
+
+def run_go_test(root, selectors):
+    leaves = sorted({leaf for _, leaf in selectors})
+    pattern = "^(" + "|".join(leaves) + ")$"
+    packages = sorted({"./" + str(Path(path).parent) for path, _ in selectors})
+    command = ["go", "test", "-json", "-count=1", "-run", pattern, *packages]
+    env = dict(os.environ)
+    env["GOPROXY"] = "off"
+    env.setdefault("GOTOOLCHAIN", "local")
+    stage_exec_environment(env)
+    try:
+        proc = subprocess.run(
+            command,
+            cwd=str(root),
+            env=env,
+            capture_output=True,
+            text=True,
+            timeout=INTERNAL_TIMEOUT_SECONDS,
+        )
+    except FileNotFoundError as exc:
+        return command, "", str(exc), None, "exec"
+    except subprocess.TimeoutExpired as exc:
+        stdout = exc.stdout or ""
+        stderr = exc.stderr or ""
+        if isinstance(stdout, bytes):
+            stdout = stdout.decode("utf-8", "replace")
+        if isinstance(stderr, bytes):
+            stderr = stderr.decode("utf-8", "replace")
+        return command, stdout, stderr, None, "timeout"
+    return command, proc.stdout, proc.stderr, proc.returncode, None
+
+
+def parse_go_json(stdout):
+    tests = {}
+    packages = {}
+    for line in stdout.splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            event = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        action = event.get("Action")
+        package = event.get("Package") or event.get("ImportPath") or ""
+        output = event.get("Output")
+        test = event.get("Test")
+        if test is None:
+            record = packages.setdefault(package, {"actions": set(), "output": []})
+            if action:
+                record["actions"].add(action)
+            if output:
+                record["output"].append(output)
+            continue
+        leaf = test.split("/")[0]
+        record = tests.setdefault(leaf, {"action": None, "output": [], "elapsed": 0.0})
+        if action in ("pass", "fail", "skip"):
+            record["action"] = action
+            elapsed = event.get("Elapsed")
+            if isinstance(elapsed, (int, float)):
+                record["elapsed"] = max(record["elapsed"], float(elapsed))
+        if output:
+            record["output"].append(output)
+    return tests, packages
+
+
+def package_output_for(packages, path, stderr_text):
+    package_dir = "./" + str(Path(path).parent)
+    chunks = []
+    for name, record in sorted(packages.items()):
+        if name.endswith(str(Path(path).parent)):
+            chunks.append("".join(record["output"]))
+    del package_dir
+    chunks.append(stderr_text)
+    return "".join(chunks)[-40000:]
+
+
+def build_rows(selectors, tests, packages, stderr_text, first_cause, problems):
+    rows = []
+    for path, leaf in selectors:
+        selector = f"{path}::{leaf}"
+        record = tests.get(leaf)
+        row = {"path": path, "leaf": leaf, "status": "fail", "message": "", "output": "", "elapsed": 0.0}
+        if selector in problems:
+            row["message"] = problems[selector]
+            row["output"] = ""
+        elif first_cause == "timeout":
+            row["message"] = "p2p runner timed out before the Go test run finished"
+            row["output"] = stderr_text
+        elif first_cause == "exec":
+            row["message"] = "go toolchain unavailable: " + stderr_text
+            row["output"] = stderr_text
+        elif record is None or record["action"] is None:
+            row["message"] = "test was not executed (build, crash or collection failure)"
+            row["output"] = package_output_for(packages, path, stderr_text)
+        elif record["action"] == "pass":
+            row["status"] = "pass"
+        elif record["action"] == "skip":
+            row["message"] = "test was skipped; a skip cannot stand in for a real P2P run"
+            row["output"] = "".join(record["output"])[-40000:]
+        else:
+            row["message"] = "test failed"
+            row["output"] = "".join(record["output"])[-40000:]
+        if record is not None:
+            row["elapsed"] = record.get("elapsed", 0.0)
+        rows.append(row)
+    return rows
+
+
+def write_junit(report_path, rows):
+    tests = len(rows)
+    failures = sum(1 for row in rows if row["status"] != "pass")
+    root = ET.Element(
+        "testsuites",
+        {"name": "p2p", "tests": str(tests), "failures": str(failures), "errors": "0", "skipped": "0"},
+    )
+    by_path = {}
+    for row in rows:
+        by_path.setdefault(row["path"], []).append(row)
+    for path, path_rows in by_path.items():
+        path_failures = sum(1 for row in path_rows if row["status"] != "pass")
+        suite = ET.SubElement(
+            root,
+            "testsuite",
+            {
+                "name": path,
+                "tests": str(len(path_rows)),
+                "failures": str(path_failures),
+                "errors": "0",
+                "skipped": "0",
+            },
+        )
+        for row in path_rows:
+            case = ET.SubElement(
+                suite,
+                "testcase",
+                {
+                    "classname": row["path"],
+                    "name": row["leaf"],
+                    "file": row["path"],
+                    "time": f"{row.get('elapsed', 0.0):.3f}",
+                },
+            )
+            if row["status"] != "pass":
+                failure = ET.SubElement(case, "failure", {"message": row["message"] or "failed"})
+                if row["message"] == "test failed" and not re.search(
+                    r"(?m)^(?:panic:|fatal error:|signal:|SIG[A-Z]+:)", row["output"]
+                ):
+                    failure.set("type", "AssertionError")
+                failure.text = row["output"]
+    tree = ET.ElementTree(root)
+    ET.indent(tree, space="  ")
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    tree.write(str(report_path), encoding="utf-8", xml_declaration=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Run the frozen P2P selector set and write JUnit.")
+    parser.add_argument("--report", required=True, help="path of the JUnit XML report to write")
+    parser.add_argument("--selectors", default=None, help="optional selector override file (debug only)")
+    args = parser.parse_args()
+
+    root = repo_root()
+    if args.selectors:
+        selectors = load_selectors(args.selectors, root=root)
+        print(f"p2p runner: selection input from explicit --selectors {args.selectors}", file=sys.stderr)
+    else:
+        selector_file = discover_selector_file(root)
+        if selector_file is not None:
+            selectors = load_selectors(selector_file, root=root, strict=False)
+            if selectors:
+                print(f"p2p runner: selection input from {selector_file}", file=sys.stderr)
+                declared = set(SELECTORS)
+                found = set(selectors)
+                if found != declared:
+                    missing = sorted(f"{p}::{l}" for p, l in declared - found)
+                    extra = sorted(f"{p}::{l}" for p, l in found - declared)
+                    print(
+                        "p2p runner: WARNING selector file differs from embedded frozen plan list"
+                        f" (missing={len(missing)}, extra={len(extra)})",
+                        file=sys.stderr,
+                    )
+                    for item in missing[:50]:
+                        print(f"p2p runner: WARNING missing {item}", file=sys.stderr)
+                    for item in extra[:50]:
+                        print(f"p2p runner: WARNING extra {item}", file=sys.stderr)
+            else:
+                print(
+                    f"p2p runner: {selector_file} yielded no usable selectors;"
+                    " falling back to the embedded frozen plan list",
+                    file=sys.stderr,
+                )
+                selectors = list(SELECTORS)
+        else:
+            print(
+                "p2p runner: no p2p_select.txt found; using the embedded frozen plan list",
+                file=sys.stderr,
+            )
+            selectors = list(SELECTORS)
+    problems = validate(root, selectors)
+    for reason in sorted(set(problems.values())):
+        print(f"p2p runner: selector problem: {reason}", file=sys.stderr)
+
+    runnable = [(path, leaf) for path, leaf in selectors if f"{path}::{leaf}" not in problems]
+    if runnable:
+        command, stdout, stderr_text, returncode, first_cause = run_go_test(root, runnable)
+        print("p2p runner: $ " + " ".join(command), file=sys.stderr)
+    else:
+        command, stdout, stderr_text, returncode, first_cause = [], "", "", None, None
+
+    if first_cause == "exec":
+        print(f"p2p runner: cannot run the Go test runner: {stderr_text}", file=sys.stderr)
+        return 2
+
+    tests, packages = parse_go_json(stdout)
+    if first_cause is None and not tests:
+        combined = (stdout + "\n" + stderr_text).lower()
+        infra_markers = (
+            "module lookup disabled by goproxy=off",
+            "missing go.sum entry",
+            "go: downloading",
+            "dial tcp",
+            "connection refused",
+            "i/o timeout",
+        )
+        if any(marker in combined for marker in infra_markers):
+            print("p2p runner: missing dependencies in the frozen environment image: " + stderr_text[-2000:], file=sys.stderr)
+            return 2
+
+    rows = build_rows(selectors, tests, packages, stderr_text, first_cause, problems)
+    report_path = Path(args.report)
+    write_junit(report_path, rows)
+
+    passed = sum(1 for row in rows if row["status"] == "pass")
+    failed = len(rows) - passed
+    print(f"p2p runner: {passed}/{len(rows)} selectors passed; report written to {report_path}", file=sys.stderr)
+    for row in rows:
+        if row["status"] != "pass":
+            print(f"p2p runner: FAIL {row['path']}::{row['leaf']}: {row['message']}", file=sys.stderr)
+    if failed:
+        return 1
+    if returncode not in (0, None):
+        print(f"p2p runner: go test exited with {returncode} although all selectors passed", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
