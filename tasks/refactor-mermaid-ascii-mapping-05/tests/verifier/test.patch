+package graph_test
+
+// The analyzer uses compiler object identity for calls and aliases. A private
+// spelling, promoted member, or generic instantiation is not a requirement.
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/importer"
+	"go/token"
+	"go/types"
+	"io"
+	"os"
+	"os/exec"
+	"time"
+)
+
+type f2pTyped struct {
+	literals map[*ast.FuncLit]*types.Func
+	bindings map[types.Object]map[*types.Func]bool
+	returned map[*types.Func]map[*types.Func]bool
+	path     string
+	info     *types.Info
+	funcs    map[*types.Func]*f2pFunc
+	keys     map[*f2pFunc]string
+}
+
+func (pp *f2pPackage) loadTypes(files []*ast.File) {
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "go", "list", "-mod=readonly", "-export", "-deps", "-json", ".")
+	cmd.Dir = pp.dir
+	data, err := cmd.Output()
+	if err != nil {
+		panic(fmt.Sprintf("source analysis infrastructure error: go list exports: %v", err))
+	}
+	exports := map[string]string{}
+	path := ""
+	dec := json.NewDecoder(bytes.NewReader(data))
+	for {
+		var row struct {
+			ImportPath, Export string
+			DepOnly            bool
+		}
+		err = dec.Decode(&row)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			panic(fmt.Sprintf("source analysis report error: %v", err))
+		}
+		exports[row.ImportPath] = row.Export
+		if !row.DepOnly {
+			path = row.ImportPath
+		}
+	}
+	info := &types.Info{Types: map[ast.Expr]types.TypeAndValue{}, Defs: map[*ast.Ident]types.Object{}, Uses: map[*ast.Ident]types.Object{}, Selections: map[*ast.SelectorExpr]*types.Selection{}}
+	imp := importer.ForCompiler(pp.fset, "gc", func(path string) (io.ReadCloser, error) {
+		if exports[path] == "" {
+			return nil, fmt.Errorf("missing export for %s", path)
+		}
+		return os.Open(exports[path])
+	})
+	conf := types.Config{Importer: imp}
+	if _, err = conf.Check(path, pp.fset, files, info); err != nil {
+		panic(fmt.Sprintf("source analysis compile error: %v", err))
+	}
+	typed := &f2pTyped{literals: map[*ast.FuncLit]*types.Func{}, bindings: map[types.Object]map[*types.Func]bool{}, returned: map[*types.Func]map[*types.Func]bool{}, path: path, info: info, funcs: map[*types.Func]*f2pFunc{}, keys: map[*f2pFunc]string{}}
+	for _, f := range pp.funcs {
+		if obj, ok := info.Defs[f.decl.Name].(*types.Func); ok {
+			typed.funcs[obj.Origin()] = f
+			key := fmt.Sprintf("@%d", f.decl.Pos())
+			typed.keys[f] = key
+			pp.byName[key] = []*f2pFunc{f}
+		}
+	}
+
+	for _, file := range files {
+		ast.Inspect(file, func(n ast.Node) bool {
+			if literal, ok := n.(*ast.FuncLit); ok {
+				signature, ok := info.TypeOf(literal).(*types.Signature)
+				if !ok {
+					panic("source analysis report error: function literal signature missing")
+				}
+				name := fmt.Sprintf("closure@%d", literal.Pos())
+				object := types.NewFunc(literal.Pos(), nil, name, signature)
+				decl := &ast.FuncDecl{Name: &ast.Ident{NamePos: literal.Pos(), Name: name}, Type: literal.Type, Body: literal.Body}
+				f := &f2pFunc{name: name, file: pp.fset.Position(literal.Pos()).Filename, decl: decl}
+				typed.literals[literal] = object
+				typed.funcs[object] = f
+				typed.keys[f] = name
+				pp.byName[name] = []*f2pFunc{f}
+				pp.funcs = append(pp.funcs, f)
+			}
+			return true
+		})
+	}
+	pp.typed = typed
+	pp.bindFunctionValues(files)
+}
+
+// Function values are resolved from compiler objects and actual bindings.
+// Call-graph reachability includes known callback targets and literal bodies.
+// Scalar value-flow requires a unique callee; unresolved dispatch is INCONCLUSIVE.
+func (pp *f2pPackage) functionObjects(expression ast.Expr) map[*types.Func]bool {
+	switch e := expression.(type) {
+	case *ast.FuncLit:
+		if object := pp.typed.literals[e]; object != nil {
+			return map[*types.Func]bool{object: true}
+		}
+	case *ast.ParenExpr:
+		return pp.functionObjects(e.X)
+	case *ast.StarExpr:
+		return pp.functionObjects(e.X)
+	case *ast.IndexExpr:
+		if _, ok := pp.typed.info.TypeOf(e.X).(*types.Signature); ok {
+			return pp.functionObjects(e.X)
+		}
+	case *ast.IndexListExpr:
+		return pp.functionObjects(e.X)
+	case *ast.Ident:
+		object := pp.typed.info.ObjectOf(e)
+		if f, ok := object.(*types.Func); ok {
+			return map[*types.Func]bool{f.Origin(): true}
+		}
+		return pp.typed.bindings[object]
+	case *ast.SelectorExpr:
+		object := pp.typed.info.ObjectOf(e.Sel)
+		if selection := pp.typed.info.Selections[e]; selection != nil {
+			object = selection.Obj()
+		}
+		if f, ok := object.(*types.Func); ok {
+			return map[*types.Func]bool{f.Origin(): true}
+		}
+		return pp.typed.bindings[object]
+	case *ast.CallExpr:
+		objects := pp.functionObjects(e.Fun)
+		if len(objects) == 1 {
+			for object := range objects {
+				return pp.typed.returned[object]
+			}
+		}
+	}
+	return nil
+}
+func f2pMergeFunctions(dst, src map[*types.Func]bool) bool {
+	changed := false
+	for f := range src {
+		if !dst[f] {
+			dst[f] = true
+			changed = true
+		}
+	}
+	return changed
+}
+func (pp *f2pPackage) bindingObject(e ast.Expr) types.Object {
+	switch x := e.(type) {
+	case *ast.Ident:
+		return pp.typed.info.ObjectOf(x)
+	case *ast.SelectorExpr:
+		if selection := pp.typed.info.Selections[x]; selection != nil {
+			return selection.Obj()
+		}
+		return pp.typed.info.ObjectOf(x.Sel)
+	}
+	return nil
+}
+func (pp *f2pPackage) bindFunctionValues(files []*ast.File) {
+	add := func(object types.Object, expression ast.Expr) bool {
+		if object == nil {
+			return false
+		}
+		if _, ok := object.Type().Underlying().(*types.Signature); !ok {
+			return false
+		}
+		if pp.typed.bindings[object] == nil {
+			pp.typed.bindings[object] = map[*types.Func]bool{}
+		}
+		return f2pMergeFunctions(pp.typed.bindings[object], pp.functionObjects(expression))
+	}
+	for changed := true; changed; {
+		changed = false
+		for _, file := range files {
+			ast.Inspect(file, func(n ast.Node) bool {
+				switch s := n.(type) {
+				case *ast.AssignStmt:
+					for i, lhs := range s.Lhs {
+						if i < len(s.Rhs) {
+							changed = add(pp.bindingObject(lhs), s.Rhs[i]) || changed
+						}
+					}
+				case *ast.ValueSpec:
+					for i, name := range s.Names {
+						if i < len(s.Values) {
+							changed = add(pp.typed.info.ObjectOf(name), s.Values[i]) || changed
+						}
+					}
+				case *ast.KeyValueExpr:
+					if id, ok := s.Key.(*ast.Ident); ok {
+						changed = add(pp.typed.info.ObjectOf(id), s.Value) || changed
+					}
+				case *ast.CallExpr:
+					objects := pp.functionObjects(s.Fun)
+					if len(objects) > 0 {
+						for object := range objects {
+							if target := pp.typed.funcs[object]; target != nil {
+								var parameters []*ast.Ident
+								if sel, ok := s.Fun.(*ast.SelectorExpr); ok {
+									if selection := pp.typed.info.Selections[sel]; selection != nil && selection.Kind() == types.MethodExpr {
+										for _, field := range target.decl.Recv.List {
+											parameters = append(parameters, field.Names...)
+										}
+									}
+								}
+								for _, field := range target.decl.Type.Params.List {
+									parameters = append(parameters, field.Names...)
+								}
+								for i, arg := range s.Args {
+									if i < len(parameters) {
+										changed = add(pp.typed.info.ObjectOf(parameters[i]), arg) || changed
+									}
+								}
+							}
+						}
+					}
+				}
+				return true
+			})
+		}
+		for object, f := range pp.typed.funcs {
+			if pp.typed.returned[object] == nil {
+				pp.typed.returned[object] = map[*types.Func]bool{}
+			}
+			ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+				if _, nested := n.(*ast.FuncLit); nested {
+					return false
+				}
+				if r, ok := n.(*ast.ReturnStmt); ok {
+					for _, e := range r.Results {
+						changed = f2pMergeFunctions(pp.typed.returned[object], pp.functionObjects(e)) || changed
+					}
+					if len(r.Results) == 0 && f.decl.Type.Results != nil {
+						for _, field := range f.decl.Type.Results.List {
+							for _, id := range field.Names {
+								changed = f2pMergeFunctions(pp.typed.returned[object], pp.functionObjects(id)) || changed
+							}
+						}
+					}
+				}
+				return true
+			})
+		}
+	}
+}
+func (pp *f2pPackage) target(expr ast.Expr) *f2pFunc {
+	objects := pp.functionObjects(expr)
+	if len(objects) == 1 {
+		for object := range objects {
+			return pp.typed.funcs[object]
+		}
+	}
+	return nil
+}
+func (pp *f2pPackage) typedCalls(n ast.Node) map[string]bool {
+	out := map[string]bool{}
+	ast.Inspect(n, func(n ast.Node) bool {
+		if call, ok := n.(*ast.CallExpr); ok {
+			objects := pp.functionObjects(call.Fun)
+			if len(objects) > 0 {
+				for object := range objects {
+					if f := pp.typed.funcs[object]; f != nil {
+						out[pp.typed.keys[f]] = true
+					} else if object.Pkg() != nil && object.Pkg().Path() == pp.typed.path {
+						pp.t.Skip("INCONCLUSIVE: unresolved local interface implementation")
+					}
+				}
+			} else if typ := pp.typed.info.TypeOf(call.Fun); typ != nil && !pp.typed.info.Types[call.Fun].IsType() {
+				if _, signature := typ.Underlying().(*types.Signature); signature {
+					object := pp.bindingObject(call.Fun)
+					if _, builtin := object.(*types.Builtin); !builtin {
+						pp.t.Skipf("INCONCLUSIVE: unresolved or ambiguous function-valued call at %s (%T, object=%v)", pp.fset.Position(call.Pos()), call.Fun, object)
+					}
+				}
+			}
+		}
+		return true
+	})
+	return out
+}
+
+// Numeric collection origins use objects rather than field names. Single-
+// assignment aliases are resolved exactly; a reassigned alias is unsupported
+// instead of being silently conflated with its earlier map.
+func f2pNumericCollection(typ types.Type) bool {
+	if typ == nil {
+		return false
+	}
+	if ptr, ok := typ.(*types.Pointer); ok {
+		typ = ptr.Elem()
+	}
+	switch c := typ.Underlying().(type) {
+	case *types.Map:
+		return types.Identical(c.Key(), types.Typ[types.Int]) && types.Identical(c.Elem(), types.Typ[types.Int])
+	case *types.Slice:
+		return types.Identical(c.Elem(), types.Typ[types.Int])
+	case *types.Array:
+		return types.Identical(c.Elem(), types.Typ[types.Int])
+	}
+	return false
+}
+
+type f2pOrigin struct {
+	object types.Object
+	owner  *f2pFunc
+}
+
+func (pp *f2pPackage) collectionOrigins(f *f2pFunc) func(ast.Expr) (f2pOrigin, bool) {
+	definitions := map[types.Object][]ast.Expr{}
+	for _, fieldList := range []*ast.FieldList{f.decl.Recv, f.decl.Type.Params} {
+		if fieldList == nil {
+			continue
+		}
+		for _, field := range fieldList.List {
+			for _, name := range field.Names {
+				obj := pp.typed.info.ObjectOf(name)
+				if obj != nil && f2pNumericCollection(obj.Type()) {
+					definitions[obj] = []ast.Expr{nil}
+				}
+			}
+		}
+	}
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		switch s := n.(type) {
+		case *ast.AssignStmt:
+			if s.Tok != token.ASSIGN && s.Tok != token.DEFINE {
+				return true
+			}
+			for i, lhs := range s.Lhs {
+				if id, ok := lhs.(*ast.Ident); ok && i < len(s.Rhs) {
+					obj := pp.typed.info.ObjectOf(id)
+					if obj != nil && f2pNumericCollection(obj.Type()) {
+						definitions[obj] = append(definitions[obj], s.Rhs[i])
+					}
+				}
+			}
+		case *ast.ValueSpec:
+			for i, id := range s.Names {
+				obj := pp.typed.info.ObjectOf(id)
+				if obj != nil && f2pNumericCollection(obj.Type()) {
+					var expr ast.Expr
+					if i < len(s.Values) {
+						expr = s.Values[i]
+					}
+					definitions[obj] = append(definitions[obj], expr)
+				}
+			}
+		}
+		return true
+	})
+	var resolve func(ast.Expr, map[types.Object]bool) (f2pOrigin, bool)
+	resolve = func(expr ast.Expr, seen map[types.Object]bool) (f2pOrigin, bool) {
+		switch e := expr.(type) {
+		case *ast.ParenExpr:
+			return resolve(e.X, seen)
+		case *ast.StarExpr:
+			return resolve(e.X, seen)
+		case *ast.SelectorExpr:
+			if selection := pp.typed.info.Selections[e]; selection != nil && selection.Kind() == types.FieldVal && f2pNumericCollection(selection.Obj().Type()) {
+				// A field belongs to the declared state type, including embedded fields.
+				return f2pOrigin{object: selection.Obj()}, true
+			}
+		case *ast.Ident:
+			obj := pp.typed.info.ObjectOf(e)
+			if obj == nil || seen[obj] || !f2pNumericCollection(obj.Type()) {
+				return f2pOrigin{}, false
+			}
+			seen[obj] = true
+			rhs := definitions[obj]
+			if len(rhs) != 1 {
+				return f2pOrigin{}, false
+			}
+			if rhs[0] == nil {
+				return f2pOrigin{object: obj, owner: f}, true
+			}
+			switch x := rhs[0].(type) {
+			case *ast.CompositeLit:
+				return f2pOrigin{object: obj, owner: f}, true
+			case *ast.CallExpr:
+				if id, ok := x.Fun.(*ast.Ident); ok && (id.Name == "make" || id.Name == "new") {
+					return f2pOrigin{object: obj, owner: f}, true
+				}
+			}
+			return resolve(rhs[0], seen)
+		}
+		return f2pOrigin{}, false
+	}
+	return func(e ast.Expr) (f2pOrigin, bool) { return resolve(e, map[types.Object]bool{}) }
+}
+
+type f2pOrigins map[f2pOrigin]bool
+
+func f2pMerge(dst, src f2pOrigins) bool {
+	changed := false
+	for x := range src {
+		if !dst[x] {
+			dst[x] = true
+			changed = true
+		}
+	}
+	return changed
+}
+
+// Follow reservation values through local aliases, helper returns and call
+// arguments into grid coordinates. A row-height/column-width map used only
+// for drawing dimensions is not evidence of a reservation cursor.
+func (pp *f2pPackage) reservationState() (bool, bool) {
+	entry := pp.entry
+	functions := pp.closure(entry)
+	values := map[types.Object]f2pOrigins{}
+	returns := map[*f2pFunc]f2pOrigins{}
+	resolvers := map[*f2pFunc]func(ast.Expr) (f2pOrigin, bool){}
+	for _, f := range functions {
+		returns[f] = f2pOrigins{}
+		resolvers[f] = pp.collectionOrigins(f)
+	}
+	var eval func(*f2pFunc, ast.Expr) f2pOrigins
+	eval = func(f *f2pFunc, e ast.Expr) f2pOrigins {
+		out := f2pOrigins{}
+		switch x := e.(type) {
+		case *ast.Ident:
+			f2pMerge(out, values[pp.typed.info.ObjectOf(x)])
+		case *ast.ParenExpr:
+			f2pMerge(out, eval(f, x.X))
+		case *ast.UnaryExpr:
+			f2pMerge(out, eval(f, x.X))
+		case *ast.StarExpr:
+			f2pMerge(out, eval(f, x.X))
+		case *ast.BinaryExpr:
+			f2pMerge(out, eval(f, x.X))
+			f2pMerge(out, eval(f, x.Y))
+		case *ast.IndexExpr:
+			if origin, ok := resolvers[f](x.X); ok {
+				out[origin] = true
+			}
+		case *ast.KeyValueExpr:
+			f2pMerge(out, eval(f, x.Value))
+		case *ast.CompositeLit:
+			for _, e := range x.Elts {
+				f2pMerge(out, eval(f, e))
+			}
+		case *ast.CallExpr:
+			if target := pp.target(x.Fun); target != nil {
+				f2pMerge(out, returns[target])
+			} else if id, ok := x.Fun.(*ast.Ident); ok {
+				if _, builtin := pp.typed.info.ObjectOf(id).(*types.Builtin); builtin {
+					for _, arg := range x.Args {
+						f2pMerge(out, eval(f, arg))
+					}
+				}
+			}
+		}
+		return out
+	}
+	add := func(object types.Object, source f2pOrigins) bool {
+		if object == nil {
+			return false
+		}
+		if values[object] == nil {
+			values[object] = f2pOrigins{}
+		}
+		return f2pMerge(values[object], source)
+	}
+	for changed := true; changed; {
+		changed = false
+		for _, f := range functions {
+			ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+				switch s := n.(type) {
+				case *ast.AssignStmt:
+					for i, lhs := range s.Lhs {
+						if id, ok := lhs.(*ast.Ident); ok && i < len(s.Rhs) {
+							changed = add(pp.typed.info.ObjectOf(id), eval(f, s.Rhs[i])) || changed
+						}
+					}
+				case *ast.ValueSpec:
+					for i, id := range s.Names {
+						if i < len(s.Values) {
+							changed = add(pp.typed.info.ObjectOf(id), eval(f, s.Values[i])) || changed
+						}
+					}
+				case *ast.ReturnStmt:
+					for _, e := range s.Results {
+						changed = f2pMerge(returns[f], eval(f, e)) || changed
+					}
+				case *ast.CallExpr:
+					if target := pp.target(s.Fun); target != nil {
+						var parameters []*ast.Ident
+						for _, field := range target.decl.Type.Params.List {
+							parameters = append(parameters, field.Names...)
+						}
+						for i, arg := range s.Args {
+							if i < len(parameters) {
+								changed = add(pp.typed.info.ObjectOf(parameters[i]), eval(f, arg)) || changed
+							}
+						}
+					}
+				}
+				return true
+			})
+		}
+	}
+	written, coordinates := f2pOrigins{}, f2pOrigins{}
+	unsupported := false
+	for _, f := range functions {
+		ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+			if c, ok := n.(*ast.CompositeLit); ok && f2pTypeName(c.Type) == "gridCoord" {
+				f2pMerge(coordinates, eval(f, c))
+			}
+			var lhs []ast.Expr
+			switch s := n.(type) {
+			case *ast.AssignStmt:
+				lhs = s.Lhs
+			case *ast.IncDecStmt:
+				lhs = []ast.Expr{s.X}
+			}
+			for _, e := range lhs {
+				if index, ok := e.(*ast.IndexExpr); ok && f2pNumericCollection(pp.typed.info.TypeOf(index.X)) {
+					if origin, ok := resolvers[f](index.X); ok {
+						written[origin] = true
+					} else {
+						unsupported = true
+					}
+				}
+			}
+			return true
+		})
+	}
+	for origin := range coordinates {
+		if written[origin] && origin.owner != entry {
+			return true, unsupported
+		}
+	}
+	return false, unsupported
+}
+
+// A root split can return a collection of private group records instead of
+// two separate node slices. P2P verifies actual membership and level offsets.
+func (pp *f2pPackage) rootGroupCollection(typ types.Type) bool {
+	if typ == nil {
+		return false
+	}
+	for {
+		ptr, ok := typ.(*types.Pointer)
+		if !ok {
+			break
+		}
+		typ = ptr.Elem()
+	}
+	var element types.Type
+	switch collection := typ.Underlying().(type) {
+	case *types.Slice:
+		element = collection.Elem()
+	case *types.Array:
+		element = collection.Elem()
+	case *types.Map:
+		element = collection.Elem()
+	default:
+		return false
+	}
+	var hasGroup func(types.Type, map[types.Type]bool) bool
+	hasGroup = func(t types.Type, seen map[types.Type]bool) bool {
+		if seen[t] {
+			return false
+		}
+		seen[t] = true
+		defer delete(seen, t)
+		if ptr, ok := t.(*types.Pointer); ok {
+			return hasGroup(ptr.Elem(), seen)
+		}
+		if named, ok := t.(*types.Named); ok && named.Obj().Name() == "node" {
+			return false
+		}
+		switch value := t.Underlying().(type) {
+		case *types.Slice:
+			e := value.Elem()
+			if ptr, ok := e.(*types.Pointer); ok {
+				e = ptr.Elem()
+			}
+			named, ok := e.(*types.Named)
+			return ok && named.Obj().Name() == "node"
+		case *types.Struct:
+			for i := 0; i < value.NumFields(); i++ {
+				if hasGroup(value.Field(i).Type(), seen) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	return hasGroup(element, map[types.Type]bool{})
+}
