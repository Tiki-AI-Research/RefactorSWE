+func p2pParseGoMod(raw string) (module string, goVersion string, requires []string) {
+	inRequireBlock := false
+	for _, line := range strings.Split(raw, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "//") {
+			continue
+		}
+		if strings.HasPrefix(line, "module ") {
+			module = strings.TrimSpace(strings.TrimPrefix(line, "module "))
+			continue
+		}
+		if strings.HasPrefix(line, "go ") {
+			goVersion = strings.TrimSpace(strings.TrimPrefix(line, "go "))
+			continue
+		}
+		if strings.HasPrefix(line, "require (") {
+			inRequireBlock = true
+			continue
+		}
+		if inRequireBlock && line == ")" {
+			inRequireBlock = false
+			continue
+		}
+		if strings.HasPrefix(line, "require ") {
+			requires = append(requires, p2pRequirePath(strings.TrimSpace(strings.TrimPrefix(line, "require "))))
+			continue
+		}
+		if inRequireBlock {
+			requires = append(requires, p2pRequirePath(line))
+		}
+	}
+	sort.Strings(requires)
+	return module, goVersion, requires
+}
+
+func p2pRequirePath(line string) string {
+	fields := strings.Fields(line)
+	if len(fields) == 0 {
+		return ""
+	}
+	return fields[0]
+}
