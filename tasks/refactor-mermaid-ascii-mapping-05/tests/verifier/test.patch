new file mode 100644
index 0000000000000000000000000000000000000000..546b5567fa835bc8a4347444ff8381f410b94af8
--- /dev/null
+++ b/cmd/p2p_cli_contract_test.go
@@ -0,0 +1,201 @@
+package cmd_test
+
+// Supplemental P2P contract tests for the command line entry point.
+//
+// The mapping refactor must not disturb the CLI surface: the same flags keep
+// their names, defaults and meanings, the diagram still arrives on stdin or
+// through --file/-f, and failures keep surfacing as non-zero exits with a
+// diagnostic. The expected text is produced through the frozen public graph
+// API, so the test pins CLI <-> library equivalence without depending on
+// mapping internals.
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/AlexanderGrooff/mermaid-ascii/pkg/diagram"
+	"github.com/AlexanderGrooff/mermaid-ascii/pkg/graph"
+)
+
+const p2pCLISource = "graph LR\nA --> B\n"
+
+func p2pCLIModuleRoot(t *testing.T) string {
+	t.Helper()
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Getwd() error = %v", err)
+	}
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatalf("go.mod not found above %s", dir)
+		}
+		dir = parent
+	}
+}
+
+func p2pBuildCLI(t *testing.T) string {
+	t.Helper()
+	root := p2pCLIModuleRoot(t)
+	dir := os.Getenv("VERIFIER_EXEC_DIR")
+	if dir == "" {
+		dir = t.TempDir()
+	}
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatalf("MkdirAll(%s) error = %v", dir, err)
+	}
+	binary := filepath.Join(dir, "mermaid-ascii-p2p")
+	build := exec.Command("go", "build", "-o", binary, "github.com/AlexanderGrooff/mermaid-ascii")
+	build.Dir = root
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("go build failed: %v\n%s", err, out)
+	}
+	return binary
+}
+
+type p2pCLIResult struct {
+	stdout string
+	stderr string
+	exit   int
+}
+
+func p2pRunCLI(t *testing.T, binary string, stdin string, args ...string) p2pCLIResult {
+	t.Helper()
+	command := exec.Command(binary, args...)
+	command.Stdin = strings.NewReader(stdin)
+	var stdout, stderr strings.Builder
+	command.Stdout = &stdout
+	command.Stderr = &stderr
+	err := command.Run()
+	exit := 0
+	if err != nil {
+		var exitErr *exec.ExitError
+		if !errors.As(err, &exitErr) {
+			t.Fatalf("running %v: %v", command.Args, err)
+		}
+		exit = exitErr.ExitCode()
+	}
+	return p2pCLIResult{stdout: stdout.String(), stderr: stderr.String(), exit: exit}
+}
+
+func p2pExpectedGraphOutput(t *testing.T, source string, ascii, coords bool, borderPadding, paddingX, paddingY int) string {
+	t.Helper()
+	properties, err := graph.Parse(source, "cli")
+	if err != nil {
+		t.Fatalf("Parse() error = %v", err)
+	}
+	config := &diagram.Config{
+		UseAscii:         ascii,
+		ShowCoords:       coords,
+		BoxBorderPadding: borderPadding,
+		PaddingBetweenX:  paddingX,
+		PaddingBetweenY:  paddingY,
+		StyleType:        "cli",
+	}
+	properties.Apply(config)
+	return graph.Draw(properties)
+}
+
+func TestP2PCLIFlagContractAndRendering(t *testing.T) {
+	binary := p2pBuildCLI(t)
+
+	cases := []struct {
+		name          string
+		args          []string
+		ascii         bool
+		coords        bool
+		borderPadding int
+		paddingX      int
+		paddingY      int
+	}{
+		{name: "defaults", args: nil, borderPadding: 1, paddingX: 5, paddingY: 5},
+		{name: "ascii-short", args: []string{"-a"}, ascii: true, borderPadding: 1, paddingX: 5, paddingY: 5},
+		{name: "ascii-long", args: []string{"--ascii"}, ascii: true, borderPadding: 1, paddingX: 5, paddingY: 5},
+		{name: "coords-short", args: []string{"-c"}, coords: true, borderPadding: 1, paddingX: 5, paddingY: 5},
+		{name: "coords-long", args: []string{"--coords"}, coords: true, borderPadding: 1, paddingX: 5, paddingY: 5},
+		{name: "padding-short", args: []string{"-x", "2", "-y", "3"}, borderPadding: 1, paddingX: 2, paddingY: 3},
+		{name: "padding-long", args: []string{"--paddingX=2", "--paddingY=3"}, borderPadding: 1, paddingX: 2, paddingY: 3},
+		{name: "border-short", args: []string{"-p", "2"}, borderPadding: 2, paddingX: 5, paddingY: 5},
+		{name: "border-long", args: []string{"--borderPadding=2"}, borderPadding: 2, paddingX: 5, paddingY: 5},
+		{name: "max-width", args: []string{"--max-width", "400"}, borderPadding: 1, paddingX: 5, paddingY: 5},
+		{
+			name:          "combined",
+			args:          []string{"-a", "-c", "-x", "1", "-y", "2", "-p", "2"},
+			ascii:         true,
+			coords:        true,
+			borderPadding: 2,
+			paddingX:      1,
+			paddingY:      2,
+		},
+	}
+
+	for _, tc := range cases {
+		result := p2pRunCLI(t, binary, p2pCLISource, tc.args...)
+		if result.exit != 0 {
+			t.Errorf("%s: exit = %d, want 0 (stderr: %s)", tc.name, result.exit, result.stderr)
+			continue
+		}
+		want := p2pExpectedGraphOutput(t, p2pCLISource, tc.ascii, tc.coords, tc.borderPadding, tc.paddingX, tc.paddingY)
+		if result.stdout != want {
+			t.Errorf("%s: CLI output diverged from the graph API\nwant:\n%s\ngot:\n%s", tc.name, want, result.stdout)
+		}
+		if result.stderr != "" {
+			t.Errorf("%s: unexpected stderr: %s", tc.name, result.stderr)
+		}
+	}
+
+	filePath := filepath.Join(t.TempDir(), "diagram.mmd")
+	if err := os.WriteFile(filePath, []byte(p2pCLISource), 0o644); err != nil {
+		t.Fatalf("WriteFile() error = %v", err)
+	}
+	wantFile := p2pExpectedGraphOutput(t, p2pCLISource, false, false, 1, 5, 5)
+	for _, args := range [][]string{
+		{"-f", filePath},
+		{"--file", filePath},
+		{"-f", "-"},
+		{"--file", "-"},
+	} {
+		result := p2pRunCLI(t, binary, p2pCLISource, args...)
+		if result.exit != 0 {
+			t.Errorf("file args %v: exit = %d, want 0 (stderr: %s)", args, result.exit, result.stderr)
+			continue
+		}
+		if result.stdout != wantFile {
+			t.Errorf("file args %v: CLI output diverged from the graph API\nwant:\n%s\ngot:\n%s", args, wantFile, result.stdout)
+		}
+	}
+}
+
+func TestP2PCLIErrorExitStatusAndDiagnostics(t *testing.T) {
+	binary := p2pBuildCLI(t)
+
+	cases := []struct {
+		name  string
+		stdin string
+		args  []string
+	}{
+		{name: "invalid graph", stdin: "not a diagram\n"},
+		{name: "unknown flag", stdin: p2pCLISource, args: []string{"--definitely-not-a-flag"}},
+		{name: "invalid max width", stdin: p2pCLISource, args: []string{"--max-width", "bogus"}},
+		{name: "zero max width", stdin: p2pCLISource, args: []string{"--max-width", "0"}},
+		{name: "negative padding", stdin: p2pCLISource, args: []string{"--paddingX=-3"}},
+		{name: "missing file", stdin: "", args: []string{"-f", "/definitely/not/here/diagram.mmd"}},
+	}
+
+	for _, tc := range cases {
+		result := p2pRunCLI(t, binary, tc.stdin, tc.args...)
+		if result.exit == 0 {
+			t.Errorf("%s: exit = 0, want non-zero", tc.name)
+		}
+		if strings.TrimSpace(result.stderr) == "" {
+			t.Errorf("%s: stderr is empty, want a diagnostic", tc.name)
+		}
+	}
+}
diff --git a/pkg/graph/f2p_mapping_structure_test.go b/pkg/graph/f2p_mapping_structure_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..97e751bf8f2d1c0bd9b67c97afd33d49c78c8828
--- /dev/null
+++ b/pkg/graph/f2p_mapping_structure_test.go
@@ -0,0 +1,1172 @@
+package graph_test
+
+// F2P structural acceptance tests for the layout-mapping phase decomposition.
+//
+// The frozen requirement set (REQ-STRUCT-001 .. REQ-STRUCT-003) demands that
+// the mapping phase be separated into dedicated units that own the state each
+// step needs and that the mapping entry point (`createMapping`) become a short
+// orchestration of ordered steps instead of a container of layout logic. The
+// rendered behaviour is pinned by the P2P gates; these tests pin the structure,
+// which is the part of the contract the Baseline cannot satisfy while its
+// entry point is a 150-line interleaved routine.
+//
+// Every test parses the non-test sources of this package and asserts one
+// observable structural property of the mapping phase reached from its entry
+// point. Ownership is derived from delegation calls and state effects rather
+// than helper names, so internal helpers may be freely renamed, split or
+// recombined as long as the required responsibilities stay with dedicated,
+// separately reachable units.
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"go/types"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// ---------------------------------------------------------------------------
+// source analysis
+// ---------------------------------------------------------------------------
+
+type f2pFunc struct {
+	name  string
+	recv  string
+	file  string
+	decl  *ast.FuncDecl
+	lines int
+}
+
+type f2pField struct {
+	name string
+	typ  ast.Expr
+}
+
+var f2pLoadMu sync.Mutex
+var f2pLoadedPackage *f2pPackage
+
+type f2pPackage struct {
+	dir     string
+	t       *testing.T
+	typed   *f2pTyped
+	fset    *token.FileSet
+	funcs   []*f2pFunc
+	byName  map[string][]*f2pFunc
+	structs map[string][]f2pField
+	types   map[string]ast.Expr
+	entry   *f2pFunc
+}
+
+func f2pPackageDir(t *testing.T) string {
+	t.Helper()
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("cannot locate the F2P test source file")
+	}
+	return filepath.Dir(file)
+}
+
+// f2pLoad parses every non-test Go file of the package that contains this
+// test file and indexes its functions, methods and struct types.
+func f2pLoad(t *testing.T) *f2pPackage {
+	f2pLoadMu.Lock()
+	defer f2pLoadMu.Unlock()
+	if f2pLoadedPackage != nil {
+		f2pLoadedPackage.t = t
+		return f2pLoadedPackage
+	}
+	var sourceFiles []*ast.File
+	t.Helper()
+	dir := f2pPackageDir(t)
+	fset := token.NewFileSet()
+	pkgs, err := parser.ParseDir(fset, dir, nil, 0)
+	if err != nil {
+		t.Fatalf("cannot parse package sources in %s: %v", dir, err)
+	}
+	pp := &f2pPackage{dir: dir, t: t, fset: fset, byName: map[string][]*f2pFunc{}, structs: map[string][]f2pField{}, types: map[string]ast.Expr{}}
+	for name, pkg := range pkgs {
+		if strings.HasSuffix(name, "_test") {
+			continue
+		}
+		for fname, f := range pkg.Files {
+			if strings.HasSuffix(fname, "_test.go") {
+				continue
+			}
+			sourceFiles = append(sourceFiles, f)
+			for _, d := range f.Decls {
+				switch decl := d.(type) {
+				case *ast.FuncDecl:
+					if decl.Body == nil {
+						continue
+					}
+					pf := &f2pFunc{name: decl.Name.Name, recv: f2pRecvType(decl), file: filepath.Base(fname), decl: decl}
+					pf.lines = fset.Position(decl.Body.Rbrace).Line - fset.Position(decl.Body.Lbrace).Line - 1
+					if pf.lines < 0 {
+						pf.lines = 0
+					}
+					pp.funcs = append(pp.funcs, pf)
+					pp.byName[pf.name] = append(pp.byName[pf.name], pf)
+				case *ast.GenDecl:
+					if decl.Tok != token.TYPE {
+						continue
+					}
+					for _, spec := range decl.Specs {
+						ts, ok := spec.(*ast.TypeSpec)
+						if !ok {
+							continue
+						}
+						pp.types[ts.Name.Name] = ts.Type
+						st, ok := ts.Type.(*ast.StructType)
+						if !ok {
+							continue
+						}
+						var fields []f2pField
+						for _, fl := range st.Fields.List {
+							for _, nm := range fl.Names {
+								fields = append(fields, f2pField{name: nm.Name, typ: fl.Type})
+							}
+						}
+						pp.structs[ts.Name.Name] = fields
+					}
+				}
+			}
+		}
+	}
+	if len(pp.funcs) == 0 {
+		t.Fatalf("no Go functions found in %s", dir)
+	}
+	pp.loadTypes(sourceFiles)
+	pp.entry = pp.findEntry()
+	f2pLoadedPackage = pp
+	return pp
+}
+
+func f2pRecvType(fd *ast.FuncDecl) string {
+	if fd.Recv == nil || len(fd.Recv.List) == 0 {
+		return ""
+	}
+	return f2pTypeName(fd.Recv.List[0].Type)
+}
+
+func f2pTypeName(e ast.Expr) string {
+	switch x := e.(type) {
+	case *ast.StarExpr:
+		return f2pTypeName(x.X)
+	case *ast.Ident:
+		return x.Name
+	case *ast.SelectorExpr:
+		return x.Sel.Name
+	case *ast.ArrayType:
+		return "[]" + f2pTypeName(x.Elt)
+	case *ast.MapType:
+		return "map[" + f2pTypeName(x.Key) + "]" + f2pTypeName(x.Value)
+	}
+	return ""
+}
+
+// findEntry locates the mapping entry point. The phase entry point is
+// `createMapping` in every known decomposition; when it is renamed, the entry
+// point is recovered as the method called from `Draw` whose call chain
+// mutates node grid placement state.
+func (pp *f2pPackage) findEntry() *f2pFunc {
+	var named []*f2pFunc
+	for _, f := range pp.byName["createMapping"] {
+		if f.recv == "graph" {
+			named = append(named, f)
+		}
+	}
+	if len(named) == 1 {
+		return named[0]
+	}
+	if len(named) > 1 {
+		return named[0]
+	}
+	for _, draw := range pp.byName["Draw"] {
+		for name := range pp.callsIn(draw.decl.Body) {
+			for _, cand := range pp.byName[name] {
+				for _, reached := range pp.closure(cand) {
+					if f2pAssignsSelector(reached.decl.Body, "gridCoord") {
+						return cand
+					}
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func (pp *f2pPackage) callsIn(n ast.Node) map[string]bool {
+	return pp.typedCalls(n)
+}
+
+// closure returns the roots plus every package unit reachable from them
+// through delegating calls.
+func (pp *f2pPackage) closure(roots ...*f2pFunc) []*f2pFunc {
+	seen := map[*f2pFunc]bool{}
+	var order, frontier []*f2pFunc
+	for _, r := range roots {
+		if !seen[r] {
+			seen[r] = true
+			order = append(order, r)
+			frontier = append(frontier, r)
+		}
+	}
+	for len(frontier) > 0 {
+		var next []*f2pFunc
+		for _, f := range frontier {
+			for name := range pp.callsIn(f.decl.Body) {
+				for _, cf := range pp.byName[name] {
+					if !seen[cf] {
+						seen[cf] = true
+						order = append(order, cf)
+						next = append(next, cf)
+					}
+				}
+			}
+		}
+		frontier = next
+	}
+	return order
+}
+
+// ---------------------------------------------------------------------------
+// AST predicates
+// ---------------------------------------------------------------------------
+
+func f2pWalk(n ast.Node, fn func(ast.Node) bool) {
+	if n == nil {
+		return
+	}
+	ast.Inspect(n, fn)
+}
+
+// f2pAssignsSelector reports an assignment or increment of `x.<field>`.
+func f2pAssignsSelector(n ast.Node, field string) bool {
+	found := false
+	f2pWalk(n, func(x ast.Node) bool {
+		switch st := x.(type) {
+		case *ast.AssignStmt:
+			for _, lhs := range st.Lhs {
+				if sel, ok := lhs.(*ast.SelectorExpr); ok && sel.Sel.Name == field {
+					found = true
+				}
+			}
+		case *ast.IncDecStmt:
+			if sel, ok := st.X.(*ast.SelectorExpr); ok && sel.Sel.Name == field {
+				found = true
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// f2pWritesIndexedSelector reports a map write `x.<field>[...] = ...`, `+=`.
+func f2pWritesIndexedSelector(n ast.Node, field string) bool {
+	found := false
+	f2pWalk(n, func(x ast.Node) bool {
+		as, ok := x.(*ast.AssignStmt)
+		if !ok {
+			return true
+		}
+		for _, lhs := range as.Lhs {
+			idx, ok := lhs.(*ast.IndexExpr)
+			if !ok {
+				continue
+			}
+			if sel, ok := idx.X.(*ast.SelectorExpr); ok && sel.Sel.Name == field {
+				found = true
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// f2pRangesOver reports a `for ... := range x.<field>` loop.
+func f2pRangesOver(n ast.Node, field string) bool {
+	found := false
+	f2pWalk(n, func(x ast.Node) bool {
+		rs, ok := x.(*ast.RangeStmt)
+		if !ok {
+			return true
+		}
+		if sel, ok := rs.X.(*ast.SelectorExpr); ok && sel.Sel.Name == field {
+			found = true
+		}
+		return true
+	})
+	return found
+}
+
+func f2pHasLoop(n ast.Node) bool {
+	found := false
+	f2pWalk(n, func(x ast.Node) bool {
+		switch x.(type) {
+		case *ast.ForStmt, *ast.RangeStmt:
+			found = true
+		}
+		return true
+	})
+	return found
+}
+
+func f2pHasMapType(n ast.Node, key, val string) bool {
+	found := false
+	f2pWalk(n, func(x ast.Node) bool {
+		mt, ok := x.(*ast.MapType)
+		if ok && f2pTypeName(mt.Key) == key && f2pTypeName(mt.Value) == val {
+			found = true
+		}
+		return true
+	})
+	return found
+}
+
+func f2pHasStringLiteral(n ast.Node, lit string) bool {
+	found := false
+	f2pWalk(n, func(x ast.Node) bool {
+		bl, ok := x.(*ast.BasicLit)
+		if ok && bl.Kind == token.STRING && bl.Value == `"`+lit+`"` {
+			found = true
+		}
+		return true
+	})
+	return found
+}
+
+func f2pAppendCount(n ast.Node) int {
+	c := 0
+	f2pWalk(n, func(x ast.Node) bool {
+		if id, ok := x.(*ast.Ident); ok && id.Name == "append" {
+			c++
+		}
+		return true
+	})
+	return c
+}
+
+func f2pCallsAny(n ast.Node, names ...string) bool {
+	set := map[string]bool{}
+	for _, n := range names {
+		set[n] = true
+	}
+	found := false
+	f2pWalk(n, func(x ast.Node) bool {
+		ce, ok := x.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		switch fn := ce.Fun.(type) {
+		case *ast.Ident:
+			if set[fn.Name] {
+				found = true
+			}
+		case *ast.SelectorExpr:
+			if set[fn.Sel.Name] {
+				found = true
+			}
+		}
+		return true
+	})
+	return found
+}
+
+func f2pCallNames(n ast.Node) []string {
+	set := map[string]bool{}
+	f2pWalk(n, func(x ast.Node) bool {
+		ce, ok := x.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		switch fn := ce.Fun.(type) {
+		case *ast.Ident:
+			set[fn.Name] = true
+		case *ast.SelectorExpr:
+			set[fn.Sel.Name] = true
+		}
+		return true
+	})
+	out := make([]string, 0, len(set))
+	for k := range set {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func f2pResultTypeNames(f *f2pFunc) []string {
+	var out []string
+	if f.decl.Type.Results == nil {
+		return out
+	}
+	for _, r := range f.decl.Type.Results.List {
+		out = append(out, f2pTypeName(r.Type))
+	}
+	return out
+}
+
+func f2pReturnsNodeSlice(f *f2pFunc) bool {
+	for _, r := range f2pResultTypeNames(f) {
+		if r == "[]*node" || r == "[]node" {
+			return true
+		}
+	}
+	return false
+}
+
+func (pp *f2pPackage) f2pStructNodeSliceFields(typ string) []string {
+	var out []string
+	for _, fld := range pp.structs[typ] {
+		if f2pTypeName(fld.typ) == "[]*node" || f2pTypeName(fld.typ) == "[]node" {
+			out = append(out, fld.name)
+		}
+	}
+	return out
+}
+
+// f2pStoresNodeGroup reports that the unit stores a node collection in its own
+// state or in a local slice, in addition to returning one.
+func (pp *f2pPackage) f2pStoresNodeGroup(f *f2pFunc) bool {
+	stored := false
+	ownFields := map[string]bool{}
+	for _, n := range pp.f2pStructNodeSliceFields(f.recv) {
+		ownFields[n] = true
+	}
+	f2pWalk(f.decl.Body, func(x ast.Node) bool {
+		as, ok := x.(*ast.AssignStmt)
+		if !ok {
+			return true
+		}
+		for _, lhs := range as.Lhs {
+			if sel, ok := lhs.(*ast.SelectorExpr); ok && ownFields[sel.Sel.Name] {
+				stored = true
+			}
+		}
+		for _, rhs := range as.Rhs {
+			if cl, ok := rhs.(*ast.CompositeLit); ok {
+				if f2pTypeName(cl.Type) == "[]*node" || f2pTypeName(cl.Type) == "[]node" {
+					stored = true
+				}
+			}
+		}
+		return true
+	})
+	return stored
+}
+
+// f2pLocalCollections lists local variables declared as maps or slices.
+func f2pLocalCollections(n ast.Node) []string {
+	var out []string
+	f2pWalk(n, func(x ast.Node) bool {
+		switch st := x.(type) {
+		case *ast.AssignStmt:
+			if len(st.Lhs) != len(st.Rhs) {
+				return true
+			}
+			for i, lhs := range st.Lhs {
+				id, ok := lhs.(*ast.Ident)
+				if !ok {
+					continue
+				}
+				switch rhs := st.Rhs[i].(type) {
+				case *ast.CompositeLit:
+					switch rhs.Type.(type) {
+					case *ast.ArrayType, *ast.MapType:
+						out = append(out, id.Name)
+					}
+				case *ast.CallExpr:
+					if fn, ok := rhs.Fun.(*ast.Ident); ok && (fn.Name == "make" || fn.Name == "new") && len(rhs.Args) > 0 {
+						switch rhs.Args[0].(type) {
+						case *ast.ArrayType, *ast.MapType:
+							out = append(out, id.Name)
+						}
+					}
+				}
+			}
+		case *ast.DeclStmt:
+			gd, ok := st.Decl.(*ast.GenDecl)
+			if !ok {
+				return true
+			}
+			for _, spec := range gd.Specs {
+				vs, ok := spec.(*ast.ValueSpec)
+				if !ok {
+					continue
+				}
+				for i, nm := range vs.Names {
+					if len(vs.Values) > i {
+						if cl, ok := vs.Values[i].(*ast.CompositeLit); ok {
+							switch cl.Type.(type) {
+							case *ast.ArrayType, *ast.MapType:
+								out = append(out, nm.Name)
+							}
+						}
+					} else if vs.Type != nil {
+						switch vs.Type.(type) {
+						case *ast.ArrayType, *ast.MapType:
+							out = append(out, nm.Name)
+						}
+					}
+				}
+			}
+		}
+		return true
+	})
+	return out
+}
+
+func (pp *f2pPackage) f2pUnderlyingType(name string) ast.Expr {
+	seen := map[string]bool{}
+	for !seen[name] {
+		seen[name] = true
+		declaration := pp.types[name]
+		if alias, ok := declaration.(*ast.Ident); ok {
+			name = alias.Name
+			continue
+		}
+		return declaration
+	}
+	return nil
+}
+
+func (pp *f2pPackage) f2pIsStateType(name string) bool {
+	declaration := pp.f2pUnderlyingType(name)
+	if name == "graph" || declaration == pp.types["graph"] {
+		return false
+	}
+	switch declaration.(type) {
+	case *ast.StructType, *ast.MapType:
+		return true
+	}
+	return false
+}
+
+func (pp *f2pPackage) f2pStateInitializerType(expression ast.Expr) string {
+	var name string
+	switch value := expression.(type) {
+	case *ast.UnaryExpr:
+		if value.Op == token.AND {
+			return pp.f2pStateInitializerType(value.X)
+		}
+	case *ast.ParenExpr:
+		return pp.f2pStateInitializerType(value.X)
+	case *ast.CompositeLit:
+		name = f2pTypeName(value.Type)
+	case *ast.CallExpr:
+		if function, ok := value.Fun.(*ast.Ident); ok {
+			if (function.Name == "make" || function.Name == "new") && len(value.Args) > 0 {
+				name = f2pTypeName(value.Args[0])
+			} else if pp.f2pIsStateType(function.Name) {
+				name = function.Name
+			} else {
+				for _, constructor := range pp.byName[function.Name] {
+					for _, result := range f2pResultTypeNames(constructor) {
+						if pp.f2pIsStateType(result) {
+							name = result
+						}
+					}
+				}
+			}
+		}
+	}
+	if pp.f2pIsStateType(name) {
+		return name
+	}
+	return ""
+}
+
+// f2pStateHolders returns the locals of the entry point that are initialised
+// as dedicated package state types, including named maps, other than `graph`.
+func (pp *f2pPackage) f2pStateHolders(f *f2pFunc) []string {
+	var out []string
+	f2pWalk(f.decl.Body, func(x ast.Node) bool {
+		switch declaration := x.(type) {
+		case *ast.AssignStmt:
+			if len(declaration.Lhs) == len(declaration.Rhs) {
+				for index, expression := range declaration.Rhs {
+					if name, ok := declaration.Lhs[index].(*ast.Ident); ok && pp.f2pStateInitializerType(expression) != "" {
+						out = append(out, name.Name)
+					}
+				}
+			}
+		case *ast.ValueSpec:
+			if len(declaration.Names) == len(declaration.Values) {
+				for index, expression := range declaration.Values {
+					if pp.f2pStateInitializerType(expression) != "" {
+						out = append(out, declaration.Names[index].Name)
+					}
+				}
+			}
+		}
+		return true
+	})
+	return out
+}
+
+// f2pUsesInCalls counts call sites in the entry point that use name as the
+// receiver or as an argument - the steps that share the state holder.
+func f2pUsesInCalls(f *f2pFunc, name string) int {
+	count := 0
+	f2pWalk(f.decl.Body, func(x ast.Node) bool {
+		ce, ok := x.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		used := false
+		if sel, ok := ce.Fun.(*ast.SelectorExpr); ok {
+			if f2pRootIdentifier(sel.X) == name {
+				used = true
+			}
+		}
+		for _, a := range ce.Args {
+			if id, ok := a.(*ast.Ident); ok && id.Name == name {
+				used = true
+			}
+		}
+		if used {
+			count++
+		}
+		return true
+	})
+	return count
+}
+
+func (pp *f2pPackage) f2pIsLevelMapType(name string) bool {
+	if name == "map[int]int" {
+		return true
+	}
+	levelMap, ok := pp.f2pUnderlyingType(name).(*ast.MapType)
+	return ok && f2pTypeName(levelMap.Key) == "int" && f2pTypeName(levelMap.Value) == "int"
+}
+
+func (pp *f2pPackage) f2pHasMapIntIntField(typ string) bool {
+	for _, fld := range pp.structs[typ] {
+		if pp.f2pIsLevelMapType(f2pTypeName(fld.typ)) {
+			return true
+		}
+	}
+	return false
+}
+
+// f2pOwnerTypesWithLevelMap returns the struct types a unit owns - through its
+// receiver or through a parameter - that carry map[int]int level bookkeeping.
+func (pp *f2pPackage) f2pOwnerTypesWithLevelMap(f *f2pFunc) []string {
+	var out []string
+	if f.recv != "" && f.recv != "graph" && pp.f2pHasMapIntIntField(f.recv) {
+		out = append(out, f.recv)
+	}
+	if f.decl.Type.Params != nil {
+		for _, p := range f.decl.Type.Params.List {
+			tn := f2pTypeName(p.Type)
+			if tn == "graph" {
+				continue
+			}
+			if pp.f2pHasMapIntIntField(tn) {
+				out = append(out, tn)
+			}
+		}
+	}
+	return out
+}
+
+func f2pMapBinding(expression ast.Expr) *ast.Ident {
+	for {
+		switch value := expression.(type) {
+		case *ast.Ident:
+			return value
+		case *ast.ParenExpr:
+			expression = value.X
+		case *ast.StarExpr:
+			expression = value.X
+		default:
+			return nil
+		}
+	}
+}
+
+func f2pIndexedBinding(expression ast.Expr) *ast.Ident {
+	for {
+		if parenthesized, ok := expression.(*ast.ParenExpr); ok {
+			expression = parenthesized.X
+			continue
+		}
+		if index, ok := expression.(*ast.IndexExpr); ok {
+			return f2pMapBinding(index.X)
+		}
+		return nil
+	}
+}
+
+func (pp *f2pPackage) f2pWritesNamedLevelMap(f *f2pFunc) bool {
+	owners := map[*ast.Object]bool{}
+	for _, fields := range []*ast.FieldList{f.decl.Recv, f.decl.Type.Params} {
+		if fields == nil {
+			continue
+		}
+		for _, field := range fields.List {
+			name := f2pTypeName(field.Type)
+			if pp.f2pIsStateType(name) && pp.f2pIsLevelMapType(name) {
+				for _, binding := range field.Names {
+					if binding.Obj != nil {
+						owners[binding.Obj] = true
+					}
+				}
+			}
+		}
+	}
+	found := false
+	checkWrite := func(expression ast.Expr) {
+		if binding := f2pIndexedBinding(expression); binding != nil && owners[binding.Obj] {
+			found = true
+		}
+	}
+	updateBindings := func(names []*ast.Ident, expressions []ast.Expr) {
+		shared := make([]bool, len(names))
+		if len(names) == len(expressions) {
+			for index, expression := range expressions {
+				if binding := f2pMapBinding(expression); binding != nil {
+					shared[index] = owners[binding.Obj]
+				}
+			}
+		}
+		for index, name := range names {
+			if name != nil && name.Obj != nil {
+				owners[name.Obj] = shared[index]
+			}
+		}
+	}
+	f2pWalk(f.decl.Body, func(node ast.Node) bool {
+		switch statement := node.(type) {
+		case *ast.AssignStmt:
+			names := make([]*ast.Ident, len(statement.Lhs))
+			for index, expression := range statement.Lhs {
+				checkWrite(expression)
+				names[index], _ = expression.(*ast.Ident)
+			}
+			if statement.Tok == token.ASSIGN || statement.Tok == token.DEFINE {
+				updateBindings(names, statement.Rhs)
+			}
+		case *ast.ValueSpec:
+			updateBindings(statement.Names, statement.Values)
+		case *ast.IncDecStmt:
+			checkWrite(statement.X)
+		}
+		return true
+	})
+	return found
+}
+
+func f2pLabelDependent(n ast.Node) bool {
+	found := false
+	f2pWalk(n, func(x ast.Node) bool {
+		switch v := x.(type) {
+		case *ast.SelectorExpr:
+			if v.Sel.Name == "label" {
+				found = true
+			}
+		case *ast.CallExpr:
+			switch fn := v.Fun.(type) {
+			case *ast.Ident:
+				if fn.Name == "contentHeight" {
+					found = true
+				}
+			case *ast.SelectorExpr:
+				if fn.Sel.Name == "contentHeight" {
+					found = true
+				}
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// ---------------------------------------------------------------------------
+// responsibility ownership
+// ---------------------------------------------------------------------------
+
+// f2pOwnsRootIdentification reports whether a unit identifies the graph's
+// roots: it scans the graph's nodes and keeps the ones that are not children
+// of an earlier node, either by returning them or by storing them in its own
+// node collection.
+func (pp *f2pPackage) f2pOwnsRootIdentification(f *f2pFunc) bool {
+	b := f.decl.Body
+	if !f2pRangesOver(b, "nodes") {
+		return false
+	}
+	if !f2pCallsAny(b, "getChildren") && !f2pHasMapType(b, "string", "bool") {
+		return false
+	}
+	return f2pReturnsNodeSlice(f) || (pp.f2pStoresNodeGroup(f) && f2pAppendCount(b) > 0)
+}
+
+// f2pOwnsRootSeparation reports whether a unit decides and performs the
+// external/subgraph root split for LR layouts: it consults subgraph membership,
+// compares the layout direction with "LR" and produces two node groups.
+func (pp *f2pPackage) f2pOwnsRootSeparation(f *f2pFunc) bool {
+
+	lr, membership, groups := false, false, false
+	for _, unit := range pp.closure(f) {
+		lr = lr || f2pHasStringLiteral(unit.decl.Body, "LR")
+		membership = membership || f2pRangesOver(unit.decl.Body, "subgraphs")
+	}
+	outputs := 0
+	if f.decl.Type.Results != nil {
+		for _, field := range f.decl.Type.Results.List {
+			typ := f2pTypeName(field.Type)
+			if typ == "[]node" || typ == "[]*node" {
+				n := len(field.Names)
+				if n == 0 {
+					n = 1
+				}
+				outputs += n
+			}
+			if pp.rootGroupCollection(pp.typed.info.TypeOf(field.Type)) || len(pp.f2pStructNodeSliceFields(typ)) >= 2 {
+				groups = true
+			}
+		}
+	}
+	groups = groups || outputs >= 2 || len(pp.f2pStructNodeSliceFields(f.recv)) >= 2
+	return lr && membership && groups
+
+}
+
+func f2pOwnsPlacement(f *f2pFunc) bool {
+	return f2pAssignsSelector(f.decl.Body, "gridCoord") || f2pWritesIndexedSelector(f.decl.Body, "grid")
+}
+
+func f2pOwnsSizing(f *f2pFunc) bool {
+	return f2pWritesIndexedSelector(f.decl.Body, "columnWidth") || f2pWritesIndexedSelector(f.decl.Body, "rowHeight")
+}
+
+func f2pOwnsEdgeFinalization(f *f2pFunc) bool {
+	return f2pAssignsSelector(f.decl.Body, "path") || f2pAssignsSelector(f.decl.Body, "labelLine")
+}
+
+func f2pOwnsDrawingConversion(f *f2pFunc) bool {
+	return f2pAssignsSelector(f.decl.Body, "drawingCoord")
+}
+
+// f2pReaches reports whether want is performed by the unit itself or by any
+// unit it delegates to.
+func (pp *f2pPackage) f2pReaches(f *f2pFunc, want func(*f2pFunc) bool) bool {
+	if want(f) {
+		return true
+	}
+	for _, c := range pp.closure(f) {
+		if c != f && want(c) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// F2P checks
+// ---------------------------------------------------------------------------
+
+func f2pEntry(t *testing.T, pp *f2pPackage) *f2pFunc {
+	t.Helper()
+	if pp.entry == nil {
+		t.Fatalf("mapping entry point not found: no `createMapping` method and no Draw callee that mutates node grid placement state")
+	}
+	return pp.entry
+}
+
+// TestF2PMappingEntryPointIsShortOrchestration - REQ-STRUCT-003: the mapping
+// entry point must be a short orchestration, not a container of layout logic.
+
+// TestF2PMappingEntryPointHasNoLayoutLoops - REQ-STRUCT-003: the entry point
+// sequences steps; iterating nodes or edges to lay them out is layout logic.
+func TestF2PMappingEntryPointHasNoLayoutLoops(t *testing.T) {
+
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	f2pWalk(entry.decl.Body, func(n ast.Node) bool {
+		if r, ok := n.(*ast.RangeStmt); ok {
+			typ := pp.typed.info.TypeOf(r.X)
+			if typ != nil {
+				switch collection := typ.Underlying().(type) {
+				case *types.Slice:
+					if _, callback := collection.Elem().Underlying().(*types.Signature); callback {
+						t.Skip("INCONCLUSIVE: callback sequence requires a function-value analysis")
+					}
+				case *types.Array:
+					if _, callback := collection.Elem().Underlying().(*types.Signature); callback {
+						t.Skip("INCONCLUSIVE: callback sequence requires a function-value analysis")
+					}
+				}
+			}
+			t.Errorf("mapping entry iterates layout data instead of invoking dedicated phases")
+		}
+		if _, ok := n.(*ast.ForStmt); ok {
+			t.Skip("INCONCLUSIVE: indexed orchestration loop requires loop/data-flow analysis")
+		}
+		return true
+	})
+	if f2pOwnsPlacement(entry) || f2pOwnsSizing(entry) || f2pOwnsEdgeFinalization(entry) || f2pOwnsDrawingConversion(entry) {
+		t.Errorf("mapping entry performs layout mutations inline")
+	}
+
+}
+
+// TestF2PMappingEntryPointDelegatesLowLevelPrimitives - REQ-STRUCT-003: the
+// entry point must not call the low-level layout primitives inline; it calls
+// the step units that own them.
+func TestF2PMappingEntryPointDelegatesLowLevelPrimitives(t *testing.T) {
+
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	for key := range pp.callsIn(entry.decl.Body) {
+		for _, callee := range pp.byName[key] {
+			for _, field := range callee.decl.Type.Params.List {
+				switch f2pTypeName(field.Type) {
+				case "node", "edge", "gridCoord", "drawingCoord":
+					t.Errorf("mapping entry directly invokes per-entity layout primitive %s; layout entities must be processed by a phase unit", callee.name)
+				}
+			}
+		}
+	}
+
+}
+
+// TestF2PMappingEntryPointOwnsNoCollectionState - REQ-STRUCT-002: the entry
+// point must not declare the mapping bookkeeping collections itself; that
+// hidden shared state has to live with the steps that own it.
+
+// TestF2PMappingEntryPointSharesDedicatedMappingState - REQ-STRUCT-001: the
+// state each step needs must have an explicit owner; the entry point creates
+// that owner and hands it to the steps.
+
+// TestF2PRootIdentificationOwnedByDedicatedUnit - REQ-STRUCT-001: root
+// identification is a dedicated unit reachable from the entry point.
+func TestF2PRootIdentificationOwnedByDedicatedUnit(t *testing.T) {
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	for _, f := range pp.closure(entry) {
+		if f != entry && pp.f2pOwnsRootIdentification(f) {
+			return
+		}
+	}
+	t.Errorf("no dedicated root-identification unit is reachable from mapping entry point %s", entry.name)
+}
+
+// TestF2PRootSeparationOwnedByDedicatedUnit - REQ-STRUCT-001: the
+// external/subgraph root separation for LR layouts is a dedicated unit.
+func TestF2PRootSeparationOwnedByDedicatedUnit(t *testing.T) {
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	for _, f := range pp.closure(entry) {
+		if f != entry && pp.f2pOwnsRootSeparation(f) {
+			return
+		}
+	}
+	t.Errorf("no dedicated external/subgraph root-separation unit is reachable from mapping entry point %s", entry.name)
+}
+
+// TestF2PLevelReservationStateOwnedByDedicatedType - REQ-STRUCT-001: the
+// per-level reservation bookkeeping (level -> next free position) is owned by
+// a dedicated type instead of a local variable of the entry point.
+func TestF2PLevelReservationStateOwnedByDedicatedType(t *testing.T) {
+
+	pp := f2pLoad(t)
+	f2pEntry(t, pp)
+	found, unsupported := pp.reservationState()
+	if found {
+		return
+	}
+	if unsupported {
+		t.Skip("INCONCLUSIVE: reassigned or unresolved numeric collection alias prevents ownership proof")
+	}
+	t.Errorf("no explicit reservation state is both updated and used to construct grid coordinates outside the mapping orchestration")
+
+}
+
+// TestF2PNodePlacementOwnedByDedicatedUnit - REQ-STRUCT-001: node placement on
+// the grid is performed by a dedicated unit, never by the entry point.
+func TestF2PNodePlacementOwnedByDedicatedUnit(t *testing.T) {
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	if f2pOwnsPlacement(entry) {
+		t.Errorf("mapping entry point %s mutates node grid placement state inline", entry.name)
+	}
+	for _, f := range pp.closure(entry) {
+		if f != entry && f2pOwnsPlacement(f) {
+			return
+		}
+	}
+	t.Errorf("no dedicated placement unit mutates node grid state for mapping entry point %s", entry.name)
+}
+
+// TestF2PColumnRowSizingOwnedByLabelAwareUnit - REQ-STRUCT-001: column/row
+// sizing is a dedicated unit that walks the nodes and derives the cell sizes
+// from their label metrics.
+func TestF2PColumnRowSizingOwnedByLabelAwareUnit(t *testing.T) {
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	for _, f := range pp.closure(entry) {
+		if f == entry || !f2pRangesOver(f.decl.Body, "nodes") {
+			continue
+		}
+		for _, c := range append([]*f2pFunc{f}, pp.closure(f)...) {
+			if c == entry {
+				continue
+			}
+			if f2pOwnsSizing(c) && f2pLabelDependent(c.decl.Body) {
+				return
+			}
+		}
+	}
+	t.Errorf("no dedicated column/row sizing unit deriving cell sizes from label metrics is reachable from mapping entry point %s", entry.name)
+}
+
+// TestF2PEdgeFinalizationOwnedByDedicatedUnit - REQ-STRUCT-001: edge path and
+// label-line finalization is a dedicated unit reachable from the entry point.
+func TestF2PEdgeFinalizationOwnedByDedicatedUnit(t *testing.T) {
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	for _, f := range pp.closure(entry) {
+		if f == entry || !f2pRangesOver(f.decl.Body, "edges") {
+			continue
+		}
+		path, label := false, false
+		for _, c := range append([]*f2pFunc{f}, pp.closure(f)...) {
+			if c == entry {
+				continue
+			}
+			if f2pAssignsSelector(c.decl.Body, "path") {
+				path = true
+			}
+			if f2pAssignsSelector(c.decl.Body, "labelLine") {
+				label = true
+			}
+		}
+		if path && label {
+			return
+		}
+	}
+	t.Errorf("no dedicated edge path/label-line finalization unit is reachable from mapping entry point %s", entry.name)
+}
+
+// TestF2PGridToDrawingConversionOwnedByDedicatedUnit - REQ-STRUCT-001: the
+// conversion of finished grid coordinates into drawing coordinates is a
+// dedicated unit reachable from the entry point.
+func TestF2PGridToDrawingConversionOwnedByDedicatedUnit(t *testing.T) {
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	for _, f := range pp.closure(entry) {
+		if f == entry || !f2pRangesOver(f.decl.Body, "nodes") {
+			continue
+		}
+		for _, c := range append([]*f2pFunc{f}, pp.closure(f)...) {
+			if c != entry && f2pOwnsDrawingConversion(c) {
+				return
+			}
+		}
+	}
+	t.Errorf("no dedicated grid-to-drawing conversion unit is reachable from mapping entry point %s", entry.name)
+}
+
+// TestF2PMappingEntryPointBuildsNoCoordinatesInline - REQ-STRUCT-003: the
+// entry point orchestrates; building grid/drawing coordinates belongs to the
+// reservation and conversion units.
+func TestF2PMappingEntryPointBuildsNoCoordinatesInline(t *testing.T) {
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	var literals []string
+	f2pWalk(entry.decl.Body, func(x ast.Node) bool {
+		if cl, ok := x.(*ast.CompositeLit); ok {
+			switch f2pTypeName(cl.Type) {
+			case "gridCoord", "drawingCoord":
+				literals = append(literals, f2pTypeName(cl.Type))
+			}
+		}
+		return true
+	})
+	if len(literals) > 0 {
+		t.Errorf("mapping entry point %s builds coordinate values inline: %v", entry.name, literals)
+	}
+}
+
+// TestF2PMappingStepsCoverResponsibilitiesWithDistinctOwners - REQ-STRUCT-001:
+// the six mapping responsibilities must be owned by the steps the entry point
+// calls, and they must not all be concentrated in the same container unit.
+func TestF2PMappingStepsCoverResponsibilitiesWithDistinctOwners(t *testing.T) {
+	pp := f2pLoad(t)
+	entry := f2pEntry(t, pp)
+	classes := []struct {
+		name string
+		owns func(*f2pFunc) bool
+	}{
+		{"root identification", pp.f2pOwnsRootIdentification},
+		{"root separation", pp.f2pOwnsRootSeparation},
+		{"node placement", f2pOwnsPlacement},
+		{"column/row sizing", f2pOwnsSizing},
+		{"edge finalization", f2pOwnsEdgeFinalization},
+		{"grid-to-drawing conversion", f2pOwnsDrawingConversion},
+	}
+	var steps []*f2pFunc
+	seen := map[*f2pFunc]bool{}
+	for name := range pp.callsIn(entry.decl.Body) {
+		for _, f := range pp.byName[name] {
+			if f != entry && !seen[f] {
+				seen[f] = true
+				steps = append(steps, f)
+			}
+		}
+	}
+	distinct := map[*f2pFunc]bool{}
+	for _, class := range classes {
+		owner := false
+		for _, step := range steps {
+			if pp.f2pReaches(step, class.owns) {
+				owner = true
+				distinct[step] = true
+			}
+		}
+		if !owner {
+			t.Errorf("no step called by mapping entry point %s owns %s", entry.name, class.name)
+		}
+	}
+
+	_ = distinct
+	for _, class := range classes {
+		dedicated := false
+		for _, unit := range pp.closure(entry) {
+			if unit == entry || !class.owns(unit) {
+				continue
+			}
+			otherWork := false
+			for _, other := range classes {
+				if other.name != class.name && other.owns(unit) {
+					otherWork = true
+				}
+			}
+			if !otherWork {
+				dedicated = true
+			}
+		}
+		if !dedicated {
+			t.Errorf("%s has no dedicated reachable implementation unit", class.name)
+		}
+	}
+
+}
+
+func f2pRootIdentifier(e ast.Expr) string {
+	switch x := e.(type) {
+	case *ast.Ident:
+		return x.Name
+	case *ast.SelectorExpr:
+		return f2pRootIdentifier(x.X)
+	case *ast.ParenExpr:
+		return f2pRootIdentifier(x.X)
+	}
+	return ""
+}
