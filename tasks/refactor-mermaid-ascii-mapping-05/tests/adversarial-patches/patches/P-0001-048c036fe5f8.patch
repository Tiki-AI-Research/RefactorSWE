diff --git a/pkg/graph/mapping.go b/pkg/graph/mapping.go
new file mode 100644
index 0000000..aed0af5
--- /dev/null
+++ b/pkg/graph/mapping.go
@@ -0,0 +1,155 @@
+package graph
+
+import (
+	log "github.com/sirupsen/logrus"
+)
+
+// mappingState tracks the cursor state across mapping phases.
+type mappingState struct {
+	highestPositionPerLevel map[int]int
+}
+
+func newMappingState() *mappingState {
+	return &mappingState{
+		highestPositionPerLevel: make(map[int]int),
+	}
+}
+
+// findRootNodes identifies all root nodes in the graph in g.nodes order.
+func (g *graph) findRootNodes() []*node {
+	nodesFound := make(map[string]bool)
+	rootNodes := []*node{}
+	for _, n := range g.nodes {
+		if _, ok := nodesFound[n.name]; !ok {
+			rootNodes = append(rootNodes, n)
+		}
+		nodesFound[n.name] = true
+		for _, child := range g.getChildren(n) {
+			nodesFound[child.name] = true
+		}
+	}
+	return rootNodes
+}
+
+// separateRoots partitions root nodes into external and subgraph roots when
+// the LR layout mix condition holds.
+func (g *graph) separateRoots(rootNodes []*node) (externalRootNodes []*node, subgraphRootNodes []*node, shouldSeparate bool) {
+	hasExternalRoots := false
+	hasSubgraphRootsWithEdges := false
+	for _, n := range rootNodes {
+		if g.isNodeInAnySubgraph(n) {
+			if len(g.getChildren(n)) > 0 {
+				hasSubgraphRootsWithEdges = true
+			}
+		} else {
+			hasExternalRoots = true
+		}
+	}
+
+	shouldSeparate = g.graphDirection == "LR" && hasExternalRoots && hasSubgraphRootsWithEdges
+
+	if shouldSeparate {
+		for _, n := range rootNodes {
+			if g.isNodeInAnySubgraph(n) {
+				subgraphRootNodes = append(subgraphRootNodes, n)
+			} else {
+				externalRootNodes = append(externalRootNodes, n)
+			}
+		}
+	} else {
+		externalRootNodes = rootNodes
+	}
+	return externalRootNodes, subgraphRootNodes, shouldSeparate
+}
+
+// reserveRootCoords places external and subgraph root nodes into the grid.
+func (g *graph) reserveRootCoords(state *mappingState, externalRootNodes []*node, subgraphRootNodes []*node, shouldSeparate bool) {
+	for _, n := range externalRootNodes {
+		var mappingCoord *gridCoord
+		if g.graphDirection == "LR" {
+			mappingCoord = g.reserveSpotInGrid(g.nodes[n.index], &gridCoord{x: 0, y: state.highestPositionPerLevel[0]})
+		} else {
+			mappingCoord = g.reserveSpotInGrid(g.nodes[n.index], &gridCoord{x: state.highestPositionPerLevel[0], y: 0})
+		}
+		log.Debugf("Setting mapping coord for external rootnode %s to %v", n.name, mappingCoord)
+		g.nodes[n.index].gridCoord = mappingCoord
+		state.highestPositionPerLevel[0] = state.highestPositionPerLevel[0] + 4
+	}
+
+	if shouldSeparate && len(subgraphRootNodes) > 0 {
+		subgraphLevel := 4
+		for _, n := range subgraphRootNodes {
+			var mappingCoord *gridCoord
+			if g.graphDirection == "LR" {
+				mappingCoord = g.reserveSpotInGrid(g.nodes[n.index], &gridCoord{x: subgraphLevel, y: state.highestPositionPerLevel[subgraphLevel]})
+			} else {
+				mappingCoord = g.reserveSpotInGrid(g.nodes[n.index], &gridCoord{x: state.highestPositionPerLevel[subgraphLevel], y: subgraphLevel})
+			}
+			log.Debugf("Setting mapping coord for subgraph rootnode %s to %v", n.name, mappingCoord)
+			g.nodes[n.index].gridCoord = mappingCoord
+			state.highestPositionPerLevel[subgraphLevel] = state.highestPositionPerLevel[subgraphLevel] + 4
+		}
+	}
+}
+
+// reserveChildCoords iterates through nodes and reserves coordinates for their descendants.
+func (g *graph) reserveChildCoords(state *mappingState) {
+	for _, n := range g.nodes {
+		log.Debugf("Creating mapping for node %s at %v", n.name, n.gridCoord)
+		var childLevel int
+		if g.graphDirection == "LR" {
+			childLevel = n.gridCoord.x + 4
+		} else {
+			childLevel = n.gridCoord.y + 4
+		}
+		highestPosition := state.highestPositionPerLevel[childLevel]
+		for _, child := range g.getChildren(n) {
+			if child.gridCoord != nil {
+				continue
+			}
+
+			var mappingCoord *gridCoord
+			if anchor := g.mappedSubgraphSibling(child); anchor != nil {
+				if g.graphDirection == "LR" {
+					mappingCoord = g.reserveSpotInGrid(g.nodes[child.index], &gridCoord{x: childLevel, y: anchor.y})
+				} else {
+					mappingCoord = g.reserveSpotInGrid(g.nodes[child.index], &gridCoord{x: anchor.x, y: childLevel})
+				}
+			} else if g.graphDirection == "LR" {
+				mappingCoord = g.reserveSpotInGrid(g.nodes[child.index], &gridCoord{x: childLevel, y: highestPosition})
+			} else {
+				mappingCoord = g.reserveSpotInGrid(g.nodes[child.index], &gridCoord{x: highestPosition, y: childLevel})
+			}
+			log.Debugf("Setting mapping coord for child %s of parent %s to %v", child.name, n.name, mappingCoord)
+			g.nodes[child.index].gridCoord = mappingCoord
+			position := highestPosition + 4
+			if g.graphDirection == "LR" {
+				position = Max(position, mappingCoord.y+4)
+			} else {
+				position = Max(position, mappingCoord.x+4)
+			}
+			state.highestPositionPerLevel[childLevel] = position
+		}
+	}
+}
+
+// sizeGridForNodes computes column widths and row heights for all nodes.
+func (g *graph) sizeGridForNodes() {
+	for _, n := range g.nodes {
+		g.setColumnWidth(n)
+	}
+}
+
+// finalizeEdges routes non-fanout edges, determines grid sizing for paths, and finalizes label lines.
+func (g *graph) finalizeEdges() {
+	for _, e := range g.edges {
+		if e.fanout {
+			continue
+		}
+		g.determinePath(e)
+		g.increaseGridSizeForPath(e.path)
+		g.determineLabelLine(e)
+	}
+}
+
+// convertGridToDrawing converts node grid coordinates into drawing coordinates and sets up drawings.
