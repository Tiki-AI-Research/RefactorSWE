+def test_edit_control_construction_and_password_type(monkeypatch):
+    call_log = []
+
+    class TrackedControlEdit:
+
+        def __init__(self, *args, **kwargs):
+            self.init_args = args
+            self.init_kwargs = kwargs
+            call_log.append(("init", self, args, kwargs))
+
+        def setPosition(self, x, y):
+            call_log.append(("setPosition", self, x, y))
+
+        def setHeight(self, h):
+            call_log.append(("setHeight", self, h))
+
+        def setWidth(self, w):
+            call_log.append(("setWidth", self, w))
+
+        def setType(self, input_type, heading):
+            call_log.append(("setType", self, input_type, heading))
+
+    monkeypatch.setattr(xbmcgui, "ControlEdit", TrackedControlEdit)
+
+    dlg = LoginManual("fake.xml", "/fake", "default", "1080i")
+    added = []
+    monkeypatch.setattr(
+        dlg,
+        "addControl",
+        lambda c: (added.append(c), call_log.append(("addControl", c))),
+    )
+
+    u_ctrl = dlg._add_editcontrol(755, 433, 40, 415, password=False)
+    p_ctrl = dlg._add_editcontrol(755, 543, 40, 415, password=True)
+
+    expected_kwargs = {
+        "label": "",
+        "font": "font13",
+        "textColor": "FF00A4DC",
+        "disabledColor": "FF888888",
+        "focusTexture": "-",
+        "noFocusTexture": "-",
+    }
+
+    assert u_ctrl.init_args == (0, 0, 0, 0)
+    assert u_ctrl.init_kwargs == expected_kwargs
+    assert p_ctrl.init_args == (0, 0, 0, 0)
+    assert p_ctrl.init_kwargs == expected_kwargs
+
+    assert ("setPosition", u_ctrl, 755, 433) in call_log
+    assert ("setHeight", u_ctrl, 40) in call_log
+    assert ("setWidth", u_ctrl, 415) in call_log
+
+    assert ("setPosition", p_ctrl, 755, 543) in call_log
+    assert ("setHeight", p_ctrl, 40) in call_log
+    assert ("setWidth", p_ctrl, 415) in call_log
+
+    assert u_ctrl in added
+    assert p_ctrl in added
+
+    p_add_idx = call_log.index(("addControl", p_ctrl))
+    p_set_idx = call_log.index(
