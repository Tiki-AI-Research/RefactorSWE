@@ -0,0 +1,135 @@
+# -*- coding: utf-8 -*-
+
+##################################################################################################
+
+import xbmcgui
+
+##################################################################################################
+
+ACTION_PARENT_DIR = 9
+ACTION_PREVIOUS_MENU = 10
+ACTION_BACK = 92
+ACTION_SELECT_ITEM = 7
+ACTION_MOUSE_LEFT_CLICK = 100
+LIST = 155
+
+##################################################################################################
+
+
+class ConnectionDialog(xbmcgui.WindowXMLDialog):
+
+    error = None
+    _item_type = None
+    _control_bindings = ()
+
+    def __init__(self, *args, **kwargs):
+
+        xbmcgui.WindowXMLDialog.__init__(self, *args, **kwargs)
+
+    def set_args(self, **kwargs):
+
+        for key, value in kwargs.items():
+            setattr(self, key, value)
+
+    def onInit(self):
+
+        self._bind_controls()
+        self._populate_list()
+        self._setup_controls()
+        self._setup_focus()
+
+    def _bind_controls(self):
+
+        for attr, control_id in self._control_bindings:
+            setattr(self, attr, self.getControl(control_id))
+
+    def _populate_list(self):
+
+        pass
+
+    def _setup_controls(self):
+
+        pass
+
+    def _setup_focus(self):
+
+        pass
+
+    @classmethod
+    def _add_listitem(cls, label, item_id, extra=None, server_type=None, art=None):
+
+        item = xbmcgui.ListItem(label)
+        item.setProperty("id", item_id)
+        if server_type is not None:
+            item.setProperty("server_type", server_type)
+        if art is not None:
+            item.setArt(art)
+        if extra is not None:
+            if getattr(cls, "_item_type", None) == "server" or extra in (
+                "wifi",
+                "network",
+            ):
+                item.setProperty("server_type", extra)
+            else:
+                item.setArt({"icon": extra})
+
+        return item
+
+    def _add_editcontrol(self, x, y, height, width, password=False):
+
+        kwargs = dict(
+            label="",
+            font="font13",
+            textColor="FF00A4DC",
+            disabledColor="FF888888",
+            focusTexture="-",
+            noFocusTexture="-",
+        )
+
+        control = xbmcgui.ControlEdit(0, 0, 0, 0, **kwargs)
+        control.setPosition(x, y)
+        control.setHeight(height)
+        control.setWidth(width)
+
+        self.addControl(control)
+
+        # setType has no effect before the control is added to a window
+        if password:
+            control.setType(xbmcgui.INPUT_TYPE_PASSWORD, "Please enter password")
+
+        return control
+
+    def onAction(self, action):
+
+        if action in (ACTION_BACK, ACTION_PREVIOUS_MENU, ACTION_PARENT_DIR):
+            self.close()
+            return
+
+        if (
+            action in (ACTION_SELECT_ITEM, ACTION_MOUSE_LEFT_CLICK)
+            and hasattr(self, "list_")
+            and self.getFocusId() == LIST
+        ):
+            selected = self.list_.getSelectedItem()
+            selected_id = selected.getProperty("id")
+            self._on_select(selected_id)
+
+    def _on_select(self, selected_id):
+
+        pass
+
+    def _message(self, message):
+
+        self.error_msg.setLabel(message)
+        self.error_toggle.setVisibleCondition("true")
+
+    def _error(self, state, message):
+
+        self.error = state
+        self.error_msg.setLabel(message)
+        self.error_toggle.setVisibleCondition("true")
+
+    def _disable_error(self):
+
+        self.error = None
+        self.error_toggle.setVisibleCondition("false")
