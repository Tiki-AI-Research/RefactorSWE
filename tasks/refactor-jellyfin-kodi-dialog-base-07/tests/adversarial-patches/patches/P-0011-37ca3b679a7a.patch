@@ -0,0 +1,869 @@
+# -*- coding: utf-8 -*-
+
+from unittest.mock import MagicMock
+
+import pytest
+import xbmcgui
+
+from jellyfin_kodi.dialogs import LoginManual, ServerConnect, ServerManual, UsersConnect
+from jellyfin_kodi.dialogs.base import (
+    ACTION_BACK,
+    ACTION_MOUSE_LEFT_CLICK,
+    ACTION_PARENT_DIR,
+    ACTION_PREVIOUS_MENU,
+    ACTION_SELECT_ITEM,
+    ConnectionDialog,
+)
+from jellyfin_kodi.helper import translate
+from jellyfin_kodi.jellyfin.connection_manager import CONNECTION_STATE
+
+
+class DummyControl:
+
+    def __init__(self, control_id=0):
+        self.control_id = control_id
+        self.label = ""
+        self.text = ""
+        self.image = None
+        self.items = []
+        self.visible_conditions = []
+        self.up = None
+        self.down = None
+        self.selected_item = None
+        self.x = 0
+        self.y = 0
+        self.height = 0
+        self.width = 0
+        self.input_type = None
+        self.heading = None
+
+    def setLabel(self, label):
+        self.label = str(label)
+
+    def getLabel(self):
+        return self.label
+
+    def setText(self, text):
+        self.text = str(text)
+
+    def getText(self):
+        return self.text
+
+    def setImage(self, image):
+        self.image = image
+
+    def addItem(self, item):
+        self.items.append(item)
+
+    def getSelectedItem(self):
+        return self.selected_item
+
+    def setVisibleCondition(self, condition, allow_hidden=False):
+        self.visible_conditions.append(condition)
+
+    def controlUp(self, control):
+        self.up = control
+
+    def controlDown(self, control):
+        self.down = control
+
+    def setPosition(self, x, y):
+        self.x = x
+        self.y = y
+
+    def setHeight(self, h):
+        self.height = h
+
+    def setWidth(self, w):
+        self.width = w
+
+    def setType(self, input_type, heading):
+        self.input_type = input_type
+        self.heading = heading
+
+
+class DummyListItem:
+
+    def __init__(self, label="", label2="", path=""):
+        self._label = label
+        self._properties = {}
+        self._art = {}
+
+    def getLabel(self):
+        return self._label
+
+    def setLabel(self, label):
+        self._label = label
+
+    def setProperty(self, key, value):
+        self._properties[key] = str(value)
+
+    def getProperty(self, key):
+        return self._properties.get(key, "")
+
+    def setArt(self, art):
+        self._art.update(art)
+
+    def getArt(self, key=None):
+        if key is not None:
+            return self._art.get(key, "")
+        return self._art
+
+
+@pytest.fixture
+def make_dialog(monkeypatch):
+    monkeypatch.setattr(xbmcgui, "ListItem", DummyListItem)
+    monkeypatch.setattr(xbmcgui, "ControlEdit", lambda *args, **kwargs: DummyControl())
+
+    def _create(dialog_cls):
+        dlg = dialog_cls("fake.xml", "/fake/addon", "default", "1080i")
+        controls = {}
+        added_controls = []
+        state = {"closed": 0, "focus": None, "focus_id": None}
+
+        def fake_get_control(cid):
+            if cid not in controls:
+                controls[cid] = DummyControl(cid)
+            return controls[cid]
+
+        def fake_add_control(ctrl):
+            added_controls.append(ctrl)
+
+        def fake_set_focus(ctrl):
+            state["focus"] = ctrl
+
+        def fake_close():
+            state["closed"] += 1
+
+        def fake_get_focus_id():
+            return state["focus_id"]
+
+        monkeypatch.setattr(dlg, "getControl", fake_get_control)
+        monkeypatch.setattr(dlg, "addControl", fake_add_control)
+        monkeypatch.setattr(dlg, "setFocus", fake_set_focus)
+        monkeypatch.setattr(dlg, "close", fake_close)
+        monkeypatch.setattr(dlg, "getFocusId", fake_get_focus_id)
+
+        return dlg, controls, added_controls, state
+
+    return _create
+
+
+@pytest.mark.parametrize(
+    "cls", [ServerConnect, UsersConnect, ServerManual, LoginManual]
+)
+def test_dialog_exports_and_modal_construction(cls):
+    assert issubclass(cls, ConnectionDialog)
+    assert issubclass(cls, xbmcgui.WindowXMLDialog)
