+# -*- coding: utf-8 -*-
+
+##################################################################################################
+
+"""F2P tests for consolidating the duplicated window mechanics of the connection dialogs.
+
+The four connection dialogs used to carry their own copy of the same window
+mechanics (``set_args``, the back/previous-menu/parent-directory close handling,
+the list-item and input-field construction, the list control lookup and the
+error indication).  The consolidation goal requires that this behaviour is
+provided by one shared dialog base which every dialog uses, while each dialog
+keeps only its own business logic.
+
+The tests never assert a private helper name, the location of the shared base,
+the error-state encoding or a visibility-condition string; they observe which
+implementation actually runs.  Every dialog interaction is driven through the
+frozen public entry points (``set_args``, ``onInit``, ``onAction``, ``onClick``)
+and the skin control ids, and the recorded call site must be one and the same
+implementation for every consumer and must not be owned by a dialog class.
+
+"""
+
+import sys
+from pathlib import Path
+
+import pytest
+import xbmc
+import xbmcaddon
+import xbmcgui
+
+from jellyfin_kodi.dialogs import LoginManual, ServerConnect, ServerManual, UsersConnect
+
+##################################################################################################
+
+# Kodi action ids.
+ACTION_SELECT_ITEM = 7
+ACTION_PARENT_DIR = 9
+ACTION_PREVIOUS_MENU = 10
+ACTION_BACK = 92
+ACTION_NEUTRAL = 0
+
+# Skin control ids of the connection dialogs.
+LIST = 155
+CONNECT = 200
+CANCEL = 201
+ERROR_TOGGLE = 202
+
+BACK_ACTIONS = (ACTION_PARENT_DIR, ACTION_PREVIOUS_MENU, ACTION_BACK)
+
+DIALOG_CLASSES = (ServerConnect, UsersConnect, ServerManual, LoginManual)
+
+SERVER_ID = "server-id"
+SERVER_ENTRY = {"Id": "s1", "Name": "Alpha", "Address": "http://alpha"}
+USER_ENTRY = {"Id": "u1", "Name": "Alice"}
+
+##################################################################################################
+
+
+class _Action(int):
+    """Kodi action that compares as its action id and exposes ``getId``."""
+
+    def getId(self):
+        return int(self)
+
+
+def _visibility_state(condition):
+    """Interpret a Kodi visibility condition as a boolean state."""
+
+    if isinstance(condition, bool):
+        return condition
+
+    text = str(condition).strip().lower()
+
+    if text.startswith("!"):
+        return not _visibility_state(text[1:])
+
+    return text not in ("false", "0", "")
+
+
+_REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
+
+
+def _is_project_code(code):
+    """True when the code object belongs to the project package under test."""
+
+    path = Path(code.co_filename)
+
+    if not path.is_absolute():
+        return False
+
+    try:
+        relative = path.resolve().relative_to(_REPOSITORY_ROOT)
+    except ValueError:
+        return False
+
+    return relative.parts[0] == "jellyfin_kodi"
+
+
+def _function_code(value):
+    if isinstance(value, (classmethod, staticmethod)):
+        value = value.__func__
+
+    return getattr(value, "__code__", None)
+
+
+def _nested_code_objects(code):
+    yield code
+
+    for constant in code.co_consts:
+        if isinstance(constant, type(code)):
+            yield from _nested_code_objects(constant)
+
+
+def _dialog_owned_code(classes=DIALOG_CLASSES):
+    """Code objects of the methods the four dialog classes define themselves."""
+
+    owned = set()
+
+    for dialog_class in classes:
+        for value in dialog_class.__dict__.values():
+            code = _function_code(value)
+            if code is not None:
+                owned.add(code)
+
+    return owned
+
+
+def _owner_class(code, classes=DIALOG_CLASSES):
+    """Class defining the given code object, resolved through the dialog MROs."""
+
+    for dialog_class in classes:
+        for ancestor in dialog_class.__mro__:
+            for value in ancestor.__dict__.values():
+                if _function_code(value) is code:
+                    return ancestor
+
+    return None
+
+
+def _describe(code):
+    return "%s:%s:%s" % (code.co_filename, code.co_firstlineno, code.co_name)
+
+
+def _shared_dialog_bases():
+    """Project-defined classes that are strict ancestors of all four dialogs."""
+
+    common = None
+
+    for dialog_class in DIALOG_CLASSES:
+        ancestors = {
+            ancestor
+            for ancestor in dialog_class.__mro__[1:]
+            if ancestor.__module__.startswith("jellyfin_kodi")
+        }
+        common = ancestors if common is None else common & ancestors
+
+    return common or set()
+
+
+def _other_dialog_classes():
+    """Classes defined by the dialog modules outside the four connection dialogs."""
+
+    from jellyfin_kodi.dialogs import context as context_module
+    from jellyfin_kodi.dialogs import resume as resume_module
+    from jellyfin_kodi.dialogs import skip as skip_module
+
+    classes = []
+
+    for module in (context_module, resume_module, skip_module):
+        for value in vars(module).values():
+            if isinstance(value, type) and value.__module__ == module.__name__:
+                classes.append(value)
+
+    return classes
+
+
+def _assert_shared_site(sites, what):
+    """Assert every consumer reached the same implementation, provided by the shared base."""
+
+    missing = sorted(name for name, code in sites.items() if code is None)
+
+    assert not missing, "%s: no implementation was executed for %s" % (what, missing)
+
+    distinct = []
+
+    for code in sites.values():
+        if code not in distinct:
+            distinct.append(code)
+
+    assert len(distinct) == 1, (
+        "%s: the consumers still run different implementations: %s"
+        % (what, [_describe(code) for code in distinct])
+    )
+
+    shared = distinct[0]
+
+    assert shared not in _dialog_owned_code(), (
+        "%s: the implementation is owned by a dialog class instead of the shared "
+        "dialog base: %s" % (what, _describe(shared))
+    )
+
+    return shared
+
+
+def _frame_chain(frame):
+    """Return ``frame`` and its callers, innermost first."""
+
+    chain = []
+
+    while frame is not None:
+        chain.append(frame)
+        frame = frame.f_back
+
+    return chain
+
+
+def _deepest_common_frame(left, right):
+    """Return the innermost frame shared by two innermost-first frame chains."""
+
+    right_ids = {id(frame) for frame in right}
+
+    for frame in left:
+        if id(frame) in right_ids:
+            return frame
+
+    return None
+
+
+class _RecordingDict(dict):
+    """Instance dictionary that notes the code object writing a watched name."""
+
+    def __init__(self, values, names, writers):
+        dict.__init__(self, values)
+        self._names = names
+        self._writers = writers
+
+    def __setitem__(self, key, value):
+        if key in self._names:
+            self._writers.add(sys._getframe(1).f_code)
+
+        dict.__setitem__(self, key, value)
+
+    def update(self, *args, **kwargs):
+        values = dict(*args, **kwargs)
+
+        for key in values:
+            if key in self._names:
+                self._writers.add(sys._getframe(1).f_code)
+
+        dict.update(self, values)
+
+
+class _SelectionData(dict):
+    def __init__(self, values, watched_key, recorder):
+        dict.__init__(self, values)
+        self.watched_key = watched_key
+        self.recorder = recorder
+
+    def __getitem__(self, key):
+        if key == self.watched_key:
+            self.recorder.note_frames("selection_data", key, sys._getframe(1))
+
+        return dict.__getitem__(self, key)
+
+    def get(self, key, default=None):
+        if key == self.watched_key:
+            self.recorder.note_frames("selection_data", key, sys._getframe(1))
+
+        return dict.get(self, key, default)
+
+
+class _ArgumentWriteProbe(object):
+    """Records which code object copies watched keyword arguments onto a dialog."""
+
+    def __init__(self, dialog, names):
+        self.dialog = dialog
+        self.names = frozenset(names)
+        self.writers = set()
+        self._dialog_class = type(dialog)
+        self._own_setattr = self._dialog_class.__dict__.get("__setattr__")
+        self._inherited_setattr = self._dialog_class.__setattr__
+        self._instance_dict = dialog.__dict__
+        self._installed_dict = None
+
+    def __enter__(self):
+        probe = self
+        dialog = self.dialog
+
+        def recording_setattr(instance, name, value):
+            if instance is dialog and name in probe.names:
+                probe.writers.add(sys._getframe(1).f_code)
+
+            probe._inherited_setattr(instance, name, value)
+
+        self._dialog_class.__setattr__ = recording_setattr
+
+        try:
+            self._installed_dict = _RecordingDict(self._instance_dict, self.names, self.writers)
+            dialog.__dict__ = self._installed_dict
+        except (AttributeError, TypeError):
+            self._installed_dict = None
+
+        return self
+
+    def __exit__(self, *exc_info):
+        if self._installed_dict is not None:
+            self._instance_dict.update(dict(self._installed_dict))
+            self.dialog.__dict__ = self._instance_dict
+            self._installed_dict = None
+
+        if self._own_setattr is None:
+            del self._dialog_class.__setattr__
+        else:
+            self._dialog_class.__setattr__ = self._own_setattr
+
+        return False
+
+
+##################################################################################################
+
+
+class _Recorder(object):
+    """Records which code object performed a watched interaction."""
+
+    def __init__(self):
+        self.events = {}
+        self.frame_events = {}
+
+    def note(self, code, event, payload=None):
+        self.events.setdefault(event, []).append((code, payload))
+
+    def note_frames(self, event, payload, frame):
+        self.frame_events.setdefault(event, []).append(
+            (frame.f_code, payload, _frame_chain(frame))
+        )
+
+    def clear(self):
+        self.events = {}
+        self.frame_events = {}
+
+    def site(self, event, payload=None):
+        for code, extra in self.events.get(event, []):
+            if payload is None or extra == payload:
+                return code
+
+        return None
+
+    def frame_site(self, event, payload=None):
+        for code, extra, frames in self.frame_events.get(event, []):
+            if payload is None or extra == payload:
+                return code, frames
+
+        return None, None
+
+
+class _FakeListItem(object):
+    def __init__(self, label="", label2="", path="", offscreen=False):
+        self.label = label
+        self.properties = {}
+        self.art = {}
+
+    def getLabel(self):
+        return self.label
+
+    def setLabel(self, label):
+        self.label = label
+
+    def setProperty(self, key, value):
+        self.properties[key] = value
+
+    def setProperties(self, values):
+        self.properties.update(values)
+
+    def getProperty(self, key):
+        return self.properties.get(key, "")
+
+    def setArt(self, values):
+        self.art.update(values)
+
+    def getArt(self, key):
+        return self.art.get(key, "")
+
+
+class _FakeControl(object):
+    def __init__(self, control_id, recorder):
+        self.control_id = control_id
+        self.recorder = recorder
+        self.visible_events = []
+        self.labels = []
+        self.images = []
+        self.items = []
+        self.selected_item = None
+        self.types = []
+        self.text = ""
+
+    def _rec(self, event, payload=None):
+        self.recorder.note(sys._getframe(2).f_code, event, payload)
+
+    def getId(self):
+        return self.control_id
+
+    def setVisibleCondition(self, condition, *args, **kwargs):
+        state = _visibility_state(condition)
+        self._rec("setVisibleCondition", state)
+        self.visible_events.append(state)
+
+    def setVisible(self, visible, *args, **kwargs):
+        state = bool(visible)
+        self._rec("setVisibleCondition", state)
+        self.visible_events.append(state)
+
+    @property
+    def visible(self):
+        return self.visible_events[-1] if self.visible_events else None
+
+    def setLabel(self, label="", *args, **kwargs):
+        self._rec("setLabel")
+        self.labels.append(label)
+
+    @property
+    def label(self):
+        return self.labels[-1] if self.labels else None
+
+    def setImage(self, image="", *args, **kwargs):
+        self._rec("setImage")
+        self.images.append(image)
+
+    def addItem(self, item, *args, **kwargs):
+        self._rec("addItem")
+        self.items.append(item)
+
+    def addItems(self, items):
+        self._rec("addItem")
+        self.items.extend(items)
+
+    def size(self):
+        return len(self.items)
+
+    def getListItem(self, index):
+        return self.items[index]
+
+    def getSelectedItem(self):
+        self._rec("getSelectedItem")
+        return self.selected_item
+
+    def selectItem(self, position):
+        self.selected_item = self.items[position]
+
+    def setType(self, type_id, heading="", *args, **kwargs):
+        self._rec("setType", type_id)
+        self.recorder.note_frames("setType", type_id, sys._getframe(1))
+        self.types.append((type_id, heading))
+
+    def getText(self):
+        return self.text
+
+    def setText(self, text):
+        self.text = text
+
+    def setPosition(self, x, y):
+        self.x = x
+        self.y = y
+
+    def setHeight(self, height):
+        self.height = height
+
+    def setWidth(self, width):
+        self.width = width
+
+    def controlUp(self, control):
+        self._rec("controlUp")
+
+    def controlDown(self, control):
+        self._rec("controlDown")
+
+    def setEnabled(self, enabled):
+        pass
+
+    def setNavigation(self, *args, **kwargs):
+        pass
+
+
+class _FakeConnectionManager(object):
+    """Recording stand-in for the Jellyfin connection manager."""
+
+    def __init__(self, connect_to_server_result=None, connect_to_address_result=None, login_result=None):
+        self.calls = []
+        self.server_id = SERVER_ID
+        self.server_info = dict(SERVER_ENTRY, address="http://alpha")
+        self.connect_to_server_result = connect_to_server_result
+        self.connect_to_address_result = connect_to_address_result
+        self.login_result = login_result
+        self.recorder = None
+
+    def _note(self, event):
+        if self.recorder is not None:
+            self.recorder.note(sys._getframe(2).f_code, event)
+
+    def get_server_info(self, server_id):
+        self.calls.append(("get_server_info", server_id))
+        return self.server_info
+
+    def connect_to_server(self, server):
+        self._note("connect_to_server")
+        self.calls.append(("connect_to_server", server))
+        return self.connect_to_server_result
+
+    def connect_to_address(self, address):
+        self._note("connect_to_address")
+        self.calls.append(("connect_to_address", address))
+        return self.connect_to_address_result
+
+    def login(self, server, username, password):
+        self._note("login")
+        self.calls.append(("login", server, username, password))
+        return self.login_result
+
+
+class _DialogHarness(object):
+    """Drives a dialog with recording stand-ins for the Kodi window API."""
+
+    def __init__(self, monkeypatch):
+        self.monkeypatch = monkeypatch
+        self.recorder = _Recorder()
+        self.controls = {}
+        self.added_controls = []
+        self.focused = []
+        self.focused_ids = []
+        self.closed = 0
+        self.focus_id = -1
+        self.edit_controls = []
+        self.list_items = []
+        self._install()
+
+    def new(self):
+        return _DialogHarness(self.monkeypatch)
+
+    def _install(self):
+        harness = self
+        recorder = self.recorder
+
+        class RecordingListItem(_FakeListItem):
+            def __init__(self, *args, **kwargs):
+                recorder.note(sys._getframe(1).f_code, "ListItem")
+                _FakeListItem.__init__(self, *args, **kwargs)
+                harness.list_items.append(self)
+
+        class RecordingControlEdit(_FakeControl):
+            def __init__(self, *args, **kwargs):
+                recorder.note(sys._getframe(1).f_code, "ControlEdit")
+                recorder.note_frames("ControlEdit", self, sys._getframe(1))
+                _FakeControl.__init__(self, None, recorder)
+                harness.edit_controls.append(self)
+
+        self.monkeypatch.setattr(xbmcgui, "ListItem", RecordingListItem)
+        self.monkeypatch.setattr(xbmcgui, "ControlEdit", RecordingControlEdit)
+        self.monkeypatch.setattr(xbmc, "sleep", lambda *args, **kwargs: None)
+        self.monkeypatch.setattr(
+            xbmc, "getLocalizedString", lambda string_id: "LOC:%s" % string_id, raising=False
+        )
+        self.monkeypatch.setattr(
+            xbmcaddon.Addon,
+            "getLocalizedString",
+            lambda self, string_id: "LOC:%s" % string_id,
+            raising=False,
+        )
+
+        # A solution may import the control classes directly into a dialog module.
+        for name, module in list(sys.modules.items()):
+            if module is None or not name.startswith("jellyfin_kodi.dialogs"):
+                continue
+            if getattr(module, "ListItem", None) is not None:
+                self.monkeypatch.setattr(module, "ListItem", RecordingListItem, raising=False)
+            if getattr(module, "ControlEdit", None) is not None:
+                self.monkeypatch.setattr(module, "ControlEdit", RecordingControlEdit, raising=False)
+
+    def dialog(self, dialog_class):
+        dialog = dialog_class("script-jellyfin-connect.xml", "/addon/path", "Default", "720p")
+        dialog.getControl = self.get_control
+        dialog.addControl = self.add_control
+        dialog.setFocus = self.set_focus
+        dialog.setFocusId = self.set_focus_id
+        dialog.getFocus = self.get_focus
+        dialog.getFocusId = self.get_focus_id_value
+        dialog.close = self.close
+        return dialog
+
+    def get_control(self, control_id):
+        self.recorder.note(sys._getframe(1).f_code, "getControl", control_id)
+
+        if control_id not in self.controls:
+            self.controls[control_id] = _FakeControl(control_id, self.recorder)
+
+        return self.controls[control_id]
+
+    def control(self, control_id):
+        return self.get_control(control_id)
+
+    def add_control(self, control):
+        self.recorder.note(sys._getframe(1).f_code, "addControl")
+        self.added_controls.append(control)
+
+    def set_focus(self, control):
+        self.recorder.note(sys._getframe(1).f_code, "setFocus")
+        self.focused.append(control)
+
+    def set_focus_id(self, control_id):
+        self.focus_id = control_id
+
+    def get_focus(self):
+        if self.focused:
+            return self.focused[-1]
+
+        return self.get_control(self.focus_id) if self.focus_id >= 0 else _FakeControl(-1, self.recorder)
+
+    def get_focus_id_value(self):
+        self.recorder.note(sys._getframe(1).f_code, "getFocusId")
+        return self.focus_id
+
+    def close(self):
+        self.recorder.note(sys._getframe(1).f_code, "close")
+        self.closed += 1
+
+    def select_row(self, control_id, index):
+        control = self.control(control_id)
+        control.selected_item = control.items[index]
+        self.focus_id = control_id
+
+    def password_field(self):
+        fields = [
+            control
+            for control in self.edit_controls
+            if any(type_id == xbmcgui.INPUT_TYPE_PASSWORD for type_id, _heading in control.types)
+        ]
+
+        return fields[0] if len(fields) == 1 else None
+
+    def text_field(self):
+        fields = [
+            control
+            for control in self.edit_controls
+            if not any(type_id == xbmcgui.INPUT_TYPE_PASSWORD for type_id, _heading in control.types)
+        ]
+
+        return fields[0] if len(fields) == 1 else None
+
+
+def _server_connect(harness, servers=(SERVER_ENTRY,), connect_manager=None):
+    dialog = harness.dialog(ServerConnect)
+    dialog.set_args(
+        connect_manager=connect_manager or _FakeConnectionManager(),
+        username="",
+        user_image=None,
+        servers=list(servers),
+    )
+    return dialog
+
+
+def _users_connect(harness, users=(USER_ENTRY,)):
+    dialog = harness.dialog(UsersConnect)
+    dialog.set_args(server="http://alpha", users=list(users))
+    return dialog
+
+
+def _server_manual(harness, connect_manager=None):
+    dialog = harness.dialog(ServerManual)
+    dialog.set_args(connect_manager=connect_manager or _FakeConnectionManager())
+    return dialog
+
+
+def _login_manual(harness, connect_manager=None, username=None):
+    dialog = harness.dialog(LoginManual)
+    dialog.set_args(connect_manager=connect_manager or _FakeConnectionManager(), username=username)
+    return dialog
+
+
+def _configure(harness, dialog_class, **kwargs):
+    if dialog_class is ServerConnect:
+        return _server_connect(harness, **kwargs)
+    if dialog_class is UsersConnect:
+        return _users_connect(harness, **kwargs)
+    if dialog_class is ServerManual:
+        return _server_manual(harness, **kwargs)
+    if dialog_class is LoginManual:
+        return _login_manual(harness, **kwargs)
+
+    raise AssertionError("unexpected dialog class %r" % (dialog_class,))
+
+
+@pytest.fixture
+def harness(monkeypatch):
+    return _DialogHarness(monkeypatch)
+
