+def test_control_lookup_is_not_implemented_by_the_dialogs_themselves(harness):
+    """The controls/focus mechanic the instruction lists as duplicated is
+    consolidated: the skin-control lookup every dialog performs while
+    initialising itself runs through one single implementation, provided by the
+    shared dialog base instead of being copied into each dialog class.
+
+    Only which implementation performed the lookup is observed, driven through
+    the frozen entry points and the skin control ids the instruction keeps
+    frozen.  No helper name, class name, module location, call form or number of
+    unrelated helpers is pinned: the shared base may decompose the rest of the
+    window mechanics however it likes, as long as the lookup calls themselves
+    come from one implementation rather than from a copy per dialog or from a
+    second lookup path inside the same base.
+    """
+
+    implementations = set()
+
+    for dialog_class in DIALOG_CLASSES:
+        case = harness.new()
+        dialog = _configure(case, dialog_class)
+        case.recorder.clear()
+        dialog.onInit()
+
+        entries = case.recorder.events.get("getControl", [])
+
+        assert entries, (
+            "%s looked up no skin control while initialising" % dialog_class.__name__
+        )
+
+        implementations.update(code for code, _payload in entries)
+
+    assert len(implementations) == 1, (
+        "the four dialogs still look their controls up through more than one "
+        "implementation, so the lookup was not consolidated: %s"
+        % sorted(_describe(code) for code in implementations)
+    )
+
+    implementation = next(iter(implementations))
+
+    assert implementation not in _dialog_owned_code(), (
+        "the skin-control lookup is still implemented by a dialog class instead "
+        "of the shared dialog base: %s" % _describe(implementation)
+    )
