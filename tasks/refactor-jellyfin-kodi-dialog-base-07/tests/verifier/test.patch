+##################################################################################################
+# The consolidation: one shared dialog base carrying the duplicated window behaviour.
+##################################################################################################
+
+
+def test_shared_dialog_base_is_introduced_and_used_by_all_four_dialogs(harness):
+    shared = _shared_dialog_bases()
+
+    assert shared, (
+        "the four connection dialogs do not share a project-defined dialog base, so the "
+        "duplicated window behaviour was not consolidated"
+    )
+
+    assert any(issubclass(base, xbmcgui.WindowXMLDialog) for base in shared), (
+        "none of the shared bases of the four dialogs is a Kodi dialog: %s"
+        % sorted(base.__name__ for base in shared)
+    )
+
+    assert not (shared & set(DIALOG_CLASSES)), (
+        "a dialog class is used as the shared base of the other dialogs: %s"
+        % sorted(base.__name__ for base in shared & set(DIALOG_CLASSES))
+    )
+
+    for dialog_class in DIALOG_CLASSES:
+        assert all(issubclass(dialog_class, base) for base in shared), (
+            "%s does not use the shared dialog base" % dialog_class.__name__
+        )
+
+
+def test_set_args_is_owned_by_the_shared_dialog_base(harness):
+    owners = set()
+
+    for dialog_class in DIALOG_CLASSES:
+        owner = None
+
+        for ancestor in dialog_class.__mro__:
+            if "set_args" in ancestor.__dict__:
+                owner = ancestor
+                break
+
+        assert owner is not None, "%s has no set_args implementation" % dialog_class.__name__
+        owners.add(owner)
+
+    assert len(owners) == 1, (
+        "set_args is still implemented once per dialog instead of once in the shared base: %s"
+        % sorted(owner.__name__ for owner in owners)
+    )
+
+    owner = owners.pop()
+
+    assert owner not in DIALOG_CLASSES, (
