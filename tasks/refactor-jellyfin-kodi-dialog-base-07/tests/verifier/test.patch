+class DialogHarness(object):
+    """Drives a dialog with recording stand-ins for the Kodi window API."""
+
+    def __init__(self, monkeypatch):
+        self.monkeypatch = monkeypatch
+        self.events = []
+        self.controls = {}
+        self.added_controls = []
+        self.focused = []
+        self.focused_ids = []
+        self.close_count = 0
+        self.close_observer = None
+        self.focus_id = -1
+        self.edit_controls = []
+        self.list_items = []
+        self._install()
+
+    def new(self):
+        """Return an independent harness (used when a test drives two dialogs)."""
+
+        return DialogHarness(self.monkeypatch)
+
+    def _install(self):
+        harness = self
+
+        class RecordingListItem(FakeListItem):
+            def __init__(self, *args, **kwargs):
+                FakeListItem.__init__(self, *args, **kwargs)
+                harness.list_items.append(self)
+
+        class RecordingControlEdit(FakeControl):
+            def __init__(self, *args, **kwargs):
+                FakeControl.__init__(self, None, harness.events)
+                for index, name in enumerate(("x", "y", "width", "height")):
+                    value = args[index] if len(args) > index else kwargs.get(name)
+                    setattr(self, name, value)
+                harness.edit_controls.append(self)
+
+        self.monkeypatch.setattr(xbmcgui, "ListItem", RecordingListItem)
+        self.monkeypatch.setattr(xbmcgui, "ControlEdit", RecordingControlEdit)
+        self.monkeypatch.setattr(
+            xbmc, "getLocalizedString", lambda string_id: "LOC:%s" % string_id, raising=False
+        )
+        self.monkeypatch.setattr(
+            xbmcaddon.Addon,
+            "getLocalizedString",
+            lambda self, string_id: "LOC:%s" % string_id,
+            raising=False,
+        )
+
+        # A solution may import the control classes directly into a dialog module.
+        for name, module in list(sys.modules.items()):
+            if module is None or not name.startswith("jellyfin_kodi.dialogs"):
+                continue
+            if getattr(module, "ListItem", None) is not None:
+                self.monkeypatch.setattr(module, "ListItem", RecordingListItem, raising=False)
+            if getattr(module, "ControlEdit", None) is not None:
+                self.monkeypatch.setattr(module, "ControlEdit", RecordingControlEdit, raising=False)
+
+    def dialog(self, dialog_class):
+        dialog = dialog_class("script-jellyfin-connect.xml", "/addon/path", "Default", "720p")
+        dialog.getControl = self.get_control
+        dialog.addControl = self.add_control
+        dialog.setFocus = self.set_focus
+        dialog.setFocusId = self.set_focus_id
+        dialog.getFocus = self.get_focus
+        dialog.getFocusId = self.get_focus_id_value
+        dialog.close = self.close
+        return dialog
+
+    def get_control(self, control_id):
+        if control_id not in self.controls:
+            self.controls[control_id] = FakeControl(control_id, self.events)
+        return self.controls[control_id]
+
+    def control(self, control_id):
+        return self.get_control(control_id)
+
+    def add_control(self, control):
+        self.added_controls.append(control)
+        self.events.append(("addControl", control))
+
+    def set_focus(self, control):
+        self.focused.append(control)
+
+    def set_focus_id(self, control_id):
+        self.focused_ids.append(control_id)
+
+    def get_focus(self):
+        if self.focused:
+            return self.focused[-1]
+        return self.get_control(self.focus_id) if self.focus_id >= 0 else FakeControl(-1)
+
+    def get_focus_id_value(self):
+        return self.focus_id
+
+    def close(self):
+        if self.close_observer is not None:
+            self.close_observer()
+        self.close_count += 1
+        self.events.append(("close",))
+
+    def select_row(self, control_id, index):
+        control = self.control(control_id)
+        control.selected_item = control.items[index]
+        self.focus_id = control_id
+
+    def list_is_focused(self, control_id):
+        return self.focused_control() is self.control(control_id) or self.focused_id() == control_id
+
+    def focused_control(self):
+        return self.focused[-1] if self.focused else None
+
+    def focused_id(self):
+        return self.focused_ids[-1] if self.focused_ids else None
+
+    def password_field(self):
+        fields = [control for control in self.edit_controls if _is_password_field(control)]
+        return fields[0] if len(fields) == 1 else None
+
+    def text_field(self):
+        fields = [control for control in self.edit_controls if not _is_password_field(control)]
+        return fields[0] if len(fields) == 1 else None
+
