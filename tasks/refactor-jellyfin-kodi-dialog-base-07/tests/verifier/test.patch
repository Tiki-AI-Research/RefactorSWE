+    assert dialog.connect_manager is connect_manager
+    assert dialog.username == "alice"
+
+    for dialog_class, accessors in PUBLIC_ACCESSORS:
+        dialog = harness.dialog(dialog_class)
+        for accessor in accessors:
+            assert callable(getattr(dialog, accessor)), "%s.%s is missing" % (
