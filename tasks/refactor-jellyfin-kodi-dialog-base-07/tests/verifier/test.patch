+# -*- coding: utf-8 -*-
+
+##################################################################################################
+
+"""Supplemental P2P regression tests for the four connection dialogs.
+
+The tests only drive the frozen public contract: class names and construction,
+``set_args``, the public accessors, the list payloads, initial focus, selection
+and close outcomes and the error indication.  The name, location and
+decomposition of the shared dialog base, its private helpers, the error-state
+encoding and the exact visibility condition strings are free to change and are
+therefore never asserted directly.
+
+The dialogs are driven through the skin control ids that the connection flow
+and the shipped skin XML already use, because no skin XML change is allowed.
+"""
+
+import ast
+import sys
+import xml.etree.ElementTree as ElementTree
+from pathlib import Path
+
+import pytest
+import xbmc
+import xbmcaddon
+import xbmcgui
+
+from jellyfin_kodi.dialogs import LoginManual, ServerConnect, ServerManual, UsersConnect
+from jellyfin_kodi.helper import translate
+from jellyfin_kodi.jellyfin.connection_manager import CONNECTION_STATE
+
+##################################################################################################
+
+# Skin control ids of the connection dialogs.
+LIST = 155
+USER_IMAGE = 150
+MESSAGE_BOX = 202
+MESSAGE = 203
+BUSY = 204
+CANCEL = 201
+MANUAL_SERVER = 206
+
+USERS_MANUAL = 200
+USERS_QUICK_CONNECT = 202
+
+MANUAL_CONNECT = 200
+MANUAL_ERROR_TOGGLE = 202
+MANUAL_ERROR_MSG = 203
+
+LOGIN_SIGN_IN = 200
+LOGIN_ERROR_TOGGLE = 202
+LOGIN_ERROR_MSG = 203
+
+# Kodi action ids.
+ACTION_SELECT_ITEM = 7
+ACTION_PARENT_DIR = 9
+ACTION_PREVIOUS_MENU = 10
+ACTION_BACK = 92
+ACTION_MOUSE_LEFT_CLICK = 100
+NEUTRAL_ACTION = 0
+
+BACK_ACTIONS = (ACTION_BACK, ACTION_PREVIOUS_MENU, ACTION_PARENT_DIR)
+
+PACKAGE_DIRECTORY = Path(__file__).resolve().parents[1] / "jellyfin_kodi" / "dialogs"
+
+SKIN_DIRECTORY = Path(__file__).resolve().parents[1] / "resources" / "skins" / "default" / "1080i"
+
+KODI_MODULES = {"xbmc", "xbmcaddon", "xbmcdrm", "xbmcgui", "xbmcplugin", "xbmcvfs"}
+
+SERVER_XML = SKIN_DIRECTORY / "script-jellyfin-connect-server.xml"
+USERS_XML = SKIN_DIRECTORY / "script-jellyfin-connect-users.xml"
+MANUAL_SERVER_XML = SKIN_DIRECTORY / "script-jellyfin-connect-server-manual.xml"
+MANUAL_LOGIN_XML = SKIN_DIRECTORY / "script-jellyfin-connect-login-manual.xml"
