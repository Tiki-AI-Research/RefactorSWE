+++ b/__tests__/f2p-dimension-contract.test.ts
@@ -0,0 +1,410 @@
+/**
+ * Observe real production function ownership using test-only AST instrumentation.
+ * Function identities are source positions, not stack names or call sites.
+ * Public wrappers, aliases and bound shared drivers use the same contract.
+ */
+import {jest, describe, it, expect, beforeEach} from '@jest/globals';
+import {productionFactory, extensionKey} from './support/dimension-probe.js';
+
+jest.unstable_mockModule('@actions/core', () => ({
+  debug: jest.fn(),
+  info: jest.fn(),
+  warning: jest.fn(),
+  error: jest.fn(),
+  setFailed: jest.fn(),
+  setOutput: jest.fn()
+}));
+jest.unstable_mockModule('@actions/github', () => ({
+  context: {
+    payload: {
+      pull_request: {
+        number: 123,
+        head: {ref: 'head-branch'},
+        base: {ref: 'base-branch'}
+      }
+    },
+    repo: {owner: 'monalisa', repo: 'helloworld'}
+  },
+  getOctokit: jest.fn()
+}));
+
+const factory = await productionFactory();
+let probe = factory();
+const run = (configs: any[], files: string[] = []) => probe.run(configs, files);
+
+function innerFrames(
+  record: any,
+  entryName: 'checkAny' | 'checkAll'
+): string[] {
+  const quantifier = entryName === 'checkAny' ? 'any' : 'all';
+  const other = quantifier === 'any' ? 'all' : 'any';
+  const control = run(
+    other === 'all' ? allAllDimensionsMatch : anyAllDimensionsFail,
+    ['foo.txt']
+  );
+  const candidates = probe.frames(record, quantifier);
+  // Only owners also reached by every dimension of the other quantifier count.
+  // The outer matching entry point is excluded by the exported target boundary.
+  return candidates.filter(
+    id =>
+      control.adapters.length > 0 &&
+      control.adapters.every(call => probe.frames(call, other).includes(id)) &&
+      probe.ownsAllAdapters(id, control.adapters)
+  );
+}
+
+function commonFrameKeys(lists: Array<string[] | null>): string[] {
+  if (!lists.length || lists.some(list => !list?.length)) return [];
+  return lists[0]!.filter(id => lists.every(list => list!.includes(id)));
+}
+
+function extensionRun(quantifier: 'any' | 'all', patterns: string[][]) {
+  const extended = factory(true);
+  expect(extended.registries.size).toBeGreaterThan(0);
+  let result: ReturnType<typeof extended.run> | undefined;
+  // Executing an added dimension without throwing is part of this contract.
+  // Keep an extension error as a real Jest assertion, with its original cause.
+  expect(() => {
+    result = extended.run(
+      [
+        {
+          [quantifier]: patterns.map(pattern => ({[extensionKey]: pattern}))
+        }
+      ],
+      ['foo.txt']
+    );
+  }).not.toThrow();
+  if (!result) throw new Error('Extension probe did not produce a result');
+  // A coincidental default boolean is insufficient: the cloned adapter must run.
+  expect(result.adapters.map(call => call.args[0])).toContainEqual(patterns[0]);
+  return result;
+}
+
+const anyAllDimensionsFail: any[] = [
+  {
+    any: [
+      {
+        baseBranch: ['^base-branch-that-does-not-match$'],
+        changedFiles: [{anyGlobToAnyFile: ['*.file-that-does-not-match']}],
+        headBranch: ['^head-branch-that-does-not-match$']
+      }
+    ]
+  }
+];
+
+const allAllDimensionsMatch: any[] = [
+  {
+    all: [
+      {
+        baseBranch: ['^base-branch$'],
+        changedFiles: [{allGlobsToAllFiles: ['*.txt']}],
+        headBranch: ['^head-branch$']
+      }
+    ]
+  }
+];
+
+beforeEach(() => {
+  probe = factory();
+});
+
+describe('F2P shared quantifier contract', () => {
+  it('drives both quantifiers through one shared production function', () => {
+    const anyRun = run(anyAllDimensionsFail, ['foo.txt']);
+    const allRun = run(allAllDimensionsMatch, ['foo.txt']);
+
+    expect(anyRun.result).toBe(false);
+    expect(allRun.result).toBe(true);
+    expect(anyRun.adapters).toHaveLength(3);
+    expect(allRun.adapters).toHaveLength(3);
+
+    const anyInner = anyRun.adapters.map(record =>
+      innerFrames(record, 'checkAny')
+    );
+    const allInner = allRun.adapters.map(record =>
+      innerFrames(record, 'checkAll')
+    );
+    expect(anyInner.every(list => list !== null && list.length > 0)).toBe(true);
+    expect(allInner.every(list => list !== null && list.length > 0)).toBe(true);
+
+    const shared = commonFrameKeys([...anyInner, ...allInner]);
+    expect(shared.length).toBeGreaterThan(0);
+  });
+
+  it('shares the any entry orchestration with all', () => {
+    const anyRun = run(anyAllDimensionsFail, ['foo.txt']);
+
+    expect(anyRun.adapters.length).toBeGreaterThan(0);
+    const inner = anyRun.adapters.map(record =>
+      innerFrames(record, 'checkAny')
+    );
+    expect(inner.every(list => list !== null && list.length > 0)).toBe(true);
+  });
+
+  it('shares the all entry orchestration with any', () => {
+    const allRun = run(allAllDimensionsMatch, ['foo.txt']);
+
+    expect(allRun.adapters.length).toBeGreaterThan(0);
+    const inner = allRun.adapters.map(record =>
+      innerFrames(record, 'checkAll')
+    );
+    expect(inner.every(list => list !== null && list.length > 0)).toBe(true);
+  });
+
+  it('evaluates the base branch dimension through the shared function', () => {
+    const anyRun = run([{any: [{baseBranch: ['^no-match$']}]}], ['foo.txt']);
+    const allRun = run([{all: [{baseBranch: ['^base-branch$']}]}], ['foo.txt']);
+
+    expect(anyRun.result).toBe(false);
+    expect(allRun.result).toBe(true);
+    expect(anyRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAnyBranch'
+    ]);
+    expect(allRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAllBranch'
+    ]);
+
+    const anyInner = innerFrames(anyRun.adapters[0], 'checkAny');
+    const allInner = innerFrames(allRun.adapters[0], 'checkAll');
+    expect(anyInner !== null && anyInner.length > 0).toBe(true);
+    expect(allInner !== null && allInner.length > 0).toBe(true);
+
+    const shared = commonFrameKeys([anyInner, allInner]);
+    expect(shared.length).toBeGreaterThan(0);
+  });
+
+  it('evaluates the changed files dimension through the shared function', () => {
+    const anyRun = run(
+      [{any: [{changedFiles: [{anyGlobToAnyFile: ['*.txt']}]}]}],
+      ['foo.txt']
+    );
+    const allRun = run(
+      [{all: [{changedFiles: [{allGlobsToAllFiles: ['*.txt']}]}]}],
+      ['foo.txt']
+    );
+
+    expect(anyRun.result).toBe(true);
+    expect(allRun.result).toBe(true);
+    expect(anyRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAnyChangedFiles'
+    ]);
+    expect(allRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAllChangedFiles'
+    ]);
+
+    const anyInner = innerFrames(anyRun.adapters[0], 'checkAny');
+    const allInner = innerFrames(allRun.adapters[0], 'checkAll');
+    expect(anyInner !== null && anyInner.length > 0).toBe(true);
+    expect(allInner !== null && allInner.length > 0).toBe(true);
+
+    const shared = commonFrameKeys([anyInner, allInner]);
+    expect(shared.length).toBeGreaterThan(0);
+  });
+
+  it('evaluates the head branch dimension through the shared function', () => {
+    const anyRun = run([{any: [{headBranch: ['^head-branch$']}]}], ['foo.txt']);
+    const allRun = run([{all: [{headBranch: ['^head-branch$']}]}], ['foo.txt']);
+
+    expect(anyRun.result).toBe(true);
+    expect(allRun.result).toBe(true);
+    expect(anyRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAnyBranch'
+    ]);
+    expect(allRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAllBranch'
+    ]);
+
+    const anyInner = innerFrames(anyRun.adapters[0], 'checkAny');
+    const allInner = innerFrames(allRun.adapters[0], 'checkAll');
+    expect(anyInner !== null && anyInner.length > 0).toBe(true);
+    expect(allInner !== null && allInner.length > 0).toBe(true);
+
+    const shared = commonFrameKeys([anyInner, allInner]);
+    expect(shared.length).toBeGreaterThan(0);
+  });
+
+  it('evaluates all block dimensions in order through the shared function', () => {
+    const allRun = run(allAllDimensionsMatch, ['foo.txt']);
+
+    expect(allRun.result).toBe(true);
+    expect(allRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAllBranch',
+      'checkAllChangedFiles',
+      'checkAllBranch'
+    ]);
+    expect(allRun.adapters[0].args[1]).toBe('base');
+    expect(allRun.adapters[2].args[1]).toBe('head');
+
+    const inner = allRun.adapters.map(record =>
+      innerFrames(record, 'checkAll')
+    );
+    expect(inner.every(list => list !== null && list.length > 0)).toBe(true);
+    const shared = commonFrameKeys(inner);
+    expect(shared.length).toBeGreaterThan(0);
+  });
+
+  it('evaluates any block dimensions in order through the shared function', () => {
+    const anyRun = run(anyAllDimensionsFail, ['foo.txt']);
+
+    expect(anyRun.result).toBe(false);
+    expect(anyRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAnyBranch',
+      'checkAnyChangedFiles',
+      'checkAnyBranch'
+    ]);
+    expect(anyRun.adapters[0].args[1]).toBe('base');
+    expect(anyRun.adapters[2].args[1]).toBe('head');
+
+    const inner = anyRun.adapters.map(record =>
+      innerFrames(record, 'checkAny')
+    );
+    expect(inner.every(list => list !== null && list.length > 0)).toBe(true);
+    const shared = commonFrameKeys(inner);
+    expect(shared.length).toBeGreaterThan(0);
+  });
+
+  it('shares an orchestration owner across every adapter and both quantifiers', () => {
+    const anyRun = run(anyAllDimensionsFail, ['foo.txt']);
+    const allRun = run(allAllDimensionsMatch, ['foo.txt']);
+
+    const inner = [
+      ...anyRun.adapters.map(record => innerFrames(record, 'checkAny')),
+      ...allRun.adapters.map(record => innerFrames(record, 'checkAll'))
+    ];
+    expect(inner.every(list => list !== null && list.length > 0)).toBe(true);
+
+    expect(commonFrameKeys(inner).length).toBeGreaterThan(0);
+  });
+
+  it('enforces the empty changed files boundary through the shared function', () => {
+    const allRun = run(
+      [
+        {
+          all: [
+            {
+              baseBranch: ['^base-branch$'],
+              changedFiles: [{allGlobsToAllFiles: ['*.txt']}]
+            }
+          ]
+        }
+      ],
+      []
+    );
+
+    expect(allRun.result).toBe(false);
+    expect(allRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAllBranch'
+    ]);
+
+    const baseInner = innerFrames(allRun.adapters[0], 'checkAll');
+    expect(baseInner !== null && baseInner.length > 0).toBe(true);
+
+    const guard = allRun.debug.filter(entry =>
+      entry.message.includes(
+        'no files to check "changed-files" patterns against'
+      )
+    );
+    expect(guard).toHaveLength(1);
+    const sharedKeys = new Set(baseInner!);
+    expect(guard[0].frames.some((id: string) => sharedKeys.has(id))).toBe(true);
+  });
+
+  it('short circuits an all block below the public entry point', () => {
+    const allRun = run(
+      [
+        {
+          all: [
+            {
+              baseBranch: ['^no-match$'],
+              changedFiles: [{allGlobsToAllFiles: ['*.txt']}],
+              headBranch: ['^head-branch$']
+            }
+          ]
+        }
+      ],
+      ['foo.txt']
+    );
+
+    expect(allRun.result).toBe(false);
+    expect(allRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAllBranch'
+    ]);
+    const inner = innerFrames(allRun.adapters[0], 'checkAll');
+    expect(inner !== null && inner.length > 0).toBe(true);
+  });
+
+  it('short circuits an any block below the public entry point', () => {
+    const anyRun = run(
+      [
+        {
+          any: [
+            {
+              baseBranch: ['^base-branch$'],
+              changedFiles: [{anyGlobToAnyFile: ['*.txt']}],
+              headBranch: ['^head-branch$']
+            }
+          ]
+        }
+      ],
+      ['foo.txt']
+    );
+
+    expect(anyRun.result).toBe(true);
+    expect(anyRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAnyBranch'
+    ]);
+    const inner = innerFrames(anyRun.adapters[0], 'checkAny');
+    expect(inner !== null && inner.length > 0).toBe(true);
+  });
+
+  it('automatically evaluates a newly registered dimension in any', () => {
+    expect(extensionRun('any', [['^base-branch$']]).result).toBe(true);
+    expect(extensionRun('any', [['^does-not-match$']]).result).toBe(false);
+  });
+
+  it('automatically evaluates a newly registered dimension in all', () => {
+    expect(extensionRun('all', [['^base-branch$']]).result).toBe(true);
+    expect(extensionRun('all', [['^does-not-match$']]).result).toBe(false);
+  });
+
+  it('extends any across entries without changing its shared driver', () => {
+    const result = extensionRun('any', [
+      ['^does-not-match$'],
+      ['^base-branch$']
+    ]);
+    expect(result.result).toBe(true);
+    expect(result.adapters).toHaveLength(2);
+  });
+
+  it('extends all across entries without changing its shared driver', () => {
+    const result = extensionRun('all', [
+      ['^base-branch$'],
+      ['^does-not-match$']
+    ]);
+    expect(result.result).toBe(false);
+    expect(result.adapters).toHaveLength(2);
+  });
+
+  it('drives every configuration through the same shared function', () => {
+    const allRun = run(
+      [
+        {all: [{baseBranch: ['^base-branch$']}]},
+        {all: [{headBranch: ['^head-branch$']}]}
+      ],
+      []
+    );
+
+    expect(allRun.result).toBe(true);
+    expect(allRun.adapters.map(record => record.adapter)).toEqual([
+      'checkAllBranch',
+      'checkAllBranch'
+    ]);
+
+    const inner = allRun.adapters.map(record =>
+      innerFrames(record, 'checkAll')
+    );
+    expect(inner.every(list => list !== null && list.length > 0)).toBe(true);
+    const shared = commonFrameKeys(inner);
+    expect(shared.length).toBeGreaterThan(0);
+  });
+});
