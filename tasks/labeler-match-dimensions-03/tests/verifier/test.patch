+        // sharing a scalar adapter helper below duplicated drivers is not enough.
+        let common: Set<number> | undefined;
+        for (const record of adapters) {
+          const owners = new Set<number>(
+            record.frames.flatMap((frame: string, index: number) =>
+              frame === id ? [record.owners[index]] : []
+            )
+          );
+          common = common
+            ? new Set([...common].filter(owner => owners.has(owner)))
+            : owners;
+        }
+        return Boolean(common?.size);
+      }
+    };
+  };
+}
+
