+          const matched = suites
+            .flatMap(suite => suite.cases)
+            .filter(testCase => testCase.name === selectorLeaf);
+          if (matched.length === 0) {
+            suites.push({
+              name: selectorFile,
+              cases: [
+                {
+                  name: selectorLeaf,
+                  status: 'error',
+                  duration: 0,
+                  message: `selector ${options.selector} did not match a collected test`,
+                  details: `selector ${options.selector} did not match a collected test`
+                }
+              ]
+            });
+            jestStatus = jestStatus || 2;
+          }
+        }
+      } else {
+        suites.push({
+          name: 'f2p-runner',
+          cases: [
+            {
+              name: 'jest produced a result file',
+              status: 'error',
+              duration: 0,
+              message: 'jest JSON output was empty or malformed',
+              details: 'jest JSON output was empty or malformed'
+            }
+          ]
+        });
+        jestStatus = jestStatus || 2;
+      }
+    }
+  }
+
+  writeReport(reportPath, suites);
+
+  const allCases = suites.flatMap(suite => suite.cases);
+  const passed = allCases.filter(testCase => testCase.status === 'passed').length;
+  process.stdout.write(
+    `f2p-runner: ${passed}/${allCases.length} test cases passed -> ${reportPath}\n`
+  );
+
+  const failed = allCases.some(testCase => testCase.status !== 'passed');
+  return failed ? 1 : 0;
+}
+
+process.exitCode = main();
