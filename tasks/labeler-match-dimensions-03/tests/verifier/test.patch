+        .map(testCase => {
+          suiteTime += (Number(testCase.duration) || 0) / 1000;
+          if (testCase.status === 'failed') {
+            suiteFailures += 1;
+          } else if (testCase.status === 'error') {
+            suiteErrors += 1;
+          } else if (testCase.status !== 'passed') {
+            suiteSkipped += 1;
+          }
+          return testcaseXml(
+            suite.name,
+            testCase.name,
+            toSeconds(testCase.duration),
+            testCase.status,
+            testCase.message,
+            testCase.details,
+            testCase.failureType
+          );
+        })
+        .join('');
+
+      total += suite.cases.length;
+      failures += suiteFailures;
+      errors += suiteErrors;
+      skipped += suiteSkipped;
+      time += suiteTime;
+
+      return (
+        `  <testsuite name="${escapeXml(suite.name)}" ` +
+        `file="${escapeXml(suite.name)}" tests="${suite.cases.length}" ` +
+        `failures="${suiteFailures}" errors="${suiteErrors}" ` +
+        `skipped="${suiteSkipped}" time="${suiteTime.toFixed(3)}">\n` +
+        cases +
+        '  </testsuite>\n'
+      );
+    })
+    .join('');
