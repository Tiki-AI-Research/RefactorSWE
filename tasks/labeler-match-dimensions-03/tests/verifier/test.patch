+      return;
+    }
+    for (const entry of entries) {
+      if (!entry.isDirectory() || skip.has(entry.name)) {
+        continue;
+      }
+      const child = path.join(directory, entry.name);
+      roots.push(child);
+      if (depth < maxDepth) {
+        walk(child, depth + 1);
+      }
+    }
+  };
+  for (const base of bases) {
+    walk(base, 0);
+  }
+  return roots;
+}
+
+function candidateRoots() {
+  const roots = [];
+  for (const entry of (process.env.NODE_PATH || '').split(path.delimiter)) {
+    if (!entry) {
+      continue;
+    }
+    const normalized = path.resolve(entry);
+    roots.push(
+      path.basename(normalized) === 'node_modules'
+        ? path.dirname(normalized)
+        : normalized
+    );
+  }
+  roots.push(...ancestorDirectories(repoRoot));
+  roots.push(...ancestorDirectories(process.cwd()));
+  // Locations provided by the frozen environment image (never installed here).
+  roots.push(
+    '/workspace/repo',
+    '/workspace',
+    '/opt/envpipe/runtime/lib',
+    '/usr/local/lib',
+    '/usr/lib'
+  );
+  // Bounded safety net: the frozen image keeps its dependency tree next to a
+  // repository checkout, wherever that checkout is mounted.
+  roots.push(...scanForDependencyRoots(['/workspace', '/opt', '/home', '/root'], 3));
+  return uniqueDirectories(roots);
+}
+
+function inspectDependencyRoot(root) {
+  const modules = path.join(root, 'node_modules');
+  const jestEntry = path.join(modules, 'jest', 'bin', 'jest.js');
+  if (!fs.existsSync(jestEntry)) {
+    return null;
+  }
+  const tsJestEntry = path.join(modules, 'ts-jest', 'dist', 'index.js');
+  return {
+    root,
+    modules,
+    jestEntry,
+    tsJestEntry: fs.existsSync(tsJestEntry) ? tsJestEntry : null
+  };
+}
+
+/**
+ * Locate jest and the dependency tree that provides it. The one-time baseline
+ * copy used for validation contains the repository sources only; the runtime
+ * dependencies stay in the frozen environment image (for example
+ * /workspace/repo/node_modules), so both the copy and the image are searched.
+ */
+function resolveDependencies() {
+  let fallback = null;
+  for (const root of candidateRoots()) {
+    const resolved = inspectDependencyRoot(root);
+    if (!resolved) {
+      continue;
+    }
+    if (resolved.tsJestEntry) {
+      return resolved;
+    }
+    if (!fallback) {
+      fallback = resolved;
+    }
+  }
+  try {
+    const packageJson = require.resolve('jest/package.json', {
+      paths: [repoRoot, __dirname, process.cwd()]
+    });
+    const modules = path.dirname(path.dirname(packageJson));
+    const resolved = inspectDependencyRoot(path.dirname(modules));
+    if (resolved && resolved.tsJestEntry) {
+      return resolved;
+    }
+    if (resolved && !fallback) {
+      fallback = resolved;
+    }
+  } catch (error) {
+    // fall through to the result below
+  }
+  return fallback;
+}
+
+/**
+ * When the dependencies live outside the repository copy, mirror the
+ * repository jest configuration while pointing module resolution at the
+ * dependency tree from the frozen image. Nothing is written inside the copy.
+ */
+function writeGeneratedConfig(dependencies) {
+  const configPath = path.join(
+    temporaryDirectory(),
+    `p2p-jest-config-${process.pid}.json`
+  );
+  const config = {
+    rootDir: repoRoot,
+    clearMocks: true,
+    moduleFileExtensions: ['js', 'ts'],
+    testEnvironment: 'node',
+    testMatch: ['**/*.test.ts'],
+    transform: {
+      '^.+\\.ts$': [
+        dependencies.tsJestEntry || 'ts-jest',
+        {
+          useESM: true,
+          diagnostics: {ignoreCodes: [151002]},
+          tsconfig: {
+            target: 'ES2022',
+            module: 'NodeNext',
+            moduleResolution: 'NodeNext',
+            esModuleInterop: true,
+            strict: true,
+            noImplicitAny: false,
+            baseUrl: repoRoot,
+            paths: {'*': [path.join(dependencies.modules, '*')]}
+          }
+        }
+      ]
+    },
+    extensionsToTreatAsEsm: ['.ts'],
+    transformIgnorePatterns: ['node_modules/(?!(@actions|@octokit)/)'],
+    moduleNameMapper: {'^(\\.{1,2}/.*)\\.js$': '$1'},
+    modulePaths: [dependencies.modules],
+    verbose: true
+  };
+  fs.writeFileSync(configPath, `${JSON.stringify(config, null, 2)}\n`);
+  return configPath;
+}
+
+function toSeconds(milliseconds) {
+  const value = Number(milliseconds);
+  return Number.isFinite(value) ? (value / 1000).toFixed(3) : '0.000';
+}
+
+function testcaseXml(classname, name, time, status, message, details) {
+  const attributes =
+    `classname="${escapeXml(classname)}" ` +
+    `name="${escapeXml(name)}" ` +
+    `file="${escapeXml(classname)}" ` +
+    `time="${escapeXml(time)}"`;
+  if (status === 'passed') {
+    return `    <testcase ${attributes}/>\n`;
+  }
+  if (status === 'failed' || status === 'error') {
+    const tag = status === 'error' ? 'error' : 'failure';
+    return (
+      `    <testcase ${attributes}>\n` +
+      `      <${tag} message="${escapeXml(message)}">${escapeXml(details)}</${tag}>\n` +
+      `    </testcase>\n`
+    );
+  }
+  return `    <testcase ${attributes}>\n      <skipped/>\n    </testcase>\n`;
+}
+
+function buildReport(suites) {
+  let total = 0;
+  let failures = 0;
+  let errors = 0;
+  let skipped = 0;
+  let time = 0;
+
+  const body = suites
+    .map(suite => {
+      let suiteFailures = 0;
+      let suiteErrors = 0;
+      let suiteSkipped = 0;
+      let suiteTime = 0;
+      const cases = suite.cases
+        .map(testCase => {
+          suiteTime += (Number(testCase.duration) || 0) / 1000;
+          if (testCase.status === 'failed') {
+            suiteFailures += 1;
+          } else if (testCase.status === 'error') {
+            suiteErrors += 1;
+          } else if (testCase.status !== 'passed') {
+            suiteSkipped += 1;
+          }
+          return testcaseXml(
+            suite.name,
+            testCase.name,
+            toSeconds(testCase.duration),
+            testCase.status,
+            testCase.message,
+            testCase.details
+          );
+        })
+        .join('');
+
+      total += suite.cases.length;
+      failures += suiteFailures;
+      errors += suiteErrors;
+      skipped += suiteSkipped;
+      time += suiteTime;
+
+      return (
+        `  <testsuite name="${escapeXml(suite.name)}" ` +
+        `file="${escapeXml(suite.name)}" tests="${suite.cases.length}" ` +
+        `failures="${suiteFailures}" errors="${suiteErrors}" ` +
+        `skipped="${suiteSkipped}" time="${suiteTime.toFixed(3)}">\n` +
+        cases +
+        '  </testsuite>\n'
+      );
+    })
+    .join('');
+
+  return (
+    '<?xml version="1.0" encoding="UTF-8"?>\n' +
+    `<testsuites name="p2p" tests="${total}" failures="${failures}" ` +
+    `errors="${errors}" skipped="${skipped}" time="${time.toFixed(3)}">\n` +
+    body +
+    '</testsuites>\n'
+  );
+}
+
+function writeReport(reportPath, suites) {
+  fs.mkdirSync(path.dirname(reportPath), {recursive: true});
+  fs.writeFileSync(reportPath, buildReport(suites));
+}
+
+function suiteFromJestFile(file, selector) {
+  const name = relative(file.name);
+  const cases = [];
+  for (const assertion of file.assertionResults || []) {
+    if (selector && assertion.fullName !== selector) {
+      continue;
+    }
+    const status =
+      assertion.status === 'passed'
+        ? 'passed'
+        : assertion.status === 'failed'
+          ? 'failed'
+          : 'skipped';
+    cases.push({
+      name: assertion.fullName,
+      status,
+      duration: assertion.duration,
+      message: (assertion.failureMessages || []).join('\n').slice(0, 500),
+      details: (assertion.failureMessages || []).join('\n')
+    });
+  }
+  if (cases.length === 0 && !selector) {
+    const message =
+      file.status === 'failed'
+        ? file.message || 'test file failed to run'
+        : 'no test cases were collected for this file';
+    cases.push({
+      name,
+      status: 'error',
+      duration: 0,
+      message: String(message).slice(0, 500),
+      details: String(message)
+    });
+  }
+  return {name, cases};
+}
+
+function main() {
+  const options = parseArgs(process.argv.slice(2));
+  if (!options.report) {
+    fail('missing required --report <path>');
+    return 2;
+  }
+  const reportPath = path.resolve(options.report);
+
+  const selectorFile = options.selector
+    ? options.selector.split('::')[0]
+    : null;
+  const selectorLeaf = options.selector
+    ? options.selector.split('::').slice(1).join('::')
+    : null;
+
+  const requested = selectorFile ? [selectorFile] : options.files;
+  const missing = requested.filter(
+    file => !fs.existsSync(path.join(repoRoot, file))
+  );
+  const present = requested.filter(file =>
+    fs.existsSync(path.join(repoRoot, file))
+  );
+
+  const suites = missing.map(file => ({
+    name: file,
+    cases: [
+      {
+        name: file,
+        status: 'error',
+        duration: 0,
+        message: `declared test path ${file} does not exist`,
+        details: `declared test path ${file} does not exist`
+      }
+    ]
+  }));
+
+  let jestStatus = 0;
+  if (present.length) {
+    const dependencies = resolveDependencies();
+    if (!dependencies) {
+      const message =
+        'jest could not be resolved from the repository or from the frozen ' +
+        `environment image (searched: ${candidateRoots().join(', ')})`;
+      suites.push({
+        name: 'p2p-runner',
+        cases: [
+          {
+            name: 'jest is available in the frozen environment',
+            status: 'error',
+            duration: 0,
+            message,
+            details: message
+          }
+        ]
+      });
+      writeReport(reportPath, suites);
+      fail(message);
+      return 2;
+    }
+    const generatedConfigPath =
+      dependencies.root === repoRoot
+        ? null
+        : writeGeneratedConfig(dependencies);
+
+    const jsonPath = path.join(
+      temporaryDirectory(),
+      `p2p-jest-${process.pid}-${Date.now()}.json`
+    );
+
+    const jestArgs = [
+      '--experimental-vm-modules',
+      dependencies.jestEntry,
+      '--runInBand'
+    ];
+    if (generatedConfigPath) {
+      jestArgs.push('--config', generatedConfigPath);
+    }
+    jestArgs.push('--json', `--outputFile=${jsonPath}`, ...present);
+    if (selectorLeaf) {
+      jestArgs.splice(
+        jestArgs.length - present.length,
+        0,
+        '--testNamePattern',
+        selectorLeaf
+      );
+    }
+
+    const nodePath = [dependencies.modules, process.env.NODE_PATH]
+      .filter(Boolean)
+      .join(path.delimiter);
+    const result = spawnSync(process.execPath, jestArgs, {
+      cwd: repoRoot,
+      env: {...process.env, CI: 'true', NODE_PATH: nodePath},
+      encoding: 'utf8',
+      maxBuffer: 64 * 1024 * 1024
+    });
+    jestStatus = result.status === null ? 2 : result.status;
+    if (jestStatus !== 0) {
+      const details = `${result.stdout || ''}\n${result.stderr || ''}`.trim();
+      if (details) {
+        process.stderr.write(`${details.slice(-4000)}\n`);
+      }
+    }
+
+    if (generatedConfigPath) {
+      try {
+        fs.unlinkSync(generatedConfigPath);
+      } catch (error) {
+        // the temporary configuration is disposable
+      }
+    }
+
+    if (result.error) {
+      suites.push({
+        name: 'p2p-runner',
+        cases: [
+          {
+            name: 'jest executed',
+            status: 'error',
+            duration: 0,
+            message: String(result.error.message || result.error),
+            details: String(result.error.stack || result.error)
+          }
+        ]
+      });
+    } else if (!fs.existsSync(jsonPath)) {
+      suites.push({
+        name: 'p2p-runner',
+        cases: [
+          {
+            name: 'jest produced a result file',
+            status: 'error',
+            duration: 0,
+            message:
+              (result.stderr || '').slice(0, 500) ||
+              'jest produced no JSON result',
+            details: result.stderr || 'jest produced no JSON result'
+          }
+        ]
+      });
+      jestStatus = jestStatus || 2;
+    } else {
+      let parsed = null;
+      try {
+        parsed = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
+      } catch (error) {
+        fail(`could not parse jest JSON output: ${error.message}`);
+      }
+      fs.unlinkSync(jsonPath);
+      if (parsed && Array.isArray(parsed.testResults)) {
+        for (const file of parsed.testResults) {
+          suites.push(suiteFromJestFile(file, selectorLeaf));
+        }
+        if (selectorLeaf) {
+          const matched = suites
+            .flatMap(suite => suite.cases)
+            .filter(testCase => testCase.name === selectorLeaf);
+          if (matched.length === 0) {
+            suites.push({
+              name: selectorFile,
+              cases: [
+                {
+                  name: selectorLeaf,
+                  status: 'error',
+                  duration: 0,
+                  message: `selector ${options.selector} did not match a collected test`,
+                  details: `selector ${options.selector} did not match a collected test`
+                }
+              ]
+            });
+            jestStatus = jestStatus || 2;
+          }
+        }
+      } else {
+        suites.push({
+          name: 'p2p-runner',
+          cases: [
+            {
+              name: 'jest produced a result file',
+              status: 'error',
+              duration: 0,
+              message: 'jest JSON output was empty or malformed',
+              details: 'jest JSON output was empty or malformed'
+            }
+          ]
+        });
+        jestStatus = jestStatus || 2;
+      }
+    }
+  }
+
+  writeReport(reportPath, suites);
+
+  const allCases = suites.flatMap(suite => suite.cases);
+  const passed = allCases.filter(
+    testCase => testCase.status === 'passed'
+  ).length;
+  process.stdout.write(
+    `p2p-runner: ${passed}/${allCases.length} test cases passed -> ${reportPath}\n`
+  );
+
+  const failed = allCases.some(testCase => testCase.status !== 'passed');
+  return failed || jestStatus !== 0 ? 1 : 0;
+}
+
+process.exitCode = main();
