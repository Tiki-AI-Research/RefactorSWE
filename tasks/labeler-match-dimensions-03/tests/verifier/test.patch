+import {jest, describe, it, expect, beforeEach} from '@jest/globals';
+import type {MatchConfig} from '../src/api/get-label-configs.js';
+
+jest.unstable_mockModule('@actions/core', () => ({
+  debug: jest.fn(),
+  info: jest.fn(),
+  warning: jest.fn(),
+  error: jest.fn(),
+  setFailed: jest.fn(),
+  setOutput: jest.fn()
+}));
+
+const mockGithubContext: any = {
+  payload: {
+    pull_request: {
+      number: 123,
+      head: {ref: 'head-branch'},
+      base: {ref: 'base-branch'}
+    }
+  },
+  repo: {owner: 'monalisa', repo: 'helloworld'}
+};
+
+jest.unstable_mockModule('@actions/github', () => ({
+  context: mockGithubContext,
+  getOctokit: jest.fn()
+}));
+
+const core = await import('@actions/core');
+const {checkMatchConfigs} = await import('../src/labeler.js');
+const {getLabelConfigMapFromObject, toMatchConfig} =
+  await import('../src/api/get-label-configs.js');
+
+const debugMessages = (): string[] =>
+  (core.debug as jest.Mock).mock.calls.map(call => String(call[0]));
+
+const baseBranchMessage = '   checking "branch" pattern against base-branch';
+const headBranchMessage = '   checking "branch" pattern against head-branch';
+const changedFilesMessage = '   checking "changed-files" patterns';
+const noChangedFilesMessage =
+  '  no files to check "changed-files" patterns against';
+
+const changedFilesPatterns = (patterns: string[]) => [
+  {anyGlobToAnyFile: patterns}
+];
+
+beforeEach(() => {
+  (core.debug as jest.Mock).mockClear();
+  mockGithubContext.payload.pull_request = {
+    number: 123,
+    head: {ref: 'head-branch'},
+    base: {ref: 'base-branch'}
+  };
+});
+
+describe('dimension evaluation order and short-circuiting', () => {
+  it('checks the base branch before changed files and the head branch', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
+        any: [
+          {
+            baseBranch: ['^does-not-match$'],
+            changedFiles: changedFilesPatterns(['*.md']),
+            headBranch: ['^does-not-match$']
+          }
+        ]
+      }
+    ];
+
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(false);
+
+    const messages = debugMessages();
+    const baseIndex = messages.indexOf(baseBranchMessage);
+    const changedFilesIndex = messages.indexOf(changedFilesMessage);
+    const headIndex = messages.indexOf(headBranchMessage);
+
+    expect(baseIndex).toBeGreaterThanOrEqual(0);
+    expect(changedFilesIndex).toBeGreaterThan(baseIndex);
+    expect(headIndex).toBeGreaterThan(changedFilesIndex);
+  });
+
+  it('short-circuits an any entry as soon as a dimension matches', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
+        any: [
+          {
+            baseBranch: ['^base-branch$'],
+            changedFiles: changedFilesPatterns(['*.txt']),
+            headBranch: ['^head-branch$']
+          }
+        ]
+      }
+    ];
+
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(true);
+
+    const messages = debugMessages();
+    expect(messages).toContain('  "any" patterns matched');
+    expect(messages).not.toContain(changedFilesMessage);
+    expect(messages).not.toContain(headBranchMessage);
+  });
+
+  it('short-circuits an all entry as soon as a dimension fails', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
+        all: [
+          {
+            baseBranch: ['^does-not-match$'],
+            changedFiles: changedFilesPatterns(['*.txt']),
+            headBranch: ['^head-branch$']
+          }
+        ]
+      }
+    ];
+
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(false);
+
+    const messages = debugMessages();
+    expect(messages).toContain('  "all" patterns did not match');
+    expect(messages).not.toContain(changedFilesMessage);
+    expect(messages).not.toContain(headBranchMessage);
+  });
+
+  it('does not evaluate the head branch after the changed files dimension fails', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
+        all: [
+          {
+            baseBranch: ['^base-branch$'],
+            changedFiles: changedFilesPatterns(['*.md']),
+            headBranch: ['^head-branch$']
+          }
+        ]
+      }
+    ];
+
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(false);
+
+    const messages = debugMessages();
+    expect(messages).toContain(changedFilesMessage);
+    expect(messages).not.toContain(headBranchMessage);
+  });
+
+  it('stops evaluating an all block at the first failing entry', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
+        all: [
+          {headBranch: ['^head-branch$']},
+          {headBranch: ['^does-not-match$']},
+          {headBranch: ['^head-branch$']}
+        ]
+      }
+    ];
+
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(false);
+
+    const messages = debugMessages();
+    expect(
+      messages.filter(message => message === headBranchMessage)
+    ).toHaveLength(2);
+  });
+});
+
+describe('empty changed files in an all block', () => {
+  it('fails an all entry with changed files before evaluating any file patterns', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
+        all: [
+          {
+            baseBranch: ['^base-branch$'],
+            changedFiles: changedFilesPatterns(['*.txt']),
+            headBranch: ['^head-branch$']
+          }
+        ]
+      }
+    ];
+
+    expect(checkMatchConfigs([], matchConfigs, false)).toBe(false);
+
+    const messages = debugMessages();
+    expect(messages).toContain(baseBranchMessage);
+    expect(messages).toContain(noChangedFilesMessage);
+    expect(messages).not.toContain(changedFilesMessage);
+    expect(messages).not.toContain(headBranchMessage);
+  });
+
+  it('fails an all block with an empty changed files list even when branch dimensions match', () => {
+    const labelConfigs = getLabelConfigMapFromObject({
+      label: [{all: [{'changed-files': [{}]}]}]
+    });
+    const matchConfigs = labelConfigs.get('label')!;
+
+    expect(matchConfigs).toEqual([{all: [{changedFiles: []}]}]);
+    expect(checkMatchConfigs([], matchConfigs, false)).toBe(false);
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(true);
+  });
+});
+
+describe('any quantifier semantics', () => {
+  it('returns false when no entry has a present dimension', () => {
+    expect(checkMatchConfigs(['foo.txt'], [{any: [{}, {}]}], false)).toBe(
+      false
+    );
+  });
+
+  it('returns false when every present dimension fails', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
+        any: [
+          {
+            baseBranch: ['^does-not-match$'],
+            changedFiles: changedFilesPatterns(['*.md'])
+          }
+        ]
+      }
+    ];
+
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(false);
+  });
+
+  it('matches when a later entry has a matching dimension', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
+        any: [
+          {headBranch: ['^does-not-match$']},
+          {changedFiles: changedFilesPatterns(['*.txt'])}
+        ]
+      }
+    ];
+
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(true);
+  });
+});
+
+describe('all quantifier semantics', () => {
+  it('requires every present dimension of an entry to match', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
+        all: [
+          {
+            baseBranch: ['^base-branch$'],
+            changedFiles: changedFilesPatterns(['*.txt']),
+            headBranch: ['^head-branch$']
+          }
+        ]
+      }
+    ];
+
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(true);
+    expect(checkMatchConfigs(['foo.md'], matchConfigs, false)).toBe(false);
+  });
+
+  it('accepts an entry that has no present dimension', () => {
+    const matchConfigs: MatchConfig[] = [
+      {all: [{}, {headBranch: ['^head-branch$']}]}
+    ];
+
+    expect(checkMatchConfigs(['foo.txt'], matchConfigs, false)).toBe(true);
+  });
+
+  it('returns false when every entry is empty', () => {
+    expect(checkMatchConfigs(['foo.txt'], [{all: [{}, {}]}], false)).toBe(
+      false
+    );
+  });
+
+  it('returns false when a later entry fails', () => {
+    const matchConfigs: MatchConfig[] = [
+      {
