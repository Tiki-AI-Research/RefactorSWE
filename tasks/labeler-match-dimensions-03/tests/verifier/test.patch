+    const origins = {any: origin(api.checkAny), all: origin(api.checkAll)};
+    return {
+      registries,
+      touched,
+      run(configs: any[], files: string[] = []) {
+        calls.length = 0;
+        debug.length = 0;
+        touched.length = 0;
+        const result = api.checkMatchConfigs(files, configs, false);
+        if (stack.length)
+          throw new Error('Unbalanced production instrumentation');
+        return {
+          result,
+          adapters: calls.slice(),
+          debug: debug.slice(),
+          touched: touched.slice()
+        };
+      },
+      frames(record: any, quantifier: 'any' | 'all'): string[] {
+        const index = record.frames.indexOf(origins[quantifier]);
+        // Include the exported target: a bound shared driver is itself a legal
+        // owner. Distinct duplicated entry functions still have no common ID.
+        return origins[quantifier] && index >= 0
+          ? record.frames.slice(index)
+          : [];
+      },
+      ownsAllAdapters(id: string, adapters: any[]): boolean {
