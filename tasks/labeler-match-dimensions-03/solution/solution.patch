+
+describe('when all four glob pattern modes are present in a single changed-files config', () => {
+  const config = {
+    'changed-files': [
+      {
+        'any-glob-to-any-file': ['foo.txt'],
+        'any-glob-to-all-files': ['*.txt'],
+        'all-globs-to-any-file': ['foo.txt', '*.txt'],
+        'all-globs-to-all-files': ['*.txt', '**']
+      }
+    ]
+  };
+
+  it('normalizes all four modes into separate items preserving order', () => {
+    const result = toChangedFilesMatchConfig(config);
+    expect(result).toEqual({
+      changedFiles: [
+        {anyGlobToAnyFile: ['foo.txt']},
+        {anyGlobToAllFiles: ['*.txt']},
+        {allGlobsToAnyFile: ['foo.txt', '*.txt']},
+        {allGlobsToAllFiles: ['*.txt', '**']}
+      ]
+    });
+  });
+
+  it('evaluates both checkAnyChangedFiles and checkAllChangedFiles to true for matching files', () => {
+    const normalized = toChangedFilesMatchConfig(config);
+    const files = ['foo.txt', 'bar.txt'];
+    expect(checkAnyChangedFiles(files, normalized.changedFiles!, false)).toBe(
+      true
+    );
+    expect(checkAllChangedFiles(files, normalized.changedFiles!, false)).toBe(
+      true
+    );
+  });
+});
