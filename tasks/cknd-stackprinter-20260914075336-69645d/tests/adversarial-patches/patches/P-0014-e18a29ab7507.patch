+"""
+Shared frame-preparation responsibility.
+
+This module decides *what* a diagnostic render will show -- which lines of
+source context and which variable values -- independently of *how* that
+content is presented. It is the single owner of that decision for both the
+report pipeline (`stackprinter.formatting`) and live tracing
+(`stackprinter.tracing`), so neither entry point has to duplicate the
+selection rules or reach into a presentation formatter to get them.
+
+`PreparedFrame` is the ownership boundary: prepared collections are copied and
+handed out as copies, so a render can neither mutate the caller-owned
+`FrameInfo` it was built from nor leak changes into another render.
+"""
+
+from collections import OrderedDict
+
+from stackprinter.utils import inspect_callable, match, trim_source
+
+
+class PreparedFrame():
+    """
+    Encapsulated representation of prepared source context and visible variables.
+    Preserves ordering and prevents mutation of internal data.
+    """
+
+    __slots__ = ('_trimmed_source_map', '_visible_assignments')
+
+    def __init__(self, trimmed_source_map, visible_assignments):
+        self._trimmed_source_map = self._copy_source_map(trimmed_source_map)
+        self._visible_assignments = OrderedDict(visible_assignments)
+
+    @staticmethod
+    def _copy_source_map(source_map):
+        if not source_map:
+            return OrderedDict()
+        return OrderedDict([(ln, [list(tok) for tok in tokens])
+                            for ln, tokens in source_map.items()])
+
+    @property
+    def trimmed_source_map(self):
+        return self._copy_source_map(self._trimmed_source_map)
+
+    @property
+    def visible_assignments(self):
+        return OrderedDict(self._visible_assignments)
+
+
+class FramePreparer():
+    """
+    Shared preparation responsibility for selecting visible source lines and variables.
+    Decoupled from presentation formatting.
+    """
+
+    def __init__(self, source_lines=5, source_lines_after=1,
+                 show_signature=True, show_vals='like_source',
+                 suppressed_paths=None):
+        if not (isinstance(source_lines, int) or source_lines == 'all'):
+            raise ValueError("source_lines must be an integer or 'all', "
+                             "was %r" % source_lines)
+
+        valid_gv = ['all', 'like_source', 'line', None, False]
+        if show_vals not in valid_gv:
+            raise ValueError("show_vals must be one of "
+                             "%s, was %r" % (str(valid_gv), show_vals))
+
+        self.lines = source_lines
+        self.lines_after = source_lines_after
+        self.show_signature = show_signature
+        self.show_vals = show_vals
+        self.suppressed_paths = suppressed_paths
+
+    def prepare(self, fi):
+        source_lines = []
+        minl, maxl = 0, 0
+        if len(fi.source_map) > 0:
+            minl, maxl = min(fi.source_map), max(fi.source_map)
+            lineno = fi.lineno
+
+            if self.lines == 0:
+                source_lines = []
+            elif self.lines == 1:
+                source_lines = [lineno]
+            elif self.lines == 'all':
+                source_lines = range(minl, maxl + 1)
+            elif self.lines > 1 or self.lines_after > 0:
+                start = max(lineno - (self.lines - 1), 0)
+                stop = lineno + self.lines_after
+                start = max(start, minl)
+                stop = min(stop, maxl)
+                source_lines = list(range(start, stop + 1))
+
+            if source_lines and self.show_signature:
+                source_lines = sorted(set(source_lines) | set(fi.head_lns))
+
+        if source_lines:
+            if not set(source_lines).issubset(fi.source_map.keys()):
+                debug_vals = [source_lines, fi.head_lns, fi.source_map.keys()]
+                info = ', '.join(str(p) for p in debug_vals)
+                raise Exception("Picked an invalid source context: %s" % info)
+            source_map_copy = PreparedFrame._copy_source_map(fi.source_map)
+            trimmed_source_map = trim_source(source_map_copy, source_lines)
+        else:
+            trimmed_source_map = {}
+
+        if self.show_vals:
+            if self.show_vals == 'all':
+                val_lines = range(minl, maxl)
+            elif self.show_vals == 'like_source':
+                val_lines = source_lines
+            elif self.show_vals == 'line':
+                val_lines = [lineno] if source_lines else []
+
+            def hide(name):
+                value = fi.assignments[name]
+                if callable(value):
+                    qualified_name, path, *_ = inspect_callable(value)
+                    is_builtin = value.__class__.__name__ == 'builtin_function_or_method'
+                    is_boring = is_builtin or (qualified_name == name) or (path is None)
+                    is_suppressed = match(path, self.suppressed_paths)
+                    return is_boring or is_suppressed
+                return False
+
+            visible_vars = (name for ln in val_lines
+                            for name in fi.line2names[ln]
+                            if name in fi.assignments)
+
+            visible_assignments = OrderedDict([(n, fi.assignments[n])
+                                               for n in visible_vars
+                                               if not hide(n)])
+        else:
+            visible_assignments = OrderedDict()
+
+        return PreparedFrame(trimmed_source_map, visible_assignments)
