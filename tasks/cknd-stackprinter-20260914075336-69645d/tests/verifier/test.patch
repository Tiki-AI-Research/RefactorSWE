+"""Fail-to-pass checks for the requested refactoring behavior rules.
+
+Each node exercises one instruction behavior that the pre-refactor code cannot
+satisfy, so the whole module fails on the baseline and passes on the solution.
+"""
+
+import io
+import re
+import sys
+import threading
+import types
+
+import pytest
+
+import stackprinter
+
+
+@pytest.fixture(autouse=True)
+def _restore_trace_after_test():
+    before = sys.gettrace()
+    yield
+    sys.settrace(before)
+
+
+def _capture_error(message="f2p-error"):
+    try:
+        raise ValueError(message)
+    except ValueError as error:
+        return error
+    raise AssertionError("fixture did not raise")
+
+
+def _render(error, **overrides):
+    options = dict(source_lines=0, show_vals=False, show_signature=False,
+                   add_summary=False)
+    options.update(overrides)
+    return stackprinter.format(error, **options)
+
+
+# --- Tracing activation re-entrancy F2P nodes ---
+
+def test_nested_traceprinters_restore_outer_trace():
+    events = []
+    outer = stackprinter.TracePrinter(style="plaintext", suppressed_paths=[r".*"], print_function=events.append)
+    inner = stackprinter.TracePrinter(style="plaintext", suppressed_paths=[r".*"], print_function=events.append)
+    with outer:
+        outer_trace = sys.gettrace()
+        assert callable(outer_trace)
+        with inner:
+            inner_trace = sys.gettrace()
+            assert callable(inner_trace)
+            def inner_body():
+                return 1
+            inner_body()
+        assert sys.gettrace() is outer_trace
+
+
+def test_nested_context_on_same_tracer_restores_outer_trace():
+    events = []
+    printer = stackprinter.TracePrinter(style="plaintext", suppressed_paths=[r".*"], print_function=events.append)
+    with printer:
+        outer_trace = sys.gettrace()
+        assert callable(outer_trace)
+        with printer:
+            inner_trace = sys.gettrace()
+            assert callable(inner_trace)
+            def inner_body():
+                return 1
+            inner_body()
+        assert sys.gettrace() is outer_trace
+
+def test_nested_context_on_same_tracer_restores_outer_trace_after_exception():
+    previous = sys.gettrace()
+    printer = stackprinter.TracePrinter(
+        style="plaintext", suppressed_paths=[r".*"], print_function=lambda _: None
+    )
+    try:
+        with printer:
+            outer_trace = sys.gettrace()
+            try:
+                with printer:
+                    def inner_body():
+                        raise ValueError("nested-context")
+                    inner_body()
+            except ValueError:
+                pass
+            assert sys.gettrace() is outer_trace
+    finally:
+        sys.settrace(previous)
+
+
+def test_nested_manual_activation_restores_outer_trace():
+    events = []
+    printer = stackprinter.TracePrinter(style="plaintext", suppressed_paths=[r".*"], print_function=events.append)
+    printer.enable()
+    outer_trace = sys.gettrace()
+    assert callable(outer_trace)
+    printer.enable()
+    assert callable(sys.gettrace())
+    def body():
+        return 1
+    body()
+    printer.disable()
+    assert sys.gettrace() is outer_trace
+    printer.disable()
+
+
+def _run_recursive_decorator():
+    calls = []
+    @stackprinter.trace(style="plaintext", suppressed_paths=[r".*"], print_function=lambda _: None)
+    def recurse(depth):
+        calls.append(depth)
+        if depth:
+            recurse(depth - 1)
+    recurse(3)
+    return calls
+
+
+def test_trace_decorator_reuse_for_recursive_calls():
+    assert _run_recursive_decorator() == [3, 2, 1, 0]
+
+
+def test_recursive_decorator_restores_original_hook():
+    previous = sys.gettrace()
+    _run_recursive_decorator()
+    assert sys.gettrace() is previous
+
+
+def test_recursive_trace_decorator_restores_outer_hook_after_exception():
+    previous = sys.gettrace()
+
+    @stackprinter.trace(
+        style="plaintext", suppressed_paths=[r".*"], print_function=lambda _: None
+    )
+    def recurse(depth):
+        if depth == 0:
+            raise ValueError("recursive-trace")
+        outer_hook = sys.gettrace()
+        try:
+            recurse(depth - 1)
+        except ValueError:
+            pass
+        assert sys.gettrace() is outer_hook
+
+    try:
+        recurse(1)
+    finally:
+        sys.settrace(previous)
+
+
+def test_recursive_decorator_exception_restores_original_hook():
+    previous = sys.gettrace()
+
+    @stackprinter.trace(
+        style="plaintext", suppressed_paths=[r".*"], print_function=lambda _: None
+    )
+    def recurse(depth):
+        if depth == 0:
+            raise ValueError("recursive-cleanup")
+        recurse(depth - 1)
+
+    try:
+        with pytest.raises(ValueError, match="recursive-cleanup"):
+            recurse(2)
+        assert sys.gettrace() is previous
+    finally:
+        sys.settrace(previous)
+
+
+def test_disabling_inactive_tracer_is_noop():
+    def sentinel(frame, event, arg):
+        return sentinel
+    printer = stackprinter.TracePrinter(style="plaintext")
+    sys.settrace(sentinel)
+    printer.disable()
+    assert sys.gettrace() is sentinel
+
+
+# --- Atomic suppression F2P nodes: format_thread ---
+
+def test_format_thread_suppressed_paths_tuple_accepted():
+    paths = ("caller-entry",)
+    thread = threading.current_thread()
+    rendered = stackprinter.format_thread(
+        thread, suppressed_paths=paths, source_lines=0, show_vals=False
+    )
+    assert rendered
+    assert paths == ("caller-entry",)
+
+
+def test_format_thread_suppressed_paths_list_not_mutated():
+    paths = ["caller-entry"]
+    snapshot = list(paths)
+    thread = threading.current_thread()
+    first = stackprinter.format_thread(
+        thread, suppressed_paths=paths, source_lines=0, show_vals=False
+    )
+    assert first
+    assert paths == snapshot
+
+
+def test_format_thread_suppressed_paths_list_intact_on_exception():
+    paths = ["caller-entry"]
+    snapshot = list(paths)
+    thread = threading.current_thread()
+    with pytest.raises(ValueError):
+        stackprinter.format_thread(
+            thread, suppressed_paths=paths, show_vals=object()
+        )
+    assert paths == snapshot
+
+
+def test_format_thread_suppressed_paths_repeated_no_accumulation():
+    paths = ["caller-entry"]
+    snapshot = list(paths)
+    thread = threading.current_thread()
+    first = stackprinter.format_thread(
+        thread, suppressed_paths=paths, source_lines=0, show_vals=False
+    )
+    assert first
+    assert paths == snapshot
+    second = stackprinter.format_thread(
+        thread, suppressed_paths=paths, source_lines=0, show_vals=False
+    )
+    assert second
+    assert paths == snapshot
+
+
+# --- Atomic suppression F2P nodes: set_excepthook (IPython) ---
+
+def test_set_excepthook_suppressed_paths_tuple_accepted(monkeypatch):
+    original_hook = lambda *args: None
+    mock_ipython = types.ModuleType("IPython")
+    shell = types.SimpleNamespace(
+        InteractiveTB=types.SimpleNamespace(structured_traceback=original_hook)
+    )
+    mock_ipython.get_ipython = lambda: shell
+    monkeypatch.setitem(sys.modules, "IPython", mock_ipython)
+    monkeypatch.setattr(stackprinter, "_is_running_in_ipython", lambda: True)
+
+    original_ipy_tb = getattr(stackprinter, "ipy_tb", None)
+    original_excepthook = sys.excepthook
+    paths = ("caller-entry",)
+    try:
+        stackprinter.set_excepthook(suppressed_paths=paths)
+        assert shell.InteractiveTB.structured_traceback is not original_hook
+        try:
+            raise ValueError("ipy-test")
+        except ValueError:
+            tb = shell.InteractiveTB.structured_traceback(*sys.exc_info())
+        assert paths == ("caller-entry",)
+    finally:
+        stackprinter.remove_excepthook()
+        stackprinter.ipy_tb = original_ipy_tb
+        sys.excepthook = original_excepthook
+
+
+def test_set_excepthook_suppressed_paths_list_not_mutated(monkeypatch):
+    original_hook = lambda *args: None
+    mock_ipython = types.ModuleType("IPython")
+    shell = types.SimpleNamespace(
+        InteractiveTB=types.SimpleNamespace(structured_traceback=original_hook)
+    )
+    mock_ipython.get_ipython = lambda: shell
+    monkeypatch.setitem(sys.modules, "IPython", mock_ipython)
+    monkeypatch.setattr(stackprinter, "_is_running_in_ipython", lambda: True)
+
+    original_ipy_tb = getattr(stackprinter, "ipy_tb", None)
