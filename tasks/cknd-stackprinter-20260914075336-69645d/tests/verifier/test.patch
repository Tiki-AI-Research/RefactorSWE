+def _ipython_render(monkeypatch, tmp_path, caller_patterns):
+    import importlib.util
+    filename = tmp_path / "site-packages" / "IPython" / "audit_frame.py"
+    filename.parent.mkdir(parents=True)
+    filename.write_text("def application():\n    marker = 'internal-source'\n    extra = 17\n    raise ValueError(marker)\n")
+    spec = importlib.util.spec_from_file_location("audit_ipython_frame", filename)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    original_hook = lambda *args: None
+    shell = types.SimpleNamespace(InteractiveTB=types.SimpleNamespace(structured_traceback=original_hook))
+    mock = types.ModuleType("IPython")
+    mock.get_ipython = lambda: shell
+    monkeypatch.setitem(sys.modules, "IPython", mock)
+    # Simulate the public IPython marker, without binding the detector helper.
+    monkeypatch.setattr(stackprinter, "__IPYTHON__", True, raising=False)
+    old_sys, old_ipy = sys.excepthook, getattr(stackprinter, "ipy_tb", None)
+    try:
+        assert stackprinter.set_excepthook(suppressed_paths=caller_patterns,
+                 source_lines="all", show_vals=False, show_signature=False, add_summary=False) is None
+        try:
+            module.application()
+        except ValueError:
+            rendered = shell.InteractiveTB.structured_traceback(*sys.exc_info())
+        assert isinstance(rendered, list) and len(rendered) == 1
+        return rendered[0], str(filename)
+    finally:
+        stackprinter.remove_excepthook()
+        stackprinter.ipy_tb = old_ipy
+        sys.excepthook = old_sys
+
