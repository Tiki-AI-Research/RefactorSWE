+"""Sink-failure recovery checks (public behavior only)."""
+
+import sys
+import threading
+import pytest
+
+import stackprinter
+
+
+def _sentinel():
+    def sentinel(frame, event, arg):
+        return sentinel
+    return sentinel
+
+
+def test_manual_activation_restores_predecessor_after_sink_failure():
+    previous = sys.gettrace()
+    sentinel = _sentinel()
+    failure = RuntimeError("manual-sink-failure")
+
+    def sink(message):
+        raise failure
+
+    printer = stackprinter.TracePrinter(
+        style="plaintext", suppressed_paths=[r".*"],
+        print_function=sink, depth_limit=7,
+    )
+    caught = None
+    try:
+        sys.settrace(sentinel)
+        try:
+            printer.enable(force=True)
+
+            def body():
+                return 1
+
+            body()
+        except RuntimeError as error:
+            caught = error
+        assert caught is not None  # Guard: exercise the failure path.
+        printer.disable()
+        assert sys.gettrace() is sentinel
+    finally:
+        sys.settrace(previous)
+
+
+@pytest.mark.parametrize("boundary", ["outer", "original"])
+def test_nested_context_restores_outer_hook_after_sink_failure(boundary):
+    previous = sys.gettrace()
+    failure = RuntimeError("nested-context-sink-failure")
+
+    def sink(message):
+        raise failure
+
+    messages = []
+    outer = stackprinter.TracePrinter(style="plaintext", suppressed_paths=[r".*"],
+                                      print_function=messages.append)
+    inner = stackprinter.TracePrinter(style="plaintext", suppressed_paths=[r".*"],
+                                      print_function=sink)
+    caught = None
+    try:
+        assert sys.gettrace() is previous
+        with outer:
+            outer_hook = sys.gettrace()
+            assert callable(outer_hook) and outer_hook is not previous
+            try:
+                with inner:
+
+                    def body():
+                        return 1
+
+                    body()
+            except RuntimeError as error:
+                caught = error
+            assert caught is not None  # Guard: exercise the failure path.
+            if boundary == "outer":
+                assert sys.gettrace() is outer_hook
+        if boundary == "original":
+            assert sys.gettrace() is previous
+    finally:
+        sys.settrace(previous)
+
