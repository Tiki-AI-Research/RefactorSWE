+def _source_blocks(rendered, filename):
+    blocks = re.split(r'(?=^\s*File ")', rendered, flags=re.MULTILINE)
+    return [block for block in blocks if block.lstrip().startswith('File "')
+            and filename in block.splitlines()[0]]
+
+
+def _source_line_count(block):
+    lines = block.splitlines()
+    indent = len(lines[0]) - len(lines[0].lstrip())
+    return sum(bool(line.strip()) and len(line) - len(line.lstrip()) > indent
+               for line in lines[1:])
+
