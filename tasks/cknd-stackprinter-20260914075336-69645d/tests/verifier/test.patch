+import threading
+import types
+"""Additional atomic compatibility checks for the refactoring task."""
+
+import io
+import re
+import sys
+
+import pytest
+
+import stackprinter
+
+
+def _raise_value_error():
+    raise ValueError("compatibility-error")
+
+
+def _nested_raise():
+    _raise_value_error()
+
+
+def _capture_error():
+    try:
+        _nested_raise()
+    except ValueError as error:
+        return error
+    raise AssertionError("fixture did not raise")
+
+
+def _render(error, **kwargs):
+    options = dict(source_lines=0, show_vals=False, show_signature=False,
+                   add_summary=False)
+    options.update(kwargs)
+    return stackprinter.format(error, **options)
+
+
+def test_format_accepts_exception_instance():
+    message = _render(_capture_error())
+    assert message.endswith("ValueError: compatibility-error")
+
+
+def test_format_accepts_exception_information_tuple():
+    error = _capture_error()
+    message = _render((type(error), error, error.__traceback__))
+    assert message.endswith("ValueError: compatibility-error")
+
+
+def test_format_accepts_frame_object():
+    frame = sys._getframe()
+    message = stackprinter.format(frame, source_lines=0, show_vals=False)
+    assert "test_format_accepts_frame_object" in message
+
+
+def test_format_current_stack_uses_caller_frame():
+    message = stackprinter.format_current_stack(source_lines=0, show_vals=False)
+    assert "test_format_current_stack_uses_caller_frame" in message
+
+
+def test_format_current_exception_uses_active_exception():
+    try:
+        _raise_value_error()
+    except ValueError:
+        message = stackprinter.format_current_exception(
+            source_lines=0, show_vals=False, show_signature=False,
+            add_summary=False
+        )
+    assert message.endswith("ValueError: compatibility-error")
+
+
+def test_show_current_exception_writes_one_newline():
+    destination = io.StringIO()
+    try:
+        _raise_value_error()
+    except ValueError:
+        stackprinter.show_current_exception(
+            file=destination, source_lines=0, show_vals=False,
+            show_signature=False, add_summary=False
+        )
+    assert destination.getvalue().endswith("ValueError: compatibility-error\n")
+
+
+def test_show_current_exception_returns_none():
+    destination = io.StringIO()
+    try:
+        _raise_value_error()
+    except ValueError:
+        result = stackprinter.show_current_exception(
+            file=destination, source_lines=0, show_vals=False,
+            show_signature=False, add_summary=False
+        )
+    assert result is None
+
+
+def test_show_current_stack_writes_to_stderr_by_default(monkeypatch):
+    destination = io.StringIO()
+    monkeypatch.setattr(sys, "stderr", destination)
+    stackprinter.show_current_stack(source_lines=0, show_vals=False)
+    assert "test_show_current_stack_writes_to_stderr_by_default" in destination.getvalue()
+
+
+def test_show_current_stack_returns_none(monkeypatch):
+    destination = io.StringIO()
+    monkeypatch.setattr(sys, "stderr", destination)
+    result = stackprinter.show_current_stack(source_lines=0, show_vals=False)
+    assert result is None
+
+
+def test_show_accepts_stdout_alias(monkeypatch):
+    destination = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", destination)
+    stackprinter.show(_capture_error(), file="stdout", source_lines=0,
+                      show_vals=False, show_signature=False, add_summary=False)
+    assert destination.getvalue().endswith("ValueError: compatibility-error\n")
+
+
+def test_none_exception_information_is_rendered():
+    assert stackprinter.format((None, None, None)) == "NoneType: None"
+
+
+def test_none_exception_value_is_rendered():
+    assert stackprinter.format((TypeError, None, None)) == "TypeError: None"
+
+
+def test_exception_without_traceback_is_rendered():
+    assert stackprinter.format(ValueError("no traceback"), source_lines=0).endswith(
+        "ValueError: no traceback"
+    )
+
+
+def test_explicit_cause_has_standard_separator():
+    cause = ValueError("compat-cause")
+    error = RuntimeError("compat-main")
+    error.__cause__ = cause
+    message = _render(error)
+    assert "The above exception was the direct cause of the following exception:" in message
+
+
+def test_implicit_context_has_standard_separator():
+    context = ValueError("compat-context")
+    error = RuntimeError("compat-main")
+    error.__context__ = context
+    message = _render(error)
+    assert "While handling the above exception, another exception occurred:" in message
+
+
+def test_suppressed_context_is_not_rendered():
+    error = RuntimeError("compat-main")
+    error.__context__ = ValueError("hidden-context")
