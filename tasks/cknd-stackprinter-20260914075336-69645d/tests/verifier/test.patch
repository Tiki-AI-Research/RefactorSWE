+    snapshot = list(paths)
+    try:
+        stackprinter.set_excepthook(suppressed_paths=paths)
+        assert shell.InteractiveTB.structured_traceback is not original_hook
+        try:
+            raise ValueError("ipy-test")
+        except ValueError:
+            tb = shell.InteractiveTB.structured_traceback(*sys.exc_info())
+        assert paths == snapshot
+    finally:
+        stackprinter.remove_excepthook()
+        stackprinter.ipy_tb = original_ipy_tb
+        sys.excepthook = original_excepthook
+
+
+def test_set_excepthook_suppressed_paths_list_intact_on_exception(monkeypatch):
+    mock_ipython = types.ModuleType("IPython")
+    def fail_get_ipython():
+        raise RuntimeError("ipython-failure")
+    mock_ipython.get_ipython = fail_get_ipython
+    monkeypatch.setitem(sys.modules, "IPython", mock_ipython)
+    monkeypatch.setattr(stackprinter, "_is_running_in_ipython", lambda: True)
+
