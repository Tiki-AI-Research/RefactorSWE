+# --- Atomic plain alias F2P nodes ---
+
+def test_plain_style_alias_matches_plaintext_single_exception():
+    marker = "\x1b[31mf2p-error\x1b[0m"
+    error = _capture_error(marker)
+    rendered_plain = _render(error, style="plain")
+    rendered_plaintext = _render(error, style="plaintext")
+    assert rendered_plain == rendered_plaintext
+    assert marker in rendered_plain
+    assert not re.search(r"\x1b\[[0-9;]*[a-zA-Z]", rendered_plain.replace(marker, ""))
+
+
+def test_plain_style_alias_matches_plaintext_explicit_cause():
+    cause_marker = "\x1b[31minner-cause\x1b[0m"
+    outer_marker = "\x1b[34mouter-explicit\x1b[0m"
+    try:
+        try:
+            raise ValueError(cause_marker)
+        except ValueError as cause:
+            raise RuntimeError(outer_marker) from cause
+    except RuntimeError as error:
+        err = error
+    rendered_plain = _render(err, style="plain")
+    rendered_plaintext = _render(err, style="plaintext")
+    assert rendered_plain == rendered_plaintext
+    assert cause_marker in rendered_plain and outer_marker in rendered_plain
+    assert "direct cause of the following exception" in rendered_plain
+    unstyled = rendered_plain.replace(cause_marker, "").replace(outer_marker, "")
+    assert not re.search(r"\x1b\[[0-9;]*[a-zA-Z]", unstyled)
+
+
+def test_plain_style_alias_matches_plaintext_implicit_context():
+    context_marker = "\x1b[32minner-context\x1b[0m"
+    outer_marker = "\x1b[35mouter-implicit\x1b[0m"
+    try:
+        try:
+            raise ValueError(context_marker)
+        except ValueError:
+            raise RuntimeError(outer_marker)
+    except RuntimeError as error:
+        err = error
+    rendered_plain = _render(err, style="plain")
+    rendered_plaintext = _render(err, style="plaintext")
+    assert rendered_plain == rendered_plaintext
+    assert context_marker in rendered_plain and outer_marker in rendered_plain
+    assert "While handling the above exception" in rendered_plain
+    unstyled = rendered_plain.replace(context_marker, "").replace(outer_marker, "")
+    assert not re.search(r"\x1b\[[0-9;]*[a-zA-Z]", unstyled)
+
+
+@pytest.mark.parametrize("with_traceback", [True, False], ids=["traceback", "no_traceback"])
+def test_plain_style_alias_matches_plaintext_show_stream_output(with_traceback):
+    marker = "\x1b[31mraw-value\x1b[0m"
+    error = _capture_error(marker) if with_traceback else ValueError(marker)
+    streams = {}
+    for style in ("plain", "plaintext"):
+        stream = io.StringIO()
+        assert stackprinter.show(error, file=stream, style=style,
+                                 source_lines=0, show_vals=False) is None
+        streams[style] = stream.getvalue()
+    expected = stackprinter.format(error, style="plaintext", source_lines=0,
+                                   show_vals=False) + "\n"
+    assert streams["plain"] == streams["plaintext"] == expected
+    assert streams["plain"].endswith("\n")
+    assert "ValueError:" in streams["plain"]
+    assert marker in streams["plain"]
+    assert not re.search(r"\x1b\[[0-9;]*[a-zA-Z]",
+                         streams["plain"].replace(marker, ""))
+
+
+@pytest.mark.parametrize("location", ["function", "caller"])
+def test_fresh_raise_after_caught_inner_exception_stops_outer(location):
+    def raise_error(error):
+        raise error
+    outer = stackprinter.TracePrinter(style="plaintext", suppressed_paths=[r".*"],
+                                      print_function=lambda _: None)
+    inner = stackprinter.TracePrinter(style="plaintext", suppressed_paths=[r".*"],
+                                      print_function=lambda _: None)
+    error = ValueError("reused-exception")
+    with outer:
+        outer_hook = sys.gettrace()
+        try:
+            with inner:
+                raise_error(error)
+        except ValueError:
+            pass
+        # Reachability guard: premature outer shutdown must not satisfy this test.
+        assert sys.gettrace() is outer_hook and outer_hook is not None
+        try:
+            if location == "function":
+                raise_error(error)
+            else:
+                raise error
+        except ValueError:
+            pass
+        assert sys.gettrace() is None
