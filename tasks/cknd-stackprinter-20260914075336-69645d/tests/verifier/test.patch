+
+def test_set_excepthook_suppressed_paths_intact_when_handler_format_raises(monkeypatch):
+    original_hook = lambda *args: None
+    mock_ipython = types.ModuleType("IPython")
+    shell = types.SimpleNamespace(
+        InteractiveTB=types.SimpleNamespace(structured_traceback=original_hook)
+    )
+    mock_ipython.get_ipython = lambda: shell
