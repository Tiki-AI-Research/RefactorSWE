+def test_overlapping_thread_activations_restore_each_thread_hook():
+    printer = stackprinter.TracePrinter(
+        style="plaintext", suppressed_paths=[r".*"],
+        print_function=lambda _message: None, stop_on_exception=False,
+    )
+    a_enabled = threading.Event()
+    b_enabled = threading.Event()
+    a_finished = threading.Event()
+    restored = []
+    failures = []
+
+    def worker_a():
+        def sentinel(frame, event, arg):
+            return sentinel
+
+        sys.settrace(sentinel)
+        try:
+            printer.enable(force=True)
+            a_enabled.set()
+            assert b_enabled.wait(timeout=5)
+            printer.disable()
+            restored.append(("a", sys.gettrace() is sentinel))
+        except BaseException as error:
+            failures.append(("a", error))
+        finally:
+            a_finished.set()
+            sys.settrace(None)
+
+    def worker_b():
+        def sentinel(frame, event, arg):
+            return sentinel
+
+        try:
+            assert a_enabled.wait(timeout=5)
+            sys.settrace(sentinel)
+            printer.enable(force=True)
+            b_enabled.set()
+            assert a_finished.wait(timeout=5)
+            printer.disable()
+            restored.append(("b", sys.gettrace() is sentinel))
+        except BaseException as error:
+            failures.append(("b", error))
+        finally:
+            b_enabled.set()
+            sys.settrace(None)
+
+    threads = [threading.Thread(target=worker_a), threading.Thread(target=worker_b)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=10)
+    assert all(not thread.is_alive() for thread in threads)
+    assert not failures, failures
+    assert sorted(restored) == [("a", True), ("b", True)]
+
