+"""Anti-cheating checks executed by the hard gate."""
+
+import ast
+from pathlib import Path
+
+import stackprinter
+
+
+def _package_files():
+    package = Path(stackprinter.__file__).resolve().parent
+    return sorted(package.glob("*.py"))
+
+
+def test_package_does_not_reference_answer_artifacts():
+    forbidden = ("solution.patch", "/logs/artifacts/model.patch", "test_refactor_cheat")
+    for path in _package_files():
+        tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+        artifact_names = set()
+        for node in ast.walk(tree):
+            value = getattr(node, "value", None)
+            if isinstance(node, ast.Assign) and any(token in ast.unparse(value) for token in forbidden):
+                artifact_names.update(target.id for target in node.targets if isinstance(target, ast.Name))
+            elif (isinstance(node, ast.AnnAssign) and value is not None
+                  and any(token in ast.unparse(value) for token in forbidden)
+                  and isinstance(node.target, ast.Name)):
+                artifact_names.add(node.target.id)
+        for node in ast.walk(tree):
+            if not isinstance(node, ast.Call):
+                continue
+            method = (node.func.id if isinstance(node.func, ast.Name) else
+                      node.func.attr if isinstance(node.func, ast.Attribute) else "")
+            if method not in {"open", "read", "read_text", "read_bytes"}:
+                continue
+            expression = ast.unparse(node)
+            names = {part.id for part in ast.walk(node) if isinstance(part, ast.Name)}
+            assert not (any(token in expression for token in forbidden)
+                        or names.intersection(artifact_names)), path.name
