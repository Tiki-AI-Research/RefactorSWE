+def _park_worker():
+    import time
+    ready, release = threading.Event(), threading.Event()
+    def worker():
+        ready.set()
+        release.wait()
+    thread = threading.Thread(target=worker)
+    thread.start()
+    assert ready.wait(5)
+    deadline = time.monotonic() + 5
+    while True:
+        frame = sys._current_frames()[thread.ident]
+        if frame.f_code.co_name == "wait" and frame.f_back.f_code.co_name == "wait":
+            break
+        assert time.monotonic() < deadline, "worker did not reach its stable wait"
+        time.sleep(.005)
+    return thread, release
+
+
+def test_format_thread_internal_suppression_pattern_effective():
+    thread, release = _park_worker()
+    try:
+        out = stackprinter.format_thread(thread, suppressed_paths=["caller-no-match"],
+                source_lines="all", show_vals=False, show_signature=False)
+        blocks = _source_blocks(out, "threading.py")
+        assert len(blocks) >= 2, out
+        assert all(_source_line_count(block) == 1 for block in blocks), out
+    finally:
+        release.set()
+        thread.join(5)
+
+
+def test_format_thread_caller_pattern_precedes_internal_pattern():
+    # Both caller rules must remain effective, independently of internal regex representation.
+    thread, release = _park_worker()
+    try:
+        out = stackprinter.format_thread(thread,
+                suppressed_paths=["caller-no-match", re.compile(re.escape(__file__))],
+                source_lines="all", show_vals=False, show_signature=False)
+        blocks = _source_blocks(out, __file__)
+        assert blocks and all(_source_line_count(block) == 1 for block in blocks), out
+    finally:
+        release.set()
+        thread.join(5)
+
