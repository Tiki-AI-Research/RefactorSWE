+class ExceptionNode:
+    """
+    Structured intermediate representation of an exception in an exception graph/tree.
+    """
+    def __init__(self,
+                 exc_type,
+                 exc_value=None,
+                 traceback=None,
+                 frames=None,
+                 chain_type=None,
+                 parent=None,
+                 chain_parent=None,
+                 sub_exceptions=None,
+                 is_group=False,
+                 is_cycle=False):
+        self.exc_type = exc_type
+        self.exc_value = exc_value
+        self.traceback = traceback
+        self.frames = frames if frames is not None else []
+        self.chain_type = chain_type
+        self.parent = parent
+        self.chain_parent = chain_parent
+        self.sub_exceptions = sub_exceptions if sub_exceptions is not None else []
+        self.is_group = is_group
+        self.is_cycle = is_cycle
+
+    @property
+    def depth(self) -> int:
+        d = 0
+        curr = self.parent
+        while curr is not None:
+            d += 1
+            curr = curr.parent
+        return d
+
+    @property
+    def leaves(self) -> list['ExceptionNode']:
+        """
+        Return all concrete leaf exception nodes (non-group nodes with no sub_exceptions),
+        in preorder traversal order.
+        """
+        return [node for node in self.walk(order='preorder')
+                if not node.is_group and not node.sub_exceptions]
+
+    def walk(self, order='preorder', _visited=None):
+        if _visited is None:
+            _visited = set()
+        node_id = id(self)
+        if node_id in _visited:
+            return
+        _visited.add(node_id)
+
+        if order == 'preorder':
+            yield self
+            if self.chain_parent is not None:
+                yield from self.chain_parent.walk(order=order, _visited=_visited)
+            for sub in self.sub_exceptions:
+                yield from sub.walk(order=order, _visited=_visited)
+        elif order == 'postorder':
+            if self.chain_parent is not None:
+                yield from self.chain_parent.walk(order=order, _visited=_visited)
+            for sub in self.sub_exceptions:
+                yield from sub.walk(order=order, _visited=_visited)
+            yield self
+        else:
+            raise ValueError(f"Unknown order: {order}")
+
+    def find(self, exc_type):
+        return [n for n in self.walk(order='preorder')
+                if n.exc_type and issubclass(n.exc_type, exc_type)]
+
+    def filter(self, predicate):
+        """
+        Recursively filter and prune the exception tree without mutating the original tree.
+        """
+        if self.is_group:
+            filtered_subs = []
+            for sub in self.sub_exceptions:
+                res = sub.filter(predicate)
+                if res is not None:
+                    filtered_subs.append(res)
+
+            self_matches = predicate(self)
+            if not filtered_subs and not self_matches:
+                return None
+
+            filtered_chain_parent = None
+            if self.chain_parent is not None:
+                filtered_chain_parent = self.chain_parent.filter(predicate)
+
+            new_node = ExceptionNode(
+                exc_type=self.exc_type,
+                exc_value=self.exc_value,
+                traceback=self.traceback,
+                frames=list(self.frames),
+                chain_type=self.chain_type,
+                parent=None,
+                chain_parent=filtered_chain_parent,
+                sub_exceptions=filtered_subs,
+                is_group=True,
+                is_cycle=self.is_cycle
+            )
+            for sub in filtered_subs:
+                sub.parent = new_node
+            if filtered_chain_parent is not None:
+                filtered_chain_parent.parent = new_node
+            return new_node
+        else:
+            if not predicate(self):
+                return None
+
+            filtered_chain_parent = None
+            if self.chain_parent is not None:
+                filtered_chain_parent = self.chain_parent.filter(predicate)
+
+            new_node = ExceptionNode(
+                exc_type=self.exc_type,
+                exc_value=self.exc_value,
+                traceback=self.traceback,
+                frames=list(self.frames),
+                chain_type=self.chain_type,
+                parent=None,
+                chain_parent=filtered_chain_parent,
+                sub_exceptions=[],
+                is_group=False,
+                is_cycle=self.is_cycle
+            )
+            if filtered_chain_parent is not None:
+                filtered_chain_parent.parent = new_node
+            return new_node
+
+    def __repr__(self):
+        name = self.exc_type.__name__ if self.exc_type else 'None'
+        return (f"<ExceptionNode {name}, chain_type={self.chain_type!r}, "
+                f"is_group={self.is_group}, is_cycle={self.is_cycle}>")
+
+
+def build_exception_tree(etype, evalue, tb, suppressed_vars=None,
+                         _ancestors=None, _parent=None, _chain_type=None) -> ExceptionNode:
+    """
+    Construct a structured ExceptionNode tree with cycle detection and DAG support.
+    """
+    if etype is None:
+        etype = type(evalue) if evalue is not None else type(None)
+
+    if _ancestors is None:
+        _ancestors = set()
+
+    is_cycle = False
+    exc_id = id(evalue) if evalue is not None else None
+    if exc_id is not None and exc_id in _ancestors:
+        is_cycle = True
+
+    is_group = False
+    if evalue is not None:
+        if isinstance(evalue, BaseExceptionGroup):
+            is_group = True
+
+    frames = []
+    if tb and not is_cycle:
+        frames = [ex.get_info(tb_, suppressed_vars=suppressed_vars or [])
+                  for tb_ in _walk_traceback(tb)]
+
+    node = ExceptionNode(
+        exc_type=etype,
+        exc_value=evalue,
+        traceback=tb,
+        frames=frames,
+        chain_type=_chain_type,
+        parent=_parent,
+        is_group=is_group,
+        is_cycle=is_cycle
+    )
+
+    if is_cycle:
+        return node
+
+    new_ancestors = set(_ancestors)
+    if exc_id is not None:
+        new_ancestors.add(exc_id)
+
+    # 1. Causality chain traversal
+    cause = getattr(evalue, '__cause__', None)
+    context = getattr(evalue, '__context__', None)
+    suppress_context = getattr(evalue, '__suppress_context__', False)
+
+    chain_exc = None
+    chain_type = None
+    if cause is not None:
+        chain_exc = cause
+        chain_type = 'cause'
+    elif context is not None and not suppress_context:
+        chain_exc = context
+        chain_type = 'context'
+
+    if chain_exc is not None:
+        chain_node = build_exception_tree(
+            chain_exc.__class__,
+            chain_exc,
+            getattr(chain_exc, '__traceback__', None),
+            suppressed_vars=suppressed_vars,
+            _ancestors=new_ancestors,
+            _parent=node,
+            _chain_type=chain_type
+        )
+        node.chain_parent = chain_node
+
+    # 2. Sub-exceptions traversal for ExceptionGroup
+    if is_group and hasattr(evalue, 'exceptions'):
+        sub_nodes = []
+        for sub_exc in evalue.exceptions:
+            sub_node = build_exception_tree(
+                sub_exc.__class__,
+                sub_exc,
+                getattr(sub_exc, '__traceback__', None),
+                suppressed_vars=suppressed_vars,
+                _ancestors=new_ancestors,
+                _parent=node,
+                _chain_type='group_sub'
+            )
+            sub_nodes.append(sub_node)
+        node.sub_exceptions = sub_nodes
+
+    return node
+
+
+class TracebackRenderer:
+    """
+    Dedicated renderer pipeline for structured ExceptionNode trees.
+    """
+    def __init__(self, style='plaintext', source_lines=5, source_lines_after=1,
+                 show_signature=True, show_vals='like_source', truncate_vals=500,
+                 line_wrap=60, reverse=False, suppressed_paths=None,
+                 suppressed_vars=None, suppressed_exceptions=[KeyboardInterrupt],
+                 add_summary='auto'):
+        self.style = style
+        self.source_lines = source_lines
+        self.source_lines_after = source_lines_after
+        self.show_signature = show_signature
+        self.show_vals = show_vals
+        self.truncate_vals = truncate_vals
+        self.line_wrap = line_wrap
+        self.reverse = reverse
+        self.suppressed_paths = suppressed_paths
+        self.suppressed_vars = suppressed_vars if suppressed_vars is not None else []
+        self.suppressed_exceptions = suppressed_exceptions
+        self.add_summary = add_summary
+
+    def render(self, node: ExceptionNode) -> str:
+        try:
+            return self._render_node(node)
+        except Exception as exc:
+            import os
+            if 'PY_STACKPRINTER_DEBUG' in os.environ:
+                raise
+
+            our_tb = traceback.format_exception(exc.__class__,
+                                                exc,
+                                                exc.__traceback__,
+                                                chain=False)
+            where = getattr(exc, 'where', None)
+            context = " while formatting " + str(where) if where else ''
+            msg = 'Stackprinter failed%s:\n%s\n' % (context, ''.join(our_tb[-2:]))
+            msg += 'So here is your original traceback at least:\n\n'
+            msg += ''.join(traceback.format_exception(node.exc_type, node.exc_value, node.traceback))
+            return msg
+
+    def _render_node(self, node: ExceptionNode, indent_level: int = 0) -> str:
+        if node.is_cycle:
+            type_name = node.exc_type.__name__ if node.exc_type else "Exception"
+            return f"[Circular reference in exception chain: {type_name} already formatted]\n"
+
+        parts = []
+        if node.frames:
+            if (self.suppressed_exceptions and
+                issubclass(node.exc_type, tuple(self.suppressed_exceptions))):
+                summary = format_summary(node.frames, style=self.style,
+                                         reverse=self.reverse,
+                                         source_lines=self.source_lines)
+                parts = [summary]
+            else:
+                whole_stack = format_stack(node.frames, style=self.style,
+                                           source_lines=self.source_lines,
+                                           source_lines_after=self.source_lines_after,
+                                           show_signature=self.show_signature,
+                                           show_vals=self.show_vals,
+                                           truncate_vals=self.truncate_vals,
+                                           line_wrap=self.line_wrap,
+                                           reverse=self.reverse,
+                                           suppressed_paths=self.suppressed_paths,
+                                           suppressed_vars=self.suppressed_vars)
+                parts.append(whole_stack)
+
+                add_sum = self.add_summary
+                if add_sum == 'auto':
+                    add_sum = whole_stack.count('\n') > 50
+
+                if add_sum:
+                    summary = format_summary(node.frames, style=self.style,
+                                             reverse=self.reverse)
+                    summary += '\n'
+                    parts.append('---- (full traceback below) ----\n\n' if self.reverse else
+                                 '---- (full traceback above) ----\n')
+                    parts.append(summary)
+
+        exc = format_exception_message(node.exc_type, node.exc_value, style=self.style)
+        parts.append('\n\n' if self.reverse else '')
+        parts.append(exc)
+
+        if self.reverse:
+            parts = list(reversed(parts))
+
+        curr_msg = ''.join(parts)
+
+        msg = ''
+        if not self.reverse:
+            if node.chain_parent:
+                parent_msg = self._render_node(node.chain_parent, indent_level=indent_level)
+                msg += parent_msg
+                if node.chain_parent.chain_type == 'cause':
+                    chain_hint = ("\n\nThe above exception was the direct cause "
+                                  "of the following exception:\n\n")
+                else:
+                    chain_hint = ("\n\nWhile handling the above exception, "
+                                  "another exception occurred:\n\n")
+                if self.style == 'plaintext':
+                    msg += chain_hint
+                else:
+                    sc = getattr(colorschemes, self.style)
+                    clr = get_ansi_tpl(*sc.colors['exception_type'])
+                    msg += clr % chain_hint
+            msg += curr_msg
+        else:
+            msg += curr_msg
+            if node.chain_parent:
+                if node.chain_parent.chain_type == 'cause':
+                    chain_hint = ("\n\nThe above exception was the direct cause "
+                                  "of the following exception:\n\n")
+                else:
+                    chain_hint = ("\n\nWhile handling the above exception, "
+                                  "another exception occurred:\n\n")
+                if self.style == 'plaintext':
+                    msg += chain_hint
+                else:
+                    sc = getattr(colorschemes, self.style)
+                    clr = get_ansi_tpl(*sc.colors['exception_type'])
+                    msg += clr % chain_hint
+                parent_msg = self._render_node(node.chain_parent, indent_level=indent_level)
+                msg += parent_msg
+
+        if node.is_group and node.sub_exceptions:
+            group_sections = []
+            indent_str = "  " * (indent_level + 1)
+            for idx, sub_node in enumerate(node.sub_exceptions, start=1):
+                branch_header = f"\n{indent_str}+---------------- {idx} ----------------\n"
+                sub_rendered = self._render_node(sub_node, indent_level=indent_level + 1)
+                rail_prefix = indent_str + "| "
+                empty_rail = indent_str + "|"
+                indented_lines = [
+                    rail_prefix + line if line else empty_rail
+                    for line in sub_rendered.rstrip('\n').split('\n')
+                ]
+                group_sections.append(branch_header + "\n".join(indented_lines) + "\n")
+            msg += ''.join(group_sections)
+
+        return msg
+
