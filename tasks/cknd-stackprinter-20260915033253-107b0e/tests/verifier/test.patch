+def test_f2p_two_phase_entrypoint():
+    """Observe objects crossing real calls; aliases and decorated builders are legal."""
+    from stackprinter import formatting as fmt
+    error = ValueError('two_phase_entry')
+    built, consumed = [], []
+
+    def observe(frame, event, result):
+        if event == 'return' and isinstance(result, fmt.ExceptionNode):
+            if result.exc_value is error:
+                built.append(result)
+        elif event == 'call':
+            values = list(frame.f_locals.values())
+            if any(isinstance(value, fmt.TracebackRenderer) for value in values):
+                consumed.extend(value for value in values
+                                if isinstance(value, fmt.ExceptionNode) and value.exc_value is error)
+
+    previous = sys.getprofile()
+    try:
+        sys.setprofile(observe)
+        output = fmt.format_exc_info(type(error), error, None, add_summary=False)
+    finally:
+        sys.setprofile(previous)
+    assert 'ValueError: two_phase_entry' in output
+    assert built, 'entrypoint must construct a reusable ExceptionNode'
+    assert any(node is candidate for node in consumed for candidate in built), (
+        'the renderer must consume the constructed IR, not a parallel monolithic traceback')
+
