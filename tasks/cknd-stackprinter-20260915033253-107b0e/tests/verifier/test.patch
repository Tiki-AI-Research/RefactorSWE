+def test_f2p_exception_group_native_formatting():
+    """Verify native ExceptionGroup tree rendering with branch separators, indentation and variables."""
+    def sub1():
+        local_alpha_marker = "alpha_42_marker"
+        raise KeyError("missing_key_x")
+
+    def sub2():
+        local_beta_marker = "beta_99_marker"
+        raise IndexError("index_out_of_bounds")
+
+    def raise_group():
+        try:
+            sub1()
+        except KeyError as e1:
+            try:
+                sub2()
+            except IndexError as e2:
+                raise ExceptionGroup("BatchOperationFailed", [e1, e2])
+
+    try:
+        raise_group()
+    except ExceptionGroup as eg:
+        output = stackprinter.format(eg)
+        assert "BatchOperationFailed" in output
+        assert "+---------------- 1 ----------------" in output
+        assert "+---------------- 2 ----------------" in output
+        assert "| " in output
+        assert "KeyError: 'missing_key_x'" in output
+        assert "IndexError: index_out_of_bounds" in output
+        # Verify stackprinter rich frame variables are rendered (not fallback standard library)
+        assert "alpha_42_marker" in output
+        assert "beta_99_marker" in output
