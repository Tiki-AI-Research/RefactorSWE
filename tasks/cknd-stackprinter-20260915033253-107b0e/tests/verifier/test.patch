+@pytest.mark.parametrize('grouped', [False, True], ids=['single', 'group'])
+def test_f2p_source_lines_after_window(tmp_path, grouped):
+    import importlib.util
+    from stackprinter.formatting import build_exception_tree, TracebackRenderer
+
+    source = tmp_path / 'window_fixture.py'
+    source.write_text('def fail():\n    before = 7\n    raise ValueError("window_failure")\n    after_window_marker = 9\n    second_window_marker = 10\n')
+    spec = importlib.util.spec_from_file_location('window_fixture', source)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    try:
+        module.fail()
+    except ValueError as caught:
+        error = caught.with_traceback(caught.__traceback__.tb_next)
+    if grouped:
+        error = ExceptionGroup('window_group', [error])
+    node = build_exception_tree(type(error), error, error.__traceback__)
+    options = dict(style='plaintext', source_lines=8, show_vals=False, add_summary=False)
+    before = TracebackRenderer(source_lines_after=0, **options).render(node)
+    after = TracebackRenderer(source_lines_after=2, **options).render(node)
+    assert 'window_failure' in before and 'window_failure' in after
+    assert 'after_window_marker' not in before
+    assert 'after_window_marker' in after
+    assert 'second_window_marker' not in before
+    assert 'second_window_marker' in after
