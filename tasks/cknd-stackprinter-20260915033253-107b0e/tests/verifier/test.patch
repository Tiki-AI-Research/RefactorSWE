+def test_f2p_cycle_detection():
+    """Verify cycle detection breaks recursive chains and renders circular marker."""
+    from stackprinter.formatting import build_exception_tree, TracebackRenderer
+    
+    e1 = ValueError("loop1")
+    e2 = RuntimeError("loop2")
+    e1.__cause__ = e2
+    e2.__cause__ = e1
+
+    node = build_exception_tree(e1.__class__, e1, None)
+    assert node.chain_parent is not None
+    assert node.chain_parent.chain_parent is not None
+    assert node.chain_parent.chain_parent.is_cycle is True
+
+    renderer = TracebackRenderer(style="plaintext")
+    output = renderer.render(node)
+    assert re.search(r"\b(?:circular|cycle|recurs\w*|loop)\b", output, re.I)
+    assert "already formatted" in output or "loop1" in output
