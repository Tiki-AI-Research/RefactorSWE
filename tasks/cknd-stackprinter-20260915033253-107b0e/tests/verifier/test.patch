+    # Give the group a real traceback, independently of its children.
+    error = error.with_traceback(leaf.__traceback__)
+    node = build_exception_tree(type(error), error, error.__traceback__)
+    output = TracebackRenderer(source_lines=0, show_vals=False, add_summary=False).render(node)
+    header = output.index('ExceptionGroup: header_contract')
+    first = output.index('+---------------- 1 ----------------')
+    second = output.index('+---------------- 2 ----------------')
