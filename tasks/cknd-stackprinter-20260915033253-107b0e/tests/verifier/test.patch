+def test_f2p_tree_dag_vs_cycle_distinction():
+    """Verify DAG exception reuse is not false-positive cycle, while real ancestor loops are caught."""
+    from stackprinter.formatting import build_exception_tree
+
+    # Diamond / DAG reuse across sibling branches in ExceptionGroup
+    shared_exc = ValueError("shared_root_cause")
+    eg = ExceptionGroup("DAG_Group", [shared_exc, shared_exc])
+
+    node = build_exception_tree(eg.__class__, eg, None)
+    assert node.is_group is True
+    assert len(node.sub_exceptions) == 2
+    assert node.sub_exceptions[0].is_cycle is False
+    assert node.sub_exceptions[1].is_cycle is False
+    assert node.sub_exceptions[0].exc_value is shared_exc
+    assert node.sub_exceptions[1].exc_value is shared_exc
+
+    # Real ancestor loop involving an ExceptionGroup sub-exception causing the group
+    e_child = RuntimeError("child_that_caused_group")
+    eg_with_loop = ExceptionGroup("LoopGroup", [e_child])
+    e_child.__cause__ = eg_with_loop
+
+    loop_node = build_exception_tree(eg_with_loop.__class__, eg_with_loop, None)
+    assert loop_node.is_group is True
+    assert len(loop_node.sub_exceptions) == 1
+    child_node = loop_node.sub_exceptions[0]
+    assert child_node.is_cycle is False
+    assert child_node.chain_parent is not None
+    assert child_node.chain_parent.is_cycle is True
