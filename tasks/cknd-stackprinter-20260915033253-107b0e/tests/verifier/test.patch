+    cause, error = KeyError('filter_ancestor'), ValueError('filter_current')
+    error.__cause__ = cause
+    root = build_exception_tree(type(error), error, None)
+    original_cause = root.chain_parent
+    pruned = root.filter(lambda node: node.exc_type is ValueError)
+    assert pruned is not root and pruned.chain_parent is None
+    retained = root.filter(lambda node: True)
+    assert retained is not root and retained.chain_parent is not original_cause
+    assert retained.chain_parent.exc_value is cause
+    assert retained.chain_parent.parent is retained
+    assert root.chain_parent is original_cause and original_cause.parent is root
