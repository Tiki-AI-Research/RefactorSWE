+@pytest.mark.parametrize('sequence_type', [list, tuple], ids=['list', 'tuple'])
+def test_f2p_exceptions_sequence_group(sequence_type):
+    from stackprinter.formatting import build_exception_tree, TracebackRenderer
+
+    class BundleError(Exception):
+        def __init__(self, children):
+            super().__init__('sequence_bundle')
+            self.exceptions = sequence_type(children)
+
+    children = [ValueError('sequence_leaf_a'), LookupError('sequence_leaf_b')]
+    error = BundleError(children)
+    root = build_exception_tree(type(error), error, None)
+    assert root.is_group is True
+    assert len(root.sub_exceptions) == len(children)
+    for child, original in zip(root.sub_exceptions, children):
+        assert child.exc_value is original
+        assert child.parent is root
+        assert child.chain_type == 'group_sub'
+        assert child.depth == 1
+    output = TracebackRenderer(style='plaintext', add_summary=False).render(root)
+    assert 'sequence_leaf_a' in output and 'sequence_leaf_b' in output
+
