+def test_f2p_compatibility_entry_reverse_causal_order(tmp_path):
+    """Keep legacy content; diagnose reverse chain order; require new IR reversal."""
+    from stackprinter.formatting import format_exc_info, build_exception_tree, TracebackRenderer
+    from tests import legacy_formatting_oracle as baseline
+
+    real_tb = _fixture_error(tmp_path).__traceback__
+    for relation in ('cause', 'context'):
+        for tb in (None, real_tb):
+            ancestor = ValueError('compat_ancestor').with_traceback(tb)
+            middle = TypeError('compat_middle').with_traceback(tb)
+            error = RuntimeError('compat_current').with_traceback(tb)
+            setattr(middle, '__' + relation + '__', ancestor)
+            setattr(error, '__' + relation + '__', middle)
+            for reverse in (False, True):
+                for summary in (False, True):
+                    for style in ('plaintext', 'darkbg'):
+                        options = dict(reverse=reverse, add_summary=summary,
+                                       source_lines=0, show_vals=False, style=style)
+                        expected = baseline.format_exc_info(type(error), error, tb, **options)
+                        # Preserve the exact old behavior, including frame and summary order.
+                        for entry, output in (
+                            ('format_exc_info', format_exc_info(type(error), error, tb, **options)),
+                            ('format(exception)', stackprinter.format(error, **options)),
+                            ('format(tuple)', stackprinter.format((type(error), error, tb), **options)),
+                        ):
+                            if reverse:
+                                # Only cross-exception ordering is ambiguous. Preserve each
+                                # exception block byte-for-byte, including frames and summary,
+                                # and retain the exact styled separators and their count.
+                                banner = ('\n\nThe above exception was the direct cause of the following exception:\n\n'
+                                          if relation == 'cause' else
+                                          '\n\nWhile handling the above exception, another exception occurred:\n\n')
+                                if style != 'plaintext':
+                                    scheme = getattr(baseline.colorschemes, style)
+                                    banner = baseline.get_ansi_tpl(*scheme.colors['exception_type']) % banner
+                                expected_blocks = expected.split(banner)
+                                # Reverse-aware wording is allowed only for reversed chains.
+                                reverse_banner = ('\n\nThe following exception was the direct cause of the above exception:\n\n'
+                                                  if relation == 'cause' else
+                                                  '\n\nThe above exception occurred while handling the following exception:\n\n')
+                                if style != 'plaintext':
+                                    reverse_banner = baseline.get_ansi_tpl(*scheme.colors['exception_type']) % reverse_banner
+                                positions = [output.index(name) for name in
+                                             ('compat_ancestor', 'compat_middle', 'compat_current')]
+                                if reverse_banner in output:
+                                    assert positions == sorted(positions, reverse=True), 'reverse banner contradicts actual chain order'
+                                normalized_output = output.replace(reverse_banner, banner)
+                                actual_blocks = normalized_output.split(banner)
+                                import json
+                                from pathlib import Path
+                                diagnostic = dict(entry=entry, relation=relation,
+                                                  traceback=tb is not None, summary=summary,
+                                                  style=style, reverse_aware_banner=reverse_banner in output,
+                                                  order=sorted(('compat_ancestor', 'compat_middle', 'compat_current'),
+                                                               key=lambda name: output.find(name)))
+                                with Path('/logs/verifier/legacy-reverse-diagnostics.jsonl').open('a') as stream:
+                                    stream.write(json.dumps(diagnostic) + '\n')
+                                assert len(expected_blocks) == 3
+                                assert sorted(actual_blocks) == sorted(expected_blocks), (entry, relation, reverse, summary, style)
+                            else:
+                                assert output == expected, (entry, relation, reverse, summary, style)
+                        # New APIs retain the explicit reverse requirement in the original task.
+                        node = build_exception_tree(type(error), error, tb)
+                        for output in (TracebackRenderer(**options).render(node),
+                                       stackprinter.format(node, **options)):
+                            positions = [output.index(name) for name in
+                                         ('compat_ancestor', 'compat_middle', 'compat_current')]
+                            assert positions == sorted(positions, reverse=reverse)
