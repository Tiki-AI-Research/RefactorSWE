+def _assert_traversal_lifecycle():
+    from cleo.commands.completions_command import CompletionsCommand
+    from cleo.loaders.factory_command_loader import FactoryCommandLoader
+
+    class FreshApplication(Application):
+        def __init__(self):
+            super().__init__("repair-lifecycle", "1.0")
+            self.init_transitions = 0
+
+        def _init(self):
+            if not self._initialized:
+                self.init_transitions += 1
+            super()._init()
+
+    class LazyCommand(Command):
+        name = "repair-lazy-target"
+        description = "Must be materialized through the real loader."
+
+    for shell in SUPPORTED_SHELLS:
+        app = FreshApplication()
+        loaded = []
+
+        def factory():
+            command = LazyCommand()
+            loaded.append(command)
+            return command
+
+        loader = FactoryCommandLoader({"repair-lazy-target": factory})
+        app.set_command_loader(loader)
+        command = CompletionsCommand()
+        command.set_application(app)
+        identity = _application_identity(app)
+        assert not app._initialized and not loaded
+        for iteration in (1, 2):
+            tester = CommandTester(command)
+            assert tester.execute(shell) == 0
+            assert tester.io.fetch_error() == ""
+            assert "repair-lazy-target" in tester.io.fetch_output()
+            assert app._initialized and app.init_transitions == 1
+            assert len(loaded) == 1
+            assert app._commands["repair-lazy-target"] is loaded[0]
+            assert _application_identity(app) == identity
