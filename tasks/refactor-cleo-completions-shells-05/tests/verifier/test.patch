index 0000000000000000000000000000000000000000..20d7a229d0df7ea328179d3275119355fb4ff597
--- /dev/null
+++ b/tests/commands/completion/test_completions_regression.py
@@ -0,0 +1,617 @@
+from __future__ import annotations
+
+from pathlib import Path
+from typing import TYPE_CHECKING
+from typing import ClassVar
+
+import pytest
+
+from cleo.application import Application
+from cleo.commands.command import Command
+from cleo.helpers import option
+from cleo.testers.command_tester import CommandTester
+from tests.commands.completion.fixtures.command_with_colons import CommandWithColons
+from tests.commands.completion.fixtures.command_with_space_in_name import SpacedCommand
+from tests.commands.completion.fixtures.hello_command import HelloCommand
+
+
+if TYPE_CHECKING:
+    from cleo.io.inputs.option import Option
+    from pytest_mock import MockerFixture
+
+FIXTURES_PATH = Path(__file__).parent / "fixtures" / "regression"
+
+SCRIPT_NAME = "/path/to/my/script"
+SUPPORTED_SHELLS = ("bash", "zsh", "fish")
+
+
+class HiddenCompletionCommand(Command):
+    name = "hidden-command"
+    description = "A hidden command."
+    hidden = True
+
+
+class DisabledCompletionCommand(Command):
+    name = "disabled-command"
+    description = "A disabled command."
+
+
+class UnnamedCompletionCommand(Command):
+    name = "unnamed-command"
+    description = "A command whose name is cleared."
+
+
+class NamespacedCacheClearCommand(Command):
+    name = "cache clear"
+    description = "Clear the cache."
+    options: ClassVar[list[Option]] = [option("zeta"), option("alpha")]
+
+
+class NamespacedCachePruneCommand(Command):
+    name = "cache prune"
+    description = "Prune the cache."
+    options: ClassVar[list[Option]] = [option("force", flag=True)]
+
+
+class EscapingCompletionCommand(Command):
+    name = "option-order"
+    description = "Don't 'quote' this & that."
+    options: ClassVar[list[Option]] = [
+        option("zulu", description="Last option."),
+        option("alpha", description="First option."),
+        option("colon:name", description="An option with a colon."),
+    ]
+
+
+def _mock_script_name(mocker: MockerFixture) -> None:
+    mocker.patch(
+        "cleo.io.inputs.string_input.StringInput.script_name",
+        new_callable=mocker.PropertyMock,
+        return_value=SCRIPT_NAME,
+    )
+
+
+def _fixture_application() -> Application:
+    app = Application()
+    app.add(HelloCommand())
+    app.add(CommandWithColons())
+    app.add(SpacedCommand())
+
+    return app
+
+
+def _rules_application() -> Application:
+    app = Application()
+    app.add(HiddenCompletionCommand())
+
+    disabled_command = app.add(DisabledCompletionCommand())
+    assert disabled_command is not None
+    disabled_command.enabled = False
+
+    unnamed_command = app.add(UnnamedCompletionCommand())
+    assert unnamed_command is not None
+    unnamed_command.name = None
+
+    app.add(NamespacedCacheClearCommand())
+    app.add(NamespacedCachePruneCommand())
+    app.add(EscapingCompletionCommand())
+
+    return app
+
+
