+def _assert_bash_does_not_read_unused_description():
+    from cleo.io.inputs.option import Option
+    for location in ('global', 'command'):
+        for throws in (False, True):
+            reads = []
+            class ObservedOption(Option):
+                @property
+                def description(self):
+                    reads.append('description')
+                    if throws: raise RuntimeError('unused description was evaluated')
+                    return 'A description not used by bash.'
+            def application(observed):
+                app = Application(); cmd = Command(); cmd.name = 'description-target'
+                app.add(cmd)
+                opt = ObservedOption('observed-option', flag=True) if observed else option('observed-option', description='A description not used by bash.')
+                definition = app.definition if location == 'global' else cmd.definition
+                definition.add_option(opt)
+                return app
+            expected = _run(application(False), 'bash')
+            try:
+                actual = _run(application(True), 'bash')
+            except RuntimeError as exc:
+                pytest.fail(f'bash accessed an unused description: {exc}')
+            assert actual == expected
+            assert reads == [], 'bash must not evaluate description when only the name is rendered'
+
