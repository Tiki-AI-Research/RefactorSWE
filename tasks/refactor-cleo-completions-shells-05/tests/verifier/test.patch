+"""Observe the public completion split, without prescribing keys/classes/files.
+
+Legacy node names are retained so the existing verifier inventory stays stable.
+Ownership is checked on executed production functions, not helper names. The
+operation model below covers the Python path/hash/traversal/template primitives
+used by this case; it is not a claim of general Python semantic equivalence.
+"""
+from __future__ import annotations
+
+import ast
+import builtins
+import dis
+import importlib
+import inspect
+import sys
+import textwrap
+from collections.abc import Mapping
+from contextlib import contextmanager
+from dataclasses import is_dataclass
+from functools import lru_cache
+from functools import partial
+from pathlib import Path
+
+from cleo.application import Application
+from cleo.commands.command import Command
+from cleo.io.inputs.definition import Definition
+from cleo.io.inputs.option import Option
+from cleo.testers.command_tester import CommandTester
+
+SHELLS = ("bash", "zsh", "fish")
+COMMAND_MODULE = "cleo.commands.completions_command"
+REPLACEMENT_MARKER = "__f2p_independent_unit_probe__"
+_CODE_GLOBALS = {}
+_DATA_CONSTRUCTOR_CODES = set()
+_OBSERVED_RECEIVERS = {}
+_REPLACEMENT_RESULTS = {}
+_MISSING = object()
+_FORMATTING_CODES = set()
+
+
+class ReplacementProbe(str):
+    def __new__(cls, *args, **kwargs):
+        return super().__new__(cls, REPLACEMENT_MARKER)
+
+    def __getattr__(self, name):
+        return lambda *args, **kwargs: REPLACEMENT_MARKER
+
+    def __call__(self, *args, **kwargs):
+        return REPLACEMENT_MARKER
+
+    def render(self, *args, **kwargs):
+        return REPLACEMENT_MARKER
+
+    def generate(self, *args, **kwargs):
+        return REPLACEMENT_MARKER
+
+
+class ProbeCommand(Command):
+    name = "f2p-probe"
+    description = "A production traversal probe."
+
+    def handle(self):
+        return 0
+
+
+def _command_class():
+    return importlib.import_module(COMMAND_MODULE).CompletionsCommand
+
+
+def _run(shell):
+    app = Application()
+    app.add(ProbeCommand())
+    tester = CommandTester(app.find("completions"))
+    status = tester.execute(shell)
+    return status, tester.io.fetch_output().replace("\r\n", "\n"), tester.io.fetch_error()
+
+
+def _production_owners():
+    # Only modules reached by actual generation are inspected. Importing every
+    # production module would change startup/state and discover unrelated units.
+    for name, module in sorted(list(sys.modules.items())):
+        if module is None or not (name == "cleo" or name.startswith("cleo.")):
+            continue
+        yield module
+        for value in list(vars(module).values()):
+            if isinstance(value, type) and value.__module__ == name:
+                yield value
+    # A cohesive unit may be an instance, including one created during generation.
+    # Only receivers reached by the real trace are eligible for instance probes.
+    yield from list(_OBSERVED_RECEIVERS.values())
+
+
+def _owner_members(owner):
+    members = dict(vars(owner)) if hasattr(owner, "__dict__") else {}
+    if not isinstance(owner, type) and not inspect.ismodule(owner):
+        for base in type(owner).__mro__:
+            for key, value in vars(base).items():
+                if inspect.isfunction(_unwrap(value)):
+                    members.setdefault(key, value)
+    return members
+
+
+def _unwrap(value):
+    return value.__func__ if isinstance(value, (staticmethod, classmethod)) else value
+
+
+def _generation_code(code):
+    # Framework accessors are not generation owners; inspect their callers.
+    path = Path(code.co_filename)
+    return (
+        code not in _DATA_CONSTRUCTOR_CODES
+        and path.name not in ("application.py", "command.py", "command_tester.py")
+        and not code.co_name.startswith("<")
+        and "/io/" not in path.as_posix()
+        and "/formatters/" not in path.as_posix()
+    )
+
+
+def _trace(shell):
+    calls = {}
+    returns = []
+    option_owners = set()
+    sorting_owners = set()
+    _FORMATTING_CODES.clear()
+    option_getter = Definition.options.fget.__code__
+    command_codes = {
+        getattr(_unwrap(value), "__code__", None)
+        for value in vars(_command_class()).values()
+    }
+
+    def observe(frame, event, result):
+        module = frame.f_globals.get("__name__", "")
+        if event == "call" and module == "string" and frame.f_code.co_name in {"substitute", "safe_substitute"}:
+            if frame.f_back is not None and frame.f_back.f_globals.get("__name__", "").startswith("cleo."):
+                _FORMATTING_CODES.add(frame.f_back.f_code)
+        if not (module == "cleo" or module.startswith("cleo.")):
+            return
+        code = frame.f_code
+        if event == "c_call" and getattr(result, "__name__", "") in {"format", "format_map"} and isinstance(getattr(result, "__self__", None), str):
+            _FORMATTING_CODES.add(code)
+        if event == "call":
+            _CODE_GLOBALS[code] = frame.f_globals
+            receiver = frame.f_locals.get("self")
+            calls[code] = code in command_codes or isinstance(receiver, _command_class())
+            if (receiver is not None and not calls[code]
+                    and type(receiver).__module__.startswith("cleo.")):
+                # dataclasses synthesize field-assignment constructors with no
+                # source file. Their called factories remain separately traced.
+                if (code.co_name == "__init__" and code.co_filename == "<string>"
+                        and is_dataclass(receiver)):
+                    _DATA_CONSTRUCTOR_CODES.add(code)
+                elif _generation_code(code):
+                    _OBSERVED_RECEIVERS[id(receiver)] = receiver
+            # Observe the trusted definition accessor, not an arbitrary field
+            # named options on an already prepared completion-data object.
+            if code is option_getter and frame.f_back is not None:
+                caller = frame.f_back.f_code
+                if caller in calls and _generation_code(caller):
+                    option_owners.add(caller)
+        elif event == "return" and isinstance(result, (str, Mapping)):
+            returns.append((code, result))
+
+    original_sorted = builtins.sorted
+    def observed_sorted(values, *args, **kwargs):
+        if isinstance(values, (list, tuple)) and values and all(isinstance(v, Option) for v in values):
+            frame = sys._getframe(1)
+            if frame.f_globals.get("__name__", "").startswith("cleo.") and _generation_code(frame.f_code):
+                sorting_owners.add(frame.f_code)
+        return original_sorted(values, *args, **kwargs)
+
+    def observe_operations(frame, event, arg):
+        if not frame.f_globals.get("__name__", "").startswith("cleo."):
+            return None
+        if event == "call":
+            frame.f_trace_opcodes = True
+        elif event == "opcode" and frame.f_lasti in _percent_offsets(frame.f_code):
+            _FORMATTING_CODES.add(frame.f_code)
+        return observe_operations
+
+    previous, previous_trace = sys.getprofile(), sys.gettrace()
+    try:
+        builtins.sorted = observed_sorted
+        sys.setprofile(observe)
+        sys.settrace(observe_operations)
+        status, output, error = _run(shell)
+    finally:
+        sys.settrace(previous_trace)
+        sys.setprofile(previous)
+        builtins.sorted = original_sorted
+    assert status == 0 and output and not error
+    return calls, returns, output, sorting_owners or option_owners
+
+
+@lru_cache(maxsize=None)
+def _percent_offsets(code):
+    return frozenset(i.offset for i in dis.get_instructions(code)
+                     if i.opname == "BINARY_OP" and i.argrepr == "%")
+
+
+def _full_script_formatter(code, result, output):
+    return (_generation_code(code) and code in _FORMATTING_CODES and isinstance(result, str)
+            and result.rstrip("\n") == output.rstrip("\n"))
+
+
+@lru_cache(maxsize=None)
+def _roles(code):
+    # Ignore framework primitives. Their callers, which implement generation,
+    # are still inspected; merely using Application.all is not a shared owner.
+    if not _generation_code(code):
+        return frozenset()
+    try:
+        tree = ast.parse(textwrap.dedent(inspect.getsource(code)))
+    except (OSError, TypeError, SyntaxError):
+        raise RuntimeError(f"unsupported executed generation code {code.co_name}")
+    # Error-message formatting is part of shell validation. It is not script
+    # rendering, so expressions beneath raise statements must be excluded.
+    class ExcludeErrors(ast.NodeTransformer):
+        def visit_Raise(self, node):
+            return ast.Pass()
+
+    tree = ExcludeErrors().visit(tree)
+    roles = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call):
+            name = node.func.attr if isinstance(node.func, ast.Attribute) else ""
+            if isinstance(node.func, ast.Name):
+                # Import spelling is not a contract: from-imports and aliases
+                # must resolve to the same primitive as module attributes.
+                value = _CODE_GLOBALS.get(code, {}).get(node.func.id)
+                name = getattr(value, "__name__", node.func.id).removeprefix("openssl_")
+            if name in {"realpath", "abspath", "resolve"}:
+                roles.add("script identity")
+            if name in {"md5", "sha1", "sha256", "blake2b", "blake2s"}:
+                roles.add("function naming")
+            if name == "sub" and node.args and isinstance(node.args[0], ast.Constant):
+                pattern = node.args[0].value
+                if isinstance(pattern, str) and "A-Za-z0-9_" in pattern:
+                    roles.add("function sanitization")
+            if name in {"option", "get_option"} and node.args and isinstance(node.args[0], ast.Constant) and node.args[0].value == "alias":
+                roles.add("aliases")
+            if name == "all" and not node.args and not node.keywords:
+                roles.add("command traversal")
+            if name in {"substitute", "safe_substitute", "format_map"}:
+                roles.add("template filling")
+            if name in {"join", "format"}:
+                roles.add("shell rendering")
+        if isinstance(node, ast.JoinedStr):
+            roles.add("shell rendering")
+        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Mod) and isinstance(node.left, (ast.Subscript, ast.Name, ast.Constant, ast.Attribute)):
+            roles.add("template filling")
+    return frozenset(roles)
+
+
+def _executed_roles(code, option_owners):
+    roles = _roles(code)
+    if code in option_owners:
+        roles = roles | {"option traversal"}
+    return roles
+
+
+def _assert_narrow(shells=SHELLS):
+    offenders = []
+    for shell in shells:
+        calls, _, _, option_owners = _trace(shell)
+        for code, owned in calls.items():
+            # Reading --alias in handle to pass it to an external unit is legal;
+            # assembling aliases in a command-owned derivation helper is not.
+            roles = set(_executed_roles(code, option_owners))
+            if code.co_name == "handle":
+                roles.discard("aliases")
+            if owned and roles:
+                offenders.append((shell, code.co_qualname, sorted(roles)))
+    assert not offenders, f"actual generation/common work remains on the command: {offenders}"
+
+
+def _assert_shared():
+    observations = {}
+    for shell in SHELLS:
+        calls, returns, output, option_owners = _trace(shell)
+        observations[shell] = {
+            role: ({code for code, result in returns if _full_script_formatter(code, result, output)}
+                   if role == "template filling" else
+                   {code for code in calls if role in _executed_roles(code, option_owners)})
+            for role in ("script identity", "function naming", "function sanitization", "aliases", "command traversal", "option traversal", "template filling")
+        }
+    for role in observations["bash"]:
+        shells = ("bash", "zsh") if role == "aliases" else SHELLS
+        owners = [observations[shell][role] for shell in shells]
+        assert all(owners), f"no executed owner observed for common {role}"
+        assert all(owner == owners[0] for owner in owners[1:]), (
+            f"common {role} is copied/defined separately across shells: "
+            f"{[(shell, sorted(code.co_qualname for code in observations[shell][role])) for shell in shells]}"
+        )
+    _assert_narrow()
+
+
+def _probe_result(result):
+    if isinstance(result, str):
+        return REPLACEMENT_MARKER
+    # Preserve the template-data schema, changing one observable text value.
+    # Replacing a mapping with a string would reject a valid data-returning unit.
+    if isinstance(result, Mapping):
+        replacement = dict(result)
+        for key, value in replacement.items():
+            if isinstance(value, str):
+                replacement[key] = REPLACEMENT_MARKER
+                return replacement
+    return _MISSING
+
+
+@contextmanager
+def _replaced(binding):
+    owner, key, original = binding
+    if isinstance(owner, dict):
+        owner[key] = ReplacementProbe if isinstance(original, type) else ReplacementProbe()
+        previous = original
+    else:
+        previous = vars(owner).get(key, _MISSING) if hasattr(owner, "__dict__") else _MISSING
+        result = _REPLACEMENT_RESULTS.get((id(owner), key), REPLACEMENT_MARKER)
+        replacement = lambda *args, **kwargs: result
+        if isinstance(owner, type):
+            if isinstance(original, staticmethod):
+                replacement = staticmethod(replacement)
+            elif isinstance(original, classmethod):
+                replacement = classmethod(replacement)
+        setattr(owner, key, replacement)
+    try:
+        yield
+    finally:
+        if isinstance(owner, dict):
+            owner[key] = previous
+        elif previous is _MISSING:
+            delattr(owner, key)
+        else:
+            setattr(owner, key, previous)
+
+
+def _selects(binding, shell, outputs):
+    try:
+        with _replaced(binding):
+            status, output, error = _run(shell)
+            if status != 0 or error or REPLACEMENT_MARKER not in output:
+                return False
+            for other in SHELLS:
+                if other != shell:
+                    status, output, error = _run(other)
+                    if status != 0 or error or output != outputs[other]:
+                        return False
+    except (Exception, AssertionError):
+        return False
+    return True
+
+
+def _unit_codes(unit):
+    # A registry entry must own executed generation code. Template strings and
+    # other static data are replaceable inputs, not generation responsibilities.
+    while isinstance(unit, partial):
+        unit = unit.func
+    codes = {getattr(_unwrap(unit), "__code__", None)}
+    owners = unit.__mro__ if isinstance(unit, type) else (unit,)
+    for owner in owners:
+        codes.update(
+            getattr(_unwrap(value), "__code__", None)
+            for value in _owner_members(owner).values()
+        )
+    return codes - {None}
+
+
+def _dispatch_bindings():
+    # A callable wrapper around command-owned rendering is not an external
+    # generation responsibility, even if replacing the wrapper changes output.
+    _assert_narrow()
+    _OBSERVED_RECEIVERS.clear()
+    _REPLACEMENT_RESULTS.clear()
+    traces = {shell: _trace(shell) for shell in SHELLS}
+    outputs = {shell: value[2] for shell, value in traces.items()}
+    owners = list(_production_owners())
+    mappings = []
+    seen = set()
+    for owner in owners:
+        for name, value in list(_owner_members(owner).items()):
+            if name.startswith("__"):
+                continue
+            if isinstance(value, dict) and id(value) not in seen:
+                seen.add(id(value))
+                mappings.extend((value, key, unit) for key, unit in list(value.items()))
+    found = {}
+    for shell in SHELLS:
+        # Match both registry and method probes to actual external execution;
+        # changing a shell's template alone must not satisfy these six nodes.
+        returning = {
+            code: result for code, result in traces[shell][1]
+            if not traces[shell][0][code] and _generation_code(code)
+            and (isinstance(result, Mapping) or
+                 result.rstrip("\n") == outputs[shell].rstrip("\n"))
+        }
+        for binding in mappings:
+            if not (_unit_codes(binding[2]) & returning.keys()):
+                continue
+            if _selects(binding, shell, outputs):
+                found[shell] = binding
+                break
+        if shell in found:
+            continue
+        # A shell unit can return the whole script or data consumed by the
+        # common template filler. Bind the actual class/instance responsibility.
+        for owner in owners:
+            for key, value in list(_owner_members(owner).items()):
+                code = getattr(_unwrap(value), "__code__", None)
+                if code not in returning:
+                    continue
+                replacement = _probe_result(returning[code])
+                if replacement is _MISSING:
+                    continue
+                _REPLACEMENT_RESULTS[(id(owner), key)] = replacement
+                binding = (owner, key, value)
+                if _selects(binding, shell, outputs):
+                    found[shell] = binding
+                    break
+            if shell in found:
+                break
+    assert set(found) == set(SHELLS), f"no actual independently replaceable external behaviour found for {set(SHELLS) - set(found)}"
+    return found
+
+
+def _assert_independent(shell=None):
+    bindings = _dispatch_bindings()
+    outputs = {name: _run(name)[1] for name in SHELLS}
+    for name in ((shell,) if shell else SHELLS):
+        assert _selects(bindings[name], name, outputs)
+
+
+def test_shell_generation_is_dispatched_through_a_shell_keyed_unit_registry():
+    _dispatch_bindings()
+
+
+def test_shell_registry_binds_each_supported_shell_to_a_distinct_generation_unit():
+    bindings = _dispatch_bindings()
+    assert len({(id(owner), key) for owner, key, _ in bindings.values()}) == 3
+
+
+def test_bash_generation_unit_is_defined_outside_the_command_module():
+    _assert_narrow(("bash",))
+
+
+def test_zsh_generation_unit_is_defined_outside_the_command_module():
+    _assert_narrow(("zsh",))
+
+
+def test_fish_generation_unit_is_defined_outside_the_command_module():
+    _assert_narrow(("fish",))
