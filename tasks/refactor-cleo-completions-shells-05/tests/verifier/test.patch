@@ -0,0 +1,65 @@
+#compdef script
+
+_script_6a747bf4223c4e57_complete()
+{
+    local state com cur
+    local -a opts
+    local -a coms
+
+    cur=${words[${#words[@]}]}
+
+    # lookup for command
+    for word in ${words[@]:1}; do
+        if [[ $word != -* ]]; then
+            com=$word
+            break
+        fi
+    done
+
+    if [[ ${cur} == --* ]]; then
+        state="option"
+        opts+=("--ansi:Force ANSI output." "--help:Display help for the given command. When no command is given display help for the list command." "--no-ansi:Disable ANSI output." "--no-interaction:Do not ask any interactive question." "--quiet:Do not output any message." "--verbose:Increase the verbosity of messages: 1 for normal output, 2 for more verbose output and 3 for debug." "--version:Display this application version.")
+    elif [[ $cur == $com ]]; then
+        state="command"
+        coms+=("'cache clear':Clear the cache." "'cache prune':Prune the cache." "help:Displays help for a command." "list:Lists commands." "option-order:Don\'t \'quote\' this \& that.")
+    fi
+
+    case $state in
+        (command)
+            _describe 'command' coms
+        ;;
+        (option)
+            case "$com" in
+
+            ('cache clear')
+            opts+=("--alpha" "--zeta")
+            ;;
+
+            ('cache prune')
+            opts+=("--force")
+            ;;
+
+            (help)
+            opts+=()
+            ;;
+
+            (list)
+            opts+=()
+            ;;
+
+            (option-order)
+            opts+=("--alpha:First option." "--colon\:name:An option with a colon." "--zulu:Last option.")
+            ;;
+
+            esac
+
+            _describe 'option' opts
+        ;;
+        *)
+            # fallback to file completion
+            _arguments '*:file:_files'
+    esac
+}
+
+_script_6a747bf4223c4e57_complete "$@"
+compdef _script_6a747bf4223c4e57_complete /path/to/my/script
