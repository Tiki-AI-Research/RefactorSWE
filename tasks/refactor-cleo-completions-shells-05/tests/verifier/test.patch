+def _assert_lazy_definition_rendering_order():
+    # Public definition access can finish a command's metadata. Descriptions
+    # must be rendered at the same point as before the refactor, before that
+    # command's options are read. Compare whole scripts to an eager reference.
+    from cleo.loaders.factory_command_loader import FactoryCommandLoader
+    from cleo.io.inputs.option import Option
+
+    before = "Description before definition."
+    after = "Description after definition."
+
+    # A public option description may include its default. Global descriptions
+    # must be rendered before a lazy command definition updates that default.
+    class DefaultDescribingOption(Option):
+        @property
+        def description(self):
+            return f"Configuration path (default: {self.default})."
+
+    class ReferenceCommand(Command):
+        name = "lazy-metadata"
+        description = before
+        options = [option("metadata-option", description="Metadata option.")]
+
+    class LazyDefinitionCommand(Command):
+        name = ReferenceCommand.name
+        description = before
+
+        def __init__(self):
+            super().__init__()
+            self.metadata_initializations = 0
+
+        @property
+        def definition(self):
+            definition = super().definition
+            if not self.metadata_initializations:
+                definition.add_option(
+                    option("metadata-option", description="Metadata option.")
+                )
+                self.description = after
+                global_option.set_default("after")
+                self.metadata_initializations += 1
+            return definition
+
+    for shell in SUPPORTED_SHELLS:
+        app = Application()
+        global_option = DefaultDescribingOption(
+            "config-path", flag=False, default="before"
+        )
+        app.definition.add_option(global_option)
+        loaded = []
+
+        def factory():
+            command = LazyDefinitionCommand()
+            loaded.append(command)
+            return command
+
+        app.set_command_loader(
+            FactoryCommandLoader({ReferenceCommand.name: factory})
+        )
+        assert not loaded
+        for description, default in ((before, "before"), (after, "after")):
+            reference = Application()
+            reference.definition.add_option(
+                DefaultDescribingOption("config-path", flag=False, default=default)
+            )
+            eager_command = ReferenceCommand()
+            eager_command.description = description
+            reference.add(eager_command)
+            expected = _run(reference, shell)
+            actual = _run(app, shell)
+            assert actual == expected, (
+                f"{shell} script changed when a command finishes its definition; "
+                "global option and command descriptions must precede command "
+                "option traversal"
+            )
+            assert actual[0] == 0 and actual[2] == ""
+            assert len(loaded) == 1
+            assert loaded[0].metadata_initializations == 1
+            assert loaded[0].description == after
+            assert global_option.default == "after"
+
+
+def _assert_visibility_at_each_command():
+    from cleo.loaders.factory_command_loader import FactoryCommandLoader
+    for shell in SUPPORTED_SHELLS:
+        for change in ('hidden', 'disabled', 'unnamed'):
+            app = Application()
+            loaded = []
+            class First(Command):
+                name = 'visibility-alpha'
+                description = 'First.'
+                def __init__(self):
+                    super().__init__()
+                    self.reads = 0
+                @property
+                def definition(self):
+                    value = super().definition
+                    self.reads += 1
+                    sibling = app.get('visibility-omega')
+                    if change == 'hidden': sibling.hidden = True
+                    elif change == 'disabled': sibling.enabled = False
+                    else: sibling.name = None
+                    return value
+            class Second(Command):
+                name = 'visibility-omega'
+                description = 'Second.'
+                def __init__(self):
+                    super().__init__()
+                    self.reads = 0
+                @property
+                def definition(self):
+                    self.reads += 1
+                    return super().definition
+            def load(cls):
+                def factory():
+                    c = cls(); loaded.append(c); return c
+                return factory
+            app.set_command_loader(FactoryCommandLoader({'visibility-alpha':load(First), 'visibility-omega':load(Second)}))
+            expected_app = Application()
+            first = Command(); first.name = 'visibility-alpha'; first.description = 'First.'
+            expected_app.add(first)
+            second = Command(); second.name = 'visibility-omega'; second.description = 'Second.'
+            expected_app.add(second)
+            if change == 'hidden': second.hidden = True
+            elif change == 'disabled': second.enabled = False
+            else: second.name = None
+            expected = _run(expected_app, shell)
+            for iteration in (1, 2):
+                assert _run(app, shell) == expected, f'{shell}: visibility must be checked when each command is reached ({change})'
+                assert len(loaded) == 2
+                assert next(c for c in loaded if isinstance(c, Second)).reads == 0, 'excluded command definition must not be read'
+                assert next(c for c in loaded if isinstance(c, First)).reads == iteration
+
