+++ b/src/cleo/commands/completions/bash.py
@@ -0,0 +1,43 @@
+from __future__ import annotations
+
+from cleo._compat import shell_quote
+from cleo.commands.completions.base import Completion
+
+
+class BashCompletion(Completion):
+    def generate(self) -> str:
+        script_name, script_path = self._get_script_name_and_path()
+        aliases = [script_name, script_path, *self._get_aliases()]
+        function = self._generate_function_name(script_name, script_path)
+
+        opts = [f"--{opt.name}" for opt in self._get_global_options()]
+
+        cmds = []
+        cmds_opts = []
+        for name, cmd in self._get_visible_commands():
+            command_name = shell_quote(name) if " " in name else name
+            cmds.append(command_name)
+            options = " ".join(
+                f"--{opt.name}".replace(":", "\\:")
+                for opt in self._get_command_options(cmd)
+            )
+            cmds_opts += [
+                f"            ({command_name})",
+                f'            opts="${{opts}} {options}"',
+                "            ;;",
+                "",  # newline
+            ]
+
+        compdefs = "\n".join(
+            f"complete -o default -F {function} {alias}" for alias in aliases
+        )
+
+        return self._render_template(
+            "bash",
+            {
+                "opts": " ".join(opts),
+                "cmds": " ".join(cmds),
+                "cmds_opts": "\n".join(cmds_opts[:-1]),  # trim trailing newline
+                "compdefs": compdefs,
+            },
+        )
