+) -> None:
+    mocker.patch(
+        "cleo.io.inputs.string_input.StringInput.script_name",
+        new_callable=mocker.PropertyMock,
+        return_value="/path/to/my/script",
+    )
+    mocker.patch(
+        "cleo.commands.completions.base.Completion._generate_function_name",
+        return_value="_my_function",
+    )
+
+    def snapshot(path: Path) -> set[tuple[str, int, int]]:
+        return {
+            (str(p.relative_to(path)), p.stat().st_size, int(p.stat().st_mtime))
+            for p in path.rglob("*")
+            if p.is_file()
+        }
+
+    before_tmp = snapshot(tmp_path)
+    before_cwd = snapshot(Path.cwd())
+
+    command = app.find("completions")
+    tester = CommandTester(command)
+    status = tester.execute(shell)
+
+    assert status == 0
+    assert tester.io.fetch_error() == ""
+    assert snapshot(tmp_path) == before_tmp
+    assert snapshot(Path.cwd()) == before_cwd
+
