+                disabled_cmd.enabled = False
+
+                unnamed_cmd = Command()
+                unnamed_cmd.name = ""
+                unnamed_cmd.description = "Unnamed secret description"
+
+                commands["hidden-secret-cmd"] = hidden_cmd
