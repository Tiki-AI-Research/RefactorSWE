new file mode 100644
--- /dev/null
+++ b/src/cleo/commands/completions/zsh.py
@@ -0,0 +1,62 @@
+from __future__ import annotations
+
+import re
+import subprocess
+
+from cleo._compat import shell_quote
+from cleo.commands.completions.base import Completion
+
+
+class ZshCompletion(Completion):
+    def generate(self) -> str:
+        script_name, script_path = self._get_script_name_and_path()
+        aliases = [script_path, *self._get_aliases()]
+        function = self._generate_function_name(script_name, script_path)
+
+        def sanitize(s: str) -> str:
+            return self._command.io.output.formatter.remove_format(s)
+
+        opts = [
+            self._zsh_describe(f"--{opt.name}", sanitize(opt.description))
+            for opt in self._get_global_options()
+        ]
+
+        cmds = []
+        cmds_opts = []
+        for name, cmd in self._get_visible_commands():
+            command_name = shell_quote(name) if " " in name else name
+            cmds.append(self._zsh_describe(command_name, sanitize(cmd.description)))
+            options = " ".join(
+                self._zsh_describe(f"--{opt.name}", sanitize(opt.description))
+                for opt in self._get_command_options(cmd)
+            )
+            cmds_opts += [
+                f"            ({command_name})",
+                f"            opts+=({options})",
+                "            ;;",
+                "",  # newline
+            ]
+
+        compdefs = "\n".join(f"compdef {function} {alias}" for alias in aliases)
+
+        return self._render_template(
+            "zsh",
+            {
+                "opts": " ".join(opts),
+                "cmds": " ".join(cmds),
+                "cmds_opts": "\n".join(cmds_opts[:-1]),  # trim trailing newline
+                "compdefs": compdefs,
+            },
+        )
+
+    def _zsh_describe(self, value: str, description: str | None = None) -> str:
+        value = '"' + value.replace(":", "\\:")
+        if description:
+            description = re.sub(
+                r"([\"'#&;`|*?~<>^()\[\]{}$\\\x0A\xFF])", r"\\\1", description
+            )
+            value += ":" + subprocess.list2cmdline([description]).strip('"')
+
+        value += '"'
+
+        return value
