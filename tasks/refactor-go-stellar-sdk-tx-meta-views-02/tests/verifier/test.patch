+// TestGetChangesConsumesConsolidatedViewWithoutLocalDispatch fails when the
+// change-assembly entry point still owns per-generation decoded-metadata
+// handling itself: either a per-generation dispatch table, or a direct read of
+// a raw metadata union arm.
+func TestGetChangesConsumesConsolidatedViewWithoutLocalDispatch(t *testing.T) {
+	p := loadProgram(t)
+	d := p.consumerOf(siteID{pkgIngest, "LedgerTransaction", "GetChanges"})
+	if d == nil {
+		t.Errorf("ingest.LedgerTransaction.GetChanges must remain declared as a production entry point")
+		return
+	}
+	if d.hasGenerationTable() {
+		t.Errorf("%s must not own a per-generation dispatch table any more (found one at %s:%d); the consolidated view must own the generation differences", d.id, d.file, d.line)
+	}
+	if d.metaUnionArmAccess {
+		t.Errorf("%s must not read the raw metadata union arms (MustV1..MustV4 / GetV1..GetV4 / .V1..V4) any more (at %s:%d)", d.id, d.file, d.line)
+	}
+}
+
+// TestGetOperationChangesConsumesConsolidatedViewWithoutLocalDispatch pins the
+// same ownership for the per-operation change entry point.
