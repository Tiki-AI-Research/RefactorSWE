+package xdr
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// Supplemental P2P regression coverage for the exported xdr.TransactionMeta
+// event accessors. The consolidated metadata view must keep every generation's
+// absent-event outcomes and unsupported-generation errors exactly as they are,
+// so these tests pin the per-generation results directly at the xdr layer.
+
+func p2pMetaContractEvent(topic string) ContractEvent {
+	topicValue := ScSymbol(topic)
+	return ContractEvent{
+		Type: ContractEventTypeContract,
+		Body: ContractEventBody{
+			V: 0,
+			V0: &ContractEventV0{
+				Topics: []ScVal{{Type: ScValTypeScvSymbol, Sym: &topicValue}},
+			},
+		},
+	}
+}
+
+func p2pMetaDiagnosticEvent(topic string) DiagnosticEvent {
+	return DiagnosticEvent{
+		InSuccessfulContractCall: true,
+		Event:                    p2pMetaContractEvent(topic),
+	}
+}
+
+func p2pMetaTransactionEvent(topic string) TransactionEvent {
+	return TransactionEvent{
+		Stage: TransactionEventStageTransactionEventStageBeforeAllTxs,
+		Event: p2pMetaContractEvent(topic),
+	}
+}
+
+func TestP2PMetaGetContractEventsForOperationOutcomes(t *testing.T) {
+	eventA := p2pMetaContractEvent("a")
+	eventB := p2pMetaContractEvent("b")
+
+	t.Run("generation-1-and-2-have-no-events", func(t *testing.T) {
+		for _, meta := range []TransactionMeta{
+			{V: 1, V1: &TransactionMetaV1{}},
+			{V: 2, V2: &TransactionMetaV2{}},
+		} {
+			events, err := meta.GetContractEventsForOperation(0)
+			require.NoError(t, err)
+			assert.Nil(t, events)
+		}
+	})
+
+	t.Run("generation-3-reads-soroban-meta-and-ignores-index", func(t *testing.T) {
+		meta := TransactionMeta{V: 3, V3: &TransactionMetaV3{
+			SorobanMeta: &SorobanTransactionMeta{Events: []ContractEvent{eventA, eventB}},
+		}}
+		for _, index := range []uint32{0, 7} {
+			events, err := meta.GetContractEventsForOperation(index)
+			require.NoError(t, err)
+			assert.Equal(t, []ContractEvent{eventA, eventB}, events)
+		}
+	})
+
+	t.Run("generation-3-without-soroban-meta-has-no-events", func(t *testing.T) {
+		meta := TransactionMeta{V: 3, V3: &TransactionMetaV3{}}
+		events, err := meta.GetContractEventsForOperation(0)
+		require.NoError(t, err)
+		assert.Nil(t, events)
+	})
+
+	t.Run("generation-4-reads-the-requested-operation", func(t *testing.T) {
+		meta := TransactionMeta{V: 4, V4: &TransactionMetaV4{
+			Operations: []OperationMetaV2{
+				{Events: []ContractEvent{eventA}},
+				{Events: []ContractEvent{eventB}},
+			},
+		}}
+		events, err := meta.GetContractEventsForOperation(1)
+		require.NoError(t, err)
+		assert.Equal(t, []ContractEvent{eventB}, events)
+	})
+
+	t.Run("generation-4-with-empty-operation-list-has-no-events", func(t *testing.T) {
+		meta := TransactionMeta{V: 4, V4: &TransactionMetaV4{}}
+		events, err := meta.GetContractEventsForOperation(0)
+		require.NoError(t, err)
+		assert.Nil(t, events)
+	})
+
+	t.Run("unsupported-generations-error", func(t *testing.T) {
+		for _, version := range []int32{0, 5} {
+			meta := TransactionMeta{V: version}
+			events, err := meta.GetContractEventsForOperation(0)
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "unsupported TransactionMeta version")
+			assert.Nil(t, events)
+		}
+	})
+}
+
+func TestP2PMetaGetDiagnosticEventsOutcomes(t *testing.T) {
+	diagnosticA := p2pMetaDiagnosticEvent("a")
+	diagnosticB := p2pMetaDiagnosticEvent("b")
+
+	t.Run("generation-1-and-2-have-no-events", func(t *testing.T) {
