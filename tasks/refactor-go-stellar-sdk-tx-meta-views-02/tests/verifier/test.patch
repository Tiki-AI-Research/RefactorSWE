+
+// TestAllDecodedConsumersShareOneGenerationDispatchSite pins the "one internal
+// view" obligation: every decoded consumer must reach the same single
+// per-generation dispatch declaration, and that declaration must live in the
+// xdr package so both the metadata accessors and the transaction readers can
+// use it.
+func TestAllDecodedConsumersShareOneGenerationDispatchSite(t *testing.T) {
+	p := loadProgram(t)
+	report := sharedDispatchSite(p)
+	if len(report.Problems) > 0 {
+		t.Errorf("every decoded-metadata consumer must reach one shared per-generation dispatch declaration in the data layer: %s", strings.Join(report.Problems, "; "))
+	}
+}
+
+// TestSharedViewDispatchCoversEverySupportedGeneration pins that the shared
+// view really is the per-generation owner rather than a partial shim: its
+// dispatch tables must name all four supported decoded generations.
+func TestSharedViewDispatchCoversEverySupportedGeneration(t *testing.T) {
+	p := loadProgram(t)
+	report := sharedDispatchSite(p)
+	if len(report.Problems) > 0 {
+		t.Errorf("the consolidated view must be the single shared dispatch site before its generation coverage can hold: %s", strings.Join(report.Problems, "; "))
+		return
+	}
+	covered := map[int]bool{}
+	for reachable := range p.reachable(p.byID[report.Site]) {
+		for _, table := range reachable.generationTables {
+			for _, value := range table {
+				covered[value] = true
+			}
+		}
+	}
+	for generation := 1; generation <= 4; generation++ {
+		if !covered[generation] {
+			t.Errorf("the consolidated view %s must own the per-generation handling for generation %d; covered generations: %v", report.Site, generation, sortedInts(covered))
+		}
+	}
+}
+
+// TestP2PDataLayerDependencyDirection pins that the shared
+// handling sits in the data layer (reachable by both the metadata accessors
+// and the transaction readers) without reversing the package dependency
+// direction: no xdr production file may import the ingest or processor trees.
+func TestP2PDataLayerDependencyDirection(t *testing.T) {
+	p := loadProgram(t)
+	for file, paths := range p.imports {
+		if !strings.HasPrefix(file, pkgXDR+"/") {
+			continue
+		}
+		for _, path := range paths {
+			if strings.Contains(path, "/ingest") || strings.Contains(path, "/processors/") {
+				t.Errorf("data-layer file %s must not import %s: the consolidation must not reverse the package dependency direction", file, path)
+			}
+		}
+	}
+}
+
+// TestDecodedConsumersReadDataThroughConsolidatedView pins the dataflow half of
+// the consolidation: it is not enough for a consumer to merely reach the view,
+// the generation-dependent values the consumer returns must be read through
+// the view value instead of being rebuilt locally.
+func TestDecodedConsumersReadDataThroughConsolidatedView(t *testing.T) {
+	p := loadProgram(t)
+	report := sharedDispatchSite(p)
+	if len(report.Problems) > 0 {
+		t.Errorf("the dataflow check needs a single shared dispatch site, got problems: %s", strings.Join(report.Problems, "; "))
+		return
+	}
+	viewProviders := providersReaching(p, report.Site)
+	for _, id := range decodedConsumers {
+		d := p.consumerOf(id)
+		if d == nil {
+			t.Errorf("%s must remain declared as a production entry point", id)
+			continue
+		}
+		viewValues := viewValueNames(p, d, viewProviders)
+		if !usesViewValue(p, d, viewValues, viewProviders) {
+			t.Errorf("%s must obtain its generation-dependent data from the value produced by the consolidated view %s, not merely reach it (view values seen: %v)", id, report.Site.String(), sortedStrings(viewValues))
+		}
+	}
+}
+
+// The raw-view walk is already shared and is explicitly out of scope. Anchor
+// the check at exported callers and the raw input type, not private helper
+// names: renaming private helpers is allowed, duplicating/rerouting the walk
+// or sending raw consumers through the decoded view is not.
+func TestP2PRawViewDispatchRemainsShared(t *testing.T) {
+	p := loadProgram(t)
+	owners := map[siteID]bool{}
+	for _, d := range p.decls {
+		if d.id.Pkg == pkgIngest && d.rawViewInput && d.rawEventOutput && d.hasGenerationTable() {
+			owners[d.id] = true
+		}
+	}
+	if len(owners) != 1 {
+		t.Errorf("raw TransactionMetaView events must retain one dispatch owner, including no copied orphan walks; got %v", sortedIDs(owners))
+		return
+	}
+	for _, name := range []string{"EventsFromTxParts", "LedgerTransactionViewByHash", "LedgerTransactionViewRange"} {
+		root := p.byID[siteID{Pkg: pkgIngest, Name: name}]
+		if root == nil {
+			t.Errorf("raw-view entry point %s is missing", name)
+			continue
+		}
+		reached := false
+		for d := range p.reachable(root) {
+			if owners[d.id] {
+				reached = true
+			}
+			if d.id.Pkg == pkgXDR && d.decodedMetaInput && d.hasGenerationTable() {
+				t.Errorf("raw-view entry point %s must not route through decoded generation dispatch %s", name, d.id)
+			}
+		}
+		if !reached {
+			t.Errorf("raw-view entry point %s bypasses the shared raw dispatch %v", name, sortedIDs(owners))
+		}
+	}
+}
