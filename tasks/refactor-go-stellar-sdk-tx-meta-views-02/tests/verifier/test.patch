+type moduleRecord struct {
+	Path, GoMod string
+	Main        bool
+	Replace     *moduleRecord
+}
+
+type moduleManifest struct {
+	Module  struct{ Path string }
+	Require []struct{ Path string }
+	Replace []struct{ Old, New struct{ Path string } }
+}
+
+func moduleOutput(t *testing.T, root string, args ...string) []byte {
+	t.Helper()
+	cmd := exec.Command("go", args...)
+	cmd.Dir = root
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	raw, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("cannot inspect module dependencies: %v: %s", err, stderr.String())
+	}
+	return raw
+}
+
+func TestP2PNoNewModuleDependencies(t *testing.T) {
+	root := repoRoot(t)
+	allowed := map[string]bool{}
+	for _, path := range strings.Fields(baselineModulePaths) {
+		allowed[path] = true
+	}
+	check := func(path, source string) {
+		if !allowed[path] {
+			t.Errorf("new module dependency %s from %s is outside the frozen base graph", path, source)
+		}
+	}
+	checked := map[string]bool{}
+	manifest := func(path string) {
+		if path == "" || checked[path] {
+			return
+		}
+		checked[path] = true
+		var m moduleManifest
+		raw := moduleOutput(t, root, "mod", "edit", "-json", path)
+		if err := json.Unmarshal(raw, &m); err != nil {
+			t.Fatal(err)
+		}
+		check(m.Module.Path, path)
+		for _, req := range m.Require {
+			check(req.Path, path)
+		}
+		for _, replacement := range m.Replace {
+			check(replacement.Old.Path, path)
+			// Module replacements have a module path; filesystem replacements are
+			// inspected by their actual go.mod below, never exempted as local code.
+			if !filepath.IsAbs(replacement.New.Path) && !strings.HasPrefix(replacement.New.Path, ".") {
+				check(replacement.New.Path, path)
+			}
+		}
+	}
+	manifest(filepath.Join(root, "go.mod"))
+	// `all` includes unused declared requirements and workspace/nested modules.
+	// -mod=readonly prevents the check itself changing dependency declarations.
+	raw := moduleOutput(t, root, "list", "-mod=readonly", "-m", "-json", "all")
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	for {
+		var m moduleRecord
+		err := decoder.Decode(&m)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		check(m.Path, "resolved module graph")
+		if m.Main {
+			manifest(m.GoMod)
+		}
+		if m.Replace != nil {
+			if !filepath.IsAbs(m.Replace.Path) && !strings.HasPrefix(m.Replace.Path, ".") {
+				check(m.Replace.Path, "module replacement")
+			}
+			// Do not inspect cached upstream manifests: they may list optional modules
+			// pruned from the baseline graph. Local replacements are authored inputs.
+			if filepath.IsAbs(m.Replace.Path) || strings.HasPrefix(m.Replace.Path, ".") {
+				manifest(m.Replace.GoMod)
+			}
+		}
+	}
+}
