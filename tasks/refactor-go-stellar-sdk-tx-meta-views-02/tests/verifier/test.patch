+package token_transfer
+
+import (
+	"fmt"
+	"github.com/stellar/go-stellar-sdk/ingest"
+	"github.com/stellar/go-stellar-sdk/xdr"
+)
+
+// Drive the same frozen positive event fixtures through exported entry points.
+// This adapter neither discovers nor recreates a candidate's private parser.
+func p2pPublicContractEvent(p *EventsProcessor, tx ingest.LedgerTransaction, index *uint32, event xdr.ContractEvent) (*TokenTransferEvent, error) {
+	if index == nil {
+		return nil, fmt.Errorf("fixture requires operation index")
+	}
+	switch tx.UnsafeMeta.V {
+	case 3:
+		meta := xdr.TransactionMetaV3{}
+		if tx.UnsafeMeta.V3 != nil {
+			meta = *tx.UnsafeMeta.V3
+		}
+		soroban := xdr.SorobanTransactionMeta{}
+		if meta.SorobanMeta != nil {
+			soroban = *meta.SorobanMeta
+		}
+		soroban.Events = []xdr.ContractEvent{event}
+		meta.SorobanMeta = &soroban
+		tx.UnsafeMeta.V3 = &meta
+	case 4:
+		meta := xdr.TransactionMetaV4{}
+		if tx.UnsafeMeta.V4 != nil {
+			meta = *tx.UnsafeMeta.V4
+		}
+		ops := append([]xdr.OperationMetaV2{}, meta.Operations...)
+		for len(ops) <= int(*index) {
+			ops = append(ops, xdr.OperationMetaV2{})
+		}
+		ops[*index].Events = []xdr.ContractEvent{event}
+		meta.Operations = ops
+		tx.UnsafeMeta.V4 = &meta
+	default:
+		return nil, fmt.Errorf("fixture requires metadata generation3/4")
+	}
+	op := xdr.Operation{Body: xdr.OperationBody{Type: xdr.OperationTypeInvokeHostFunction}}
+	events, err := p.EventsFromOperation(tx, *index, op, xdr.OperationResult{})
+	if err != nil {
+		return nil, err
+	}
+	if len(events) != 1 {
+		return nil, fmt.Errorf("public operation produced %d events, want1", len(events))
+	}
+	return events[0], nil
+}
+func p2pPublicFeeEvents(p *EventsProcessor, tx ingest.LedgerTransaction) ([]*TokenTransferEvent, error) {
+	events, err := p.EventsFromTransaction(tx)
+	return events.FeeEvents, err
+}
