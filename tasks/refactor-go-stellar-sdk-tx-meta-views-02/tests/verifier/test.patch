+func TestP2PGetOperationChangesBoundsAndUnsupportedGenerations(t *testing.T) {
+	for name, meta := range p2pChangesMeta() {
+		t.Run(name, func(t *testing.T) {
+			tx := &LedgerTransaction{UnsafeMeta: meta}
+			for _, index := range []uint32{2, 9, ^uint32(0)} {
+				changes, err := tx.GetOperationChanges(index)
+				require.NoError(t, err)
+				assert.NotNil(t, changes)
+				assert.Len(t, changes, 0)
+			}
+		})
+	}
+
+	t.Run("generation-0", func(t *testing.T) {
+		tx := &LedgerTransaction{UnsafeMeta: xdr.TransactionMeta{V: 0, Operations: &[]xdr.OperationMeta{}}}
+		changes, err := tx.GetOperationChanges(0)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "TransactionMeta.V=0 not supported")
+		assert.NotNil(t, changes)
+		assert.Len(t, changes, 0)
+
+		changes, err = tx.GetChanges()
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "TransactionMeta.V=0 not supported")
+		assert.Nil(t, changes)
+	})
+
+	t.Run("unknown-generation", func(t *testing.T) {
+		tx := &LedgerTransaction{UnsafeMeta: xdr.TransactionMeta{V: 5}}
+		changes, err := tx.GetOperationChanges(0)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported TransactionMeta version: 5")
+		assert.NotNil(t, changes)
+		assert.Len(t, changes, 0)
+
+		changes, err = tx.GetChanges()
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported TransactionMeta version: 5")
+		assert.Nil(t, changes)
+	})
+}
