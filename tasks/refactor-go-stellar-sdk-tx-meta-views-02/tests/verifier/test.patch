+func TestP2PGetTransactionEventsAbsentOutcomes(t *testing.T) {
+	testCases := []struct {
+		name string
+		tx   *LedgerTransaction
+	}{
+		{
+			name: "generation-1",
+			tx:   &LedgerTransaction{Envelope: p2pClassicEnvelope(), UnsafeMeta: xdr.TransactionMeta{V: 1, V1: &xdr.TransactionMetaV1{}}},
+		},
+		{
+			name: "generation-2",
+			tx:   &LedgerTransaction{Envelope: p2pClassicEnvelope(), UnsafeMeta: xdr.TransactionMeta{V: 2, V2: &xdr.TransactionMetaV2{}}},
+		},
+		{
+			name: "generation-3-classic",
+			tx:   &LedgerTransaction{Envelope: p2pClassicEnvelope(), UnsafeMeta: xdr.TransactionMeta{V: 3, V3: &xdr.TransactionMetaV3{}}},
+		},
+		{
+			name: "generation-4-empty-operations",
+			tx: &LedgerTransaction{
+				Envelope: p2pClassicEnvelope(),
+				UnsafeMeta: xdr.TransactionMeta{V: 4, V4: &xdr.TransactionMetaV4{
+					Operations: []xdr.OperationMetaV2{},
+				}},
+			},
+		},
+	}
+
+	for _, testCase := range testCases {
+		t.Run(testCase.name, func(t *testing.T) {
+			events, err := testCase.tx.GetTransactionEvents()
+			require.NoError(t, err)
