+func TestP2PGetTransactionEventsGeneration3And4Composition(t *testing.T) {
+	eventA := p2pContractEvent("a")
+	eventB := p2pContractEvent("b")
+	eventC := p2pContractEvent("c")
+	diagnostic := xdr.DiagnosticEvent{InSuccessfulContractCall: true, Event: eventA}
+	stagedBefore := xdr.TransactionEvent{Stage: xdr.TransactionEventStageTransactionEventStageBeforeAllTxs, Event: eventA}
+	stagedAfter := xdr.TransactionEvent{Stage: xdr.TransactionEventStageTransactionEventStageAfterTx, Event: eventB}
+
+	t.Run("generation-3-soroban", func(t *testing.T) {
+		tx := &LedgerTransaction{
+			Envelope: p2pSorobanEnvelope(),
+			UnsafeMeta: xdr.TransactionMeta{V: 3, V3: &xdr.TransactionMetaV3{
+				SorobanMeta: &xdr.SorobanTransactionMeta{
+					Events:           []xdr.ContractEvent{eventA, eventB},
+					DiagnosticEvents: []xdr.DiagnosticEvent{diagnostic},
+				},
+			}},
+		}
+
+		events, err := tx.GetTransactionEvents()
+		require.NoError(t, err)
+		assert.Empty(t, events.TransactionEvents)
+		assert.Equal(t, [][]xdr.ContractEvent{{eventA, eventB}}, events.OperationEvents)
+		assert.Equal(t, []xdr.DiagnosticEvent{diagnostic}, events.DiagnosticEvents)
+	})
+
+	t.Run("generation-3-soroban-without-soroban-meta-single-empty-slot", func(t *testing.T) {
+		tx := &LedgerTransaction{
+			Envelope:   p2pSorobanEnvelope(),
+			UnsafeMeta: xdr.TransactionMeta{V: 3, V3: &xdr.TransactionMetaV3{}},
+		}
+
+		events, err := tx.GetTransactionEvents()
+		require.NoError(t, err)
+		assert.Empty(t, events.TransactionEvents)
+		require.Len(t, events.OperationEvents, 1)
+		assert.Empty(t, events.OperationEvents[0])
+		assert.Empty(t, events.DiagnosticEvents)
+	})
+
+	t.Run("generation-4", func(t *testing.T) {
+		tx := &LedgerTransaction{
+			Envelope: p2pClassicEnvelope(),
+			UnsafeMeta: xdr.TransactionMeta{V: 4, V4: &xdr.TransactionMetaV4{
+				Events:           []xdr.TransactionEvent{stagedBefore, stagedAfter},
+				DiagnosticEvents: []xdr.DiagnosticEvent{diagnostic},
+				Operations: []xdr.OperationMetaV2{
+					{Events: []xdr.ContractEvent{eventA}},
+					{Events: []xdr.ContractEvent{eventB, eventC}},
+				},
+			}},
+		}
+
+		events, err := tx.GetTransactionEvents()
+		require.NoError(t, err)
+		assert.Equal(t, []xdr.TransactionEvent{stagedBefore, stagedAfter}, events.TransactionEvents)
+		assert.Equal(t, [][]xdr.ContractEvent{{eventA}, {eventB, eventC}}, events.OperationEvents)
+		assert.Equal(t, []xdr.DiagnosticEvent{diagnostic}, events.DiagnosticEvents)
+	})
+}
