+func TestP2PGetChangesGeneration1OrderAndAssociations(t *testing.T) {
+	tx := &LedgerTransaction{UnsafeMeta: p2pChangesMeta()["v1"]}
+
+	changes, err := tx.GetChanges()
+	require.NoError(t, err)
+	require.Len(t, changes, 3)
+
+	assert.Equal(t, []xdr.Int64{100, 200, 300}, p2pPreBalances(changes))
+	assert.Equal(t, []LedgerEntryChangeReason{
+		LedgerEntryChangeReasonTransaction,
+		LedgerEntryChangeReasonOperation,
+		LedgerEntryChangeReasonOperation,
+	}, p2pReasons(changes))
+	assert.Equal(t, []uint32{0, 0, 1}, p2pOperationIndexes(changes))
+	for _, change := range changes {
+		assert.True(t, change.Transaction == tx, "change must reference its transaction")
+		assert.True(t, change.Ledger == &tx.Ledger, "change must reference the ledger")
+	}
+
+	operationChanges, err := tx.GetOperationChanges(1)
+	require.NoError(t, err)
+	require.Len(t, operationChanges, 1)
+	assert.Equal(t, xdr.Int64(300), operationChanges[0].Pre.Data.MustAccount().Balance)
+	assert.Equal(t, uint32(1), operationChanges[0].OperationIndex)
+	assert.Equal(t, LedgerEntryChangeReasonOperation, operationChanges[0].Reason)
+}
