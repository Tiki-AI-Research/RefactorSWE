index 00000000..496b0522
--- /dev/null
+++ b/ingest/tests/f2p_meta_view/token_semantics_test.go
@@ -0,0 +1,111 @@
+package f2p_meta_view
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/importer"
+	"go/parser"
+	"go/token"
+	"go/types"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+// Resolve the actual TransactionMeta type, including aliases and local copies.
+// Reading V for interpretation/error text is allowed; exposing union arms is not.
+func tokenUnionViolations(t *testing.T) []string {
+	t.Helper()
+	root := repoRoot(t)
+	cmd := exec.Command("go", "list", "-mod=readonly", "-deps", "-export", "-json", "./processors/token_transfer")
+	cmd.Dir = root
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	raw, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("infrastructure error: load token types: %v: %s", err, stderr.String())
+	}
+	exports := map[string]string{}
+	var active []string
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	const module = "github.com/stellar/go-stellar-sdk"
+	for {
+		var row struct {
+			ImportPath, Export string
+			GoFiles            []string
+		}
+		err := dec.Decode(&row)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("infrastructure error: decode exports: %v", err)
+		}
+		exports[row.ImportPath] = row.Export
+		if row.ImportPath == module+"/processors/token_transfer" {
+			active = row.GoFiles
+		}
+	}
+	if len(active) == 0 {
+		t.Fatal("infrastructure error: missing token source inventory")
+	}
+	fset := token.NewFileSet()
+	var files []*ast.File
+	for _, name := range active {
+		f, err := parser.ParseFile(fset, filepath.Join(root, "processors/token_transfer", name), nil, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		files = append(files, f)
+	}
+	imp := importer.ForCompiler(fset, "gc", func(path string) (io.ReadCloser, error) {
+		name := exports[path]
+		if name == "" {
+			return nil, fmt.Errorf("missing export %s", path)
+		}
+		return os.Open(name)
+	})
+	info := &types.Info{Types: map[ast.Expr]types.TypeAndValue{}, Selections: map[*ast.SelectorExpr]*types.Selection{}}
+	cfg := types.Config{Importer: imp}
+	if _, err := cfg.Check(module+"/processors/token_transfer", fset, files, info); err != nil {
+		t.Fatalf("infrastructure error: token type-check: %v", err)
+	}
+	pkg, err := imp.Import(module + "/xdr")
+	if err != nil {
+		t.Fatal(err)
+	}
+	meta := pkg.Scope().Lookup("TransactionMeta").Type()
+	unwrap := func(typ types.Type) types.Type {
+		for {
+			typ = types.Unalias(typ)
+			if p, ok := typ.(*types.Pointer); ok {
+				typ = p.Elem()
+			} else {
+				return typ
+			}
+		}
+	}
+	var found []string
+	for _, f := range files {
+		ast.Inspect(f, func(node ast.Node) bool {
+			sel, ok := node.(*ast.SelectorExpr)
+			if !ok || (!isUnionArmField(sel.Sel.Name) && !isUnionArmAccessor(sel.Sel.Name)) {
+				return true
+			}
+			typ := info.TypeOf(sel.X)
+			if typ == nil {
+				t.Fatalf("infrastructure error: unresolved selector at %v", fset.Position(sel.Pos()))
+			}
+			typ = unwrap(typ)
+			if types.Identical(typ, meta) || types.Identical(typ.Underlying(), meta.Underlying()) {
+				found = append(found, fmt.Sprintf("%s at %s", sel.Sel.Name, fset.Position(sel.Pos())))
+			}
+			return true
+		})
+	}
+	return found
+}
