+// These fixtures exercise the exported operation entry point. In particular,
+// rejected events must not disappear because their topics or asset are invalid.
+func p2pOperationFixture(t *testing.T, version int32, event xdr.ContractEvent) []*TokenTransferEvent {
+	t.Helper()
+	tx := someTxV3()
+	if version == 3 {
+		tx.UnsafeMeta = xdr.TransactionMeta{V: 3, V3: &xdr.TransactionMetaV3{
+			SorobanMeta: &xdr.SorobanTransactionMeta{Events: []xdr.ContractEvent{event}},
+		}}
+	} else {
+		tx.UnsafeMeta = xdr.TransactionMeta{V: 4, V4: &xdr.TransactionMetaV4{
+			Operations: []xdr.OperationMetaV2{{Events: []xdr.ContractEvent{event}}},
+		}}
+	}
+	op := xdr.Operation{Body: xdr.OperationBody{Type: xdr.OperationTypeInvokeHostFunction}}
+	events, err := NewEventsProcessor(someNetworkPassphrase).EventsFromOperation(tx, 0, op, xdr.OperationResult{})
+	require.NoError(t, err)
+	return events
+}
+
+func p2pCheckContractEventTypes(t *testing.T, version int32) {
+	t.Helper()
+	event := createContractEvent(TransferEvent, accountA.Address(), accountB.Address(), 89, nil,
+		usdcAsset.StringCanonical(), contractIdFromAsset(usdcAsset))
+	accepted := p2pOperationFixture(t, version, event)
+	require.Len(t, accepted, 1)
+	require.NotNil(t, accepted[0].GetTransfer())
+	assert.Equal(t, "89", accepted[0].GetTransfer().Amount)
+	assert.True(t, proto.Equal(usdcProtoAsset, accepted[0].GetTransfer().Asset))
+	for _, kind := range []xdr.ContractEventType{xdr.ContractEventTypeSystem, xdr.ContractEventTypeDiagnostic} {
+		t.Run(fmt.Sprintf("reject-type-%d", kind), func(t *testing.T) {
+			invalid := event
+			invalid.Type = kind
+			assert.Len(t, p2pOperationFixture(t, version, invalid), 0)
+		})
+	}
+}
+
+func p2pCheckIssuerTransfers(t *testing.T, version int32) {
+	t.Helper()
+	for _, issuerSends := range []bool{true, false} {
+		t.Run(fmt.Sprintf("issuer-sends-%t", issuerSends), func(t *testing.T) {
+			from, to := accountA.Address(), usdcIssuer
+			if issuerSends {
+				from, to = usdcIssuer, accountB.Address()
+			}
+			event := createContractEvent(TransferEvent, from, to, 89, nil,
+				usdcAsset.StringCanonical(), contractIdFromAsset(usdcAsset))
+			events := p2pOperationFixture(t, version, event)
+			require.Len(t, events, 1)
+			if version == 4 {
+				transfer := events[0].GetTransfer()
+				require.NotNil(t, transfer, "V4 must preserve an issuer transfer as a transfer")
+				assert.Equal(t, from, transfer.From)
+				assert.Equal(t, to, transfer.To)
+				assert.Equal(t, "89", transfer.Amount)
+				assert.True(t, proto.Equal(usdcProtoAsset, transfer.Asset))
+			} else if issuerSends {
+				mint := events[0].GetMint()
+				require.NotNil(t, mint, "V3 issuer-origin transfer must become mint")
+				assert.Nil(t, events[0].GetTransfer())
+				assert.Equal(t, to, mint.To)
+				assert.Equal(t, "89", mint.Amount)
+				assert.True(t, proto.Equal(usdcProtoAsset, mint.Asset))
+			} else {
+				burn := events[0].GetBurn()
+				require.NotNil(t, burn, "V3 issuer-destination transfer must become burn")
+				assert.Nil(t, events[0].GetTransfer())
+				assert.Equal(t, from, burn.From)
+				assert.Equal(t, "89", burn.Amount)
+				assert.True(t, proto.Equal(usdcProtoAsset, burn.Asset))
+			}
+		})
+	}
 }
