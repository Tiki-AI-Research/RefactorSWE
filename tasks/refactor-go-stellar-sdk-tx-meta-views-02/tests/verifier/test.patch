+func TestP2PContractEventAccessorsOutcomes(t *testing.T) {
+	eventA := p2pContractEvent("a")
+	eventB := p2pContractEvent("b")
+	diagnostic := xdr.DiagnosticEvent{InSuccessfulContractCall: true, Event: eventA}
+
+	t.Run("for-operation-v4-empty-operations", func(t *testing.T) {
+		tx := &LedgerTransaction{UnsafeMeta: xdr.TransactionMeta{V: 4, V4: &xdr.TransactionMetaV4{}}}
+		events, err := tx.GetContractEventsForOperation(0)
+		require.NoError(t, err)
+		assert.Nil(t, events)
+	})
+
+	t.Run("for-operation-v4-index-is-honored", func(t *testing.T) {
+		tx := &LedgerTransaction{UnsafeMeta: xdr.TransactionMeta{V: 4, V4: &xdr.TransactionMetaV4{
+			Operations: []xdr.OperationMetaV2{
+				{Events: []xdr.ContractEvent{eventA}},
+				{Events: []xdr.ContractEvent{eventB}},
+			},
+		}}}
+		events, err := tx.GetContractEventsForOperation(1)
+		require.NoError(t, err)
+		assert.Equal(t, []xdr.ContractEvent{eventB}, events)
+	})
+
+	t.Run("for-operation-unsupported", func(t *testing.T) {
+		tx := &LedgerTransaction{UnsafeMeta: xdr.TransactionMeta{V: 5}}
+		events, err := tx.GetContractEventsForOperation(0)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported TransactionMeta version: 5")
+		assert.Nil(t, events)
+	})
+
+	t.Run("non-soroban-envelope", func(t *testing.T) {
+		tx := &LedgerTransaction{Envelope: p2pClassicEnvelope(), UnsafeMeta: xdr.TransactionMeta{V: 3, V3: &xdr.TransactionMetaV3{
+			SorobanMeta: &xdr.SorobanTransactionMeta{Events: []xdr.ContractEvent{eventA}},
+		}}}
+		_, err := tx.GetContractEvents()
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "not a soroban transaction")
+	})
+
+	t.Run("soroban-generations", func(t *testing.T) {
+		txV3 := &LedgerTransaction{Envelope: p2pSorobanEnvelope(), UnsafeMeta: xdr.TransactionMeta{V: 3, V3: &xdr.TransactionMetaV3{
+			SorobanMeta: &xdr.SorobanTransactionMeta{Events: []xdr.ContractEvent{eventA, eventB}},
+		}}}
+		events, err := txV3.GetContractEvents()
+		require.NoError(t, err)
+		assert.Equal(t, []xdr.ContractEvent{eventA, eventB}, events)
+
+		txV4 := &LedgerTransaction{Envelope: p2pSorobanEnvelope(), UnsafeMeta: xdr.TransactionMeta{V: 4, V4: &xdr.TransactionMetaV4{
+			Operations: []xdr.OperationMetaV2{{Events: []xdr.ContractEvent{eventB}}},
+		}}}
+		events, err = txV4.GetContractEvents()
+		require.NoError(t, err)
+		assert.Equal(t, []xdr.ContractEvent{eventB}, events)
+	})
+
+	t.Run("diagnostic-events", func(t *testing.T) {
+		txV1 := &LedgerTransaction{UnsafeMeta: xdr.TransactionMeta{V: 1, V1: &xdr.TransactionMetaV1{}}}
+		events, err := txV1.GetDiagnosticEvents()
+		require.NoError(t, err)
+		assert.Nil(t, events)
+
+		txV3MissingSorobanMeta := &LedgerTransaction{UnsafeMeta: xdr.TransactionMeta{V: 3, V3: &xdr.TransactionMetaV3{}}}
+		events, err = txV3MissingSorobanMeta.GetDiagnosticEvents()
+		require.NoError(t, err)
+		assert.Nil(t, events)
+
+		txV4 := &LedgerTransaction{UnsafeMeta: xdr.TransactionMeta{V: 4, V4: &xdr.TransactionMetaV4{
+			DiagnosticEvents: []xdr.DiagnosticEvent{diagnostic},
+		}}}
+		events, err = txV4.GetDiagnosticEvents()
+		require.NoError(t, err)
+		assert.Equal(t, []xdr.DiagnosticEvent{diagnostic}, events)
+
+		txUnknown := &LedgerTransaction{UnsafeMeta: xdr.TransactionMeta{V: 7}}
+		_, err = txUnknown.GetDiagnosticEvents()
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported TransactionMeta version: 7")
+	})
+}
