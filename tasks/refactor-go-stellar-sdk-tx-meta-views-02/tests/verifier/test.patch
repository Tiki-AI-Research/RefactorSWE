+// Supplemental P2P regression coverage for the consolidated decoded-metadata
+// generation view. These tests only exercise the exported transaction metadata
+// APIs and pin per-generation observable behavior, so they pass on the
+// Baseline and fail on any refactor that changes the preserved contract.
+
+const p2pMetadataAccount = "GAHK7EEG2WWHVKDNT4CEQFZGKF2LGDSW2IVM4S5DP42RBW3K6BTODB4A"
+
+var p2pMetadataAccountId = xdr.MustMuxedAddress(p2pMetadataAccount)
+
+func p2pLedgerEntry(balance int64) *xdr.LedgerEntry {
+	return &xdr.LedgerEntry{
+		Data: xdr.LedgerEntryData{
+			Type: xdr.LedgerEntryTypeAccount,
+			Account: &xdr.AccountEntry{
+				AccountId: xdr.MustAddress(p2pMetadataAccount),
+				Balance:   xdr.Int64(balance),
+			},
+		},
+	}
+}
+
+func p2pChangePair(from, to int64) xdr.LedgerEntryChanges {
+	return xdr.LedgerEntryChanges{
+		{
+			Type:  xdr.LedgerEntryChangeTypeLedgerEntryState,
+			State: p2pLedgerEntry(from),
+		},
+		{
+			Type:    xdr.LedgerEntryChangeTypeLedgerEntryUpdated,
+			Updated: p2pLedgerEntry(to),
+		},
+	}
+}
+
+func p2pChangePairBalances(balance int64) xdr.LedgerEntryChanges {
+	return p2pChangePair(balance, balance+1)
+}
+
+func p2pPreBalances(changes []Change) []xdr.Int64 {
+	balances := make([]xdr.Int64, 0, len(changes))
+	for _, change := range changes {
+		balances = append(balances, change.Pre.Data.MustAccount().Balance)
+	}
+	return balances
+}
+
+func p2pReasons(changes []Change) []LedgerEntryChangeReason {
+	reasons := make([]LedgerEntryChangeReason, 0, len(changes))
+	for _, change := range changes {
+		reasons = append(reasons, change.Reason)
+	}
+	return reasons
+}
+
+func p2pOperationIndexes(changes []Change) []uint32 {
+	indexes := make([]uint32, 0, len(changes))
+	for _, change := range changes {
+		indexes = append(indexes, change.OperationIndex)
+	}
+	return indexes
+}
+
+func p2pClassicEnvelope() xdr.TransactionEnvelope {
+	return xdr.TransactionEnvelope{
+		Type: xdr.EnvelopeTypeEnvelopeTypeTx,
+		V1: &xdr.TransactionV1Envelope{
+			Tx: xdr.Transaction{
+				SourceAccount: p2pMetadataAccountId,
+			},
+		},
+	}
+}
+
+func p2pSorobanEnvelope() xdr.TransactionEnvelope {
+	return xdr.TransactionEnvelope{
+		Type: xdr.EnvelopeTypeEnvelopeTypeTx,
+		V1: &xdr.TransactionV1Envelope{
+			Tx: xdr.Transaction{
+				SourceAccount: p2pMetadataAccountId,
+				Ext: xdr.TransactionExt{
+					V:           1,
+					SorobanData: &xdr.SorobanTransactionData{},
+				},
+			},
+		},
+	}
+}
+
+func p2pContractEvent(topic string) xdr.ContractEvent {
+	topicValue := xdr.ScSymbol(topic)
+	return xdr.ContractEvent{
+		Type: xdr.ContractEventTypeContract,
+		Body: xdr.ContractEventBody{
+			V: 0,
+			V0: &xdr.ContractEventV0{
+				Topics: []xdr.ScVal{{Type: xdr.ScValTypeScvSymbol, Sym: &topicValue}},
+			},
+		},
+	}
+}
