+// p2pChangesMeta returns metadata for each supported generation carrying
+// leading transaction changes (balances 100), two operation change groups
+// (200, 300) and, for generations 2-4, trailing transaction changes (400).
+func p2pChangesMeta() map[string]xdr.TransactionMeta {
+	return map[string]xdr.TransactionMeta{
+		"v1": {
+			V: 1,
+			V1: &xdr.TransactionMetaV1{
+				TxChanges: p2pChangePairBalances(100),
+				Operations: []xdr.OperationMeta{
+					{Changes: p2pChangePairBalances(200)},
+					{Changes: p2pChangePairBalances(300)},
+				},
+			},
+		},
+		"v2": {
+			V: 2,
+			V2: &xdr.TransactionMetaV2{
+				TxChangesBefore: p2pChangePairBalances(100),
+				Operations: []xdr.OperationMeta{
+					{Changes: p2pChangePairBalances(200)},
+					{Changes: p2pChangePairBalances(300)},
+				},
+				TxChangesAfter: p2pChangePairBalances(400),
+			},
+		},
+		"v3": {
+			V: 3,
+			V3: &xdr.TransactionMetaV3{
+				TxChangesBefore: p2pChangePairBalances(100),
+				Operations: []xdr.OperationMeta{
+					{Changes: p2pChangePairBalances(200)},
+					{Changes: p2pChangePairBalances(300)},
+				},
+				TxChangesAfter: p2pChangePairBalances(400),
+			},
+		},
+		"v4": {
+			V: 4,
+			V4: &xdr.TransactionMetaV4{
+				TxChangesBefore: p2pChangePairBalances(100),
+				Operations: []xdr.OperationMetaV2{
+					{Changes: p2pChangePairBalances(200)},
+					{Changes: p2pChangePairBalances(300)},
+				},
+				TxChangesAfter: p2pChangePairBalances(400),
+			},
+		},
+	}
+}
