+
+	t.Run("unknown-generation", func(t *testing.T) {
+		tx := &LedgerTransaction{Envelope: p2pClassicEnvelope(), UnsafeMeta: xdr.TransactionMeta{V: 5}}
+		_, err := tx.GetTransactionEvents()
