@@ -0,0 +1,600 @@
+// Command p2p_junit runs the P2P-selected Go test nodes declared by the frozen
+// P2P plan and writes a regular JUnit XML report.
+//
+// Test selection comes from the pipeline-materialized p2p select file, passed
+// with --select-file ({p2p_select}: one `path::exact_leaf` selector per line).
+// When that file is not available the runner falls back to the selector set
+// frozen in the plan, so the command is self-sufficient. No selection manifest
+// other than the pipeline-provided one is required.
+//
+// The runner only uses the repository, the Go toolchain already present in the
+// image and its warm module cache: no installs, no downloads, no registry
+// access. Tests are executed per package with `go test -json` and the JSON
+// stream is converted into JUnit XML whose testcase identity is
+// `classname=path, name=leaf`, i.e. the exact selector.
+package main
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// defaultSelectors mirrors p2p[].selector from the frozen P2P plan.
+const defaultSelectors = `ingest/ledger_transaction_test.go::TestMetaV2Order
+ingest/ledger_transaction_test.go::TestFeeMetaAndOperationsChangesSeparate
+ingest/ledger_transaction_test.go::TestFailedTransactionOperationChangesMeta
+ingest/ledger_transaction_test.go::TestMetaV0
+ingest/ledger_transaction_test.go::TestTransactionHelperFunctions
+ingest/ledger_transaction_test.go::TestGetContractEventsForOperation
+ingest/ledger_transaction_test.go::TestGetSorobanContractEvents
+ingest/ledger_transaction_test.go::TestGetDiagnosticEvents
+ingest/ledger_transaction_test.go::TestGetTransactionEvents
+ingest/transaction_events_view_test.go::TestTransactionEventsFromMeta_MatchesParsedReader
+ingest/transaction_events_view_test.go::TestDiagnosticEventsFromMeta_MatchesParsedReader
+ingest/transaction_events_view_test.go::TestTransactionEventsFromMeta_LegacyV0
+ingest/transaction_events_view_test.go::TestTransactionEventsFromMeta_V3GateIsCallerResponsibility
+ingest/transaction_view_test.go::TestTransactionView_EventsAgreeWithGetTransactionEvents
+ingest/transaction_view_test.go::TestTransactionView_V3SorobanMetaAbsent_OneEmptyOperationSlot
+processors/token_transfer/contract_events_test.go::TestVersionSpecificSACValidation
+processors/token_transfer/contract_events_test.go::TestV4FeeEventParsing
+processors/token_transfer/contract_events_test.go::TestValidContractEventsV3
+processors/token_transfer/contract_events_test.go::TestValidContractEventsV4
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PGetChangesGeneration1OrderAndAssociations
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PGetChangesGeneration2Order
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PGetChangesGeneration3OrderAndAssociations
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PGetChangesGeneration4OrderAndAssociations
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PGetChangesLegacyInternalErrorShape
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PGetOperationChangesBoundsAndUnsupportedGenerations
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PGetTransactionEventsAbsentOutcomes
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PGetTransactionEventsGeneration3And4Composition
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PContractEventAccessorsOutcomes
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PSorobanResourceFeeRefundGenerationAndComposition
+ingest/ledger_transaction_metadata_view_p2p_test.go::TestP2PGetPostApplyFeeChangesClassification
+xdr/transaction_meta_p2p_test.go::TestP2PMetaGetContractEventsForOperationOutcomes
+xdr/transaction_meta_p2p_test.go::TestP2PMetaGetDiagnosticEventsOutcomes
+xdr/transaction_meta_p2p_test.go::TestP2PMetaGetTransactionEventsOutcomes
+processors/token_transfer/unified_events_p2p_test.go::TestP2PUnifiedEventsStreamAcceptsOnlyGeneration4
+processors/token_transfer/unified_events_p2p_test.go::TestP2PUnifiedEventsOptionDefaultsToLegacyInterpretation
+ingest/tests/f2p_meta_view/dispatch_test.go::TestP2PDataLayerDependencyDirection`
+
+type selector struct {
+	Path string
+	Leaf string
+}
+
+func (s selector) String() string { return s.Path + "::" + s.Leaf }
+
+type testEvent struct {
+	Action  string  `json:"Action"`
+	Package string  `json:"Package"`
+	Test    string  `json:"Test"`
+	Output  string  `json:"Output"`
+	Elapsed float64 `json:"Elapsed"`
+}
+
+type leafResult struct {
+	selector selector
+	status   string // pass, fail, skip, notrun
+	output   strings.Builder
+	elapsed  float64
+}
+
+type junitTestsuites struct {
+	XMLName  xml.Name         `xml:"testsuites"`
+	Tests    int              `xml:"tests,attr"`
+	Failures int              `xml:"failures,attr"`
+	Errors   int              `xml:"errors,attr"`
+	Skipped  int              `xml:"skipped,attr"`
+	Time     string           `xml:"time,attr"`
+	Suites   []junitTestsuite `xml:"testsuite"`
+}
+
+type junitTestsuite struct {
+	Name      string          `xml:"name,attr"`
+	Tests     int             `xml:"tests,attr"`
+	Failures  int             `xml:"failures,attr"`
+	Errors    int             `xml:"errors,attr"`
+	Skipped   int             `xml:"skipped,attr"`
+	Time      string          `xml:"time,attr"`
+	Timestamp string          `xml:"timestamp,attr"`
+	Cases     []junitTestcase `xml:"testcase"`
+	SystemOut string          `xml:"system-out,omitempty"`
+}
+
+type junitTestcase struct {
+	Classname string        `xml:"classname,attr"`
+	Name      string        `xml:"name,attr"`
+	Time      string        `xml:"time,attr"`
+	Failure   *junitFailure `xml:"failure,omitempty"`
+	Error     *junitFailure `xml:"error,omitempty"`
+	Skipped   *junitSkipped `xml:"skipped,omitempty"`
+}
+
+type junitFailure struct {
+	Type    string `xml:"type,attr,omitempty"`
+	Message string `xml:"message,attr"`
+	Body    string `xml:",chardata"`
+}
+
+type junitSkipped struct {
+	Message string `xml:"message,attr,omitempty"`
+}
+
+func main() {
+	var (
+		reportPath  string
+		selectFiles multiFlag
+		repoRoot    string
+		timeout     int
+		verbose     bool
+	)
+	flag.StringVar(&reportPath, "report", "", "path of the JUnit XML report to write")
+	flag.Var(&selectFiles, "select-file", "file with `path::exact_leaf` selectors (repeatable)")
+	flag.StringVar(&repoRoot, "repo", "", "repository root (defaults to the nearest parent with go.mod)")
+	flag.IntVar(&timeout, "timeout", 300, "per-package go test timeout in seconds")
+	flag.BoolVar(&verbose, "verbose", false, "stream go test JSON output to stderr")
+	flag.Parse()
+
+	if reportPath == "" {
+		fatalf("--report is required")
+	}
+	root, err := findRepoRoot(repoRoot)
+	if err != nil {
+		fatalf("%v", err)
+	}
+
+	selectors, err := loadSelectors(selectFiles, flag.Args(), root)
+	if err != nil {
+		fatalf("%v", err)
+	}
+	if len(selectors) == 0 {
+		fatalf("no selectors to run")
+	}
+
+	results := runSelectors(root, selectors, timeout, verbose)
+	if err := writeReport(reportPath, results); err != nil {
+		fatalf("failed to write report %q: %v", reportPath, err)
+	}
+
+	failed := 0
+	for _, result := range results {
+		if result.status != "pass" {
+			failed++
+		}
+	}
+	fmt.Fprintf(os.Stderr, "p2p_junit: %d selectors, %d not passing; report: %s\n", len(results), failed, reportPath)
+	if failed > 0 {
+		os.Exit(1)
+	}
+}
+
+type multiFlag []string
+
+func (m *multiFlag) String() string { return strings.Join(*m, ",") }
+
+func (m *multiFlag) Set(value string) error {
+	*m = append(*m, value)
+	return nil
+}
+
+func fatalf(format string, args ...any) {
+	fmt.Fprintf(os.Stderr, "p2p_junit: "+format+"\n", args...)
+	os.Exit(2)
+}
+
+func findRepoRoot(explicit string) (string, error) {
+	if explicit != "" {
+		return filepath.Abs(explicit)
+	}
+	dir, err := os.Getwd()
+	if err != nil {
+		return "", err
+	}
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir, nil
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "", fmt.Errorf("could not locate go.mod above %q", dir)
+		}
+		dir = parent
+	}
+}
+
+func loadSelectors(files []string, args []string, root string) ([]selector, error) {
+	var lines []string
+	for _, file := range files {
+		file = strings.TrimSpace(file)
+		if file == "" || strings.Contains(file, "{") {
+			// Placeholder was not substituted at runtime; fall back below.
+			continue
+		}
+		if !filepath.IsAbs(file) {
+			file = filepath.Join(root, file)
+		}
+		content, err := os.ReadFile(file)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "p2p_junit: select file %q unavailable (%v), using the frozen plan selector set\n", file, err)
+			continue
+		}
+		lines = append(lines, parseSelection(content)...)
+	}
+	lines = append(lines, args...)
+
+	selectors, err := parseSelectors(lines, root)
+	if err != nil {
+		return nil, err
+	}
+	if len(selectors) == 0 {
+		fmt.Fprintf(os.Stderr, "p2p_junit: no usable selection input, using the frozen plan selector set\n")
+		return parseSelectors(strings.Split(defaultSelectors, "\n"), root)
+	}
+	return selectors, nil
+}
+
+// parseSelection accepts either a JSON array of selector strings or
+// newline-separated selector strings.
+func parseSelection(content []byte) []string {
+	trimmed := strings.TrimSpace(string(content))
+	if strings.HasPrefix(trimmed, "[") {
+		var values []string
+		if err := json.Unmarshal([]byte(trimmed), &values); err == nil {
+			return values
+		}
+	}
+	return strings.Split(trimmed, "\n")
+}
+
+func parseSelectors(lines []string, root string) ([]selector, error) {
+	known := map[string]string{}
+	for _, line := range strings.Split(defaultSelectors, "\n") {
+		if parts := strings.SplitN(line, "::", 2); len(parts) == 2 {
+			known[parts[1]] = parts[0]
+		}
+	}
+
+	seen := map[string]bool{}
+	var selectors []selector
+	for _, raw := range lines {
+		line := strings.TrimSpace(raw)
+		line = strings.Trim(line, "\"',")
+		if index := strings.Index(line, " #"); index >= 0 {
+			line = line[:index]
+		}
+		line = strings.TrimSpace(strings.TrimPrefix(line, "- "))
+		if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, "//") {
+			continue
+		}
+		if strings.HasPrefix(line, "{") || strings.HasSuffix(line, "}") {
+			continue
+		}
+		var current selector
+		if parts := strings.SplitN(line, "::", 2); len(parts) == 2 {
+			current = selector{Path: strings.TrimPrefix(strings.TrimSpace(parts[0]), "./"), Leaf: strings.TrimSpace(parts[1])}
+		} else if path, ok := known[line]; ok {
+			current = selector{Path: path, Leaf: line}
+		} else {
+			fmt.Fprintf(os.Stderr, "p2p_junit: ignoring non-selector line %q\n", raw)
+			continue
+		}
+		if current.Path == "" || current.Leaf == "" {
+			return nil, fmt.Errorf("invalid selector %q", raw)
+		}
+		current.Path = canonicalTestPath(current.Path, current.Leaf, known, root)
+		if seen[current.String()] {
+			continue
+		}
+		seen[current.String()] = true
+		selectors = append(selectors, current)
+	}
+	return selectors, nil
+}
+
+// canonicalTestPath recovers the repository-relative test file for a selector
+// whose path is missing, absolute, or expressed as a package/import path.
+func canonicalTestPath(path, leaf string, known map[string]string, root string) string {
+	resolved := path
+	if filepath.IsAbs(resolved) {
+		if rel, err := filepath.Rel(root, resolved); err == nil {
+			resolved = rel
+		}
+	}
+	if !strings.HasSuffix(resolved, ".go") {
+		if knownPath, ok := known[leaf]; ok {
+			resolved = knownPath
+		}
+	}
+	if _, err := os.Stat(filepath.Join(root, resolved)); err != nil {
+		if knownPath, ok := known[leaf]; ok {
+			resolved = knownPath
+		}
+	}
+	return resolved
+}
+
+type packageRun struct {
+	dir       string
+	selectors []selector
+}
+
+func grouping(selectors []selector) []packageRun {
+	order := []string{}
+	byDir := map[string][]selector{}
+	for _, current := range selectors {
+		dir := filepath.Dir(current.Path)
+		if !strings.Contains(current.Path, ".go") {
+			dir = current.Path
+		}
+		if _, ok := byDir[dir]; !ok {
+			order = append(order, dir)
+		}
+		byDir[dir] = append(byDir[dir], current)
+	}
+	runs := make([]packageRun, 0, len(order))
+	for _, dir := range order {
+		runs = append(runs, packageRun{dir: dir, selectors: byDir[dir]})
+	}
+	return runs
+}
+
+func runSelectors(root string, selectors []selector, timeout int, verbose bool) []leafResult {
+	bySelector := map[string]*leafResult{}
+	results := make([]leafResult, 0, len(selectors))
+	for _, current := range selectors {
+		results = append(results, leafResult{selector: current, status: "notrun"})
+	}
+	for i := range results {
+		bySelector[results[i].selector.String()] = &results[i]
+	}
+
+	for _, run := range grouping(selectors) {
+		runPackage(root, run, bySelector, timeout, verbose)
+	}
+	return results
+}
+
+func runPackage(root string, run packageRun, bySelector map[string]*leafResult, timeout int, verbose bool) {
+	leaves := make([]string, 0, len(run.selectors))
+	for _, current := range run.selectors {
+		leaves = append(leaves, regexp.QuoteMeta(current.Leaf))
+	}
+	runPattern := "^(" + strings.Join(leaves, "|") + ")$"
+
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeout+30)*time.Second)
+	defer cancel()
+
+	args := []string{"test", "-json", "-count=1", "-timeout", fmt.Sprintf("%ds", timeout), "-run", runPattern, "./" + run.dir}
+	cmd := exec.CommandContext(ctx, "go", args...)
+	cmd.Dir = root
+	env := os.Environ()
+	env = append(env, "GOTOOLCHAIN=local", "GOPROXY=off")
+	cmd.Env = env
+
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		markPackageError(run, bySelector, fmt.Sprintf("failed to start go test: %v", err))
+		return
+	}
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+
+	if err := cmd.Start(); err != nil {
+		markPackageError(run, bySelector, fmt.Sprintf("failed to start go test: %v", err))
+		return
+	}
+
+	var packageOutput strings.Builder
+	statuses := map[string]string{}
+	elapsed := map[string]float64{}
+	outputs := map[string]*strings.Builder{}
+	failedTests := map[string]bool{}
+
+	scanner := bufio.NewScanner(stdout)
+	scanner.Buffer(make([]byte, 0, 64*1024), 16*1024*1024)
+	for scanner.Scan() {
+		line := scanner.Bytes()
+		if verbose {
+			fmt.Fprintln(os.Stderr, string(line))
+		}
+		var event testEvent
+		if err := json.Unmarshal(line, &event); err != nil {
+			packageOutput.Write(line)
+			packageOutput.WriteByte('\n')
+			continue
+		}
+		if event.Test == "" {
+			if event.Action == "output" || event.Action == "build-output" {
+				packageOutput.WriteString(event.Output)
+			}
+			continue
+		}
+		top := topLevelTest(event.Test)
+		if _, ok := bySelector[selectorForPath(run, top)]; !ok {
+			continue
+		}
+		if outputs[event.Test] == nil {
+			outputs[event.Test] = &strings.Builder{}
+		}
+		switch event.Action {
+		case "output":
+			outputs[event.Test].WriteString(event.Output)
+		case "fail":
+			failedTests[top] = true
+		case "pass":
+			if !failedTests[top] {
+				statuses[top] = "pass"
+				elapsed[top] = event.Elapsed
+			}
+		case "skip":
+			if !failedTests[top] {
+				statuses[top] = "skip"
+				elapsed[top] = event.Elapsed
+			}
+		}
+	}
+	waitErr := cmd.Wait()
+
+	for _, current := range run.selectors {
+		result := bySelector[current.String()]
+		if failedTests[current.Leaf] {
+			result.status = "fail"
+			result.elapsed = elapsed[current.Leaf]
+			var parts []string
+			for name, buffer := range outputs {
+				if topLevelTest(name) == current.Leaf {
+					parts = append(parts, buffer.String())
+				}
+			}
+			result.output.WriteString(strings.Join(parts, ""))
+			if result.output.Len() == 0 {
+				result.output.WriteString(packageOutput.String())
+			}
+			continue
+		}
+		if status, ok := statuses[current.Leaf]; ok {
+			result.status = status
+			result.elapsed = elapsed[current.Leaf]
+			continue
+		}
+		// No per-test event: the package did not build or the selector was not
+		// collected. Surface it as an error, never as a silent pass.
+		result.status = "notrun"
+		detail := strings.TrimSpace(packageOutput.String())
+		if detail == "" {
+			detail = strings.TrimSpace(stderr.String())
+		}
+		if detail == "" && waitErr != nil {
+			detail = waitErr.Error()
+		}
+		if detail == "" {
+			detail = fmt.Sprintf("go test did not report a result for %s", current.Leaf)
+		}
+		result.output.WriteString(detail)
+	}
+}
+
+func selectorForPath(run packageRun, leaf string) string {
+	for _, current := range run.selectors {
+		if current.Leaf == leaf {
+			return current.String()
+		}
+	}
+	return ""
+}
+
+func topLevelTest(name string) string {
+	if index := strings.Index(name, "/"); index >= 0 {
+		return name[:index]
+	}
+	return name
+}
+
+func markPackageError(run packageRun, bySelector map[string]*leafResult, message string) {
+	for _, current := range run.selectors {
+		result := bySelector[current.String()]
+		result.status = "notrun"
+		result.output.WriteString(message)
+	}
+}
+
+// failureType distinguishes completed test failures from Go runtime failures.
+// Runtime diagnostics begin at column zero; assertion messages are indented.
+func failureType(output string) string {
+	for _, line := range strings.Split(output, "\n") {
+		if strings.HasPrefix(line, "panic: test timed out after ") {
+			return "Timeout"
+		}
+		if strings.HasPrefix(line, "panic:") || strings.HasPrefix(line, "fatal error:") ||
+			regexp.MustCompile(`^SIG[A-Z0-9]+:`).MatchString(line) {
+			return "Process Crash"
+		}
+	}
+	return ""
+}
+
+func writeReport(path string, results []leafResult) error {
+	timestamp := time.Now().UTC().Format(time.RFC3339)
+	suite := junitTestsuite{Timestamp: timestamp, Name: "p2p"}
+	totalTime := 0.0
+
+	for _, result := range results {
+		testCase := junitTestcase{
+			Classname: result.selector.Path,
+			Name:      result.selector.Leaf,
+			Time:      fmt.Sprintf("%.3f", result.elapsed),
+		}
+		totalTime += result.elapsed
+		//nolint:exhaustive
+		switch result.status {
+		case "pass":
+		case "skip":
+			suite.Skipped++
+			testCase.Skipped = &junitSkipped{Message: "skipped"}
+		case "fail":
+			failure := &junitFailure{
+				Type:    "AssertionFailure",
+				Message: fmt.Sprintf("%s failed", result.selector.Leaf),
+				Body:    result.output.String(),
+			}
+			if kind := failureType(result.output.String()); kind != "" {
+				suite.Errors++
+				failure.Type = kind
+				testCase.Error = failure
+			} else {
+				suite.Failures++
+				testCase.Failure = failure
+			}
+		default:
+			suite.Errors++
+			testCase.Error = &junitFailure{
+				Type:    failureType(result.output.String()),
+				Message: fmt.Sprintf("%s was not executed", result.selector.Leaf),
+				Body:    result.output.String(),
+			}
+		}
+		suite.Cases = append(suite.Cases, testCase)
+	}
+	suite.Tests = len(suite.Cases)
+	suite.Time = fmt.Sprintf("%.3f", totalTime)
+
+	report := junitTestsuites{
+		Tests:    suite.Tests,
+		Failures: suite.Failures,
+		Errors:   suite.Errors,
+		Skipped:  suite.Skipped,
+		Time:     suite.Time,
+		Suites:   []junitTestsuite{suite},
+	}
+
+	if dir := filepath.Dir(path); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			return err
+		}
+	}
+	file, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	if _, err := io.WriteString(file, xml.Header); err != nil {
+		return err
+	}
+	encoder := xml.NewEncoder(file)
+	encoder.Indent("", "  ")
+	if err := encoder.Encode(report); err != nil {
+		return err
+	}
+	return encoder.Flush()
+}
diff --git a/ingest/tests/p2p_junit/run_p2p.sh b/ingest/tests/p2p_junit/run_p2p.sh
new file mode 100644
index 00000000..4f931fe6
--- /dev/null
+++ b/ingest/tests/p2p_junit/run_p2p.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# Build and run the P2P JUnit runner with every build artifact placed in an
+# exec-capable directory.
+#
+# The replay sandbox mounts TMPDIR (and therefore go's default GOTMPDIR) with
+# noexec, so `go run`/`go test` cannot execute the binaries they link there.
+# The frozen plan declares require_exec, so the pipeline provides
+# VERIFIER_EXEC_DIR: the compiled runner and every `go test` binary are placed
+# below it (TMPDIR is only a fallback for local runs). GOTOOLCHAIN=local and
+# GOPROXY=off keep the run fully offline, and the caller's working directory is
+# preserved so relative {report} and {p2p_select} paths keep their
+# caller-relative meaning.
+set -euo pipefail
+
+script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+repo_root="$(cd -- "${script_dir}/../../.." && pwd)"
+
+base_dir="${VERIFIER_EXEC_DIR:-${TMPDIR:-/tmp}}"
+exec_dir="${base_dir}/p2p-junit"
+mkdir -p "$exec_dir"
+export GOTMPDIR="${exec_dir}/go-build-tmp"
+mkdir -p "$GOTMPDIR"
+export GOTOOLCHAIN=local
+export GOPROXY=off
+echo "run_p2p.sh: building P2P runner into ${exec_dir}" >&2
+
+runner_bin="${exec_dir}/p2p_junit"
+go -C "$repo_root" build -o "$runner_bin" ./ingest/tests/p2p_junit
+exec "$runner_bin" --repo "$repo_root" "$@"
