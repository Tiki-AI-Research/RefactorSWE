+func TestP2PSorobanResourceFeeRefundGenerationAndComposition(t *testing.T) {
+	t.Run("non-soroban-transaction", func(t *testing.T) {
+		tx := &LedgerTransaction{Envelope: p2pClassicEnvelope(), UnsafeMeta: xdr.TransactionMeta{V: 3, V3: &xdr.TransactionMetaV3{
+			TxChangesAfter: p2pChangePair(1000, 1050),
+		}}}
+		assert.Equal(t, int64(0), tx.SorobanResourceFeeRefund())
+	})
+
+	t.Run("generation-3-trailing-changes", func(t *testing.T) {
+		tx := &LedgerTransaction{Envelope: p2pSorobanEnvelope(), UnsafeMeta: xdr.TransactionMeta{V: 3, V3: &xdr.TransactionMetaV3{
+			TxChangesAfter: p2pChangePair(1000, 1030),
+		}}}
+		assert.Equal(t, int64(30), tx.SorobanResourceFeeRefund())
+	})
+
+	t.Run("generation-4-post-apply-changes", func(t *testing.T) {
+		tx := &LedgerTransaction{
+			Envelope:              p2pSorobanEnvelope(),
+			UnsafeMeta:            xdr.TransactionMeta{V: 4, V4: &xdr.TransactionMetaV4{}},
+			PostTxApplyFeeChanges: p2pChangePair(2000, 2025),
+		}
+		assert.Equal(t, int64(25), tx.SorobanResourceFeeRefund())
+	})
+
+	t.Run("trailing-changes-precede-post-apply-changes", func(t *testing.T) {
+		tx := &LedgerTransaction{
+			Envelope: p2pSorobanEnvelope(),
+			UnsafeMeta: xdr.TransactionMeta{V: 4, V4: &xdr.TransactionMetaV4{
+				TxChangesAfter: p2pChangePair(1000, 1001),
+			}},
+			PostTxApplyFeeChanges: p2pChangePair(1001, 1030),
+		}
+		assert.Equal(t, int64(29), tx.SorobanResourceFeeRefund())
+	})
+
+	// A valid account pair reaches the balance-decrease guard, rather than
+	// panicking earlier while unwrapping metadata or looking up the fee payer.
+	for _, version := range []int32{3, 4} {
+		for _, postApply := range []bool{false, true} {
+			t.Run(fmt.Sprintf("decreasing-balance-v%d-post-apply-%t", version, postApply), func(t *testing.T) {
+				meta := xdr.TransactionMeta{V: version}
+				var trailing xdr.LedgerEntryChanges
+				if !postApply {
+					trailing = p2pChangePair(1000, 999)
+				}
+				if version == 3 {
+					meta.V3 = &xdr.TransactionMetaV3{TxChangesAfter: trailing}
+				} else {
+					meta.V4 = &xdr.TransactionMetaV4{TxChangesAfter: trailing}
+				}
+				tx := &LedgerTransaction{Envelope: p2pSorobanEnvelope(), UnsafeMeta: meta}
+				if postApply {
+					tx.PostTxApplyFeeChanges = p2pChangePair(1000, 999)
+				}
+				require.PanicsWithValue(t, "Invalid Soroban Resource Refund", func() { tx.SorobanResourceFeeRefund() })
+			})
+		}
+	}
+
+	t.Run("unsupported-generations-do-not-return-a-value", func(t *testing.T) {
+		for _, version := range []int32{0, 1, 2, 5} {
+			meta := xdr.TransactionMeta{V: version}
+			switch version {
+			case 1:
+				meta.V1 = &xdr.TransactionMetaV1{}
+			case 2:
+				meta.V2 = &xdr.TransactionMetaV2{}
+			}
+			tx := &LedgerTransaction{Envelope: p2pSorobanEnvelope(), UnsafeMeta: meta}
+			require.Panics(t, func() { tx.SorobanResourceFeeRefund() }, "generation %d must not return a refund value", version)
+		}
+	})
+}
+
+func TestP2PGetPostApplyFeeChangesClassification(t *testing.T) {
+	tx := &LedgerTransaction{PostTxApplyFeeChanges: p2pChangePair(700, 705)}
+
+	changes := tx.GetPostApplyFeeChanges()
+	require.Len(t, changes, 1)
+	assert.Equal(t, LedgerEntryChangeReasonFeeRefund, changes[0].Reason)
+	assert.True(t, changes[0].Transaction == tx, "change must reference its transaction")
+	assert.True(t, changes[0].Ledger == &tx.Ledger, "change must reference the ledger")
+	assert.Equal(t, xdr.Int64(700), changes[0].Pre.Data.MustAccount().Balance)
+	assert.Equal(t, xdr.Int64(705), changes[0].Post.Data.MustAccount().Balance)
+}
diff --git a/ingest/tests/f2p_junit/main.go b/ingest/tests/f2p_junit/main.go
new file mode 100644
index 00000000..2fc35441
--- /dev/null
+++ b/ingest/tests/f2p_junit/main.go
@@ -0,0 +1,475 @@
+// Command f2p_junit runs the frozen P2P selectors plus the F2P selectors
+// declared by the task plan and writes a regular JUnit XML report.
+//
+// Selection comes from the pipeline-materialized {config} file only: the
+// exact `path::exact_leaf` selectors are read from its `p2p` and `f2p` arrays.
+// No selector inventory is embedded in this runner, and no test file glob,
+// package-wide pattern or original inventory is ever used as the scoring
+// selection set.
+//
+// Only the repository, the Go toolchain already present in the image and its
+// warm module cache are used: no installs, no downloads, no registry access.
+// Tests are executed per package with `go test -json` and the JSON stream is
+// converted into JUnit XML whose testcase identity is `classname=path,
+// name=leaf`, i.e. the exact selector.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+type selector struct {
+	Path string
+	Leaf string
+}
+
+func (s selector) String() string { return s.Path + "::" + s.Leaf }
+
+type testEvent struct {
+	Action  string  `json:"Action"`
+	Package string  `json:"Package"`
+	Test    string  `json:"Test"`
+	Output  string  `json:"Output"`
+	Elapsed float64 `json:"Elapsed"`
+}
+
+type leafResult struct {
+	selector selector
+	status   string // pass, fail, skip, notrun
+	output   strings.Builder
+	elapsed  float64
+}
+
+type junitTestsuites struct {
+	XMLName  xml.Name         `xml:"testsuites"`
+	Tests    int              `xml:"tests,attr"`
+	Failures int              `xml:"failures,attr"`
+	Errors   int              `xml:"errors,attr"`
+	Skipped  int              `xml:"skipped,attr"`
+	Time     string           `xml:"time,attr"`
+	Suites   []junitTestsuite `xml:"testsuite"`
+}
+
+type junitTestsuite struct {
+	Name      string          `xml:"name,attr"`
+	Tests     int             `xml:"tests,attr"`
+	Failures  int             `xml:"failures,attr"`
+	Errors    int             `xml:"errors,attr"`
+	Skipped   int             `xml:"skipped,attr"`
+	Time      string          `xml:"time,attr"`
+	Timestamp string          `xml:"timestamp,attr"`
+	Cases     []junitTestcase `xml:"testcase"`
+}
+
+type junitTestcase struct {
+	Classname string        `xml:"classname,attr"`
+	Name      string        `xml:"name,attr"`
+	Time      string        `xml:"time,attr"`
+	Failure   *junitFailure `xml:"failure,omitempty"`
+	Error     *junitFailure `xml:"error,omitempty"`
+	Skipped   *junitSkipped `xml:"skipped,omitempty"`
+}
+
+type junitFailure struct {
+	Type    string `xml:"type,attr,omitempty"`
+	Message string `xml:"message,attr"`
+	Body    string `xml:",chardata"`
+}
+
+type junitSkipped struct {
+	Message string `xml:"message,attr"`
+}
+
+func main() {
+	var (
+		repoPath   = flag.String("repo", "", "repository root (defaults to the working directory)")
+		configPath = flag.String("config", "", "pipeline-materialized config.json carrying the p2p and f2p selector arrays")
+		reportPath = flag.String("report", "", "path of the JUnit XML report to write")
+		verbose    = flag.Bool("verbose", false, "stream go test events to stderr")
+	)
+	flag.Parse()
+	if *reportPath == "" {
+		fmt.Fprintln(os.Stderr, "f2p_junit: --report is required")
+		os.Exit(2)
+	}
+	repo := *repoPath
+	if repo == "" {
+		wd, err := os.Getwd()
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "f2p_junit: cannot determine working directory: %v\n", err)
+			os.Exit(2)
+		}
+		repo = wd
+	}
+
+	selectors, err := loadSelectors(*configPath)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "f2p_junit: %v\n", err)
+		os.Exit(2)
+	}
+	fmt.Fprintf(os.Stderr, "f2p_junit: running %d selectors (selection: %s)\n", len(selectors), *configPath)
+
+	results := execute(repo, selectors, *verbose)
+	if err := writeReport(*reportPath, results); err != nil {
+		fmt.Fprintf(os.Stderr, "f2p_junit: cannot write report %s: %v\n", *reportPath, err)
+		os.Exit(1)
+	}
+	failed := 0
+	for _, result := range results {
+		if result.status != "pass" {
+			failed++
+		}
+	}
+	fmt.Fprintf(os.Stderr, "f2p_junit: %d/%d selectors passed\n", len(results)-failed, len(results))
+	if failed > 0 {
+		os.Exit(1)
+	}
+}
+
+// loadSelectors reads the exact selector set from the pipeline-materialized
+// config. Only its `p2p` and `f2p` arrays are consulted; the runner declares no
+// selector inventory of its own.
+func loadSelectors(configPath string) ([]selector, error) {
+	if configPath == "" {
+		return nil, fmt.Errorf("--config is required: the frozen P2P+F2P selector set comes from the pipeline config")
+	}
+	raw, err := os.ReadFile(configPath)
+	if err != nil {
+		return nil, fmt.Errorf("cannot read config %s: %w", configPath, err)
+	}
+	var decoded map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &decoded); err != nil {
+		return nil, fmt.Errorf("cannot decode config %s: %w", configPath, err)
+	}
+	var out []selector
+	for _, key := range []string{"p2p", "f2p"} {
+		value, ok := decoded[key]
+		if !ok {
+			continue
+		}
+		out = append(out, parseEntries(value)...)
+	}
+	if len(out) == 0 {
+		return nil, fmt.Errorf("config %s carries no p2p/f2p selectors", configPath)
+	}
+	return out, nil
+}
+
+func parseEntries(raw json.RawMessage) []selector {
+	var entries []json.RawMessage
+	if err := json.Unmarshal(raw, &entries); err != nil {
+		return nil
+	}
+	var out []selector
+	for _, entry := range entries {
+		var text string
+		if err := json.Unmarshal(entry, &text); err == nil {
+			if parsed, ok := parseSelector(text); ok {
+				out = append(out, parsed)
+			}
+			continue
+		}
+		var object map[string]any
+		if err := json.Unmarshal(entry, &object); err != nil {
+			continue
+		}
+		for _, key := range []string{"selector", "test"} {
+			if text, ok := object[key].(string); ok {
+				if parsed, ok := parseSelector(text); ok {
+					out = append(out, parsed)
+				}
+				break
+			}
+		}
+	}
+	return out
+}
+
+func parseSelector(text string) (selector, bool) {
+	text = strings.TrimSpace(text)
+	parts := strings.SplitN(text, "::", 2)
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+		return selector{}, false
+	}
+	return selector{Path: parts[0], Leaf: parts[1]}, true
+}
+
+// packageFor maps a selector file path to the Go package pattern run by
+// `go test`: the directory holding the file.
+func packageFor(selectorPath string) string {
+	dir := filepath.Dir(selectorPath)
+	if dir == "." || dir == "" {
+		return "."
+	}
+	return "./" + filepath.ToSlash(dir)
+}
+
+func execute(repo string, selectors []selector, verbose bool) []leafResult {
+	bySelector := map[string]*leafResult{}
+	var ordered []*leafResult
+	byPackage := map[string][]selector{}
+	for _, current := range selectors {
+		key := current.String()
+		if _, ok := bySelector[key]; ok {
+			continue
+		}
+		result := &leafResult{selector: current}
+		bySelector[key] = result
+		ordered = append(ordered, result)
+		byPackage[packageFor(current.Path)] = append(byPackage[packageFor(current.Path)], current)
+	}
+
+	packages := make([]string, 0, len(byPackage))
+	for pkg := range byPackage {
+		packages = append(packages, pkg)
+	}
+	sort.Strings(packages)
+	for _, pkg := range packages {
+		runPackage(repo, pkg, byPackage[pkg], bySelector, verbose)
+	}
+
+	results := make([]leafResult, 0, len(ordered))
+	for _, result := range ordered {
+		results = append(results, *result)
+	}
+	return results
+}
+
+func runPackage(repo, pkg string, selectors []selector, bySelector map[string]*leafResult, verbose bool) {
+	leaves := make([]string, 0, len(selectors))
+	for _, current := range selectors {
+		leaves = append(leaves, regexp.QuoteMeta(current.Leaf))
+	}
+	pattern := "^(?:" + strings.Join(leaves, "|") + ")$"
+
+	args := []string{"test", "-json", "-count=1", "-run", pattern, pkg}
+	cmd := exec.Command("go", args...)
+	cmd.Dir = repo
+	cmd.Env = append(os.Environ(), "GOPROXY=off", "GOTOOLCHAIN=local", "GOWORK=off")
+
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		markPackageError(selectors, bySelector, fmt.Sprintf("failed to start go test: %v", err))
+		return
+	}
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		markPackageError(selectors, bySelector, fmt.Sprintf("failed to start go test: %v", err))
+		return
+	}
+
+	var packageOutput strings.Builder
+	statuses := map[string]string{}
+	elapsed := map[string]float64{}
+	outputs := map[string]*strings.Builder{}
+	failedTests := map[string]bool{}
+
+	scanner := bufio.NewScanner(stdout)
+	scanner.Buffer(make([]byte, 0, 64*1024), 16*1024*1024)
+	for scanner.Scan() {
+		line := scanner.Bytes()
+		if verbose {
+			fmt.Fprintln(os.Stderr, string(line))
+		}
+		var event testEvent
+		if err := json.Unmarshal(line, &event); err != nil {
+			packageOutput.Write(line)
+			packageOutput.WriteByte('\n')
+			continue
+		}
+		if event.Test == "" {
+			if event.Action == "output" || event.Action == "build-output" {
+				packageOutput.WriteString(event.Output)
+			}
+			continue
+		}
+		top := topLevelTest(event.Test)
+		if _, ok := leafForPath(selectors, top); !ok {
+			continue
+		}
+		if outputs[event.Test] == nil {
+			outputs[event.Test] = &strings.Builder{}
+		}
+		switch event.Action {
+		case "output":
+			outputs[event.Test].WriteString(event.Output)
+		case "fail":
+			failedTests[top] = true
+		case "pass":
+			if !failedTests[top] {
+				statuses[top] = "pass"
+				elapsed[top] = event.Elapsed
+			}
+		case "skip":
+			if !failedTests[top] {
+				statuses[top] = "skip"
+				elapsed[top] = event.Elapsed
+			}
+		}
+	}
+	waitErr := cmd.Wait()
+
+	for _, current := range selectors {
+		result := bySelector[current.String()]
+		if failedTests[current.Leaf] {
+			result.status = "fail"
+			result.elapsed = elapsed[current.Leaf]
+			var parts []string
+			for name, buffer := range outputs {
+				if topLevelTest(name) == current.Leaf {
+					parts = append(parts, buffer.String())
+				}
+			}
+			result.output.WriteString(strings.Join(parts, ""))
+			if result.output.Len() == 0 {
+				result.output.WriteString(packageOutput.String())
+			}
+			continue
+		}
+		if status, ok := statuses[current.Leaf]; ok {
+			result.status = status
+			result.elapsed = elapsed[current.Leaf]
+			continue
+		}
+		// No per-test event: the package did not build or the selector was not
+		// collected. Surface it as an error, never as a silent pass.
+		result.status = "notrun"
+		detail := strings.TrimSpace(packageOutput.String())
+		if detail == "" {
+			detail = strings.TrimSpace(stderr.String())
+		}
+		if detail == "" && waitErr != nil {
+			detail = waitErr.Error()
+		}
+		if detail == "" {
+			detail = fmt.Sprintf("go test did not report a result for %s", current.Leaf)
+		}
+		result.output.WriteString(detail)
+	}
+}
+
+func leafForPath(selectors []selector, leaf string) (selector, bool) {
+	for _, current := range selectors {
+		if current.Leaf == leaf {
+			return current, true
+		}
+	}
+	return selector{}, false
+}
+
+func topLevelTest(name string) string {
+	if index := strings.Index(name, "/"); index >= 0 {
+		return name[:index]
+	}
+	return name
+}
+
+func markPackageError(selectors []selector, bySelector map[string]*leafResult, message string) {
+	for _, current := range selectors {
+		result := bySelector[current.String()]
+		result.status = "notrun"
+		result.output.WriteString(message)
+	}
+}
+
+// failureType distinguishes completed test failures from Go runtime failures.
+// Runtime diagnostics begin at column zero; assertion messages are indented.
+func failureType(output string) string {
+	for _, line := range strings.Split(output, "\n") {
+		if strings.HasPrefix(line, "panic: test timed out after ") {
+			return "Timeout"
+		}
+		if strings.HasPrefix(line, "panic:") || strings.HasPrefix(line, "fatal error:") ||
+			regexp.MustCompile(`^SIG[A-Z0-9]+:`).MatchString(line) {
+			return "Process Crash"
+		}
+	}
+	return ""
+}
+
+func writeReport(path string, results []leafResult) error {
+	timestamp := time.Now().UTC().Format(time.RFC3339)
+	suite := junitTestsuite{Timestamp: timestamp, Name: "f2p+p2p"}
+	totalTime := 0.0
+
+	for _, result := range results {
+		testCase := junitTestcase{
+			Classname: result.selector.Path,
+			Name:      result.selector.Leaf,
+			Time:      fmt.Sprintf("%.3f", result.elapsed),
+		}
+		totalTime += result.elapsed
+		switch result.status {
+		case "pass":
+		case "skip":
+			suite.Skipped++
+			testCase.Skipped = &junitSkipped{Message: "skipped"}
+		case "fail":
+			failure := &junitFailure{
+				Type:    "AssertionFailure",
+				Message: fmt.Sprintf("%s failed", result.selector.Leaf),
+				Body:    result.output.String(),
+			}
+			if kind := failureType(result.output.String()); kind != "" {
+				suite.Errors++
+				failure.Type = kind
+				testCase.Error = failure
+			} else {
+				suite.Failures++
+				testCase.Failure = failure
+			}
+		default:
+			suite.Errors++
+			testCase.Error = &junitFailure{
+				Type:    failureType(result.output.String()),
+				Message: fmt.Sprintf("%s was not executed", result.selector.Leaf),
+				Body:    result.output.String(),
+			}
+		}
+		suite.Cases = append(suite.Cases, testCase)
+	}
+	suite.Tests = len(suite.Cases)
+	suite.Time = fmt.Sprintf("%.3f", totalTime)
+
+	report := junitTestsuites{
+		Tests:    suite.Tests,
+		Failures: suite.Failures,
+		Errors:   suite.Errors,
+		Skipped:  suite.Skipped,
+		Time:     suite.Time,
+		Suites:   []junitTestsuite{suite},
+	}
+
+	if dir := filepath.Dir(path); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			return err
+		}
+	}
+	file, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	if _, err := io.WriteString(file, xml.Header); err != nil {
+		return err
+	}
+	encoder := xml.NewEncoder(file)
+	encoder.Indent("", "  ")
+	if err := encoder.Encode(report); err != nil {
+		return err
+	}
+	return encoder.Flush()
+}
diff --git a/ingest/tests/f2p_junit/run_f2p.sh b/ingest/tests/f2p_junit/run_f2p.sh
new file mode 100755
index 00000000..b4d48d04
--- /dev/null
+++ b/ingest/tests/f2p_junit/run_f2p.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Build and run the aggregate P2P+F2P JUnit runner with every build artifact
+# placed in an exec-capable directory.
+#
+# The replay sandbox mounts TMPDIR (and therefore go's default GOTMPDIR) with
+# noexec, so `go run`/`go test` cannot execute the binaries they link there.
+# The plan declares require_exec, so the pipeline provides VERIFIER_EXEC_DIR:
+# the compiled runner and every `go test` binary are placed below it (TMPDIR is
+# only a fallback for local runs). GOTOOLCHAIN=local and GOPROXY=off keep the
+# run fully offline, and the caller's working directory is preserved so
+# relative {config} and {report} paths keep their caller-relative meaning.
+#
+# Selection is read from the pipeline-materialized {config}: the exact `p2p`
+# and `f2p` selector arrays. No test-file globs, package-wide patterns or
+# original inventory are used as the scoring selection set.
+set -euo pipefail
+
+script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+repo_root="$(cd -- "${script_dir}/../../.." && pwd)"
+
+base_dir="${VERIFIER_EXEC_DIR:-${TMPDIR:-/tmp}}"
+exec_dir="${base_dir}/f2p-junit"
+mkdir -p "$exec_dir"
+export GOTMPDIR="${exec_dir}/go-build-tmp"
+mkdir -p "$GOTMPDIR"
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export GOWORK=off
+echo "run_f2p.sh: building P2P+F2P runner into ${exec_dir}" >&2
+
+runner_bin="${exec_dir}/f2p_junit"
+go -C "$repo_root" build -o "$runner_bin" ./ingest/tests/f2p_junit
+exec "$runner_bin" --repo "$repo_root" "$@"
diff --git a/ingest/tests/f2p_meta_view/analysis.go b/ingest/tests/f2p_meta_view/analysis.go
new file mode 100644
index 00000000..fac4a0ed
--- /dev/null
+++ b/ingest/tests/f2p_meta_view/analysis.go
@@ -0,0 +1,729 @@
+// Package f2p_meta_view holds the F2P contract checks for the decoded
+// transaction-metadata consolidation.
+//
+// The frozen requirements for this task are structural: the scattered
+// per-generation conditionals around decoded transaction metadata must be
+// replaced by one internal view whose per-generation handling owns changes,
+// operation changes, events and fee-refund inputs, while the observable
+// results pinned by the P2P nodes stay identical. Because the observable
+// results must NOT change, the acceptance surface of the consolidation itself
+// is the structure of the production sources: which declarations still
+// dispatch per generation, which ones re-derive layout from the raw version
+// field, and which shared declaration owns the dispatch.
+//
+// Every check in this package parses the repository's production Go sources
+// (no compilation, no behavior execution) and pins one concrete structural
+// property. Each check fails on the un-consolidated baseline and passes on an
+// implementation that actually routes every decoded-metadata consumer through
+// one view.
+package f2p_meta_view
+
+import (
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// Production packages that participate in the decoded-metadata contract.
+const (
+	pkgXDR        = "xdr"
+	pkgIngest     = "ingest"
+	pkgTokenXfer  = "processors/token_transfer"
+	rawMetaSuffix = "UnsafeMeta"
+)
+
+// siteID identifies one function or method declaration.
+type siteID struct {
+	Pkg  string
+	Recv string
+	Name string
+}
+
+func (s siteID) String() string {
+	if s.Recv == "" {
+		return fmt.Sprintf("%s.%s", s.Pkg, s.Name)
+	}
+	return fmt.Sprintf("%s.%s.%s", s.Pkg, s.Recv, s.Name)
+}
+
+// decl is one parsed production function/method declaration.
+type decl struct {
+	id                    siteID
+	file                  string
+	line                  int
+	body                  *ast.BlockStmt
+	callees               []string
+	generationTables      [][]int
+	metaUnionArmAccess    bool
+	rawMetaVersionRead    bool
+	rawViewInput          bool
+	rawEventOutput        bool
+	decodedMetaInput      bool
+	unsupportedErrLiteral bool
+}
+
+func (d *decl) hasGenerationTable() bool { return len(d.generationTables) > 0 }
+
+// program is the parsed production-source index.
+type program struct {
+	decls     []*decl
+	byID      map[siteID]*decl
+	byName    map[string][]*decl
+	imports   map[string][]string
+	parseErrs []string
+}
+
+var productionDirs = []struct {
+	pkg string
+	rel string
+}{
+	{pkgXDR, "xdr"},
+	{pkgIngest, "ingest"},
+	{pkgTokenXfer, filepath.Join("processors", "token_transfer")},
+}
+
+// decodedConsumers are the exported entry points that the task consolidates.
+var decodedConsumers = []siteID{
+	{pkgIngest, "LedgerTransaction", "GetChanges"},
+	{pkgIngest, "LedgerTransaction", "GetOperationChanges"},
+	{pkgIngest, "LedgerTransaction", "GetTransactionEvents"},
+	{pkgIngest, "LedgerTransaction", "SorobanResourceFeeRefund"},
+	{pkgXDR, "TransactionMeta", "GetContractEventsForOperation"},
+	{pkgXDR, "TransactionMeta", "GetDiagnosticEvents"},
+	{pkgXDR, "TransactionMeta", "GetTransactionEvents"},
+}
+
+// tokenTransferConsumers are the downstream event consumers that must stop
+// re-deriving metadata layout from the raw version field.
+var tokenTransferConsumers = []siteID{
+	{pkgTokenXfer, "EventsProcessor", "parseEvent"},
+	{pkgTokenXfer, "EventsProcessor", "EventsFromTransaction"},
+	{pkgTokenXfer, "EventsProcessor", "generateFeeEvents"},
+}
+
+// repoRoot locates the repository that contains the sources under analysis.
+// The tests run with the package directory as working directory, so the module
+// root is found by walking up to go.mod; F2P_REPO_ROOT overrides that for
+// scratch calibration runs.
+func repoRoot(t *testing.T) string {
+	t.Helper()
+	if override := os.Getenv("F2P_REPO_ROOT"); override != "" {
+		return override
+	}
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("cannot determine working directory: %v", err)
+	}
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatalf("cannot locate repository root (no go.mod above %s)", dir)
+		}
+		dir = parent
+	}
+}
+
+// loadProgram parses every hand-written production source file of the three
+// relevant packages. Directories are scanned non-recursively on purpose:
+// unrelated sub-packages (load test helpers, runners, ...) are not part of the
+// decoded metadata contract, and generated XDR codec files are excluded
+// because their union-arm switches are frozen generator output, not generation
+// dispatch for decoded metadata.
+func loadProgram(t *testing.T) *program {
+	t.Helper()
+	root := repoRoot(t)
+	p := &program{byID: map[siteID]*decl{}, byName: map[string][]*decl{}, imports: map[string][]string{}}
+	fset := token.NewFileSet()
+	for _, dir := range productionDirs {
+		entries, err := os.ReadDir(filepath.Join(root, dir.rel))
+		if err != nil {
+			t.Fatalf("cannot read production directory %s: %v", dir.rel, err)
+		}
+		for _, entry := range entries {
+			name := entry.Name()
+			if entry.IsDir() || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") || strings.HasSuffix(name, "_generated.go") {
+				continue
+			}
+			full := filepath.Join(root, dir.rel, name)
+			file, err := parser.ParseFile(fset, full, nil, 0)
+			if err != nil {
+				p.parseErrs = append(p.parseErrs, fmt.Sprintf("%s: %v", full, err))
+				continue
+			}
+			rel, err := filepath.Rel(root, full)
+			if err != nil {
+				rel = full
+			}
+			for _, spec := range file.Imports {
+				path, err := strconv.Unquote(spec.Path.Value)
+				if err == nil {
+					p.imports[rel] = append(p.imports[rel], path)
+				}
+			}
+			collectDecls(p, dir.pkg, rel, fset, file)
+		}
+	}
+	if len(p.parseErrs) > 0 {
+		t.Fatalf("production sources must stay parseable: %v", p.parseErrs)
+	}
+	return p
+}
+
+func collectDecls(p *program, pkg, file string, fset *token.FileSet, af *ast.File) {
+	for _, node := range af.Decls {
+		fd, ok := node.(*ast.FuncDecl)
+		if !ok || fd.Body == nil {
+			continue
+		}
+		d := &decl{
+			id:   siteID{Pkg: pkg, Recv: receiverName(fd), Name: fd.Name.Name},
+			file: file,
+			line: fset.Position(fd.Pos()).Line,
+			body: fd.Body,
+		}
+		d.decodedMetaInput = receiverName(fd) == "TransactionMeta"
+		if fd.Type.Params != nil {
+			for _, field := range fd.Type.Params.List {
+				if exprText(field.Type) == "TransactionMeta" || strings.HasSuffix(exprText(field.Type), ".TransactionMeta") {
+					d.decodedMetaInput = true
+				}
+				if strings.HasSuffix(exprText(field.Type), ".TransactionMetaView") || exprText(field.Type) == "TransactionMetaView" {
+					d.rawViewInput = true
+				}
+			}
+		}
+		if fd.Type.Results != nil {
+			for _, field := range fd.Type.Results.List {
+				if exprText(field.Type) == "TxEvents" {
+					d.rawEventOutput = true
+				}
+			}
+		}
+		callees := map[string]bool{}
+		ast.Inspect(fd.Body, func(n ast.Node) bool {
+			switch x := n.(type) {
+			case *ast.SwitchStmt:
+				if values, ok := generationTable(x); ok {
+					d.generationTables = append(d.generationTables, values)
+				}
+			case *ast.CallExpr:
+				switch fun := x.Fun.(type) {
+				case *ast.SelectorExpr:
+					callees[fun.Sel.Name] = true
+					if isMetaExpression(fun.X) && isUnionArmAccessor(fun.Sel.Name) {
+						d.metaUnionArmAccess = true
+					}
+				case *ast.Ident:
+					callees[fun.Name] = true
+				}
+			case *ast.SelectorExpr:
+				text := exprText(x)
+				if strings.HasSuffix(text, "."+rawMetaSuffix+".V") {
+					d.rawMetaVersionRead = true
+				}
+				if isMetaExpression(x.X) && isUnionArmField(x.Sel.Name) {
+					d.metaUnionArmAccess = true
+				}
+			case *ast.BasicLit:
+				if x.Kind == token.STRING && strings.Contains(x.Value, "unsupported TransactionMeta version") {
+					d.unsupportedErrLiteral = true
+				}
+			}
+			return true
+		})
+		d.generationTables = append(d.generationTables, generationGuardTables(fd)...)
+		for name := range callees {
+			d.callees = append(d.callees, name)
+		}
+		sort.Strings(d.callees)
+		p.decls = append(p.decls, d)
+		if _, ok := p.byID[d.id]; !ok {
+			p.byID[d.id] = d
+		}
+		p.byName[d.id.Name] = append(p.byName[d.id.Name], d)
+	}
+}
+
+// generationTable reports whether a switch statement is a per-generation
+// dispatch table: at least two non-default arms whose literal case values all
+// fall in the decoded-metadata generation range and that name at least two
+// distinct supported generations. Data-carrying per-generation handling looks
+// exactly like this; unrelated enum switches (strings, generated enums, single
+// guarded arms) do not.
+func generationTable(sw *ast.SwitchStmt) ([]int, bool) {
+	if sw == nil || sw.Body == nil {
+		return nil, false
+	}
+	var values []int
+	arms := 0
+	for _, stmt := range sw.Body.List {
+		clause, ok := stmt.(*ast.CaseClause)
+		if !ok || len(clause.List) == 0 {
+			continue
+		}
+		arms++
+		for _, expression := range clause.List {
+			lit, ok := expression.(*ast.BasicLit)
+			if !ok || lit.Kind != token.INT {
+				return nil, false
+			}
+			value, err := strconv.Atoi(lit.Value)
+			if err != nil || value < 0 || value > 4 {
+				return nil, false
+			}
+			values = append(values, value)
+		}
+	}
+	if arms < 2 {
+		return nil, false
+	}
+	distinct := map[int]bool{}
+	for _, value := range values {
+		if value >= 1 && value <= 4 {
+			distinct[value] = true
+		}
+	}
+	if len(distinct) < 2 {
+		return nil, false
+	}
+	return values, true
+}
+
+func isMetaExpression(e ast.Expr) bool {
+	return strings.HasSuffix(exprText(e), rawMetaSuffix)
+}
+
+func isUnionArmAccessor(name string) bool {
+	switch name {
+	case "MustV1", "MustV2", "MustV3", "MustV4", "GetV1", "GetV2", "GetV3", "GetV4":
+		return true
+	}
+	return false
+}
+
+func isUnionArmField(name string) bool {
+	return name == "V1" || name == "V2" || name == "V3" || name == "V4"
+}
+
+func exprText(e ast.Expr) string {
+	switch t := e.(type) {
+	case nil:
+		return ""
+	case *ast.Ident:
+		return t.Name
+	case *ast.SelectorExpr:
+		return exprText(t.X) + "." + t.Sel.Name
+	case *ast.CallExpr:
+		return exprText(t.Fun)
+	case *ast.StarExpr:
+		return exprText(t.X)
+	case *ast.ParenExpr:
+		return exprText(t.X)
+	case *ast.IndexExpr:
+		return exprText(t.X)
+	}
+	return ""
+}
+
+func receiverName(fd *ast.FuncDecl) string {
+	if fd.Recv == nil || len(fd.Recv.List) == 0 {
+		return ""
+	}
+	return baseTypeName(fd.Recv.List[0].Type)
+}
+
+func baseTypeName(e ast.Expr) string {
+	switch t := e.(type) {
+	case *ast.StarExpr:
+		return baseTypeName(t.X)
+	case *ast.Ident:
+		return t.Name
+	case *ast.IndexExpr:
+		return baseTypeName(t.X)
+	case *ast.IndexListExpr:
+		return baseTypeName(t.X)
+	}
+	return ""
+}
+
+// reachable returns every declaration reachable from start through calls,
+// resolving callee names across the three production packages and following
+// delegation chains (the requirements explicitly allow consolidation to be
+// reached through delegation rather than in one inlined function body).
+func (p *program) reachable(start *decl) map[*decl]bool {
+	seen := map[*decl]bool{}
+	var walk func(*decl, int)
+	walk = func(current *decl, depth int) {
+		if current == nil || seen[current] || depth > 8 {
+			return
+		}
+		seen[current] = true
+		for _, callee := range current.callees {
+			for _, target := range p.byName[callee] {
+				walk(target, depth+1)
+			}
+		}
+	}
+	walk(start, 0)
+	return seen
+}
+
+// reachableDispatchSites returns the identifiers of every per-generation
+// dispatch table reachable from start (including start itself).
+func (p *program) reachableDispatchSites(start *decl) map[siteID]bool {
+	sites := map[siteID]bool{}
+	for d := range p.reachable(start) {
+		if d.hasGenerationTable() {
+			sites[d.id] = true
+		}
+	}
+	return sites
+}
+
+// consumerOf returns the parsed declaration for id, or nil when the
+// production entry point is not declared. Reporting that absence is the
+// responsibility of the calling check, not of this analysis helper.
+func (p *program) consumerOf(id siteID) *decl {
+	return p.byID[id]
+}
+
+func sortedIDs(in map[siteID]bool) []string {
+	out := make([]string, 0, len(in))
+	for id := range in {
+		out = append(out, id.String())
+	}
+	sort.Strings(out)
+	return out
+}
+
+// dispatchReport captures the outcome of the shared-dispatch-site analysis:
+// the single per-generation dispatch declaration reached by every decoded
+// consumer, plus the concrete reasons when there is no such single site.
+type dispatchReport struct {
+	Site     siteID
+	Problems []string
+}
+
+// sharedDispatchSite analyses the decoded consumers and reports whether they
+// all reach exactly one per-generation dispatch declaration in the data layer.
+// It never asserts: the calling check owns the assertion and its message.
+func sharedDispatchSite(p *program) dispatchReport {
+	union := map[siteID]bool{}
+	perConsumer := map[string][]string{}
+	var problems []string
+	for _, id := range decodedConsumers {
+		d := p.byID[id]
+		if d == nil {
+			problems = append(problems, fmt.Sprintf("%s is not declared", id))
+			continue
+		}
+		sites := p.reachableDispatchSites(d)
+		for site := range sites {
+			union[site] = true
+		}
+		perConsumer[id.String()] = sortedIDs(sites)
+	}
+	if len(problems) > 0 {
+		return dispatchReport{Problems: problems}
+	}
+	if len(union) != 1 {
+		problems = append(problems, fmt.Sprintf("decoded-metadata consumers must share exactly one generation dispatch site, got %v; per consumer: %v", sortedIDs(union), perConsumer))
+		return dispatchReport{Problems: problems}
+	}
+	var site siteID
+	for candidate := range union {
+		site = candidate
+	}
+	if site.Pkg != pkgXDR {
+		problems = append(problems, fmt.Sprintf("the shared generation dispatch site must live in %s so both the metadata accessors and the transaction readers can reach it, got %s", pkgXDR, site))
+		return dispatchReport{Site: site, Problems: problems}
+	}
+	for consumer, sites := range perConsumer {
+		if len(sites) != 1 || sites[0] != site.String() {
+			problems = append(problems, fmt.Sprintf("consumer %s must delegate to the shared site %s, got %v", consumer, site, sites))
+		}
+	}
+	return dispatchReport{Site: site, Problems: problems}
+}
+
+// providersReaching returns the declarations whose call result carries the
+// consolidated view: the view dispatch site itself and every declaration that
+// reaches it by delegation.
+func providersReaching(p *program, site siteID) map[*decl]bool {
+	providers := map[*decl]bool{}
+	for _, candidate := range p.decls {
+		if candidate.id == site {
+			providers[candidate] = true
+			continue
+		}
+		for reachable := range p.reachable(candidate) {
+			if reachable.id == site {
+				providers[candidate] = true
+				break
+			}
+		}
+	}
+	return providers
+}
+
+// viewValueNames returns the local variable names assigned from a call whose
+// callee produces the consolidated view.
+func viewValueNames(p *program, d *decl, providers map[*decl]bool) map[string]bool {
+	names := map[string]bool{}
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		assign, ok := n.(*ast.AssignStmt)
+		if !ok || assign.Tok.String() != ":=" {
+			return true
+		}
+		for i, rhs := range assign.Rhs {
+			call, ok := rhs.(*ast.CallExpr)
+			if !ok || i >= len(assign.Lhs) {
+				continue
+			}
+			if isViewProducingCall(p, call, providers) {
+				if ident, ok := assign.Lhs[i].(*ast.Ident); ok {
+					names[ident.Name] = true
+				}
+			}
+		}
+		return true
+	})
+	return names
+}
+
+// generationOnlyMethods report the generation itself; they are not evidence
+// that the view owns the changes/events/refund data.
+var generationOnlyMethods = map[string]bool{
+	"Generation": true,
+	"Version":    true,
+	"Supported":  true,
+}
+
+// usesViewValue reports whether a value produced by the consolidated view is
+// consumed as data: a non-generation method is called on it (directly or
+// chained), or it is handed to another call (including the append that
+// assembles the result).
+func usesViewValue(p *program, d *decl, viewValues map[string]bool, providers map[*decl]bool) bool {
+	found := false
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		call, ok := n.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		if selector, ok := call.Fun.(*ast.SelectorExpr); ok && !generationOnlyMethods[selector.Sel.Name] {
+			switch receiver := selector.X.(type) {
+			case *ast.Ident:
+				if viewValues[receiver.Name] {
+					found = true
+				}
+			case *ast.CallExpr:
+				// Chained read such as meta.Generation().Events(...) where the
+				// inner call is the consolidated view.
+				if isViewProducingCall(p, receiver, providers) {
+					found = true
+				}
+			}
+		}
+		for _, arg := range call.Args {
+			if ident, ok := arg.(*ast.Ident); ok && viewValues[ident.Name] {
+				found = true
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// isViewProducingCall reports whether the callee of call returns the
+// consolidated view. Delegation is resolved by name across the production
+// packages; chained reads (view().Data()) are handled by the caller.
+func isViewProducingCall(p *program, call *ast.CallExpr, providers map[*decl]bool) bool {
+	if p == nil {
+		return false
+	}
+	switch fun := call.Fun.(type) {
+	case *ast.SelectorExpr:
+		for _, target := range p.byName[fun.Sel.Name] {
+			if providers[target] {
+				return true
+			}
+		}
+	case *ast.Ident:
+		for _, target := range p.byName[fun.Name] {
+			if providers[target] {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func sortedInts(in map[int]bool) []int {
+	out := make([]int, 0, len(in))
+	for value := range in {
+		out = append(out, value)
+	}
+	sort.Ints(out)
+	return out
+}
+
+func sortedStrings(in map[string]bool) []string {
+	out := make([]string, 0, len(in))
+	for value := range in {
+		out = append(out, value)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// generationGuardTables recognizes metadata generation dispatch independently
+// of switch syntax. Comparisons are grouped by their actual discriminator;
+// unrelated numeric guards (operation index, ledger version, etc.) do not
+// contribute coverage. Sequential early-return guards and else-if chains are
+// both valid single-owner dispatch.
+func generationGuardTables(fd *ast.FuncDecl) [][]int {
+	metaNames := map[string]bool{}
+	rawNames := map[string]bool{}
+	seed := func(fields *ast.FieldList) {
+		if fields == nil {
+			return
+		}
+		for _, field := range fields.List {
+			typ := field.Type
+			if star, ok := typ.(*ast.StarExpr); ok {
+				typ = star.X
+			}
+			if exprText(typ) == "TransactionMetaView" || strings.HasSuffix(exprText(typ), ".TransactionMetaView") {
+				for _, name := range field.Names {
+					rawNames[name.Name] = true
+				}
+			}
+			if exprText(typ) == "TransactionMeta" || strings.HasSuffix(exprText(typ), ".TransactionMeta") {
+				for _, name := range field.Names {
+					metaNames[name.Name] = true
+				}
+			}
+		}
+	}
+	seed(fd.Recv)
+	seed(fd.Type.Params)
+	aliases := map[string]string{}
+	var discriminator func(ast.Expr) string
+	discriminator = func(e ast.Expr) string {
+		switch x := e.(type) {
+		case *ast.ParenExpr:
+			return discriminator(x.X)
+		case *ast.Ident:
+			return aliases[x.Name]
+		case *ast.CallExpr:
+			if sel, ok := x.Fun.(*ast.SelectorExpr); ok && sel.Sel.Name == "V" && rawNames[exprText(sel.X)] {
+				return exprText(sel)
+			}
+		case *ast.SelectorExpr:
+			if x.Sel.Name == "V" && (metaNames[exprText(x.X)] || isMetaExpression(x.X)) {
+				return exprText(x)
+			}
+		}
+		return ""
+	}
+	// Resolve local copies of metadata and of its version to a fixed point.
+	for changed := true; changed; {
+		changed = false
+		bind := func(name string, rhs ast.Expr) {
+			if name == "_" {
+				return
+			}
+			if (metaNames[exprText(rhs)] || isMetaExpression(rhs)) && !metaNames[name] {
+				metaNames[name] = true
+				changed = true
+			}
+			if key := discriminator(rhs); key != "" && aliases[name] == "" {
+				aliases[name] = key
+				changed = true
+			}
+		}
+		ast.Inspect(fd.Body, func(n ast.Node) bool {
+			switch x := n.(type) {
+			case *ast.AssignStmt:
+				for i, rhs := range x.Rhs {
+					if i < len(x.Lhs) {
+						if name, ok := x.Lhs[i].(*ast.Ident); ok {
+							bind(name.Name, rhs)
+						}
+					}
+				}
+			case *ast.ValueSpec:
+				for i, rhs := range x.Values {
+					if i < len(x.Names) {
+						bind(x.Names[i].Name, rhs)
+					}
+				}
+			}
+			return true
+		})
+	}
+	groups := map[string]map[int]bool{}
+	var collect func(ast.Expr)
+	collect = func(e ast.Expr) {
+		if paren, ok := e.(*ast.ParenExpr); ok {
+			collect(paren.X)
+			return
+		}
+		binary, ok := e.(*ast.BinaryExpr)
+		if !ok {
+			return
+		}
+		if binary.Op == token.LOR || binary.Op == token.LAND {
+			collect(binary.X)
+			collect(binary.Y)
+			return
+		}
+		if binary.Op != token.EQL && binary.Op != token.NEQ {
+			return
+		}
+		for _, pair := range [][2]ast.Expr{{binary.X, binary.Y}, {binary.Y, binary.X}} {
+			key := discriminator(pair[0])
+			lit, ok := pair[1].(*ast.BasicLit)
+			if key == "" || !ok || lit.Kind != token.INT {
+				continue
+			}
+			value, err := strconv.Atoi(lit.Value)
+			if err != nil || value < 0 || value > 4 {
+				continue
+			}
+			if groups[key] == nil {
+				groups[key] = map[int]bool{}
+			}
+			groups[key][value] = true
+		}
+	}
+	ast.Inspect(fd.Body, func(n ast.Node) bool {
+		if branch, ok := n.(*ast.IfStmt); ok {
+			collect(branch.Cond)
+		}
+		return true
+	})
+	var tables [][]int
+	for _, values := range groups {
+		supported := 0
+		for v := range values {
+			if v >= 1 {
+				supported++
+			}
+		}
+		if supported >= 2 {
+			tables = append(tables, sortedInts(values))
+		}
+	}
+	return tables
+}
