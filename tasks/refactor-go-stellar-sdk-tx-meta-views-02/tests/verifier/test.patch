index 00000000..135a1c18
--- /dev/null
+++ b/processors/token_transfer/unified_events_p2p_test.go
@@ -0,0 +1,152 @@
+package token_transfer
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/stellar/go-stellar-sdk/ingest"
+	"github.com/stellar/go-stellar-sdk/xdr"
+)
+
+// Supplemental P2P regression coverage for the token-transfer unified-events
+// option. With the option enabled generation-4 metadata must remain the only
+// accepted generation, every other generation must still fail with an error,
+// and the default (non-unified) processor must keep treating generation-3 and
+// generation-4 metadata as before.
+
+const p2pUnifiedNetworkPassphrase = "p2p unified events network passphrase"
+
+var p2pUnifiedSourceAccount = xdr.MustMuxedAddress("GBF3XFXGBGNQDN3HOSZ7NVRF6TJ2JOD5U6ELIWJOOEI6T5WKMQT2YSXQ")
+
+func p2pUnifiedFeeEvent(amount int64) xdr.TransactionEvent {
+	contractId, err := xdr.MustNewNativeAsset().ContractID(p2pUnifiedNetworkPassphrase)
+	if err != nil {
+		panic(err)
+	}
+	contractHash := xdr.ContractId(contractId)
+	fn := xdr.ScSymbol(FeeEvent)
+	address := xdr.ScAddress{
+		Type:      xdr.ScAddressTypeScAddressTypeAccount,
+		AccountId: xdr.MustAddressPtr(p2pUnifiedSourceAccount.Address()),
+	}
+	return xdr.TransactionEvent{
+		Stage: xdr.TransactionEventStageTransactionEventStageBeforeAllTxs,
+		Event: xdr.ContractEvent{
+			Type:       xdr.ContractEventTypeContract,
+			ContractId: &contractHash,
+			Body: xdr.ContractEventBody{
+				V: 0,
+				V0: &xdr.ContractEventV0{
+					Topics: []xdr.ScVal{
+						{Type: xdr.ScValTypeScvSymbol, Sym: &fn},
+						{Type: xdr.ScValTypeScvAddress, Address: &address},
+					},
+					Data: xdr.ScVal{
+						Type: xdr.ScValTypeScvI128,
+						I128: &xdr.Int128Parts{Lo: xdr.Uint64(amount), Hi: 0},
+					},
+				},
+			},
+		},
+	}
+}
+
+func p2pUnifiedTx(meta xdr.TransactionMeta) ingest.LedgerTransaction {
+	return ingest.LedgerTransaction{
+		Index: 1,
+		Envelope: xdr.TransactionEnvelope{
+			Type: xdr.EnvelopeTypeEnvelopeTypeTx,
+			V1: &xdr.TransactionV1Envelope{
+				Tx: xdr.Transaction{
+					SourceAccount: p2pUnifiedSourceAccount,
+				},
+			},
+		},
+		Result: xdr.TransactionResultPair{
+			Result: xdr.TransactionResult{
+				Result: xdr.TransactionResultResult{
+					Code:    xdr.TransactionResultCodeTxSuccess,
+					Results: &[]xdr.OperationResult{},
+				},
+			},
+		},
+		UnsafeMeta:    meta,
+		LedgerVersion: 23,
+		Ledger: xdr.LedgerCloseMeta{
+			V: 0,
+			V0: &xdr.LedgerCloseMetaV0{
+				LedgerHeader: xdr.LedgerHeaderHistoryEntry{
+					Header: xdr.LedgerHeader{
+						LedgerSeq: 7,
+						ScpValue:  xdr.StellarValue{CloseTime: 123456},
+					},
+				},
+			},
+		},
+		Hash: xdr.Hash{1, 2, 3},
+	}
+}
+
+func p2pUnifiedMeta(version int32) xdr.TransactionMeta {
+	meta := xdr.TransactionMeta{V: version}
+	switch version {
+	case 1:
+		meta.V1 = &xdr.TransactionMetaV1{}
+	case 2:
+		meta.V2 = &xdr.TransactionMetaV2{}
+	case 3:
+		meta.V3 = &xdr.TransactionMetaV3{}
+	case 4:
+		meta.V4 = &xdr.TransactionMetaV4{Operations: []xdr.OperationMetaV2{}}
+	}
+	return meta
+}
+
+func TestP2PUnifiedEventsStreamAcceptsOnlyGeneration4(t *testing.T) {
+	for name, processor := range map[string]*EventsProcessor{
+		"convenience-constructor": NewEventsProcessorForUnifiedEvents(p2pUnifiedNetworkPassphrase),
+		"direct-exported-option":  NewEventsProcessor(p2pUnifiedNetworkPassphrase, WithUnifiedEventsStreamEnabled()),
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Run("generation-4-is-accepted", func(t *testing.T) {
+				meta := p2pUnifiedMeta(4)
+				meta.V4.Events = []xdr.TransactionEvent{p2pUnifiedFeeEvent(100)}
+				tx := p2pUnifiedTx(meta)
+
+				events, err := processor.EventsFromTransaction(tx)
+				require.NoError(t, err)
+				require.Len(t, events.FeeEvents, 1)
+				require.NotNil(t, events.FeeEvents[0].GetFee())
+				assert.Equal(t, "100", events.FeeEvents[0].GetFee().Amount)
+				assert.Equal(t, p2pUnifiedSourceAccount.Address(), events.FeeEvents[0].GetFee().From)
+				assert.Empty(t, events.OperationEvents)
+			})
+
+			t.Run("other-generations-fail-with-an-error", func(t *testing.T) {
+				for _, version := range []int32{0, 1, 2, 3, 5} {
+					tx := p2pUnifiedTx(p2pUnifiedMeta(version))
+					_, err := processor.EventsFromTransaction(tx)
+					require.Errorf(t, err, "generation %d metadata must be rejected when reading from unified events", version)
+				}
+			})
+		})
+	}
+}
+
+func TestP2PUnifiedEventsOptionDefaultsToLegacyInterpretation(t *testing.T) {
+	processor := NewEventsProcessor(p2pUnifiedNetworkPassphrase)
+
+	t.Run("generation-3-metadata-is-accepted", func(t *testing.T) {
+		tx := p2pUnifiedTx(p2pUnifiedMeta(3))
+		_, err := processor.EventsFromTransaction(tx)
+		require.NoError(t, err)
+	})
+
+	t.Run("generation-4-metadata-is-accepted", func(t *testing.T) {
+		tx := p2pUnifiedTx(p2pUnifiedMeta(4))
+		_, err := processor.EventsFromTransaction(tx)
+		require.NoError(t, err)
+	})
+}
