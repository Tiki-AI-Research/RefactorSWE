+func TestP2PGetChangesLegacyInternalErrorShape(t *testing.T) {
+	for name, meta := range p2pChangesMeta() {
+		t.Run(name, func(t *testing.T) {
+			tx := &LedgerTransaction{UnsafeMeta: meta, LedgerVersion: 12}
+			tx.Result.Result.Result.Code = xdr.TransactionResultCodeTxInternalError
+
+			changes, err := tx.GetChanges()
+			require.NoError(t, err)
+			require.Len(t, changes, 1)
+			assert.Equal(t, xdr.Int64(100), changes[0].Pre.Data.MustAccount().Balance)
+			assert.Equal(t, LedgerEntryChangeReasonTransaction, changes[0].Reason)
+
+			operationChanges, err := tx.GetOperationChanges(0)
+			require.NoError(t, err)
+			assert.NotNil(t, operationChanges)
+			assert.Len(t, operationChanges, 0)
+
+			tx.LedgerVersion = 13
+			changes, err = tx.GetChanges()
+			require.NoError(t, err)
+			if name == "v1" {
+				require.Len(t, changes, 3)
+				assert.Equal(t, []xdr.Int64{100, 200, 300}, p2pPreBalances(changes))
+			} else {
+				require.Len(t, changes, 4)
+				assert.Equal(t, []xdr.Int64{100, 200, 300, 400}, p2pPreBalances(changes))
+			}
+
+			operationChanges, err = tx.GetOperationChanges(1)
+			require.NoError(t, err)
+			require.Len(t, operationChanges, 1)
+			assert.Equal(t, xdr.Int64(300), operationChanges[0].Pre.Data.MustAccount().Balance)
+		})
+	}
+}
