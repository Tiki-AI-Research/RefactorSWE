--- /dev/null
+++ b/xdr/transaction_meta_layout.go
@@ -0,0 +1,276 @@
+package xdr
+
+import (
+	"fmt"
+)
+
+// TransactionMetaLayout provides a read-only consolidated view over decoded
+// TransactionMeta for supported generations (1, 2, 3, 4).
+// It encapsulates the differences in leading/trailing changes, operation changes,
+// events, and fee-refund trailing change sources.
+type TransactionMetaLayout interface {
+	// Generation returns the underlying metadata generation (1, 2, 3, or 4).
+	Generation() int32
+
+	// LeadingTxChanges returns transaction-level changes that occur before operations.
+	// For V1 this is TxChanges; for V2-V4 this is TxChangesBefore.
+	LeadingTxChanges() LedgerEntryChanges
+
+	// TrailingTxChanges returns transaction-level changes that occur after operations,
+	// and whether trailing transaction changes exist for this generation.
+	// For V1 this returns (nil, false); for V2-V4 this returns (TxChangesAfter, true).
+	TrailingTxChanges() (LedgerEntryChanges, bool)
+
+	// OperationsLen returns the number of recorded operations in metadata.
+	OperationsLen() int
+
+	// OperationChanges returns the LedgerEntryChanges for the given operation index.
+	// Note: index validity is the caller's responsibility or handled according to generation.
+	OperationChanges(opIndex uint32) LedgerEntryChanges
+
+	// ContractEventsForOperation returns contract events for the given operation index.
+	// For V1 and V2: returns (nil, nil).
+	// For V3: returns SorobanMeta.Events if SorobanMeta != nil, else nil.
+	// For V4: if Operations is empty, returns (nil, nil). Otherwise returns Operations[opIndex].Events.
+	// (Note: For V4 with non-empty Operations, opIndex out of bounds panics, matching baseline).
+	ContractEventsForOperation(opIndex uint32) ([]ContractEvent, error)
+
+	// DiagnosticEvents returns diagnostic events.
+	// For V1 and V2: returns (nil, nil).
+	// For V3: returns SorobanMeta.DiagnosticEvents if SorobanMeta != nil, else nil.
+	// For V4: returns DiagnosticEvents.
+	DiagnosticEvents() ([]DiagnosticEvent, error)
+
+	// TransactionEvents returns top-level transaction events.
+	// For V1, V2, V3: returns (nil, nil).
+	// For V4: returns Events.
+	TransactionEvents() ([]TransactionEvent, error)
+
+	// EventsForTransaction assembles transaction, operation and diagnostic events.
+	// Only V3 consults isSoroban; other generations do not inspect the envelope.
+	EventsForTransaction(isSoroban func() bool) ([]TransactionEvent, [][]ContractEvent, []DiagnosticEvent)
+
+	// FeeRefundTrailingChanges returns the trailing changes used for deriving
+	// Soroban resource fee refunds, along with a boolean indicating whether
+	// the generation provides a fee-refund trailing changes source (true for V3 and V4).
+	FeeRefundTrailingChanges() (LedgerEntryChanges, bool)
+}
+
+// NewLayout constructs a TransactionMetaLayout for the given TransactionMeta.
+// It returns an error with message "unsupported TransactionMeta version: %v" if the version is not supported.
+func (t TransactionMeta) NewLayout() (TransactionMetaLayout, error) {
+	switch t.V {
+	case 1:
+		return &metaLayoutV1{t: t}, nil
+	case 2:
+		return &metaLayoutV2{t: t}, nil
+	case 3:
+		return &metaLayoutV3{t: t}, nil
+	case 4:
+		return &metaLayoutV4{t: t}, nil
+	default:
+		return nil, fmt.Errorf("unsupported TransactionMeta version: %v", t.V)
+	}
+}
+
+type metaLayoutV1 struct {
+	t TransactionMeta
+}
+
+func (m *metaLayoutV1) Generation() int32 {
+	return 1
+}
+
+func (m *metaLayoutV1) LeadingTxChanges() LedgerEntryChanges {
+	return m.t.MustV1().TxChanges
+}
+
+func (m *metaLayoutV1) TrailingTxChanges() (LedgerEntryChanges, bool) {
+	return nil, false
+}
+
+func (m *metaLayoutV1) OperationsLen() int {
+	return len(m.t.MustV1().Operations)
+}
+
+func (m *metaLayoutV1) OperationChanges(opIndex uint32) LedgerEntryChanges {
+	return m.t.MustV1().Operations[opIndex].Changes
+}
+
+func (m *metaLayoutV1) ContractEventsForOperation(opIndex uint32) ([]ContractEvent, error) {
+	return nil, nil
+}
+
+func (m *metaLayoutV1) DiagnosticEvents() ([]DiagnosticEvent, error) {
+	return nil, nil
+}
+
+func (m *metaLayoutV1) TransactionEvents() ([]TransactionEvent, error) {
+	return nil, nil
+}
+
+func (m *metaLayoutV1) EventsForTransaction(isSoroban func() bool) ([]TransactionEvent, [][]ContractEvent, []DiagnosticEvent) {
+	return nil, nil, nil
+}
+
+func (m *metaLayoutV1) FeeRefundTrailingChanges() (LedgerEntryChanges, bool) {
+	return nil, false
+}
+
+type metaLayoutV2 struct {
+	t TransactionMeta
+}
+
+func (m *metaLayoutV2) Generation() int32 {
+	return 2
+}
+
+func (m *metaLayoutV2) LeadingTxChanges() LedgerEntryChanges {
+	return m.t.MustV2().TxChangesBefore
+}
+
+func (m *metaLayoutV2) TrailingTxChanges() (LedgerEntryChanges, bool) {
+	return m.t.MustV2().TxChangesAfter, true
+}
+
+func (m *metaLayoutV2) OperationsLen() int {
+	return len(m.t.MustV2().Operations)
+}
+
+func (m *metaLayoutV2) OperationChanges(opIndex uint32) LedgerEntryChanges {
+	return m.t.MustV2().Operations[opIndex].Changes
+}
+
+func (m *metaLayoutV2) ContractEventsForOperation(opIndex uint32) ([]ContractEvent, error) {
+	return nil, nil
+}
+
+func (m *metaLayoutV2) DiagnosticEvents() ([]DiagnosticEvent, error) {
+	return nil, nil
+}
+
+func (m *metaLayoutV2) TransactionEvents() ([]TransactionEvent, error) {
+	return nil, nil
+}
+
+func (m *metaLayoutV2) EventsForTransaction(isSoroban func() bool) ([]TransactionEvent, [][]ContractEvent, []DiagnosticEvent) {
+	return nil, nil, nil
+}
+
+func (m *metaLayoutV2) FeeRefundTrailingChanges() (LedgerEntryChanges, bool) {
+	return nil, false
+}
+
+type metaLayoutV3 struct {
+	t TransactionMeta
+}
+
+func (m *metaLayoutV3) Generation() int32 {
+	return 3
+}
+
+func (m *metaLayoutV3) LeadingTxChanges() LedgerEntryChanges {
+	return m.t.MustV3().TxChangesBefore
+}
+
+func (m *metaLayoutV3) TrailingTxChanges() (LedgerEntryChanges, bool) {
+	return m.t.MustV3().TxChangesAfter, true
+}
+
+func (m *metaLayoutV3) OperationsLen() int {
+	return len(m.t.MustV3().Operations)
+}
+
+func (m *metaLayoutV3) OperationChanges(opIndex uint32) LedgerEntryChanges {
+	return m.t.MustV3().Operations[opIndex].Changes
+}
+
+func (m *metaLayoutV3) ContractEventsForOperation(opIndex uint32) ([]ContractEvent, error) {
+	sorobanMeta := m.t.MustV3().SorobanMeta
+	if sorobanMeta == nil {
+		return nil, nil
+	}
+	return sorobanMeta.Events, nil
+}
+
+func (m *metaLayoutV3) DiagnosticEvents() ([]DiagnosticEvent, error) {
+	sorobanMeta := m.t.MustV3().SorobanMeta
+	if sorobanMeta == nil {
+		return nil, nil
+	}
+	return sorobanMeta.DiagnosticEvents, nil
+}
+
+func (m *metaLayoutV3) TransactionEvents() ([]TransactionEvent, error) {
+	return nil, nil
+}
+
+func (m *metaLayoutV3) EventsForTransaction(isSoroban func() bool) ([]TransactionEvent, [][]ContractEvent, []DiagnosticEvent) {
+	if !isSoroban() {
+		return nil, nil, nil
+	}
+	groups := make([][]ContractEvent, 1)
+	sorobanMeta := m.t.MustV3().SorobanMeta
+	if sorobanMeta == nil {
+		return nil, groups, nil
+	}
+	groups[0] = sorobanMeta.Events
+	return nil, groups, sorobanMeta.DiagnosticEvents
+}
+
+func (m *metaLayoutV3) FeeRefundTrailingChanges() (LedgerEntryChanges, bool) {
+	return m.t.MustV3().TxChangesAfter, true
+}
+
+type metaLayoutV4 struct {
+	t TransactionMeta
+}
+
+func (m *metaLayoutV4) Generation() int32 {
+	return 4
+}
+
+func (m *metaLayoutV4) LeadingTxChanges() LedgerEntryChanges {
+	return m.t.MustV4().TxChangesBefore
+}
+
+func (m *metaLayoutV4) TrailingTxChanges() (LedgerEntryChanges, bool) {
+	return m.t.MustV4().TxChangesAfter, true
+}
+
+func (m *metaLayoutV4) OperationsLen() int {
+	return len(m.t.MustV4().Operations)
+}
+
+func (m *metaLayoutV4) OperationChanges(opIndex uint32) LedgerEntryChanges {
+	return m.t.MustV4().Operations[opIndex].Changes
+}
+
+func (m *metaLayoutV4) ContractEventsForOperation(opIndex uint32) ([]ContractEvent, error) {
+	txMeta := m.t.MustV4()
+	if len(txMeta.Operations) == 0 {
+		return nil, nil
+	}
+	return txMeta.Operations[opIndex].Events, nil
+}
+
+func (m *metaLayoutV4) DiagnosticEvents() ([]DiagnosticEvent, error) {
+	return m.t.MustV4().DiagnosticEvents, nil
+}
+
+func (m *metaLayoutV4) TransactionEvents() ([]TransactionEvent, error) {
+	return m.t.MustV4().Events, nil
+}
+
+func (m *metaLayoutV4) EventsForTransaction(isSoroban func() bool) ([]TransactionEvent, [][]ContractEvent, []DiagnosticEvent) {
+	txMeta := m.t.MustV4()
+	groups := make([][]ContractEvent, len(txMeta.Operations))
+	for i, op := range txMeta.Operations {
