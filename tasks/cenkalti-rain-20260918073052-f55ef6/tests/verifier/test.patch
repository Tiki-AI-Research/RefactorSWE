+func (p *evaluatorSlowCloseStorageProvider) GetStorage(torrentID string) (storage.Storage, error) {
+	s, err := p.base.GetStorage(torrentID)
+	if err != nil {
+		return nil, err
+	}
+	return &evaluatorSlowCloseStorage{Storage: s, provider: p}, nil
