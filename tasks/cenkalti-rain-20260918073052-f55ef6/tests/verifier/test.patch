+func TestEvaluator_Session_SubphaseRemainingBudgetEnforced(t *testing.T) {
+	tmp := t.TempDir()
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.RPCEnabled = false
+	cfg.DHTEnabled = false
+
+	openEntered := make(chan struct{})
+	storageProv := &evaluatorSlowCloseStorageProvider{
+		base:         newFileStorageProvider(&cfg),
+		openEntered:  openEntered,
+		closeEntered: make(chan struct{}),
+	}
+	cfg.CustomStorage = storageProv
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	tor := addTestTorrent(t, s)
+	require.NoError(t, tor.Start())
+
+	select {
+	case <-openEntered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("storage did not enter Open")
+	}
+
+	require.Eventually(t, func() bool {
+		st := tor.Stats().Status
+		return st != Stopped && st != Allocating
+	}, 5*time.Second, 20*time.Millisecond)
+
+	setter, ok := interface{}(s).(shutdownTimerSetter)
+	require.True(t, ok)
+
+	var timersMu sync.Mutex
+	observedTimers := make(map[string]time.Duration)
+
+	setter.setShutdownTimer(func(phase string, d time.Duration) (<-chan time.Time, func() bool) {
+		timersMu.Lock()
+		observedTimers[phase] = d
+		timersMu.Unlock()
+		t := time.NewTimer(d)
+		return t.C, t.Stop
+	})
+
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	select {
+	case <-storageProv.closeEntered:
+		// File close entered; delay 400ms before unblocking so torrents phase consumes 400ms
+		time.Sleep(400 * time.Millisecond)
+	case <-time.After(3 * time.Second):
+		t.Fatal("shutdown did not enter file close")
+	}
+
+	select {
+	case err := <-closeDone:
+		require.NoError(t, err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("Close timed out")
+	}
+
+	timersMu.Lock()
+	defer timersMu.Unlock()
+
+	dTotal, okTot := observedTimers["total"]
+	require.True(t, okTot, "must create timer for 'total' phase")
+
+	dTorrents, okTor := observedTimers["torrents"]
+	dWorkers, okWor := observedTimers["workers"]
+	dDatabase, okDB := observedTimers["database"]
+
+	require.True(t, okTor, "must create timer for 'torrents' phase")
+	require.True(t, okWor, "must create timer for 'workers' phase")
+	require.True(t, okDB, "must create timer for 'database' phase")
+
+	assert.LessOrEqual(t, dTorrents, dTotal, "torrents phase timer must receive remaining budget, not full hour")
+	assert.LessOrEqual(t, dWorkers, dTorrents-200*time.Millisecond,
+		"workers phase timer must receive remaining budget, not reset full 4900ms budget")
+	assert.LessOrEqual(t, dDatabase, dWorkers,
+		"database phase timer must receive remaining budget")
+	assert.Less(t, dWorkers, 4750*time.Millisecond,
+		"workers phase timer cannot be full initial 4900ms budget")
+}
