+func testInjectedShutdownTimerControlsExecution(t *testing.T, baseCfg Config) {
+	tmp := t.TempDir()
+	boundPort := freePort(t)
+
+	cfg := baseCfg
+	cfg.Database = filepath.Join(tmp, "session_timer_drive.db")
+	cfg.DataDir = tmp
+	cfg.RPCPort = boundPort
+	cfg.RPCShutdownTimeout = 2 * time.Second
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	initTotalDl, initRPCDl := evaluatorActiveShutdownDeadline(s)
+	assert.True(t, initTotalDl.IsZero(), "active total shutdown deadline must be zero before Close()")
+	assert.True(t, initRPCDl.IsZero(), "active rpc shutdown deadline must be zero before Close()")
+
+	setter, ok := interface{}(s).(shutdownTimerSetter)
+	require.True(t, ok, "Session must implement shutdownTimerSetter")
+
+	totalTrigger := make(chan time.Time, 1)
+	setter.setShutdownTimer(func(phase string, d time.Duration) (<-chan time.Time, func() bool) {
+		if phase == "total" {
+			return totalTrigger, func() bool { return true }
+		}
+		tm := time.NewTimer(d)
+		return tm.C, tm.Stop
+	})
+
+	rawConn, err := net.Dial("tcp", "127.0.0.1:"+strconv.Itoa(boundPort))
+	require.NoError(t, err)
+	defer rawConn.Close()
+
+	header := fmt.Sprintf("POST / HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nExpect: 100-continue\r\nContent-Type: application/json\r\nAccept: application/json\r\nContent-Length: 1000\r\n\r\n", boundPort)
+	_, err = rawConn.Write([]byte(header))
+	require.NoError(t, err)
+
+	reader := bufio.NewReader(rawConn)
+	line, err := reader.ReadString(byte(10))
+	require.NoError(t, err, "server must respond with 100 Continue upon entering handler")
+	require.Contains(t, line, "100 Continue")
+
+	start := time.Now()
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	time.Sleep(30 * time.Millisecond)
+	totalTrigger <- time.Now()
+
+	select {
+	case closeErr := <-closeDone:
+		elapsed := time.Since(start)
+		assert.Error(t, closeErr, "Close must return error when injected total timer channel fires")
+		assert.Less(t, elapsed, 400*time.Millisecond, "Close was not driven by injected timer channel")
+	case <-time.After(1 * time.Second):
+		t.Fatal("Close was not driven by injected timer channel (hung beyond deadline)")
+	}
+}
