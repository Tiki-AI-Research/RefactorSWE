+// TestEvaluator_Session_WorkerRegistration_DHT verifies that processDHTResults is tracked
+// by s.workers (sync.WaitGroup) and prevents workerCompletion() from closing when blocked.
+func TestEvaluator_Session_WorkerRegistration_DHT(t *testing.T) {
+	tmp := t.TempDir()
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.RPCEnabled = false
+	cfg.DHTEnabled = true
+	cfg.DHTPort = uint16(freePort(t))
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	// Holding mPeerRequests blocks handleDHTtick inside processDHTResults
+	s.mPeerRequests.Lock()
+	time.Sleep(1100 * time.Millisecond)
+
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	workerCh := evaluatorWorkerCompletion(t, s)
+
+	select {
+	case <-workerCh:
+		s.mPeerRequests.Unlock()
+		t.Fatal("workerCompletion closed while processDHTResults worker was blocked")
+	case <-time.After(200 * time.Millisecond):
+		// Expected: processDHTResults is tracked and keeps workerCompletion open
+	}
+
+	s.mPeerRequests.Unlock()
+
+	select {
+	case err := <-closeDone:
+		require.NoError(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("Close timed out after unblocking DHT worker")
+	}
+
+	select {
+	case <-workerCh:
+	default:
+		t.Fatal("workerCompletion must be closed after unblocked shutdown")
+	}
+}
