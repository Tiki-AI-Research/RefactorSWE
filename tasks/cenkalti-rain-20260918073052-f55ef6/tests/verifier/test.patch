+// TestEvaluator_Session_WorkerRegistration_HealthCheck observes the existing health module
+// across helper extraction, without depending on worker function names or WaitGroup layout.
+func TestEvaluator_Session_WorkerRegistration_HealthCheck(t *testing.T) {
+ tmp := t.TempDir()
+ cfg := DefaultConfig
+ cfg.Database = filepath.Join(tmp, "session.db")
+ cfg.DataDir = tmp
+ cfg.RPCEnabled = false
+ cfg.DHTEnabled = false
+ s, err := NewSession(cfg)
+ require.NoError(t, err)
+ defer evaluatorSafeClose(s)
+ addTestTorrent(t, s)
+ // Observe the real health-check loop and the declared completion boundary,
+ // without changing internal counters or requiring a particular worker-group layout.
+ healthRunning := func() bool {
+  buf := make([]byte, 1<<20)
+  n := runtime.Stack(buf, true)
+  return strings.Contains(string(buf[:n]), "/torrent/session_healthcheck.go:")
+ }
+ require.Eventually(t, healthRunning, time.Second, time.Millisecond, "health-check worker must start")
+ done := evaluatorWorkerCompletion(t, s)
+ require.Equal(t, done, evaluatorWorkerCompletion(t, s), "completion channel must be stable")
+ select {
+ case <-done: t.Fatal("workerCompletion closed while the health-check worker is running")
+ default:
+ }
+ require.NoError(t, evaluatorSafeClose(s))
+ select {
+ case <-done:
+ default: t.Fatal("workerCompletion must be closed before successful Close returns")
+ }
+ require.False(t, healthRunning(), "health-check worker must exit before successful Close returns")
+}
