+// TestEvaluator_Session_WebseedCloseIdleConnections verifies that Session.Close() explicitly
+// closes idle keepalive connections in s.webseedClient.
+func TestEvaluator_Session_WebseedCloseIdleConnections(t *testing.T) {
+	var idleConns atomic.Int32
+	var closedConns atomic.Int32
+
+	ts := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "5")
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("hello"))
+	}))
+	ts.Config.ConnState = func(c net.Conn, state http.ConnState) {
+		switch state {
+		case http.StateIdle:
+			idleConns.Add(1)
+		case http.StateClosed:
+			closedConns.Add(1)
+		}
+	}
+	ts.Start()
+	defer ts.Close()
+
+	tmp := t.TempDir()
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.RPCEnabled = false
+	cfg.DHTEnabled = false
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	resp, err := s.webseedClient.Get(ts.URL)
+	require.NoError(t, err)
+	_, _ = io.ReadAll(resp.Body)
+	_ = resp.Body.Close()
+
+	require.Eventually(t, func() bool {
+		return idleConns.Load() >= 1
+	}, 2*time.Second, 10*time.Millisecond, "connection must transition to idle")
+
+	initialClosed := closedConns.Load()
+
+	require.NoError(t, evaluatorSafeClose(s))
+
+	require.Eventually(t, func() bool {
+		return closedConns.Load() > initialClosed
+	}, 1*time.Second, 10*time.Millisecond, "idle connection must be closed by CloseIdleConnections()")
+}
