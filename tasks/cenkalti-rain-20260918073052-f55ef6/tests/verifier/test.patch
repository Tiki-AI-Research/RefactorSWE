+func TestEvaluator_B6_Session_RPCShutdown_RejectsNewWorkAfterShutdownBegins(t *testing.T) {
+	tmp := t.TempDir()
+	boundPort := freePort(t)
+
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = true
+	cfg.RPCHost = "127.0.0.1"
+	cfg.RPCPort = boundPort
+	cfg.RPCShutdownTimeout = 500 * time.Millisecond
+
+	storageProv := &evaluatorSlowCloseStorageProvider{
+		base:         newFileStorageProvider(&cfg),
+		closeEntered: make(chan struct{}),
+	}
+	cfg.CustomStorage = storageProv
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	// Conn 1: Send request headers with Expect: 100-continue to hold active handler
+	conn1, err := net.Dial("tcp", fmt.Sprintf("127.0.0.1:%d", boundPort))
+	require.NoError(t, err)
+	defer conn1.Close()
+
+	reqHeader1 := fmt.Sprintf("POST / HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nExpect: 100-continue\r\nContent-Type: application/json\r\nAccept: application/json\r\nContent-Length: 1000\r\n\r\n", boundPort)
+	_, err = conn1.Write([]byte(reqHeader1))
+	require.NoError(t, err)
+
+	r1 := bufio.NewReader(conn1)
+	line, err := r1.ReadString('\n')
+	require.NoError(t, err)
+	require.Contains(t, line, "100 Continue")
+
+	// Conn 2: Pre-established keepalive connection
+	conn2, err := net.Dial("tcp", fmt.Sprintf("127.0.0.1:%d", boundPort))
+	require.NoError(t, err)
+	defer conn2.Close()
+
+	body1 := `{"jsonrpc":"2.0","method":"Session.Version","params":[],"id":1}`
+	req2First := fmt.Sprintf("POST / HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nContent-Type: application/json\r\nAccept: application/json\r\nContent-Length: %d\r\nConnection: keep-alive\r\n\r\n%s", boundPort, len(body1), body1)
+	_, err = conn2.Write([]byte(req2First))
+	require.NoError(t, err)
+
+	r2 := bufio.NewReader(conn2)
+	resp1, err := http.ReadResponse(r2, nil)
+	require.NoError(t, err)
+	_ = resp1.Body.Close()
+	require.Equal(t, http.StatusOK, resp1.StatusCode)
+
+	tor := addTestTorrent(t, s)
+	require.NoError(t, tor.Start())
+
+	select {
+	case <-tor.NotifyComplete():
+	case err := <-tor.torrent.NotifyError():
+		t.Fatal(err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for torrent completion")
+	}
+
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	// Verify admission control on already-connected Conn 2 during RPC shutdown grace period
+	body2 := `{"jsonrpc":"2.0","method":"Session.Version","params":[],"id":2}`
+	var rejected bool
+	rejectionDeadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(rejectionDeadline) {
+		req2Second := fmt.Sprintf("POST / HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nContent-Type: application/json\r\nAccept: application/json\r\nContent-Length: %d\r\nConnection: keep-alive\r\n\r\n%s", boundPort, len(body2), body2)
+		_ = conn2.SetDeadline(time.Now().Add(500 * time.Millisecond))
+		_, err = conn2.Write([]byte(req2Second))
+		if err != nil {
+			rejected = errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.EPIPE)
+			t.Logf("terminal transport result: %T %v", err, err)
+			break
+		}
+		resp2, err := http.ReadResponse(r2, nil)
+		if err != nil {
+			rejected = errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.EPIPE)
+			t.Logf("terminal transport result: %T %v", err, err)
+			break
+		}
+		_, _ = io.Copy(io.Discard, resp2.Body)
+		_ = resp2.Body.Close()
+		if resp2.StatusCode >= 400 && resp2.StatusCode < 600 {
+			rejected = true
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	assert.True(t, rejected, "new request on established keepalive connection after shutdown started must receive a terminal transport failure or HTTP error")
+
+	// Release Conn 1 so RPC shutdown proceeds
+	_ = conn1.Close()
+
+	// Synchronize on an observable shutdown-in-progress condition (file close has started)
+	select {
+	case <-storageProv.closeEntered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("shutdown did not enter file close within deadline")
+	}
+
+	// Start the new request only after shutdown has definitely begun
+	url := fmt.Sprintf("http://127.0.0.1:%d/", boundPort)
+	reqBody := `{"jsonrpc":"2.0","method":"Session.GetSessionStats","params":[],"id":1}`
+	req, err := http.NewRequest(http.MethodPost, url, bytes.NewReader([]byte(reqBody)))
+	require.NoError(t, err)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+
+	// Verify that the request receives a terminal non-success result before Session.Close() returns
+	reqDone := make(chan struct {
+		statusCode int
+		err        error
+	}, 1)
+	go func() {
+		client := &http.Client{Timeout: 1 * time.Second}
+		defer client.CloseIdleConnections()
+		resp, doErr := client.Do(req)
+		statusCode := 0
+		if resp != nil {
+			statusCode = resp.StatusCode
+			_ = resp.Body.Close()
+		}
+		reqDone <- struct {
+			statusCode int
+			err        error
+		}{statusCode, doErr}
+	}()
+
+	select {
+	case res := <-reqDone:
+		// Verify that Session.Close() has not returned yet at the time the request completed
+		select {
+		case <-closeDone:
+			t.Fatal("Session.Close returned before new request completed")
+		default:
+		}
+		if res.err == nil {
+			assert.NotEqual(t, http.StatusOK, res.statusCode, "new request sent after shutdown began must not succeed with 200 OK")
+			assert.True(t, res.statusCode >= 400 && res.statusCode < 600, "new request must receive terminal non-success HTTP status, got %d", res.statusCode)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("new request did not complete before Session.Close returned")
+	}
+
+	select {
+	case err := <-closeDone:
+		assert.NoError(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("Session.Close timed out")
+	}
+}
