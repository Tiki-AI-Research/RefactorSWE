+// B7: Terminates active handler after timeout
+func TestEvaluator_B7_Session_RPCShutdown_TerminatesActiveHandlerAfterTimeout(t *testing.T) {
+	tmp := t.TempDir()
+	boundPort := freePort(t)
+
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = true
+	cfg.RPCHost = "127.0.0.1"
+	cfg.RPCPort = boundPort
+	cfg.RPCShutdownTimeout = 100 * time.Millisecond
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	enteredCh := make(chan struct{})
+	doneCh := make(chan struct{})
+
+	origHandler := s.rpc.httpServer.Handler
+	s.rpc.httpServer.Handler = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		close(enteredCh)
+		defer close(doneCh)
+		origHandler.ServeHTTP(w, r)
+	})
+
+	conn, err := net.Dial("tcp", fmt.Sprintf("127.0.0.1:%d", boundPort))
+	require.NoError(t, err)
+	defer conn.Close()
+
+	// Send request headers with Expect: 100-continue and uncompleted body
+	reqHeader := fmt.Sprintf("POST / HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nExpect: 100-continue\r\nContent-Type: application/json\r\nAccept: application/json\r\nContent-Length: 1000\r\n\r\n", boundPort)
+	_, err = conn.Write([]byte(reqHeader))
+	require.NoError(t, err)
+
+	// Ensure the RPC handler is definitely active before starting shutdown
+	reader := bufio.NewReader(conn)
+	line, err := reader.ReadString('\n')
+	require.NoError(t, err, "server must respond with 100 Continue upon entering handler body read")
+	require.Contains(t, line, "100 Continue", "server must send 100 Continue indicating handler is actively reading request")
+
+	select {
+	case <-enteredCh:
+	case <-time.After(2 * time.Second):
+		t.Fatal("server-side handler did not enter execution")
+	}
+
+	// Server-side handler is actively reading request body. Now initiate Session.Close()
+	start := time.Now()
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	// Verify that Session.Close() returns within bound
+	select {
+	case err := <-closeDone:
+		elapsed := time.Since(start)
+		assert.LessOrEqual(t, elapsed, cfg.RPCShutdownTimeout+250*time.Millisecond,
+			"Session.Close must complete within RPCShutdownTimeout + 250ms")
+		assert.NoError(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("Session.Close timed out during RPC shutdown")
+	}
+
+	// Verify that the server-side handler has terminated by the time Session.Close() returns
+	select {
+	case <-doneCh:
+		// Succeeded: server-side handler function has returned
+	default:
+		t.Fatal("server-side handler function was still executing when Session.Close returned")
+	}
+
+	// Verify that the client receives a terminal non-success outcome
+	_ = conn.SetReadDeadline(time.Now().Add(100 * time.Millisecond))
+	// Drain buffered error response bytes; closure need not make the first Read fail.
+	var received []byte
+	var readErr error
+	for len(received) < 65536 {
+		buf := make([]byte, 4096)
+		n, e := reader.Read(buf)
+		received = append(received, buf[:n]...)
+		if e != nil { readErr = e; break }
+	}
+	t.Logf("buffered bytes=%q terminal=%v", string(received), readErr)
+	assert.True(t, errors.Is(readErr, io.EOF) || errors.Is(readErr, syscall.ECONNRESET), "connection must terminate after draining buffered data: %v", readErr)
+	assert.NotContains(t, string(received), "200 OK", "active incomplete request must not succeed")
+
+	if readErr != nil {
+		netErr, ok := readErr.(net.Error)
+		assert.False(t, ok && netErr.Timeout(), "server-side handler was not terminated when Session.Close returned (read timed out)")
+	}
+}
