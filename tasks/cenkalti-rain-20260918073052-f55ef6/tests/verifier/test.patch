+// B8: Enforces deadline and releases port
+func TestEvaluator_B8_Session_RPCShutdown_EnforcesDeadlineAndReleasesPort(t *testing.T) {
+	tmp := t.TempDir()
+	boundPort := freePort(t)
+
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = true
+	cfg.RPCHost = "127.0.0.1"
+	cfg.RPCPort = boundPort
+	cfg.RPCShutdownTimeout = 100 * time.Millisecond
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	totalBudget, rpcBudget := evaluatorShutdownBudget(s)
+	assert.Equal(t, cfg.RPCShutdownTimeout+150*time.Millisecond, totalBudget, "shutdown budget without active torrents must be timeout + 150ms")
+	assert.Equal(t, cfg.RPCShutdownTimeout+150*time.Millisecond, rpcBudget, "rpc shutdown budget must be timeout + 150ms")
+
+	setter, ok := interface{}(s).(shutdownTimerSetter)
+	require.True(t, ok, "Session must implement setShutdownTimer(fn func(phase string, d time.Duration) (<-chan time.Time, func() bool))")
+	var observedTimers sync.Map
+	setter.setShutdownTimer(func(phase string, d time.Duration) (<-chan time.Time, func() bool) {
+		observedTimers.Store(phase, d)
+		t := time.NewTimer(d)
+		return t.C, t.Stop
+	})
+
+	rawConn, err := net.Dial("tcp", "127.0.0.1:"+strconv.Itoa(boundPort))
+	require.NoError(t, err)
+	defer rawConn.Close()
+
+	header := fmt.Sprintf("POST / HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nExpect: 100-continue\r\nContent-Type: application/json\r\nAccept: application/json\r\nContent-Length: 1000\r\n\r\n", boundPort)
+	_, err = rawConn.Write([]byte(header))
+	require.NoError(t, err)
+
+	// Ensure connection is actively being processed by server before closing
+	reader := bufio.NewReader(rawConn)
+	line, err := reader.ReadString('\n')
+	require.NoError(t, err, "server must respond with 100 Continue upon entering handler")
+	require.Contains(t, line, "100 Continue")
+
+	start := time.Now()
+	closeErr := evaluatorSafeClose(s)
+	duration := time.Since(start)
+
+	assert.NoError(t, closeErr)
+	assert.LessOrEqual(t, duration, cfg.RPCShutdownTimeout+250*time.Millisecond,
+		"Session.Close monotonic duration must not exceed RPCShutdownTimeout + 250ms")
+
+	totalDl, rpcDl := evaluatorActiveShutdownDeadline(s)
+	assert.False(t, totalDl.IsZero(), "active shutdown deadline must be recorded")
+	assert.False(t, rpcDl.IsZero(), "active rpc shutdown deadline must be recorded")
+	assert.WithinDuration(t, start.Add(totalBudget), totalDl, 50*time.Millisecond, "active total deadline must match start + totalBudget")
+	assert.WithinDuration(t, start.Add(rpcBudget), rpcDl, 50*time.Millisecond, "active rpc deadline must match start + rpcBudget")
+
+	valTotal, okTotal := observedTimers.Load("total")
+	assert.True(t, okTotal, "shutdown must create execution timer for 'total' phase")
+	if okTotal {
+		d := valTotal.(time.Duration)
+		assert.InDelta(t, totalBudget.Milliseconds(), d.Milliseconds(), 20, "actual execution timer for 'total' phase must match totalBudget")
+	}
+	valRPC, okRPC := observedTimers.Load("rpc")
+	assert.True(t, okRPC, "shutdown must create execution timer for 'rpc' phase")
+	if okRPC {
+		d := valRPC.(time.Duration)
+		assert.InDelta(t, rpcBudget.Milliseconds(), d.Milliseconds(), 20, "actual execution timer for 'rpc' phase must match rpcBudget")
+	}
+
+	// Server must have terminated all active client connections before Close() returns
+	_ = rawConn.SetReadDeadline(time.Now().Add(100 * time.Millisecond))
+	// Drain buffered error response bytes; closure need not make the first Read fail.
+	var received []byte
+	var readErr error
+	for len(received) < 65536 {
+		buf := make([]byte, 4096)
+		n, e := reader.Read(buf)
+		received = append(received, buf[:n]...)
+		if e != nil { readErr = e; break }
+	}
+	t.Logf("buffered bytes=%q terminal=%v", string(received), readErr)
+	assert.True(t, errors.Is(readErr, io.EOF) || errors.Is(readErr, syscall.ECONNRESET), "connection must terminate after draining buffered data: %v", readErr)
+	assert.NotContains(t, string(received), "200 OK", "active incomplete request must not succeed")
+
+	if readErr != nil {
+		netErr, ok := readErr.(net.Error)
+		assert.False(t, ok && netErr.Timeout(), "active connection was not closed by server (read timed out)")
+	}
+
+	conn, dialErr := net.DialTimeout("tcp", "127.0.0.1:"+strconv.Itoa(boundPort), 50*time.Millisecond)
+	if conn != nil {
+		_ = conn.Close()
+		t.Fatal("RPC listener must be closed after Session.Close returns")
+	}
+	assert.Error(t, dialErr, "connecting to closed RPC listener must fail")
+
+	s2, err := NewSession(cfg)
+	require.NoError(t, err, "reopening session on same port and database must succeed immediately")
+	assert.NoError(t, evaluatorSafeClose(s2))
+
+	testInjectedShutdownTimerControlsExecution(t, cfg)
+}
