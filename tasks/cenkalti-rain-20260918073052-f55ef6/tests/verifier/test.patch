+// TestEvaluator_Session_TorrentStopAsyncTracker verifies that Torrent.Stop() does not synchronously
+// wait for HTTP tracker response to event=stopped announce.
+func TestEvaluator_Session_TorrentStopAsyncTracker(t *testing.T) {
+	initialAnnounceReceived := make(chan struct{}, 1)
+	stopAnnounceReceived := make(chan struct{}, 1)
+
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		event := r.URL.Query().Get("event")
+		if event == "stopped" {
+			select {
+			case stopAnnounceReceived <- struct{}{}:
+			default:
+			}
+			time.Sleep(3 * time.Second)
+			w.WriteHeader(http.StatusOK)
+			return
+		}
+		select {
+		case initialAnnounceReceived <- struct{}{}:
+		default:
+		}
+		w.Header().Set("content-type", "text/plain")
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("d8:completei0e10:incompletei0e8:intervali1800e12:min intervali60e5:peers0:e"))
+	}))
+	defer ts.Close()
+
+	tmp := t.TempDir()
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.RPCEnabled = false
+	cfg.DHTEnabled = false
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+	_ = evaluatorWorkerCompletion(t, s)
+
+	tor := addTestTorrent(t, s)
+	tor.AddTracker(ts.URL)
+
+	require.NoError(t, tor.Start())
+
+	// Wait deterministically for initial tracker announce to be received
+	select {
+	case <-initialAnnounceReceived:
+	case <-time.After(5 * time.Second):
+		t.Fatal("initial tracker announce did not arrive")
+	}
+
+	// Verify tracker status is Working (HasAnnounced is true)
+	require.Eventually(t, func() bool {
+		for _, trk := range tor.Trackers() {
+			if trk.Status == Working {
+				return true
+			}
+		}
+		return false
+	}, 5*time.Second, 20*time.Millisecond)
+
+	start := time.Now()
+	err = tor.Stop()
+	elapsed := time.Since(start)
+
+	assert.NoError(t, err)
+	assert.Less(t, elapsed, 400*time.Millisecond, "Torrent.Stop must return promptly without waiting for tracker response")
+
+	// Verify event=stopped announce arrived at tracker
+	select {
+	case <-stopAnnounceReceived:
+	case <-time.After(3 * time.Second):
+		t.Fatal("event=stopped announce did not arrive at tracker")
+	}
+
+	require.NoError(t, evaluatorSafeClose(s))
+}
