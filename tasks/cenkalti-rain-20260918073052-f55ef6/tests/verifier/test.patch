+type evaluatorBlockingResponseWriter struct {
+	http.ResponseWriter
+	entered  chan struct{}
+	block    chan struct{}
+	db       *bbolt.DB
+	viewDone chan struct{}
+	dbErr    error
+}
+
+func (b *evaluatorBlockingResponseWriter) checkDB() {
+	if b.db != nil {
+		b.dbErr = b.db.View(func(tx *bbolt.Tx) error {
+			return nil
+		})
+	}
+	if b.viewDone != nil {
+		select {
+		case b.viewDone <- struct{}{}:
+		default:
+		}
+	}
+}
+
+func (b *evaluatorBlockingResponseWriter) WriteHeader(status int) {
+	select {
+	case b.entered <- struct{}{}:
+	default:
+	}
+	<-b.block
+	b.checkDB()
+	b.ResponseWriter.WriteHeader(status)
+}
+
+func (b *evaluatorBlockingResponseWriter) Write(p []byte) (int, error) {
+	select {
+	case b.entered <- struct{}{}:
+	default:
+	}
+	<-b.block
+	b.checkDB()
+	return b.ResponseWriter.Write(p)
+}
+
+func (b *evaluatorBlockingResponseWriter) Header() http.Header {
+	return b.ResponseWriter.Header()
+}
