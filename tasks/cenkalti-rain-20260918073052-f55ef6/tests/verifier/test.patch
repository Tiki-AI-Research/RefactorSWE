+func freePort(t *testing.T) int {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer l.Close()
+	return l.Addr().(*net.TCPAddr).Port
+}
+
+func evaluatorSafeClose(s *Session) (err error) {
+	if s == nil {
+		return nil
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("panic during Close: %v", r)
+		}
+	}()
+	return s.Close()
+}
+
+func evaluatorWorkerCompletion(t *testing.T, s *Session) <-chan struct{} {
+	t.Helper()
+	wc, ok := interface{}(s).(workerCompleter)
+	require.True(t, ok, "Session must implement workerCompletion() <-chan struct{}")
+	ch := wc.workerCompletion()
+	require.NotNil(t, ch, "workerCompletion channel must not be nil")
+	return ch
+}
