+// TestEvaluator_B15_Session_WorkerCompletionBoundary verifies the internal worker completion boundary:
+// 1. Session implements package-private method func (s *Session) workerCompletion() <-chan struct{}
+// 2. Returns the same stable, non-nil channel for the lifetime of Session
+// 3. Remains open while registered background workers are running
+// 4. Closes before/when Session.Close() returns nil on clean shutdown
+// 5. Remains open when Close() times out while worker is blocked on a barrier, retaining BoltDB lock
+// 6. Closes after outstanding worker exits, triggering deferred cleanup to release resources
+// 7. Handles concurrent and repeated Close() calls safely and idempotently
+func TestEvaluator_B15_Session_WorkerCompletionBoundary(t *testing.T) {
+	tmp := t.TempDir()
+	dbPath := filepath.Join(tmp, "session_clean.db")
+	cfg := DefaultConfig
+	cfg.Database = dbPath
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = false
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	// Step 1: Interface assertion (dynamic so unpatched baseline compiles cleanly)
+	wc, ok := interface{}(s).(workerCompleter)
+	require.True(t, ok, "Session must implement workerCompletion() <-chan struct{}")
+
+	// Step 2: Stable, non-nil channel identity
+	ch1 := wc.workerCompletion()
+	ch2 := wc.workerCompletion()
+	require.NotNil(t, ch1, "workerCompletion channel must not be nil")
+	assert.Equal(t, ch1, ch2, "workerCompletion must return the same channel across calls")
+
+	// Step 3: Channel remains open while session is running
+	select {
+	case <-ch1:
+		t.Fatal("workerCompletion channel must not be closed while session is running")
+	default:
+	}
+
+	// Step 4: Clean Close ordering: Close returning nil must not return before channel is closed
+	closeErr := evaluatorSafeClose(s)
+	assert.NoError(t, closeErr)
+
+	select {
+	case <-ch1:
+		// Passed: channel is closed
+	default:
+		t.Fatal("workerCompletion channel must be closed before or when Close returns nil")
+	}
+
+	// Channel identity remains stable after closure
+	assert.Equal(t, ch1, wc.workerCompletion())
+
+	// Subsequent Close is idempotent
+	assert.NoError(t, evaluatorSafeClose(s))
+
+	// Step 5: Concurrent Close calls return cached error/nil idempotently
+	var wg sync.WaitGroup
+	for i := 0; i < 10; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			err := evaluatorSafeClose(s)
+			assert.NoError(t, err)
+		}()
+	}
+	done := make(chan struct{})
+	go func() {
+		wg.Wait()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("concurrent Close calls timed out")
+	}
+}
