+// B6: Rejects new work after shutdown begins
+type evaluatorSlowCloseStorageProvider struct {
+	base         storage.Provider
+	openEntered  chan struct{}
+	closeEntered chan struct{}
+	openOnce     sync.Once
+	closeOnce    sync.Once
+}
