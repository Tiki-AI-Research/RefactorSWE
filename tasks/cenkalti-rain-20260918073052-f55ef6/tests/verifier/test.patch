+// TestEvaluator_Session_WorkerRegistration_Blocklist verifies that blocklistReloader is tracked
+// by s.workers (sync.WaitGroup) and prevents workerCompletion() from closing when blocked.
+func TestEvaluator_Session_WorkerRegistration_Blocklist(t *testing.T) {
+	var count atomic.Int32
+	req2Entered := make(chan struct{})
+
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		reqNum := count.Add(1)
+		w.Header().Set("content-type", "text/plain")
+		w.Header().Set("content-length", "11")
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("1.1.1.1/32\n"))
+		if reqNum == 2 {
+			select {
+			case req2Entered <- struct{}{}:
+			default:
+			}
+		}
+	}))
+	defer ts.Close()
+
+	tmp := t.TempDir()
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.RPCEnabled = false
+	cfg.DHTEnabled = false
+	cfg.BlocklistURL = ts.URL
+	cfg.BlocklistUpdateInterval = 50 * time.Millisecond
+	cfg.BlocklistUpdateTimeout = 5 * time.Second
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	// Holding mBlocklist blocks reloadBlocklist inside blocklistReloader
+	s.mBlocklist.Lock()
+
+	select {
+	case <-req2Entered:
+	case <-time.After(3 * time.Second):
+		s.mBlocklist.Unlock()
+		t.Fatal("blocklistReloader did not trigger background reload")
+	}
+
+	time.Sleep(50 * time.Millisecond)
+
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	workerCh := evaluatorWorkerCompletion(t, s)
+
+	select {
+	case <-workerCh:
+		s.mBlocklist.Unlock()
+		t.Fatal("workerCompletion closed while blocklistReloader was blocked")
+	case <-time.After(200 * time.Millisecond):
+		// Expected: blocklistReloader is tracked and keeps workerCompletion open
+	}
+
+	s.mBlocklist.Unlock()
+
+	select {
+	case err := <-closeDone:
+		require.NoError(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("Close timed out after unblocking blocklist worker")
+	}
+
+	select {
+	case <-workerCh:
+	default:
+		t.Fatal("workerCompletion must be closed after unblocked shutdown")
+	}
+}
