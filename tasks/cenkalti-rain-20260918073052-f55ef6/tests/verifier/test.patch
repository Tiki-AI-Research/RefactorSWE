+type shutdownBudgeter interface {
+	shutdownBudget() (time.Duration, time.Duration)
+}
+
+type shutdownDeadliner interface {
+	activeShutdownDeadline() (time.Time, time.Time)
+}
+
+type shutdownTimerSetter interface {
+	setShutdownTimer(fn func(phase string, d time.Duration) (<-chan time.Time, func() bool))
+}
+
+func evaluatorShutdownBudget(s *Session) (time.Duration, time.Duration) {
+	if b, ok := interface{}(s).(shutdownBudgeter); ok {
+		return b.shutdownBudget()
+	}
+	return 0, 0
+}
+
+func evaluatorActiveShutdownDeadline(s *Session) (time.Time, time.Time) {
+	if d, ok := interface{}(s).(shutdownDeadliner); ok {
+		return d.activeShutdownDeadline()
+	}
+	return time.Time{}, time.Time{}
+}
