+// TestSession_CloseConcurrent verifies that calling Session.Close()
+// concurrently from multiple goroutines is thread-safe and does not panic or deadlock.
+func TestEvaluator_B2_Session_CloseConcurrent(t *testing.T) {
+	tmp := t.TempDir()
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = false
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+	require.NotNil(t, s)
+
+	const goroutines = 10
+	var wg sync.WaitGroup
+	errs := make([]error, goroutines)
+
+	wg.Add(goroutines)
+	for i := 0; i < goroutines; i++ {
+		go func(idx int) {
+			defer wg.Done()
+			defer func() {
+				if r := recover(); r != nil {
+					errs[idx] = fmt.Errorf("panic: %v", r)
+				}
+			}()
+			errs[idx] = evaluatorSafeClose(s)
+		}(i)
+	}
+
+	done := make(chan struct{})
+	go func() {
+		wg.Wait()
+		close(done)
+	}()
+
+	select {
+	case <-done:
+		for _, err := range errs {
+			assert.NoError(t, err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("concurrent Close deadlocked or timed out")
+	}
+
+	// Part 2: Concurrent Close with a blocked worker resulting in deadline error.
+	// Verifies that all concurrent callers (leader and followers) wait for completion
+	// and receive identical non-nil error, killing if !isOwner { return nil } mutants.
+	tmp2 := t.TempDir()
+	cfg2 := DefaultConfig
+	cfg2.Database = filepath.Join(tmp2, "session.db")
+	cfg2.DataDir = tmp2
+	cfg2.DHTEnabled = false
+	cfg2.RPCEnabled = false
+
+	s2, err := NewSession(cfg2)
+	require.NoError(t, err)
+
+	setter2, ok := interface{}(s2).(shutdownTimerSetter)
+	require.True(t, ok)
+	setter2.setShutdownTimer(func(phase string, d time.Duration) (<-chan time.Time, func() bool) {
+		t := time.NewTimer(50 * time.Millisecond)
+		return t.C, t.Stop
+	})
+
+	tx2, err := s2.db.Begin(true)
+	require.NoError(t, err)
+	defer func() { _ = tx2.Rollback() }()
+
+	const goroutines2 = 10
+	var wg2 sync.WaitGroup
+	errs2 := make([]error, goroutines2)
+	startBarrier2 := make(chan struct{})
+
+	wg2.Add(goroutines2)
+	for i := 0; i < goroutines2; i++ {
+		go func(idx int) {
+			defer wg2.Done()
+			<-startBarrier2
+			errs2[idx] = evaluatorSafeClose(s2)
+		}(i)
+	}
+
+	close(startBarrier2)
+	done2 := make(chan struct{})
+	go func() {
+		wg2.Wait()
+		close(done2)
+	}()
+
+	select {
+	case <-done2:
+	case <-time.After(10 * time.Second):
+		t.Fatal("B2 concurrent Close with simulated error timed out (deadlock in Close)")
+	}
+
+	require.Error(t, errs2[0], "leader must receive non-nil shutdown error")
+	firstErrMsg := errs2[0].Error()
+	for i := 1; i < goroutines2; i++ {
+		require.Error(t, errs2[i], "follower must receive non-nil shutdown error")
+		assert.Equal(t, firstErrMsg, errs2[i].Error(), "all concurrent Close callers must receive identical error")
+	}
+}
