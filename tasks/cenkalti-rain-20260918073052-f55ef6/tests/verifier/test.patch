+type evaluatorVerifierBlockingFile struct {
+	storage.File
+	readEntered chan struct{}
+	unblockRead chan struct{}
+}
+
+func (f *evaluatorVerifierBlockingFile) ReadAt(p []byte, off int64) (n int, err error) {
+	select {
+	case f.readEntered <- struct{}{}:
+	default:
+	}
+	<-f.unblockRead
+	return f.File.ReadAt(p, off)
+}
+
+type evaluatorVerifierBlockingStorage struct {
+	storage.Storage
+	bf *evaluatorVerifierBlockingFile
+}
+
+func (s *evaluatorVerifierBlockingStorage) Open(name string, size int64) (storage.File, bool, error) {
+	f, exists, err := s.Storage.Open(name, size)
+	if err != nil {
+		return nil, false, err
+	}
+	s.bf.File = f
+	return s.bf, exists, nil
+}
+
+type evaluatorVerifierBlockingProvider struct {
+	base storage.Provider
+	st   *evaluatorVerifierBlockingStorage
+}
+
+func (p *evaluatorVerifierBlockingProvider) GetStorage(torrentID string) (storage.Storage, error) {
+	s, err := p.base.GetStorage(torrentID)
+	if err != nil {
+		return nil, err
+	}
+	p.st.Storage = s
+	return p.st, nil
+}
