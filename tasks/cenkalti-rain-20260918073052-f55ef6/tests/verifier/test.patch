+// TestEvaluator_B11_Session_ShutdownExceedsDeadline_ReturnsError verifies that when teardown
+// exceeds the declared shutdown bound, Session.Close returns a non-nil error and subsequent
+// invocations deterministically report the cached shutdown error.
+func TestEvaluator_B11_Session_ShutdownExceedsDeadline_ReturnsError(t *testing.T) {
+	tmp := t.TempDir()
+	dbPath := filepath.Join(tmp, "session.db")
+	cfg := DefaultConfig
+	cfg.Database = dbPath
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = false
+
+	blockC := make(chan struct{})
+	defer func() {
+		select {
+		case <-blockC:
+		default:
+			close(blockC)
+		}
+	}()
+
+	cfg.CustomStorage = &evaluatorHangingCloseStorageProvider{
+		base:   newFileStorageProvider(&cfg),
+		blockC: blockC,
+	}
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	initTotalDl, initRPCDl := evaluatorActiveShutdownDeadline(s)
+	assert.True(t, initTotalDl.IsZero(), "active total shutdown deadline must be zero before Close()")
+	assert.True(t, initRPCDl.IsZero(), "active rpc shutdown deadline must be zero before Close()")
+
+	f, err := os.Open(torrentFile)
+	require.NoError(t, err)
+	defer f.Close()
+
+	tor, err := s.AddTorrent(f, nil)
+	require.NoError(t, err)
+
+	require.Eventually(t, func() bool {
+		st := tor.Stats().Status
+		return st == Downloading || st == Seeding
+	}, 5*time.Second, 20*time.Millisecond)
+
+	totalBudget, rpcBudget := evaluatorShutdownBudget(s)
+	assert.Equal(t, 4900*time.Millisecond, totalBudget, "shutdown budget without RPC must be 4900ms")
+	assert.Equal(t, time.Duration(0), rpcBudget, "rpc shutdown budget without RPC must be 0")
+
+	setter, ok := interface{}(s).(shutdownTimerSetter)
+	require.True(t, ok, "Session must implement setShutdownTimer(fn func(phase string, d time.Duration) (<-chan time.Time, func() bool))")
+	var observedTimers sync.Map
+	setter.setShutdownTimer(func(phase string, d time.Duration) (<-chan time.Time, func() bool) {
+		observedTimers.Store(phase, d)
+		t := time.NewTimer(d)
+		return t.C, t.Stop
+	})
+
+	start := time.Now()
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	var closeErr error
+	select {
+	case closeErr = <-closeDone:
+		elapsed := time.Since(start)
+		assert.LessOrEqual(t, elapsed, 5*time.Second, "Session.Close must complete within 5s")
+		assert.GreaterOrEqual(t, elapsed, 4900*time.Millisecond-100*time.Millisecond, "Session.Close must respect internal 4900ms budget")
+		assert.Error(t, closeErr, "Session.Close must return non-nil error when teardown exceeds deadline")
+	case <-time.After(10 * time.Second):
+		t.Fatal("Session.Close watchdog expired (hung indefinitely)")
+	}
+
+	totalDl, rpcDl := evaluatorActiveShutdownDeadline(s)
+	assert.False(t, totalDl.IsZero(), "active shutdown deadline must be recorded")
+	assert.True(t, rpcDl.IsZero(), "rpc deadline without RPC must be zero")
+	assert.WithinDuration(t, start.Add(4900*time.Millisecond), totalDl, 100*time.Millisecond, "active deadline must match start + 4900ms")
+
+	valTotal, okTotal := observedTimers.Load("total")
+	assert.True(t, okTotal, "shutdown must create execution timer for 'total' phase")
+	if okTotal {
+		d := valTotal.(time.Duration)
+		assert.InDelta(t, 4900, d.Milliseconds(), 20, "actual execution timer for 'total' phase must be 4900ms")
+	}
+
+	err2 := evaluatorSafeClose(s)
+	assert.Equal(t, closeErr, err2, "subsequent Session.Close must return cached shutdown error")
+
+	close(blockC)
+}
