+// TestEvaluator_B12_Session_ShutdownExceedsDeadline_RetainsDatabaseLock verifies that when
+// teardown exceeds the deadline, BoltDB lock is retained while unfinished routines may still
+// access it, and is safely released once outstanding work finishes.
+func TestEvaluator_B12_Session_ShutdownExceedsDeadline_RetainsDatabaseLock(t *testing.T) {
+	tmp := t.TempDir()
+	dbPath := filepath.Join(tmp, "session.db")
+	cfg := DefaultConfig
+	cfg.Database = dbPath
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = false
+
+	blockC := make(chan struct{})
+	defer func() {
+		select {
+		case <-blockC:
+		default:
+			close(blockC)
+		}
+	}()
+
+	cfg.CustomStorage = &evaluatorHangingCloseStorageProvider{
+		base:   newFileStorageProvider(&cfg),
+		blockC: blockC,
+	}
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	f, err := os.Open(torrentFile)
+	require.NoError(t, err)
+	defer f.Close()
+
+	tor, err := s.AddTorrent(f, nil)
+	require.NoError(t, err)
+
+	require.Eventually(t, func() bool {
+		st := tor.Stats().Status
+		return st == Downloading || st == Seeding
+	}, 5*time.Second, 20*time.Millisecond)
+
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	select {
+	case closeErr := <-closeDone:
+		assert.Error(t, closeErr, "Session.Close must report error when deadline exceeded")
+	case <-time.After(10 * time.Second):
+		t.Fatal("Session.Close hung indefinitely")
+	}
+
+	// While unfinished torrent work is still running, BoltDB lock must be retained
+	db, err := bbolt.Open(dbPath, 0600, &bbolt.Options{Timeout: 100 * time.Millisecond})
+	assert.Error(t, err, "database lock must be retained while unfinished work may still access it")
+	if db != nil {
+		_ = db.Close()
+	}
+
+	// Unblock outstanding work and verify deferred cleanup releases database lock
+	close(blockC)
+
+	require.Eventually(t, func() bool {
+		db, err := bbolt.Open(dbPath, 0600, &bbolt.Options{Timeout: 50 * time.Millisecond})
+		if err == nil {
+			_ = db.Close()
+			return true
+		}
+		return false
+	}, 5*time.Second, 50*time.Millisecond, "database lock must be released once outstanding work finishes")
+}
