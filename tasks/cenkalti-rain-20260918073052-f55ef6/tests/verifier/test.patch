+// TestSession_CloseIdempotentSequential verifies that calling Session.Close()
+// multiple times sequentially does not panic, deadlocks, or return unexpected errors.
+func TestEvaluator_B1_Session_CloseIdempotentSequential(t *testing.T) {
+	tmp := t.TempDir()
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = false
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+	require.NotNil(t, s)
+
+	// First Close must succeed
+	err1 := evaluatorSafeClose(s)
+	assert.NoError(t, err1)
+
+	// Subsequent sequential Close calls must be idempotent and return nil without panic
+	for i := 0; i < 5; i++ {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					assert.Fail(t, fmt.Sprintf("sequential Close() panicked on iteration %d: %v", i, r))
+				}
+			}()
+			err2 := evaluatorSafeClose(s)
+			assert.NoError(t, err2)
+			err3 := evaluatorSafeClose(s)
+			assert.NoError(t, err3)
+		}()
+	}
+}
