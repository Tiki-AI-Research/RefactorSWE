+type evaluatorSlowCloseStorage struct {
+	storage.Storage
+	provider *evaluatorSlowCloseStorageProvider
+}
+
+func (s *evaluatorSlowCloseStorage) Open(name string, size int64) (storage.File, bool, error) {
+	f, exists, err := s.Storage.Open(name, size)
+	if err != nil {
+		return nil, false, err
+	}
+	s.provider.openOnce.Do(func() {
+		if s.provider.openEntered != nil {
+			close(s.provider.openEntered)
+		}
+	})
+	return &evaluatorSlowCloseFile{File: f, provider: s.provider}, exists, nil
+}
+
+type evaluatorSlowCloseFile struct {
+	storage.File
+	provider *evaluatorSlowCloseStorageProvider
+}
+
+func (f *evaluatorSlowCloseFile) Close() error {
+	f.provider.closeOnce.Do(func() {
+		if f.provider.closeEntered != nil {
+			close(f.provider.closeEntered)
+		}
+		time.Sleep(250 * time.Millisecond)
+	})
+	return f.File.Close()
+}
