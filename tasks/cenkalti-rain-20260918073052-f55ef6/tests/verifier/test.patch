+// TestEvaluator_Session_DefaultShutdownTimerFallback verifies that calling setShutdownTimer(nil)
+// safely restores the default timer implementation without panic, and that the default fallback timer
+// enforces RPC shutdown bounds without excessive timeout skew (killing defaultTimer + 1s mutants).
+func TestEvaluator_Session_DefaultShutdownTimerFallback(t *testing.T) {
+	tmp := t.TempDir()
+	boundPort := freePort(t)
+
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = true
+	cfg.RPCHost = "127.0.0.1"
+	cfg.RPCPort = boundPort
+	cfg.RPCShutdownTimeout = 100 * time.Millisecond
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	setter, ok := interface{}(s).(shutdownTimerSetter)
+	require.True(t, ok)
+
+	// Step 1: Install a custom timer, then explicitly reset to nil to verify safe restoration without panic
+	setter.setShutdownTimer(func(phase string, d time.Duration) (<-chan time.Time, func() bool) {
+		ch := make(chan time.Time)
+		return ch, func() bool { return true }
+	})
+	setter.setShutdownTimer(nil)
+
+	// Step 2: Block updateStatsLoop via BoltDB exclusive transaction so workers phase must wait for default timer
+	tx, err := s.db.Begin(true)
+	require.NoError(t, err)
+	defer func() { _ = tx.Rollback() }()
+
+	// Step 3: Close session and measure actual elapsed time using default fallback timer
+	start := time.Now()
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	select {
+	case err := <-closeDone:
+		elapsed := time.Since(start)
+		assert.Error(t, err, "Close must return error when worker teardown exceeds deadline")
+		assert.GreaterOrEqual(t, elapsed, 200*time.Millisecond, "Close must wait for 250ms total budget")
+		assert.LessOrEqual(t, elapsed, 400*time.Millisecond, "Close using default timer must complete within 400ms, killing defaultTimer + 1s mutant")
+	case <-time.After(3 * time.Second):
+		t.Fatal("Session.Close timed out using default timer")
+	}
+}
