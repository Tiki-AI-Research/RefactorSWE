+// evaluatorTrackedAllocFile wraps storage.File to observe whether Close() is called.
+type evaluatorTrackedAllocFile struct {
+	storage.File
+	closed atomic.Bool
+}
+
+func (f *evaluatorTrackedAllocFile) Close() error {
+	f.closed.Store(true)
+	return f.File.Close()
+}
+
+// evaluatorTrackedAllocStorage tracks file allocations and provides synchronization hooks.
+type evaluatorTrackedAllocStorage struct {
+	storage.Storage
+	mu     sync.Mutex
+	files  []*evaluatorTrackedAllocFile
+	opened atomic.Int32
+	onOpen chan struct{}
+	slow   bool
+}
+
+func (s *evaluatorTrackedAllocStorage) Open(name string, size int64) (storage.File, bool, error) {
+	if s.slow {
+		time.Sleep(30 * time.Millisecond)
+	}
+	f, exists, err := s.Storage.Open(name, size)
+	if err != nil {
+		return nil, false, err
+	}
+	tf := &evaluatorTrackedAllocFile{File: f}
+	s.mu.Lock()
+	s.files = append(s.files, tf)
+	s.mu.Unlock()
+	s.opened.Add(1)
+	select {
+	case s.onOpen <- struct{}{}:
+	default:
+	}
+	return tf, exists, nil
+}
+
+type evaluatorTrackedAllocStorageProvider struct {
+	base    storage.Provider
+	storage *evaluatorTrackedAllocStorage
+}
+
+func (p *evaluatorTrackedAllocStorageProvider) GetStorage(torrentID string) (storage.Storage, error) {
+	s, err := p.base.GetStorage(torrentID)
+	if err != nil {
+		return nil, err
+	}
+	p.storage.Storage = s
+	return p.storage, nil
+}
