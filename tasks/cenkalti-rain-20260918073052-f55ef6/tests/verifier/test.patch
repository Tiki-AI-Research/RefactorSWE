+// TestEvaluator_Session_CloseDuringActiveAllocation verifies that calling Session.Close()
+// while a torrent is actively allocating storage promptly halts allocation and closes
+// all open file handles without leaking resources or hanging.
+func TestEvaluator_B3_Session_CloseHaltsActiveTorrentWorkAndReleasesFileHandles(t *testing.T) {
+	tmp := t.TempDir()
+	cfg := DefaultConfig
+	cfg.Database = filepath.Join(tmp, "session.db")
+	cfg.DataDir = tmp
+	cfg.DHTEnabled = false
+	cfg.RPCEnabled = false
+	cfg.Host = "127.0.0.1"
+
+	trackStorage := &evaluatorTrackedAllocStorage{
+		onOpen: make(chan struct{}, 100),
+		slow:   true,
+	}
+	cfg.CustomStorage = &evaluatorTrackedAllocStorageProvider{
+		base:    newFileStorageProvider(&cfg),
+		storage: trackStorage,
+	}
+
+	s, err := NewSession(cfg)
+	require.NoError(t, err)
+
+	initTotalDl, initRPCDl := evaluatorActiveShutdownDeadline(s)
+	assert.True(t, initTotalDl.IsZero(), "active total shutdown deadline must be zero before Close()")
+	assert.True(t, initRPCDl.IsZero(), "active rpc shutdown deadline must be zero before Close()")
+
+	totalBudget, rpcBudget := evaluatorShutdownBudget(s)
+	assert.Equal(t, 4900*time.Millisecond, totalBudget, "shutdown budget without RPC must be 4900ms")
+	assert.Equal(t, time.Duration(0), rpcBudget, "rpc shutdown budget without RPC must be 0")
+
+	f, err := os.Open(torrentFile)
+	require.NoError(t, err)
+	defer f.Close()
+
+	// Add torrent without Stopped: true so allocation begins immediately
+	tor, err := s.AddTorrent(f, nil)
+	require.NoError(t, err)
+	require.NotNil(t, tor)
+
+	// Wait deterministically until allocation has actively opened at least one file
+	select {
+	case <-trackStorage.onOpen:
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for storage allocation to start")
+	}
+
+	// Close session while allocation is active
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- evaluatorSafeClose(s)
+	}()
+
+	select {
+	case err := <-closeDone:
+		assert.NoError(t, err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("Session.Close timed out during active allocation")
+	}
+
+	// Active allocation must halt: no new files should be opened after Session.Close returns
+	openedAtClose := trackStorage.opened.Load()
+	time.Sleep(50 * time.Millisecond)
+	assert.Equal(t, openedAtClose, trackStorage.opened.Load(), "allocation must not continue opening files after Session.Close returns")
+
+	// All files opened by the allocator must be closed to release file handles
+	trackStorage.mu.Lock()
+	openedFiles := append([]*evaluatorTrackedAllocFile(nil), trackStorage.files...)
+	trackStorage.mu.Unlock()
+	require.NotEmpty(t, openedFiles, "at least one file must have been opened during allocation")
+
+	for i, of := range openedFiles {
+		assert.True(t, of.closed.Load(), fmt.Sprintf("file %d opened during allocation must be closed upon Session.Close", i))
+	}
+
+	// Database lock must be released
+	db, dbErr := bbolt.Open(cfg.Database, 0600, &bbolt.Options{Timeout: 1 * time.Second})
+	assert.NoError(t, dbErr, "database lock must be released after Session.Close")
+	if db != nil {
+		_ = db.Close()
+	}
+
+	// Reopening session on the same database succeeds
+	s2, err := NewSession(cfg)
+	require.NoError(t, err, "reopening session with same configuration must succeed after Close")
+	if s2 != nil {
+		_ = evaluatorSafeClose(s2)
+	}
+}
