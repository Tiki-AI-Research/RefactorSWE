+		cfg.RPCShutdownTimeout = tc.timeout
+
+		s, err := NewSession(cfg)
+		assert.Error(t, err, fmt.Sprintf("NewSession must return an error when RPCEnabled is true and RPCShutdownTimeout is %v (%s)", tc.timeout, tc.name))
+		if s != nil {
+			_ = s.Close()
+			t.Fatalf("NewSession returned a non-nil session when RPCShutdownTimeout is %v (%s)", tc.timeout, tc.name)
+		}
+
+		// Verify database file was not created
+		_, statErr := os.Stat(cfg.Database)
+		assert.True(t, os.IsNotExist(statErr), fmt.Sprintf("database file must not be created on rejected configuration (%s)", tc.name))
+	}
+
+	// Verify that when RPCEnabled is false, non-positive timeout does not fail NewSession
+	tmpDisabled := t.TempDir()
+	cfgDisabled := DefaultConfig
+	cfgDisabled.Database = filepath.Join(tmpDisabled, "session.db")
+	cfgDisabled.DataDir = tmpDisabled
+	cfgDisabled.DHTEnabled = false
+	cfgDisabled.RPCEnabled = false
+	cfgDisabled.RPCShutdownTimeout = -1 * time.Second
+
+	sDisabled, errDisabled := NewSession(cfgDisabled)
+	assert.NoError(t, errDisabled, "NewSession must succeed when RPCEnabled is false even if RPCShutdownTimeout is non-positive")
+	if sDisabled != nil {
+		_ = sDisabled.Close()
+	}
+}
