+package verifier_architecture
+
+// These checks use historical parse APIs and disable editor implementations to
+// test delegation independently of new function names and signatures.
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/build"
+	"go/format"
+	"go/importer"
+	"go/parser"
+	"go/token"
+	"go/types"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func repository(t *testing.T) string {
+	t.Helper()
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("cannot locate repository")
+	}
+	return filepath.Dir(filepath.Dir(file))
+}
+
+// New packages belong to the migration regardless of directory spelling. Existing
+// editor packages remain part of the boundary; baseline parser services are not.
+func componentDirs(root string) ([]string, error) {
+	dirs := map[string]bool{}
+	err := filepath.WalkDir(root, func(path string, entry os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, _ := filepath.Rel(root, path)
+		if entry.IsDir() {
+			if strings.HasPrefix(entry.Name(), ".") || entry.Name() == "vendor" || strings.HasPrefix(rel, "verifier_") || rel == "tests" || rel == "test" {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		dir := filepath.Dir(rel)
+		if dir == "." || dir == "parse" {
+			return nil
+		}
+		if dir == "editor" || strings.HasPrefix(dir, "editor/") {
+			dirs[filepath.Dir(path)] = true
+			return nil
+		}
+		old, err := exec.Command("git", "-C", root, "ls-tree", "-r", "--name-only", "8928f1866da3269aed613288afb3554985df94e1", "--", dir).Output()
+		if err != nil {
+			return err
+		}
+		if len(bytes.TrimSpace(old)) == 0 {
+			dirs[filepath.Dir(path)] = true
+		}
+		return nil
+	})
+	out := []string{}
+	for dir := range dirs {
+		out = append(out, dir)
+	}
+	return out, err
+}
+
+var disabledEditor struct {
+	sync.Once
+	path string
+	dir  string
+	err  error
+}
+
+func TestMain(m *testing.M) {
+	code := m.Run()
+	if disabledEditor.dir != "" {
+		os.RemoveAll(disabledEditor.dir)
+	}
+	os.Exit(code)
+}
+
+// Compile an overlay with editor function bodies disabled. Keeping the original
+// body unreachable preserves imports and local declarations. No candidate files
+// are changed, and no editor package, function name or signature is prescribed.
+func editorOverlay(root, dir string) (string, error) {
+	replacements := map[string]string{}
+	dirs, err := componentDirs(root)
+	if err != nil {
+		return "", err
+	}
+	for _, componentDir := range dirs {
+		err = filepath.WalkDir(componentDir, func(path string, entry os.DirEntry, err error) error {
+			if err == nil && entry.IsDir() && path != componentDir {
+				return filepath.SkipDir
+			}
+			if err != nil {
+				return err
+			}
+			if entry.IsDir() || !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+				return nil
+			}
+			fset := token.NewFileSet()
+			file, err := parser.ParseFile(fset, path, nil, parser.ParseComments)
+			if err != nil {
+				return err
+			}
+			type function struct {
+				typ  *ast.FuncType
+				body *ast.BlockStmt
+			}
+			var functions []function
+			ast.Inspect(file, func(node ast.Node) bool {
+				switch fn := node.(type) {
+				case *ast.FuncDecl:
+					if fn.Body != nil && fn.Name.Name != "init" {
+						functions = append(functions, function{fn.Type, fn.Body})
+					}
+				case *ast.FuncLit:
+					functions = append(functions, function{fn.Type, fn.Body})
+				}
+				return true
+			})
+			for _, fn := range functions {
+				body := &ast.BlockStmt{}
+				ret := &ast.ReturnStmt{}
+				if fn.typ.Results != nil {
+					for _, field := range fn.typ.Results.List {
+						count := len(field.Names)
+						if count == 0 {
+							count = 1
+						}
+						for i := 0; i < count; i++ {
+							name := ast.NewIdent(fmt.Sprintf("auditZero%d", len(ret.Results)))
+							body.List = append(body.List, &ast.DeclStmt{Decl: &ast.GenDecl{Tok: token.VAR, Specs: []ast.Spec{
+								&ast.ValueSpec{Names: []*ast.Ident{name}, Type: field.Type},
+							}}})
+							ret.Results = append(ret.Results, name)
+						}
+					}
+				}
+				body.List = append(body.List, ret)
+				fn.body.List = append([]ast.Stmt{&ast.IfStmt{Cond: ast.NewIdent("true"), Body: body}}, fn.body.List...)
+			}
+			var output bytes.Buffer
+			if err := format.Node(&output, fset, file); err != nil {
+				return err
+			}
+			replacement := filepath.Join(dir, fmt.Sprintf("editor-%d.go", len(replacements)))
+			if err := os.WriteFile(replacement, output.Bytes(), 0600); err != nil {
+				return err
+			}
+			replacements[path] = replacement
+			return nil
+		})
+		if err != nil {
+			return "", err
+		}
+	}
+	data, err := json.Marshal(map[string]any{"Replace": replacements})
+	if err != nil {
+		return "", err
+	}
+	path := filepath.Join(dir, "overlay.json")
+	return path, os.WriteFile(path, data, 0600)
+}
