+func TestF2PStableSpanCustomAttributes(t *testing.T) {
+	var first string
+	for i := 0; i < 128; i++ {
+		node := &ast.Node{Type: ast.NodeTextMark}
+		parent := &ast.Node{Type: ast.NodeParagraph}
+		parent.AppendChild(node)
+		parse.SetSpanIAL(node, p2pHtmlNode(t, `<span custom-z="z" custom-a="a" custom-m="m">hello</span>`))
+		for key, value := range map[string]string{"custom-z": "z", "custom-a": "a", "custom-m": "m"} {
+			if node.IALAttr(key) != value {
+				t.Fatalf("custom attribute %s lost or changed", key)
+			}
+		}
+		actual := string(parse.IAL2Tokens(node.KramdownIAL))
+		if i == 0 {
+			first = actual
+		} else if actual != first {
+			t.Fatalf("same span input produced different serialized attribute order: %q vs %q", first, actual)
+		}
+	}
+}
+func checkStableBlockCustomAttributes(t *testing.T, nodeType string) {
+	t.Helper()
+	wasTesting := ast.Testing
+	ast.Testing = true
+	defer func() { ast.Testing = wasTesting }()
+	input := `<div data-node-id="20060102150405-1a2b3c4" data-type="` + nodeType + `" data-subtype="h2" custom-z="z" custom-a="a" custom-m="m"><div contenteditable="true">hello</div></div>`
+	first := map[string]string{}
+	for i := 0; i < 128; i++ {
+		engine := lute.New()
+		outputs := map[string]string{"markdown": engine.BlockDOM2Md(input), "export": engine.BlockDOM2StdMd(input)}
+		for key, actual := range outputs {
+			if !strings.Contains(actual, "hello") {
+				t.Fatalf("%s dropped body text", key)
+			}
+			if key == "markdown" {
+				for _, attr := range []string{`custom-z="z"`, `custom-a="a"`, `custom-m="m"`} {
+					if strings.Count(actual, attr) != 1 {
+						t.Fatalf("%s missing, duplicate or changed in %q", attr, actual)
+					}
+				}
+			}
+			if i == 0 {
+				first[key] = actual
+			} else if actual != first[key] {
+				t.Fatalf("%s %s is nondeterministic: %q vs %q", nodeType, key, first[key], actual)
+			}
+		}
+	}
+}
+func TestF2PStableParagraphCustomAttributes(t *testing.T) {
+	checkStableBlockCustomAttributes(t, "NodeParagraph")
+}
+func TestF2PStableHeadingCustomAttributes(t *testing.T) {
+	checkStableBlockCustomAttributes(t, "NodeHeading")
+}
