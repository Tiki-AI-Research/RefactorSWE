+from __future__ import annotations
+
+import json
+import os
+import re
+import subprocess
+import sys
+from functools import lru_cache
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, '/tests/verifier')
+from candidate_runtime import run_go
+
+REPOSITORY = Path(__file__).resolve().parents[1]
+
+
+GO_TEST_GROUPS = {
+    "./verifier_tests": r"^Test",
+    "./verifier_tests_refactor": r"^Test",
+    "./verifier_architecture": r"^Test",
+    "./test": (
+        r"^(?:TestProtyleExportMd|TestSpinBlockDOM|TestMd2BlockDOM|"
+        r"TestInlineMd2BlockDOM|TestBlockDOM2StdMd|TestMd2VditorDOM|"
+        r"TestVditorDOM2Md|TestInlineMath)$"
+    ),
+}
+
+
+@lru_cache(maxsize=None)
+def _run_go_test_group(package: str) -> tuple[dict[str, str], str]:
+    env = os.environ.copy()
+    tmpdir = Path(env.get("TMPDIR", "/tmp"))
+    env["GOCACHE"] = str(tmpdir / "go-build-cache")
+    try:
+        completed = run_go(
+            ["go", "test", "-json", package, "-run", GO_TEST_GROUPS[package], "-count=1"],
+            cwd=REPOSITORY, env=env, text=True, stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT, timeout=240, check=False,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        pytest.skip(f"Go test infrastructure unavailable: {exc}")
+
+    statuses: dict[str, str] = {}
+    for line in completed.stdout.splitlines():
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        name = event.get("Test")
+        action = event.get("Action")
+        if name and action in {"pass", "fail", "skip"}:
+            statuses[name] = action
+    return statuses, completed.stdout
+
+
+@lru_cache(maxsize=None)
+def _run_go_test_single(package: str, test_name: str) -> tuple[str | None, str]:
+    env = os.environ.copy()
+    tmpdir = Path(env.get("TMPDIR", "/tmp"))
+    env["GOCACHE"] = str(tmpdir / "go-build-cache")
+    try:
+        completed = run_go(
+            ["go", "test", "-json", package, "-run", f"^{test_name}$", "-count=1"],
+            cwd=REPOSITORY, env=env, text=True, stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT, timeout=240, check=False,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        pytest.skip(f"Go test infrastructure unavailable: {exc}")
+
+    for line in completed.stdout.splitlines():
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if event.get("Test") == test_name and event.get("Action") in {"pass", "fail", "skip"}:
+            return str(event["Action"]), completed.stdout
+    return None, completed.stdout
+
+
+def go_test(name_or_package: str, expression: str | None = None) -> None:
+    if expression is None:
+        # F2P nodes live in the refactor-only package so the baseline-compatible
+        # P2P package still compiles before the editor AST module exists.
+        package = "./verifier_tests_refactor"
+    elif name_or_package.startswith("./verifier_tests/"):
+        package = "./verifier_tests"
+    else:
+        package = name_or_package
+    test_name = (
+        re.fullmatch(r"\^([A-Za-z0-9_]+)\$", expression).group(1)
+        if expression is not None
+        else name_or_package
+    )
+    statuses, group_output = _run_go_test_group(package)
+    if test_name in statuses:
+        status, output = statuses[test_name], group_output
+    else:
+        # An unrecovered panic aborts the shared `go test` binary, so any test
+        # ordered after the panicking test never emits a status. Re-run this
+        # node in isolation so a single panic cannot cascade into false
+        # failures for the nodes that follow it.
+        status, output = _run_go_test_single(package, test_name)
+    if status is None or status == "skip":
+        pytest.skip(f"Go test did not produce a completed result: {test_name}\n{output}")
+    if status != "pass":
+        pytest.fail(f"{test_name} did not pass:\n{output}")
+
