+func requireDelegation(t *testing.T, name, probe string) {
+	t.Helper()
+	cmd := exec.Command("go", "test", "-count=1", "./verifier_tests", "./verifier_tests_refactor", "-run", "^"+probe+"$")
+	cmd.Dir = repository(t)
+	output, err := boundedInlineGo(cmd.Dir, os.Environ(), cmd.Args[1:]...)
+	if err != nil {
+		t.Fatalf("public contract probe failed: %v\n%s", err, output)
+	}
+	disabledEditor.Do(func() {
+		dir, err := os.MkdirTemp("", "lute-editor-intervention-")
+		if err != nil {
+			disabledEditor.err = err
+			return
+		}
+		disabledEditor.dir = dir
+		disabledEditor.path, disabledEditor.err = editorOverlay(repository(t), dir)
+		if disabledEditor.err != nil {
+			return
+		}
+		cmd := exec.Command("go", "test", "-vet=off", "-overlay", disabledEditor.path, "./verifier_tests", "./verifier_tests_refactor", "-run", "^$")
+		cmd.Dir = repository(t)
+		if out, err := boundedInlineGo(cmd.Dir, os.Environ(), cmd.Args[1:]...); err != nil {
+			disabledEditor.err = fmt.Errorf("editor intervention cannot compile: %v: %s", err, out)
+		}
+	})
+	if disabledEditor.err != nil {
+		t.Fatal(disabledEditor.err)
+	}
+	cmd = exec.Command("go", "test", "-json", "-vet=off", "-count=1", "-overlay", disabledEditor.path, "./verifier_tests", "./verifier_tests_refactor", "-run", "^"+probe+"$")
+	cmd.Dir = repository(t)
+	output, err = boundedInlineGo(cmd.Dir, os.Environ(), cmd.Args[1:]...)
+	for _, line := range bytes.Split(output, []byte("\n")) {
+		var event struct{ Test, Action string }
+		if json.Unmarshal(line, &event) == nil && event.Test == probe && event.Action == "fail" {
+			return
+		}
+	}
+	t.Fatalf("parse.%s contract survives disabled editor transformations (or probe did not complete): %v\n%s", name, err, output)
+}
