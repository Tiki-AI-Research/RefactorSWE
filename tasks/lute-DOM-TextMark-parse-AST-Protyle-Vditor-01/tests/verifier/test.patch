+package verifier_tests_refactor
+
+import (
+	intervention "github.com/88250/lute/verifier_intervention"
+	"os"
+	"testing"
+
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/parse"
+)
+
+func TestInlineTextMarkConversion(t *testing.T) {
+	hit := intervention.Observe([]string{"textmark"}, func() {
+		tree := parse.Inline("", []byte(`<span data-type="a" data-href="/target">label</span>`), &parse.Options{
+			ProtyleWYSIWYG:   true,
+			HTMLTag2TextMark: true,
+		})
+		if tree == nil || tree.Root == nil || tree.Root.FirstChild == nil || tree.Root.FirstChild.FirstChild == nil {
+			t.Fatal("inline text-mark conversion produced no node")
+		}
+		node := tree.Root.FirstChild.FirstChild
+		if node.Type != ast.NodeTextMark || node.TextMarkType != "a" || node.TextMarkAHref != "/target" {
+			t.Fatalf("unexpected inline text-mark conversion: type=%v mark=%q href=%q", node.Type, node.TextMarkType, node.TextMarkAHref)
+		}
+	})
+	if hit {
+		t.Run("VerifiedIntervention_"+os.Getenv("LUTE_INTERVENTION_KIND")+"_"+os.Getenv("LUTE_INTERVENTION_NONCE"), func(t *testing.T) {})
+	}
+}
+
+func TestInlineImageConversion(t *testing.T) {
+	hit := intervention.Observe([]string{"image-node", "image-style"}, func() {
+		tree := parse.Inline("", []byte(`<img alt="alt" src="/target" width="12">`), &parse.Options{
+			ProtyleWYSIWYG:   true,
+			HTMLTag2TextMark: true,
+		})
+		if tree == nil || tree.Root == nil || tree.Root.FirstChild == nil || tree.Root.FirstChild.FirstChild == nil {
+			t.Fatal("inline image conversion produced no node")
+		}
+		node := tree.Root.FirstChild.FirstChild
+		if node.Type != ast.NodeImage || node.IALAttr("style") != "width: 12px;" {
+			t.Fatalf("unexpected inline image conversion: type=%v style=%q", node.Type, node.IALAttr("style"))
+		}
+	})
+	if hit {
+		t.Run("VerifiedIntervention_"+os.Getenv("LUTE_INTERVENTION_KIND")+"_"+os.Getenv("LUTE_INTERVENTION_NONCE"), func(t *testing.T) {})
+	}
+}
