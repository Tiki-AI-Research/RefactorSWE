+package verifier_tests
+
+import (
+	_ "embed"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/88250/lute"
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/parse"
+)
+
+//go:embed linkref_fixture.json
+var linkrefFixture []byte
+
+func contractSnapshot(n *ast.Node) any {
+	if n == nil {
+		return nil
+	}
+	b, err := json.Marshal(n)
+	if err != nil {
+		panic(err)
+	}
+	m := map[string]any{}
+	if err = json.Unmarshal(b, &m); err != nil {
+		panic(err)
+	}
+	m["Type"] = n.Type.String()
+	m["Data"] = string(n.Tokens)
+	children := []any{}
+	for c := n.FirstChild; c != nil; c = c.Next {
+		children = append(children, contractSnapshot(c))
+	}
+	m["Children"] = children
+	return m
+}
+
+func checkLinkReferenceFlatten(t *testing.T, hybrid bool) {
+	t.Helper()
+	wasTesting := ast.Testing
+	ast.Testing = true
+	defer func() { ast.Testing = wasTesting }()
+	var fixtures map[string]any
+	if err := json.Unmarshal(linkrefFixture, &fixtures); err != nil {
+		t.Fatal(err)
+	}
+	for _, editor := range []bool{false, true} {
+		for _, export := range []bool{false, true} {
+			options := parse.NewOptions()
+			options.ProtyleWYSIWYG = editor
+			options.HTMLTag2TextMark = editor
+			tree := parse.Parse("audit", []byte("[link][ref]\n\n[ref]: https://example.test \"title\""), options)
+			root := tree.Root
+			if hybrid {
+				parse.NestedInlines2FlattedSpansHybrid(tree, export)
+			} else {
+				parse.NestedInlines2FlattedSpans(tree, export)
+			}
+			if tree.Root != root {
+				t.Fatal("flatten replaced the caller's root")
+			}
+			key := fmt.Sprintf("editor=%v/hybrid=%v/export=%v", editor, hybrid, export)
+			expected, ok := fixtures[key]
+			if !ok {
+				t.Fatalf("missing frozen baseline observation %s", key)
+			}
+			actual := contractSnapshot(root)
+			if !reflect.DeepEqual(actual, expected) {
+				a, _ := json.Marshal(actual)
+				e, _ := json.Marshal(expected)
+				t.Errorf("link-reference AST changed for %s\nactual=%s\nexpected=%s", key, a, e)
+			}
+		}
+	}
+}
+func TestP2PRegularLinkReferenceAST(t *testing.T) { checkLinkReferenceFlatten(t, false) }
+func TestP2PHybridLinkReferenceAST(t *testing.T)  { checkLinkReferenceFlatten(t, true) }
