+++ b/verifier_tests_refactor/refactor_behavior_test.go
@@ -0,0 +1,176 @@
+package verifier_tests_refactor
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/parse"
+)
+
+func documentWithParagraph() (*ast.Node, *ast.Node) {
+	root := &ast.Node{Type: ast.NodeDocument}
+	paragraph := &ast.Node{Type: ast.NodeParagraph}
+	root.AppendChild(paragraph)
+	return root, paragraph
+}
+
+func inline(typ, contentType ast.NodeType, content string) *ast.Node {
+	node := &ast.Node{Type: typ}
+	node.AppendChild(&ast.Node{Type: contentType, Tokens: []byte(content)})
+	return node
+}
+
+func TestRegularFlattenSemantics(t *testing.T) {
+	root, paragraph := documentWithParagraph()
+	strong := &ast.Node{Type: ast.NodeStrong, KramdownIAL: [][]string{{"color", "red"}}}
+	strong.AppendChild(inline(ast.NodeEmphasis, ast.NodeText, `a "quote" & b`))
+	paragraph.AppendChild(strong)
+	parse.NestedInlines2FlattedSpans(&parse.Tree{Root: root}, false)
+	mark := paragraph.FirstChild
+	if mark == nil || mark != paragraph.LastChild || mark.Type != ast.NodeTextMark ||
+		mark.TextMarkType != "strong em" || mark.TextMarkTextContent != `a &quot;quote&quot; &amp; b` ||
+		mark.IALAttr("color") != "red" {
+		t.Fatalf("regular flatten semantics changed: type=%v marks=%q content=%q", mark.Type, mark.TextMarkType, mark.TextMarkTextContent)
+	}
+}
+
+func TestHybridFlattenSemantics(t *testing.T) {
+	root, paragraph := documentWithParagraph()
+	strong := &ast.Node{Type: ast.NodeStrong}
+	strong.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "em strong text a", TextMarkTextContent: "content", TextMarkAHref: "https://b3log.org"})
+	paragraph.AppendChild(strong)
+	parse.NestedInlines2FlattedSpansHybrid(&parse.Tree{Root: root}, false)
+	mark := paragraph.FirstChild
+	if mark == nil || mark.Type != ast.NodeTextMark || mark.TextMarkType != "strong em a" || mark.TextMarkAHref != "https://b3log.org" {
+		t.Fatalf("hybrid flatten semantics changed: type=%v marks=%q href=%q", mark.Type, mark.TextMarkType, mark.TextMarkAHref)
+	}
+}
+
+func tableMathTree() (*ast.Node, *ast.Node) {
+	root := &ast.Node{Type: ast.NodeDocument}
+	cell := &ast.Node{Type: ast.NodeTableCell}
+	root.AppendChild(cell)
+	cell.AppendChild(inline(ast.NodeInlineMath, ast.NodeInlineMathContent, `a\|b`))
+	return root, cell
+}
+
+func TestTableMathNormal(t *testing.T) {
+	root, cell := tableMathTree()
+	parse.NestedInlines2FlattedSpans(&parse.Tree{Root: root}, false)
+	if got := cell.FirstChild.TextMarkInlineMathContent; got != "a|b" {
+		t.Fatalf("normal table math escaping changed: %q", got)
+	}
+}
+
+func TestTableMathExport(t *testing.T) {
+	root, cell := tableMathTree()
+	parse.NestedInlines2FlattedSpans(&parse.Tree{Root: root}, true)
+	if got := cell.FirstChild.TextMarkInlineMathContent; got != `a\|b` {
+		t.Fatalf("export table math escaping changed: %q", got)
+	}
+}
+
+func TestNormalBlockRefFields(t *testing.T) {
+	root, paragraph := documentWithParagraph()
+	ref := &ast.Node{Type: ast.NodeBlockRef}
+	ref.AppendChild(&ast.Node{Type: ast.NodeBlockRefID, Tokens: []byte("20260913000000-abcdefg")})
+	ref.AppendChild(&ast.Node{Type: ast.NodeBlockRefDynamicText, Tokens: []byte("label")})
+	paragraph.AppendChild(ref)
+	parse.NestedInlines2FlattedSpans(&parse.Tree{Root: root}, false)
+	mark := paragraph.FirstChild
+	if mark == nil || mark.TextMarkType != "block-ref" || mark.TextMarkBlockRefID != "20260913000000-abcdefg" ||
+		mark.TextMarkBlockRefSubtype != "d" || mark.TextMarkTextContent != "label" {
+		t.Fatalf("normal block-ref fields changed: %#v", mark)
+	}
+}
+
+func TestNilRegularRoot(t *testing.T) { parse.NestedInlines2FlattedSpans(nil, false) }
+func TestNilHybridRoot(t *testing.T)  { parse.NestedInlines2FlattedSpansHybrid(nil, false) }
+
+func TestMalformedBlockRefIDSafe(t *testing.T) {
+	root, paragraph := documentWithParagraph()
+	before := &ast.Node{Type: ast.NodeText, Tokens: []byte("before")}
+	id := &ast.Node{Type: ast.NodeBlockRefID, Tokens: []byte("broken")}
+	after := &ast.Node{Type: ast.NodeText, Tokens: []byte("after")}
+	paragraph.AppendChild(before)
+	paragraph.AppendChild(id)
+	paragraph.AppendChild(after)
+	parse.NestedInlines2FlattedSpans(&parse.Tree{Root: root}, false)
+	if paragraph.FirstChild != before || before.Next != id || id.Previous != before || id.Next != after || after.Previous != id || paragraph.LastChild != after || id.Parent != paragraph {
+		t.Fatal("malformed block-ref ID partially changed tree links")
+	}
+}
+
+func TestMalformedBlockRefSafe(t *testing.T) {
+	root, paragraph := documentWithParagraph()
+	before := &ast.Node{Type: ast.NodeText, Tokens: []byte("before")}
+	ref := &ast.Node{Type: ast.NodeBlockRef}
+	after := &ast.Node{Type: ast.NodeText, Tokens: []byte("after")}
+	paragraph.AppendChild(before)
+	paragraph.AppendChild(ref)
+	paragraph.AppendChild(after)
+	parse.NestedInlines2FlattedSpans(&parse.Tree{Root: root}, false)
+	if paragraph.FirstChild != before || before.Next != after || after.Previous != before || paragraph.LastChild != after {
+		t.Fatal("malformed block-ref damaged surrounding siblings")
+	}
+}
+
+func TestStyleValueNormalization(t *testing.T) {
+	for _, space := range []string{" ", "\t", "\r", "\v", "\f", "\u0085", "\u00a0", "\u1680", "\u2000", "\u2003", "\u2028", "\u2029", "\u202f", "\u205f", "\u3000"} {
+		for _, input := range []string{space + "color:" + space + "red" + space, "font:" + space + space + "12px", space, "a\nb" + space + "c"} {
+			want := strings.Join(strings.Fields(strings.ReplaceAll(strings.TrimSpace(input), "\n", "")), " ")
+			if got := parse.StyleValue(input); got != want {
+				t.Fatalf("StyleValue(%q)=%q, want %q", input, got, want)
+			}
+		}
+	}
+}
+
+func TestContainTextMark(t *testing.T) {
+	node := &ast.Node{Type: ast.NodeTextMark, TextMarkType: "block-ref a"}
+	if !parse.ContainTextMark(node, "a") || !parse.ContainTextMark(node, "strong", "block-ref") || parse.ContainTextMark(node, "strong") || parse.ContainTextMark(nil, "a") {
+		t.Fatal("ContainTextMark contract changed")
+	}
+}
+
+func TestTagAttributeContract(t *testing.T) {
+	valid, rest, _, name, val := parse.TagAttr([]byte(` title="a b" tail`))
+	if !valid || string(rest) != " tail" || string(name) != "title" || string(val) != "a b" {
+		t.Fatalf("attribute contract: %v %q %q %q", valid, rest, name, val)
+	}
+}
+func TestAttributeNameContract(t *testing.T) {
+	valid, _, _, name, _ := parse.TagAttr([]byte(` data-custom_1="value"`))
+	if !valid || string(name) != "data-custom_1" {
+		t.Fatalf("attribute name: %v %q", valid, name)
+	}
+}
+func TestAttributeValueContract(t *testing.T) {
+	valid, _, _, _, val := parse.TagAttr([]byte(` key='a b'`))
+	if !valid || string(val) != "a b" {
+		t.Fatalf("attribute value: %v %q", valid, val)
+	}
+}
+
+func TestConcurrentInvocationIsolation(t *testing.T) {
+	for i := 0; i < 16; i++ {
+		t.Run(fmt.Sprint(i), func(t *testing.T) {
+			t.Parallel()
+			for j := 0; j < 20; j++ {
+				root, p := documentWithParagraph()
+				p.AppendChild(inline(ast.NodeStrong, ast.NodeText, "isolated"))
+				parse.NestedInlines2FlattedSpans(&parse.Tree{Root: root}, j%2 == 0)
+				if p.FirstChild.Type != ast.NodeTextMark || p.FirstChild.TextMarkTextContent != "isolated" {
+					t.Fatal("cross-call tree contamination")
+				}
+			}
+		})
+	}
+}
+
+func TestNilRegularTreeRoot(t *testing.T) { parse.NestedInlines2FlattedSpans(&parse.Tree{}, false) }
+func TestNilHybridTreeRoot(t *testing.T) {
+	parse.NestedInlines2FlattedSpansHybrid(&parse.Tree{}, false)
+}
