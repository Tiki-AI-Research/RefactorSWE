+func requireEditorOwnsFlatten(t *testing.T, probe string) {
+	t.Helper()
+	parserIntervention.Do(func() {
+		dir, err := os.MkdirTemp("", "lute-parser-intervention-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		parserIntervention.path = parserMutationOverlay(t, repository(t), dir)
+	})
+	if parserIntervention.path == "" {
+		t.Fatal("parser intervention failed to initialize")
+	}
+	cmd := exec.Command("go", "test", "-json", "-vet=off", "-count=1", "-overlay", parserIntervention.path, "./verifier_tests_refactor", "-run", "^"+probe+"$")
+	cmd.Dir = repository(t)
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("flattening still needs parser-owned AST construction or mutation: %v\n%s", err, output)
+	}
+	for _, line := range bytes.Split(output, []byte("\n")) {
+		var event struct{ Test, Action string }
+		if json.Unmarshal(line, &event) == nil && event.Test == probe && event.Action == "pass" {
+			return
+		}
+	}
+	t.Fatalf("ownership probe did not run: %s", output)
+}
+func TestRegularFlattenOwnedByEditor(t *testing.T) {
+	requireEditorOwnsFlatten(t, "TestRegularFlattenSemantics")
+}
+func TestHybridFlattenOwnedByEditor(t *testing.T) {
+	requireEditorOwnsFlatten(t, "TestHybridFlattenSemantics")
+}
+
+// Effects are propagated to a fixed point through local helper/receiver calls.
+// An address used only for reading does not constitute retained invocation state.
+func globalAddress(e ast.Expr, base func(ast.Expr) bool) bool {
+	if u, ok := e.(*ast.UnaryExpr); ok && u.Op == token.AND {
+		return globalAddress(u.X, base)
+	}
+	if p, ok := e.(*ast.ParenExpr); ok {
+		return globalAddress(p.X, base)
+	}
+	return base(e)
+}
+func effectCall(c *ast.CallExpr) (string, []ast.Expr) {
+	if id, ok := c.Fun.(*ast.Ident); ok {
+		return id.Name, c.Args
+	}
+	if sel, ok := c.Fun.(*ast.SelectorExpr); ok {
+		return sel.Sel.Name, append([]ast.Expr{sel.X}, c.Args...)
+	}
+	return "", nil
+}
+func packageEffects(pkg *ast.Package) map[string]map[int]bool {
+	effects := map[string]map[int]bool{}
+	funcs := []*ast.FuncDecl{}
+	for _, f := range pkg.Files {
+		for _, d := range f.Decls {
+			if fn, ok := d.(*ast.FuncDecl); ok && fn.Body != nil {
+				funcs = append(funcs, fn)
+				if effects[fn.Name.Name] == nil {
+					effects[fn.Name.Name] = map[int]bool{}
+				}
+			}
+		}
+	}
+	for changed := true; changed; {
+		changed = false
+		for _, fn := range funcs {
+			origins := map[*ast.Object]map[int]bool{}
+			index := 0
+			add := func(fields *ast.FieldList) {
+				if fields != nil {
+					for _, field := range fields.List {
+						for _, id := range field.Names {
+							origins[id.Obj] = map[int]bool{index: true}
+							index++
+						}
+					}
+				}
+			}
+			add(fn.Recv)
+			add(fn.Type.Params)
+			var sources func(ast.Expr) map[int]bool
+			sources = func(e ast.Expr) map[int]bool {
+				switch x := e.(type) {
+				case *ast.Ident:
+					return origins[x.Obj]
+				case *ast.SelectorExpr:
+					return sources(x.X)
+				case *ast.IndexExpr:
+					return sources(x.X)
+				case *ast.SliceExpr:
+					return sources(x.X)
+				case *ast.StarExpr:
+					return sources(x.X)
+				case *ast.UnaryExpr:
+					return sources(x.X)
+				case *ast.ParenExpr:
+					return sources(x.X)
+				}
+				return nil
+			}
+			mark := func(e ast.Expr) {
+				for i := range sources(e) {
+					if !effects[fn.Name.Name][i] {
+						effects[fn.Name.Name][i] = true
+						changed = true
+					}
+				}
+			}
+			for again := true; again; {
+				again = false
+				ast.Inspect(fn.Body, func(n ast.Node) bool {
+					if a, ok := n.(*ast.AssignStmt); ok {
+						for i, lhs := range a.Lhs {
+							if i >= len(a.Rhs) {
+								continue
+							}
+							if id, ok := lhs.(*ast.Ident); ok && id.Obj != nil {
+								if origins[id.Obj] == nil {
+									origins[id.Obj] = map[int]bool{}
+								}
+								for k := range sources(a.Rhs[i]) {
+									if !origins[id.Obj][k] {
+										origins[id.Obj][k] = true
+										again = true
+									}
+								}
+							}
+						}
+					}
+					return true
+				})
+			}
+			ast.Inspect(fn.Body, func(n ast.Node) bool {
+				switch x := n.(type) {
+				case *ast.AssignStmt:
+					for _, lhs := range x.Lhs {
+						if _, local := lhs.(*ast.Ident); !local {
+							mark(lhs)
+						}
+					}
+				case *ast.IncDecStmt:
+					if _, local := x.X.(*ast.Ident); !local {
+						mark(x.X)
+					}
+				case *ast.CallExpr:
+					name, args := effectCall(x)
+					for i, arg := range args {
+						if effects[name][i] {
+							mark(arg)
+						}
+					}
+					if (name == "copy" || name == "delete" || name == "clear") && len(x.Args) > 0 {
+						mark(x.Args[0])
+					}
+				}
+				return true
+			})
+		}
+	}
+	return effects
+}
+
+// F2P-026 follows value producers across the parser/editor boundary.
+func TestNoParserTextMarkConversion(t *testing.T) {
+	root := repository(t)
+	dirs, err := componentDirs(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	issues, err := parserTextMarkIssues(root, dirs)
+	if err != nil {
+		t.Fatalf("TextMark ownership analysis unavailable: %v", err)
+	}
+	for _, issue := range issues {
+		t.Error(issue)
+	}
+}
diff --git a/verifier_architecture/style_ownership_test.go b/verifier_architecture/style_ownership_test.go
new file mode 100644
index 0000000..119658b
--- /dev/null
+++ b/verifier_architecture/style_ownership_test.go
@@ -0,0 +1,145 @@
+package verifier_architecture
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/build"
+	"go/format"
+	"go/parser"
+	"go/token"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Probe private as well as public helpers with the editor disabled. An unused
+// parser copy still normalizes the corpus; a forwarding helper cannot do so.
+func TestNoParserStyleConversion(t *testing.T) {
+	root, dir := repository(t), t.TempDir()
+	overlay, err := editorOverlay(root, dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(overlay)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var mapping struct{ Replace map[string]string }
+	if err := json.Unmarshal(data, &mapping); err != nil {
+		t.Fatal(err)
+	}
+	paths, err := filepath.Glob(filepath.Join(root, "parse", "*.go"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	encode := func(fn *ast.FuncDecl) string {
+		var b bytes.Buffer
+		if err := format.Node(&b, token.NewFileSet(), fn); err != nil {
+			t.Fatal(err)
+		}
+		return b.String()
+	}
+	baseline := map[string]bool{}
+	for _, path := range paths {
+		old, err := exec.Command("git", "-C", root, "show", "8928f1866da3269aed613288afb3554985df94e1:parse/"+filepath.Base(path)).Output()
+		if err != nil {
+			continue
+		}
+		f, err := parser.ParseFile(token.NewFileSet(), path, old, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, decl := range f.Decls {
+			if fn, ok := decl.(*ast.FuncDecl); ok && fn.Name.Name != "StyleValue" {
+				baseline[encode(fn)] = true
+			}
+		}
+	}
+	stringField := func(fields *ast.FieldList) bool {
+		if fields == nil || len(fields.List) != 1 || len(fields.List[0].Names) > 1 {
+			return false
+		}
+		id, ok := fields.List[0].Type.(*ast.Ident)
+		return ok && id.Name == "string"
+	}
+	var source strings.Builder
+	source.WriteString("package parse\nimport \"testing\"\nfunc TestVerifierStyleOwnership(t *testing.T) {\n")
+	for _, path := range paths {
+		matched, err := build.Default.MatchFile(filepath.Dir(path), filepath.Base(path))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !matched || strings.HasSuffix(path, "_test.go") {
+			continue
+		}
+		f, err := parser.ParseFile(token.NewFileSet(), path, nil, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, decl := range f.Decls {
+			fn, ok := decl.(*ast.FuncDecl)
+			if !ok || fn.Body == nil || !stringField(fn.Type.Params) || !stringField(fn.Type.Results) || baseline[encode(fn)] {
+				continue
+			}
+			call := fn.Name.Name
+			if fn.Recv != nil {
+				receiver := fn.Recv.List[0].Type
+				if pointer, ok := receiver.(*ast.StarExpr); ok {
+					receiver = pointer.X
+				}
+				name, ok := receiver.(*ast.Ident)
+				if !ok {
+					// Generic receivers need concrete type arguments before invocation.
+					continue
+				}
+				// A fresh receiver avoids requiring constructors or retained state.
+				// Pointer method sets also include methods with value receivers.
+				call = "new(" + name.Name + ")." + fn.Name.Name
+			}
+			fmt.Fprintf(&source, "t.Run(%q, func(t *testing.T) {\n", call)
+			source.WriteString("matches := true\nfunc() { defer func() { if recover() != nil { matches = false } }()\n")
+			for _, sample := range []struct{ input, want string }{
+				{" color: red; ", "color: red;"},
+				{"color:\nred", "color:red"},
+				{" \tfont-size:  12px;\tcolor: blue;\n ", "font-size: 12px; color: blue;"},
+				{"a\r\nb\tc", "a b c"},
+				{"\u2003color:\u00a0red\u3000", "color: red"},
+				{"\n\t ", ""},
+			} {
+				fmt.Fprintf(&source, "if %s(%q) != %q { matches = false; return }\n", call, sample.input, sample.want)
+			}
+			source.WriteString("}()\nif matches { t.Fatal(\"parser retains editor style normalization without editor implementation\") }\n})\n")
+		}
+	}
+	source.WriteString("}\n")
+	probe := filepath.Join(dir, "style_probe_test.go")
+	if err := os.WriteFile(probe, []byte(source.String()), 0600); err != nil {
+		t.Fatal(err)
+	}
+	// Overlay an existing same-package test file so private helpers are callable.
+	mapping.Replace[filepath.Join(root, "parse", "inline_attribute_list_test.go")] = probe
+	data, err = json.Marshal(mapping)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(overlay, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "test", "-json", "-vet=off", "-count=1", "-overlay", overlay, "./parse", "-run", "^TestVerifierStyleOwnership$")
+	cmd.Dir = root
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("parser style ownership: %v\n%s", err, out)
+	}
+	for _, line := range bytes.Split(out, []byte("\n")) {
+		var event struct{ Test, Action string }
+		if json.Unmarshal(line, &event) == nil && event.Test == "TestVerifierStyleOwnership" && event.Action == "pass" {
+			return
+		}
+	}
+	t.Fatalf("style ownership probe did not run: %s", out)
+}
diff --git a/verifier_tests/p2p_behavior_test.go b/verifier_tests/p2p_behavior_test.go
new file mode 100644
index 0000000..ffdf20b
--- /dev/null
+++ b/verifier_tests/p2p_behavior_test.go
@@ -0,0 +1,371 @@
+package verifier_tests
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/88250/lute"
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/html"
+	"github.com/88250/lute/parse"
+)
+
+var (
+	_ func(*parse.Tree, bool) = parse.NestedInlines2FlattedSpansHybrid
+	_ func(*parse.Tree, bool) = parse.NestedInlines2FlattedSpans
+	_ func(*parse.Tree)       = parse.TextMarks2Inlines
+)
+
+func treeWithParagraph() (*parse.Tree, *ast.Node) {
+	root := &ast.Node{Type: ast.NodeDocument}
+	paragraph := &ast.Node{Type: ast.NodeParagraph}
+	root.AppendChild(paragraph)
+	return &parse.Tree{Root: root, Context: &parse.Context{ParseOption: parse.NewOptions()}}, paragraph
+}
+
+func containerWithText(typ ast.NodeType, textType ast.NodeType, content string) *ast.Node {
+	container := &ast.Node{Type: typ}
+	container.AppendChild(&ast.Node{Type: textType, Tokens: []byte(content)})
+	return container
+}
+
+func TestP2PPublicAPIAndInPlaceMutation(t *testing.T) {
+	tree, paragraph := treeWithParagraph()
+	root := tree.Root
+	unrelated := &ast.Node{Type: ast.NodeText, Tokens: []byte("untouched")}
+	paragraph.AppendChild(unrelated)
+	paragraph.AppendChild(containerWithText(ast.NodeStrong, ast.NodeText, "changed"))
+	parse.NestedInlines2FlattedSpans(tree, false)
+	if tree.Root != root || paragraph.FirstChild != unrelated || unrelated.TokensStr() != "untouched" {
+		t.Fatal("public transformation did not preserve the supplied tree")
+	}
+	mark := unrelated.Next
+	if mark == nil || mark.Type != ast.NodeTextMark || mark.TextMarkType != "strong" || mark.TextMarkTextContent != "changed" {
+		t.Fatalf("public entry point did not mutate the target in place: %#v", mark)
+	}
+}
+
+func assertP2PTag(t *testing.T, typ, textType ast.NodeType, expected string) {
+	t.Helper()
+	tree, paragraph := treeWithParagraph()
+	paragraph.AppendChild(containerWithText(typ, textType, "value"))
+	parse.NestedInlines2FlattedSpansHybrid(tree, false)
+	mark := paragraph.FirstChild
+	if mark == nil || mark.Type != ast.NodeTextMark || mark.TextMarkType != expected {
+		t.Fatalf("tag mapping %q was not preserved: %#v", expected, mark)
+	}
+}
+
+func TestP2PCodeSpanMapping(t *testing.T) {
+	assertP2PTag(t, ast.NodeCodeSpan, ast.NodeCodeSpanContent, "code")
+}
+func TestP2PTagMapping(t *testing.T) { assertP2PTag(t, ast.NodeTag, ast.NodeText, "tag") }
+func TestP2PInlineMathMapping(t *testing.T) {
+	assertP2PTag(t, ast.NodeInlineMath, ast.NodeInlineMathContent, "inline-math")
+}
+func TestP2PEmphasisMapping(t *testing.T) { assertP2PTag(t, ast.NodeEmphasis, ast.NodeText, "em") }
+func TestP2PStrongMapping(t *testing.T)   { assertP2PTag(t, ast.NodeStrong, ast.NodeText, "strong") }
+func TestP2PStrikethroughMapping(t *testing.T) {
+	assertP2PTag(t, ast.NodeStrikethrough, ast.NodeText, "s")
+}
+func TestP2PMarkMapping(t *testing.T)      { assertP2PTag(t, ast.NodeMark, ast.NodeText, "mark") }
+func TestP2PUnderlineMapping(t *testing.T) { assertP2PTag(t, ast.NodeUnderline, ast.NodeText, "u") }
+func TestP2PSubMapping(t *testing.T)       { assertP2PTag(t, ast.NodeSub, ast.NodeText, "sub") }
+func TestP2PSupMapping(t *testing.T)       { assertP2PTag(t, ast.NodeSup, ast.NodeText, "sup") }
+func TestP2PKbdMapping(t *testing.T)       { assertP2PTag(t, ast.NodeKbd, ast.NodeText, "kbd") }
+func TestP2PLinkMapping(t *testing.T)      { assertP2PTag(t, ast.NodeLink, ast.NodeLinkText, "a") }
+
+func TestP2PNestedHierarchy(t *testing.T) {
+	tree, paragraph := treeWithParagraph()
+	strong := &ast.Node{Type: ast.NodeStrong}
+	em := &ast.Node{Type: ast.NodeEmphasis}
+	em.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "em text u", TextMarkTextContent: "nested"})
+	strong.AppendChild(em)
+	paragraph.AppendChild(strong)
+	parse.NestedInlines2FlattedSpansHybrid(tree, false)
+	if paragraph.FirstChild.TextMarkType != "strong em u" {
+		t.Fatalf("outer-to-inner hierarchy changed: %q", paragraph.FirstChild.TextMarkType)
+	}
+}
+
+func TestP2PInlineAttributes(t *testing.T) {
+	tree, paragraph := treeWithParagraph()
+	strong := &ast.Node{Type: ast.NodeStrong, KramdownIAL: [][]string{{"style", "color: red"}}}
+	strong.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte("value")})
+	paragraph.AppendChild(strong)
+	parse.NestedInlines2FlattedSpansHybrid(tree, false)
+	if !reflect.DeepEqual(paragraph.FirstChild.KramdownIAL, [][]string{{"style", "color: red"}}) {
+		t.Fatalf("inline attributes were not retained: %#v", paragraph.FirstChild.KramdownIAL)
+	}
+}
+
+func TestP2PLinkMetadata(t *testing.T) {
+	tree, paragraph := treeWithParagraph()
+	link := &ast.Node{Type: ast.NodeLink}
+	link.AppendChild(&ast.Node{Type: ast.NodeOpenBracket})
+	link.AppendChild(&ast.Node{Type: ast.NodeLinkText, Tokens: []byte("Lute")})
+	link.AppendChild(&ast.Node{Type: ast.NodeCloseBracket})
+	link.AppendChild(&ast.Node{Type: ast.NodeOpenParen})
+	link.AppendChild(&ast.Node{Type: ast.NodeLinkDest, Tokens: []byte("https://b3log.org/lute")})
+	link.AppendChild(&ast.Node{Type: ast.NodeLinkSpace, Tokens: []byte(" ")})
+	link.AppendChild(&ast.Node{Type: ast.NodeLinkTitle, Tokens: []byte("title")})
+	link.AppendChild(&ast.Node{Type: ast.NodeCloseParen})
+	paragraph.AppendChild(link)
+	parse.NestedInlines2FlattedSpans(tree, false)
+	mark := paragraph.FirstChild
+	if mark == nil || mark.TextMarkType != "a" || mark.TextMarkAHref != "https://b3log.org/lute" || mark.TextMarkATitle != "title" {
+		t.Fatalf("link metadata changed: %#v", mark)
+	}
+}
+
+func assertP2PTextMark(t *testing.T, markType string, nodeType, openType, closeType ast.NodeType) {
+	t.Helper()
+	tree, paragraph := treeWithParagraph()
+	mark := &ast.Node{Type: ast.NodeTextMark, TextMarkType: markType, TextMarkTextContent: "*nested* text"}
+	paragraph.AppendChild(mark)
+	parse.TextMarks2Inlines(tree)
+	if mark.Type != nodeType || mark.FirstChild == nil || mark.FirstChild.Type != openType || mark.LastChild == nil || mark.LastChild.Type != closeType {
+		t.Fatalf("marker boundary changed for %q: %#v", markType, mark)
+	}
+	if inner := mark.FirstChild.Next; inner == nil || inner.Type != ast.NodeEmphasis || inner.Next == nil || inner.Next.TokensStr() != " text" {
+		t.Fatalf("parsed child expansion order changed for %q", markType)
+	}
+}
+
+func TestP2PTextMarkSup(t *testing.T) {
+	assertP2PTextMark(t, "sup", ast.NodeSup, ast.NodeSupOpenMarker, ast.NodeSupCloseMarker)
+}
+func TestP2PTextMarkSub(t *testing.T) {
+	assertP2PTextMark(t, "sub", ast.NodeSub, ast.NodeSubOpenMarker, ast.NodeSubCloseMarker)
+}
+func TestP2PTextMarkEmphasis(t *testing.T) {
+	assertP2PTextMark(t, "em", ast.NodeEmphasis, ast.NodeEmA6kOpenMarker, ast.NodeEmA6kCloseMarker)
+}
+func TestP2PTextMarkStrong(t *testing.T) {
+	assertP2PTextMark(t, "strong", ast.NodeStrong, ast.NodeStrongA6kOpenMarker, ast.NodeStrongA6kCloseMarker)
+}
+func TestP2PTextMarkMark(t *testing.T) {
+	assertP2PTextMark(t, "mark", ast.NodeMark, ast.NodeMark2OpenMarker, ast.NodeMark2CloseMarker)
+}
+func TestP2PTextMarkStrikethrough(t *testing.T) {
+	assertP2PTextMark(t, "s", ast.NodeStrikethrough, ast.NodeStrikethrough2OpenMarker, ast.NodeStrikethrough2CloseMarker)
+}
+
+func TestP2PUnsupportedTextMarkNoop(t *testing.T) {
+	tree, paragraph := treeWithParagraph()
+	mark := &ast.Node{Type: ast.NodeTextMark, TextMarkType: "code", TextMarkTextContent: "raw"}
+	paragraph.AppendChild(mark)
+	parse.TextMarks2Inlines(tree)
+	if paragraph.FirstChild != mark || mark.Type != ast.NodeTextMark {
+		t.Fatal("unsupported text mark changed")
+	}
+}
+
+func TestP2PFlashcardTextMarkNoop(t *testing.T) {
+	tree, paragraph := treeWithParagraph()
+	mark := &ast.Node{Type: ast.NodeTextMark, TextMarkType: "strong", TextMarkTextContent: "answer", TextMarkFlashcardOcclusionID: "card"}
+	paragraph.AppendChild(mark)
+	parse.TextMarks2Inlines(tree)
+	if paragraph.FirstChild != mark || mark.Type != ast.NodeTextMark {
+		t.Fatal("flashcard text mark changed")
+	}
+}
+
+func TestP2PUnclosedBoundary(t *testing.T) {
+	tree, paragraph := treeWithParagraph()
+	unclosed := &ast.Node{Type: ast.NodeStrong}
+	unclosed.AppendChild(&ast.Node{Type: ast.NodeStrongA6kOpenMarker})
+	unclosed.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte("unclosed")})
+	paragraph.AppendChild(unclosed)
+	parse.NestedInlines2FlattedSpans(tree, false)
+	if mark := paragraph.FirstChild; mark == nil || mark.Type != ast.NodeTextMark || mark.TextMarkTextContent != "unclosed" {
+		t.Fatalf("unclosed inline boundary was not handled safely: %#v", mark)
+	}
+}
+
+func p2pTableMathCell() (*parse.Tree, *ast.Node) {
+	tree := &parse.Tree{Root: &ast.Node{Type: ast.NodeDocument}}
+	cell := &ast.Node{Type: ast.NodeTableCell}
+	tree.Root.AppendChild(cell)
+	cell.AppendChild(containerWithText(ast.NodeInlineMath, ast.NodeInlineMathContent, `a\|b`))
+	return tree, cell
+}
+
+func TestP2PTableMathNormal(t *testing.T) {
+	tree, cell := p2pTableMathCell()
+	parse.NestedInlines2FlattedSpans(tree, false)
+	if got := cell.FirstChild.TextMarkInlineMathContent; got != "a|b" {
+		t.Fatalf("normal table math escaping changed: %q", got)
+	}
+}
+
+func TestP2PTableMathExport(t *testing.T) {
+	tree, cell := p2pTableMathCell()
+	parse.NestedInlines2FlattedSpans(tree, true)
+	if got := cell.FirstChild.TextMarkInlineMathContent; got != `a\|b` {
+		t.Fatalf("export table math escaping changed: %q", got)
+	}
+}
+
+func p2pBackslashTree() (*parse.Tree, *ast.Node) {
+	tree, paragraph := treeWithParagraph()
+	strong := &ast.Node{Type: ast.NodeStrong}
+	backslash := &ast.Node{Type: ast.NodeBackslash}
+	backslash.AppendChild(&ast.Node{Type: ast.NodeBackslashContent, Tokens: []byte("*")})
+	strong.AppendChild(backslash)
+	paragraph.AppendChild(strong)
+	return tree, paragraph
+}
+
+func TestP2PBackslashNormal(t *testing.T) {
+	tree, paragraph := p2pBackslashTree()
+	parse.NestedInlines2FlattedSpans(tree, false)
+	mark := paragraph.FirstChild
+	if mark == nil || mark.Type != ast.NodeTextMark || mark.TextMarkTextContent != "*" || mark.TextMarkType != "strong" {
+		t.Fatalf("normal backslash semantics changed: %#v", mark)
+	}
+}
+
+func TestP2PBackslashHybrid(t *testing.T) {
+	tree, paragraph := p2pBackslashTree()
+	parse.NestedInlines2FlattedSpansHybrid(tree, false)
+	mark := paragraph.FirstChild
+	if mark == nil || mark.Type != ast.NodeTextMark || mark.TextMarkTextContent != "*" || mark.TextMarkType != "strong" {
+		t.Fatalf("hybrid backslash semantics changed: %#v", mark)
+	}
+}
+
+func TestP2PProtyleDOMProtocol(t *testing.T) {
+	engine := lute.New()
+	engine.SetProtyleWYSIWYG(true)
+	engine.SetKramdownIAL(true)
+	markdown := "**bold *nested*** and [link](https://example.com \"t\") and $a\\|b$"
+	blockDOM := engine.Md2BlockDOM(markdown, false)
+	if !strings.Contains(blockDOM, `data-type="strong em"`) || !strings.Contains(blockDOM, `data-type="a"`) || !strings.Contains(blockDOM, `data-href="https://example.com"`) {
+		t.Fatalf("Protyle DOM protocol changed: %q", blockDOM)
+	}
+}
+
+func TestP2PBlockDOMRoundTrip(t *testing.T) {
+	engine := lute.New()
+	engine.SetProtyleWYSIWYG(true)
+	engine.SetKramdownIAL(true)
+	markdown := "**bold *nested*** and [link](https://example.com \"t\") and $a\\|b$"
+	standard := engine.BlockDOM2StdMd(engine.Md2BlockDOM(markdown, false))
+	if !strings.Contains(standard, "**bold** ***nested***") || !strings.Contains(standard, "[link](https://example.com") {
+		t.Fatalf("exported Markdown protocol changed: %q", standard)
+	}
+}
+
+func TestP2PVditorDOMProtocol(t *testing.T) {
+	engine := lute.New()
+	markdown := "**bold *nested*** and [link](https://example.com \"t\") and $a\\|b$"
+	vditorDOM := engine.Md2VditorDOM(markdown)
+	if !strings.Contains(vditorDOM, "<strong ") || !strings.Contains(vditorDOM, "<em ") || !strings.Contains(vditorDOM, `href="https://example.com"`) {
+		t.Fatalf("Vditor DOM protocol changed: %q", vditorDOM)
+	}
+}
+
+func TestP2PVditorRoundTrip(t *testing.T) {
+	engine := lute.New()
+	markdown := "**bold *nested*** and [link](https://example.com \"t\") and $a\\|b$"
+	roundTrip := engine.VditorDOM2Md(engine.Md2VditorDOM(markdown))
+	if !strings.Contains(roundTrip, "**bold *nested***") || !strings.Contains(roundTrip, "[link](https://example.com") {
+		t.Fatalf("Vditor Markdown protocol changed: %q", roundTrip)
+	}
+}
+
+func TestP2PCrossTreeIsolation(t *testing.T) {
+	options := parse.NewOptions()
+	firstTree, firstParagraph := treeWithParagraph()
+	firstTree.Context.ParseOption = options
+	firstParagraph.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "strong", TextMarkTextContent: "one"})
+	secondTree, secondParagraph := treeWithParagraph()
+	secondTree.Context.ParseOption = options
+	secondMark := &ast.Node{Type: ast.NodeTextMark, TextMarkType: "strong", TextMarkTextContent: "two"}
+	secondParagraph.AppendChild(secondMark)
+	parse.TextMarks2Inlines(firstTree)
+	if secondMark.Type != ast.NodeTextMark || secondMark.FirstChild != nil {
+		t.Fatal("transforming one tree mutated a different tree")
+	}
+	_ = secondTree
+}
+
+func TestP2PParserOptionUnchanged(t *testing.T) {
+	options := parse.NewOptions()
+	before := *options
+	tree, paragraph := treeWithParagraph()
+	tree.Context.ParseOption = options
+	paragraph.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "strong", TextMarkTextContent: "value"})
+	parse.TextMarks2Inlines(tree)
+	if !reflect.DeepEqual(before, *options) {
+		t.Fatal("the transformation mutated caller parser configuration")
+	}
+}
+
+func TestP2PDeterministicResult(t *testing.T) {
+	options := parse.NewOptions()
+	first, firstParagraph := treeWithParagraph()
+	first.Context.ParseOption = options
+	firstParagraph.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "strong", TextMarkTextContent: "same"})
+	second, secondParagraph := treeWithParagraph()
+	second.Context.ParseOption = options
+	secondParagraph.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "strong", TextMarkTextContent: "same"})
+	parse.TextMarks2Inlines(first)
+	parse.TextMarks2Inlines(second)
+	if first.Root.Text() != second.Root.Text() {
+		t.Fatalf("identical invocations were nondeterministic: %q != %q", first.Root.Text(), second.Root.Text())
+	}
+}
+
+func p2pHtmlNode(t *testing.T, raw string) *html.Node {
+	t.Helper()
+	root := &html.Node{Type: html.ElementNode}
+	nodes, err := html.ParseFragment(strings.NewReader(raw), root)
+	if nil != err || 1 != len(nodes) {
+		t.Fatalf("invalid html fixture: %s", raw)
+	}
+	return nodes[0]
+}
+
+func TestP2PContainTextMarkWrapper(t *testing.T) {
+	node := &ast.Node{Type: ast.NodeTextMark, TextMarkType: "strong em"}
+	if !parse.ContainTextMark(node, "em") || parse.ContainTextMark(node, "kbd") {
+		t.Fatal("parse.ContainTextMark behavior changed")
+	}
+	if !parse.ContainTextMark(&ast.Node{Type: ast.NodeText, TextMarkType: "strong em"}, "em") {
+		t.Fatal("parse.ContainTextMark must preserve membership for other node types")
+	}
+}
+
+func TestP2PStyleValueWrapper(t *testing.T) {
+	if got := parse.StyleValue("  color :  red ;\n font-size: 12px  "); got != "color : red ; font-size: 12px" {
+		t.Fatalf("parse.StyleValue behavior changed: %q", got)
+	}
+}
+
+func TestP2PSetSpanIALWrapper(t *testing.T) {
+	node := &ast.Node{Type: ast.NodeTextMark}
+	parse.SetSpanIAL(node, p2pHtmlNode(t, `<span style="color: red" custom-data="v">x</span>`))
+	if node.IALAttr("style") != "color: red" || node.IALAttr("custom-data") != "v" {
+		t.Fatalf("parse.SetSpanIAL behavior changed: %v", node.KramdownIAL)
+	}
+}
+
+func TestP2PSetTextMarkNodeWrapper(t *testing.T) {
+	node := &ast.Node{}
+	parse.SetTextMarkNode(node, p2pHtmlNode(t, `<span data-type="a" data-href="https://x" data-title="t">label</span>`), parse.NewOptions())
+	if node.Type != ast.NodeTextMark || node.TextMarkType != "a" || node.TextMarkTextContent != "label" || node.TextMarkAHref != "https://x" || node.TextMarkATitle != "t" {
+		t.Fatalf("parse.SetTextMarkNode behavior changed: type=%q tm=%q content=%q", node.Type, node.TextMarkType, node.TextMarkTextContent)
+	}
+}
+
+func TestP2PTextMarkNilOptionsPlainSpan(t *testing.T) {
+	dom := p2pHtmlNode(t, `<span>plain &amp; text</span>`)
+	node := &ast.Node{Type: ast.NodeText, Tokens: []byte("old")}
+	parse.SetTextMarkNode(node, dom, nil)
+	if node.Type != ast.NodeTextMark || node.TextMarkType != "text" || node.TextMarkTextContent != "plain &amp; text" || node.Tokens != nil {
+		t.Fatalf("plain span with nil options changed: type=%s mark=%q content=%q tokens=%q", node.Type, node.TextMarkType, node.TextMarkTextContent, node.Tokens)
+	}
+}
diff --git a/verifier_tests_refactor/refactor_behavior_test.go b/verifier_tests_refactor/refactor_behavior_test.go
new file mode 100644
index 0000000..2d0bcb0
