new file mode 100644
--- /dev/null
+++ b/verifier_architecture/delegation_intervention_test.go
@@ -0,0 +1,376 @@
+package verifier_architecture
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/build"
+	"go/format"
+	"go/parser"
+	"go/token"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+const inlineReceiptPrefix = "LUTE_INTERVENTION_V1 "
+
+// Every nested Go process has an independent deadline and owns a process group.
+// A failed compile, ordinary panic, or timeout is never an intervention witness.
+func boundedInlineGo(root string, env []string, args ...string) ([]byte, error) {
+	return boundedInlineGoDeadline(root, env, 50*time.Second, args...)
+}
+
+func boundedInlineGoDeadline(root string, env []string, limit time.Duration, args ...string) ([]byte, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), limit)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "go", args...)
+	cmd.Dir, cmd.Env = root, env
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	cmd.Cancel = func() error { return syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL) }
+	cmd.WaitDelay = 2 * time.Second
+	defer func() {
+		if cmd.Process != nil {
+			_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
+		}
+	}()
+	output, err := cmd.CombinedOutput()
+	if ctx.Err() != nil {
+		return output, fmt.Errorf("probe deadline: %w", ctx.Err())
+	}
+	return output, err
+}
+
+func inlineNodeKind(expr ast.Expr, imports map[string]string) string {
+	sel, ok := expr.(*ast.SelectorExpr)
+	if !ok {
+		return ""
+	}
+	id, ok := sel.X.(*ast.Ident)
+	if !ok || id.Obj != nil || imports[id.Name] != "github.com/88250/lute/ast" {
+		return ""
+	}
+	switch sel.Sel.Name {
+	case "NodeTextMark":
+		return "textmark"
+	case "NodeImage", "NodeLinkDest":
+		return "image-node"
+	}
+	return ""
+}
+
+func literalString(expr ast.Expr, value string) bool {
+	lit, ok := expr.(*ast.BasicLit)
+	if !ok || lit.Kind != token.STRING {
+		return false
+	}
+	s, err := strconv.Unquote(lit.Value)
+	return err == nil && s == value
+}
+
+// Instrument the expression that constructs/writes the target representation.
+// No arbitrary editor entry point is disabled. Keeping the original expression
+// as an argument preserves typing; Stop is a typed, immediately recovered abort.
+func inlineInterventionOverlay(root, dir, kind, nonce string, dirs []string) (string, int, error) {
+	replace := map[string]string{}
+	sites := 0
+	for _, component := range dirs {
+		paths, err := filepath.Glob(filepath.Join(component, "*.go"))
+		if err != nil {
+			return "", 0, err
+		}
+		for _, path := range paths {
+			match, err := build.Default.MatchFile(component, filepath.Base(path))
+			if err != nil {
+				return "", 0, err
+			}
+			if !match || strings.HasSuffix(path, "_test.go") {
+				continue
+			}
+			fset := token.NewFileSet()
+			file, err := parser.ParseFile(fset, path, nil, parser.ParseComments)
+			if err != nil {
+				return "", 0, err
+			}
+			imports := map[string]string{}
+			for _, imp := range file.Imports {
+				p, err := strconv.Unquote(imp.Path.Value)
+				if err != nil {
+					return "", 0, err
+				}
+				alias := filepath.Base(p)
+				if imp.Name != nil {
+					alias = imp.Name.Name
+				}
+				imports[alias] = p
+			}
+			before := sites
+			stop := func(value ast.Expr) ast.Expr {
+				sites++
+				return &ast.CallExpr{Fun: &ast.SelectorExpr{X: ast.NewIdent("luteVerifierIntervention"), Sel: ast.NewIdent("Stop")}, Args: []ast.Expr{value, &ast.BasicLit{Kind: token.STRING, Value: strconv.Quote(kind)}, &ast.BasicLit{Kind: token.STRING, Value: strconv.Quote(nonce)}}}
+			}
+			// A multi-result RHS cannot be passed as one generic value. Mark the
+			// executed assignment statement without changing its tuple signature.
+			prefixTupleWrites := func(statements []ast.Stmt) []ast.Stmt {
+				result := []ast.Stmt{}
+				for _, statement := range statements {
+					if assignment, ok := statement.(*ast.AssignStmt); ok && len(assignment.Lhs) > 1 && len(assignment.Rhs) == 1 && kind == "textmark" {
+						for _, lhs := range assignment.Lhs {
+							if sel, ok := lhs.(*ast.SelectorExpr); ok && markFieldName(sel.Sel.Name) {
+								sites++
+								result = append(result, &ast.ExprStmt{X: &ast.CallExpr{Fun: &ast.SelectorExpr{X: ast.NewIdent("luteVerifierIntervention"), Sel: ast.NewIdent("Hit")}, Args: []ast.Expr{&ast.BasicLit{Kind: token.STRING, Value: strconv.Quote(kind)}, &ast.BasicLit{Kind: token.STRING, Value: strconv.Quote(nonce)}}}})
+								break
+							}
+						}
+					}
+					result = append(result, statement)
+				}
+				return result
+			}
+			ast.Inspect(file, func(node ast.Node) bool {
+				switch x := node.(type) {
+				case *ast.BlockStmt:
+					x.List = prefixTupleWrites(x.List)
+				case *ast.CaseClause:
+					x.Body = prefixTupleWrites(x.Body)
+				case *ast.CommClause:
+					x.Body = prefixTupleWrites(x.Body)
+				case *ast.KeyValueExpr:
+					if key, ok := x.Key.(*ast.Ident); ok {
+						if key.Name == "Type" && inlineNodeKind(x.Value, imports) == kind {
+							x.Value = stop(x.Value)
+							return false
+						}
+						if kind == "textmark" && markFieldName(key.Name) {
+							x.Value = stop(x.Value)
+							return false
+						}
+					}
+				case *ast.AssignStmt:
+					if len(x.Lhs) > 1 && len(x.Rhs) == 1 {
+						return true
+					}
+					for i, lhs := range x.Lhs {
+						if i >= len(x.Rhs) {
+							continue
+						}
+						if sel, ok := lhs.(*ast.SelectorExpr); ok {
+							if (sel.Sel.Name == "Type" && inlineNodeKind(x.Rhs[i], imports) == kind) || (kind == "textmark" && markFieldName(sel.Sel.Name)) {
+								x.Rhs[i] = stop(x.Rhs[i])
+							}
+						}
+					}
+					return true
+				case *ast.CallExpr:
+					if kind == "image-style" {
+						if sel, ok := x.Fun.(*ast.SelectorExpr); ok && sel.Sel.Name == "SetIALAttr" && len(x.Args) == 2 && literalString(x.Args[0], "style") {
+							x.Args[1] = stop(x.Args[1])
+							return false
+						}
+					}
+				}
+				return true
+			})
+			if sites == before {
+				continue
+			}
+			file.Decls = append([]ast.Decl{&ast.GenDecl{Tok: token.IMPORT, Specs: []ast.Spec{&ast.ImportSpec{Name: ast.NewIdent("luteVerifierIntervention"), Path: &ast.BasicLit{Kind: token.STRING, Value: strconv.Quote("github.com/88250/lute/verifier_intervention")}}}}}, file.Decls...)
+			var output bytes.Buffer
+			if err := format.Node(&output, fset, file); err != nil {
+				return "", 0, err
+			}
+			target := filepath.Join(dir, fmt.Sprintf("target-%d.go", len(replace)))
+			if err := os.WriteFile(target, output.Bytes(), 0600); err != nil {
+				return "", 0, err
+			}
+			replace[path] = target
+		}
+	}
+	data, err := json.Marshal(map[string]any{"Replace": replace})
+	if err != nil {
+		return "", 0, err
+	}
+	path := filepath.Join(dir, "overlay.json")
+	return path, sites, os.WriteFile(path, data, 0600)
+}
+
+type inlineProbeResult struct {
+	action     string
+	hits       int
+	unexpected bool
+}
+
+func inlineProbeEvents(output []byte, probe, kind, nonce string) inlineProbeResult {
+	result := inlineProbeResult{}
+	verified := false
+	for _, line := range bytes.Split(output, []byte("\n")) {
+		var event struct{ Test, Action, Output string }
+		if json.Unmarshal(line, &event) != nil {
+			continue
+		}
+		if nonce != "" && event.Test == probe+"/VerifiedIntervention_"+kind+"_"+nonce && event.Action == "pass" {
+			verified = true
+		}
+		if event.Test != probe {
+			continue
+		}
+		if event.Action == "pass" || event.Action == "fail" || event.Action == "skip" {
+			result.action = event.Action
+		}
+		if event.Action == "output" && strings.HasPrefix(event.Output, inlineReceiptPrefix) {
+			var receipt struct{ Kind, Nonce string }
+			if json.Unmarshal([]byte(strings.TrimPrefix(event.Output, inlineReceiptPrefix)), &receipt) != nil || receipt.Kind != kind || receipt.Nonce != nonce {
+				result.unexpected = true
+			} else {
+				result.hits++
+			}
+		}
+	}
+	if nonce != "" && !verified {
+		result.hits = 0
+	}
+	return result
+}
+
+// Forwarded style parameters are traced to prevent parser-side width/IAL
+// computation from hiding behind an editor function that merely stores a string.
+func parserImageStyleIssues(root string, dirs []string) ([]string, error) {
+	functions, err := markFunctions(root, dirs)
+	if err != nil {
+		return nil, err
+	}
+	components := map[string]bool{}
+	for _, dir := range dirs {
+		rel, err := filepath.Rel(root, dir)
+		if err != nil {
+			return nil, err
+		}
+		components["github.com/88250/lute/"+filepath.ToSlash(rel)] = true
+	}
+	styleWrites := func(f *markFunction, visit func(ast.Expr)) {
+		ast.Inspect(f.fn.Body, func(node ast.Node) bool {
+			if call, ok := node.(*ast.CallExpr); ok && len(call.Args) == 2 && literalString(call.Args[0], "style") {
+				if sel, ok := call.Fun.(*ast.SelectorExpr); ok && sel.Sel.Name == "SetIALAttr" {
+					visit(call.Args[1])
+				}
+			}
+			return true
+		})
+	}
+	for _, f := range functions {
+		f.sinks = map[int]bool{}
+	}
+	for changed := true; changed; {
+		changed = false
+		for _, f := range functions {
+			if !components[f.pkg] {
+				continue
+			}
+			add := func(expr ast.Expr) {
+				for i := range markParameterSources(f, expr, map[*ast.Object]bool{}) {
+					if !f.sinks[i] {
+						f.sinks[i], changed = true, true
+					}
+				}
+			}
+			styleWrites(f, add)
+			ast.Inspect(f.fn.Body, func(node ast.Node) bool {
+				if call, ok := node.(*ast.CallExpr); ok {
+					if callee := markCallee(f, call, functions); callee != nil {
+						for i := range callee.sinks {
+							if i < len(call.Args) {
+								add(call.Args[i])
+							}
+						}
+					}
+				}
+				return true
+			})
+		}
+	}
+	issues := []string{}
+	for _, f := range functions {
+		if components[f.pkg] {
+			continue
+		}
+		safe := func(expr ast.Expr) bool {
+			return markEditorValue(f, expr, 0, functions, components, nil, map[any]bool{})
+		}
+		styleWrites(f, func(expr ast.Expr) {
+			if !safe(expr) {
+				issues = append(issues, f.key+" computes image style in parser")
+			}
+		})
+		ast.Inspect(f.fn.Body, func(node ast.Node) bool {
+			if call, ok := node.(*ast.CallExpr); ok {
+				if callee := markCallee(f, call, functions); callee != nil && components[callee.pkg] {
+					for i := range callee.sinks {
+						if i < len(call.Args) && !safe(call.Args[i]) {
+							issues = append(issues, f.key+" supplies parser-computed style to "+callee.key)
+						}
+					}
+				}
+			}
+			return true
+		})
+	}
+	return issues, nil
+}
+
+func requireInlineConversionDelegation(t *testing.T, probe string, kinds ...string) {
+	t.Helper()
+	root := repository(t)
+	plain, err := boundedInlineGo(root, os.Environ(), "test", "-json", "-count=1", "-timeout=30s", "./verifier_tests_refactor", "-run", "^"+probe+"$")
+	plainResult := inlineProbeEvents(plain, probe, "", "")
+	if plainResult.action == "" || plainResult.action == "skip" || (plainResult.action == "pass" && err != nil) {
+		t.Skipf("public probe unavailable: %v\n%s", err, plain)
+	}
+	if err != nil || plainResult.action != "pass" {
+		t.Fatalf("normal public conversion failed: %v\n%s", err, plain)
+	}
+	dirs, err := componentDirs(root)
+	if err != nil {
+		t.Skipf("intervention unavailable: %v", err)
+	}
+	if len(kinds) == 2 {
+		issues, err := parserImageStyleIssues(root, dirs)
+		if err != nil {
+			t.Skipf("style provenance unavailable: %v", err)
+		}
+		if len(issues) > 0 {
+			t.Fatalf("image conversion remains in parser: %s", strings.Join(issues, "; "))
+		}
+	}
+	for _, kind := range kinds {
+		random := make([]byte, 16)
+		if _, err := rand.Read(random); err != nil {
+			t.Skipf("cannot bind intervention nonce: %v", err)
+		}
+		nonce := hex.EncodeToString(random)
+		overlay, sites, err := inlineInterventionOverlay(root, t.TempDir(), kind, nonce, dirs)
+		if err != nil {
+			t.Skipf("intervention unavailable: %v", err)
+		}
+		if sites == 0 {
+			t.Fatalf("no editor-owned %s transformation sites", kind)
+		}
+		env := append(os.Environ(), "LUTE_INTERVENTION_KIND="+kind, "LUTE_INTERVENTION_NONCE="+nonce)
+		output, err := boundedInlineGo(root, env, "test", "-json", "-vet=off", "-count=1", "-timeout=30s", "-overlay", overlay, "./verifier_tests_refactor", "-run", "^"+probe+"$")
+		result := inlineProbeEvents(output, probe, kind, nonce)
+		if err != nil || result.action != "pass" || result.unexpected {
+			t.Skipf("intervention did not complete normally: %v\n%s", err, output)
+		}
+		if result.hits != 1 {
+			t.Fatalf("public conversion survives without executing editor %s transformation", kind)
+		}
+	}
+}
