diff --git a/verifier_unit_adapter/main.go b/verifier_unit_adapter/main.go
new file mode 100644
index 0000000..aec298f
--- /dev/null
+++ b/verifier_unit_adapter/main.go
@@ -0,0 +1,133 @@
+// Adapt trusted upstream table loops into subtests without changing assertions.
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/format"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+func main() {
+	root, out := os.Args[1], os.Args[2]
+	if err := os.MkdirAll(out, 0700); err != nil {
+		panic(err)
+	}
+	replacements := map[string]string{}
+	for _, pkg := range []string{"parse", "test"} {
+		paths, err := filepath.Glob(filepath.Join(root, pkg, "*_test.go"))
+		if err != nil {
+			panic(err)
+		}
+		for _, path := range paths {
+			fset := token.NewFileSet()
+			file, err := parser.ParseFile(fset, path, nil, parser.ParseComments)
+			if err != nil {
+				panic(err)
+			}
+			changed := false
+			for _, decl := range file.Decls {
+				fn, ok := decl.(*ast.FuncDecl)
+				if !ok || !strings.HasPrefix(fn.Name.Name, "Test") || fn.Body == nil {
+					continue
+				}
+				for index, stmt := range fn.Body.List {
+					loop, ok := stmt.(*ast.RangeStmt)
+					if !ok {
+						continue
+					}
+					// Keep fixture-selection guards in the loop, outside the subtest.
+					prefixEnd := 0
+					for i, statement := range loop.Body.List {
+						hasContinue := false
+						ast.Inspect(statement, func(n ast.Node) bool {
+							if branch, ok := n.(*ast.BranchStmt); ok && branch.Tok == token.CONTINUE {
+								hasContinue = true
+							}
+							return true
+						})
+						if hasContinue {
+							prefixEnd = i + 1
+						}
+					}
+					prefixStmts := append([]ast.Stmt(nil), loop.Body.List[:prefixEnd]...)
+					body := &ast.BlockStmt{List: loop.Body.List[prefixEnd:]}
+					already, assertion, unsafe := false, false, false
+					ast.Inspect(body, func(node ast.Node) bool {
+						if _, ok := node.(*ast.FuncLit); ok {
+							return false
+						}
+						if call, ok := node.(*ast.CallExpr); ok {
+							if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+								if id, ok := sel.X.(*ast.Ident); ok && id.Name == "t" {
+									already = already || sel.Sel.Name == "Run"
+									assertion = assertion || sel.Sel.Name == "Fatalf" || sel.Sel.Name == "Fatal" || sel.Sel.Name == "Errorf" || sel.Sel.Name == "Error"
+								}
+							}
+						}
+						if _, ok := node.(*ast.BranchStmt); ok {
+							unsafe = true
+						}
+						return true
+					})
+					if already || !assertion {
+						continue
+					}
+					if unsafe {
+						panic(fmt.Sprintf("table loop has branch needing explicit adaptation: %s:%s", path, fn.Name.Name))
+					}
+					key := loop.Key
+					if id, ok := key.(*ast.Ident); key == nil || (ok && id.Name == "_") {
+						key = ast.NewIdent("verifierCaseIndex")
+						loop.Key = key
+						loop.Tok = token.DEFINE
+					}
+					prefix := fmt.Sprintf("table_%02d_", index)
+					snippet, err := parser.ParseFile(token.NewFileSet(), "wrapper.go", "package p\nfunc f(){ t.Run(\"\", func(t *testing.T){}) }", 0)
+					if err != nil {
+						panic(err)
+					}
+					call := snippet.Decls[0].(*ast.FuncDecl).Body.List[0].(*ast.ExprStmt).X.(*ast.CallExpr)
+					call.Args[0] = &ast.BinaryExpr{X: &ast.BasicLit{Kind: token.STRING, Value: strconv.Quote(prefix)}, Op: token.ADD,
+						Y: &ast.CallExpr{Fun: ast.NewIdent("verifierUnitCaseName"), Args: []ast.Expr{key}}}
+					call.Args[1].(*ast.FuncLit).Body = body
+					loop.Body = &ast.BlockStmt{List: append(prefixStmts, &ast.ExprStmt{X: call})}
+					changed = true
+				}
+			}
+			if !changed {
+				continue
+			}
+			var data bytes.Buffer
+			if err := format.Node(&data, fset, file); err != nil {
+				panic(err)
+			}
+			replacement := filepath.Join(out, pkg+"-"+filepath.Base(path))
+			if err := os.WriteFile(replacement, data.Bytes(), 0600); err != nil {
+				panic(err)
+			}
+			replacements[path] = replacement
+		}
+		// Go overlays discover new files in existing package directories.
+		helper := filepath.Join(out, pkg+"-helper_test.go")
+		code := fmt.Sprintf("package %s\nimport \"fmt\"\nfunc verifierUnitCaseName(key interface{}) string { if n, ok := key.(int); ok { return fmt.Sprintf(\"case_%%04d\", n) }; return fmt.Sprintf(\"key_%%x\", []byte(fmt.Sprint(key))) }\n", pkg)
+		if err := os.WriteFile(helper, []byte(code), 0600); err != nil {
+			panic(err)
+		}
+		replacements[filepath.Join(root, pkg, "verifier_unit_cases_test.go")] = helper
+	}
+	data, err := json.Marshal(map[string]interface{}{"Replace": replacements})
+	if err != nil {
+		panic(err)
+	}
+	if err := os.WriteFile(filepath.Join(out, "overlay.json"), data, 0600); err != nil {
+		panic(err)
+	}
+}
diff --git a/verifier_architecture/textmark_ownership_test.go b/verifier_architecture/textmark_ownership_test.go
new file mode 100644
--- /dev/null
+++ b/verifier_architecture/textmark_ownership_test.go
@@ -0,0 +1,491 @@
+package verifier_architecture
+
+// This analyzer follows TextMark value producers, not the spelling or age of a
+// helper. Component results may be wired by parse, but parse must not compute
+// the values, including values passed to component functions that just store them.
+import (
+	"fmt"
+	"go/ast"
+	"go/build"
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type markBinding struct {
+	expr        ast.Expr
+	part        int
+	conditional bool
+}
+
+type markFunction struct {
+	key, pkg                    string
+	fn                          *ast.FuncDecl
+	imports                     map[string]string
+	bindings                    map[*ast.Object][]markBinding
+	params                      []*ast.Ident
+	sinks                       map[int]bool
+	readObjects, mutatedObjects map[*ast.Object]bool
+	callSites                   []*ast.CallExpr
+}
+
+func markFieldName(name string) bool {
+	// Options.TextMark is a parser mode flag, not ast.Node representation state.
+	return name != "TextMark" && strings.HasPrefix(name, "TextMark")
+}
+
+func markFunctions(root string, componentDirs []string) (map[string]*markFunction, error) {
+	functions := map[string]*markFunction{}
+	dirs := append([]string{filepath.Join(root, "parse")}, componentDirs...)
+	for _, dir := range dirs {
+		paths, err := filepath.Glob(filepath.Join(dir, "*.go"))
+		if err != nil {
+			return nil, err
+		}
+		rel, err := filepath.Rel(root, dir)
+		if err != nil {
+			return nil, err
+		}
+		pkg := "github.com/88250/lute/" + filepath.ToSlash(rel)
+		for _, path := range paths {
+			matched, err := build.Default.MatchFile(dir, filepath.Base(path))
+			if err != nil {
+				return nil, err
+			}
+			if !matched || strings.HasSuffix(path, "_test.go") {
+				continue
+			}
+			file, err := parser.ParseFile(token.NewFileSet(), path, nil, 0)
+			if err != nil {
+				return nil, err
+			}
+			imports := map[string]string{}
+			for _, imp := range file.Imports {
+				value, err := strconv.Unquote(imp.Path.Value)
+				if err != nil {
+					return nil, err
+				}
+				name := filepath.Base(value)
+				if imp.Name != nil {
+					name = imp.Name.Name
+				}
+				if name == "." {
+					return nil, fmt.Errorf("unresolved dot import in %s", path)
+				}
+				imports[name] = value
+			}
+			for _, decl := range file.Decls {
+				fn, ok := decl.(*ast.FuncDecl)
+				if !ok || fn.Body == nil {
+					continue
+				}
+				key := pkg + "." + fn.Name.Name
+				if fn.Recv != nil {
+					var receiver ast.Expr = fn.Recv.List[0].Type
+					if ptr, ok := receiver.(*ast.StarExpr); ok {
+						receiver = ptr.X
+					}
+					id, ok := receiver.(*ast.Ident)
+					if !ok {
+						return nil, fmt.Errorf("unsupported receiver in %s", path)
+					}
+					key = pkg + "." + id.Name + "." + fn.Name.Name
+				}
+				f := &markFunction{key: key, pkg: pkg, fn: fn, imports: imports, bindings: map[*ast.Object][]markBinding{}, sinks: map[int]bool{}}
+				for _, field := range fn.Type.Params.List {
+					f.params = append(f.params, field.Names...)
+				}
+				ancestors := []bool{}
+				conditionalDepth := 0
+				ast.Inspect(fn.Body, func(n ast.Node) bool {
+					if n == nil {
+						if ancestors[len(ancestors)-1] {
+							conditionalDepth--
+						}
+						ancestors = ancestors[:len(ancestors)-1]
+						return false
+					}
+					conditional := false
+					switch n.(type) {
+					case *ast.IfStmt, *ast.ForStmt, *ast.RangeStmt, *ast.SwitchStmt, *ast.TypeSwitchStmt, *ast.SelectStmt, *ast.FuncLit:
+						conditional = true
+					}
+					ancestors = append(ancestors, conditional)
+					if conditional {
+						conditionalDepth++
+					}
+					add := func(names []ast.Expr, values []ast.Expr, compound bool) {
+						for i, name := range names {
+							id, ok := name.(*ast.Ident)
+							if !ok || id.Obj == nil {
+								continue
+							}
+							b := markBinding{conditional: conditionalDepth > 0}
+							if !compound && i < len(values) {
+								b.expr = values[i]
+							}
+							if !compound && len(values) == 1 && len(names) > 1 {
+								b.expr, b.part = values[0], i
+							}
+							f.bindings[id.Obj] = append(f.bindings[id.Obj], b)
+						}
+					}
+					switch x := n.(type) {
+					case *ast.AssignStmt:
+						add(x.Lhs, x.Rhs, x.Tok != token.ASSIGN && x.Tok != token.DEFINE)
+					case *ast.ValueSpec:
+						if len(x.Values) > 0 {
+							names := []ast.Expr{}
+							for _, id := range x.Names {
+								names = append(names, id)
+							}
+							add(names, x.Values, false)
+						}
+					}
+					return true
+				})
+				functions[key] = f
+			}
+		}
+	}
+	return functions, nil
+}
+
+func markCallee(f *markFunction, call *ast.CallExpr, functions map[string]*markFunction) *markFunction {
+	switch x := call.Fun.(type) {
+	case *ast.Ident:
+		return functions[f.pkg+"."+x.Name]
+	case *ast.SelectorExpr:
+		if id, ok := x.X.(*ast.Ident); ok {
+			if path := f.imports[id.Name]; path != "" {
+				return functions[path+"."+x.Sel.Name]
+			}
+			if f.fn.Recv != nil {
+				for _, name := range f.fn.Recv.List[0].Names {
+					if id.Obj == name.Obj {
+						return functions[strings.TrimSuffix(f.key, f.fn.Name.Name)+x.Sel.Name]
+					}
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// Only identity/alias forwarding propagates a component parameter to a sink.
+// DOM field extraction or a computation in the component is component-owned.
+func markParameterSources(f *markFunction, expr ast.Expr, seen map[*ast.Object]bool) map[int]bool {
+	out := map[int]bool{}
+	if p, ok := expr.(*ast.ParenExpr); ok {
+		return markParameterSources(f, p.X, seen)
+	}
+	id, ok := expr.(*ast.Ident)
+	if !ok || id.Obj == nil || seen[id.Obj] {
+		return out
+	}
+	seen[id.Obj] = true
+	defer delete(seen, id.Obj)
+	overwritten := false
+	for _, b := range f.bindings[id.Obj] {
+		if !b.conditional {
+			overwritten = true
+		}
+	}
+	for i, param := range f.params {
+		if param.Obj == id.Obj && !overwritten {
+			out[i] = true
+		}
+	}
+	for _, b := range f.bindings[id.Obj] {
+		for i := range markParameterSources(f, b.expr, seen) {
+			out[i] = true
+		}
+	}
+	return out
+}
+
+func markWrites(fn *ast.FuncDecl, visit func(string, ast.Expr, bool)) {
+	ast.Inspect(fn.Body, func(n ast.Node) bool {
+		switch x := n.(type) {
+		case *ast.AssignStmt:
+			for i, lhs := range x.Lhs {
+				if field, ok := lhs.(*ast.SelectorExpr); ok && markFieldName(field.Sel.Name) {
+					var rhs ast.Expr
+					if i < len(x.Rhs) {
+						rhs = x.Rhs[i]
+					}
+					visit(field.Sel.Name, rhs, x.Tok == token.ASSIGN)
+				}
+			}
+		case *ast.KeyValueExpr:
+			if id, ok := x.Key.(*ast.Ident); ok && markFieldName(id.Name) {
+				visit(id.Name, x.Value, true)
+			}
+		}
+		return true
+	})
+}
+
+// Correlate representation reads and mutations on the same object, including
+// aliases. Merely reading a mark while constructing an unrelated parser node is
+// not evidence that parse owns a TextMark-to-inline conversion.
+func markObjectRoots(f *markFunction, expr ast.Expr, seen map[*ast.Object]bool) map[*ast.Object]bool {
+	out := map[*ast.Object]bool{}
+	switch x := expr.(type) {
+	case *ast.Ident:
+		if x.Obj == nil || seen[x.Obj] {
+			return out
+		}
+		seen[x.Obj] = true
+		defer delete(seen, x.Obj)
+		for _, b := range f.bindings[x.Obj] {
+			for obj := range markObjectRoots(f, b.expr, seen) {
+				out[obj] = true
+			}
+		}
+		if len(out) == 0 {
+			out[x.Obj] = true
+		}
+	case *ast.SelectorExpr:
+		return markObjectRoots(f, x.X, seen)
+	case *ast.IndexExpr:
+		return markObjectRoots(f, x.X, seen)
+	case *ast.ParenExpr:
+		return markObjectRoots(f, x.X, seen)
+	case *ast.UnaryExpr:
+		return markObjectRoots(f, x.X, seen)
+	case *ast.StarExpr:
+		return markObjectRoots(f, x.X, seen)
+	}
+	return out
+}
+
+// A result remains delegated through aliases, selectors, and local forwarding
+// functions. Any parser-side calculation invalidates that result's provenance.
+func markEditorValue(f *markFunction, expr ast.Expr, part int, functions map[string]*markFunction, components map[string]bool, args map[*ast.Object]bool, seen map[any]bool) bool {
+	switch x := expr.(type) {
+	case *ast.ParenExpr:
+		return markEditorValue(f, x.X, part, functions, components, args, seen)
+	case *ast.SelectorExpr:
+		return markEditorValue(f, x.X, 0, functions, components, args, seen)
+	case *ast.Ident:
+		if x.Obj == nil || seen[x.Obj] {
+			return false
+		}
+		if value, ok := args[x.Obj]; ok && len(f.bindings[x.Obj]) == 0 {
+			return value
+		}
+		bindings := f.bindings[x.Obj]
+		if len(bindings) == 0 {
+			return false
+		}
+		seen[x.Obj] = true
+		defer delete(seen, x.Obj)
+		for _, b := range bindings {
+			if !markEditorValue(f, b.expr, b.part, functions, components, args, seen) {
+				return false
+			}
+		}
+		return true
+	case *ast.CallExpr:
+		if sel, ok := x.Fun.(*ast.SelectorExpr); ok {
+			if id, ok := sel.X.(*ast.Ident); ok && id.Obj == nil && components[f.imports[id.Name]] {
+				return true
+			}
+		}
+		callee := markCallee(f, x, functions)
+		if callee == nil || seen[callee] {
+			return false
+		}
+		seen[callee] = true
+		defer delete(seen, callee)
+		values := map[*ast.Object]bool{}
+		for i, param := range callee.params {
+			values[param.Obj] = i < len(x.Args) && markEditorValue(f, x.Args[i], 0, functions, components, args, seen)
+		}
+		found, valid := false, true
+		ast.Inspect(callee.fn.Body, func(n ast.Node) bool {
+			if _, nested := n.(*ast.FuncLit); nested {
+				return false
+			}
+			if ret, ok := n.(*ast.ReturnStmt); ok {
+				found = true
+				if part >= len(ret.Results) || !markEditorValue(callee, ret.Results[part], 0, functions, components, values, seen) {
+					valid = false
+				}
+			}
+			return true
+		})
+		return found && valid
+	}
+	return false
+}
+
+func parserTextMarkIssues(root string, dirs []string) ([]string, error) {
+	functions, err := markFunctions(root, dirs)
+	if err != nil {
+		return nil, err
+	}
+	components := map[string]bool{}
+	for _, dir := range dirs {
+		rel, err := filepath.Rel(root, dir)
+		if err != nil {
+			return nil, err
+		}
+		components["github.com/88250/lute/"+filepath.ToSlash(rel)] = true
+	}
+	// Resolve component parameters stored into TextMark fields, including
+	// forwarding through component helpers, to a fixed point.
+	for changed := true; changed; {
+		changed = false
+		for _, f := range functions {
+			if !components[f.pkg] {
+				continue
+			}
+			add := func(expr ast.Expr) {
+				for i := range markParameterSources(f, expr, map[*ast.Object]bool{}) {
+					if !f.sinks[i] {
+						f.sinks[i], changed = true, true
+					}
+				}
+			}
+			markWrites(f.fn, func(_ string, expr ast.Expr, _ bool) { add(expr) })
+			ast.Inspect(f.fn.Body, func(n ast.Node) bool {
+				if call, ok := n.(*ast.CallExpr); ok {
+					if callee := markCallee(f, call, functions); callee != nil {
+						for i := range callee.sinks {
+							if i < len(call.Args) {
+								add(call.Args[i])
+							}
+						}
+					}
+				}
+				return true
+			})
+		}
+	}
+	issues := map[string]bool{}
+	for _, f := range functions {
+		if components[f.pkg] {
+			continue
+		}
+		f.readObjects, f.mutatedObjects = map[*ast.Object]bool{}, map[*ast.Object]bool{}
+		addObjects := func(target map[*ast.Object]bool, expr ast.Expr) {
+			for obj := range markObjectRoots(f, expr, map[*ast.Object]bool{}) {
+				target[obj] = true
+			}
+		}
+		safe := func(expr ast.Expr) bool {
+			return markEditorValue(f, expr, 0, functions, components, nil, map[any]bool{})
+		}
+		markWrites(f.fn, func(field string, value ast.Expr, plain bool) {
+			if !plain || !safe(value) {
+				issues[f.key+" computes/writes "+field+" in parser"] = true
+			}
+		})
+		written := map[*ast.SelectorExpr]bool{}
+		ast.Inspect(f.fn.Body, func(n ast.Node) bool {
+			if assignment, ok := n.(*ast.AssignStmt); ok {
+				for _, lhs := range assignment.Lhs {
+					if sel, ok := lhs.(*ast.SelectorExpr); ok && assignment.Tok == token.ASSIGN {
+						written[sel] = true
+					}
+				}
+			}
+			return true
+		})
+		ast.Inspect(f.fn.Body, func(n ast.Node) bool {
+			switch x := n.(type) {
+			case *ast.SelectorExpr:
+				if !written[x] && markFieldName(x.Sel.Name) && !safe(x.X) {
+					addObjects(f.readObjects, x.X)
+				}
+			case *ast.AssignStmt:
+				for _, lhs := range x.Lhs {
+					if sel, ok := lhs.(*ast.SelectorExpr); ok && (sel.Sel.Name == "Type" || sel.Sel.Name == "Tokens") {
+						addObjects(f.mutatedObjects, sel.X)
+					}
+				}
+			case *ast.CallExpr:
+				if sel, ok := x.Fun.(*ast.SelectorExpr); ok {
+					switch sel.Sel.Name {
+					case "AppendChild", "PrependChild", "InsertBefore", "InsertAfter", "Unlink":
+						addObjects(f.mutatedObjects, sel.X)
+					}
+				}
+				if callee := markCallee(f, x, functions); callee != nil && !components[callee.pkg] {
+					f.callSites = append(f.callSites, x)
+				}
+				if callee := markCallee(f, x, functions); callee != nil && components[callee.pkg] {
+					for i := range callee.sinks {
+						if i >= len(x.Args) {
+							continue
+						}
+						// Empty string requests component-side inference; it is not
+						// a parser-computed type or attribute value.
+						if literal, ok := x.Args[i].(*ast.BasicLit); ok && literal.Kind == token.STRING && literal.Value == `""` {
+							continue
+						}
+						if !safe(x.Args[i]) {
+							issues[f.key+" supplies parser-owned TextMark value to "+callee.key] = true
+						}
+					}
+				}
+			}
+			return true
+		})
+	}
+	for changed := true; changed; {
+		changed = false
+		for _, f := range functions {
+			if components[f.pkg] {
+				continue
+			}
+			for _, call := range f.callSites {
+				callee := markCallee(f, call, functions)
+				propagate := func(param *ast.Ident, arg ast.Expr) {
+					for _, pair := range []struct{ from, to map[*ast.Object]bool }{{callee.readObjects, f.readObjects}, {callee.mutatedObjects, f.mutatedObjects}} {
+						if !pair.from[param.Obj] {
+							continue
+						}
+						for obj := range markObjectRoots(f, arg, map[*ast.Object]bool{}) {
+							if !pair.to[obj] {
+								pair.to[obj], changed = true, true
+							}
+						}
+					}
+				}
+				for i, param := range callee.params {
+					if i < len(call.Args) {
+						propagate(param, call.Args[i])
+					}
+				}
+				if callee.fn.Recv != nil {
+					if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+						for _, param := range callee.fn.Recv.List[0].Names {
+							propagate(param, sel.X)
+						}
+					}
+				}
+			}
+		}
+	}
+	for _, f := range functions {
+		if !components[f.pkg] {
+			for obj := range f.readObjects {
+				if f.mutatedObjects[obj] {
+					issues[f.key+" owns TextMark-to-inline mutation"] = true
+				}
+			}
+		}
+	}
+	out := []string{}
+	for issue := range issues {
+		out = append(out, issue)
+	}
+	sort.Strings(out)
+	return out, nil
+}
