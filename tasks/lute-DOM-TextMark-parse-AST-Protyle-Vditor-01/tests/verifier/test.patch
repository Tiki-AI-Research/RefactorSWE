+// Package variables initialized once and used as lookup constants are allowed.
+// Reject writes and address escapes from invocation code, including selectors,
+// indexes and globals declared in another file. Local shadowing is resolved by
+// go/ast objects; constants and locals are never classified as package state.
+func TestInvocationStateNotRetained(t *testing.T) {
+	root := repository(t)
+	dirs := map[string]bool{filepath.Join(root, "parse"): true}
+	components, err := componentDirs(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, dir := range components {
+		dirs[dir] = true
+	}
+	for dir := range dirs {
+		packages, err := parser.ParseDir(token.NewFileSet(), dir, func(info os.FileInfo) bool { return !strings.HasSuffix(info.Name(), "_test.go") }, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		// Existing parser services outside this migration may own state.
+		// Compare normalized declarations against the frozen baseline, rather
+		// than exempting names that a candidate could reuse.
+		unchanged := map[string]bool{}
+		if filepath.Base(dir) == "parse" {
+			paths, _ := filepath.Glob(filepath.Join(dir, "*.go"))
+			for _, path := range paths {
+				old, err := exec.Command("git", "-C", root, "show", "8928f1866da3269aed613288afb3554985df94e1:parse/"+filepath.Base(path)).Output()
+				if err != nil {
+					continue
+				}
+				f, err := parser.ParseFile(token.NewFileSet(), "baseline.go", old, 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				for _, d := range f.Decls {
+					if fn, ok := d.(*ast.FuncDecl); ok {
+						var b bytes.Buffer
+						format.Node(&b, token.NewFileSet(), fn)
+						unchanged[b.String()] = true
+					}
+				}
+			}
+		}
+		for _, pkg := range packages {
+			globals := map[string]bool{}
+			stateWriters := map[string]map[string]bool{}
+			for _, f := range pkg.Files {
+				imports := map[string]string{}
+				for _, spec := range f.Imports {
+					path, err := strconv.Unquote(spec.Path.Value)
+					if err != nil {
+						t.Fatal(err)
+					}
+					alias := filepath.Base(path)
+					if spec.Name != nil {
+						alias = spec.Name.Name
+					}
+					imports[alias] = path
+				}
+				var storageType func(ast.Expr) string
+				storageType = func(expr ast.Expr) string {
+					switch e := expr.(type) {
+					case *ast.SelectorExpr:
+						if pkg, ok := e.X.(*ast.Ident); ok && imports[pkg.Name] != "" {
+							return imports[pkg.Name] + "." + e.Sel.Name
+						}
+					case *ast.StarExpr:
+						return storageType(e.X)
+					case *ast.ParenExpr:
+						return storageType(e.X)
+					case *ast.UnaryExpr:
+						return storageType(e.X)
+					case *ast.CompositeLit:
+						return storageType(e.Type)
+					case *ast.IndexExpr:
+						return storageType(e.X)
+					case *ast.CallExpr:
+						if id, ok := e.Fun.(*ast.Ident); ok && id.Name == "new" && len(e.Args) == 1 {
+							return storageType(e.Args[0])
+						}
+					}
+					return ""
+				}
+				for _, decl := range f.Decls {
+					gen, ok := decl.(*ast.GenDecl)
+					if !ok || gen.Tok != token.VAR {
+						continue
+					}
+					for _, raw := range gen.Specs {
+						spec := raw.(*ast.ValueSpec)
+						for i, name := range spec.Names {
+							globals[name.Name] = true
+							typ := storageType(spec.Type)
+							if typ == "" && i < len(spec.Values) {
+								typ = storageType(spec.Values[i])
+							}
+							methods := ""
+							if typ == "sync.Map" {
+								methods = "Clear CompareAndDelete CompareAndSwap Delete LoadOrStore Store Swap"
+							} else if strings.HasPrefix(typ, "sync/atomic.") {
+								methods = "Add And CompareAndSwap Or Store Swap"
+							}
+							if methods != "" {
+								stateWriters[name.Name] = map[string]bool{}
+								for _, method := range strings.Fields(methods) {
+									stateWriters[name.Name][method] = true
+								}
+							}
+						}
+					}
+				}
+			}
+			effects := packageEffects(pkg)
+			for _, f := range pkg.Files {
+				for _, decl := range f.Decls {
+					fn, ok := decl.(*ast.FuncDecl)
+					if !ok || fn.Body == nil || fn.Name.Name == "init" {
+						continue
+					}
+					var normalized bytes.Buffer
+					format.Node(&normalized, token.NewFileSet(), fn)
+					if unchanged[normalized.String()] {
+						continue
+					}
+					// Objects defined by package-level ValueSpecs are distinct from local vars.
+					globalObjects := map[*ast.Object]bool{}
+					for _, other := range pkg.Files {
+						for name := range globals {
+							if obj := other.Scope.Lookup(name); obj != nil {
+								globalObjects[obj] = true
+							}
+						}
+					}
+					taintedObjects := map[*ast.Object]bool{}
+					var globalBase func(ast.Expr) bool
+					globalBase = func(e ast.Expr) bool {
+						switch e := e.(type) {
+						case *ast.Ident:
+							if e.Obj != nil {
+								return globalObjects[e.Obj] || taintedObjects[e.Obj]
+							}
+							return globals[e.Name]
+						case *ast.SelectorExpr:
+							return globalBase(e.X)
+						case *ast.IndexExpr:
+							return globalBase(e.X)
+						case *ast.IndexListExpr:
+							return globalBase(e.X)
+						case *ast.SliceExpr:
+							return globalBase(e.X)
+						case *ast.StarExpr:
+							return globalBase(e.X)
+						case *ast.ParenExpr:
+							return globalBase(e.X)
+						}
+						return false
+					}
+
+					// A plain local assignment only rebinds a local variable. It is
+					// the later indexed/field/dereference write that mutates backing
+					// storage. Scalar, struct and array copies are not aliases.
+					var referenceType func(ast.Expr) bool
+					referenceType = func(e ast.Expr) bool {
+						switch e := e.(type) {
+						case *ast.ArrayType:
+							return e.Len == nil
+						case *ast.MapType, *ast.StarExpr, *ast.ChanType:
+							return true
+						case *ast.ParenExpr:
+							return referenceType(e.X)
+						}
+						return false
+					}
+					var referenceValue func(ast.Expr) bool
+					referenceValue = func(e ast.Expr) bool {
+						switch e := e.(type) {
+						case *ast.ParenExpr:
+							return referenceValue(e.X)
+						case *ast.SliceExpr:
+							return globalBase(e.X)
+						case *ast.UnaryExpr:
+							return e.Op == token.AND && globalBase(e.X)
+						case *ast.Ident:
+							if e.Obj != nil && taintedObjects[e.Obj] {
+								return true
+							}
+							if !globalBase(e) {
+								return false
+							}
+							for _, file := range pkg.Files {
+								obj := file.Scope.Lookup(e.Name)
+								if obj == nil {
+									continue
+								}
+								if spec, ok := obj.Decl.(*ast.ValueSpec); ok {
+									if referenceType(spec.Type) {
+										return true
+									}
+									for _, v := range spec.Values {
+										switch v := v.(type) {
+										case *ast.CompositeLit:
+											if referenceType(v.Type) {
+												return true
+											}
+										case *ast.UnaryExpr:
+											if v.Op == token.AND {
+												return true
+											}
+										case *ast.CallExpr:
+											if id, ok := v.Fun.(*ast.Ident); ok && (id.Name == "make" || id.Name == "new") {
+												return true
+											}
+										}
+									}
+								}
+							}
+						}
+						return false
+					}
+					writesGlobal := func(e ast.Expr) bool {
+						for {
+							p, ok := e.(*ast.ParenExpr)
+							if !ok {
+								break
+							}
+							e = p.X
+						}
+						if id, ok := e.(*ast.Ident); ok {
+							return globals[id.Name] && (id.Obj == nil || globalObjects[id.Obj])
+						}
+						return globalBase(e)
+					}
+
+					// Resolve local aliases to package storage to a fixed point so
+					// chained assignments are covered regardless of lexical order.
+					for changed := true; changed; {
+						changed = false
+						ast.Inspect(fn.Body, func(n ast.Node) bool {
+							switch n := n.(type) {
+							case *ast.AssignStmt:
+								for i, lhs := range n.Lhs {
+									id, ok := lhs.(*ast.Ident)
+									if !ok || id.Obj == nil || globalObjects[id.Obj] || i >= len(n.Rhs) {
+										continue
+									}
+									if referenceValue(n.Rhs[i]) && !taintedObjects[id.Obj] {
+										taintedObjects[id.Obj] = true
+										changed = true
+									}
+								}
+							case *ast.DeclStmt:
+								gen, ok := n.Decl.(*ast.GenDecl)
+								if !ok || gen.Tok != token.VAR {
+									break
+								}
+								for _, spec := range gen.Specs {
+									valueSpec := spec.(*ast.ValueSpec)
+									for i, id := range valueSpec.Names {
+										if id.Obj == nil || globalObjects[id.Obj] || i >= len(valueSpec.Values) {
+											continue
+										}
+										if referenceValue(valueSpec.Values[i]) && !taintedObjects[id.Obj] {
+											taintedObjects[id.Obj] = true
+											changed = true
+										}
+									}
+								}
+							}
+							return true
+						})
+					}
+
+					ast.Inspect(fn.Body, func(n ast.Node) bool {
+						switch n := n.(type) {
+						case *ast.AssignStmt:
+							for _, lhs := range n.Lhs {
+								if writesGlobal(lhs) {
+									t.Errorf("%s.%s writes package state", pkg.Name, fn.Name.Name)
+								}
+							}
+						case *ast.IncDecStmt:
+							if writesGlobal(n.X) {
+								t.Errorf("%s.%s mutates package state", pkg.Name, fn.Name.Name)
+							}
+						case *ast.CallExpr:
+							name, args := effectCall(n)
+							for idx, arg := range args {
+								if effects[name][idx] && globalAddress(arg, globalBase) {
+									t.Errorf("%s.%s writes shared storage through call %s", pkg.Name, fn.Name.Name, name)
+								}
+							}
+							// These standard-library methods mutate receiver storage
+							// without an explicit assignment or address operation in the caller.
+							if sel, ok := n.Fun.(*ast.SelectorExpr); ok && globalBase(sel.X) {
+								ast.Inspect(sel.X, func(part ast.Node) bool {
+									if id, ok := part.(*ast.Ident); ok && stateWriters[id.Name][sel.Sel.Name] {
+										t.Errorf("%s.%s mutates shared storage through %s", pkg.Name, fn.Name.Name, sel.Sel.Name)
+									}
+									return true
+								})
+							}
+							if id, ok := n.Fun.(*ast.Ident); ok && (id.Name == "delete" || id.Name == "clear" || id.Name == "copy") && len(n.Args) > 0 && globalBase(n.Args[0]) {
+								t.Errorf("%s.%s mutates package storage", pkg.Name, fn.Name.Name)
+							}
+						}
+						return true
+					})
+				}
+			}
+		}
+	}
+}
+
+// parserMutationOverlay disables only functions that directly mutate AST node
+// storage in parse. Type information, rather than candidate helper names or
+// filenames, identifies operations. Pure forwarding and read-only context
+// adapters remain executable. These probes perform flattening of an existing
+// tree, so they do not require the parser's legitimate Markdown construction.
+// String operations alone do not establish conversion ownership; the style
+// corpus probes that behavior separately with editor implementations disabled.
+func parserMutationOverlay(t *testing.T, root, dir string) string {
+	t.Helper()
+	cmd := exec.Command("go", "list", "-export", "-json", "-deps", "./parse")
+	cmd.Dir = root
+	output, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("load parse types: %v", err)
+	}
+	exports := map[string]string{}
+	decoder := json.NewDecoder(bytes.NewReader(output))
+	for decoder.More() {
+		var pkg struct{ ImportPath, Export string }
+		if err := decoder.Decode(&pkg); err != nil {
+			t.Fatal(err)
+		}
+		exports[pkg.ImportPath] = pkg.Export
+	}
+	fset := token.NewFileSet()
+	packages, err := parser.ParseDir(fset, filepath.Join(root, "parse"), func(info os.FileInfo) bool {
+		matched, err := build.Default.MatchFile(filepath.Join(root, "parse"), info.Name())
+		return err == nil && matched && !strings.HasSuffix(info.Name(), "_test.go")
+	}, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pkg := packages["parse"]
+	if pkg == nil {
+		t.Fatal("public parse package unavailable")
+	}
+	files := []*ast.File{}
+	for _, f := range pkg.Files {
+		files = append(files, f)
+	}
+	info := &types.Info{Types: map[ast.Expr]types.TypeAndValue{}, Selections: map[*ast.SelectorExpr]*types.Selection{}}
+	config := types.Config{Importer: importer.ForCompiler(fset, "gc", func(path string) (io.ReadCloser, error) { return os.Open(exports[path]) })}
+	if _, err := config.Check("github.com/88250/lute/parse", fset, files, info); err != nil {
+		t.Fatalf("type-check parse intervention: %v", err)
+	}
+	isNode := func(typ types.Type) bool {
+		if p, ok := typ.(*types.Pointer); ok {
+			typ = p.Elem()
+		}
+		n, ok := typ.(*types.Named)
+		return ok && n.Obj().Pkg() != nil && n.Obj().Pkg().Path() == "github.com/88250/lute/ast" && n.Obj().Name() == "Node"
+	}
+	var writesNode func(ast.Expr) bool
+	writesNode = func(expr ast.Expr) bool {
+		switch e := expr.(type) {
+		case *ast.SelectorExpr:
+			return isNode(info.TypeOf(e.X)) || writesNode(e.X)
+		case *ast.IndexExpr:
+			return writesNode(e.X)
+		case *ast.StarExpr:
+			return isNode(info.TypeOf(e.X))
+		case *ast.ParenExpr:
+			return writesNode(e.X)
+		}
+		return false
+	}
+	// These are existing public AST mutation operations, not implementation names.
+	mutators := map[string]bool{"AppendChild": true, "PrependChild": true, "InsertBefore": true, "InsertAfter": true, "Unlink": true, "SetIALAttr": true, "RemoveIALAttr": true, "AppendTokens": true, "PrependTokens": true, "SetTokens": true, "SortTextMarkDataTypes": true}
+	replacements := map[string]string{}
+	for path, f := range pkg.Files {
+		ast.Inspect(f, func(node ast.Node) bool {
+			var body *ast.BlockStmt
+			switch fn := node.(type) {
+			case *ast.FuncDecl:
+				body = fn.Body
+			case *ast.FuncLit:
+				body = fn.Body
+			}
+			if body == nil {
+				return true
+			}
+			mutates := false
+			ast.Inspect(body, func(n ast.Node) bool {
+				if _, nested := n.(*ast.FuncLit); nested {
+					return false
+				}
+				switch e := n.(type) {
+				case *ast.AssignStmt:
+					for _, lhs := range e.Lhs {
+						if writesNode(lhs) {
+							mutates = true
+						}
+					}
+				case *ast.IncDecStmt:
+					if writesNode(e.X) {
+						mutates = true
+					}
+				case *ast.CompositeLit:
+					if isNode(info.TypeOf(e)) {
+						mutates = true
+					}
+				case *ast.CallExpr:
+					if sel, ok := e.Fun.(*ast.SelectorExpr); ok && isNode(info.TypeOf(sel.X)) && mutators[sel.Sel.Name] {
+						mutates = true
+					}
+				}
+				return true
+			})
+			if mutates {
+				body.List = append([]ast.Stmt{&ast.IfStmt{Cond: ast.NewIdent("true"), Body: &ast.BlockStmt{List: []ast.Stmt{&ast.ExprStmt{X: &ast.CallExpr{Fun: ast.NewIdent("panic"), Args: []ast.Expr{&ast.BasicLit{Kind: token.STRING, Value: strconv.Quote("parser owns AST conversion during editor flattening")}}}}}}}}, body.List...)
+			}
+			return true
+		})
+		var out bytes.Buffer
+		if err := format.Node(&out, fset, f); err != nil {
+			t.Fatal(err)
+		}
+		replacement := filepath.Join(dir, fmt.Sprintf("parse-%d.go", len(replacements)))
+		if err := os.WriteFile(replacement, out.Bytes(), 0600); err != nil {
+			t.Fatal(err)
+		}
+		replacements[path] = replacement
+	}
+	data, err := json.Marshal(map[string]any{"Replace": replacements})
+	if err != nil {
+		t.Fatal(err)
+	}
+	overlay := filepath.Join(dir, "parser-overlay.json")
+	if err := os.WriteFile(overlay, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return overlay
+}
