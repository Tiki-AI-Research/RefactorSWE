--- /dev/null
+++ b/verifier_intervention/probe.go
@@ -0,0 +1,45 @@
+package verifier_intervention
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+// Event is only constructed by the verifier's injected transformation-site
+// expression. Arbitrary panics and failed assertions cannot create a receipt.
+type Event struct{ Kind, Nonce string }
+
+func Hit(kind, nonce string) { panic(Event{Kind: kind, Nonce: nonce}) }
+
+func Stop[T any](value T, kind, nonce string) T {
+	panic(Event{Kind: kind, Nonce: nonce})
+}
+
+func Observe(kinds []string, run func()) (hit bool) {
+	wantKind, nonce := os.Getenv("LUTE_INTERVENTION_KIND"), os.Getenv("LUTE_INTERVENTION_NONCE")
+	defer func() {
+		value := recover()
+		if value == nil {
+			return
+		}
+		event, ok := value.(Event)
+		allowed := false
+		for _, kind := range kinds {
+			if kind == wantKind {
+				allowed = true
+			}
+		}
+		if !ok || !allowed || nonce == "" || event.Kind != wantKind || event.Nonce != nonce {
+			panic(value)
+		}
+		data, err := json.Marshal(event)
+		if err != nil {
+			panic(err)
+		}
+		fmt.Println("LUTE_INTERVENTION_V1 " + string(data))
+		hit = true
+	}()
+	run()
+	return false
+}
