index 0000000000000000000000000000000000000000..834759b59f5d8558eb5cdb98f318f59dbf0f2fc4
--- /dev/null
+++ b/editor/ast/inline_span.go
@@ -0,0 +1,308 @@
+// Lute - A structured Markdown engine for Go and JavaScript
+// Copyright (c) 2019-present, b3log.org
+//
+// Lute is licensed under Mulan PSL v2.
+// You can use this software according to the terms and conditions of the Mulan PSL v2.
+// You may obtain a copy of Mulan PSL v2 at:
+//         http://license.coscl.org.cn/MulanPSL2
+// THIS SOFTWARE IS PROVIDED ON AN "AS IS" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY OR FIT FOR A PARTICULAR PURPOSE.
+// See the Mulan PSL v2 for more details.
+
+package editorast
+
+import (
+	"bytes"
+	"strings"
+
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/editor"
+	"github.com/88250/lute/html"
+	"github.com/88250/lute/html/atom"
+	"github.com/88250/lute/lex"
+	"github.com/88250/lute/util"
+)
+
+// SpanOptions carries the parser configuration and callbacks required by the editor inline HTML conversion.
+type SpanOptions struct {
+	VditorWYSIWYG    bool
+	VditorIR         bool
+	VditorSV         bool
+	ProtyleWYSIWYG   bool
+	HTMLTag2TextMark bool
+	KeepEscaped      bool
+	Inline           func(string) *ast.Node
+	IAL2Tokens       func([][]string) []byte
+	Tokens2IAL       func([]byte) [][]string
+}
+
+// InlineHTMLState is the mutable token cursor shared with the parser while converting one inline HTML run.
+type InlineHTMLState struct {
+	Tokens    []byte
+	TokensLen int
+	Pos       int
+}
+
+func ParseInlineHTML(state *InlineHTMLState, opts *SpanOptions) (ret *ast.Node) {
+	tokens := state.Tokens
+	caretInTag := false
+	caretLeftSpace := false
+	if opts.VditorWYSIWYG || opts.VditorIR || opts.VditorSV || opts.ProtyleWYSIWYG {
+		caretIndex := bytes.Index(tokens, editor.CaretTokens)
+		caretInTag = caretIndex > state.Pos
+		if caretInTag {
+			caretLeftSpace = bytes.Contains(tokens, []byte(" "+editor.Caret))
+			tokens = bytes.ReplaceAll(tokens, editor.CaretTokens, []byte(editor.CaretReplacement))
+			tokens = bytes.ReplaceAll(tokens, []byte("\""+editor.CaretReplacement), []byte("\" "+editor.CaretReplacement))
+		}
+	}
+
+	startPos := state.Pos
+	ret = &ast.Node{Type: ast.NodeText, Tokens: []byte{tokens[state.Pos]}}
+	if 3 > state.TokensLen || state.TokensLen <= startPos+1 {
+		state.Pos++
+		return
+	}
+
+	var tags []byte
+	tags = append(tags, tokens[startPos])
+	if lex.ItemSlash == tokens[startPos+1] && 1 < state.TokensLen-(startPos+1) { // a closing tag
+		tags = append(tags, tokens[startPos+1])
+		remains, tagName := ParseTagName(tokens[state.Pos+2:])
+		if 1 > len(tagName) {
+			state.Pos++
+			return
+		}
+		tags = append(tags, tagName...)
+		tokens = remains
+	} else if remains, tagName := ParseTagName(tokens[state.Pos+1:]); 0 < len(tagName) {
+		tags = append(tags, tagName...)
+		tokens = remains
+		for {
+			valid, remains, attr, _, _ := TagAttr(tokens)
+			if !valid {
+				state.Pos++
+				return
+			}
+
+			tokens = remains
+			tags = append(tags, attr...)
+			if 1 > len(attr) {
+				break
+			}
+		}
+	} else if valid, remains, comment := ParseHTMLComment(tokens[state.Pos+1:]); valid {
+		tags = append(tags, comment...)
+		tags = ReplaceCreateTokens(tags, caretInTag, caretLeftSpace, opts)
+		tokens = remains
+		state.Pos += len(tags)
+		ret = &ast.Node{Type: ast.NodeInlineHTML, Tokens: tags}
+		return
+	} else if valid, remains, ins := ParseProcessingInstruction(tokens[state.Pos+1:]); valid {
+		tags = append(tags, ins...)
+		tags = ReplaceCreateTokens(tags, caretInTag, caretLeftSpace, opts)
+		tokens = remains
+		state.Pos += len(tags)
+		ret = &ast.Node{Type: ast.NodeInlineHTML, Tokens: tags}
+		return
+	} else if valid, remains, decl := ParseDeclaration(tokens[state.Pos+1:]); valid {
+		tags = append(tags, decl...)
+		tags = ReplaceCreateTokens(tags, caretInTag, caretLeftSpace, opts)
+		tokens = remains
+		state.Pos += len(tags)
+		ret = &ast.Node{Type: ast.NodeInlineHTML, Tokens: tags}
+		return
+	} else if valid, remains, cdata := ParseCDATA(tokens[state.Pos+1:]); valid {
+		tags = append(tags, cdata...)
+		tags = ReplaceCreateTokens(tags, caretInTag, caretLeftSpace, opts)
+		tokens = remains
+		state.Pos += len(tags)
+		ret = &ast.Node{Type: ast.NodeInlineHTML, Tokens: tags}
+		return
+	} else {
+		state.Pos++
+		return
+	}
+
+	whitespaces, tokens := lex.TrimLeft(tokens)
+	length := len(tokens)
+	if 1 > length {
+		state.Pos = startPos + 1
+		return
+	}
+
+	if (lex.ItemGreater == tokens[0]) ||
+		(1 < length && lex.ItemSlash == tokens[0] && lex.ItemGreater == tokens[1]) {
+		tags = append(tags, whitespaces...)
+		tags = append(tags, tokens[0])
+		if lex.ItemSlash == tokens[0] {
+			tags = append(tags, tokens[1])
+		}
+		tags = ReplaceCreateTokens(tags, caretInTag, caretLeftSpace, opts)
+		state.Pos += len(tags)
+
+		if opts.ProtyleWYSIWYG {
+			if bytes.EqualFold(tags, []byte("<br />")) || bytes.EqualFold(tags, []byte("<br/>")) || bytes.EqualFold(tags, []byte("<br>")) {
+				ret = &ast.Node{Type: ast.NodeBr}
+				return
+			} else if bytes.HasPrefix(tags, []byte("<span data-type=")) {
+				ret = ProcessSpanTag(tags, "<span data-type=", "</span>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<kbd>")) {
+							ret = ProcessSpanTag(tags, "<kbd>", "</kbd>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<u>")) {
+				ret = ProcessSpanTag(tags, "<u>", "</u>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<sup>")) {
+				ret = ProcessSpanTag(tags, "<sup>", "</sup>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<sub>")) {
+				ret = ProcessSpanTag(tags, "<sub>", "</sub>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<mark>")) {
+				ret = ProcessSpanTag(tags, "<mark>", "</mark>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<s>")) {
+				ret = ProcessSpanTag(tags, "<s>", "</s>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<del>")) {
+				ret = ProcessSpanTag(tags, "<del>", "</del>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<strike>")) {
+				ret = ProcessSpanTag(tags, "<strike>", "</strike>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<em>")) {
+				ret = ProcessSpanTag(tags, "<em>", "</em>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<i>")) {
+				ret = ProcessSpanTag(tags, "<i>", "</i>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<strong>")) {
+				ret = ProcessSpanTag(tags, "<strong>", "</strong>", state, opts)
+				return
+			} else if bytes.EqualFold(tags, []byte("<b>")) {
+				ret = ProcessSpanTag(tags, "<b>", "</b>", state, opts)
+				return
+			} else if bytes.HasPrefix(bytes.ToLower(tags), []byte("<img ")) {
+				nodes, _ := html.ParseFragment(bytes.NewReader(tags), &html.Node{Type: html.ElementNode})
+				if 1 != len(nodes) {
+					ret = &ast.Node{Type: ast.NodeInlineHTML, Tokens: tags}
+					return
+				}
+				node := nodes[0]
+
+				if atom.Img == node.DataAtom {
+					ret = &ast.Node{Type: ast.NodeImage}
+					ret.AppendChild(&ast.Node{Type: ast.NodeBang})
+					ret.AppendChild(&ast.Node{Type: ast.NodeOpenBracket})
+					if text := util.DomAttrValue(node, "alt"); "" != text {
+						ret.AppendChild(&ast.Node{Type: ast.NodeLinkText, Tokens: []byte(text)})
+					}
+					ret.AppendChild(&ast.Node{Type: ast.NodeCloseBracket})
+					ret.AppendChild(&ast.Node{Type: ast.NodeOpenParen})
+					if src := util.DomAttrValue(node, "src"); "" != src {
+						ret.AppendChild(&ast.Node{Type: ast.NodeLinkDest, Tokens: []byte(src)})
+					}
+					if title := util.DomAttrValue(node, "title"); "" != title {
+						ret.AppendChild(&ast.Node{Type: ast.NodeLinkTitle, Tokens: []byte(title)})
+					}
+					ret.AppendChild(&ast.Node{Type: ast.NodeCloseParen})
+					if width := strings.TrimSpace(util.DomAttrValue(node, "width")); "" != width {
+						if util.IsDigit(width) {
+							width += "px"
+						}
+						style := "width: " + width + ";"
+						ial := &ast.Node{Type: ast.NodeKramdownSpanIAL, Tokens: opts.IAL2Tokens([][]string{{"style", style}})}
+						ret.SetIALAttr("style", style)
+						ret.InsertAfter(ial)
+					} else {
+						if height := strings.TrimSpace(util.DomAttrValue(node, "height")); "" != height {
+							if util.IsDigit(height) {
+								height += "px"
+							}
+							style := "height: " + height + ";"
+							ial := &ast.Node{Type: ast.NodeKramdownSpanIAL, Tokens: opts.IAL2Tokens([][]string{{"style", style}})}
+							ret.SetIALAttr("style", style)
+							ret.InsertAfter(ial)
+						}
+					}
+
+					return
+				}
+				ret = &ast.Node{Type: ast.NodeInlineHTML, Tokens: tags}
+			}
+		}
+		ret = &ast.Node{Type: ast.NodeInlineHTML, Tokens: tags}
+		return
+	}
+
+	state.Pos = startPos + 1
+	return
+}
+
+func ReplaceCreateTokens(tokens []byte, caretInTag, caretLeftSpace bool, opts *SpanOptions) []byte {
+	if (opts.VditorWYSIWYG || opts.VditorIR || opts.VditorSV) && caretInTag || opts.ProtyleWYSIWYG {
+		if !bytes.Contains(tokens, []byte(editor.CaretReplacement+" ")) && !caretLeftSpace {
+			tokens = bytes.ReplaceAll(tokens, []byte("\" "+editor.CaretReplacement), []byte("\""+editor.CaretReplacement))
+		}
+		tokens = bytes.ReplaceAll(tokens, []byte(editor.CaretReplacement), editor.CaretTokens)
+	}
+	return tokens
+}
+
+func ProcessSpanTag(tags []byte, startTag, endTag string, state *InlineHTMLState, opts *SpanOptions) (ret *ast.Node) {
+	remains := state.Tokens[state.Pos:]
+	if 1 > len(remains) {
+		return
+	}
+
+	end := bytes.Index(remains, []byte(endTag))
+	innerStartTagIndex := bytes.Index(remains, []byte(startTag))
+	if (bytes.Contains(remains, []byte(startTag)) && -1 < end && innerStartTagIndex < end) || -1 == end {
+		ret = &ast.Node{Type: ast.NodeInlineHTML, Tokens: tags}
+		return
+	}
+
+	closerLen := len(endTag)
+	endTmp := end + closerLen
+	if len(remains) < endTmp {
+		endTmp = len(remains)
+	}
+	tokens := append(tags, remains[:endTmp]...)
+	nodes, _ := html.ParseFragment(bytes.NewReader(tokens), &html.Node{Type: html.ElementNode})
+	if 1 != len(nodes) {
+		return
+	}
+	node := nodes[0]
+
+	var typ string
+	startTagLen := len(startTag)
+	if "<kbd>" == startTag || "<u>" == startTag || "<sup>" == startTag || "<sub>" == startTag || "<mark>" == startTag || "<s>" == startTag || "<del>" == startTag || "<strike>" == startTag || "<em>" == startTag || "<i>" == startTag || "<strong>" == startTag || "<b>" == startTag {
+		if !opts.HTMLTag2TextMark {
+			ret = &ast.Node{Type: ast.NodeInlineHTML, Tokens: tags}
+			return
+		}
+		typ = node.Data
+		if "b" == typ {
+			typ = "strong"
+		} else if "i" == typ {
+			typ = "em"
+		} else if "del" == typ || "strike" == typ {
+			typ = "s"
+		}
+	} else { // <span data-type="a">
+		typ = string(tags[startTagLen+1:])
+		typ = typ[:strings.Index(typ, "\"")]
+	}
+
+	ret = &ast.Node{Type: ast.NodeTextMark, TextMarkType: typ}
+
+	if nil != node.FirstChild && typ != node.FirstChild.Data && html.ElementNode == node.FirstChild.Type &&
+		util.ContainsStr(node.FirstChild.Data, []string{"sup", "sub", "em", "strong"}) {
+		ret.TextMarkType += " " + node.FirstChild.Data
+	}
+
+	SetTextMarkNode(ret, node, func() bool { return opts.KeepEscaped }, opts.Inline, opts.IAL2Tokens, opts.Tokens2IAL)
+	state.Pos += end + closerLen
+	return
+}
