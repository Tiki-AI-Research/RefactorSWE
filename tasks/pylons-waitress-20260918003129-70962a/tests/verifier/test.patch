+    def test_f2p_write_forbidden_body_suppression_and_warning(self):
+        """Instruction 72:
+        For response statuses that forbid a message body (1xx, 204, 304), data passed
+        to write() MUST NOT be emitted to the channel; the task's content_bytes_written
+        counter MUST still track the ignored bytes, and an ignored-body warning MUST
+        be logged at most once (logged_write_no_body).
+        """
+        channel = DummyChannel()
+        req = DummyParser()
+        task = WSGITask(channel, req)
+        task.logger = DummyLogger()
+
+        write_fn = task.start_response("204 No Content", [])
+        prep = task.prepare_response()
+        self.assertFalse(prep.body_allowed)
+
+        write_fn(b"forbidden_body")
+        self.assertEqual(task.content_bytes_written, len(b"forbidden_body"))
+        self.assertTrue(task.logged_write_no_body)
+        self.assertEqual(len(task.logger.logged), 1)
+        self.assertIn("ignored", task.logger.logged[0])
+        self.assertNotIn(b"forbidden_body", channel.written)
+
+        # Subsequent write tracks bytes but does not log a second warning
+        write_fn(b"extra")
+        self.assertEqual(task.content_bytes_written, len(b"forbidden_body") + len(b"extra"))
+        self.assertEqual(len(task.logger.logged), 1)
+        self.assertNotIn(b"extra", channel.written)
