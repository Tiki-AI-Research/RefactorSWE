+    def test_f2p_chunked_body_uppercase_hex_framing(self):
+        """Instruction 70:
+        When chunked transfer encoding is active, body data written to the channel MUST encode chunk
+        sizes in uppercase hexadecimal followed by CRLF (\\r\\n), the payload bytes, and CRLF.
+        Calling finish() on a chunked task MUST emit the terminal chunk b"0\\r\\n\\r\\n".
+        """
+        channel = DummyChannel()
+        req = DummyParser()
+        req.version = "1.1"
+        task = WSGITask(channel, req)
+        # No content-length declared on HTTP/1.1 -> chunked
+        write_fn = task.start_response("200 OK", [])
+        prep = task.prepare_response()
+        self.assertTrue(prep.chunked)
+
+        # 10 bytes -> uppercase hex 'A'
+        write_fn(b"1234567890")
+        expected_chunk1 = b"A\r\n1234567890\r\n"
+        self.assertIn(expected_chunk1, channel.written)
+
+        # 26 bytes -> uppercase hex '1A' (not '1a')
+        write_fn(b"a" * 26)
+        expected_chunk2 = b"1A\r\n" + (b"a" * 26) + b"\r\n"
+        self.assertIn(expected_chunk2, channel.written)
+
+        # finish() emits terminal chunk
+        task.finish()
+        self.assertTrue(channel.written.endswith(b"0\r\n\r\n"))
