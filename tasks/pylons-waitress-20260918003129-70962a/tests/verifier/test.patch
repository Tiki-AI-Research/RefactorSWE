+    def test_f2p_headers_canonical_casing_and_lexicographical_sorting(self):
+        """Instruction 54:
+        Serialized response heads (header_bytes) MUST format status line as HTTP/<version> <status>,
+        apply canonical hyphenated title-casing to header names, sort headers lexicographically
+        by normalized header name while preserving relative order for duplicate header names,
+        and terminate with exactly one empty CRLF line (\\r\\n\\r\\n).
+        """
+        channel = DummyChannel()
+        req = DummyParser()
+        req.version = "1.1"
+        task = Task(channel, req)
+        task.status = "200 OK"
+        task.content_length = 0
+        task.response_headers = [
+            ("content-type", "text/plain"),
+            ("x-custom-b", "first"),
+            ("a-custom", "val"),
+            ("x-custom-b", "second"),
+        ]
+        prep = task.prepare_response()
+        self.assertTrue(prep.header_bytes.startswith(b"HTTP/1.1 200 OK\r\n"))
+        self.assertTrue(prep.header_bytes.endswith(b"\r\n\r\n"))
+        self.assertEqual(prep.header_bytes.count(b"\r\n\r\n"), 1)
+
+        header_names = [k for k, v in prep.headers]
+        # Verify title-casing
+        self.assertIn("A-Custom", header_names)
+        self.assertIn("Content-Type", header_names)
+        self.assertIn("X-Custom-B", header_names)
+        self.assertNotIn("content-type", header_names)
+        self.assertNotIn("a-custom", header_names)
+
+        # Verify lexicographical sort
+        sorted_names = sorted(header_names)
+        self.assertEqual(header_names, sorted_names)
+
+        # Verify relative order of duplicates
+        xcustom_values = [v for k, v in prep.headers if k == "X-Custom-B"]
+        self.assertEqual(xcustom_values, ["first", "second"])
