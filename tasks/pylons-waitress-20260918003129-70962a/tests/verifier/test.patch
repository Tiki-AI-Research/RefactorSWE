+    def test_f2p_content_length_shortfall_head_vs_non_head(self):
+        """Instruction 73:
+        When an application iterable finishes after producing fewer bytes than declared
+        by Content-Length, non-HEAD responses MUST set close_on_finish=True and log
+        a shortfall warning. For HEAD requests, returning fewer bytes than Content-Length
+        MUST NOT set close_on_finish and MUST NOT log this warning.
+        """
+        # Part A: Non-HEAD (GET) shortfall -> close_on_finish=True and warning logged
+        ch_get = DummyChannel()
+        req_get = DummyParser()
+        req_get.version = "1.1"
+        req_get.command = "GET"
+        app_get = lambda env, sr: [sr("200 OK", [("Content-Length", "10")]), b"123"][1:]
+        ch_get.server.application = app_get
+        t_get = WSGITask(ch_get, req_get)
+        t_get.logger = DummyLogger()
+        t_get.execute()
+
+        self.assertTrue(t_get.close_on_finish)
+        self.assertTrue(t_get.prepare_response().close_connection)
+        self.assertEqual(len(t_get.logger.logged), 1)
+        self.assertIn("too few bytes", t_get.logger.logged[0])
+
+        # Part B: HEAD request shortfall -> close_on_finish=False and no warning
+        ch_head = DummyChannel()
+        req_head = DummyParser()
+        req_head.version = "1.1"
+        req_head.command = "HEAD"
+        app_head = lambda env, sr: [sr("200 OK", [("Content-Length", "10")]), b""][1:]
+        ch_head.server.application = app_head
+        t_head = WSGITask(ch_head, req_head)
+        t_head.logger = DummyLogger()
+        t_head.execute()
+
+        self.assertFalse(t_head.close_on_finish)
+        self.assertFalse(t_head.prepare_response().close_connection)
