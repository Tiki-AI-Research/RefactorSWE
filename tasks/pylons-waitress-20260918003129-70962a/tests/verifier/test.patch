+    def test_f2p_headers_date_generation_and_preservation_branches(self):
+        """Instruction 55:
+        For Date: any supplied Date header (including an empty-valued header) MUST be preserved
+        in the response head. If Date is absent or its value is empty, an auto-generated Date header
+        formatted from the task's start_time in standard HTTP date format MUST also be emitted.
+        If a non-empty Date header is supplied, no generated Date header is added.
+        """
+        from waitress.utilities import build_http_date
+
+        channel = DummyChannel()
+        req = DummyParser()
+        req.version = "1.1"
+
+        # Branch 1: Date absent -> auto-generated Date emitted
+        task1 = Task(channel, req)
+        task1.start_time = 1700000000.0
+        task1.content_length = 0
+        prep1 = task1.prepare_response()
+        expected_date = build_http_date(task1.start_time)
+        date_headers1 = [v for k, v in prep1.headers if k == "Date"]
+        self.assertEqual(date_headers1, [expected_date])
+
+        # Branch 2: Empty Date supplied -> preserved AND auto-generated emitted
+        task2 = Task(channel, req)
+        task2.start_time = 1700000000.0
+        task2.content_length = 0
+        task2.response_headers = [("Date", "")]
+        prep2 = task2.prepare_response()
+        date_headers2 = [v for k, v in prep2.headers if k == "Date"]
+        self.assertIn("", date_headers2)
+        self.assertIn(expected_date, date_headers2)
+        self.assertEqual(len(date_headers2), 2)
+
+        # Branch 3: Non-empty Date supplied -> preserved, NO auto-generated added
+        custom_date = "Sun, 06 Nov 1994 08:49:37 GMT"
+        task3 = Task(channel, req)
+        task3.start_time = 1700000000.0
+        task3.content_length = 0
+        task3.response_headers = [("Date", custom_date)]
+        prep3 = task3.prepare_response()
+        date_headers3 = [v for k, v in prep3.headers if k == "Date"]
+        self.assertEqual(date_headers3, [custom_date])
+
+        # Branch 4: Duplicate Date where last is empty -> both preserved, auto-generated Date appended stably
+        task4 = Task(channel, req)
+        task4.start_time = 1700000000.0
+        task4.content_length = 0
+        task4.response_headers = [("Date", custom_date), ("Date", "")]
+        prep4 = task4.prepare_response()
+        date_headers4 = [v for k, v in prep4.headers if k == "Date"]
+        self.assertEqual(date_headers4, [custom_date, "", expected_date])
+
+        # Branch 5: Duplicate Date where last is non-empty -> both preserved, NO auto-generated Date added
+        task5 = Task(channel, req)
+        task5.start_time = 1700000000.0
+        task5.content_length = 0
+        task5.response_headers = [("Date", ""), ("Date", custom_date)]
+        prep5 = task5.prepare_response()
+        date_headers5 = [v for k, v in prep5.headers if k == "Date"]
+        self.assertEqual(date_headers5, ["", custom_date])
