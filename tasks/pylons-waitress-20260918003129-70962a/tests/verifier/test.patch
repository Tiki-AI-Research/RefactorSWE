+        task.start_response("200 OK", [("X-Initial", "1")])
+        with self.assertRaises(AssertionError) as ctx:
+            task.start_response("200 OK", [])
+        self.assertEqual(
+            str(ctx.exception),
+            "start_response called a second time without providing exc_info.",
+        )
+
+        try:
+            raise RuntimeError("test error")
+        except RuntimeError:
+            exc_info = sys.exc_info()
+
+        task.start_response("500 Internal Server Error", [("X-After-Error", "2")], exc_info=exc_info)
+        self.assertEqual(task.status, "500 Internal Server Error")
+        self.assertNotIn(("X-Initial", "1"), task.response_headers)
+        self.assertIn(("X-After-Error", "2"), task.response_headers)
+
+        task.wrote_header = True
+        with self.assertRaises(RuntimeError) as ctx:
+            task.start_response("500 Error", [], exc_info=exc_info)
+        self.assertEqual(str(ctx.exception), "test error")
