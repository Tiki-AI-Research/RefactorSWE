+
+
+class TestRefactorP2P(unittest.TestCase):
+    def test_task_build_response_header_format(self):
+        channel = DummyChannel()
+        request = DummyParser()
+        request.version = "1.1"
+        task = Task(channel, request)
+        task.status = "200 OK"
+        task.content_length = 0
+        header_bytes = task.build_response_header()
+        self.assertTrue(header_bytes.startswith(b"HTTP/1.1 200 OK\r\n"))
+        self.assertTrue(header_bytes.endswith(b"\r\n\r\n"))
+
+    def test_task_build_response_header_retains_custom_headers(self):
+        channel = DummyChannel()
+        request = DummyParser()
