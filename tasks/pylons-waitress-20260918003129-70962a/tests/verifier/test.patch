+        - Status 1xx, 204, 304 forbid body (body_allowed=False, content_length=None)
+          even if application provided Content-Length.
+        - Must NOT emit Content-Length or Transfer-Encoding.
+        - Calling write() does not emit data, increments content_bytes_written, and logs logged_write_no_body.
+        - Effective content length: 0 is integer 0 (not None) for 200 OK.
+        """
+        channel = DummyChannel()
+        req = DummyParser()
+        req.version = "1.1"
+
+        task204 = Task(channel, req)
+        task204.status = "204 No Content"
+        task204.content_length = 50
+        task204.response_headers = [
+            ("Content-Length", "50"),
+            ("Transfer-Encoding", "chunked"),
