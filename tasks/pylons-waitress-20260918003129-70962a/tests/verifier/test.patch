+    def test_f2p_response_headers_legacy_ordering_and_equivalence(self):
+        """Instruction 39, 40:
+        - In HTTP/1.1 close + chunked path:
+          * When request provides Connection: close, response_headers MUST follow
+            Connection -> Transfer-Encoding -> Server -> Date order.
+          * When request does not provide Connection, response_headers MUST follow
+            Transfer-Encoding -> Connection -> Server -> Date order.
+        - build_response_header() MUST return bytes identical to header_bytes produced by prepare_response().
+        """
+        # Scenario 1: Request explicitly specifies Connection: close
+        channel = DummyChannel()
+        req = DummyParser()
+        req.version = "1.1"
+        req.headers = {"CONNECTION": "close"}
+        task = Task(channel, req)
+        task.status = "200 OK"
+        task.content_length = None
+
+        prep = task.prepare_response()
+        legacy_bytes = task.build_response_header()
+        self.assertEqual(legacy_bytes, prep.header_bytes)
+
+        header_names = [h[0] for h in task.response_headers]
+        self.assertEqual(
+            header_names,
+            ["Connection", "Transfer-Encoding", "Server", "Date"],
+            "Legacy response_headers with incoming Connection: close must follow "
+            "Connection -> Transfer-Encoding -> Server -> Date order",
+        )
+        conn_idx = header_names.index("Connection")
+        te_idx = header_names.index("Transfer-Encoding")
+        self.assertLess(
+            conn_idx,
+            te_idx,
+            "Connection header must appear before Transfer-Encoding header in legacy response_headers",
+        )
+
+        # Scenario 2: Request does not specify Connection header
+        channel2 = DummyChannel()
+        req2 = DummyParser()
+        req2.version = "1.1"
+        req2.headers = {}
+        task2 = Task(channel2, req2)
+        task2.status = "200 OK"
+        task2.content_length = None
+
+        prep2 = task2.prepare_response()
+        legacy_bytes2 = task2.build_response_header()
+        self.assertEqual(legacy_bytes2, prep2.header_bytes)
+
+        header_names2 = [h[0] for h in task2.response_headers]
+        self.assertEqual(
+            header_names2,
+            ["Transfer-Encoding", "Connection", "Server", "Date"],
+            "Legacy response_headers without incoming Connection header must follow "
+            "Transfer-Encoding -> Connection -> Server -> Date order",
+        )
+        te_idx2 = header_names2.index("Transfer-Encoding")
+        conn_idx2 = header_names2.index("Connection")
+        self.assertLess(
+            te_idx2,
+            conn_idx2,
+            "Transfer-Encoding header must appear before Connection header in legacy response_headers without incoming Connection",
+        )
