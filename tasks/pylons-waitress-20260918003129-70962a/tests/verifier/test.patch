+        prep204 = task204.prepare_response()
+
+        self.assertFalse(prep204.body_allowed)
+        self.assertFalse(prep204.chunked)
+        self.assertIsNone(prep204.content_length)
+        self.assertNotIn(b"Content-Length", prep204.header_bytes)
+        self.assertNotIn(b"Transfer-Encoding", prep204.header_bytes)
+        self.assertNotIn("Content-Length", [k for k, v in prep204.headers])
+        self.assertNotIn("Transfer-Encoding", [k for k, v in prep204.headers])
+
+        # build_response_header() consistency check
