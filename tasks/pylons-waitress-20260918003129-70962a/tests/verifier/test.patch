+    def test_f2p_read_only_file_based_buffer_nonzero_and_zero_size(self):
+        """Instruction 77:
+        When an application returns a ReadOnlyFileBasedBuffer whose prepared size is
+        non-zero, effective content length MUST be reconciled with that size, response
+        headers emitted, and underlying file resource remains open until response
+        consumption finishes. When prepared size is zero, falls back to standard
+        iterable handling and buffer closed upon task completion.
+        """
+        import os
+        import tempfile
+        from waitress.buffers import ReadOnlyFileBasedBuffer
+
+        # Non-zero size buffer
+        with tempfile.NamedTemporaryFile(delete=False) as tf:
+            tf.write(b"file buffer sample content")
+            tf_name = tf.name
+
+        try:
+            f = open(tf_name, "rb")
+            buf = ReadOnlyFileBasedBuffer(f, block_size=1024)
+            ch = DummyChannel()
+            req = DummyParser()
+            # Application supplies mismatched Content-Length: 9999 and returns buffer directly
+            def app_buf(env, sr):
+                sr("200 OK", [("Content-Length", "9999")])
+                return buf
+            ch.server.application = app_buf
+            task = WSGITask(ch, req)
+            task.execute()
+
+            self.assertEqual(task.content_length, len(b"file buffer sample content"))
+            self.assertEqual(task.prepare_response().content_length, len(b"file buffer sample content"))
+            self.assertTrue(task.wrote_header)
+            self.assertIn(buf, ch.otherdata)
+            self.assertFalse(f.closed)  # File remains open!
+
+            # Channel cleanup closes buffer and underlying file
+            buf.close()
+            self.assertTrue(f.closed)
+        finally:
+            if os.path.exists(tf_name):
+                os.remove(tf_name)
+
+        # Zero size buffer
+        with tempfile.NamedTemporaryFile(delete=False) as tf_zero:
+            tf_zero_name = tf_zero.name
+
+        try:
+            f_zero = open(tf_zero_name, "rb")
+            buf_zero = ReadOnlyFileBasedBuffer(f_zero, block_size=1024)
+            ch_zero = DummyChannel()
+            req_zero = DummyParser()
+            def app_zero(env, sr):
+                sr("200 OK", [])
+                return buf_zero
+            ch_zero.server.application = app_zero
+            task_zero = WSGITask(ch_zero, req_zero)
+            task_zero.execute()
+
+            # Buffer closed upon task completion
+            self.assertTrue(f_zero.closed)
+            self.assertIsNone(task_zero.prepare_response().content_length)
+        finally:
+            if os.path.exists(tf_zero_name):
+                os.remove(tf_zero_name)
+
+        # Failure path: response headers emitted, buffer delegation to channel fails -> task cleans up and closes file
+        with tempfile.NamedTemporaryFile(delete=False) as tf_fail:
+            tf_fail.write(b"fail sample content")
+            tf_fail_name = tf_fail.name
+        try:
+            f_fail = open(tf_fail_name, "rb")
+            buf_fail = ReadOnlyFileBasedBuffer(f_fail, block_size=1024)
+            ch_fail = DummyChannel()
+            orig_write_soon = ch_fail.write_soon
+
+            def failing_write_soon(data):
+                if isinstance(data, ReadOnlyFileBasedBuffer):
+                    raise OSError("socket write failed on buffer delegation")
+                return orig_write_soon(data)
+
+            ch_fail.write_soon = failing_write_soon
+            req_fail = DummyParser()
+
+            def app_fail(env, sr):
+                sr("200 OK", [])
+                return buf_fail
+
+            ch_fail.server.application = app_fail
+            task_fail = WSGITask(ch_fail, req_fail)
+            with self.assertRaises(OSError) as exc_ctx:
+                task_fail.execute()
+            self.assertIn("socket write failed on buffer delegation", str(exc_ctx.exception))
+            self.assertTrue(task_fail.wrote_header, "Response headers must be emitted before buffer delegation")
+            self.assertTrue(f_fail.closed, "File must be closed in task finally block when buffer delegation fails")
+        finally:
+            if not f_fail.closed:
+                f_fail.close()
+            if os.path.exists(tf_fail_name):
+                os.remove(tf_fail_name)
+
+    def test_f2p_closeable_iterable_invoked_exactly_once(self):
+        """Instruction 78:
+        For all other closeable iterables providing a close() method, close() MUST
+        be invoked exactly once upon task completion across all normal and error paths.
+        """
+        class TrackingCloseableIter:
+            def __init__(self, should_fail=False):
+                self.should_fail = should_fail
+                self.close_calls = 0
+
+            def __iter__(self):
+                yield b"chunk1"
+                if self.should_fail:
+                    raise RuntimeError("iteration error")
+                yield b"chunk2"
+
+            def close(self):
+                self.close_calls += 1
+
+        # Normal path
+        it_normal = TrackingCloseableIter(should_fail=False)
+        ch1 = DummyChannel()
+        req1 = DummyParser()
+        def app_normal(env, sr):
+            sr("200 OK", [("Content-Length", "12")])
+            return it_normal
+        ch1.server.application = app_normal
+        t1 = WSGITask(ch1, req1)
+        t1.execute()
+        self.assertEqual(it_normal.close_calls, 1)
+        self.assertEqual(t1.prepare_response().content_length, 12)
+
+        # Error path
+        it_err = TrackingCloseableIter(should_fail=True)
+        ch2 = DummyChannel()
+        req2 = DummyParser()
+        def app_err(env, sr):
+            sr("200 OK", [("Content-Length", "12")])
+            return it_err
+        ch2.server.application = app_err
+        t2 = WSGITask(ch2, req2)
+        with self.assertRaises(RuntimeError) as ctx_err:
+            t2.execute()
+        self.assertEqual(it_err.close_calls, 1)
+        self.assertEqual(t2.prepare_response().content_length, 12)
+        self.assertIn("iteration error", str(ctx_err.exception))
+
+    def test_f2p_error_task_full_attributes_and_lifecycle(self):
+        """Instruction 81:
+        ErrorTask instances MUST follow the unified response lifecycle, preserving
+        their status code, generated body, Content-Type: text/plain; charset=utf-8,
+        content length, server identity, and mandatory Connection: close across both
+        HTTP/1.0 and HTTP/1.1 requests.
+        """
+        channel = DummyChannel()
+        channel.server.adj.ident = "custom-waitress-test"
+        req = DummyParser()
+        req.version = "1.1"
+
+        err = Error("Internal error description")
+        err.code = 500
+        err.reason = "Internal Server Error"
+        req.error = err
+
+        expected_status, expected_headers, expected_body = err.to_response("custom-waitress-test")
+
+        task = ErrorTask(channel, req)
+        task.execute()
+
+        self.assertEqual(task.status, expected_status)
+        self.assertEqual(task.content_length, len(expected_body))
+        self.assertTrue(task.close_on_finish)
+
+        task_prep = ErrorTask(channel, req)
+        task_prep.status = expected_status
+        task_prep.response_headers.extend(expected_headers)
+        task_prep.content_length = len(expected_body)
+        # Verify ErrorTask independently enforces close_connection without requiring prior execute() or manual set_close_on_finish()
+        prep = task_prep.prepare_response()
+        self.assertEqual(prep.status, expected_status)
+        self.assertEqual(prep.content_length, len(expected_body))
+        self.assertTrue(prep.close_connection)
+
+        def header_value(prepared, name):
+            return next(
+                (
+                    value
+                    for header_name, value in prepared.headers
+                    if header_name.lower() == name.lower()
+                ),
+                None,
+            )
+
+        self.assertEqual(header_value(prep, "Content-Type"), "text/plain; charset=utf-8")
+        self.assertEqual(header_value(prep, "Content-Length"), str(len(expected_body)))
+        self.assertEqual(header_value(prep, "Server"), "custom-waitress-test")
+        self.assertEqual(header_value(prep, "Connection"), "close")
+
+        # Channel output has header and body
+        self.assertIn(b"HTTP/1.1 500 Internal Server Error\r\n", channel.written)
+        self.assertIn(b"Content-Type: text/plain; charset=utf-8\r\n", channel.written)
+        self.assertIn(b"Content-Length: " + str(len(expected_body)).encode("ascii") + b"\r\n", channel.written)
+        self.assertIn(b"Server: custom-waitress-test\r\n", channel.written)
+        self.assertIn(b"Connection: close\r\n", channel.written)
+        self.assertTrue(channel.written.endswith(expected_body))
+
+    def test_f2p_task_service_oserror_socket_logging_branches(self):
+        """Instruction 82:
+        When an OSError occurs during task servicing (service()), close_on_finish MUST
+        be set to True; if channel.adj.log_socket_errors is true, the OSError MUST be
+        re-raised; if false, it MUST NOT be re-raised and task servicing MUST conclude cleanly.
+        """
+        from unittest.mock import Mock
+
+        # Branch 1: log_socket_errors = True -> close_on_finish=True AND re-raises
+        ch1 = DummyChannel()
+        ch1.adj = DummyAdj()
+        ch1.adj.log_socket_errors = True
+        t1 = Task(ch1, DummyParser())
+        t1.execute = Mock(side_effect=OSError("connection reset by peer"))
+
+        with self.assertRaises(OSError) as ctx_os:
+            t1.service()
+        self.assertTrue(t1.close_on_finish)
+        self.assertTrue(t1.prepare_response().close_connection)
+        self.assertIn("connection reset by peer", str(ctx_os.exception))
+
+        # Branch 2: log_socket_errors = False -> close_on_finish=True AND suppressed
+        ch2 = DummyChannel()
+        ch2.adj = DummyAdj()
+        ch2.adj.log_socket_errors = False
+        t2 = Task(ch2, DummyParser())
+        t2.execute = Mock(side_effect=OSError("connection reset by peer"))
+
+        t2.service()  # Does NOT raise
+        self.assertTrue(t2.close_on_finish)
+        self.assertTrue(t2.prepare_response().close_connection)
