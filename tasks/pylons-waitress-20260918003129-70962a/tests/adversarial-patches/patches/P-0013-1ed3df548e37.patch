+##############################################################################
+"""Response modeling, preparation, framing, and header serialization."""
+
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Sequence, Tuple, Union
+
+from .utilities import build_http_date
+
+HOP_BY_HOP_HEADERS = frozenset(
+    (
+        "connection",
+        "keep-alive",
+        "proxy-authenticate",
+        "proxy-authorization",
+        "te",
+        "trailer",
+        "transfer-encoding",
+        "upgrade",
+    )
+)
+
+
+def is_hop_by_hop(header_name: str) -> bool:
+    """Return True if the given header name is a hop-by-hop header."""
+    return header_name.lower() in HOP_BY_HOP_HEADERS
+
+
+def canonical_header_name(header_name: str) -> str:
+    """Return canonical hyphenated title-cased header name (e.g., Content-Type)."""
+    return "-".join([part.capitalize() for part in header_name.split("-")])
+
+
+def is_body_allowed(status: Optional[str]) -> bool:
+    """Determine whether the response status code permits a message body.
+
+    RFC 7230: MUST NOT send a body for any response with a status code of
+    1xx (Informational), 204 (No Content), or 304 (Not Modified).
+    """
+    if not status:
+        return True
+    status_code = status.split(" ", 1)[0]
+    return not (status_code.startswith("1") or status_code in ("204", "304"))
+
+
+@dataclass(frozen=True)
+class PreparedResponse:
+    """Immutable representation of a prepared HTTP response head and metadata.
+
+    Properties:
+        status: The response status string (e.g. '200 OK').
+        version: The effective HTTP version ('1.0' or '1.1').
+        header_bytes: The complete serialized response head bytes, ending in \\r\\n\\r\\n.
+        headers: An ordered tuple of normalized (name, value) string pairs in wire order.
+        body_allowed: Boolean indicating whether the status code permits a message body.
+        chunked: Boolean indicating whether chunked transfer framing is active.
+        close_connection: Boolean indicating whether the connection must close after response.
+        content_length: Effective outgoing integer content length, or None if no effective length.
+        normalized_headers: Normalized headers in declaration order with system headers appended.
+    """
+
+    status: str
+    version: str
+    header_bytes: bytes
+    headers: Tuple[Tuple[str, str], ...]
+    body_allowed: bool
+    chunked: bool
+    close_connection: bool
+    content_length: Optional[int]
+    normalized_headers: Tuple[Tuple[str, str], ...] = ()
+
+    @property
+    def status_code(self) -> int:
+        """Return the numeric status code."""
+        return int(self.status.split(" ", 1)[0])
+
+    @property
+    def reason_phrase(self) -> str:
+        """Return the reason phrase from the status line, or empty string."""
+        parts = self.status.split(" ", 1)
+        return parts[1] if len(parts) > 1 else ""
+
+    def get_header(self, name: str, default: Optional[str] = None) -> Optional[str]:
+        """Return the value of the first header matching name (case-insensitive)."""
+        target = name.lower()
+        for k, v in self.headers:
+            if k.lower() == target:
+                return v
+        return default
+
+    def get_headers(self, name: str) -> List[str]:
+        """Return a list of values for all headers matching name (case-insensitive)."""
+        target = name.lower()
+        return [v for k, v in self.headers if k.lower() == target]
+
+    def to_dict(self) -> Dict[str, Union[str, int, bool, None, Tuple[Tuple[str, str], ...]]]:
+        """Return a dictionary representation of the prepared response metadata."""
+        return {
+            "status": self.status,
+            "version": self.version,
+            "body_allowed": self.body_allowed,
+            "chunked": self.chunked,
+            "close_connection": self.close_connection,
+            "content_length": self.content_length,
+            "headers": self.headers,
+            "normalized_headers": self.normalized_headers,
+        }
+
+    def __repr__(self) -> str:
+        return (
+            f"<PreparedResponse status={self.status!r} version={self.version!r} "
+            f"body_allowed={self.body_allowed} chunked={self.chunked} "
+            f"close_connection={self.close_connection} content_length={self.content_length}>"
+        )
+
+
+class ResponseFraming:
+    """Calculates HTTP framing, chunked encoding, and connection closure rules."""
+
+    @staticmethod
+    def evaluate(
+        version: str,
+        request_connection: str,
+        content_length_established: bool,
+        body_allowed: bool,
+        is_closing: bool,
+        connection_header_present: bool,
+        chunked_te_present: bool = False,
+    ) -> Tuple[bool, bool, List[Tuple[str, str]]]:
+        """Evaluate framing parameters and return headers to add in legacy sequence.
+
+        Returns:
+            (close_connection, chunked, headers_to_add)
+        """
+        req_conn = (request_connection or "").strip().lower()
+        chunked = False
+        headers_to_add: List[Tuple[str, str]] = []
+
+        if version == "1.0":
+            if req_conn == "keep-alive" and content_length_established and not is_closing:
+                close_connection = False
+                if not connection_header_present:
+                    headers_to_add.append(("Connection", "Keep-Alive"))
+                    connection_header_present = True
+            else:
+                close_connection = True
+                if not connection_header_present:
+                    headers_to_add.append(("Connection", "close"))
+                    connection_header_present = True
+        elif version == "1.1":
+            close_connection = is_closing
+
+            # 1. Incoming request with Connection: close triggers set_close_on_finish first
+            if req_conn == "close":
+                close_connection = True
+                if not connection_header_present:
+                    headers_to_add.append(("Connection", "close"))
+                    connection_header_present = True
+
+            # 2. If no content length established, evaluate chunked framing
+            if not content_length_established:
+                if body_allowed:
+                    chunked = True
+                    if not chunked_te_present:
+                        headers_to_add.append(("Transfer-Encoding", "chunked"))
+
+                close_connection = True
+                if not connection_header_present:
+                    headers_to_add.append(("Connection", "close"))
+                    connection_header_present = True
+
+            # 3. If connection was marked for closure (e.g. from task state)
+            if close_connection and not connection_header_present:
+                headers_to_add.append(("Connection", "close"))
+                connection_header_present = True
+        else:
+            raise AssertionError("neither HTTP/1.0 or HTTP/1.1")
+
+        return close_connection, chunked, headers_to_add
+
+
+class ResponseHeaderSerializer:
+    """Formats and serializes HTTP response headers into wire representation."""
+
+    @staticmethod
+    def serialize(
+        version: str,
+        status: Optional[str],
+        headers: Sequence[Tuple[str, str]],
+    ) -> Tuple[bytes, Tuple[Tuple[str, str], ...]]:
+        """Sort headers lexicographically and serialize to Latin-1 bytes with \\r\\n\\r\\n."""
+        # RFC 2616 section 4.2: stable sort by header name preserves order of duplicates
+        effective_status = status if status is not None else "200 OK"
+        sorted_headers = tuple(sorted(headers, key=lambda x: x[0]))
+        first_line = f"HTTP/{version} {effective_status}"
+        next_lines = [f"{k}: {v}" for k, v in sorted_headers]
+        lines = [first_line] + next_lines
+        header_text = "\r\n".join(lines) + "\r\n\r\n"
+        return header_text.encode("latin-1"), sorted_headers
+
+
+class ResponsePreparer:
+    """Builds and serializes a PreparedResponse without modifying input state."""
+
+    @classmethod
+    def prepare_response(
+        cls,
+        status: Optional[str],
+        version: str,
+        response_headers: Sequence[Tuple[str, str]],
+        task_content_length: Optional[int] = None,
+        request_connection: str = "",
+        server_ident: Optional[str] = None,
+        start_time: float = 0.0,
+        initial_close_connection: bool = False,
+        has_body: Optional[bool] = None,
+    ) -> PreparedResponse:
+        """Construct a PreparedResponse from response state and request context.
+
+        This method is side-effect-free and does not mutate any arguments.
+        """
+        # Validate version
+        if version not in ("1.0", "1.1"):
+            raise AssertionError("neither HTTP/1.0 or HTTP/1.1")
+
+        effective_status = status if status is not None else "200 OK"
+
+        if has_body is not None:
+            body_allowed = bool(has_body)
+        else:
+            body_allowed = is_body_allowed(effective_status)
+
+        normalized_headers: List[Tuple[str, str]] = []
+        content_length_header_val: Optional[str] = None
+        date_header_val: Optional[str] = None
+        server_header_val: Optional[str] = None
+        connection_headers: List[str] = []
+        transfer_encoding_headers: List[str] = []
+
+        for raw_name, raw_val in response_headers:
+            name = canonical_header_name(raw_name)
+            val = str(raw_val)
+
+            if name == "Content-Length":
+                if body_allowed:
+                    content_length_header_val = val
+                    normalized_headers.append((name, val))
+                else:
+                    # RFC 7230: MUST NOT send Transfer-Encoding or Content-Length
+                    # for any response with a status code of 1xx, 204 or 304.
+                    continue
+            elif name == "Transfer-Encoding":
+                if not body_allowed:
+                    # RFC 7230 §3.3.1: A server MUST NOT send a Transfer-Encoding header field
+                    # in any response with a status code of 1xx (Informational) or 204 (No Content)
+                    # or 304 (Not Modified).
+                    continue
+                transfer_encoding_headers.append(val)
+                normalized_headers.append((name, val))
+            else:
+                if name == "Date":
+                    date_header_val = val
+                elif name == "Server":
+                    server_header_val = val
+                elif name == "Connection":
+                    connection_headers.append(val)
+                normalized_headers.append((name, val))
+
+        # Determine effective content length
+        effective_content_length: Optional[int] = None
+        if body_allowed:
+            if content_length_header_val is not None:
+                effective_content_length = int(content_length_header_val)
+            elif task_content_length is not None:
+                effective_content_length = int(task_content_length)
+                content_length_header_val = str(effective_content_length)
+                normalized_headers.append(("Content-Length", content_length_header_val))
+        else:
+            effective_content_length = None
+
+        has_established_length = content_length_header_val is not None
+        has_close_header = any("close" in v.lower() for v in connection_headers)
+        is_closing = initial_close_connection or has_close_header
+        has_chunked_te = any("chunked" in v.lower() for v in transfer_encoding_headers)
+
+        # Evaluate framing and append headers in exact legacy sequence
+        close_connection, chunked, framing_headers = ResponseFraming.evaluate(
+            version=version,
+            request_connection=request_connection,
+            content_length_established=has_established_length,
+            body_allowed=body_allowed,
+            is_closing=is_closing,
+            connection_header_present=bool(connection_headers),
+            chunked_te_present=has_chunked_te,
+        )
+
+        normalized_headers.extend(framing_headers)
+
+        # Deduplicate multiple preset/emitted "Transfer-Encoding: chunked" headers if chunked framing is active
+        if chunked:
+            seen_chunked = False
+            reconciled_te: List[Tuple[str, str]] = []
+            for h_name, h_val in normalized_headers:
+                if h_name == "Transfer-Encoding" and "chunked" in h_val.lower():
+                    if not seen_chunked:
+                        reconciled_te.append((h_name, h_val))
+                        seen_chunked = True
+                else:
+                    reconciled_te.append((h_name, h_val))
+            normalized_headers = reconciled_te
+
+        # Reconcile Connection headers under Tier 2 Mandatory Closure and HTTP/1.0 Keep-Alive rules:
+        if close_connection:
+            # Under Tier 2 Mandatory Connection Closure:
+            # Exactly one "Connection: close" MUST be emitted.
+            # Any preset Connection header (such as "Keep-Alive" or duplicate "close")
+            # is superseded/replaced and deduplicated to a single ("Connection", "close").
+            reconciled_headers: List[Tuple[str, str]] = []
+            conn_set = False
+            for h_name, h_val in normalized_headers:
+                if h_name == "Connection":
+                    if not conn_set:
+                        reconciled_headers.append(("Connection", "close"))
+                        conn_set = True
+                else:
+                    reconciled_headers.append((h_name, h_val))
+            if not conn_set:
+                reconciled_headers.append(("Connection", "close"))
+            normalized_headers = reconciled_headers
+        elif version == "1.0":
+            # HTTP/1.0 with keep-alive established:
+            # Exactly one "Connection: Keep-Alive" MUST be emitted.
+            reconciled_headers: List[Tuple[str, str]] = []
+            conn_set = False
+            for h_name, h_val in normalized_headers:
+                if h_name == "Connection":
+                    if not conn_set:
+                        reconciled_headers.append(("Connection", "Keep-Alive"))
+                        conn_set = True
+                else:
+                    reconciled_headers.append((h_name, h_val))
+            if not conn_set:
+                reconciled_headers.append(("Connection", "Keep-Alive"))
+            normalized_headers = reconciled_headers
+
+        # Date, Server, and Via handling
+        # Preserves any supplied Server (including "")
+        ident = server_ident
+        if not server_header_val:
+            if ident:
+                normalized_headers.append(("Server", ident))
+        else:
+            normalized_headers.append(("Via", ident or "waitress"))
+
+        # Preserves any supplied Date (including ""); adds auto-generated if absent or empty
+        if not date_header_val:
+            normalized_headers.append(("Date", build_http_date(start_time)))
+
+        # Serialize
+        header_bytes, wire_headers = ResponseHeaderSerializer.serialize(
+            version=version,
+            status=effective_status,
+            headers=normalized_headers,
+        )
+
+        return PreparedResponse(
+            status=effective_status,
+            version=version,
+            header_bytes=header_bytes,
+            headers=wire_headers,
+            body_allowed=body_allowed,
+            chunked=chunked,
+            close_connection=close_connection,
+            content_length=effective_content_length,
+            normalized_headers=tuple(normalized_headers),
+        )
