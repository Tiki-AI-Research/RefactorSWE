+++ b/kivymd/tests/datepicker/test_p2p_row_selection.py
@@ -0,0 +1,247 @@
+"""
+P2P regression check: month and year list row selection.
+
+Selecting a month row applies the currently displayed year with the chosen
+1-based month, dispatches ``on_select_month`` with that month number and marks
+the row selected; selecting a year row applies the chosen year with the
+currently selected month, dispatches ``on_select_year`` with that integer year
+and marks the row selected.  The list data's ``selected`` flag tracks the row
+state and a single touch emits at most one such event.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+import time
+
+from kivy.animation import Animation
+from kivy.clock import Clock
+from kivy.input.motionevent import MotionEvent
+
+from kivymd.app import MDApp
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class FakeTouch(MotionEvent):
+    """Minimal touch used to release a list row."""
+
+    def __init__(self, pos=(0, 0)):
+        super().__init__(device="fake", id="fake", args={}, is_touch=True)
+        self.x, self.y = pos
+        self.pos = pos
+
+
+class PollingApp(MDApp):
+    """Drives ``plan()`` inside the Kivy event loop, polling each step."""
+
+    step_timeout = 20.0
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._plan = self.plan()
+        self._wait = None
+        self._deadline = 0.0
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _poll(self, *args):
+        if self._wait is not None and not self._wait():
+            if time.monotonic() > self._deadline:
+                raise AssertionError(
+                    "step timed out after %s seconds" % self.step_timeout
+                )
+            return
+        try:
+            self._wait = next(self._plan)
+        except StopIteration:
+            Clock.unschedule(self._tick)
+            self.stop()
+            return
+        self._deadline = time.monotonic() + self.step_timeout
+
+    def settle(self, *widgets):
+        """True once no animation is still animating the given widgets."""
+
+        instances = list(Animation._instances)
+        return not any(
+            animation.have_properties_to_animate(widget)
+            for animation in instances
+            for widget in widgets
+        )
+
+    def plan(self):
+        raise NotImplementedError
+
+
+def find_view(recycle_view, predicate):
+    """First rendered row of ``recycle_view`` matching ``predicate``."""
+
+    if not recycle_view.children:
+        return None
+    for view in recycle_view.children[0].children:
+        if predicate(view):
+            return view
+    return None
+
+
+def data_index(recycle_view, key, value):
+    for index, entry in enumerate(recycle_view.data):
+        if entry.get(key) == value:
+            return index
+    raise AssertionError("no data row with %s == %r" % (key, value))
+
+
+class RowSelection(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import MDDockedDatePicker, MDModalDatePicker
+
+        docked = MDDockedDatePicker(year=2024, month=1, day=15)
+        modal = MDModalDatePicker(year=2024, month=6, day=10)
+        docked_events = []
+        modal_events = []
+        docked.bind(
+            on_select_month=lambda instance, month: docked_events.append(month)
+        )
+        docked.bind(
+            on_select_year=lambda instance, year: docked_events.append(year)
+        )
+        modal.bind(
+            on_select_month=lambda instance, month: modal_events.append(month)
+        )
+        modal.bind(
+            on_select_year=lambda instance, year: modal_events.append(year)
+        )
+        docked.open()
+        modal.open()
+        yield lambda: self.settle(
+            docked.ids.calendar_layout, modal.ids.calendar_layout
+        )
+
+        # Show a year that differs from the picked date's year so that the
+        # month row must apply the displayed year, not the picked one.
+        docked.update_calendar(2030, 1)
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        docked.ids.month_selection_items.dispatch("on_open_menu")
+        month_list = docked.ids.month_year_selection_layout
+        yield lambda: find_view(
+            month_list, lambda view: getattr(view, "month_index", 0) == 3
+        ) is not None
+
+        marching = find_view(
+            month_list, lambda view: getattr(view, "month_index", 0) == 3
+        )
+        assert marching.month_year_name == "March"
+        events_before = len(docked_events)
+        touch = FakeTouch((marching.center_x, marching.center_y))
+        marching.on_touch_down(touch)
+        assert docked.year == 2030, "the displayed year is applied"
+        assert docked.month == 3, "the chosen 1-based month is applied"
+        assert docked_events[events_before:] == [3], docked_events[events_before:]
+        assert marching.selected is True
+        assert month_list.data[2]["selected"] is True
+        # A single touch emits at most one selection event.
+        assert len(docked_events) == events_before + 1
+
+        # A second month row re-applies its own month and deselects the first.
+        april = find_view(
+            month_list, lambda view: getattr(view, "month_index", 0) == 4
+        )
+        events_before = len(docked_events)
+        april.on_touch_down(FakeTouch((april.center_x, april.center_y)))
+        assert (docked.year, docked.month) == (2030, 4)
+        assert docked_events[events_before:] == [4]
+        assert april.selected is True
+        assert month_list.data[3]["selected"] is True
+        assert month_list.data[2]["selected"] is False
+        assert marching.selected is False
+
+        # Year rows of the docked list apply their own year and keep the
+        # displayed month; the touched row and the data flag are marked.
+        docked.update_calendar(2030, 9)
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        docked.ids.month_selection_items.dispatch("on_open_menu")
+        yield lambda: self.settle(docked.ids.month_year_selection_layout)
+        docked.ids.year_selection_items.dispatch("on_open_menu")
+        year_list = docked.ids.month_year_selection_layout
+        yield lambda: find_view(
+            year_list, lambda view: getattr(view, "month_year_name", "") == "1920"
+        ) is not None
+        target = find_view(
+            year_list, lambda view: getattr(view, "month_year_name", "") == "1920"
+        )
+        events_before = len(docked_events)
+        target.on_touch_down(FakeTouch((target.center_x, target.center_y)))
+        assert docked.year == 1920, docked.year
+        assert docked.month == 9, docked.month
+        assert docked_events[events_before:] == [1920]
+        assert len(docked_events) == events_before + 1
+        assert target.selected is True
+        assert year_list.data[data_index(year_list, "month_year_name", "1920")][
+            "selected"
+        ] is True
+
+        # Unlike docked rows, modal year rows retain the selected-date month,
+        # even after month navigation changes the displayed month.
+        modal.update_calendar(2030, 9)
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        assert modal.month == 9
+        modal.ids.year_selection_items.dispatch("on_open_menu")
+        modal_list = modal.ids.year_selection_layout
+        yield lambda: find_view(
+            modal_list, lambda view: getattr(view, "text", "") == "1920"
+        ) is not None
+        target = find_view(
+            modal_list, lambda view: getattr(view, "text", "") == "1920"
+        )
+        events_before = len(modal_events)
+        target.on_touch_down(FakeTouch((target.center_x, target.center_y)))
+        assert (modal.year, modal.month) == (1920, 6), (modal.year, modal.month)
+        assert modal_events[events_before:] == [1920]
+        assert len(modal_events) == events_before + 1
+        assert target.selected is True
+        assert modal_list.data[data_index(modal_list, "text", "1920")][
+            "selected"
+        ] is True
+
+        # Month rows of the modal line are not part of its year list, so a
+        # further year row still emits exactly one event.
+        other = find_view(
+            modal_list, lambda view: getattr(view, "text", "") == "1921"
+        )
+        events_before = len(modal_events)
+        other.on_touch_down(FakeTouch((other.center_x, other.center_y)))
+        assert modal.year == 1921
+        assert modal_events[events_before:] == [1921]
+        assert len(modal_events) == events_before + 1
+
+
+        detach(docked, modal)
+
+
+
+if __name__ == "__main__":
+    RowSelection().run()
diff --git a/kivymd/tests/datepicker/test_p2p_variant_parity.py b/kivymd/tests/datepicker/test_p2p_variant_parity.py
