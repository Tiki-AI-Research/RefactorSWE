index 0000000000000000000000000000000000000000..521c13f9982b1428458995f31ed97b1ce1f4891e
--- /dev/null
+++ b/kivymd/tests/datepicker/test_p2p_variant_parity.py
@@ -0,0 +1,213 @@
+"""
+P2P regression check: the docked, modal and modal input lines agree.
+
+Month stepping behaves identically on both variant lines for the same
+releases, the open state of the month/year list stays consistent with what is
+visible on both lines, and the input-based variant reports the same picked
+date as the other lines.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+import time
+
+from kivy.animation import Animation
+from kivy.clock import Clock
+
+from kivymd.app import MDApp
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class PollingApp(MDApp):
+    """Drives ``plan()`` inside the Kivy event loop, polling each step."""
+
+    step_timeout = 20.0
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._plan = self.plan()
+        self._wait = None
+        self._deadline = 0.0
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _poll(self, *args):
+        if self._wait is not None and not self._wait():
+            if time.monotonic() > self._deadline:
+                raise AssertionError(
+                    "step timed out after %s seconds" % self.step_timeout
+                )
+            return
+        try:
+            self._wait = next(self._plan)
+        except StopIteration:
+            Clock.unschedule(self._tick)
+            self.stop()
+            return
+        self._deadline = time.monotonic() + self.step_timeout
+
+    def settle(self, *widgets):
+        """True once no animation is still animating the given widgets."""
+
+        instances = list(Animation._instances)
+        return not any(
+            animation.have_properties_to_animate(widget)
+            for animation in instances
+            for widget in widgets
+        )
+
+    def plan(self):
+        raise NotImplementedError
+
+
+class VariantParity(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import (
+            MDDockedDatePicker,
+            MDModalDatePicker,
+            MDModalInputDatePicker,
+        )
+
+        start = dict(year=2024, month=1, day=15)
+        docked = MDDockedDatePicker(**start)
+        modal = MDModalDatePicker(**start)
+        typed = MDModalInputDatePicker(**start)
+        docked_months = []
+        modal_months = []
+        docked.bind(
+            on_select_month=lambda instance, month: docked_months.append(month)
+        )
+        modal.bind(
+            on_select_month=lambda instance, month: modal_months.append(month)
+        )
+        docked.open()
+        modal.open()
+        typed.open()
+        docked_container = docked.ids.month_selection_items
+        modal_container = modal.ids.year_selection_items
+        calendars = (docked.ids.calendar_layout, modal.ids.calendar_layout)
+        containers = (docked_container, modal_container)
+
+        def settled():
+            return self.settle(*calendars) and self.settle(
+                *[container.ids.menu_selection_button for container in containers]
+            )
+
+        yield settled
+
+        # The same chevron releases move both lines to the same date.
+        trajectory = []
+        for direction in (
+            "next",
+            "next",
+            "prev",
+            "next",
+            "prev",
+            "prev",
+        ):
+            previous = (docked.year, docked.month)
+            docked_container.dispatch("on_release", direction)
+            modal_container.dispatch("on_release", direction)
+            yield lambda prev=previous: (
+                (docked.year, docked.month) != prev
+                and (docked.year, docked.month) == (modal.year, modal.month)
+                and settled()
+            )
+            trajectory.append((docked.year, docked.month))
+            assert docked.month == modal.month
+            assert docked.year == modal.year
+
+        assert trajectory == [
+            (2024, 2),
+            (2024, 3),
+            (2024, 2),
+            (2024, 3),
+            (2024, 2),
+            (2024, 1),
+        ], trajectory
+        assert docked_months == modal_months == [2, 3, 2, 3, 2, 1], (
+            docked_months,
+            modal_months,
+        )
+
+        # Both lines keep the list's open state consistent with what is
+        # visible for repeated presses.
+        for open_state in (True, False, True, False):
+            docked_container.dispatch("on_open_menu")
+            modal_container.dispatch("on_open_menu")
+            yield lambda state=open_state: (
+                (tuple(docked.ids.month_year_selection_layout.size)[0] > 0)
+                is state
+                and (tuple(modal.ids.year_selection_layout.size)[0] > 0)
+                is state
+                and settled()
+            )
+            for picker, container, selection in (
+                (
+                    docked,
+                    docked_container,
+                    docked.ids.month_year_selection_layout,
+                ),
+                (modal, modal_container, modal.ids.year_selection_layout),
+            ):
+                calendar = picker.ids.calendar_layout
+                assert (round(calendar.opacity, 3) == 0.0) is open_state
+                assert (calendar.disabled is True) is open_state
+                assert (
+                    round(calendar.scale_value_x, 3) == 1.1
+                ) is open_state
+                assert (tuple(selection.size)[0] > 0) is open_state
+                assert container.ids.chevron_left.disabled is open_state
+                assert (
+                    round(
+                        container.ids.menu_selection_button.rotate_value_angle, 3
+                    )
+                    == -90.0
+                ) is open_state
+
+        # The input-based variant of the same date reports the same date and
+        # the same text as the other lines.
+        typed.ids.input_date_field.text = "01/15/2024"
+        assert typed.get_date() == docked.get_date() == modal.get_date(), (
+            typed.get_date(),
+            docked.get_date(),
+            modal.get_date(),
+        )
+        assert typed.set_text_full_date() == docked.set_text_full_date(), (
+            typed.set_text_full_date(),
+            docked.set_text_full_date(),
+        )
+        assert typed.set_text_full_date() == "Mon, Jan 15"
+
+
+        detach(docked, modal, typed)
+
+
+
+if __name__ == "__main__":
+    VariantParity().run()
diff --git a/kivymd/tests/datepicker/test_p2p_year_bounds.py b/kivymd/tests/datepicker/test_p2p_year_bounds.py
