index 0000000000000000000000000000000000000000..f52a41e2110f1d4e28f8e39892668a72f72d0cb6
--- /dev/null
+++ b/kivymd/tests/datepicker/test_f2p_menu_close_restore_shared.py
@@ -0,0 +1,56 @@
+"""
+F2P acceptance check: one shared implementation restores the calendar.
+
+Closing the month/year menu restores the calendar layout opacity to 1.  On the
+baseline the docked and the modal picker each implemented that write in their
+own toggle.  The restructured picker must perform the close/restore from one
+shared implementation, and the calendar must still be restored on both lines.
+"""
+
+import os
+import sys
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+if _HERE not in sys.path:
+    sys.path.insert(0, _HERE)
+
+import _f2p_selector_support as support  # noqa: E402
+
+
+def main():
+    def probe():
+        docked = support.docked_picker()
+        support.open_docked_menu(docked)
+        docked_chains = support.write_chains(
+            docked.ids.calendar_layout,
+            "opacity",
+            lambda: support.open_docked_menu(docked, state=False),
+        )
+        docked_opacity = round(docked.ids.calendar_layout.opacity, 3)
+
+        modal = support.modal_picker()
+        support.open_modal_menu(modal)
+        modal_chains = support.write_chains(
+            modal.ids.calendar_layout,
+            "opacity",
+            lambda: support.open_modal_menu(modal),
+        )
+        modal_opacity = round(modal.ids.calendar_layout.opacity, 3)
+
+        shared = support.shared_write_functions(docked_chains, modal_chains)
+        support.detach(docked, modal)
+        return docked_opacity, modal_opacity, shared
+
+    docked_opacity, modal_opacity, shared = support.run_probe(probe)
+    assert (docked_opacity, modal_opacity) == (1.0, 1.0), (
+        "closing the menu must still restore the calendar on both lines, got "
+        "docked=%r modal=%r" % (docked_opacity, modal_opacity)
+    )
+    assert shared, (
+        "the calendar restore must be written by one shared implementation on "
+        "both lines, the responsible functions do not overlap"
+    )
+
+
+if __name__ == "__main__":
+    main()
