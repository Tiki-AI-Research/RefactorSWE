--- /dev/null
+++ b/kivymd/tests/datepicker/test_f2p_menu_open_state_shared.py
@@ -0,0 +1,73 @@
+"""The shared menu interaction must toggle both variants repeatedly.
+
+Private state names and storage are implementation choices. Observe the
+calendar's disabled state and opacity instead, and attribute each transition
+to the code that actually performs it. A common outer event wrapper around
+two independent controllers does not establish shared responsibility.
+"""
+
+import os
+import sys
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+if _HERE not in sys.path:
+    sys.path.insert(0, _HERE)
+
+import _f2p_selector_support as support  # noqa: E402
+
+
+def plan():
+    docked = support.docked_picker()
+    modal = support.modal_picker()
+    docked_calendar = docked.ids.calendar_layout
+    modal_calendar = modal.ids.calendar_layout
+    try:
+        for opened in (True, False, True, False):
+            docked_chains = support.write_chains(
+                docked_calendar,
+                "disabled",
+                lambda: docked.ids.month_selection_items.dispatch("on_open_menu"),
+            )
+            modal_chains = support.write_chains(
+                modal_calendar,
+                "disabled",
+                lambda: modal.ids.year_selection_items.dispatch("on_open_menu"),
+            )
+            assert bool(docked_calendar.disabled) is opened, (
+                "successive docked menu events must alternate open and closed"
+            )
+            assert bool(modal_calendar.disabled) is opened, (
+                "successive modal menu events must alternate open and closed"
+            )
+            assert support.shared_write_functions(docked_chains, modal_chains), (
+                "both menu transitions must be carried out by shared code, "
+                "rather than independent controllers behind a common wrapper"
+            )
+            # Wait for actual animations, then assert their final values. A
+            # wrong stable value must fail immediately instead of timing out.
+            def settled():
+                return not any(
+                    animation.have_properties_to_animate(calendar)
+                    for animation in list(support.Animation._instances)
+                    for calendar in (docked_calendar, modal_calendar)
+                )
+            yield settled
+            assert all(
+                abs(calendar.opacity - (0 if opened else 1)) < 0.001
+                and abs(calendar.scale_value_x - (1.1 if opened else 1)) < 0.001
+                and abs(calendar.scale_value_y - (1.1 if opened else 1)) < 0.001
+                for calendar in (docked_calendar, modal_calendar)
+            ), {"opened": opened, "values": [
+                {key: getattr(calendar, key) for key in ("opacity", "scale_value_x", "scale_value_y", "disabled")}
+                for calendar in (docked_calendar, modal_calendar)
+            ]}
+    finally:
+        support.detach(docked, modal)
+
+
+def main():
+    support.run_plan(plan)
+
+
+if __name__ == "__main__":
+    main()
