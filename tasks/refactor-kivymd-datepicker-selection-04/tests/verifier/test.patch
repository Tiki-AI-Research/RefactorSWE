@@ -0,0 +1,60 @@
+"""
+F2P acceptance check: one shared implementation disables the chevrons.
+
+Opening the month/year menu disables the left chevron of the selection
+container.  On the baseline the docked and the modal picker each implemented
+that write in their own toggle.  The restructured picker must perform the
+write from one shared implementation, and the chevrons must still be disabled
+on both lines.
+"""
+
+import os
+import sys
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+if _HERE not in sys.path:
+    sys.path.insert(0, _HERE)
+
+import _f2p_selector_support as support  # noqa: E402
+
+
+def main():
+    def probe():
+        docked = support.docked_picker()
+        docked_chevron = docked.ids.month_selection_items.ids.chevron_left
+        docked_chains = support.write_chains(
+            docked_chevron,
+            "disabled",
+            lambda: support.open_docked_menu(docked),
+        )
+        docked_disabled = docked_chevron.disabled
+
+        modal = support.modal_picker()
+        modal_chevron = modal.ids.year_selection_items.ids.chevron_left
+        modal_chains = support.write_chains(
+            modal_chevron,
+            "disabled",
+            lambda: support.open_modal_menu(modal),
+        )
+        modal_disabled = modal_chevron.disabled
+
+        shared = support.shared_write_functions(docked_chains, modal_chains)
+        support.detach(docked, modal)
+        return docked_disabled, modal_disabled, shared
+
+    docked_disabled, modal_disabled, shared = support.run_probe(probe)
+    assert docked_disabled is True, (
+        "the docked chevron must still be disabled while the menu is open"
+    )
+    assert modal_disabled is True, (
+        "the modal chevron must still be disabled while the menu is open"
+    )
+    assert shared, (
+        "the chevron disabled state must be written by one shared "
+        "implementation on both lines, the responsible functions do not "
+        "overlap"
+    )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/kivymd/tests/datepicker/test_f2p_menu_open_expansion_shared.py b/kivymd/tests/datepicker/test_f2p_menu_open_expansion_shared.py
new file mode 100644
index 0000000000000000000000000000000000000000..f21ee6544c1d722368980705406e65e80d4aa7ed
--- /dev/null
+++ b/kivymd/tests/datepicker/test_f2p_menu_open_expansion_shared.py
@@ -0,0 +1,51 @@
+"""P2P: preserve the explicitly different expansion geometry of both variants.
+
+The legacy filename is retained for provenance. The instruction permits free
+helper/composition choices and explicitly gives different geometry formulas.
+The remaining eight F2P nodes check shared interaction responsibilities; this
+node does not impose a shared size writer or a particular call graph.
+"""
+import os
+import sys
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from kivy.metrics import dp
+import _f2p_selector_support as support
+
+
+def rounded(size):
+    return tuple(round(value, 4) for value in size)
+
+
+def settled():
+    return not support.Animation._instances
+
+
+def plan():
+    for modal in (False, True):
+        picker = support.modal_picker() if modal else support.docked_picker()
+        try:
+            picker.open()
+            yield settled
+            layout = picker.ids['year_selection_layout' if modal else 'month_year_selection_layout']
+            assert rounded(layout.size) == (0.0, 0.0)
+            if modal:
+                support.open_modal_menu(picker)
+            else:
+                support.open_docked_menu(picker)
+            yield settled
+            calendar = picker.ids.calendar_layout
+            expected = ((calendar.width - dp(36), calendar.height) if modal else
+                        (picker.width, picker.height - picker.ids.month_year_selection_items_container.height - dp(56)))
+            assert rounded(layout.size) == rounded(expected), (modal, tuple(layout.size), expected)
+            if modal:
+                support.open_modal_menu(picker)
+            else:
+                support.open_docked_menu(picker, state=False)
+            yield settled
+            assert rounded(layout.size) == (0.0, 0.0), (modal, tuple(layout.size))
+        finally:
+            support.detach(picker)
+
+
+if __name__ == '__main__':
+    support.run_plan(plan)
