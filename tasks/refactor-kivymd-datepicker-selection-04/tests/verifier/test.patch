index 0000000000000000000000000000000000000000..250c9505bde88d0cfdf5f8e3228a9122791b599a
--- /dev/null
+++ b/kivymd/tests/datepicker/test_p2p_change_month.py
@@ -0,0 +1,181 @@
+"""
+P2P regression check: ``change_month`` and ``update_calendar`` semantics.
+
+``change_month`` keeps its string flag, moves the displayed month by exactly
+one, wraps across year boundaries, clamps the year so it never drops below 1,
+steps backwards for any other flag value and dispatches ``on_select_month``
+with the resulting 1-based month number.  ``update_calendar`` refreshes the
+displayed calendar and its label without emitting selection events.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+from datetime import date
+
+from kivy.clock import Clock
+
+from kivymd.app import MDApp
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    from kivy.animation import Animation
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class ChangeMonthApp(MDApp):
+    """Runs the synchronous regression checks inside the Kivy event loop."""
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        Clock.schedule_once(self.run_checks_and_stop, 0)
+
+    def run_checks_and_stop(self, *args):
+        try:
+            self.run_checks()
+        finally:
+            self.stop()
+
+    def run_checks(self):
+        raise NotImplementedError
+
+
+def visible_days(picker):
+    """Day numbers currently rendered on the picker's calendar grid."""
+
+    from kivymd.uix.pickers.datepicker.datepicker import (
+        MDDatePickerDaySelectableItem,
+    )
+
+    days = []
+    for child in picker.ids.calendar_layout.children:
+        if isinstance(child, MDDatePickerDaySelectableItem) and child.text:
+            days.append(int(child.text))
+    return sorted(days)
+
+
+class ChangeMonthSemantics(ChangeMonthApp):
+    def run_checks(self):
+        from kivymd.uix.pickers import MDDockedDatePicker
+
+        picker = MDDockedDatePicker(year=2024, month=1, day=15)
+        months = []
+        years = []
+        days = []
+        picker.bind(on_select_month=lambda instance, month: months.append(month))
+        picker.bind(on_select_year=lambda instance, year: years.append(year))
+        picker.bind(on_select_day=lambda instance, day: days.append(day))
+
+        # "next" advances exactly one month and dispatches the 1-based month.
+        assert picker.change_month("next") is None
+        assert (picker.year, picker.month) == (2024, 2)
+        assert months == [2], months
+        assert visible_days(picker) == list(range(1, 30)), "February 2024"
+        assert (picker.sel_year, picker.sel_month, picker.sel_day) == (
+            2024,
+            1,
+            15,
+        ), "stepping must not change the picked date"
+
+        # "prev" steps back exactly one month.
+        picker.change_month("prev")
+        assert (picker.year, picker.month) == (2024, 1)
+        assert months == [2, 1], months
+        assert visible_days(picker) == list(range(1, 32)), "January 2024"
+
+        # December wraps to January of the next year, January wraps back.
+        picker.update_calendar(2024, 12)
+        picker.change_month("next")
+        assert (picker.year, picker.month) == (2025, 1)
+        assert months[-1] == 1
+        picker.change_month("prev")
+        assert (picker.year, picker.month) == (2024, 12)
+        assert months[-1] == 12
+        assert visible_days(picker) == list(range(1, 32))
+
+        # Stepping next and then prev from the same date returns to the
+        # original month and year.
+        picker.update_calendar(2024, 12)
+        picker.change_month("next")
+        picker.change_month("prev")
+        assert (picker.year, picker.month) == (2024, 12)
+
+        # Any other flag keeps stepping backward, as it does today.
+        before = len(months)
+        picker.update_calendar(2024, 3)
+        for flag in ("back", "", "NEXT", None):
+            picker.update_calendar(2024, 3)
+            picker.change_month(flag)
+            assert (picker.year, picker.month) == (2024, 2), flag
+        assert len(months) - before == 4
+        assert all(isinstance(month, int) for month in months)
+
+        # The year is clamped so that it never drops below 1.
+        picker.update_calendar(1, 1)
+        picker.change_month("prev")
+        assert (picker.year, picker.month) == (1, 1)
+        assert months[-1] == 1
+
+        # A year boundary wrap keeps the year consistent both ways.
+        picker.update_calendar(2024, 1)
+        picker.change_month("prev")
+        assert (picker.year, picker.month) == (2023, 12)
+        picker.change_month("next")
+        assert (picker.year, picker.month) == (2024, 1)
+
+        # ``update_calendar`` emits no selection event itself.
+        events_before = (len(months), len(years), len(days))
+        picker.update_calendar(2025, 5)
+        assert (picker.year, picker.month) == (2025, 5)
+        assert (len(months), len(years), len(days)) == events_before
+        assert visible_days(picker) == list(range(1, 32)), "May 2025"
+
+        picker.update_calendar(2023, 2)
+        assert visible_days(picker) == list(range(1, 29)), "February 2023"
+        assert (len(months), len(years), len(days)) == events_before
+
+        # A month with a first day at the end of a week still renders every
+        # day of the displayed month exactly once.
+        picker.update_calendar(2024, 9)
+        assert visible_days(picker) == list(range(1, 31)), "September 2024"
+
+        # ``update_calendar`` accepts plain numbers and refreshes the calendar
+        # without touching the selected date.
+        selection = (picker.sel_year, picker.sel_month, picker.sel_day)
+        picker.update_calendar(2001, 12)
+        assert (picker.year, picker.month) == (2001, 12)
+        assert (picker.sel_year, picker.sel_month, picker.sel_day) == selection
+        assert (len(months), len(years), len(days)) == events_before
+        assert visible_days(picker) == list(range(1, 32))
+        assert date(picker.year, picker.month, 1).isoformat() == "2001-12-01"
+
+
+        detach(picker)
+
+
+
+if __name__ == "__main__":
+    ChangeMonthSemantics().run()
