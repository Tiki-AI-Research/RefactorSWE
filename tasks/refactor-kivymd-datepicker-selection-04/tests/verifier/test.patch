+        month_data = docked.ids.month_year_selection_layout.data
+        assert len(month_data) == 12
+        assert [entry["month_index"] for entry in month_data] == list(
+            range(1, 13)
+        )
+        assert month_data[0]["month_year_name"] == "January"
+        assert month_data[2]["month_year_name"] == "March"
+        assert month_data[0]["viewclass"] == "MDDockedDatePickerMenuSelectionItem"
+        assert isinstance(
+            month_data[0]["viewclass"], str
+        )
+        for entry in month_data:
+            assert {
+                "viewclass",
+                "height",
+                "date_picker",
+                "menu_type",
+                "month_year_name",
+                "month_index",
