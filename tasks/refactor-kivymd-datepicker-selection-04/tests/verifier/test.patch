@@ -0,0 +1,38 @@
+"""Isolated public UI probe: no inherited Kivy App/Clock state from other tests."""
+import functools
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+@functools.lru_cache(maxsize=1)
+def observations():
+    here=Path(__file__).parent
+    expected=json.loads((here/"case33-baseline-ui.json").read_text())
+    with tempfile.TemporaryDirectory(prefix="case33-ui-") as temporary:
+        result=Path(temporary)/"observations.json"
+        try:
+            process=subprocess.run([sys.executable,str(here/"_case33_ui_probe.py"),str(result)],capture_output=True,text=True,timeout=180)
+        except subprocess.TimeoutExpired as error:
+            return {"__probe_error__":"isolated public UI probe timed out", "diagnostic":str(error.stderr)[-16000:]},expected
+        if process.returncode:
+            return {"__probe_error__":"isolated public UI probe failed", "exit_code":process.returncode, "diagnostic":process.stderr[-16000:]},expected
+        try:
+            actual=json.loads(result.read_text())
+        except (OSError,ValueError) as error:
+            actual={"__probe_error__":str(error)}
+    return actual,expected
+
+def check(category):
+    actual,expected=observations()
+    if "__probe_error__" in actual:
+        raise RuntimeError(str(actual))
+    if set(actual)!=set(expected):
+        raise RuntimeError("all69 baseline observations must be produced")
+    def selected(key):
+        if category=="direct":return key.startswith("direct")
+        if category=="row":return key.startswith("row/")
+        return not key.startswith(("direct","row/"))
+    differences={k:{"actual":actual[k],"expected":expected[k]} for k in expected if selected(k) and actual[k]!=expected[k]}
+    assert not differences,differences
