+        modal_year_data = modal.ids.year_selection_layout.data
+        assert len(modal_year_data) == 207
+        assert modal_year_data[0]["text"] == "1914"
+        assert modal_year_data[-1]["text"] == "2120"
+        assert modal_year_data[0]["index"] == 0
+        for entry in modal_year_data:
+            assert entry["viewclass"] == "MDModalDatePickerYearSelectableItem"
+            assert {"viewclass", "date_picker", "text", "index"} <= set(entry)
+
+        # The list item classes resolved from the declarative layouts are the
+        # same objects as the module-level classes.
+        assert MDDockedDatePickerMenuSelectionItem.__name__ == (
+            "MDDockedDatePickerMenuSelectionItem"
+        )
+        assert MDModalDatePickerYearSelectableItem.__name__ == (
+            "MDModalDatePickerYearSelectableItem"
+        )
+        assert MDCalendarLayout.__name__ == "MDCalendarLayout"
+
+
+        detach(docked, modal, modal_input)
+
+
+
+if __name__ == "__main__":
+    ContractSurface().run()
