index 0000000000000000000000000000000000000000..0dee00444958f154ea00cd53f6e8a84be456caa8
--- /dev/null
+++ b/kivymd/tests/datepicker/test_p2p_event_surface.py
@@ -0,0 +1,221 @@
+"""
+P2P regression check: the picker event surface.
+
+``on_select_day``, ``on_select_month``, ``on_select_year``, ``on_open``,
+``on_dismiss``, ``on_cancel``, ``on_ok`` and ``on_edit`` stay usable with the
+same payloads, the selection containers keep dispatching ``on_release`` with
+``"prev"``/``"next"`` and ``on_open_menu``, and the button and icon releases
+keep dispatching the picker's cancel, ok and edit events.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+import time
+
+from kivy.animation import Animation
+from kivy.clock import Clock
+
+from kivymd.app import MDApp
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class PollingApp(MDApp):
+    """Drives ``plan()`` inside the Kivy event loop, polling each step."""
+
+    step_timeout = 20.0
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._plan = self.plan()
+        self._wait = None
+        self._deadline = 0.0
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _poll(self, *args):
+        if self._wait is not None and not self._wait():
+            if time.monotonic() > self._deadline:
+                raise AssertionError(
+                    "step timed out after %s seconds" % self.step_timeout
+                )
+            return
+        try:
+            self._wait = next(self._plan)
+        except StopIteration:
+            Clock.unschedule(self._tick)
+            self.stop()
+            return
+        self._deadline = time.monotonic() + self.step_timeout
+
+    def settle(self, *widgets):
+        """True once no animation is still animating the given widgets."""
+
+        instances = list(Animation._instances)
+        return not any(
+            animation.have_properties_to_animate(widget)
+            for animation in instances
+            for widget in widgets
+        )
+
+    def plan(self):
+        raise NotImplementedError
+
+
+class EventSurface(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import (
+            MDDockedDatePicker,
+            MDModalInputDatePicker,
+        )
+
+        docked = MDDockedDatePicker(year=2024, month=1, day=15)
+        typed = MDModalInputDatePicker(year=2024, month=6, day=10)
+        seen = []
+
+        def record(event):
+            def handler(instance, *args):
+                seen.append((event, args))
+
+            return handler
+
+        for event in (
+            "on_select_day",
+            "on_select_month",
+            "on_select_year",
+            "on_dismiss",
+            "on_cancel",
+            "on_ok",
+            "on_edit",
+        ):
+            docked.bind(**{event: record(event)})
+            typed.bind(**{event: record(event)})
+            assert callable(getattr(docked, event)), event
+
+        # Opening the picker runs the documented open path and marks it open.
+        docked.open()
+        typed.open()
+        yield lambda: round(docked.opacity, 3) == 1.0
+        assert docked.is_open is True
+        assert typed.is_open is True
+
+        # on_open is an inherited motion method, not a registered Kivy event.
+        for picker in (docked, typed):
+            assert callable(picker.on_open)
+            assert not picker.is_event_type("on_open")
+            picker.on_open()
+        yield lambda: round(docked.opacity, 3) == round(typed.opacity, 3) == 1.0
+
+        from kivymd.uix.pickers import MDModalDatePicker
+        modal = MDModalDatePicker(year=2024, month=6, day=10)
+        modal.open()
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        events = []
+        modal.bind(on_select_month=lambda instance, month: events.append(month))
+        for button, expected in (("chevron_right", 7), ("chevron_left", 6)):
+            count_before = len(events)
+            modal.ids.year_selection_items.ids[button].dispatch("on_release")
+            yield lambda count_before=count_before: len(events) > count_before
+            yield lambda: self.settle(modal.ids.calendar_layout)
+            assert (modal.year, modal.month) == (2024, expected)
+        assert events == [7, 6]
+        detach(modal)
+
+        # The selection events stay dispatchable and keep integer payloads.
+        docked.dispatch("on_select_month", 3)
+        assert ("on_select_month", (3,)) in seen
+        docked.dispatch("on_select_year", 2020)
+        assert ("on_select_year", (2020,)) in seen
+        docked.dispatch("on_select_day", 12)
+        assert ("on_select_day", (12,)) in seen
+        assert isinstance(
+            [args for event, args in seen if event == "on_select_year"][0][0],
+            int,
+        )
+
+        # The selection container keeps dispatching its own events: the month
+        # chevron steps the displayed month and the menu toggle opens the
+        # list.
+        month_items = docked.ids.month_selection_items
+        month_items.dispatch("on_release", "next")
+        yield lambda: docked.month == 2
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert docked.month == 2
+        assert ("on_select_month", (2,)) in seen
+        month_items.dispatch("on_open_menu")
+        yield lambda: self.settle(
+            month_items.ids.menu_selection_button,
+            docked.ids.month_year_selection_layout,
+        )
+        assert tuple(docked.ids.month_year_selection_layout.size)[0] > 0
+        month_items.dispatch("on_open_menu")
+        yield lambda: self.settle(
+            month_items.ids.menu_selection_button,
+            docked.ids.month_year_selection_layout,
+        )
+        assert tuple(docked.ids.month_year_selection_layout.size) == (0.0, 0.0)
+
+        # Releasing the dialog buttons dispatches cancel and ok.
+        ok_cancel = [
+            event for event, args in seen if event in ("on_ok", "on_cancel")
+        ]
+        assert ok_cancel == []
+        buttons = [
+            child
+            for child in docked.ids.button_container.children
+            if hasattr(child, "on_release")
+        ]
+        assert len(buttons) == 2
+        for button in buttons:
+            button.dispatch("on_release")
+        ok_cancel = [
+            event for event, args in seen if event in ("on_ok", "on_cancel")
+        ]
+        assert sorted(ok_cancel) == ["on_cancel", "on_ok"], ok_cancel
+
+        # Releasing the edit icon of the input picker dispatches edit.
+        assert [event for event, args in seen if event == "on_edit"] == []
+        typed.ids.icon_button.dispatch("on_release")
+        assert [
+            event for event, args in seen if event == "on_edit"
+        ] == ["on_edit"]
+
+        # Dismissing the picker dispatches dismiss and closes it.
+        assert [event for event, args in seen if event == "on_dismiss"] == []
+        docked.dismiss()
+        yield lambda: docked.is_open is False
+        yield lambda: ("on_dismiss", ()) in seen
+        assert docked.is_open is False
+        assert ("on_dismiss", ()) in seen
+
+
+        detach(docked, typed)
+
+
+
+if __name__ == "__main__":
+    EventSurface().run()
