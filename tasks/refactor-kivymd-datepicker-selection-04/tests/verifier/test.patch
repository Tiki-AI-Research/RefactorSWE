+++ b/kivymd/tests/datepicker/test_p2p_chevron_stepping.py
@@ -0,0 +1,286 @@
+"""
+P2P regression check: chevron month stepping on both picker variants.
+
+Releasing a chevron with ``"prev"`` or ``"next"`` moves the displayed month
+by exactly one on the docked line and on the modal line, wraps December to
+January and January to December across the year, restores the calendar layout
+padding and the fade-in, and emits exactly one ``on_select_month`` carrying
+the new 1-based month.  Stepping next and then prev from the same date returns
+the picker to the original month and year.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+import time
+
+from kivy.animation import Animation, AnimationTransition
+from kivy.clock import Clock
+from kivy.metrics import dp
+
+from kivymd.app import MDApp
+
+RESTORED_PADDING = [dp(12), 0, dp(12), 0]
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class PollingApp(MDApp):
+    """Drives ``plan()`` inside the Kivy event loop, polling each step."""
+
+    step_timeout = 20.0
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._plan = self.plan()
+        self._wait = None
+        self._deadline = 0.0
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _poll(self, *args):
+        if self._wait is not None and not self._wait():
+            if time.monotonic() > self._deadline:
+                raise AssertionError(
+                    "step timed out after %s seconds" % self.step_timeout
+                )
+            return
+        try:
+            self._wait = next(self._plan)
+        except StopIteration:
+            Clock.unschedule(self._tick)
+            self.stop()
+            return
+        self._deadline = time.monotonic() + self.step_timeout
+
+    def settle(self, *widgets):
+        """True once no animation is still animating the given widgets."""
+
+        instances = list(Animation._instances)
+        return not any(
+            animation.have_properties_to_animate(widget)
+            for animation in instances
+            for widget in widgets
+        )
+
+    def plan(self):
+        raise NotImplementedError
+
+
+def visible_days(picker):
+    """Day numbers currently rendered on the picker's calendar grid."""
+
+    from kivymd.uix.pickers.datepicker.datepicker import (
+        MDDatePickerDaySelectableItem,
+    )
+
+    days = [
+        int(child.text)
+        for child in picker.ids.calendar_layout.children
+        if isinstance(child, MDDatePickerDaySelectableItem) and child.text
+    ]
+    return sorted(days)
+
+
+class ChevronStepping(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import MDDockedDatePicker, MDModalDatePicker
+
+        docked = MDDockedDatePicker(year=2024, month=1, day=15)
+        modal = MDModalDatePicker(year=2024, month=6, day=10)
+        docked_events = []
+        modal_events = []
+        docked.bind(
+            on_select_month=lambda instance, month: docked_events.append(month)
+        )
+        modal.bind(
+            on_select_month=lambda instance, month: modal_events.append(month)
+        )
+        docked.open()
+        modal.open()
+        yield lambda: self.settle(
+            docked.ids.calendar_layout, modal.ids.calendar_layout
+        )
+
+        # Record animation boundaries while retaining real Kivy execution.
+        starts = []
+        fade_progress = {}
+        event_progress = []
+        original_start = Animation.start
+
+        def month_changed(picker, month):
+            event_progress.append(fade_progress.get(picker.ids.calendar_layout, 0))
+
+        docked.fbind("on_select_month", month_changed)
+        modal.fbind("on_select_month", month_changed)
+
+        def record_start(animation, widget):
+            if widget in (docked.ids.calendar_layout, modal.ids.calendar_layout):
+                starts.append((widget, dict(animation.animated_properties),
+                               animation.duration, animation.transition))
+                if animation.animated_properties.get("opacity") == 0:
+                    fade_progress[widget] = 0
+                    animation.bind(on_progress=lambda anim, target, progress:
+                                   fade_progress.__setitem__(target, progress))
+            return original_start(animation, widget)
+
+        Animation.start = record_start
+        try:
+            for picker, container in (
+                (docked, docked.ids.month_selection_items),
+                (modal, modal.ids.year_selection_items),
+            ):
+                original_date = (picker.year, picker.month)
+                starts.clear()
+                event_progress.clear()
+                container.dispatch("on_release", "next")
+                assert (picker.year, picker.month) == original_date, (
+                    "month must update after fade completion, not at scheduling"
+                )
+                yield lambda picker=picker: (picker.year, picker.month) != original_date
+                yield lambda picker=picker: self.settle(picker.ids.calendar_layout)
+                fades = [entry for entry in starts if entry[1].get("opacity") == 0]
+                restores = [entry for entry in starts if entry[1].get("opacity") == 1]
+                assert len(fades) == len(restores) == 1
+                assert event_progress == [1.0], "month changed before fade completed"
+                assert fades[0][2] == 0.2
+                assert fades[0][3] is AnimationTransition.in_quad
+                assert restores[0][2] == 0.2
+                assert restores[0][3] is AnimationTransition.out_quad
+                assert fades[0][1]["padding"] == [dp(18), 0, 0, 0]
+                assert list(picker.ids.calendar_layout.padding) == RESTORED_PADDING
+                container.dispatch("on_release", "prev")
+                yield lambda picker=picker: (picker.year, picker.month) == original_date
+                yield lambda picker=picker: self.settle(picker.ids.calendar_layout)
+        finally:
+            Animation.start = original_start
+            docked.unbind(on_select_month=month_changed)
+            modal.unbind(on_select_month=month_changed)
+        docked_events.clear()
+        modal_events.clear()
+
+        # Docked line: "next" then "prev" moves one month each way and emits
+        # exactly one event per release.
+        docked.ids.month_selection_items.dispatch("on_release", "next")
+        yield lambda: docked.month == 2
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert docked.year == 2024
+        assert docked_events == [2], docked_events
+        assert visible_days(docked) == list(range(1, 30))
+        assert list(docked.ids.calendar_layout.padding) == RESTORED_PADDING, (
+            list(docked.ids.calendar_layout.padding)
+        )
+        assert round(docked.ids.calendar_layout.opacity, 3) == 1.0
+
+        docked.ids.month_selection_items.dispatch("on_release", "prev")
+        yield lambda: docked.month == 1
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert (docked.year, docked.month) == (2024, 1), "back to the start"
+        assert docked_events == [2, 1], docked_events
+        assert list(docked.ids.calendar_layout.padding) == RESTORED_PADDING
+        assert round(docked.ids.calendar_layout.opacity, 3) == 1.0
+
+        # December wraps to January of the next year and the calendar grid
+        # follows the movement.
+        docked.update_calendar(2024, 12)
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        docked.ids.month_selection_items.dispatch("on_release", "next")
+        yield lambda: docked.month == 1
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert (docked.year, docked.month) == (2025, 1)
+        assert docked_events[-1] == 1
+        assert visible_days(docked) == list(range(1, 32))
+
+        # January wraps back to December of the previous year.
+        docked.update_calendar(2025, 1)
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        docked.ids.month_selection_items.dispatch("on_release", "prev")
+        yield lambda: docked.month == 12
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert (docked.year, docked.month) == (2024, 12)
+        assert docked_events[-1] == 12
+        assert visible_days(docked) == list(range(1, 32))
+
+        # Modal line behaves identically for the same releases, and its month
+        # label follows the displayed month.
+        assert modal.ids.year_selection_items.text == "June 2024"
+        modal.ids.year_selection_items.dispatch("on_release", "next")
+        yield lambda: modal.month == 7
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        assert (modal.year, modal.month) == (2024, 7)
+        assert modal_events == [7], modal_events
+        assert modal.ids.year_selection_items.text == "July 2024"
+        assert visible_days(modal) == list(range(1, 32))
+        assert list(modal.ids.calendar_layout.padding) == RESTORED_PADDING, (
+            list(modal.ids.calendar_layout.padding)
+        )
+        assert round(modal.ids.calendar_layout.opacity, 3) == 1.0
+
+        modal.ids.year_selection_items.dispatch("on_release", "prev")
+        yield lambda: modal.month == 6
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        assert (modal.year, modal.month) == (2024, 6), "back to the start"
+        assert modal_events == [7, 6], modal_events
+        assert modal.ids.year_selection_items.text == "June 2024"
+        assert visible_days(modal) == list(range(1, 31))
+
+        # December wraps to January of the next year on the modal line too.
+        modal.update_calendar(2024, 12)
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        modal.ids.year_selection_items.dispatch("on_release", "next")
+        yield lambda: modal.month == 1
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        assert (modal.year, modal.month) == (2025, 1)
+        assert modal_events[-1] == 1
+        assert modal.ids.year_selection_items.text == "January 2025"
+
+        assert docked_events == [2, 1, 1, 12]
+        assert modal_events == [7, 6, 1]
+        assert (docked.year, docked.month) == (2024, 12)
+        assert (modal.year, modal.month) == (2025, 1)
+
+
+        # Displayed navigation and selected-date labels have different sources.
+        # Check both when they deliberately diverge, including a real arrow.
+        label_docked = MDDockedDatePicker(year=2024, month=6, day=10)
+        for picker in (label_docked, modal):
+            picker.update_calendar(2030, 9)
+        assert label_docked._current_month_name == "Jun"
+        assert modal._current_month_name == "Mon, Jun 10"
+        assert modal.ids.year_selection_items.text == "September 2030"
+        label_docked.ids.month_selection_items.dispatch("on_release", "next")
+        yield lambda: (label_docked.year, label_docked.month) == (2030, 10)
+        yield lambda: self.settle(label_docked.ids.calendar_layout)
+        assert label_docked._current_month_name == "Jun", (
+            "navigation must not replace the selected-month label"
+        )
+
+        detach(docked, modal, label_docked)
+
+
+
+if __name__ == "__main__":
+    ChevronStepping().run()
