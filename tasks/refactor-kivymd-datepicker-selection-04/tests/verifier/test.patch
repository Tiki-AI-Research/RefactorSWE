index 0000000000000000000000000000000000000000..f3d51eb38bb0fda3c0ac2489cf54d49a715633db
--- /dev/null
+++ b/kivymd/tests/datepicker/_case33_ui_probe.py
@@ -0,0 +1,167 @@
+"""Independent observations of real Kivy widgets and the public event paths."""
+import datetime
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+sys.path.insert(0, os.getcwd())
+from kivy.animation import Animation
+from kivy.clock import Clock
+from kivy.input.motionevent import MotionEvent
+from kivymd.app import MDApp
+from kivymd.uix.boxlayout import MDBoxLayout
+from kivymd.uix.pickers import MDDockedDatePicker, MDModalDatePicker, MDModalInputDatePicker
+
+observed = {}
+
+def clean(p):
+    Animation.cancel_all(None)
+    for name in ('month_year_selection_layout','year_selection_layout'):
+        if name in p.ids: p.ids[name].data=[]
+    for w in (p,getattr(p,'_scrim',None)):
+        if w is not None and w.parent: w.parent.remove_widget(w)
+
+def settled():
+    return not Animation._instances
+
+def state(p, modal=False):
+    calendar=p.ids.calendar_layout
+    layout=p.ids['year_selection_layout' if modal else 'month_year_selection_layout']
+    container=p.ids['year_selection_items' if modal else 'month_selection_items']
+    return dict(display=[p.year,p.month],selected=[d.isoformat() for d in p.get_date()],label=p.set_text_full_date(),
+                rows=len(layout.data),row_values=[d.get('text',d.get('month_year_name')) for d in layout.data],
+                size=[round(x,4) for x in layout.size],calendar_disabled=calendar.disabled,
+                calendar_opacity=round(calendar.opacity,4),calendar_scale=[round(calendar.scale_value_x,4),round(calendar.scale_value_y,4)],
+                list_disabled=layout.disabled,list_scale=[round(layout.scale_value_x,4),round(layout.scale_value_y,4)],
+                rotation=round(container.ids.menu_selection_button.rotate_value_angle,4))
+
+def row_for(layout, year):
+    if not layout.children:return None
+    return next((w for w in layout.children[0].children if getattr(w,'text',None)==str(year) or getattr(w,'month_year_name',None)==str(year)),None)
+
+class Touch(MotionEvent):
+    def __init__(self,pos):
+        super().__init__('audit','audit',{},is_touch=True)
+        self.x,self.y=pos;self.pos=pos
+
+def plan():
+    # Direct-show deliberately omits list generation, including an already
+    # populated year list. This is a public API separate from the toggle event.
+    for populated in (False,True):
+        p=MDDockedDatePicker(year=2024,month=6,day=10,min_year=2020,max_year=2026)
+        p.open();yield settled
+        if populated:p.generate_menu_month_year_selection('year')
+        observed[f'direct/{populated}/before']=state(p)
+        p.open_close_menu_month_year_selection(state=True,menu_type='month');yield settled
+        observed[f'direct/{populated}/show']=state(p)
+        for i in range(2):
+            p.ids.month_selection_items.dispatch('on_open_menu');yield settled
+            observed[f'direct/{populated}/toggle{i}']=state(p)
+        clean(p)
+
+    for populated in (False,True):
+        p=MDModalDatePicker(year=2024,month=6,day=10,min_year=2020,max_year=2026)
+        p.open();yield settled
+        if populated:p.generate_list_widgets_years()
+        observed[f'direct-modal/{populated}/before']=state(p,True)
+        for i in range(2):
+            p.open_menu_year_selection();yield settled
+            observed[f'direct-modal/{populated}/toggle{i}']=state(p,True)
+        clean(p)
+
+    # Preserve the asymmetric legacy selectable flag. Use actual rendered
+    # rows and parent selection machinery, not a mocked widget implementation.
+    for cls,modal in ((MDDockedDatePicker,False),(MDModalDatePicker,True)):
+        for selectable in (False,True):
+            p=cls(year=2024,month=6,day=10,min_year=2020,max_year=2026)
+            p.open();yield settled
+            p.update_calendar(2030,9)
+            p.ids.year_selection_items.dispatch('on_open_menu')
+            layout=p.ids['year_selection_layout' if modal else 'month_year_selection_layout']
+            yield lambda: settled() and row_for(layout,2021) is not None
+            row=row_for(layout,2021);row.selectable=selectable
+            events=[];p.bind(on_select_year=lambda instance,year:events.append(year))
+            returned=row.on_touch_down(Touch(row.center))
+            observed[f'row/{modal}/{selectable}']=dict(display=[p.year,p.month],events=events[:],selected=row.selected,
+                                                      data_selected=layout.data[row.index].get('selected',False),return_value=returned)
+            clean(p)
+
+    # Boundary month navigation and labels retain the selected date as their
+    # original source even when the displayed calendar moves elsewhere.
+    for cls,modal in ((MDDockedDatePicker,False),(MDModalDatePicker,True)):
+        p=cls(year=2024,month=6,day=10);p.open();yield settled
+        for y,m in ((1,1),(1914,1),(2000,2),(2023,12),(2024,2),(2121,12)):
+            for operation in ('next','prev','unexpected'):
+                p.update_calendar(y,m);events=[]
+                def got(instance,month):events.append(month)
+                p.bind(on_select_month=got)
+                p.change_month(operation)
+                p.unbind(on_select_month=got)
+                observed[f'navigation/{modal}/{y}/{m}/{operation}']=dict(display=[p.year,p.month],events=events,
+                    selected=[d.isoformat() for d in p.get_date()],label=p.set_text_full_date())
+        clean(p)
+
+    # The entrypoint and registered events drive real asynchronous animations.
+    for cls,modal in ((MDDockedDatePicker,False),(MDModalDatePicker,True)):
+        p=cls(year=2024,month=12,day=15,min_year=2020,max_year=2026);p.open();yield settled
+        container=p.ids['year_selection_items' if modal else 'month_selection_items']
+        for i,op in enumerate(('next','prev')):
+            events=[]
+            def got(instance,month):events.append(month)
+            p.bind(on_select_month=got)
+            before=[p.year,p.month]
+            container.dispatch('on_release',op)
+            immediate=[p.year,p.month]
+            yield settled
+            observed[f'chevron/{modal}/{i}']=dict(before=before,immediate=immediate,after=[p.year,p.month],events=events[:],padding=list(p.ids.calendar_layout.padding),opacity=p.ids.calendar_layout.opacity)
+            p.unbind(on_select_month=got)
+        for i in range(4):
+            container.dispatch('on_open_menu');yield settled
+            observed[f'menu/{modal}/{i}']=state(p,modal)
+        clean(p)
+
+    # The unchanged input subclass must continue to parse each date format.
+    p=MDModalInputDatePicker(year=2024,month=6,day=10);p.open()
+    yield lambda: bool(p.ids.input_date_field.text) and settled()
+    for fmt,text,rendered in (('dd/mm/yyyy','29/02/2024','29/2/2024'),('mm/dd/yyyy','02/29/2024','2/29/2024'),('yyyy/mm/dd','2024/02/29','2024/2/29')):
+        p.date_format=fmt;p.ids.input_date_field.text='99/99/9999'
+        yield lambda: p.ids.input_date_field.error
+        p.ids.input_date_field.text=text
+        yield lambda: p.get_date()==[datetime.date(2024,2,29)] and not p.ids.input_date_field.error and p.get_current_date_from_format()==rendered
+        observed['input/'+fmt]=dict(dates=[d.isoformat() for d in p.get_date()],formatted=p.get_current_date_from_format(),label=p.set_text_full_date())
+    clean(p)
+
+class AuditApp(MDApp):
+    error=None
+    def build(self):return MDBoxLayout()
+    def on_start(self):
+        self.iterator=plan();self.wait=None;self.deadline=time.monotonic()+20
+        self.timer=Clock.schedule_interval(self.tick,.02)
+    def tick(self,*args):
+        try:
+            if self.wait is not None and not self.wait():
+                if time.monotonic()>self.deadline:raise TimeoutError('probe UI step did not settle')
+                return
+            self.wait=next(self.iterator);self.deadline=time.monotonic()+20
+        except StopIteration:
+            Clock.unschedule(self.timer);self.stop()
+        except BaseException as e:
+            self.error=e;Clock.unschedule(self.timer);self.stop()
+
+def collect():
+    observed.clear()
+    app=AuditApp()
+    app.run()
+    if app.error:raise app.error
+    return dict(observed)
+
+if __name__ == "__main__":
+    import faulthandler
+    faulthandler.dump_traceback_later(30, repeat=True, file=sys.__stderr__)
+    try:
+        result=collect()
+        Path(sys.argv[1]).write_text(json.dumps(result,sort_keys=True))
+    finally:
+        faulthandler.cancel_dump_traceback_later()
