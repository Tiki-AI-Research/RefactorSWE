index 0000000000000000000000000000000000000000..7f88e34b86c1c68ecf63f3afc14b6d9c7e64fd61
--- /dev/null
+++ b/kivymd/tests/datepicker/test_f2p_row_selection_bookkeeping_shared.py
@@ -0,0 +1,110 @@
+"""
+F2P acceptance check: the row selection bookkeeping is one shared implementation.
+
+The docked list rows and the modal list rows keep the ``selected`` flag of the
+displayed row in sync with the layout selection.  On the baseline each line
+carried its own copy of that bookkeeping.  The restructured picker must serve
+both row views from a single implementation while the flag still tracks the
+row's selected state on both lines.
+"""
+
+import os
+import sys
+from types import SimpleNamespace
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+if _HERE not in sys.path:
+    sys.path.insert(0, _HERE)
+
+import _f2p_selector_support as support  # noqa: E402
+
+from kivymd.uix.pickers.datepicker import datepicker as datepicker_module  # noqa: E402
+
+
+def main():
+    docked_row_class = datepicker_module.MDDockedDatePickerMenuSelectionItem
+    modal_row_class = datepicker_module.MDModalDatePickerYearSelectableItem
+    assert docked_row_class is not modal_row_class
+
+    docked_impl = support.resolved_attribute(docked_row_class, "apply_selection")
+    modal_impl = support.resolved_attribute(modal_row_class, "apply_selection")
+    assert docked_impl is not None, "docked rows must expose apply_selection"
+    assert modal_impl is not None, "modal rows must expose apply_selection"
+    def probe():
+        rows = (docked_row_class(), modal_row_class())
+        data_chains = [[], []]
+
+        class SelectionData(dict):
+            def __init__(self, owner):
+                super().__init__(selected=False)
+                self.owner = owner
+
+            def __setitem__(self, key, value):
+                if key == "selected":
+                    data_chains[self.owner].append(support.module_frame_chain(1))
+                super().__setitem__(key, value)
+
+        stores = tuple(SimpleNamespace(data=[SelectionData(i) for _ in range(4)])
+                       for i in range(2))
+        chains = [[], []]
+        for selected in (True, False, True):
+            for i, (row, store) in enumerate(zip(rows, stores)):
+                chains[i].extend(support.write_chains(
+                    row, "selected",
+                    lambda row=row, store=store, selected=selected:
+                        row.apply_selection(store, 3, selected),
+                ))
+                assert row.selected is selected
+                assert store.data[3]["selected"] is selected
+                assert all(item["selected"] is False for item in store.data[:3])
+        for writes in (chains, data_chains):
+            assert support.shared_write_functions(*writes), (
+                "row and list-data bookkeeping must have shared writers; "
+                "a pure super() wrapper is permitted"
+            )
+
+    def plan():
+        from test_p2p_row_selection import FakeTouch, find_view
+
+        probe()
+        observations = []
+        for picker, is_modal in (
+            (support.docked_picker(month=6, day=10), False),
+            (support.modal_picker(month=6, day=10), True),
+        ):
+            picker.open()
+            yield lambda: not Animation._instances
+            picker.update_calendar(2030, 9)
+            picker.ids.year_selection_items.dispatch("on_open_menu")
+            layout = picker.ids[
+                "year_selection_layout" if is_modal
+                else "month_year_selection_layout"
+            ]
+            predicate = (
+                (lambda row: getattr(row, "text", "") == "1920")
+                if is_modal else
+                (lambda row: getattr(row, "month_year_name", "") == "1920")
+            )
+            yield lambda: find_view(layout, predicate) is not None
+            row = find_view(layout, predicate)
+            events = []
+            picker.fbind("on_select_year",
+                         lambda instance, year: events.append(year))
+            with support.RowDateResponsibility(picker) as observed:
+                row.on_touch_down(FakeTouch(row.center))
+            assert (picker.year, picker.month) == (
+                1920, 6 if is_modal else 9
+            ), "touched year must retain the variant's own month source"
+            assert events == [1920], "one touch must dispatch one year event"
+            assert row.selected is True
+            assert layout.data[row.index]["selected"] is True
+            observations.append(observed)
+            support.detach(picker)
+        support.assert_shared_row_date_responsibility(*observations)
+
+    from kivy.animation import Animation
+    support.run_plan(plan)
+
+
+if __name__ == "__main__":
+    main()
