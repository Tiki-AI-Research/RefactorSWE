index 0000000000000000000000000000000000000000..f3a4f0ca85ef6c131c172612033671fd3489c096
--- /dev/null
+++ b/kivymd/tests/datepicker/test_p2p_year_bounds.py
@@ -0,0 +1,221 @@
+"""
+P2P regression check: year bounds and the year lists.
+
+The year lists offer the years from ``min_year`` up to but not including
+``max_year`` and stepping the year chevron beyond either bound raises
+``MDDatePickerTypeDateError`` without changing the displayed calendar.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+import time
+
+from kivy.animation import Animation
+from kivy.clock import Clock
+
+from kivymd.app import MDApp
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class PollingApp(MDApp):
+    """Drives ``plan()`` inside the Kivy event loop, polling each step."""
+
+    step_timeout = 20.0
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._plan = self.plan()
+        self._wait = None
+        self._deadline = 0.0
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _poll(self, *args):
+        if self._wait is not None and not self._wait():
+            if time.monotonic() > self._deadline:
+                raise AssertionError(
+                    "step timed out after %s seconds" % self.step_timeout
+                )
+            return
+        try:
+            self._wait = next(self._plan)
+        except StopIteration:
+            Clock.unschedule(self._tick)
+            self.stop()
+            return
+        self._deadline = time.monotonic() + self.step_timeout
+
+    def settle(self, *widgets):
+        """True once no animation is still animating the given widgets."""
+
+        instances = list(Animation._instances)
+        return not any(
+            animation.have_properties_to_animate(widget)
+            for animation in instances
+            for widget in widgets
+        )
+
+    def plan(self):
+        raise NotImplementedError
+
+
+def visible_days(picker):
+    """Day numbers currently rendered on the picker's calendar grid."""
+
+    from kivymd.uix.pickers.datepicker.datepicker import (
+        MDDatePickerDaySelectableItem,
+    )
+
+    days = [
+        int(child.text)
+        for child in picker.ids.calendar_layout.children
+        if isinstance(child, MDDatePickerDaySelectableItem) and child.text
+    ]
+    return sorted(days)
+
+
+class YearBounds(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import MDDockedDatePicker, MDModalDatePicker
+        from kivymd.uix.pickers.datepicker.datepicker import (
+            MDDatePickerTypeDateError,
+        )
+
+        docked = MDDockedDatePicker(year=2000, month=6, day=10)
+        modal = MDModalDatePicker(year=2000, month=6, day=10)
+        events = []
+        docked.bind(on_select_year=lambda instance, year: events.append(year))
+        docked.open()
+        modal.open()
+        yield lambda: self.settle(
+            docked.ids.calendar_layout, modal.ids.calendar_layout
+        )
+
+        # The docked year list offers min_year .. max_year - 1 only.
+        docked.ids.year_selection_items.dispatch("on_open_menu")
+        yield lambda: self.settle(docked.ids.month_year_selection_layout)
+        docked_years = [
+            entry["month_year_name"]
+            for entry in docked.ids.month_year_selection_layout.data
+        ]
+        assert len(docked_years) == docked.max_year - docked.min_year
+        assert docked_years == [str(year) for year in range(1914, 2121)]
+        assert "1914" in docked_years and "2121" not in docked_years
+
+        # The modal year list offers the same years.
+        modal.ids.year_selection_items.dispatch("on_open_menu")
+        modal_years = [
+            entry["text"] for entry in modal.ids.year_selection_layout.data
+        ]
+        assert modal_years == docked_years
+        assert len(modal.ids.year_selection_layout.data) == 207
+
+        # Stepping the year chevron one year up and down keeps the month.
+        docked.ids.year_selection_items.dispatch("on_release", "next")
+        yield lambda: docked.year == 2001
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert docked.month == 6
+        assert visible_days(docked) == list(range(1, 31)), "June 2001"
+
+        docked.ids.year_selection_items.dispatch("on_release", "prev")
+        yield lambda: docked.year == 2000
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert docked.month == 6
+
+        # Leaving the lower bound raises the public error and does not change
+        # the displayed calendar.
+        docked.update_calendar(docked.min_year, 5)
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        days_before = visible_days(docked)
+        events_before = list(events)
+        try:
+            docked.ids.year_selection_items.dispatch("on_release", "prev")
+            raise AssertionError("stepping below min_year must raise")
+        except MDDatePickerTypeDateError:
+            pass
+        assert (docked.year, docked.month) == (1914, 5)
+        assert visible_days(docked) == days_before
+        assert events == events_before
+        assert docked.year == docked.min_year
+
+        # Leaving the upper bound raises the public error as well.
+        docked.update_calendar(docked.max_year, 7)
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        days_before = visible_days(docked)
+        events_before = list(events)
+        try:
+            docked.ids.year_selection_items.dispatch("on_release", "next")
+            raise AssertionError("stepping above max_year must raise")
+        except MDDatePickerTypeDateError:
+            pass
+        assert (docked.year, docked.month) == (2121, 7)
+        assert visible_days(docked) == days_before
+        assert events == events_before
+
+        # The step directly below the upper bound is still allowed.
+        docked.update_calendar(docked.max_year - 1, 3)
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        docked.ids.year_selection_items.dispatch("on_release", "next")
+        yield lambda: docked.year == docked.max_year
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert (docked.year, docked.month) == (2121, 3)
+
+        # The step directly above the lower bound is allowed too.
+        docked.update_calendar(docked.min_year + 1, 9)
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        docked.ids.year_selection_items.dispatch("on_release", "prev")
+        yield lambda: docked.year == docked.min_year
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert (docked.year, docked.month) == (1914, 9)
+
+        # The modal line keeps stepping months from the same chevron and
+        # tracks the displayed month in its label.
+        modal.update_calendar(modal.max_year, 2)
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        modal.ids.year_selection_items.dispatch("on_release", "next")
+        yield lambda: modal.month == 3
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        assert modal.year == 2121, "modal keeps stepping months, not years"
+        assert modal.ids.year_selection_items.text == "March 2121"
+
+
+        # Year-chevron bounds do not apply to month navigation.
+        for picker in (docked, modal):
+            picker.update_calendar(picker.min_year, 1)
+            picker.change_month("prev")
+            assert (picker.year, picker.month) == (picker.min_year - 1, 12)
+            picker.update_calendar(picker.max_year, 12)
+            picker.change_month("next")
+            assert (picker.year, picker.month) == (picker.max_year + 1, 1)
+
+        detach(docked, modal)
+
+
+
+if __name__ == "__main__":
+    YearBounds().run()
