+
+        month_items = picker.ids.month_selection_items
+        year_items = picker.ids.year_selection_items
+        calendar = picker.ids.calendar_layout
+        selection = picker.ids.month_year_selection_layout
+        button_container = picker.ids.button_container
+        menu_button = month_items.ids.menu_selection_button
+
+        # Collapsed state before the first press.
+        assert menu_button.rotate_value_angle == 0
+        assert round(calendar.opacity, 3) == 1.0
+        assert calendar.disabled is False
+        assert round(calendar.scale_value_x, 3) == 1.0
+        assert tuple(selection.size) == (0.0, 0.0)
+
+        # Pressing the toggle opens the list.
+        month_items.dispatch("on_open_menu")
+        yield lambda: self.settle(
+            calendar, menu_button, selection, month_items, year_items
+        )
+        assert round(menu_button.rotate_value_angle, 3) == -90.0
+        assert round(calendar.opacity, 3) == 0.0
+        assert round(calendar.scale_value_x, 3) == 1.1
+        assert round(calendar.scale_value_y, 3) == 1.1
+        assert calendar.disabled is True
+        assert month_items.ids.chevron_left.disabled is True
+        assert month_items.ids.chevron_right.disabled is True
+        assert round(month_items.ids.chevron_left.opacity, 3) == 0.0
+        assert round(month_items.ids.chevron_right.opacity, 3) == 0.0
+        assert year_items.ids.chevron_left.disabled is True
+        assert year_items.ids.chevron_right.disabled is True
+        assert year_items.ids.label.disabled is True
+        assert round(year_items.ids.menu_selection_button.opacity, 3) == 0.0
+        assert round(button_container.opacity, 3) == 0.0
+        assert button_container.disabled is True
+        # The selection area is expanded to the full available space.
+        assert tuple(selection.size)[0] == picker.width, (
+            tuple(selection.size),
+            picker.width,
+        )
+        assert tuple(selection.size)[1] == picker.height - (
+            picker.ids.month_year_selection_items_container.height + dp(56)
+        )
+        assert selection.disabled is False
+        assert round(selection.scale_value_x, 2) == 1.0
+        assert round(selection.scale_value_y, 2) == 1.0
+
+        # Pressing the toggle again closes the list and restores everything.
+        month_items.dispatch("on_open_menu")
+        yield lambda: self.settle(
+            calendar, menu_button, selection, month_items, year_items
+        )
+        assert round(menu_button.rotate_value_angle, 3) == 0.0
+        assert round(calendar.opacity, 3) == 1.0
+        assert calendar.disabled is False
+        assert round(calendar.scale_value_x, 3) == 1.0
+        assert round(calendar.scale_value_y, 3) == 1.0
+        assert month_items.ids.chevron_left.disabled is False
+        assert month_items.ids.chevron_right.disabled is False
+        assert round(month_items.ids.chevron_left.opacity, 3) == 1.0
+        assert year_items.ids.chevron_left.disabled is False
+        assert tuple(selection.size) == (0.0, 0.0)
+        assert round(selection.scale_value_x, 3) == 0.0
+        assert round(button_container.opacity, 3) == 1.0
+        assert button_container.disabled is False
+
+        # The year toggle drives the same contract and only hides the year
+        # label and menu button while the list is open.
+        year_items.dispatch("on_open_menu")
+        yield lambda: self.settle(
+            calendar,
+            year_items.ids.menu_selection_button,
+            selection,
+            month_items,
+            year_items,
+        )
+        assert round(
+            year_items.ids.menu_selection_button.rotate_value_angle, 3
+        ) == -90.0
+        assert round(
+            month_items.ids.menu_selection_button.rotate_value_angle, 3
+        ) == 0.0
+        assert round(calendar.opacity, 3) == 0.0
+        assert calendar.disabled is True
+        assert round(calendar.scale_value_x, 3) == 1.1
+        assert tuple(selection.size)[0] == picker.width
+        assert tuple(selection.size)[1] == picker.height - (
+            picker.ids.month_year_selection_items_container.height + dp(56)
+        )
+        assert year_items.ids.chevron_left.disabled is True
+        assert month_items.ids.label.disabled is True
+        assert round(month_items.ids.menu_selection_button.opacity, 3) == 0.0
+
+        year_items.dispatch("on_open_menu")
+        yield lambda: self.settle(
+            calendar,
+            year_items.ids.menu_selection_button,
+            selection,
+            month_items,
+            year_items,
+        )
+        assert round(
+            year_items.ids.menu_selection_button.rotate_value_angle, 3
+        ) == 0.0
+        assert round(calendar.opacity, 3) == 1.0
+        assert calendar.disabled is False
+        assert tuple(selection.size) == (0.0, 0.0)
+        assert month_items.ids.label.disabled is False
+
+
+        # Direct show preserves its original separation from toggle state.
+        picker.generate_menu_month_year_selection(menu_type="month")
+        picker.open_close_menu_month_year_selection(state=True, menu_type="month")
+        yield lambda: self.settle(calendar, selection, menu_button)
+        month_items.dispatch("on_open_menu")
+        yield lambda: self.settle(calendar, selection, menu_button)
