index 0000000000000000000000000000000000000000..b5be5bbb6698f823b39fcfefe8a793f65edf8f30
--- /dev/null
+++ b/kivymd/tests/datepicker/test_p2p_date_accessors.py
@@ -0,0 +1,203 @@
+"""
+P2P regression check: ``get_date`` and ``set_text_full_date``.
+
+``get_date`` keeps returning a list of ``datetime.date`` values and
+``set_text_full_date`` keeps returning its current formatted strings for every
+selection mode, including the range mode and the dates picked from the
+calendar grid.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+import time
+from datetime import date
+
+from kivy.animation import Animation
+from kivy.clock import Clock
+from kivy.input.motionevent import MotionEvent
+
+from kivymd.app import MDApp
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class FakeTouch(MotionEvent):
+    """Minimal touch used to release a calendar day."""
+
+    def __init__(self, pos=(0, 0)):
+        super().__init__(device="fake", id="fake", args={}, is_touch=True)
+        self.x, self.y = pos
+        self.pos = pos
+
+    def release(self, widget):
+        """Hand the touch back to ``widget`` so it completes its release."""
+
+        widget.on_touch_down(self)
+        self.grab_current = widget
+        widget.on_touch_up(self)
+
+
+class PollingApp(MDApp):
+    """Drives ``plan()`` inside the Kivy event loop, polling each step."""
+
+    step_timeout = 20.0
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._plan = self.plan()
+        self._wait = None
+        self._deadline = 0.0
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _poll(self, *args):
+        if self._wait is not None and not self._wait():
+            if time.monotonic() > self._deadline:
+                raise AssertionError(
+                    "step timed out after %s seconds" % self.step_timeout
+                )
+            return
+        try:
+            self._wait = next(self._plan)
+        except StopIteration:
+            Clock.unschedule(self._tick)
+            self.stop()
+            return
+        self._deadline = time.monotonic() + self.step_timeout
+
+    def settle(self, *widgets):
+        """True once no animation is still animating the given widgets."""
+
+        instances = list(Animation._instances)
+        return not any(
+            animation.have_properties_to_animate(widget)
+            for animation in instances
+            for widget in widgets
+        )
+
+    def plan(self):
+        raise NotImplementedError
+
+
+def day_item(picker, text):
+    from kivymd.uix.pickers.datepicker.datepicker import (
+        MDDatePickerDaySelectableItem,
+    )
+
+    for child in picker.ids.calendar_layout.children:
+        if (
+            isinstance(child, MDDatePickerDaySelectableItem)
+            and child.text == text
+        ):
+            return child
+    raise AssertionError("no calendar day %r" % text)
+
+
+class DateAccessors(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import MDDockedDatePicker, MDModalDatePicker
+
+        docked = MDDockedDatePicker(year=2024, month=2, day=5)
+        modal = MDModalDatePicker(year=2024, month=6, day=10)
+        docked_open_days = []
+        docked.bind(
+            on_select_day=lambda instance, day: docked_open_days.append(day)
+        )
+        docked.open()
+        modal.open()
+        yield lambda: self.settle(
+            docked.ids.calendar_layout, modal.ids.calendar_layout
+        )
+
+        # Picker mode returns a one item list of ``datetime.date`` values.
+        assert docked.get_date() == [date(2024, 2, 5)], docked.get_date()
+        assert all(
+            isinstance(value, date) for value in docked.get_date()
+        )
+        assert docked.set_text_full_date() == "Mon, Feb 5", (
+            docked.set_text_full_date()
+        )
+        assert modal.get_date() == [date(2024, 6, 10)]
+        assert modal.set_text_full_date() == "Mon, Jun 10", (
+            modal.set_text_full_date()
+        )
+
+        # Picking a day on the grid refreshes the returned date and emits the
+        # day number.
+        item = day_item(docked, "12")
+        FakeTouch((item.center_x, item.center_y)).release(item)
+        yield lambda: self.settle(docked.ids.calendar_layout)
+        assert docked_open_days == [12], docked_open_days
+        assert docked.get_date() == [date(2024, 2, 12)], docked.get_date()
+        assert docked.set_text_full_date() == "Mon, Feb 12"
+        assert item.is_selected is True
+        assert day_item(docked, "5").is_selected is False
+
+        # Range mode keeps returning the inclusive list of dates.
+        ranged = MDDockedDatePicker(
+            mode="range",
+            year=2024,
+            month=2,
+            day=5,
+            min_date=date(2024, 2, 5),
+            max_date=date(2024, 2, 8),
+        )
+        assert ranged.get_date() == [
+            date(2024, 2, 5),
+            date(2024, 2, 6),
+            date(2024, 2, 7),
+            date(2024, 2, 8),
+        ], ranged.get_date()
+        assert ranged.set_text_full_date() == "Feb 5 — Feb 8", (
+            ranged.set_text_full_date()
+        )
+
+        # Range mode without a date range reports its current placeholder.
+        empty_range = MDDockedDatePicker(mode="range", year=2024, month=2, day=5)
+        assert empty_range.get_date() == []
+        assert empty_range.set_text_full_date() == "Start - End", (
+            empty_range.set_text_full_date()
+        )
+
+        # The modal picker's accessors follow the date picked on its grid too.
+        modal.update_calendar(2024, 3)
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        item = day_item(modal, "7")
+        FakeTouch((item.center_x, item.center_y)).release(item)
+        yield lambda: self.settle(modal.ids.calendar_layout)
+        assert modal.get_date() == [date(2024, 3, 7)], modal.get_date()
+        assert modal.set_text_full_date() == "Thu, Mar 7", (
+            modal.set_text_full_date()
+        )
+
+
+        detach(docked, modal, ranged, empty_range)
+
+
+
+if __name__ == "__main__":
+    DateAccessors().run()
