@@ -0,0 +1,508 @@
+"""
+Shared probe helpers for the F2P month/year selection interaction selectors.
+
+Every F2P selector in this directory is collected by ``kivymd/tests/conftest.py``
+and executed as a standalone script.  The helpers below build the docked and
+modal pickers inside a live :class:`~kivymd.app.MDApp`, observe which code of
+``kivymd.uix.pickers.datepicker.datepicker`` is responsible for an interaction
+and report that observation.  Nothing here pins private helper names, inlining
+or any single implementation shape: a verified delegation chain is accepted as
+long as the interaction itself is carried by one shared implementation.
+"""
+
+import ast
+import hashlib
+import inspect
+import os
+import sys
+import textwrap
+import time
+from functools import lru_cache
+
+from kivy.animation import Animation
+from kivy.clock import Clock
+
+from kivymd.app import MDApp
+from kivymd.uix.boxlayout import MDBoxLayout
+from kivymd.uix.pickers.datepicker import datepicker as datepicker_module
+
+MODULE_FILE = datepicker_module.__file__
+
+#: Code that already lived in the frozen picker base on the baseline and was
+#: executed by both variant lines.  Finding it on both lines says nothing
+#: about the duplicated selection interaction having become shared.
+FROZEN_BASE_QUALNAMES = frozenset(
+    (
+        "MDBaseDatePicker.__init__",
+        "MDBaseDatePicker._get_date_range",
+        "MDBaseDatePicker._update_date_label_text",
+        "MDBaseDatePicker.change_month",
+        "MDBaseDatePicker.compare_date_range",
+        "MDBaseDatePicker.dismiss",
+        "MDBaseDatePicker.generate_list_widgets_days",
+        "MDBaseDatePicker.get_date",
+        "MDBaseDatePicker.on_cancel",
+        "MDBaseDatePicker.on_dismiss",
+        "MDBaseDatePicker.on_edit",
+        "MDBaseDatePicker.on_ok",
+        "MDBaseDatePicker.on_select_day",
+        "MDBaseDatePicker.on_select_month",
+        "MDBaseDatePicker.on_select_year",
+        "MDBaseDatePicker.on_touch_down",
+        "MDBaseDatePicker.open",
+        "MDBaseDatePicker.restore_calendar_layout_properties",
+        "MDBaseDatePicker.set_calendar_layout_properties",
+        "MDBaseDatePicker.set_selected_widget",
+        "MDBaseDatePicker.set_text_full_date",
+        "MDBaseDatePicker.update_calendar",
+    )
+)
+
+#: Full inventory of the baseline picker module.  Two lines that only meet on
+#: code that already existed there did not gain a shared implementation.
+FROZEN_MODULE_QUALNAMES = frozenset(
+    (
+        'MDBaseDatePicker.__init__',
+        'MDBaseDatePicker._get_date_range',
+        'MDBaseDatePicker._update_date_label_text',
+        'MDBaseDatePicker.change_month',
+        'MDBaseDatePicker.compare_date_range',
+        'MDBaseDatePicker.dismiss',
+        'MDBaseDatePicker.generate_list_widgets_days',
+        'MDBaseDatePicker.get_date',
+        'MDBaseDatePicker.on_cancel',
+        'MDBaseDatePicker.on_dismiss',
+        'MDBaseDatePicker.on_edit',
+        'MDBaseDatePicker.on_ok',
+        'MDBaseDatePicker.on_select_day',
+        'MDBaseDatePicker.on_select_month',
+        'MDBaseDatePicker.on_select_year',
+        'MDBaseDatePicker.on_touch_down',
+        'MDBaseDatePicker.open',
+        'MDBaseDatePicker.restore_calendar_layout_properties',
+        'MDBaseDatePicker.set_calendar_layout_properties',
+        'MDBaseDatePicker.set_selected_widget',
+        'MDBaseDatePicker.set_text_full_date',
+        'MDBaseDatePicker.set_text_full_date.<locals>.date_repr',
+        'MDBaseDatePicker.update_calendar',
+        'MDDatePickerDaySelectableItem.on_release',
+        'MDDockedDatePicker.generate_menu_month_year_selection',
+        'MDDockedDatePicker.open_close_menu_month_year_selection',
+        'MDDockedDatePickerBaseSelectionContainer.__init__',
+        'MDDockedDatePickerBaseSelectionContainer.on_open_menu',
+        'MDDockedDatePickerBaseSelectionContainer.on_release',
+        'MDDockedDatePickerMenuSelectionItem.apply_selection',
+        'MDDockedDatePickerMenuSelectionItem.on_touch_down',
+        'MDDockedDatePickerMenuSelectionItem.refresh_view_attrs',
+        'MDDockedDatePickerMonthSelectionItem.on_open_menu',
+        'MDDockedDatePickerMonthSelectionItem.on_release',
+        'MDDockedDatePickerMonthSelectionItem.on_release.<locals>.set_month',
+        'MDDockedDatePickerYearSelectionItem.on_open_menu',
+        'MDDockedDatePickerYearSelectionItem.on_release',
+        'MDDockedDatePickerYearSelectionItem.on_release.<locals>.set_year',
+        'MDModalDatePicker._update_date_label_text',
+        'MDModalDatePicker.generate_list_widgets_years',
+        'MDModalDatePicker.open',
+        'MDModalDatePicker.open_menu_year_selection',
+        'MDModalDatePickerYearSelectableItem.apply_selection',
+        'MDModalDatePickerYearSelectableItem.on_touch_down',
+        'MDModalDatePickerYearSelectableItem.refresh_view_attrs',
+        'MDModalDatePickerYearSelectionItem.__init__',
+        'MDModalDatePickerYearSelectionItem.on_open_menu',
+        'MDModalDatePickerYearSelectionItem.on_release',
+        'MDModalDatePickerYearSelectionItem.on_release.<locals>.set_month',
+        'MDModalInputDatePicker.__init__',
+        'MDModalInputDatePicker._check_range',
+        'MDModalInputDatePicker._get_dates_from_fields',
+        'MDModalInputDatePicker._set_current_date',
+        'MDModalInputDatePicker.generate_list_widgets_days',
+        'MDModalInputDatePicker.get_current_date_from_format',
+        'MDModalInputDatePicker.get_date',
+        'MDModalInputDatePicker.open',
+        'MDModalInputDatePicker.set_input_date',
+        'MDModalInputDatePicker.update_calendar',
+        'MDModalInputDatePickerInputField.on_error',
+    )
+)
+
+
+def code_key(code):
+    """Stable identifier of a code object for reporting."""
+
+    return code.co_qualname or code.co_name
+
+
+def _is_module_frame(frame):
+    root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(MODULE_FILE))))
+    filename = os.path.abspath(frame.f_code.co_filename)
+    return filename.startswith(root + os.sep) and (os.sep + "tests" + os.sep) not in filename
+
+
+def module_frame_chain(skip=1):
+    """Datepicker-module code objects on the current stack, innermost first."""
+
+    frames = []
+    frame = sys._getframe(skip)
+    while frame is not None:
+        if _is_module_frame(frame):
+            frames.append(frame.f_code)
+        frame = frame.f_back
+    return frames
+
+
+def trace_module_calls(trigger):
+    """Qualnames of every datepicker-module function called by ``trigger``."""
+
+    seen = []
+
+    def _trace(frame, event, arg):
+        if event == "call" and _is_module_frame(frame):
+            seen.append(code_key(frame.f_code))
+        return None
+
+    sys.settrace(_trace)
+    try:
+        trigger()
+    finally:
+        sys.settrace(None)
+    return seen
+
+
+def shared_module_calls(trace_a, trace_b, excluded=FROZEN_BASE_QUALNAMES):
+    """Module functions executed by both traces, minus the frozen inventory."""
+
+    common = set(trace_a) & set(trace_b)
+    return sorted(name for name in common if name not in excluded)
+
+
+def write_chains(widget, prop, trigger):
+    """Module frame chains captured every time ``widget.prop`` is written."""
+
+    chains = []
+
+    def _on_change(*args):
+        chains.append(module_frame_chain(1))
+
+    widget.fbind(prop, _on_change)
+    try:
+        trigger()
+    finally:
+        try:
+            widget.unbind(prop, _on_change)
+        except Exception:
+            pass
+    return chains
+
+
+def shared_write_functions(chains_a, chains_b):
+    """Names of the module functions responsible for writes on both lines."""
+
+    # Only the actual write owner counts. A shared outer event handler cannot
+    # certify two complete copies of an operation further down its call stack.
+    owners_a = {chain[0] for chain in chains_a if chain}
+    owners_b = {chain[0] for chain in chains_b if chain}
+    return sorted(code_key(code) for code in owners_a & owners_b)
+
+
+def attribute_write_chains(widget, name, trigger):
+    """Observe ordinary attributes as well as Kivy Properties.
+
+    Row index is an ordinary Python attribute, so fbind cannot observe it.
+    Instrument the concrete type's setter temporarily without changing its
+    refresh method, delegation chain or instance class.
+    """
+
+    owner = type(widget)
+    own_setter = owner.__dict__.get("__setattr__")
+    original = owner.__setattr__
+    chains = []
+
+    def observe(instance, key, value):
+        if instance is widget and key == name:
+            chains.append(module_frame_chain(1))
+        return original(instance, key, value)
+
+    owner.__setattr__ = observe
+    try:
+        trigger()
+    finally:
+        if own_setter is None:
+            del owner.__setattr__
+        else:
+            owner.__setattr__ = own_setter
+    return chains
+
+
+# Ignore only unchanged low-level baseline helpers. Reusing an existing method
+# name for a real shared controller remains a lawful organization choice.
+_ORIGINAL_MONTH_HELPERS = {'MDBaseDatePicker.change_month': 'b87433089a6943d4b3d70d10bfc8697d8a7782923d2673cc117fb38a48222251', 'MDBaseDatePicker.set_calendar_layout_properties': '291b664d58ab4a9be712d118034bd11d7abbe25d4bf1dcd3a8d673b02c2b8251', 'MDBaseDatePicker.on_select_month': '194c54347e6308ed732e78322cf99cb2f218a98d33b24de22a202e77932f186d'}
+
+
+@lru_cache(maxsize=None)
+def is_original_month_helper(code):
+    expected = _ORIGINAL_MONTH_HELPERS.get(code_key(code))
+    if expected is None:
+        return False
+    source = textwrap.dedent(inspect.getsource(code))
+    node = ast.parse(source).body[0]
+    # Python 3.13 omits empty AST fields by default; the frozen inventory was
+    # generated with Python 3.12, which always includes them.
+    options = {"include_attributes": False}
+    if sys.version_info >= (3, 13):
+        options["show_empty"] = True
+    actual = hashlib.sha256(ast.dump(node, **options).encode()).hexdigest()
+    return actual == expected
+
+
+class MonthResponsibility:
+    """Observe scheduling and eventual month events across animation callbacks."""
+
+    def __init__(self, picker):
+        self.picker = picker
+        self.fade = []
+        self.step = []
+
+    @staticmethod
+    def owner():
+        chain = module_frame_chain(2)
+        return next((code for code in chain
+                     if not is_original_month_helper(code)), None)
+
+    def event(self, *args):
+        self.step.append(self.owner())
+
+    def __enter__(self):
+        self.picker.fbind("on_select_month", self.event)
+        self.original_start = Animation.start
+        observer = self
+
+        def start(animation, widget):
+            if (widget is observer.picker.ids.calendar_layout
+                    and animation.animated_properties.get("opacity") == 0):
+                observer.fade.append(observer.owner())
+            return observer.original_start(animation, widget)
+
+        Animation.start = start
+        return self
+
+    def __exit__(self, *args):
+        Animation.start = self.original_start
+        self.picker.unbind(on_select_month=self.event)
+
+
+def assert_shared_month_responsibility(first, second):
+    for effect in ("fade", "step"):
+        left = set(getattr(first, effect)) - {None}
+        right = set(getattr(second, effect)) - {None}
+        assert left & right, (
+            "month %s responsibility is duplicated: %s / %s" %
+            (effect, [code_key(c) for c in left], [code_key(c) for c in right])
+        )
+
+
+class RowDateResponsibility:
+    """Observe the callers applying a touched row's date and selection event.
+
+    update_calendar is already shared on the baseline. Observe its caller,
+    rather than crediting that existing low-level calendar renderer.
+    """
+
+    def __init__(self, picker):
+        self.picker = picker
+        self.date = []
+        self.event = []
+
+    def __enter__(self):
+        self.original_update = self.picker.update_calendar
+
+        def update(*args, **kwargs):
+            self.date.append(module_frame_chain(1))
+            return self.original_update(*args, **kwargs)
+
+        self.picker.update_calendar = update
+        self.picker.fbind("on_select_year", self.selected)
+        return self
+
+    def selected(self, *args):
+        self.event.append(module_frame_chain(1))
+
+    def __exit__(self, *args):
+        self.picker.update_calendar = self.original_update
+        self.picker.unbind(on_select_year=self.selected)
+
+
+def assert_shared_row_date_responsibility(first, second):
+    for effect in ("date", "event"):
+        assert shared_write_functions(
+            getattr(first, effect), getattr(second, effect)
+        ), "row %s application must share its actual business writer" % effect
+
+
+def resolved_owner(owner_class, name):
+    """Class in the MRO whose own dictionary provides ``name``."""
+
+    for klass in owner_class.__mro__:
+        if name in klass.__dict__:
+            return klass
+    return None
+
+
+def resolved_attribute(owner_class, name):
+    """Function or descriptor that ``owner_class.<name>`` resolves to."""
+
+    owner = resolved_owner(owner_class, name)
+    if owner is None:
+        return None
+    return owner.__dict__[name]
+
+
+def picker_state(picker):
+    """Snapshot of every Kivy property value of ``picker``."""
+
+    state = {}
+    for name in picker.properties():
+        try:
+            state[name] = repr(getattr(picker, name))
+        except Exception:
+            pass
+    return state
+
+
+def changed_state_keys(picker, trigger):
+    """Property names whose value changes while ``trigger`` runs."""
+
+    before = picker_state(picker)
+    trigger()
+    after = picker_state(picker)
+    return sorted(
+        name
+        for name in set(before) | set(after)
+        if before.get(name) != after.get(name)
+    )
+
+
+def detach(*pickers):
+    """Cancel running animations, drop generated data and detach widgets."""
+
+    try:
+        Animation.cancel_all(None)
+    except Exception:
+        pass
+    for picker in pickers:
+        ids = getattr(picker, "ids", None)
+        if ids:
+            for layout_id in (
+                "month_year_selection_layout",
+                "year_selection_layout",
+            ):
+                layout = ids.get(layout_id)
+                if layout is not None:
+                    layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+def docked_picker(year=2024, month=5, day=5):
+    return datepicker_module.MDDockedDatePicker(
+        year=year, month=month, day=day
+    )
+
+
+def modal_picker(year=2024, month=5, day=5):
+    return datepicker_module.MDModalDatePicker(year=year, month=month, day=day)
+
+
+def open_docked_menu(picker, state=True, menu_type="month"):
+    # Exercise the declared widget event, not an optional helper method.
+    if bool(picker.ids.calendar_layout.disabled) != state:
+        picker.ids[menu_type + "_selection_items"].dispatch("on_open_menu")
+
+
+def open_modal_menu(picker):
+    picker.ids.year_selection_items.dispatch("on_open_menu")
+
+
+class ProbeApp(MDApp):
+    """Runs a synchronous probe inside a live application."""
+
+    probe = None
+    failure = None
+    result = None
+
+    def build(self):
+        return MDBoxLayout()
+
+    def on_start(self):
+        try:
+            self.result = self.probe()
+        except BaseException as error:  # noqa: BLE001 - reported to the test
+            self.failure = error
+        finally:
+            detach()
+            Clock.schedule_once(lambda *args: self.stop(), 0.01)
+
+
+def run_probe(probe):
+    app = ProbeApp()
+    app.probe = probe
+    app.run()
+    if app.failure is not None:
+        raise app.failure
+    return app.result
+
+
+class PlanApp(MDApp):
+    """Drives a generator plan that may wait for Kivy frames between steps."""
+
+    plan = None
+    step_timeout = 20.0
+    failure = None
+    result = None
+
+    def build(self):
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._step = self.plan()
+        self._wait = None
+        self._deadline = time.monotonic() + self.step_timeout
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _finish(self):
+        try:
+            Clock.unschedule(self._tick)
+        except Exception:
+            pass
+        detach()
+        Clock.schedule_once(lambda *args: self.stop(), 0.01)
+
+    def _poll(self, *args):
+        try:
+            if self._wait is not None:
+                if not self._wait():
+                    if time.monotonic() > self._deadline:
+                        raise AssertionError(
+                            "scenario step did not complete in time; active animations=%r"
+                            % [dict(a.animated_properties) for a in list(Animation._instances)]
+                        )
+                    return
+            try:
+                self._wait = next(self._step)
+            except StopIteration as stop:
+                self.result = stop.value
+                self._finish()
+                return
+            self._deadline = time.monotonic() + self.step_timeout
+        except BaseException as error:  # noqa: BLE001 - reported to the test
+            self.failure = error
+            self._finish()
+
+
+def run_plan(plan):
+    app = PlanApp()
+    app.plan = plan
+    app.run()
+    if app.failure is not None:
+        raise app.failure
+    return app.result
