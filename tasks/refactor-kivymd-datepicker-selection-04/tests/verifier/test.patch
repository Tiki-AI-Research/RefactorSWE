+
+class DockedMenuToggle(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import MDDockedDatePicker
+
+        picker = MDDockedDatePicker(year=2024, month=1, day=15)
+        picker.open()
+        yield lambda: self.settle(
