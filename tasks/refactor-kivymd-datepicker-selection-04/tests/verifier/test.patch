+++ b/kivymd/tests/datepicker/test_p2p_menu_toggle_modal.py
@@ -0,0 +1,159 @@
+"""
+P2P regression check: modal year list menu toggle and its open state.
+
+Opening the modal list rotates the menu icon to -90 degrees, hides and
+disables the calendar and the chevrons, scales the calendar to 1.1 and expands
+the selection area to the calendar width minus 36dp; closing collapses the
+selection area to zero size and restores the calendar.  Repeated presses keep
+the visible list and the calendar state consistent.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+import time
+
+from kivy.animation import Animation
+from kivy.clock import Clock
+from kivy.metrics import dp
+
+from kivymd.app import MDApp
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class PollingApp(MDApp):
+    """Drives ``plan()`` inside the Kivy event loop, polling each step."""
+
+    step_timeout = 20.0
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._plan = self.plan()
+        self._wait = None
+        self._deadline = 0.0
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _poll(self, *args):
+        if self._wait is not None and not self._wait():
+            if time.monotonic() > self._deadline:
+                raise AssertionError(
+                    "step timed out after %s seconds" % self.step_timeout
+                )
+            return
+        try:
+            self._wait = next(self._plan)
+        except StopIteration:
+            Clock.unschedule(self._tick)
+            self.stop()
+            return
+        self._deadline = time.monotonic() + self.step_timeout
+
+    def settle(self, *widgets):
+        """True once no animation is still animating the given widgets."""
+
+        instances = list(Animation._instances)
+        return not any(
+            animation.have_properties_to_animate(widget)
+            for animation in instances
+            for widget in widgets
+        )
+
+    def plan(self):
+        raise NotImplementedError
+
+
+class ModalMenuToggle(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import MDModalDatePicker
+
+        picker = MDModalDatePicker(year=2024, month=6, day=10)
+        picker.open()
+        year_items = picker.ids.year_selection_items
+        calendar = picker.ids.calendar_layout
+        selection = picker.ids.year_selection_layout
+        menu_button = year_items.ids.menu_selection_button
+
+        def settled():
+            return self.settle(calendar, menu_button, selection, year_items)
+
+        yield settled
+        assert round(menu_button.rotate_value_angle, 3) == 0.0
+        assert round(calendar.opacity, 3) == 1.0
+        assert calendar.disabled is False
+        assert tuple(selection.size) == (0.0, 0.0)
+
+        def check(open_state):
+            """The visible list and the calendar state must agree."""
+
+            assert (tuple(selection.size)[0] > 0) is open_state
+            assert (round(calendar.opacity, 3) == 0.0) is open_state
+            assert (calendar.disabled is True) is open_state
+            if open_state:
+                assert round(menu_button.rotate_value_angle, 3) == -90.0
+                assert round(calendar.scale_value_x, 3) == 1.1
+                assert round(calendar.scale_value_y, 3) == 1.1
+                assert year_items.ids.chevron_left.disabled is True
+                assert year_items.ids.chevron_right.disabled is True
+                assert round(selection.scale_value_x, 2) == 1.0
+                assert selection.disabled is False
+                assert tuple(selection.size) == (
+                    calendar.width - dp(36),
+                    calendar.height,
+                ), (tuple(selection.size), calendar.width, calendar.height)
+            else:
+                assert round(menu_button.rotate_value_angle, 3) == 0.0
+                assert round(calendar.scale_value_x, 3) == 1.0
+                assert round(calendar.scale_value_y, 3) == 1.0
+                assert year_items.ids.chevron_left.disabled is False
+                assert year_items.ids.chevron_right.disabled is False
+                assert round(year_items.ids.chevron_left.opacity, 3) == 1.0
+                assert tuple(selection.size) == (0.0, 0.0)
+                assert selection.disabled is True
+                assert round(selection.scale_value_x, 3) == 1.2
+
+        # The list starts hidden; three presses must keep opening and closing
+        # it without leaving hidden state behind.
+        for open_state in (True, False, True, False, True, False):
+            year_items.dispatch("on_open_menu")
+            yield lambda state=open_state: settled() and (
+                (tuple(selection.size)[0] > 0) is state
+            )
+            check(open_state)
+
+        # Opening regenerates the year list with the documented bound.
+        assert len(selection.data) == 207
+        assert selection.data[0]["text"] == "1914"
+        assert selection.data[-1]["text"] == "2120"
+
+
+        detach(picker)
+
+
+
+if __name__ == "__main__":
+    ModalMenuToggle().run()
