+"""
+P2P regression check: existing docked month/year menu opening.
+
+The frozen baseline already satisfies these menu effects and delegation
+checks. The selector keeps its legacy filename, but is classified as P2P;
+it is not evidence of a newly completed refactoring responsibility.
+"""
+
+import os
+import sys
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+if _HERE not in sys.path:
+    sys.path.insert(0, _HERE)
+
+import _f2p_selector_support as support  # noqa: E402
+
+from kivymd.uix.pickers.datepicker import datepicker as datepicker_module  # noqa: E402
+
+
+def main():
+    month_container = datepicker_module.MDDockedDatePickerMonthSelectionItem
+    year_container = datepicker_module.MDDockedDatePickerYearSelectionItem
+
+    def probe():
+        month_picker = support.docked_picker()
+        month_trace = support.trace_module_calls(
+            lambda: month_picker.ids.month_selection_items.on_open_menu()
+        )
+        month_opacity = round(month_picker.ids.calendar_layout.opacity, 3)
+        month_rows = len(month_picker.ids.month_year_selection_layout.data)
+
+        year_picker = support.docked_picker()
+        year_trace = support.trace_module_calls(
+            lambda: year_picker.ids.year_selection_items.on_open_menu()
+        )
+        year_opacity = round(year_picker.ids.calendar_layout.opacity, 3)
+        year_rows = len(year_picker.ids.month_year_selection_layout.data)
+
+        shared = support.shared_module_calls(
+            month_trace, year_trace, support.FROZEN_MODULE_QUALNAMES
+        )
+        support.detach(month_picker, year_picker)
+        return month_opacity, year_opacity, month_rows, year_rows, shared
+
+    month_opacity, year_opacity, month_rows, year_rows, shared = (
+        support.run_probe(probe)
+    )
+    assert (month_opacity, year_opacity) == (0.0, 0.0), (
+        "both docked containers must still open the menu, got month=%r "
+        "year=%r" % (month_opacity, year_opacity)
+    )
+    assert month_rows > 0 and year_rows > 0, (
+        "both docked menu-open handlers must still generate their list, got "
+        "%r month rows and %r year rows" % (month_rows, year_rows)
+    )
+
+    month_impl = support.resolved_attribute(month_container, "on_open_menu")
+    year_impl = support.resolved_attribute(year_container, "on_open_menu")
+    assert month_impl is not None and year_impl is not None
+    same_handler = month_impl is year_impl
+    assert same_handler or shared, (
+        "the docked month and year containers must open the month/year menu "
+        "through one shared implementation; they resolve to %r and %r and "
+        "share no implementation introduced by the restructuring"
+        % (
+            support.resolved_owner(month_container, "on_open_menu"),
+            support.resolved_owner(year_container, "on_open_menu"),
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
