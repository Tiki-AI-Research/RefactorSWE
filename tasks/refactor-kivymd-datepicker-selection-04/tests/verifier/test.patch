+++ b/kivymd/tests/datepicker/test_f2p_row_view_refresh_shared.py
@@ -0,0 +1,62 @@
+"""
+F2P acceptance check: the row view refresh is one shared implementation.
+
+Every generated list row is refreshed through ``refresh_view_attrs`` so that
+the row knows its index in the recycle view data.  On the baseline the docked
+and the modal row classes each carried their own copy of that refresh.  The
+restructured picker must serve both row views from a single implementation
+while the refreshed row still records its data index.
+"""
+
+import os
+import sys
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+if _HERE not in sys.path:
+    sys.path.insert(0, _HERE)
+
+import _f2p_selector_support as support  # noqa: E402
+
+from kivymd.uix.pickers.datepicker import datepicker as datepicker_module  # noqa: E402
+
+
+def main():
+    docked_row_class = datepicker_module.MDDockedDatePickerMenuSelectionItem
+    modal_row_class = datepicker_module.MDModalDatePickerYearSelectableItem
+    assert docked_row_class is not modal_row_class
+
+    docked_impl = support.resolved_attribute(
+        docked_row_class, "refresh_view_attrs"
+    )
+    modal_impl = support.resolved_attribute(
+        modal_row_class, "refresh_view_attrs"
+    )
+    assert docked_impl is not None, "docked rows must expose refresh_view_attrs"
+    assert modal_impl is not None, "modal rows must expose refresh_view_attrs"
+    def probe():
+        refreshed = []
+        writes = []
+        for row_class in (docked_row_class, modal_row_class):
+            row = row_class()
+            store = type("Store", (), {"data": [{}]})()
+            writes.append(support.attribute_write_chains(
+                row, "index",
+                lambda row=row, store=store:
+                    row.refresh_view_attrs(store, 3, store.data[0]),
+            ))
+            refreshed.append(row.index)
+        assert support.shared_write_functions(*writes), (
+            "row index refresh must share its actual writer; "
+            "a pure super() forwarding wrapper is permitted"
+        )
+        return refreshed
+
+    result = support.run_probe(probe)
+    assert result == [3, 3], (
+        "the shared refresh must record the row index on both row views, "
+        "got %r" % (result,)
+    )
+
+
+if __name__ == "__main__":
+    main()
