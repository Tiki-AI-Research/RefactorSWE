diff --git a/kivymd/tests/datepicker/test_f2p_chevron_month_step_shared.py b/kivymd/tests/datepicker/test_f2p_chevron_month_step_shared.py
new file mode 100644
index 0000000000000000000000000000000000000000..f454102e1ebcbb375c03a15af05679e97f1859cc
--- /dev/null
+++ b/kivymd/tests/datepicker/test_f2p_chevron_month_step_shared.py
@@ -0,0 +1,54 @@
+"""
+F2P acceptance check: one shared chevron month-stepping implementation.
+
+Releasing a chevron with "next" on the docked month container and on the modal
+selection container must move the displayed month by one through one shared
+implementation of the step.  On the baseline each container defined its own
+copy of the release handler and of the scheduled step.  Both releases must
+still advance the calendar exactly one month.
+"""
+
+import os
+import sys
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+if _HERE not in sys.path:
+    sys.path.insert(0, _HERE)
+
+import _f2p_selector_support as support  # noqa: E402
+
+
+def plan():
+    docked = support.docked_picker()
+    modal = support.modal_picker()
+    docked.open()
+    modal.open()
+
+    with support.MonthResponsibility(docked) as docked_owner:
+        docked.ids.month_selection_items.dispatch("on_release", "next")
+        yield lambda: docked.month == 6
+    with support.MonthResponsibility(modal) as modal_owner:
+        modal.ids.year_selection_items.dispatch("on_release", "next")
+        yield lambda: modal.month == 6
+    support.assert_shared_month_responsibility(docked_owner, modal_owner)
+    return (docked.year, docked.month), (modal.year, modal.month), True
+
+
+def main():
+    docked_state, modal_state, shared = support.run_plan(plan)
+    assert docked_state == (2024, 6), (
+        "the shared chevron step must advance the docked calendar by one "
+        "month, got %r" % (docked_state,)
+    )
+    assert modal_state == (2024, 6), (
+        "the shared chevron step must advance the modal calendar by one "
+        "month, got %r" % (modal_state,)
+    )
+    assert shared, (
+        "the docked and modal chevrons must step the month through one shared "
+        "implementation, no common non-base implementation was executed"
+    )
+
+
+if __name__ == "__main__":
+    main()
