+"""
+P2P regression check: public surface and declarative names of the date pickers.
+
+The docked, modal and modal-input pickers must keep the public classes,
+properties, methods, events and declarative identifiers that applications and
+the declarative layouts rely on, exactly as they are today.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+import time
+
+from kivy.animation import Animation
+from kivy.clock import Clock
+
+from kivymd.app import MDApp
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class PollingApp(MDApp):
+    """Drives ``plan()`` inside the Kivy event loop, polling each step."""
+
+    step_timeout = 20.0
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._plan = self.plan()
+        self._wait = None
+        self._deadline = 0.0
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _poll(self, *args):
+        if self._wait is not None and not self._wait():
+            if time.monotonic() > self._deadline:
+                raise AssertionError(
+                    "step timed out after %s seconds" % self.step_timeout
+                )
+            return
+        try:
+            self._wait = next(self._plan)
+        except StopIteration:
+            Clock.unschedule(self._tick)
+            self.stop()
+            return
+        self._deadline = time.monotonic() + self.step_timeout
+
+    def settle(self, *widgets):
+        """True once no animation is still animating the given widgets."""
+
+        instances = list(Animation._instances)
+        return not any(
+            animation.have_properties_to_animate(widget)
+            for animation in instances
+            for widget in widgets
+        )
+
+    def plan(self):
+        raise NotImplementedError
+
+
+class ContractSurface(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import (
+            MDDockedDatePicker,
+            MDModalDatePicker,
+            MDModalInputDatePicker,
+        )
+        from kivymd.uix.pickers.datepicker.datepicker import (
+            MDBaseDatePicker,
+            MDCalendarLayout,
+            MDDatePickerDaySelectableItem,
+            MDDatePickerTypeDateError,
+            MDDockedDatePickerMenuMonthYearSelection,
+            MDDockedDatePickerMonthSelectionItem,
+            MDDockedDatePickerMenuSelectionItem,
+            MDDockedDatePickerYearSelectionItem,
+            MDModalDatePickerMenuYearSelection,
+            MDModalDatePickerYearSelectableItem,
+            MDModalDatePickerYearSelectionItem,
+        )
+
+        # The classes are importable under their current names from both the
+        # package and the module that defines them.
+        assert MDDockedDatePicker.__name__ == "MDDockedDatePicker"
+        assert MDModalDatePicker.__name__ == "MDModalDatePicker"
+        assert MDModalInputDatePicker.__name__ == "MDModalInputDatePicker"
+        assert MDBaseDatePicker.__name__ == "MDBaseDatePicker"
+        assert issubclass(MDDockedDatePicker, MDBaseDatePicker)
+        assert issubclass(MDModalDatePicker, MDBaseDatePicker)
+        assert issubclass(MDModalInputDatePicker, MDBaseDatePicker)
+        assert issubclass(MDDatePickerTypeDateError, Exception)
+
+        docked = MDDockedDatePicker(year=2024, month=1, day=15)
+        modal = MDModalDatePicker(year=2024, month=6, day=10)
+        modal_input = MDModalInputDatePicker(year=2024, month=6, day=10)
+
+        # Public numeric bounds keep their current defaults and the documented
+        # public methods stay callable on every variant.
+        for picker in (docked, modal, modal_input):
+            assert picker.min_year == 1914, picker.min_year
+            assert picker.max_year == 2121, picker.max_year
+            assert picker.mode == "picker"
+            for name in (
+                "change_month",
