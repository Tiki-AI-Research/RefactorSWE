@@ -0,0 +1,198 @@
+"""
+P2P regression check: the modal input date picker.
+
+``MDModalInputDatePicker`` still opens, validates manually entered dates and
+honours its ``date_format`` options exactly as before, and keeps returning the
+dates entered in its field through ``get_date``.
+
+The file is collected by ``kivymd/tests/conftest.py`` and executed as a
+standalone application script.
+"""
+
+import time
+from datetime import date
+
+from kivy.animation import Animation
+from kivy.clock import Clock
+
+from kivymd.app import MDApp
+
+
+def detach(*pickers):
+    """Drop the generated list data and detach the pickers from the window.
+
+    Cancels the running animations and keeps a collected file from leaving
+    widgets whose recycle views would be laid out after the application
+    stopped.
+    """
+
+    Animation.cancel_all(None)
+    for picker in pickers:
+        for layout_id in (
+            "month_year_selection_layout",
+            "year_selection_layout",
+        ):
+            layout = picker.ids.get(layout_id)
+            if layout is not None:
+                layout.data = []
+        for widget in (picker, getattr(picker, "_scrim", None)):
+            if widget is not None and widget.parent is not None:
+                widget.parent.remove_widget(widget)
+
+
+class PollingApp(MDApp):
+    """Drives ``plan()`` inside the Kivy event loop, polling each step."""
+
+    step_timeout = 20.0
+
+    def build(self):
+        from kivymd.uix.boxlayout import MDBoxLayout
+
+        return MDBoxLayout()
+
+    def on_start(self):
+        self._plan = self.plan()
+        self._wait = None
+        self._deadline = 0.0
+        self._tick = Clock.schedule_interval(self._poll, 0.02)
+
+    def _poll(self, *args):
+        if self._wait is not None and not self._wait():
+            if time.monotonic() > self._deadline:
+                raise AssertionError(
+                    "step timed out after %s seconds" % self.step_timeout
+                )
+            return
+        try:
+            self._wait = next(self._plan)
+        except StopIteration:
+            Clock.unschedule(self._tick)
+            self.stop()
+            return
+        self._deadline = time.monotonic() + self.step_timeout
+
+    def settle(self, *widgets):
+        """True once no animation is still animating the given widgets."""
+
+        instances = list(Animation._instances)
+        return not any(
+            animation.have_properties_to_animate(widget)
+            for animation in instances
+            for widget in widgets
+        )
+
+    def plan(self):
+        raise NotImplementedError
+
+
+class ModalInputPicker(PollingApp):
+    def plan(self):
+        from kivymd.uix.pickers import MDModalInputDatePicker
+
+        picker = MDModalInputDatePicker(year=2024, month=6, day=10)
+        assert picker.is_open is False
+        from kivymd.uix.behaviors.motion_behavior import MotionDatePickerBehavior
+        motion_calls = []
+        original_on_open = MotionDatePickerBehavior.on_open
+
+        def on_open(instance, *args):
+            motion_calls.append(instance)
+            return original_on_open(instance, *args)
+
+        # Observe, rather than replace, the baseline motion lifecycle.
+        inherited = "on_open" not in MotionDatePickerBehavior.__dict__
+        MotionDatePickerBehavior.on_open = on_open
+        try:
+            picker.open()
+            picker.open()
+            assert motion_calls == [picker]
+        finally:
+            if inherited:
+                del MotionDatePickerBehavior.on_open
+            else:
+                MotionDatePickerBehavior.on_open = original_on_open
+        assert picker.is_open is True
+        from kivy.core.window import Window
+        assert picker in Window.children
+        assert picker._scrim is not None and picker._scrim in Window.children
+        children_before = list(Window.children)
+        scrim_before = picker._scrim
+        picker.open()
+        assert list(Window.children) == children_before
+        assert picker._scrim is scrim_before
+        today = date.today()
+        field = picker.ids.input_date_field
+        yield lambda: field.text not in ("", None)
+        assert picker.date_format == "mm/dd/yyyy", picker.date_format
+        assert field.text == today.strftime(
+            "%m/%d/%Y"
+        ), "the current date prefills the field"
+        assert picker.get_date() == [today], picker.get_date()
+
+        # Every ``date_format`` option is honoured when the entered date is
+        # parsed and when the current date is rendered back.  An entry that
+        # does not match the format is reported as an error and contributes
+        # no date; the following valid entry clears the error and is adopted.
+        for date_format, invalid, valid, expected, rendered in (
+            (
+                "dd/mm/yyyy",
+                "99/99/9999",
+                "05/02/2024",
+                date(2024, 2, 5),
+                "5/2/2024",
+            ),
+            (
+                "mm/dd/yyyy",
+                "99/99/9999",
+                "02/05/2024",
+                date(2024, 2, 5),
+                "2/5/2024",
+            ),
+            (
+                "yyyy/mm/dd",
+                "99/99/9999",
+                "2024/02/05",
+                date(2024, 2, 5),
+                "2024/2/5",
+            ),
+        ):
+            picker.date_format = date_format
+            field.text = invalid
+            yield lambda: field.error is True
+            assert picker.get_date() == [], (date_format, picker.get_date())
+            field.text = valid
+            assert picker.get_date() == [expected], (
+                date_format,
+                picker.get_date(),
+            )
+            yield lambda value=rendered: (
+                picker.get_current_date_from_format() == value
+            )
+            assert picker.get_date() == [expected]
+            assert picker.set_text_full_date() == "Mon, Feb 5", (
+                picker.set_text_full_date()
+            )
+
+        # A manually entered date that does not match the format is reported
+        # as an error and contributes no date.
+        picker.date_format = "mm/dd/yyyy"
+        field.text = "13/31/2024"
+        assert picker.get_date() == [], picker.get_date()
+        yield lambda: field.error is True
+        assert picker.get_date() == []
+
+        # A valid entry clears the error and is parsed again.
+        field.text = "07/04/2025"
+        assert picker.get_date() == [date(2025, 7, 4)], picker.get_date()
+        yield lambda: field.error is False
+        yield lambda: picker.get_current_date_from_format() == "7/4/2025"
+        assert picker.get_date() == [date(2025, 7, 4)]
+        assert picker.set_text_full_date() == "Fri, Jul 4"
+
+
+        detach(picker)
+
+
+
+if __name__ == "__main__":
+    ModalInputPicker().run()
