+    def step_month(self, direction: str) -> None:
+        """
+        Animates calendar layout and changes displayed month in the given direction.
+        """
+        def set_month(*args):
+            self.change_month(direction)
+            self._update_date_label_text()
+            self.restore_calendar_layout_properties()
+
+        self.set_calendar_layout_properties(set_month)
+
+    def step_year(self, direction: str) -> None:
+        """
+        Validates year boundaries, animates calendar layout, and updates calendar year.
+        """
+        year = self.year
+        if direction == "prev":
+            year -= 1
+        elif direction == "next":
+            year += 1
+
+        if year < self.min_year or year > self.max_year:
+            raise MDDatePickerTypeDateError(
+                "The maximum/minimum value of the year is exceeded or less "
+                "than the set value"
+            )
+
+        def set_year(*args):
+            self.update_calendar(year, self.month)
+            self.restore_calendar_layout_properties()
+
+        self.set_calendar_layout_properties(set_year)
+
+    def select_month(self, month: int) -> None:
+        """
+        Selects month, updating displayed calendar and dispatching on_select_month.
+        """
+        self.update_calendar(self.year, month)
+        self.dispatch("on_select_month", month)
+
+    def select_year(self, year: int, month: int | None = None) -> None:
+        """
+        Selects year, updating displayed calendar and dispatching on_select_year.
+        """
+        target_month = self.month if month is None else month
+        self.update_calendar(year, target_month)
+        self.dispatch("on_select_year", year)
+
+    def generate_year_selection_data(
+        self,
+        viewclass: str,
+        year_key: str = "month_year_name",
+        include_index: bool = False,
+        extra_attrs: dict | None = None,
+    ) -> list[dict]:
+        """
+        Generates list data for year selection recycle view.
+        """
+        data = []
+        for i, year in enumerate(range(self.min_year, self.max_year)):
+            item = {
+                "date_picker": self,
+                year_key: str(year),
+                "viewclass": viewclass,
+            }
+            if include_index:
+                item["index"] = i
+            if extra_attrs:
+                item.update(extra_attrs)
+            data.append(item)
+        return data
+
+    def toggle_menu_selection(
+        self, menu_type: str = "year", state: bool | None = None
+    ) -> bool:
+        """
+        Toggles or explicitly sets the month/year selection menu state.
+        Returns the new state (True for open, False for closed).
+        """
+        if state is None:
+            self._menu_selection_is_open = not self._menu_selection_is_open
+
+        # Explicit show/hide preserves the docked direct API's baseline behavior:
+        # only event-driven toggles advance the remembered toggle state.
+        current_state = self._menu_selection_is_open if state is None else state
+        opacity = 0 if current_state else 1
+        disabled = True if current_state else 0
+        rotate = -90 if current_state else 0
+
+        self.prepare_menu_selection(menu_type, current_state)
+
+        for container in self._get_menu_chevron_containers():
+            container.ids.chevron_left.disabled = disabled
+            container.ids.chevron_left.opacity = opacity
+            container.ids.chevron_right.disabled = disabled
+            container.ids.chevron_right.opacity = opacity
+
+        calendar_layout = self.ids.calendar_layout
+        calendar_layout.disabled = disabled
+        calendar_layout.opacity = opacity
+        if current_state:
+            calendar_layout.scale_value_x = 1.1
+            calendar_layout.scale_value_y = 1.1
+
+        button = self._get_menu_selection_button(menu_type)
+        if button:
+            Animation(rotate_value_angle=rotate, d=0.2).start(button)
+
+        layout = self.get_selection_layout()
+        if layout:
+            layout.size = self.get_menu_selection_size(current_state)
+
+        self.apply_menu_selection_state(current_state, menu_type, layout)
+
+        if not current_state:
+            Animation(scale_value_x=1, scale_value_y=1, d=0.1).start(
+                calendar_layout
+            )
+
+        return current_state
+
+    def prepare_menu_selection(self, menu_type: str, state: bool) -> None:
+        """Hook for subclasses to generate or prepare list data."""
+
+    def _get_menu_chevron_containers(self) -> list:
+        """Hook for subclasses to return containers with chevrons to toggle."""
+        return []
+
+    def _get_menu_selection_button(self, menu_type: str):
