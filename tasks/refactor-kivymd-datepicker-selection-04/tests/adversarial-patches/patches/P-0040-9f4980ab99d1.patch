+    def refresh_view_attrs(self, rv, index, data):
+        self.index = index
+        return super().refresh_view_attrs(rv, index, data)
+
+    def _can_select_row(self) -> bool:
+        return self.selectable
+
+    def select_row(self) -> None:
+        """Subclasses override to apply specific month/year selection logic."""
+
+    def on_touch_down(self, touch):
+        if super().on_touch_down(touch):
+            return True
+        if self.collide_point(*touch.pos) and self._can_select_row():
+            self.select_row()
+            return self.parent.select_with_touch(self.index, touch)
+
+    def apply_selection(self, rv, index, is_selected):
+        self.selected = is_selected
+        rv.data[index]["selected"] = is_selected
