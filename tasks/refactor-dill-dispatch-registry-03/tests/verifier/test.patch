+def test_global_protocol_and_call_override_are_effective():
+    import pickletools
+    before = dill.settings.copy()
+    value = [1, 2]
+
+    def protocol_used(payload):
+        assert isinstance(payload, bytes), "dumps must return a pickle byte stream"
+        try:
+            operations = list(pickletools.genops(payload))
+        except (ValueError, TypeError) as exc:
+            raise AssertionError("invalid pickle protocol stream: " + str(exc)) from exc
+        if operations[0][0].name == "PROTO":
+            return operations[0][1]
+        return max(op.proto for op, argument, position in operations)
+
+    try:
+        dill.settings['protocol'] = 0
+        for writer in (lambda: dill.dumps(value),
+                       lambda: _dump_to_bytes(value)):
+            payload = writer()
+            assert protocol_used(payload) == 0
+            assert stock_pickle.loads(payload) == value
+        assert protocol_used(dill.dumps(value, protocol=4)) == 4
+        assert protocol_used(_dump_to_bytes(value, protocol=4)) == 4
+        dill.settings['protocol'] = 4
+        assert protocol_used(dill.dumps(value)) == 4
+        assert protocol_used(_dump_to_bytes(value)) == 4
+        assert protocol_used(dill.dumps(value, protocol=0)) == 0
+    finally:
+        dill.settings.clear()
+        dill.settings.update(before)
+
+
+def _dump_to_bytes(value, **options):
+    stream = BytesIO()
+    assert dill.dump(value, stream, **options) is None
+    return stream.getvalue()
+
