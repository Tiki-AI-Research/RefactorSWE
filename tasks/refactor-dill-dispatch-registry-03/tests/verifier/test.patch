+#!/usr/bin/env python
+"""Run frozen P2P leaves and this round's F2P leaves into one JUnit report."""
+
+import argparse
+import importlib.util
+import os
+import subprocess
+import sys
+import tempfile
+import traceback
+import xml.etree.ElementTree as ET
+
+REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+if REPO_ROOT not in sys.path:
+    sys.path.insert(0, REPO_ROOT)
+
+
+F2P_SELECTORS = ['dill/tests/test_registry_ownership.py::test_registry_lifecycle_has_one_owner', 'dill/tests/test_f2p_registry.py::test_f2p_external_callable_without_module_survives_cycles__cycle1_disable_without_module', 'dill/tests/test_f2p_registry.py::test_f2p_external_callable_without_module_survives_cycles__cycle1_disabled_stock_dispatch_keeps_handler', 'dill/tests/test_f2p_registry.py::test_f2p_external_callable_without_module_survives_cycles__cycle1_disabled_stock_roundtrip', 'dill/tests/test_f2p_registry.py::test_f2p_external_callable_without_module_survives_cycles__cycle2_enabled_stock_roundtrip', 'dill/tests/test_f2p_registry.py::test_f2p_external_callable_without_module_survives_cycles__cycle2_disable_without_module', 'dill/tests/test_f2p_registry.py::test_f2p_external_callable_without_module_survives_cycles__cycle2_disabled_stock_dispatch_keeps_handler', 'dill/tests/test_f2p_registry.py::test_f2p_external_callable_without_module_survives_cycles__cycle2_disabled_stock_roundtrip']
+
+
+def load_module(path):
+    spec = importlib.util.spec_from_file_location("f2p_tests", os.path.abspath(path))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--p2p-select", required=True)
+    parser.add_argument("--junit", required=True)
+    args = parser.parse_args()
+    suite = ET.Element("testsuite", name="dill-p2p-f2p")
+    failures = errors = total = 0
+
+    with tempfile.TemporaryDirectory(dir=os.environ.get("TMPDIR")) as work:
+        p2p_report = os.path.join(work, "p2p.xml")
+        p2p_runner = os.path.join(REPO_ROOT, "dill", "tests", "p2p_runner.py")
+        completed = subprocess.run(
+            [sys.executable, p2p_runner, "--p2p-select", args.p2p_select,
+             "--junit", p2p_report], cwd=REPO_ROOT, text=True)
+        if os.path.exists(p2p_report):
+            p2p_root = ET.parse(p2p_report).getroot()
+            for case in p2p_root.findall("testcase"):
+                suite.append(case)
+                total += 1
+                failures += len(case.findall("failure"))
+                errors += len(case.findall("error"))
+        elif completed.returncode:
+            case = ET.SubElement(suite, "testcase", classname="p2p_runner",
+                                 name="p2p-report")
+            ET.SubElement(case, "error", type="runner", message="missing JUnit report")
+            total += 1
+            errors += 1
+
+    modules = {}
+    for selector in F2P_SELECTORS:
+        path, leaf = selector.split("::", 1)
+        case = ET.SubElement(suite, "testcase", classname=path, name=leaf)
+        total += 1
+        try:
+            if path not in modules:
+                modules[path] = load_module(os.path.join(REPO_ROOT, path))
+            getattr(modules[path], leaf)()
+        except AssertionError as exc:
+            failures += 1
+            failure = ET.SubElement(case, "failure", type=type(exc).__name__, message=str(exc))
+            failure.text = traceback.format_exc()
+        except Exception as exc:
+            errors += 1
+            error = ET.SubElement(case, "error", type=type(exc).__name__, message=str(exc))
+            error.text = traceback.format_exc()
+
+    suite.set("tests", str(total))
+    suite.set("failures", str(failures))
+    suite.set("errors", str(errors))
+    suite.set("skipped", "0")
+    report = os.path.abspath(args.junit)
+    os.makedirs(os.path.dirname(report), exist_ok=True)
+    ET.ElementTree(suite).write(report, encoding="utf-8", xml_declaration=True)
+    return 1 if failures or errors else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
