+def _assert_explicit_standard_handlers_are_current_registrations():
+    # Each scenario starts before dill import: the oracle is the runtime's
+    # original standard serializer, never a candidate-owned registry snapshot.
+    import json
+    import subprocess
+    import sys
+    script = r"""
+import json, pickle, sys
+from io import BytesIO
+standard = pickle._Pickler.dispatch.copy()
+import dill
+api, key = sys.argv[1:]
+type_, value = (int, 37) if key == 'int' else (dict, {'x': 1})
+def roundtrip(cls):
+    stream = BytesIO(); cls(stream, protocol=4).dump(value)
+    return pickle.loads(stream.getvalue())
+def external(pickler, obj):
+    pickler.save_reduce(str, ('old-external',), obj=obj)
+try:
+    dill.extend(False)
+    pickle._Pickler.dispatch[type_] = external
+    assert roundtrip(pickle._Pickler) == 'old-external'
+    handler = standard[type_]
+    if api == 'register': assert dill.register(t=type_)(handler) is handler
+    elif api == 'pickle': assert dill.pickle(t=type_, func=handler) is None
+    else: dill.Pickler.dispatch[type_] = handler
+    assert roundtrip(dill.Pickler) == value
+    assert dill.extend(True) is None
+    assert pickle._Pickler.dispatch[type_] is handler, 'explicitly chosen standard handler was not published'
+    assert roundtrip(pickle._Pickler) == value, 'stock serialization did not use the current registration'
+    result = {'passed': True}
+except Exception as exc:
+    result = {'passed': False, 'error': type(exc).__name__, 'message': str(exc)}
+print('STANDARD_REGISTRATION_RESULT='+json.dumps(result))
+"""
+    for api in ('register', 'pickle', 'dispatch'):
+        for key in ('int', 'dict'):
+            result = subprocess.run([sys.executable, '-B', '-c', script, api, key],
+                                    capture_output=True, text=True, timeout=30)
+            if result.returncode:
+                raise RuntimeError('standard registration observation failed: '+result.stderr[-2000:])
+            receipts = [line for line in result.stdout.splitlines() if line.startswith('STANDARD_REGISTRATION_RESULT=')]
+            if len(receipts) != 1:
+                raise RuntimeError('missing unique standard registration receipt')
+            observation = json.loads(receipts[0].split('=', 1)[1])
+            assert observation['passed'], f'{api}/{key}: {observation}'
