+def test_serialized_format_remains_compatible():
+    import base64
+    # Frozen baseline bytes for this deterministic primitive payload, protocol 4.
+    # A same-implementation dumps/loads roundtrip alone would miss a new prefix.
+    old_payload = base64.b64decode(
+        "gASVHAAAAAAAAAB9lCiMAWGUXZQoSwFLAmWMAWKUjAR0ZXh0lHUu")
+    value = {"a": [1, 2], "b": "text"}
+    assert dill.loads(old_payload) == value
+    assert dill.load(BytesIO(old_payload)) == value
+    payload = dill.dumps(value, protocol=4)
+    assert payload == old_payload
+    assert stock_pickle.loads(payload) == value
+    stream = BytesIO()
+    assert dill.dump(value, stream, protocol=4) is None
+    assert stream.getvalue() == old_payload
+    assert stock_pickle.load(BytesIO(stream.getvalue())) == value
