@@ -0,0 +1,400 @@
+"""Independent exact leaves for the registry and pickle integration contract."""
+
+import pickle as stock_pickle
+import subprocess
+import sys
+from contextlib import contextmanager
+from io import BytesIO
+
+import dill
+
+
+@contextmanager
+def preserved_dispatch():
+    dill_dispatch = dill.Pickler.dispatch.copy()
+    stock_dispatch = stock_pickle._Pickler.dispatch.copy()
+    try:
+        yield
+    finally:
+        dill.Pickler.dispatch.clear()
+        dill.Pickler.dispatch.update(dill_dispatch)
+        stock_pickle._Pickler.dispatch.clear()
+        stock_pickle._Pickler.dispatch.update(stock_dispatch)
+
+
+def save_text(text):
+    def save(pickler, obj):
+        pickler.save_reduce(str, (text,), obj=obj)
+    return save
+
+
+def roundtrip(pickler_type, value):
+    stream = BytesIO()
+    pickler_type(stream).dump(value)
+    return stock_pickle.loads(stream.getvalue())
+
+
+class Registered:
+    def __reduce_ex__(self, protocol):
+            raise AssertionError("the registered serializer was not selected")
+
+
+def test_f2p_register_decorator_serializes_instances():
+    with preserved_dispatch():
+        serializer = save_text("decorator")
+        dill.register(Registered)(serializer)
+        result = roundtrip(dill.Pickler, Registered())
+    assert result == "decorator"
+
+
+def test_f2p_register_decorator_returns_original_serializer():
+    with preserved_dispatch():
+        serializer = save_text("decorator")
+        returned = dill.register(Registered)(serializer)
+    assert returned is serializer
+
+
+def test_f2p_pickle_keyword_updates_dispatch():
+    with preserved_dispatch():
+        serializer = save_text("keyword")
+        dill.pickle(t=Registered, func=serializer)
+        result = dill.Pickler.dispatch[Registered] is serializer
+    assert result is True
+
+
+def test_f2p_pickle_keyword_returns_none():
+    with preserved_dispatch():
+        returned = dill.pickle(t=Registered, func=save_text("keyword"))
+    assert returned is None
+
+
+def test_f2p_direct_dispatch_mutation_controls_dill_serializer():
+    with preserved_dispatch():
+        serializer = save_text("assigned")
+        dill.Pickler.dispatch[Registered] = serializer
+        result = roundtrip(dill.Pickler, Registered())
+    assert result == "assigned"
+
+
+def test_f2p_dispatch_delete_exposes_original_reduction():
+    with preserved_dispatch():
+        dill.Pickler.dispatch[Registered] = save_text("assigned")
+        del dill.Pickler.dispatch[Registered]
+        try:
+            roundtrip(dill.Pickler, Registered())
+        except AssertionError as exc:
+            result = str(exc)
+        else:
+            result = "serializer still selected"
+    assert result == "the registered serializer was not selected"
+
+
+def test_f2p_extend_uses_latest_registration_for_stock_pickler():
+    with preserved_dispatch():
+        first = save_text("first")
+        second = save_text("second")
+        dill.pickle(Registered, first)
+        dill.extend(False)
+        dill.pickle(Registered, second)
+        dill.extend(True)
+        result = roundtrip(stock_pickle._Pickler, Registered())
+    assert result == "second"
+
+
+def test_f2p_disable_keeps_dill_dispatch_and_serializer():
+    with preserved_dispatch():
+        serializer = save_text("retained")
+        dill.pickle(Registered, serializer)
+        dill.extend(True)
+        dill.extend(False)
+        result = roundtrip(dill.Pickler, Registered())
+    assert result == "retained"
+
+
+def test_f2p_external_stock_handler_survives_disable():
+    class External:
+        pass
+    external = save_text("external")
+    with preserved_dispatch():
+        dill.extend(True)
+        stock_pickle._Pickler.dispatch[External] = external
+        dill.extend(False)
+        result = roundtrip(stock_pickle._Pickler, External())
+    assert result == "external"
+
+
+def test_f2p_external_dill_registration_survives_disable():
+    class External:
+        pass
+    external = save_text("registered-external")
+    with preserved_dispatch():
+        dill.pickle(External, external)
+        dill.extend(True)
+        dill.extend(False)
+        result = roundtrip(stock_pickle._Pickler, External())
+    assert result == "registered-external"
+
+
+def test_f2p_external_replacement_is_not_restored():
+    external = save_text("replacement")
+    with preserved_dispatch():
+        dill.extend(True)
+        stock_pickle._Pickler.dispatch[dict] = external
+        dill.extend(False)
+        result = roundtrip(stock_pickle._Pickler, {})
+    assert result == "replacement"
+
+
+def test_f2p_metaclass_lookup_uses_type_serializer_without_inserting_key():
+    class Meta(type):
+        pass
+    with preserved_dispatch():
+        dispatch = dill.Pickler.dispatch
+        result = dispatch[Meta] is dispatch[type]
+    assert result is True
+
+
+def test_f2p_extend_false_restores_standard_entry():
+    with preserved_dispatch():
+        original = stock_pickle._Pickler.dispatch.get(int)
+        dill_owned = save_text("dill-dict")
+        dill_owned.__module__ = "dill._dill"
+        dill.Pickler.dispatch[int] = dill_owned
+        dill.extend(True)
+        dill.extend(False)
+        result = stock_pickle._Pickler.dispatch.get(int) is original
+    assert result is True
+
+    # Capture the real standard handler before import; exercise direct access
+    # and repeated disabling without depending on registry bookkeeping.
+    code = """
+import pickle
+from io import BytesIO
+
+standard = pickle._Pickler.dispatch[dict]
+import dill
+
+handler = dill.Pickler.dispatch[dict]
+value = {'answer': 42}
+
+def roundtrip():
+    stream = BytesIO()
+    pickle._Pickler(stream).dump(value)
+    return pickle.loads(stream.getvalue())
+
+for cycle in range(2):
+    dill.extend(True)
+    dill.extend(False)
+    pickle._Pickler.dispatch[dict] = handler
+    assert roundtrip() == value
+    assert dill.extend(False) is None
+    assert pickle._Pickler.dispatch.get(dict) is standard, (
+        'disable must restore the pre-extension standard handler after '
+        'direct assignment of a dill serializer (cycle %s)' % cycle
+    )
+    assert dill.Pickler.dispatch[dict] is handler
+    assert roundtrip() == value
+"""
+    completed = subprocess.run([sys.executable, "-c", code],
+                               capture_output=True, text=True, timeout=30)
+    assert completed.returncode == 0, completed.stdout + completed.stderr
+
+
+def test_f2p_import_auto_extension_in_fresh_interpreter():
+    code = """
+import pickle
+before = pickle._Pickler.dispatch.copy()
+import dill
+import types
+ok = (pickle._Pickler.dispatch is not dill.Pickler.dispatch
+      and pickle._Pickler.dispatch[type].__module__ == 'dill._dill'
+      and types.CodeType not in before
+      and types.CodeType in pickle._Pickler.dispatch)
+raise SystemExit(0 if ok else 1)
+"""
+    completed = subprocess.run([sys.executable, "-c", code],
+                               capture_output=True, text=True)
+    assert completed.returncode == 0
+
+
+def test_f2p_extend_return_and_default_flag():
+    with preserved_dispatch():
+        import inspect
+        signature = inspect.signature(dill.extend)
+        assert signature.parameters['use_dill'].default is True
+        for call in (lambda: dill.extend(), lambda: dill.extend(True),
+                     lambda: dill.extend(False), lambda: dill.extend(use_dill=True),
+                     lambda: dill.extend(use_dill=False)):
+            assert call() is None
+        dill.extend()
+        assert stock_pickle._Pickler.dispatch[type] is dill.Pickler.dispatch[type]
+
+
+def test_f2p_serializer_exception_propagates_from_dumps():
+    class Bad:
+        pass
+    def failing(pickler, obj):
+        raise ValueError("serializer failure")
+    with preserved_dispatch():
+        dill.pickle(Bad, failing)
+        try:
+            dill.dumps(Bad())
+        except ValueError as exc:
+            result = str(exc)
+        else:
+            result = "no exception"
+    assert result == "serializer failure"
+
+
+def test_f2p_safe_pickles_reports_failed_serializer():
+    class Bad:
+        pass
+    def failing(pickler, obj):
+        raise ValueError("serializer failure")
+    with preserved_dispatch():
+        dill.pickle(Bad, failing)
+        result = dill.pickles(Bad(), safe=True)
+    assert result is False
+
+
+# ---------------------------------------------------------------------------
+# Independently scored checkpoints
+#
+# A multi-assertion scenario is reported as one F2P selector per checkpoint.
+# The scenario runs once per process and records every checkpoint; each leaf
+# below judges a single checkpoint.  Checkpoints that already hold on the
+# unrefactored baseline are preconditions of every leaf of their scenario, and
+# a scenario that stops before completing fails every leaf, so the leaves pass
+# together exactly when the original combined test passed.
+# ---------------------------------------------------------------------------
+
+
+class _Checkpoints:
+    def __init__(self):
+        self.results = {}
+        self.messages = {}
+        self.preconditions = []
+
+    def check(self, name, condition, message="", precondition=False):
+        if precondition:
+            self.preconditions.append(name)
+        self.messages[name] = message
+        try:
+            self.results[name] = bool(condition())
+        except BaseException:
+            self.results[name] = False
+            raise
+
+    def record(self, name, value, message="", precondition=False):
+        self.check(name, lambda: value, message, precondition)
+
+
+_SCENARIO_OUTCOMES = {}
+
+
+def _scenario_outcome(scenario):
+    if scenario not in _SCENARIO_OUTCOMES:
+        checkpoints = _Checkpoints()
+        try:
+            scenario(checkpoints)
+        except Exception as exc:  # reported by every leaf of this scenario
+            _SCENARIO_OUTCOMES[scenario] = (checkpoints, exc)
+        else:
+            _SCENARIO_OUTCOMES[scenario] = (checkpoints, None)
+    return _SCENARIO_OUTCOMES[scenario]
+
+
+def _assert_checkpoint(scenario, name):
+    checkpoints, stopped = _scenario_outcome(scenario)
+    for required in checkpoints.preconditions:
+        assert checkpoints.results[required], (
+            "precondition %r failed: %s" % (required, checkpoints.messages[required]))
+    if name in checkpoints.results:
+        assert checkpoints.results[name], (
+            "checkpoint %r failed: %s" % (name, checkpoints.messages[name]))
+    if stopped is not None:
+        if isinstance(stopped, AssertionError):
+            raise AssertionError(
+                "scenario stopped before completing: %s" % (stopped,)) from stopped
+        raise stopped
+    assert name in checkpoints.results, "checkpoint %r was not reached" % (name,)
+
+
+_EXTERNAL_RESULT = "external-callable"
+_DISABLE_MESSAGE = (
+    "disabling integration must preserve external callable handlers "
+    "without requiring __module__"
+)
+
+
+def _scenario_external_callable_without_module_survives_cycles(checkpoints):
+    """External serializers need only be callable, including bound __call__."""
+    def serializer(pickler, obj):
+        pickler.save_reduce(str, (_EXTERNAL_RESULT,), obj=obj)
+
+    # A normal Python method-wrapper accepts the serializer's two arguments
+    # but has no __module__; no custom metadata or dispatch API is required.
+    handler = serializer.__call__
+    with preserved_dispatch():
+        dill.pickle(t=Registered, func=handler)
+        checkpoints.check(
+            "dill_pickler_roundtrip",
+            lambda: roundtrip(dill.Pickler, Registered()) == _EXTERNAL_RESULT,
+            "dill.Pickler must serialize through the registered external callable",
+            precondition=True)
+        for cycle in (1, 2):
+            dill.extend(True)
+            checkpoints.check(
+                "cycle%d_enabled_stock_roundtrip" % cycle,
+                lambda: roundtrip(stock_pickle._Pickler, Registered()) == _EXTERNAL_RESULT,
+                "enabled integration must serialize through the external callable",
+                precondition=(cycle == 1))
+            try:
+                dill.extend(False)
+            except AttributeError as exc:
+                checkpoints.record("cycle%d_disable_without_module" % cycle, False, _DISABLE_MESSAGE)
+                raise AssertionError(_DISABLE_MESSAGE) from exc
+            checkpoints.record("cycle%d_disable_without_module" % cycle, True, _DISABLE_MESSAGE)
+            checkpoints.check(
+                "cycle%d_disabled_stock_dispatch_keeps_handler" % cycle,
+                lambda: stock_pickle._Pickler.dispatch.get(Registered) is handler,
+                "disabling integration must keep the external handler in the stock table")
+            checkpoints.check(
+                "cycle%d_disabled_stock_roundtrip" % cycle,
+                lambda: roundtrip(stock_pickle._Pickler, Registered()) == _EXTERNAL_RESULT,
+                "the stock pickler must still use the external handler after disabling")
+
+
+def test_f2p_external_callable_without_module_survives_cycles__cycle1_disable_without_module():
+    _assert_checkpoint(_scenario_external_callable_without_module_survives_cycles,
+                       "cycle1_disable_without_module")
+
+
+def test_f2p_external_callable_without_module_survives_cycles__cycle1_disabled_stock_dispatch_keeps_handler():
+    _assert_checkpoint(_scenario_external_callable_without_module_survives_cycles,
+                       "cycle1_disabled_stock_dispatch_keeps_handler")
+
+
+def test_f2p_external_callable_without_module_survives_cycles__cycle1_disabled_stock_roundtrip():
+    _assert_checkpoint(_scenario_external_callable_without_module_survives_cycles,
+                       "cycle1_disabled_stock_roundtrip")
+
+
+def test_f2p_external_callable_without_module_survives_cycles__cycle2_enabled_stock_roundtrip():
+    _assert_checkpoint(_scenario_external_callable_without_module_survives_cycles,
+                       "cycle2_enabled_stock_roundtrip")
+
+
+def test_f2p_external_callable_without_module_survives_cycles__cycle2_disable_without_module():
+    _assert_checkpoint(_scenario_external_callable_without_module_survives_cycles,
+                       "cycle2_disable_without_module")
+
+
+def test_f2p_external_callable_without_module_survives_cycles__cycle2_disabled_stock_dispatch_keeps_handler():
+    _assert_checkpoint(_scenario_external_callable_without_module_survives_cycles,
+                       "cycle2_disabled_stock_dispatch_keeps_handler")
+
+
+def test_f2p_external_callable_without_module_survives_cycles__cycle2_disabled_stock_roundtrip():
+    _assert_checkpoint(_scenario_external_callable_without_module_survives_cycles,
+                       "cycle2_disabled_stock_roundtrip")
