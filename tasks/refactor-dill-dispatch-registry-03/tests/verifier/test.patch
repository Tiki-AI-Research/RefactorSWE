+#!/usr/bin/env python
+"""Run selected P2P and original leaves and emit a small JUnit document."""
+
+import argparse
+import importlib.util
+import os
+import sys
+import traceback
+import xml.etree.ElementTree as ET
+
+
+REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+if REPO_ROOT not in sys.path:
+    sys.path.insert(0, REPO_ROOT)
+
+def load_module(path):
+    absolute = os.path.abspath(path)
+    name = "p2p_" + os.path.basename(path).replace(".", "_")
+    spec = importlib.util.spec_from_file_location(name, absolute)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--junit", required=True)
+    parser.add_argument("--p2p-select", default=None)
+    parser.add_argument("--config", default=None)
+    args = parser.parse_args()
+
+    if not args.p2p_select:
+        raise SystemExit("--p2p-select is required")
+    with open(args.p2p_select) as selected_file:
+        selected = [line.strip().split("::", 1)
+                    for line in selected_file if line.strip()]
+
+    suite = ET.Element("testsuite", name="dill-p2p", tests=str(len(selected)),
+                       failures="0", errors="0", skipped="0")
+    failures = errors = 0
+    modules = {}
+    for path, leaf in selected:
+        case = ET.SubElement(suite, "testcase", classname=path, name=leaf)
+        try:
+            if path not in modules:
+                modules[path] = load_module(path)
+            module = modules[path]
+            getattr(module, leaf)()
+        except AssertionError as exc:
+            failures += 1
+            failure = ET.SubElement(case, "failure", type=type(exc).__name__,
+                                    message=str(exc))
+            failure.text = traceback.format_exc()
+        except Exception as exc:
+            errors += 1
+            error = ET.SubElement(case, "error", type=type(exc).__name__,
+                                  message=str(exc))
+            error.text = traceback.format_exc()
+
+    suite.set("failures", str(failures))
+    suite.set("errors", str(errors))
+    os.makedirs(os.path.dirname(os.path.abspath(args.junit)), exist_ok=True)
+    ET.ElementTree(suite).write(args.junit, encoding="utf-8", xml_declaration=True)
+    return 1 if failures or errors else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
