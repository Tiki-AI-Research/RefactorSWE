+++ b/dill/tests/test_p2p_registry.py
@@ -0,0 +1,340 @@
+"""Focused P2P coverage for dill's public registration lifecycle."""
+
+import pickle as stock_pickle
+from contextlib import contextmanager
+from io import BytesIO
+from types import CodeType
+
+import dill
+
+
+@contextmanager
+def preserved_dispatch():
+    dill_dispatch = dill.Pickler.dispatch.copy()
+    stock_dispatch = stock_pickle._Pickler.dispatch.copy()
+    try:
+        yield
+    finally:
+        dill.Pickler.dispatch.clear()
+        dill.Pickler.dispatch.update(dill_dispatch)
+        stock_pickle._Pickler.dispatch.clear()
+        stock_pickle._Pickler.dispatch.update(stock_dispatch)
+
+
+def _save_token(token):
+    def save(pickler, obj):
+        pickler.save_reduce(str, (token,), obj=obj)
+    return save
+
+
+def test_register_decorator_positional():
+    class Registered:
+        pass
+    save = _save_token("decorator-positional")
+    with preserved_dispatch():
+        assert dill.register(Registered)(save) is save
+        assert dill.Pickler.dispatch[Registered] is save
+
+
+def test_register_decorator_keyword():
+    class Registered:
+        pass
