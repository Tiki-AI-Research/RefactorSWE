+"""Check actual lifecycle delegation, without a registry name or storage API.
+
+This is the task's structural requirement, separate from preserved behavior.
+Observe the frames in which real table changes occur; merely exposing an alias
+or calling a no-op facade before doing the old module-level work is insufficient.
+"""
+
+from collections.abc import Mapping
+from contextlib import contextmanager
+import dis
+from functools import lru_cache
+from pathlib import Path
+import sys
+import types
+
+import dill
+import pickle
+
+
+def _storage_ids(root):
+    """Follow owned data, including dict/sequence containers and slot storage.
+
+    Do not follow module namespaces, function globals, descriptors or properties:
+    those would make every object appear to own all module-level state.
+    """
+    seen = set()
+    pending = [root]
+    while pending:
+        value = pending.pop()
+        if id(value) in seen:
+            continue
+        seen.add(id(value))
+        if isinstance(value, (types.ModuleType, types.MethodType)):
+            continue
+        if isinstance(value, Mapping):
+            pending.extend(value.values())
+        elif isinstance(value, (list, tuple, set, frozenset)):
+            pending.extend(value)
+        else:
+            try:
+                pending.extend(vars(value).values())
+            except TypeError:
+                pass
+            if not isinstance(value, (type, types.FunctionType)):
+                for cls in type(value).__mro__:
+                    for name, descriptor in vars(cls).items():
+                        if isinstance(descriptor, types.MemberDescriptorType):
+                            try:
+                                pending.append(object.__getattribute__(value, name))
+                            except AttributeError:
+                                pass
+                        elif (not name.startswith('__') and not callable(descriptor)
+                              and not isinstance(descriptor, (property, staticmethod, classmethod,
+                                                             types.GetSetDescriptorType))):
+                            pending.append(descriptor)
+        # Never reach unrelated storage through imported modules or globals.
+        pending = [v for v in pending if not isinstance(
+            v, (types.FunctionType, types.ModuleType, types.MethodType))]
+    return seen
+
+
+@lru_cache(maxsize=None)
+def _production_file(filename):
+    file = Path(filename).resolve()
+    package = Path(dill.__file__).resolve().parent
+    return package in file.parents and "tests" not in file.relative_to(package).parts
+
+
+def _production_frame(frame):
+    return _production_file(frame.f_code.co_filename)
+
+
+def _delegated_owners(frame):
+    """Receivers, explicit state arguments and closure state in active helpers."""
+    owners = {}
+    while frame is not None:
+        if _production_frame(frame):
+            code = frame.f_code
+            count = code.co_argcount + code.co_kwonlyargcount
+            for name in (*code.co_varnames[:count], *code.co_freevars):
+                value = frame.f_locals.get(name)
+                if value is None or isinstance(value, types.ModuleType):
+                    continue
+                if id(dill.Pickler.dispatch) in _storage_ids(value):
+                    owners[id(value)] = value
+        frame = frame.f_back
+    return owners
+
+
+def _global_dispatch_state(frame, reads):
+    """Also account for actually read module-level restoration snapshots.
+
+    Aliases to registry-owned data are allowed. A separately owned global copy
+    used by the lifecycle is not centralized merely by adding a facade method.
+    """
+    tables = set()
+    while frame is not None:
+        if _production_frame(frame):
+            tables.update(reads.get(id(frame), ()))
+        frame = frame.f_back
+    return tables
+
+
+def _mutation_owners(operation, table, key):
+    missing = object()
+    previous = table.get(key, missing)
+    events = []
+    retained = {}
+    frames = {}
+    reads = {}
+    instructions = {}
+    excluded = {id(dill.Pickler.dispatch), id(pickle._Pickler.dispatch)}
+    old_trace = sys.gettrace()
+
+    def trace(frame, event, arg):
+        nonlocal previous
+        if _production_frame(frame):
+            frames[id(frame)] = frame  # Frame ids must not be recycled mid-probe.
+            frame.f_trace_opcodes = True
+            if event == 'opcode':
+                code = frame.f_code
+                if code not in instructions:
+                    instructions[code] = {op.offset: op for op in dis.get_instructions(code)}
+                op = instructions[code].get(frame.f_lasti)
+                if op is not None and op.opname in ('LOAD_GLOBAL', 'LOAD_NAME'):
+                    value = frame.f_globals.get(op.argval)
+                    if isinstance(value, Mapping) and id(value) not in excluded and value:
+                        if all(isinstance(k, type) and callable(v) for k, v in value.items()):
+                            reads.setdefault(id(frame), set()).add(id(value))
+            current = table.get(key, missing)
+            if current is not previous:
+                owners = _delegated_owners(frame)
+                retained.update(owners)  # Keep identities alive across operations.
+                # Retain the frame: restoration may read its snapshot after
+                # deleting the target key, and that read still belongs here.
+                events.append((owners, frame))
+                previous = current
+            return trace
+        return None
+
+    try:
+        sys.settrace(trace)
+        operation()
+    finally:
+        sys.settrace(old_trace)
+    assert events, "the structural probe did not reach its target table change"
+    valid_events = []
+    for owners, frame in events:
+        global_state = _global_dispatch_state(frame, reads)
+        valid_events.append({identity for identity, owner in owners.items()
+                             if global_state <= _storage_ids(owner)})
+    return set.intersection(*valid_events), retained
+
+
+@contextmanager
+def _preserve_tables():
+    own = dill.Pickler.dispatch.copy()
+    stock = pickle._Pickler.dispatch.copy()
+    try:
+        yield
+    finally:
+        dill.Pickler.dispatch.clear()
+        dill.Pickler.dispatch.update(own)
+        pickle._Pickler.dispatch.clear()
+        pickle._Pickler.dispatch.update(stock)
+
+
+def test_registry_lifecycle_has_one_owner():
+    class Decorated:
+        pass
+
+    class Direct:
+        pass
+
+    def serializer(pickler, obj):
+        pickler.save_reduce(str, ("ownership-probe",), obj=obj)
+
+    # A dill-owned handler must be removed, rather than externally preserved.
+    serializer.__module__ = dill._dill.__name__
+    records = {}
+    retained = {}
+    with _preserve_tables():
+        dill.extend(False)
+        operations = (
+            ("decorator registration", lambda: dill.register(Decorated)(serializer),
+             dill.Pickler.dispatch, Decorated),
+            ("direct registration", lambda: dill.pickle(Direct, serializer),
+             dill.Pickler.dispatch, Direct),
+            ("enable integration", lambda: dill.extend(True),
+             pickle._Pickler.dispatch, Direct),
+            ("disable integration", lambda: dill.extend(False),
+             pickle._Pickler.dispatch, Direct),
+        )
+        for label, operation, table, key in operations:
+            owners, keepalive = _mutation_owners(operation, table, key)
+            records[label] = owners
+            retained.update(keepalive)
+        assert Direct not in pickle._Pickler.dispatch
+        assert dill.Pickler.dispatch[Direct] is serializer
+    common = set.intersection(*records.values())
+    assert common, (
+        "registration, integration and restoration must change state through "
+        "one actual owner; observed owner counts: "
+        + repr({label: len(owners) for label, owners in records.items()})
+    )
