@@ -0,0 +1,182 @@
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestShouldAppendCommitIDAndAppendCommitID(t *testing.T) {
+	tests := []struct {
+		name               string
+		initialContent     string
+		expectMissingID    bool
+		expectMissingNL    bool
+		expectPattern      string
+		expectExactContent string
+	}{
+		{
+			name:            "single line message gets extra newline",
+			initialContent:  "Initial commit message\n",
+			expectMissingID: true,
+			expectMissingNL: true,
+			expectPattern:   `^Initial commit message\n\n\ncommit-id:[a-f0-9]{8}\n$`,
+		},
+		{
+			name:            "multi line message gets single newline",
+			initialContent:  "Subject\n\nBody paragraph\n",
+			expectMissingID: true,
+			expectMissingNL: false,
+			expectPattern:   `^Subject\n\nBody paragraph\n\ncommit-id:[a-f0-9]{8}\n$`,
+		},
+		{
+			name:               "already contains commit-id line",
+			initialContent:     "Subject\n\ncommit-id:053f6d16\n",
+			expectMissingID:    false,
+			expectMissingNL:    false,
+			expectExactContent: "Subject\n\ncommit-id:053f6d16\n",
+		},
+		{
+			name:               "already contains non-hex commit-id line",
+			initialContent:     "Subject\n\ncommit-id:XYZ\n",
+			expectMissingID:    false,
+			expectMissingNL:    false,
+			expectExactContent: "Subject\n\ncommit-id:XYZ\n",
+		},
+		{
+			name:               "only comments",
+			initialContent:     "# Comments only\n# Nothing else\n",
+			expectMissingID:    false,
+			expectMissingNL:    false,
+			expectExactContent: "# Comments only\n# Nothing else\n",
+		},
+		{
+			name:               "empty file",
+			initialContent:     "",
+			expectMissingID:    false,
+			expectMissingNL:    false,
+			expectExactContent: "",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			tempFile := filepath.Join(t.TempDir(), "COMMIT_EDITMSG")
+			err := os.WriteFile(tempFile, []byte(tc.initialContent), 0666)
+			require.NoError(t, err)
+
+			missingID, missingNL := shouldAppendCommitID(tempFile)
+			assert.Equal(t, tc.expectMissingID, missingID)
+			assert.Equal(t, tc.expectMissingNL, missingNL)
+
+			if missingID {
+				appendCommitID(tempFile, missingNL)
+			}
+
+			content, err := os.ReadFile(tempFile)
+			require.NoError(t, err)
+
+			if tc.expectExactContent != "" || tc.initialContent == "" {
+				assert.Equal(t, tc.expectExactContent, string(content))
+			} else if tc.expectPattern != "" {
+				matched, err := regexp.MatchString(tc.expectPattern, string(content))
+				require.NoError(t, err)
+				assert.True(t, matched, "content %q did not match pattern %s", string(content), tc.expectPattern)
+			}
+		})
+	}
+}
+
+func cleanGitEnv(t *testing.T) {
+	for _, env := range os.Environ() {
+		if strings.HasPrefix(env, "GIT_CONFIG_") {
+			key := strings.SplitN(env, "=", 2)[0]
+			os.Unsetenv(key)
+		}
+	}
+}
+
+func TestMainAppendsCommitIDToCommitEditMsg(t *testing.T) {
+	cleanGitEnv(t)
+	origArgs := os.Args
+	defer func() { os.Args = origArgs }()
+
+	tempFile := filepath.Join(t.TempDir(), "COMMIT_EDITMSG")
+	err := os.WriteFile(tempFile, []byte("Test commit headline\n"), 0666)
+	require.NoError(t, err)
+
+	os.Args = []string{"spr_reword_helper", tempFile}
+	main()
+
+	content, err := os.ReadFile(tempFile)
+	require.NoError(t, err)
+
+	matched, err := regexp.MatchString(`^Test commit headline\n\n\ncommit-id:[a-f0-9]{8}\n$`, string(content))
+	require.NoError(t, err)
+	assert.True(t, matched, "content %q did not match expected commit-id pattern", string(content))
+}
+
+func TestMainRewordsTodoEntriesWithoutCommitID(t *testing.T) {
+	cleanGitEnv(t)
+	origArgs := os.Args
+	defer func() { os.Args = origArgs }()
+
+	tempDir := t.TempDir()
+	origWd, err := os.Getwd()
+	require.NoError(t, err)
+	defer func() { _ = os.Chdir(origWd) }()
+	require.NoError(t, os.Chdir(tempDir))
+
+	runGit := func(args ...string) string {
+		cmd := exec.Command("git", args...)
+		cmd.Dir = tempDir
+		out, err := cmd.CombinedOutput()
+		require.NoError(t, err, "git %v failed: %s", args, string(out))
+		return strings.TrimSpace(string(out))
+	}
+
+	runGit("init")
+	runGit("config", "user.name", "Test User")
+	runGit("config", "user.email", "test@example.com")
+
+	// Commit 1: with commit-id in message
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "file1.txt"), []byte("1"), 0666))
+	runGit("add", "file1.txt")
+	runGit("commit", "-m", "Commit with id\n\ncommit-id:12345678")
+	hashWithID := runGit("rev-parse", "HEAD")
+
+	// Commit 2: without commit-id in message
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "file2.txt"), []byte("2"), 0666))
+	runGit("add", "file2.txt")
+	runGit("commit", "-m", "Commit without id")
+	hashWithoutID := runGit("rev-parse", "HEAD")
+
+	todoFile := filepath.Join(tempDir, "git-rebase-todo")
+	todoContent := strings.Join([]string{
+		"pick " + hashWithID + " Commit with id",
+		"pick " + hashWithoutID + " Commit without id",
+		"# Rebase comments",
+		"drop " + hashWithID + " Commit with id",
+	}, "\n") + "\n"
+	require.NoError(t, os.WriteFile(todoFile, []byte(todoContent), 0666))
+
+	os.Args = []string{"spr_reword_helper", todoFile}
+	main()
+
+	result, err := os.ReadFile(todoFile)
+	require.NoError(t, err)
+
+	expected := strings.Join([]string{
+		"pick " + hashWithID + " Commit with id",
+		"reword " + hashWithoutID + " Commit without id",
+		"# Rebase comments",
+		"drop " + hashWithID + " Commit with id",
+	}, "\n") + "\n"
+	assert.Equal(t, expected, string(result))
+}
diff --git a/git/commitid.go b/git/commitid.go
new file mode 100644
index 0000000000000000000000000000000000000000..272599fa15aa8d04fdca6609a840a4429124c5ed
--- /dev/null
+++ b/git/commitid.go
@@ -0,0 +1,44 @@
+package git
+
+import (
+	"regexp"
+	"strings"
+)
+
+const (
+	CommitIDKeyword = "commit-id"
+	CommitIDPrefix  = CommitIDKeyword + ":"
+	CommitIDPattern = "[a-fA-F0-9]{8}"
+)
+
+var strictCommitIDRegex = regexp.MustCompile(regexp.QuoteMeta(CommitIDPrefix) + `\s*(` + CommitIDPattern + `)`)
+
+// ParseCommitID parses a commit-id from a git log line (strict).
+// The prefix commit-id: can appear anywhere in the line, followed by optional whitespace,
+// and captures the first 8 lowercase hexadecimal characters.
+func ParseCommitID(line string) (string, bool) {
+	matches := strictCommitIDRegex.FindStringSubmatch(line)
+	if matches != nil {
+		return matches[1], true
+	}
+	return "", false
+}
+
+// ParseCommitIDFromMessageBody parses a commit-id from a pull request commit message body line (loose).
+// It matches lines starting with commit-id: (no leading whitespace),
+// and extracts the text following the first colon up to the next colon or the end of the line verbatim.
+func ParseCommitIDFromMessageBody(line string) (string, bool) {
+	if strings.HasPrefix(line, CommitIDPrefix) {
+		val := line[len(CommitIDPrefix):]
+		if idx := strings.Index(val, ":"); idx != -1 {
+			val = val[:idx]
+		}
+		return val, true
+	}
+	return "", false
+}
+
+// FormatCommitID formats a commit ID into a line string without trailing newline.
+func FormatCommitID(commitID string) string {
+	return CommitIDPrefix + commitID
+}
