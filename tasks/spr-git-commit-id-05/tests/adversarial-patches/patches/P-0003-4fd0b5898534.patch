+package git
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestParseCommitID(t *testing.T) {
+	tests := []struct {
+		name       string
+		input      string
+		expectedID string
+		expectedOk bool
+	}{
+		{name: "standard", input: "commit-id:053f6d16", expectedID: "053f6d16", expectedOk: true},
+		{name: "with tab indent", input: "\tcommit-id:053f6d16", expectedID: "053f6d16", expectedOk: true},
+		{name: "with spaces indent", input: "    commit-id:053f6d16", expectedID: "053f6d16", expectedOk: true},
+		{name: "space after colon", input: "commit-id: 053f6d16", expectedID: "053f6d16", expectedOk: true},
+		{name: "trailing characters", input: "commit-id:053f6d16-suffix", expectedID: "053f6d16", expectedOk: true},
+		{name: "more hex characters", input: "commit-id:053f6d16abcdef12", expectedID: "053f6d16", expectedOk: true},
+		{name: "invalid characters", input: "commit-id:XYZ", expectedID: "", expectedOk: false},
+		{name: "uppercase hex", input: "commit-id:053F6D16", expectedID: "", expectedOk: false},
+		{name: "too short", input: "commit-id:053f6d1", expectedID: "", expectedOk: false},
+		{name: "missing prefix", input: "no commit id here", expectedID: "", expectedOk: false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			id, ok := ParseCommitID(tc.input)
+			assert.Equal(t, tc.expectedOk, ok)
+			assert.Equal(t, tc.expectedID, id)
+		})
+	}
+}
+
+func TestParseCommitIDFromMessageBody(t *testing.T) {
+	tests := []struct {
+		name       string
+		input      string
+		expectedID string
+		expectedOk bool
+	}{
+		{name: "colon separated", input: "commit-id:abc:def", expectedID: "abc", expectedOk: true},
+		{name: "preserves leading space", input: "commit-id: XYZ", expectedID: " XYZ", expectedOk: true},
+		{name: "uppercase value", input: "commit-id:ABCDEF", expectedID: "ABCDEF", expectedOk: true},
+		{name: "empty value", input: "commit-id:", expectedID: "", expectedOk: true},
+		{name: "short id", input: "commit-id:1", expectedID: "1", expectedOk: true},
+		{name: "rejects leading space", input: " commit-id:abc", expectedID: "", expectedOk: false},
+		{name: "missing prefix", input: "subject line", expectedID: "", expectedOk: false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			id, ok := ParseCommitIDFromMessageBody(tc.input)
+			assert.Equal(t, tc.expectedOk, ok)
+			assert.Equal(t, tc.expectedID, id)
+		})
+	}
+}
+
+func TestFormatCommitID(t *testing.T) {
+	assert.Equal(t, "commit-id:053f6d16", FormatCommitID("053f6d16"))
+	assert.Equal(t, "commit-id:custom-id", FormatCommitID("custom-id"))
+}
