+import (
+	"testing"
+
+	"github.com/ejoffe/spr/git"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestCommitResponseOutputMatchesProtocolFormat(t *testing.T) {
+	commits := []*git.Commit{
+		{
+			CommitHash: "d89e0e460ed817c81641f32b1a506b60164b4403",
+			CommitID:   "053f6d16",
+			Subject:    "Test Subject",
+		},
+	}
+
+	resp := &commitResponse{
+		valid:   true,
+		commits: commits,
+	}
+
+	expected := "commit d89e0e460ed817c81641f32b1a506b60164b4403\n" +
+		"Author: Eitan Joffe <ejoffe@gmail.com>\n" +
+		"Date:   Fri Jun 11 14:15:49 2021 -0700\n" +
+		"\n" +
+		"\tTest Subject\n" +
+		"\n" +
+		"\tcommit-id:053f6d16\n" +
+		"\n"
+
+	assert.Equal(t, expected, resp.Output())
+
+	invalidResp := &commitResponse{
+		valid:   false,
+		commits: commits,
+	}
+	assert.Equal(t, "", invalidResp.Output())
+}
