+// cliSurface extracts the CLI command/flag surface and the configuration
+// option surface from the production sources.
+func cliSurface(t *testing.T, m *repoModel) (map[string]bool, map[string]bool, map[string]bool) {
+	t.Helper()
+	commands := map[string]bool{}
+	flags := map[string]bool{}
+	options := map[string]bool{}
+
+	mainPkg := m.mustPkg(t, "cmd/spr")
+	for _, f := range mainPkg.files {
+		ast.Inspect(f.file, func(n ast.Node) bool {
+			lit, ok := n.(*ast.CompositeLit)
+			if !ok {
+				return true
+			}
+			name := compositeNameField(lit)
+			if name == "" {
+				return true
+			}
+			kind := compositeKind(f, lit)
+			switch {
+			case strings.HasSuffix(kind, "Command"), strings.HasSuffix(kind, "App"):
+				commands[name] = true
+			case strings.HasSuffix(kind, "Flag"):
+				flags[kind+":"+name] = true
+			}
+			return true
+		})
+	}
+
+	configPkg := m.mustPkg(t, "config")
+	for _, f := range configPkg.files {
+		for _, top := range f.file.Decls {
+			gen, ok := top.(*ast.GenDecl)
+			if !ok || gen.Tok != token.TYPE {
+				continue
+			}
+			for _, spec := range gen.Specs {
+				typeSpec, ok := spec.(*ast.TypeSpec)
+				if !ok {
+					continue
+				}
+				structType, ok := typeSpec.Type.(*ast.StructType)
+				if !ok {
+					continue
+				}
+				for _, field := range structType.Fields.List {
+					if field.Tag == nil {
+						continue
+					}
+					yamlName := yamlOptionName(unquoteString(field.Tag.Value))
+					if yamlName == "" {
+						continue
+					}
+					for _, name := range field.Names {
+						options[typeSpec.Name.Name+"."+name.Name+"="+yamlName] = true
+					}
+				}
+			}
+		}
+	}
+	return commands, flags, options
+}
+
+func yamlOptionName(tag string) string {
+	index := strings.Index(tag, `yaml:"`)
+	if index < 0 {
+		return ""
+	}
+	rest := tag[index+len(`yaml:"`):]
+	end := strings.Index(rest, `"`)
+	if end < 0 {
+		return ""
+	}
+	return strings.Split(rest[:end], ",")[0]
+}
+
+func compositeNameField(lit *ast.CompositeLit) string {
+	for _, element := range lit.Elts {
+		kv, ok := element.(*ast.KeyValueExpr)
+		if !ok {
+			continue
+		}
+		key, ok := kv.Key.(*ast.Ident)
+		if !ok || key.Name != "Name" {
+			continue
+		}
+		if value, ok := kv.Value.(*ast.BasicLit); ok && value.Kind == token.STRING {
+			return unquoteString(value.Value)
+		}
+	}
+	return ""
+}
+
+// compositeKind returns the type name of a composite literal, resolving the
+// element type of a slice literal through the parent context because the
+// elements of `Commands: []*cli.Command{...}` carry no explicit type.
+func compositeKind(f *parsedFile, lit *ast.CompositeLit) string {
+	if lit.Type != nil {
+		return typeNameOf(lit.Type)
+	}
+	switch parent := f.parents[lit].(type) {
+	case *ast.CompositeLit:
+		return typeNameOf(parent.Type)
+	case *ast.KeyValueExpr:
+		if grand, ok := f.parents[parent].(*ast.CompositeLit); ok {
+			return typeNameOf(grand.Type)
+		}
+	}
+	return ""
+}
+
+func typeNameOf(expr ast.Expr) string {
+	switch v := expr.(type) {
+	case *ast.SelectorExpr:
+		return v.Sel.Name
+	case *ast.StarExpr:
+		return "*" + typeNameOf(v.X)
+	case *ast.ArrayType:
+		return "[]" + typeNameOf(v.Elt)
+	case *ast.Ident:
+		return v.Name
+	}
+	return ""
+}
