+package f2p
+
+import (
+	"go/ast"
+	"testing"
+)
+
+// isCommitIDField reports whether an assignment target is the CommitID field
+// of a commit value (scannedCommit.CommitID in the log parser) or the
+// CommitID struct-literal key (git.Commit{CommitID: ...} in the GraphQL
+// matcher).
+func isCommitIDField(expr ast.Expr) bool {
+	sel, ok := expr.(*ast.SelectorExpr)
+	return ok && sel.Sel.Name == "CommitID"
+}
+
+func assignmentRHS(stmt *ast.AssignStmt, index int) ast.Expr {
+	if len(stmt.Rhs) == len(stmt.Lhs) && index < len(stmt.Rhs) {
+		return stmt.Rhs[index]
+	}
+	if len(stmt.Rhs) == 1 {
+		return stmt.Rhs[0]
+	}
+	return nil
+}
+
+// parseTargets returns the exported git capability functions whose result is
+// the value stored in a CommitID of the site. The call result has to be the
+// value source: a discarded `_ = git.ParseX(line)` reference never counts, and
+// a private extraction whose result wins over the capability result does not
+// count either.
+func parseTargets(m *repoModel, g *pkg, site *decl) []*decl {
+	locals := localBindings(site)
+	var out []*decl
+	add := func(expr ast.Expr) {
+		for _, target := range exprOrigins(m, g, site, locals, expr, 0, nil) {
+			if (!g.definesPrefix(target) && len(prefixSourceNames(g, target)) == 0) || !g.hasParseEvidence(target) {
+				continue
+			}
+			out = append(out, target)
+		}
+	}
+	ast.Inspect(site.body, func(n ast.Node) bool {
+		switch item := n.(type) {
+		case *ast.AssignStmt:
+			for index, lhs := range item.Lhs {
+				if isCommitIDField(lhs) {
+					add(assignmentRHS(item, index))
+				}
+			}
+		case *ast.KeyValueExpr:
+			if id, ok := item.Key.(*ast.Ident); ok && id.Name == "CommitID" {
+				add(item.Value)
+			}
+		}
+		return true
+	})
+	return out
+}
+
+// sharedCapabilityDecls returns every declaration in the value dependency of
+// the capability targets: the capability function itself, the regexp/pattern
+// variables it uses and the prefix constants they are built from.
+func sharedCapabilityDecls(g *pkg, targets []*decl) map[*decl]bool {
+	shared := map[*decl]bool{}
+	for _, target := range targets {
+		for _, member := range g.valueClosure(target) {
+			shared[member] = true
+		}
+	}
+	return shared
+}
+
+// privateProtocolEvidence reports a private copy of the protocol rules kept by
+// a site: a protocol literal anywhere in the site body (local const/var
+// included), the bare token consumed as a rule, or a same-package
+// helper/package variable the site consumes that carries the literal and is
+// not part of the shared capability. The shared capability declarations
+// reached through the used capability calls are excluded, so an implementation
+// that legitimately keeps the literal in the shared git capability is not
+// flagged.
+func privateProtocolEvidence(p *pkg, site *decl, shared map[*decl]bool) string {
+	for _, d := range p.callClosure(site) {
+		if d != site && d.recv == "" && d.exported && p.definesPrefix(d) &&
+			(p.hasParseEvidence(d) || p.hasFormatterEvidence(d)) {
+			continue
+		}
+		if evidence := protocolRuleEvidence(p, d, shared); evidence != "" {
+			return evidence
+		}
+	}
+	return ""
+}
+
+// TestLocalLogParserObtainsIdentifierThroughCapability verifies that the local
+// commit-log parser obtains the parsed identifier from the shared `git`
+// capability instead of computing it itself: the capability call result must
+// flow into the scanned commit's CommitID, and the target must really parse
+// the protocol prefix.
+//
+// Baseline fails this leaf because parseLocalCommitStack assigns matches[1]
+// from its private regexp and calls no shared capability.
+func TestLocalLogParserObtainsIdentifierThroughCapability(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	sites := findLocalLogParserFuncs(g)
+	requireSites(t, "the local commit-log parser", sites)
+
+	var reached []string
+	for _, site := range sites {
+		for _, target := range parseTargets(m, g, site) {
+			reached = append(reached, site.name+" -> "+target.name)
+		}
+	}
+	if len(reached) == 0 {
+		t.Fatalf("the local commit-log parser (%s) does not obtain the identifier through a used call to an exported git commit-id capability",
+			siteNames(sites))
+	}
+}
+
+// TestLocalLogParserKeepsNoPrivateProtocolRule verifies that the local
+// commit-log parser no longer carries a private copy of the commit-id rules:
+// no protocol literal may remain in its body (including local const/var
+// declarations and local variables that carry the text into a call) or in a
+// same-package helper it uses that is not part of the shared capability, and
+// it must not use a private package variable that carries the literal.
+//
+// Baseline fails this leaf because the parser keeps
+// regexp.MustCompile(`commit-id\:\s*([a-f0-9]{8})`) inline.
+func TestLocalLogParserKeepsNoPrivateProtocolRule(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	sites := findLocalLogParserFuncs(g)
+	requireSites(t, "the local commit-log parser", sites)
+
+	for _, site := range sites {
+		shared := sharedCapabilityDecls(g, parseTargets(m, g, site))
+		if evidence := privateProtocolEvidence(g, site, shared); evidence != "" {
+			t.Fatalf("the local commit-log parser still keeps a private protocol rule: %s", evidence)
+		}
+	}
+}
+
+// TestGraphQLMatcherObtainsIdentifierThroughCapability verifies that the
+// GitHub GraphQL message-body matcher obtains the identifier through the
+// shared `git` capability: the call result must flow into the Commit{CommitID:
+// ...} value, and the target capability must not apply the strict eight-hex
+// shape, because the message-body path keeps its loose tolerance.
+//
+// Baseline fails this leaf because matchPullRequestStack extracts the value
+// with strings.Split(line, ":")[1] and calls no shared capability.
+func TestGraphQLMatcherObtainsIdentifierThroughCapability(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+	client := m.mustPkg(t, "github/githubclient")
+
+	sites := findGraphQLMatcherFuncs(client)
+	requireSites(t, "the GraphQL message-body matcher", sites)
+
+	var reached []string
+	for _, site := range sites {
+		for _, target := range parseTargets(m, g, site) {
+			if g.hasProtocolMatchCall(target) {
+				continue
+			}
+			reached = append(reached, site.name+" -> git."+target.name)
+		}
+	}
+	if len(reached) == 0 {
+		t.Fatalf("the GraphQL message-body matcher (%s) does not obtain the identifier through a used call to a loose exported git commit-id capability",
+			siteNames(sites))
+	}
+}
+
+// TestGraphQLMatcherKeepsNoPrivateProtocolRule verifies that the GraphQL
+// message-body matcher no longer carries a private copy of the commit-id
+// rules: no protocol literal may remain in its body (including local
+// const/var declarations and local variables) or in a same-package helper it
+// uses that is not part of the shared capability.
+//
+// Baseline fails this leaf because the matcher tests
+// strings.HasPrefix(line, "commit-id:") and splits the line itself.
+func TestGraphQLMatcherKeepsNoPrivateProtocolRule(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+	client := m.mustPkg(t, "github/githubclient")
+
+	sites := findGraphQLMatcherFuncs(client)
+	requireSites(t, "the GraphQL message-body matcher", sites)
+
+	for _, site := range sites {
+		shared := sharedCapabilityDecls(g, parseTargets(m, g, site))
+		if evidence := privateProtocolEvidence(client, site, shared); evidence != "" {
+			t.Fatalf("the GraphQL message-body matcher still keeps a private protocol rule: %s", evidence)
+		}
+	}
+}
+
+// The local parser must use a shared capability with strict identifier matching.
+func TestLocalParserUsesStrictSharedCapability(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	logSites := findLocalLogParserFuncs(g)
+	requireSites(t, "the local commit-log parser", logSites)
+
+	var strict []*decl
+	for _, site := range logSites {
+		for _, target := range parseTargets(m, g, site) {
+			if g.hasProtocolMatchCall(target) {
+				strict = append(strict, target)
+			}
+		}
+	}
+	if len(strict) == 0 {
+		t.Fatalf("the local commit-log parser (%s) does not reach a capability that enforces the eight-lowercase-hex identifier shape",
+			siteNames(logSites))
+	}
+}
+
+func TestGraphQLMatcherUsesLooseSharedCapability(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+	client := m.mustPkg(t, "github/githubclient")
+
+	matcherSites := findGraphQLMatcherFuncs(client)
+	requireSites(t, "the GraphQL message-body matcher", matcherSites)
+	var loose []*decl
+	for _, site := range matcherSites {
+		for _, target := range parseTargets(m, g, site) {
+			if !g.hasProtocolMatchCall(target) {
+				loose = append(loose, target)
+			}
+		}
+	}
+	if len(loose) == 0 {
+		t.Fatalf("the GraphQL message-body matcher (%s) does not reach a capability that leaves the identifier shape unenforced",
+			siteNames(matcherSites))
+	}
+}
diff --git a/test/f2p/sites_test.go b/test/f2p/sites_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..7d431ddfd7485c09d5e72f52163aec651dbb9a97
--- /dev/null
+++ b/test/f2p/sites_test.go
@@ -0,0 +1,80 @@
+package f2p
+
+import (
+	"sort"
+	"strings"
+	"testing"
+)
+
+// The helpers below locate the production responsibility that is being
+// checked. The locator is content based (the local commit-log parser owns the
+// 40-hex commit hash handling, the GraphQL matcher walks message bodies, the
+// reword helper appends the identifier line and scans the message, the git
+// test double fabricates the log text), so renaming or moving the code inside
+// its package does not invalidate the check.
+
+func findLocalLogParserFuncs(g *pkg) []*decl {
+	return g.funcsMatching(func(d *decl) bool {
+		if d.hasFieldName("CommitHash") {
+			return true
+		}
+		if d.hasLiteralMatching(commitLogHeaderPattern) || d.hasLiteralMatching(commitHashShapePattern) {
+			return true
+		}
+		return false
+	})
+}
+
+func findGraphQLMatcherFuncs(client *pkg) []*decl {
+	return client.funcsMatching(func(d *decl) bool {
+		return d.hasFieldName("MessageBody") && d.hasFieldName("CommitID")
+	})
+}
+
+func findRewordAppendFuncs(main *pkg) []*decl {
+	return main.funcsMatching(func(d *decl) bool {
+		if d.hasSelectorName("O_APPEND") {
+			return true
+		}
+		if !strings.Contains(d.signature, "missingNewLine bool") {
+			return false
+		}
+		for _, writer := range []string{"WriteString", "WriteFile", "Fprintf", "Sprintf", "Write"} {
+			if d.hasSelectorName(writer) {
+				return true
+			}
+		}
+		return false
+	})
+}
+
+func findRewordScanFuncs(main *pkg) []*decl {
+	return main.funcsMatching(func(d *decl) bool {
+		return d.hasIdent("lineCount") || d.hasIdent("nonEmptyCommitMessage")
+	})
+}
+
+func findMockGitFabricatorFuncs(mock *pkg) []*decl {
+	return mock.funcsMatching(func(d *decl) bool {
+		if d.hasLiteralMatching(mockLogCommitPattern) {
+			return true
+		}
+		return d.hasFieldName("CommitID") && d.hasSelectorName("Fprintf")
+	})
+}
+
+func requireSites(t *testing.T, what string, sites []*decl) {
+	t.Helper()
+	if len(sites) == 0 {
+		t.Fatalf("could not locate %s in the production sources; the responsibility is missing or was renamed beyond recognition", what)
+	}
+}
+
+func siteNames(sites []*decl) string {
+	names := make([]string, 0, len(sites))
+	for _, d := range sites {
+		names = append(names, d.pkg.dir+"."+d.name)
+	}
+	sort.Strings(names)
+	return joinComma(names)
+}
diff --git a/test/f2p_runner.py b/test/f2p_runner.py
new file mode 100755
index 0000000000000000000000000000000000000000..1d57ac1eb9ec7c59039133d2388ec59c625d603b
--- /dev/null
+++ b/test/f2p_runner.py
@@ -0,0 +1,557 @@
+#!/usr/bin/env python3
+"""Summary runner for the merged verifier plan.
+
+The merged plan contains the frozen P2P gates and the F2P gates, so this
+runner executes the exact leaves of both sets with ``go test -json`` and writes
+one regular JUnit report for the pipeline.
+
+Selector input comes from plan-managed assets when they are present (the
+pipeline materialized ``config.json`` / ``p2p_select.txt``, passed with
+``--select``/``--config`` or discovered next to the repository) and always
+includes the leaves declared by the plan's own test assets:
+
+* the F2P test files of this runner (``F2P_PATHS``), and
+* the frozen P2P test files of the merged plan (``FROZEN_P2P_PATHS``), whose
+  selector set is frozen by the P2P handoff and must keep running in the
+  summary report.
+
+Build products that must be executed (the ``go test`` work directory holding
+the compiled test binary) are placed in the controlled execution directory
+``VERIFIER_EXEC_DIR`` when the pipeline provides one, because a ``noexec``
+temporary mount cannot run them.
+"""
+
+import argparse
+import json
+import os
+import re
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+from xml.sax.saxutils import escape, quoteattr
+
+# F2P assets added by this plan (the leaves of these files are discovered and
+# executed in addition to any selection input).
+F2P_PATHS = [
+    "test/f2p/model_test.go",
+    "test/f2p/sites_test.go",
+    "test/f2p/capability_test.go",
+    "test/f2p/parsing_test.go",
+    "test/f2p/emission_test.go",
+]
+
+# Frozen P2P assets of the merged plan. Their selector set is fixed by the P2P
+# handoff, so the summary runner must keep executing them; they are never
+# re-declared as F2P paths.
+FROZEN_P2P_PATHS = [
+    "git/commit_test.go",
+    "git/helpers_test.go",
+    "github/githubclient/client_test.go",
+    "config/config_test.go",
+    "config/config_parser/config_parser_test.go",
+    "github/pullrequest_test.go",
+    "github/template/template_basic/template_test.go",
+    "github/template/template_custom/template_test.go",
+    "github/template/template_stack/template_test.go",
+    "github/template/template_why_what/template_test.go",
+    "spr/spr_test.go",
+    "git/p2p_commitid_regression_test.go",
+    "github/githubclient/p2p_graphql_regression_test.go",
+    "cmd/reword/p2p_reword_regression_test.go",
+    "git/mockgit/p2p_mockgit_regression_test.go",
+]
+
+GO_LEAF_RE = re.compile(r"^func\s+(Test[A-Za-z0-9_]*)\s*\(", re.M)
+SELECTOR_RE = re.compile(r"^[A-Za-z0-9_./\\-]+\.(?:go|py|js|ts|tsx|jsx|java|kt|rb|rs)::Test[A-Za-z0-9_]+(?:/[A-Za-z0-9_./:<>()-]+)*$")
+ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
+PLACEHOLDER_RE = re.compile(r"^\{[A-Za-z_]+\}$")
+MAX_DETAIL = 8000
+
+
+def log(message):
+    sys.stdout.write("f2p_runner: %s\n" % message)
+    sys.stdout.flush()
+
+
+def repo_root_from_script():
+    return Path(__file__).resolve().parent.parent
+
+
+def normalize_selector(selector, repo):
+    selector = selector.strip().strip(",").strip('"').strip("'")
+    if selector.startswith("- "):
+        selector = selector[2:].strip()
+    if "::" not in selector:
+        return None
+    file_part, leaf = selector.split("::", 1)
+    file_part = file_part.replace("\\", "/").strip()
+    leaf = leaf.strip()
+    if not file_part or not leaf:
+        return None
+    if file_part.startswith("./"):
+        file_part = file_part[2:]
+    if os.path.isabs(file_part):
+        try:
+            file_part = os.path.relpath(file_part, str(repo)).replace("\\", "/")
+        except ValueError:
+            return None
+    if leaf.startswith("./"):
+        leaf = leaf[2:]
+    return "%s::%s" % (file_part, leaf)
+
+
+def collect_selectors_from_json(text):
+    found = []
+
+    def walk(node):
+        if isinstance(node, str):
+            candidate = node.strip()
+            if SELECTOR_RE.match(candidate) and candidate not in found:
+                found.append(candidate)
+        elif isinstance(node, dict):
+            for value in node.values():
+                walk(value)
+        elif isinstance(node, list):
+            for value in node:
+                walk(value)
+
+    try:
+        walk(json.loads(text))
+    except ValueError:
+        return []
+    return found
+
+
+def parse_selection_text(text):
+    stripped = text.strip()
+    if not stripped:
+        return []
+    if stripped[0] in "[{":
+        selectors = collect_selectors_from_json(stripped)
+        if selectors:
+            return selectors
+    selectors = []
+    for line in stripped.splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or line.startswith("//"):
+            continue
+        candidate = None
+        if SELECTOR_RE.match(line.strip(",").strip('"').strip("'")):
+            candidate = line.strip(",").strip('"').strip("'")
+        else:
+            for token in re.split(r"[\s,]+", line):
+                token = token.strip(",").strip('"').strip("'")
+                if SELECTOR_RE.match(token):
+                    candidate = token
+                    break
+        if candidate and candidate not in selectors:
+            selectors.append(candidate)
+    return selectors
+
+
+def discover_leaves(repo, paths):
+    selectors = []
+    for rel in paths:
+        if not rel.endswith(".go"):
+            continue
+        path = repo / rel
+        try:
+            if not path.is_file():
+                continue
+            text = path.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            continue
+        for match in GO_LEAF_RE.finditer(text):
+            selector = "%s::%s" % (rel, match.group(1))
+            if selector not in selectors:
+                selectors.append(selector)
+    return selectors
+
+
+def candidate_selection_files(select_arg, config_arg, repo):
+    candidates = []
+    for arg in (select_arg, config_arg):
+        if not arg or PLACEHOLDER_RE.match(arg.strip()):
+            continue
+        arg_path = Path(arg)
+        candidates.append(arg_path)
+        candidates.append(repo / arg)
+        if arg_path.is_dir():
+            candidates.append(arg_path / "p2p_select.txt")
+            candidates.append(arg_path / "config.json")
+    cwd = Path.cwd()
+    for base in (repo, repo.parent, repo.parent.parent, cwd):
+        candidates.extend([
+            base / "p2p_select.txt",
+            base / "verifier" / "p2p_select.txt",
+            base / "config.json",
+            base / "verifier" / "config.json",
+        ])
+    for env_name in ("P2P_SELECT", "P2P_SELECT_FILE", "P2P_SELECT_PATH", "VERIFIER_P2P_SELECT", "CONFIG", "VERIFIER_CONFIG"):
+        value = os.environ.get(env_name)
+        if value:
+            candidates.append(Path(value))
+    return candidates
+
+
+def load_selection(select_arg, config_arg, repo):
+    selectors = []
+    seen = set()
+
+    def add(found, origin):
+        new = 0
+        for selector in found:
+            if selector not in seen:
+                seen.add(selector)
+                selectors.append(selector)
+                new += 1
+        if new:
+            log("selection input from %s (%d selector entries)" % (origin, new))
+
+    for candidate in candidate_selection_files(select_arg, config_arg, repo):
+        try:
+            if not candidate.is_file():
+                continue
+            text = candidate.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            continue
+        add(parse_selection_text(text), candidate)
+
+    for arg in (select_arg, config_arg):
+        if not arg or PLACEHOLDER_RE.match(arg.strip()):
+            continue
+        text = arg.strip()
+        if text.startswith("[") or text.startswith("{"):
+            add(collect_selectors_from_json(text), "--select argument (JSON)")
+        else:
+            add(parse_selection_text(text), "--select argument (inline)")
+
+    return selectors
+
+
+def build_selection(select_arg, config_arg, repo, node_selector=""):
+    if node_selector:
+        normalized = normalize_selector(node_selector, repo)
+        if normalized is None:
+            log("cannot parse selector %r" % node_selector)
+            return []
+        return [normalized]
+
+    merged = []
+    for selector in load_selection(select_arg, config_arg, repo):
+        normalized = normalize_selector(selector, repo)
+        if normalized is None or normalized in merged:
+            continue
+        merged.append(normalized)
+    for selector in discover_leaves(repo, F2P_PATHS) + discover_leaves(repo, FROZEN_P2P_PATHS):
+        if selector not in merged:
+            merged.append(selector)
+    if not merged:
+        log("no selectors found")
+    return merged
+
+
+def find_go():
+    go = shutil.which("go")
+    if go:
+        return go
+    for candidate in ("/opt/envpipe/runtime/bin/go", "/usr/local/go/bin/go", "/usr/lib/go/bin/go"):
+        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    return None
+
+
+EXEC_FALLBACK_DIRNAME = ".f2p_exec_tmp"
+
+
+def probe_exec(directory):
+    try:
+        directory.mkdir(parents=True, exist_ok=True)
+    except OSError:
+        return False
+    probe = directory / (".f2p_exec_probe_%d" % os.getpid())
+    shell = shutil.which("sh") or "/bin/sh"
+    try:
+        if os.path.isfile(shell):
+            shutil.copy2(shell, probe)
+            command = [str(probe), "-c", "exit 0"]
+        else:
+            probe.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
+            probe.chmod(0o755)
+            command = [str(probe)]
+        completed = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
+        return completed.returncode == 0
+    except (OSError, subprocess.SubprocessError):
+        return False
+    finally:
+        try:
+            probe.unlink()
+        except OSError:
+            pass
+
+
+def resolve_exec_dir(repo):
+    candidates = []
+    declared = os.environ.get("VERIFIER_EXEC_DIR", "").strip()
+    if declared:
+        candidates.append(Path(declared))
+    candidates.append(Path(tempfile.gettempdir()))
+    fallback = repo / EXEC_FALLBACK_DIRNAME
+    candidates.append(fallback)
+    for candidate in candidates:
+        if probe_exec(candidate):
+            return candidate, candidate == fallback
+    if declared:
+        return Path(declared), False
+    return None, False
+
+
+def build_env(exec_dir):
+    env = os.environ.copy()
+    env["GOFLAGS"] = "-mod=readonly"
+    env["GOPROXY"] = "off"
+    env["GOTOOLCHAIN"] = "local"
+    if exec_dir is not None:
+        env["GOTMPDIR"] = str(exec_dir)
+        env["VERIFIER_EXEC_DIR"] = str(exec_dir)
+    return env
+
+
+def strip_ansi(text):
+    return ANSI_RE.sub("", text)
+
+
+def run_selector(repo, go_binary, selector, timeout, exec_dir=None):
+    file_part, leaf = selector.split("::", 1)
+    if not file_part.endswith(".go"):
+        return {
+            "selector": selector,
+            "status": "error",
+            "time": 0.0,
+            "message": "selector does not point at a Go test file",
+            "detail": selector,
+        }
+    package_dir = os.path.dirname(file_part) or "."
+    package_arg = "./" + package_dir if package_dir != "." else "."
+    command = [go_binary, "test", "-count=1", "-json", "-run", "^%s$" % re.escape(leaf), package_arg]
+    env = build_env(exec_dir)
+
+    started = time.time()
+    timed_out = False
+    try:
+        process = subprocess.Popen(
+            command,
+            cwd=str(repo),
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            start_new_session=True,
+        )
+    except OSError as exc:
+        return {
+            "selector": selector,
+            "status": "error",
+            "time": 0.0,
+            "message": "failed to start go test: %s" % exc,
+            "detail": " ".join(command),
+        }
+
+    try:
+        raw, _ = process.communicate(timeout=timeout)
+        output = raw.decode("utf-8", "replace")
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        try:
+            os.killpg(process.pid, signal.SIGKILL)
+        except OSError:
+            pass
+        raw, _ = process.communicate()
+        output = raw.decode("utf-8", "replace")
+
+    elapsed = time.time() - started
+    if timed_out:
+        return {
+            "selector": selector,
+            "status": "error",
+            "time": elapsed,
+            "message": "timed out after %ss" % timeout,
+            "detail": strip_ansi(output)[-MAX_DETAIL:],
+        }
+
+    leaf_status = None
+    subtest_failed = False
+    package_output = []
+    test_output = {}
+    for line in output.splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            if line:
+                package_output.append(line)
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            package_output.append(line)
+            continue
+        test_name = event.get("Test")
+        action = event.get("Action")
+        if event.get("Output"):
+            if test_name is None:
+                package_output.append(event["Output"].rstrip("\n"))
+            else:
+                test_output.setdefault(test_name, []).append(event["Output"].rstrip("\n"))
+        if not test_name:
+            continue
+        if test_name == leaf and action in ("pass", "fail", "skip"):
+            leaf_status = action
+        elif test_name.startswith(leaf + "/") and action == "fail":
+            subtest_failed = True
+
+    if leaf_status is None:
+        if subtest_failed:
+            leaf_status = "fail"
+        else:
+            return {
+                "selector": selector,
+                "status": "error",
+                "time": elapsed,
+                "message": "selector was not collected or did not execute",
+                "detail": strip_ansi("\n".join(package_output))[-MAX_DETAIL:] or strip_ansi(output)[-MAX_DETAIL:],
+            }
+
+    leaf_output = []
+    for name in sorted(test_output):
+        if name == leaf or name.startswith(leaf + "/"):
+            leaf_output.extend(test_output[name])
+    detail = strip_ansi("\n".join(leaf_output + package_output))[-MAX_DETAIL:]
+    if leaf_status == "pass":
+        return {"selector": selector, "status": "pass", "time": elapsed, "message": "", "detail": ""}
+    if leaf_status == "skip":
+        return {
+            "selector": selector,
+            "status": "skipped",
+            "time": elapsed,
+            "message": "selector was skipped",
+            "detail": detail,
+        }
+    return {
+        "selector": selector,
+        "status": "fail",
+        "time": elapsed,
+        "message": "test assertions failed",
+        "detail": detail,
+    }
+
+
+def write_junit(report_path, results):
+    tests = len(results)
+    failures = sum(1 for r in results if r["status"] == "fail")
+    errors = sum(1 for r in results if r["status"] == "error")
+    skipped = sum(1 for r in results if r["status"] == "skipped")
+    total_time = sum(r["time"] for r in results)
+
+    lines = []
+    lines.append('<?xml version="1.0" encoding="UTF-8"?>')
+    lines.append(
+        '<testsuites name="verifier" tests="%d" failures="%d" errors="%d" skipped="%d" time="%.3f">'
+        % (tests, failures, errors, skipped, total_time)
+    )
+    lines.append(
+        '  <testsuite name="verifier" tests="%d" failures="%d" errors="%d" skipped="%d" time="%.3f">'
+        % (tests, failures, errors, skipped, total_time)
+    )
+    lines.append("    <properties>")
+    lines.append('      <property name="runner" value="test/f2p_runner.py"/>')
+    lines.append("    </properties>")
+    for result in results:
+        file_part, leaf = result["selector"].split("::", 1)
+        attributes = 'classname=%s name=%s time="%.3f" selector=%s' % (
+            quoteattr(file_part),
+            quoteattr(leaf),
+            result["time"],
+            quoteattr(result["selector"]),
+        )
+        if result["status"] == "pass":
+            lines.append("    <testcase %s/>" % attributes)
+        elif result["status"] == "fail":
+            lines.append("    <testcase %s>" % attributes)
+            lines.append(
+                "      <failure type=\"AssertionError\" message=%s>%s</failure>"
+                % (quoteattr(result["message"]), escape(result["detail"]))
+            )
+            lines.append("    </testcase>")
+        elif result["status"] == "skipped":
+            lines.append("    <testcase %s>" % attributes)
+            lines.append("      <skipped message=%s/>" % quoteattr(result["message"]))
+            lines.append("    </testcase>")
+        else:
+            lines.append("    <testcase %s>" % attributes)
+            lines.append(
+                "      <error type=\"error\" message=%s>%s</error>"
+                % (quoteattr(result["message"]), escape(result["detail"]))
+            )
+            lines.append("    </testcase>")
+    lines.append("  </testsuite>")
+    lines.append("</testsuites>")
+    lines.append("")
+
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    report_path.write_text("\n".join(lines), encoding="utf-8")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Run the frozen P2P and F2P selectors and write a JUnit report")
+    parser.add_argument("--report", required=True, help="path of the JUnit report to write")
+    parser.add_argument("--select", default="", help="path or content of the selection file")
+    parser.add_argument("--config", default="", help="path of the materialized config.json")
+    parser.add_argument("--node", default="", help="run a single selector")
+    parser.add_argument("--repo", default="", help="repository root (defaults to the runner's parent directory)")
+    parser.add_argument("--timeout", type=float, default=180.0, help="per selector timeout in seconds")
+    args = parser.parse_args()
+
+    repo = Path(args.repo).resolve() if args.repo else repo_root_from_script()
+    report_path = Path(args.report)
+
+    go_binary = find_go()
+    if not go_binary:
+        log("go toolchain not found; cannot run selectors")
+        return 1
+
+    os.umask(0o022)
+
+    selectors = build_selection(args.select, args.config, repo, args.node)
+    if not selectors:
+        log("no selectors found; refusing to write an empty report")
+        return 1
+
+    exec_dir, used_fallback = resolve_exec_dir(repo)
+    if exec_dir is not None:
+        log("executing build products from %s" % exec_dir)
+
+    log("running %d selectors from %s" % (len(selectors), repo))
+    results = []
+    try:
+        for selector in selectors:
+            result = run_selector(repo, go_binary, selector, args.timeout, exec_dir)
+            log("%-9s %s" % (result["status"], selector))
+            results.append(result)
+    finally:
+        if used_fallback:
+            shutil.rmtree(exec_dir, ignore_errors=True)
+
+    write_junit(report_path, results)
+
+    passed = sum(1 for r in results if r["status"] == "pass")
+    failed = sum(1 for r in results if r["status"] == "fail")
+    errored = sum(1 for r in results if r["status"] == "error")
+    skipped = sum(1 for r in results if r["status"] == "skipped")
+    log("report written to %s (pass=%d fail=%d error=%d skipped=%d)" % (report_path, passed, failed, errored, skipped))
+    return 1 if failed or errored or skipped else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
