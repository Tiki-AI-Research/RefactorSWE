+// formatterTargets returns the exported git capability functions whose result
+// is (part of) the text written by a write call of the site (WriteString,
+// Fprintf, ...). The target must define the prefix and build text from it, and
+// the capability result must be the value source of the written text: a
+// wrapper that ignores the capability result and returns its own private text
+// does not count.
+func formatterTargets(m *repoModel, g *pkg, site *decl) []*decl {
+	locals := localBindings(site)
+	var out []*decl
+	ast.Inspect(site.body, func(n ast.Node) bool {
+		call, ok := n.(*ast.CallExpr)
+		if !ok || !writeCallees[callName(call)] {
+			return true
+		}
+		for _, arg := range call.Args {
+			for _, target := range exprOrigins(m, g, site, locals, arg, 0, nil) {
+				if (!g.definesPrefix(target) && len(prefixSourceNames(g, target)) == 0) || !g.hasFormatterEvidence(target) {
+					continue
+				}
+				out = append(out, target)
+			}
+		}
+		return true
+	})
+	return out
+}
+
+// gitSelectorNames returns the selector names of a git import used inside an
+// expression (for example the git.CommitIDPrefix argument of a prefix check).
+func gitSelectorNames(f *parsedFile, expr ast.Expr) []string {
+	return gitSelectorNamesResolved(f, nil, expr)
+}
+
+// gitSelectorNamesResolved is gitSelectorNames with local bindings followed,
+// so a prefix constant copied into a local variable is still recognized.
+func gitSelectorNamesResolved(f *parsedFile, locals map[string]ast.Expr, expr ast.Expr) []string {
+	var out []string
+	seen := map[string]bool{}
+	var visit func(node ast.Node, depth int)
+	visit = func(node ast.Node, depth int) {
+		if node == nil || depth > 12 {
+			return
+		}
+		switch item := node.(type) {
+		case *ast.SelectorExpr:
+			qual, ok := item.X.(*ast.Ident)
+			if ok && resolveImport(f, qual.Name) == gitImportPath {
+				out = append(out, item.Sel.Name)
+				return
+			}
+		case *ast.Ident:
+			if item.Name == "_" || seen[item.Name] {
+				return
+			}
+			if bound, ok := locals[item.Name]; ok {
+				seen[item.Name] = true
+				visit(bound, depth+1)
+				return
+			}
+		}
+		for _, child := range nodeChildren(node) {
+			visit(child, depth+1)
+		}
+	}
+	visit(expr, 0)
+	return out
+}
+
+// nodeChildren returns the expression children of an AST node, which is enough
+// for the selector search used by the scan leaf.
+func nodeChildren(node ast.Node) []ast.Node {
+	var out []ast.Node
+	ast.Inspect(node, func(n ast.Node) bool {
+		if n == nil || n == node {
+			return true
+		}
+		out = append(out, n)
+		return false
+	})
+	return out
+}
+
+// scanTargets returns the exported git declarations that drive the existing-id
+// detection of the reword helper: a used capability call whose result is the
+// condition of a branch that decides the scan result, or an exported
+// prefix-carrying constant/variable used by the prefix predicate of such a
+// branch. An incidental reference that does not decide the result, such as a
+// discarded strings.TrimPrefix(line, git.CommitIDPrefix), does not count.
+func scanTargets(m *repoModel, g *pkg, site *decl) []*decl {
+	var out []*decl
+	ast.Inspect(site.body, func(n ast.Node) bool {
+		stmt, ok := n.(*ast.IfStmt)
+		if !ok {
+			return true
+		}
+		if !blockDecidesResult(site, stmt.Body) {
+			if elseBlock, ok := stmt.Else.(*ast.BlockStmt); !ok || !blockDecidesResult(site, elseBlock) {
+				return true
+			}
+		}
+		locals := localBindings(site)
+		for _, call := range callsReached(site, locals, stmt.Cond) {
+			if site.file.isDiscarded(call) {
+				continue
+			}
+			for _, target := range capabilityCallsResolved(m, g, site, call, 0, nil) {
+				if g.definesPrefix(target) && g.hasParseEvidence(target) {
+					out = append(out, target)
+				}
+			}
+			if !prefixCallees[callName(call)] {
+				continue
+			}
+			for _, arg := range call.Args {
+				for _, name := range gitSelectorNamesResolved(site.file, locals, arg) {
+					target := g.decls[name]
+					if target == nil || !target.exported {
+						continue
+					}
+					if target.kind != "const" && target.kind != "var" {
+						continue
+					}
+					if g.definesPrefix(target) {
+						out = append(out, target)
+					}
+				}
+			}
+		}
+		return true
+	})
+	return out
+}
+
+func targetsForSites(m *repoModel, g *pkg, sites []*decl, finder func(*repoModel, *pkg, *decl) []*decl) []*decl {
+	var out []*decl
+	for _, site := range sites {
+		out = append(out, finder(m, g, site)...)
+	}
+	return out
+}
+
+// prefixCarryingSources returns the package-level const/var declarations that
+// define the protocol prefix and feed the observable parse/format behavior of
+// the targets. A declaration that is merely referenced (for example through a
+// blank assignment) does not count.
+func prefixCarryingSources(g *pkg, targets []*decl) map[string]bool {
+	out := map[string]bool{}
