+package f2p
+
+// Source-structure analysis helpers shared by the F2P leaves.
+//
+// The F2P obligation is structural: the repository must move the commit-id
+// protocol rules behind one exported capability in the `git` package, and the
+// callers in the other packages must obtain the protocol text, the identifier
+// shape and the written text through that capability instead of keeping a
+// private copy of the rules.
+//
+// The helpers below parse every production (non-test) .go file with
+// go/parser and build a declaration model. The predicates are deliberately
+// based on data flow and definitions instead of names:
+//
+//   - a declaration "defines the prefix" when a string literal equal to
+//     `commit-id` or starting with `commit-id:` (or the regexp-escaped form)
+//     is reachable from it through package-level const/var initializers and
+//     its own body literals (local consts and local variables included);
+//   - a declaration "enforces the shape" only when a regexp whose argument
+//     closure contains both the prefix and the eight-hex shape is compiled
+//     and then used by a match call (FindStringSubmatch, MatchString, ...);
+//   - a call is only a delegation when its result is actually consumed, so a
+//     discarded `_ = git.Something` reference never counts.
+//
+// This keeps the checks free of name/doc heuristics and of the over-broad
+// "any identifier anywhere in the closure" approximations that made the
+// previous round's assertions satisfiable by no-op declarations.
+
+import (
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const gitImportPath = "github.com/ejoffe/spr/git"
+
+var (
+	// hexClassQuantifierPattern finds character classes with a fixed repeat
+	// count in a folded regexp source, for example `[a-f0-9]{8}`.
+	hexClassQuantifierPattern = regexp.MustCompile(`\[([0-9a-fA-F\-]+)\]\{([0-9]+)\}`)
+
+	commitLogHeaderPattern = regexp.MustCompile(`\^commit\s`)
+	commitHashShapePattern = regexp.MustCompile(`\[a-f0-9\]\{40\}`)
+	mockLogCommitPattern   = regexp.MustCompile(`commit %s`)
+)
+
+// matchCallees are the regexp match methods that apply a compiled pattern.
+var matchCallees = map[string]bool{
+	"FindStringSubmatch":      true,
+	"FindStringSubmatchIndex": true,
+	"FindAllStringSubmatch":   true,
+	"MatchString":             true,
+	"Find":                    true,
+	"FindString":              true,
+}
+
+// prefixCallees are the string predicates that consume a prefix value.
+var prefixCallees = map[string]bool{
+	"CutPrefix":   true,
+	"HasPrefix":   true,
+	"HasSuffix":   true,
+	"Contains":    true,
+	"ContainsAny": true,
+	"Index":       true,
+	"IndexAny":    true,
+	"LastIndex":   true,
+	"Split":       true,
+	"SplitN":      true,
+	"SplitAfter":  true,
+	"Cut":         true,
+	"TrimPrefix":  true,
+	"TrimSuffix":  true,
+	"EqualFold":   true,
+	"Count":       true,
+}
+
+// writeCallees are the calls that emit text.
+var writeCallees = map[string]bool{
+	"WriteString": true,
+	"Write":       true,
+	"WriteFile":   true,
+	"Fprintf":     true,
+	"Printf":      true,
+	"Sprintf":     true,
+	"Sprint":      true,
+	"Sprintln":    true,
+}
+
+// formatCallees are the calls that can build text from a format string.
+var formatCallees = map[string]bool{
+	"Sprintf":  true,
+	"Fprintf":  true,
+	"Printf":   true,
+	"Sprint":   true,
+	"Sprintln": true,
+	"Join":     true,
+}
+
+// transparentCallees are the calls whose result is built from their arguments
+// with known semantics, so a value that reaches an argument also reaches the
+// call result. Unknown (private) calls are deliberately not transparent: an
+// argument of an arbitrary wrapper does not prove that the wrapper's result
+// carries that argument.
+var transparentCallees = map[string]bool{
+	"Sprintf":     true,
+	"Sprint":      true,
+	"Sprintln":    true,
+	"Join":        true,
+	"QuoteMeta":   true,
+	"Errorf":      true,
+	"TrimSpace":   true,
+	"Trim":        true,
+	"TrimLeft":    true,
+	"TrimRight":   true,
+	"TrimPrefix":  true,
+	"TrimSuffix":  true,
+	"Replace":     true,
+	"ReplaceAll":  true,
+	"ToLower":     true,
+	"ToUpper":     true,
+	"ToValidUTF8": true,
+	"Clone":       true,
+	"Repeat":      true,
+}
+
+func transparentCall(d *decl, call *ast.CallExpr) bool {
+	if id, ok := call.Fun.(*ast.Ident); ok && id.Name == "append" {
+		return d.pkg.decls[id.Name] == nil && !localNames(d)[id.Name]
+	}
+	if callName(call) == "Cut" || callName(call) == "CutPrefix" || callName(call) == "CutSuffix" {
+		if selector, ok := call.Fun.(*ast.SelectorExpr); ok {
+			if qualifier, ok := selector.X.(*ast.Ident); ok {
+				return d.file.imports[qualifier.Name] == "strings"
+			}
+		}
+		return false
+	}
+	return transparentCallees[callName(call)]
+}
+
+// sinkCallees are the calls that consume a value as a protocol rule or as
+// emitted text: a private value used by one of them is a protocol rule even
+// when the call itself is not a comparison or a regexp operation.
+var sinkCallees = func() map[string]bool {
+	out := map[string]bool{}
+	for name := range ruleCallNames {
+		out[name] = true
+	}
+	for name := range writeCallees {
+		out[name] = true
+	}
+	return out
+}()
+
+type parsedFile struct {
+	rel     string
+	pkgDir  string
+	pkgName string
+	file    *ast.File
+	src     []byte
+	fset    *token.FileSet
+	imports map[string]string
+	parents map[ast.Node]ast.Node
+}
+
+type callInfo struct {
+	expr      *ast.CallExpr
+	fnName    string
+	qual      string
+	text      string
+	used      bool
+	argLits   []string
+	argIdents []string
+}
+
+type selectorRef struct {
+	qual   string
+	name   string
+	text   string
+	isCall bool
+	used   bool
+}
+
+type decl struct {
+	pkg          *pkg
+	name         string
+	base         string
+	recv         string
+	recvExported bool
+	exported     bool
+	kind         string
+	file         *parsedFile
+	node         ast.Node
+	body         ast.Node
+	value        ast.Expr
+	typeSpec     *ast.TypeSpec
+	doc          string
+	signature    string
+	literals     []string
+	idents       map[string]bool
+	fields       map[string]bool
+	calls        []*callInfo
+	selectors    []*selectorRef
+}
+
+type pkg struct {
+	dir   string
+	name  string
+	files []*parsedFile
+	decls map[string]*decl
+	order []*decl
+}
+
+type repoModel struct {
+	root string
+	pkgs map[string]*pkg
+}
+
+var (
+	loadOnce sync.Once
+	loaded   *repoModel
+	loadErr  error
+)
+
+func loadRepo(t *testing.T) *repoModel {
+	t.Helper()
+	loadOnce.Do(func() {
+		loaded, loadErr = buildRepoModel()
+	})
+	if loadErr != nil {
+		t.Fatalf("cannot analyze the repository production sources: %v", loadErr)
+	}
+	if loaded == nil {
+		t.Fatalf("repository model was not built")
+	}
+	return loaded
+}
+
+func findRepoRoot() (string, error) {
+	dir, err := os.Getwd()
+	if err != nil {
+		return "", err
+	}
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir, nil
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "", fmt.Errorf("go.mod not found above %s", dir)
+		}
+		dir = parent
+	}
+}
+
+func buildRepoModel() (*repoModel, error) {
+	root, err := findRepoRoot()
+	if err != nil {
+		return nil, err
+	}
+	model := &repoModel{root: root, pkgs: map[string]*pkg{}}
+	fset := token.NewFileSet()
+
+	err = filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		name := entry.Name()
+		if entry.IsDir() {
+			if path == root {
+				return nil
+			}
+			if name == ".git" || name == "vendor" || name == "testdata" ||
+				strings.HasPrefix(name, ".") || strings.HasPrefix(name, "_") {
+				return fs.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			return nil
+		}
+		src, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		file, err := parser.ParseFile(fset, path, src, parser.ParseComments|parser.SkipObjectResolution)
+		if err != nil {
+			return fmt.Errorf("parse %s: %w", path, err)
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		rel = filepath.ToSlash(rel)
+		pkgDir := filepath.ToSlash(filepath.Dir(rel))
+		if pkgDir == "." {
+			pkgDir = "."
+		}
+		imports := map[string]string{}
+		for _, spec := range file.Imports {
+			importPath, err := strconv.Unquote(spec.Path.Value)
+			if err != nil {
+				continue
+			}
+			alias := importPath
+			if index := strings.LastIndex(importPath, "/"); index >= 0 {
+				alias = importPath[index+1:]
+			}
+			if spec.Name != nil {
+				alias = spec.Name.Name
+			}
+			imports[alias] = importPath
+		}
+		parsed := &parsedFile{
+			rel:     rel,
+			pkgDir:  pkgDir,
+			pkgName: file.Name.Name,
+			file:    file,
+			src:     src,
+			fset:    fset,
+			imports: imports,
+			parents: buildParents(file),
+		}
+		p := model.pkgs[pkgDir]
+		if p == nil {
+			p = &pkg{dir: pkgDir, name: file.Name.Name, decls: map[string]*decl{}}
+			model.pkgs[pkgDir] = p
+		}
+		p.files = append(p.files, parsed)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	for _, p := range model.pkgs {
+		buildPackageDecls(p)
+	}
+	return model, nil
+}
+
+func buildParents(file *ast.File) map[ast.Node]ast.Node {
+	parents := map[ast.Node]ast.Node{}
+	var stack []ast.Node
+	ast.Inspect(file, func(n ast.Node) bool {
+		if n == nil {
+			if len(stack) > 0 {
+				stack = stack[:len(stack)-1]
+			}
+			return true
+		}
+		if len(stack) > 0 {
+			parents[n] = stack[len(stack)-1]
+		}
+		stack = append(stack, n)
+		return true
+	})
+	return parents
+}
+
+func buildPackageDecls(p *pkg) {
+	for _, f := range p.files {
+		for _, top := range f.file.Decls {
+			switch node := top.(type) {
+			case *ast.FuncDecl:
+				d := &decl{
+					pkg:      p,
+					name:     node.Name.Name,
+					base:     node.Name.Name,
+					exported: ast.IsExported(node.Name.Name),
+					kind:     "func",
+					file:     f,
+					node:     node,
+					body:     node.Body,
+					doc:      commentText(node.Doc),
+				}
+				if node.Recv != nil {
+					d.kind = "method"
+					recv, recvExported := receiverTypeName(node)
+					d.recv = recv
+					d.recvExported = recvExported
+					d.exported = d.exported && recvExported
+					if recv != "" {
+						d.name = recv + "." + node.Name.Name
+					}
+				}
+				if node.Type.Params != nil {
+					d.signature = normalizeSpace(sourceBetween(f, node.Type.Params.Pos(), node.Type.End()))
+				}
+				collectNode(d, node.Body)
+				p.add(d)
+			case *ast.GenDecl:
+				for _, spec := range node.Specs {
+					switch s := spec.(type) {
+					case *ast.ValueSpec:
+						doc := s.Doc
+						if doc == nil {
+							doc = node.Doc
+						}
+						for i, ident := range s.Names {
+							d := &decl{
+								pkg:      p,
+								name:     ident.Name,
+								base:     ident.Name,
+								exported: ast.IsExported(ident.Name),
+								kind:     strings.ToLower(node.Tok.String()),
+								file:     f,
+								node:     s,
+								doc:      commentText(doc),
+							}
+							var value ast.Expr
+							if i < len(s.Values) {
+								value = s.Values[i]
+							} else if len(s.Values) > 0 {
+								value = s.Values[0]
+							}
+							d.value = value
+							d.body = value
+							if value != nil {
+								d.signature = normalizeSpace(sourceOf(f, value))
+								collectNode(d, value)
+							}
+							p.add(d)
+						}
+					case *ast.TypeSpec:
+						d := &decl{
+							pkg:      p,
+							name:     s.Name.Name,
+							base:     s.Name.Name,
+							exported: ast.IsExported(s.Name.Name),
+							kind:     "type",
+							file:     f,
+							node:     s,
+							body:     s.Type,
+							typeSpec: s,
+							doc:      commentText(s.Doc),
+						}
+						d.signature = normalizeSpace(sourceOf(f, s.Type))
+						collectNode(d, s.Type)
+						p.add(d)
+					}
+				}
+			}
+		}
+	}
+}
+
+func (p *pkg) add(d *decl) {
+	if _, exists := p.decls[d.name]; !exists {
+		p.decls[d.name] = d
+		p.order = append(p.order, d)
+	}
+}
+
+func collectNode(d *decl, node ast.Node) {
+	if node == nil {
+		return
+	}
+	if d.idents == nil {
+		d.idents = map[string]bool{}
+	}
+	if d.fields == nil {
+		d.fields = map[string]bool{}
+	}
+	ast.Inspect(node, func(n ast.Node) bool {
+		switch item := n.(type) {
+		case *ast.BasicLit:
+			if item.Kind == token.STRING {
+				if value, err := strconv.Unquote(item.Value); err == nil {
+					d.literals = append(d.literals, value)
+				} else {
+					d.literals = append(d.literals, strings.Trim(item.Value, "`\""))
+				}
+			}
+		case *ast.Ident:
+			d.idents[item.Name] = true
+		case *ast.SelectorExpr:
+			d.fields[item.Sel.Name] = true
+			if qual, ok := item.X.(*ast.Ident); ok {
+				d.selectors = append(d.selectors, &selectorRef{
+					qual: qual.Name,
+					name: item.Sel.Name,
+					text: normalizeSpace(sourceOf(d.file, item)),
+					used: !d.file.isDiscarded(item),
+				})
+			}
+		case *ast.CallExpr:
+			info := &callInfo{
+				expr: item,
+				text: normalizeSpace(sourceOf(d.file, item)),
+				used: !d.file.isDiscarded(item),
+			}
+			switch fun := item.Fun.(type) {
+			case *ast.Ident:
+				info.fnName = fun.Name
+			case *ast.SelectorExpr:
+				info.fnName = fun.Sel.Name
+				if qual, ok := fun.X.(*ast.Ident); ok {
+					info.qual = qual.Name
+					d.selectors = append(d.selectors, &selectorRef{
+						qual:   qual.Name,
+						name:   fun.Sel.Name,
+						text:   info.text,
+						isCall: true,
+						used:   info.used,
+					})
+				}
+			}
+			for _, arg := range item.Args {
+				ast.Inspect(arg, func(inner ast.Node) bool {
+					switch value := inner.(type) {
+					case *ast.BasicLit:
+						if value.Kind == token.STRING {
+							if unquoted, err := strconv.Unquote(value.Value); err == nil {
+								info.argLits = append(info.argLits, unquoted)
+							} else {
+								info.argLits = append(info.argLits, value.Value)
+							}
+						}
+					case *ast.Ident:
+						info.argIdents = append(info.argIdents, value.Name)
+					}
+					return true
+				})
+			}
+			d.calls = append(d.calls, info)
+		}
+		return true
+	})
+}
+
+// isDiscarded reports whether the value of node is thrown away: a bare
+// expression statement, a go/defer statement, or an assignment whose
+// receiving identifiers are all blank. A multi-value call that binds at least
+// one named result (for example `if _, ok := git.Parse(line); ok`) is not
+// discarded.
+func (f *parsedFile) isDiscarded(n ast.Node) bool {
+	parent := f.parents[n]
+	switch p := parent.(type) {
+	case *ast.ExprStmt:
+		return true
+	case *ast.GoStmt, *ast.DeferStmt:
+		return true
+	case *ast.AssignStmt:
+		for i, rhs := range p.Rhs {
+			if rhs != n {
+				continue
+			}
+			if len(p.Rhs) == 1 && len(p.Lhs) > 1 {
+				for _, lhs := range p.Lhs {
+					if !isBlankIdent(lhs) {
+						return false
+					}
+				}
+				return true
+			}
+			if i < len(p.Lhs) {
+				return isBlankIdent(p.Lhs[i])
+			}
+			return false
+		}
+		return false
+	case *ast.ValueSpec:
+		for i, value := range p.Values {
+			if value != n {
+				continue
+			}
+			if i < len(p.Names) {
+				return p.Names[i].Name == "_"
+			}
+			return false
+		}
+		return false
+	}
+	return false
+}
+
+func isBlankIdent(expr ast.Expr) bool {
+	id, ok := expr.(*ast.Ident)
+	return ok && id.Name == "_"
+}
+
+func commentText(group *ast.CommentGroup) string {
+	if group == nil {
+		return ""
+	}
+	return group.Text()
+}
+
+func receiverTypeName(node *ast.FuncDecl) (string, bool) {
+	if node.Recv == nil || len(node.Recv.List) == 0 {
+		return "", false
+	}
+	switch recv := node.Recv.List[0].Type.(type) {
+	case *ast.Ident:
+		return recv.Name, ast.IsExported(recv.Name)
+	case *ast.StarExpr:
+		if ident, ok := recv.X.(*ast.Ident); ok {
+			return ident.Name, ast.IsExported(ident.Name)
+		}
+	case *ast.IndexExpr:
+		if ident, ok := recv.X.(*ast.Ident); ok {
+			return ident.Name, ast.IsExported(ident.Name)
+		}
+	}
+	return "", false
+}
+
+func sourceBetween(f *parsedFile, start, end token.Pos) string {
+	if f == nil {
+		return ""
+	}
+	startPos := f.fset.Position(start)
+	endPos := f.fset.Position(end)
+	if startPos.Offset < 0 || endPos.Offset > len(f.src) || startPos.Offset > endPos.Offset {
+		return ""
+	}
+	return string(f.src[startPos.Offset:endPos.Offset])
+}
+
+func sourceOf(f *parsedFile, node ast.Node) string {
+	if f == nil || node == nil {
+		return ""
+	}
+	return sourceBetween(f, node.Pos(), node.End())
+}
+
+func normalizeSpace(text string) string {
+	return strings.Join(strings.Fields(text), " ")
+}
+
+func isImportName(f *parsedFile, name string) bool {
+	if f == nil {
+		return false
+	}
+	if name == "_" || name == "." {
+		return true
+	}
+	_, ok := f.imports[name]
+	return ok
+}
+
+func (m *repoModel) mustPkg(t *testing.T, dir string) *pkg {
+	t.Helper()
+	p := m.pkgs[dir]
+	if p == nil {
+		t.Fatalf("package %q not found in the repository sources; packages: %v", dir, m.packageDirs())
+	}
+	return p
+}
+
+func (m *repoModel) packageDirs() []string {
+	dirs := make([]string, 0, len(m.pkgs))
+	for dir := range m.pkgs {
+		dirs = append(dirs, dir)
+	}
+	sort.Strings(dirs)
+	return dirs
+}
+
+func (p *pkg) funcs() []*decl {
+	var funcs []*decl
+	for _, d := range p.order {
+		if d.kind == "func" || d.kind == "method" {
+			funcs = append(funcs, d)
+		}
+	}
+	return funcs
+}
+
+func (p *pkg) funcsMatching(predicate func(*decl) bool) []*decl {
+	var matched []*decl
+	for _, d := range p.funcs() {
+		if predicate(d) {
+			matched = append(matched, d)
+		}
+	}
+	return matched
+}
+
+func (d *decl) hasIdent(name string) bool {
+	return d.idents[name]
+}
+
+func (d *decl) hasFieldName(name string) bool {
+	return d.fields[name]
+}
+
+func (d *decl) hasLiteralMatching(re *regexp.Regexp) bool {
+	for _, lit := range d.literals {
+		if re.MatchString(lit) {
+			return true
+		}
+	}
+	return false
+}
+
+func (d *decl) hasSelectorName(name string) bool {
+	for _, ref := range d.selectors {
+		if ref.name == name {
+			return true
+		}
+	}
+	return false
+}
+
+// colonProtocolLiteral reports whether a string literal carries the
+// `commit-id:` prefix (also in its regexp-escaped spelling). Diagnostic
+// sentences such as "missing commit-id in the commit body" are not protocol
+// text, and neither is the bare token without a colon.
+func colonProtocolLiteral(lit string) bool {
+	return strings.Contains(lit, "commit-id:") || strings.Contains(lit, `commit-id\:`)
+}
+
+// prefixDefiningLiteral reports whether a literal can serve as the protocol
+// prefix definition: the bare `commit-id` token or a literal carrying the
+// colon form. It is used to recognize the shared capability declarations.
+func prefixDefiningLiteral(lit string) bool {
+	return lit == "commit-id" || colonProtocolLiteral(lit)
+}
+
+// ruleCallNames are the calls in which a commit-id literal is a protocol rule
+// rather than a diagnostic label: prefix predicates, regexp compilation and
+// matching, and format builders.
+var ruleCallNames = func() map[string]bool {
+	out := map[string]bool{"MustCompile": true, "Compile": true, "QuoteMeta": true}
+	for name := range prefixCallees {
+		out[name] = true
+	}
+	for name := range formatCallees {
+		out[name] = true
+	}
+	for name := range matchCallees {
+		out[name] = true
+	}
+	return out
+}()
+
+func isComparisonOp(op token.Token) bool {
+	switch op {
+	case token.EQL, token.NEQ, token.LSS, token.GTR, token.LEQ, token.GEQ:
+		return true
+	}
+	return false
+}
+
+func unquoteString(value string) string {
+	if lit, err := strconv.Unquote(value); err == nil {
+		return lit
+	}
+	return strings.Trim(value, "`\"")
+}
+
+// exprContainsIdent reports whether the expression uses the identifier.
+func exprContainsIdent(expr ast.Expr, name string, depth int) bool {
+	if expr == nil || depth > 12 {
+		return false
+	}
+	switch v := expr.(type) {
+	case *ast.Ident:
+		return v.Name == name
+	case *ast.ParenExpr:
+		return exprContainsIdent(v.X, name, depth+1)
+	case *ast.BinaryExpr:
+		return exprContainsIdent(v.X, name, depth+1) || exprContainsIdent(v.Y, name, depth+1)
+	case *ast.SelectorExpr:
+		return exprContainsIdent(v.X, name, depth+1)
+	case *ast.CallExpr:
+		if exprContainsIdent(v.Fun, name, depth+1) {
+			return true
+		}
+		for _, arg := range v.Args {
+			if exprContainsIdent(arg, name, depth+1) {
+				return true
+			}
+		}
+	case *ast.IndexExpr:
+		return exprContainsIdent(v.X, name, depth+1)
+	case *ast.SliceExpr:
+		return exprContainsIdent(v.X, name, depth+1)
+	case *ast.StarExpr:
+		return exprContainsIdent(v.X, name, depth+1)
+	case *ast.UnaryExpr:
+		return exprContainsIdent(v.X, name, depth+1)
+	case *ast.KeyValueExpr:
+		return exprContainsIdent(v.Value, name, depth+1)
+	case *ast.CompositeLit:
+		for _, elt := range v.Elts {
+			if exprContainsIdent(elt, name, depth+1) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// nameUsedInRulePosition reports whether the identifier is consumed by a rule
+// operation: an argument (or receiver) of a prefix/regexp/format call, or an
+// operand of a comparison.
+func nameUsedInRulePosition(d *decl, name string) bool {
+	found := false
+	if d.body == nil {
+		return false
+	}
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		if found {
+			return false
+		}
+		switch item := n.(type) {
+		case *ast.CallExpr:
+			if !sinkCallees[callName(item)] {
+				return true
+			}
+			if exprContainsIdent(item.Fun, name, 0) {
+				found = true
+				return false
+			}
+			for _, arg := range item.Args {
+				if exprContainsIdent(arg, name, 0) {
+					found = true
+					return false
+				}
+			}
+		case *ast.BinaryExpr:
+			if isComparisonOp(item.Op) && (exprContainsIdent(item.X, name, 0) || exprContainsIdent(item.Y, name, 0)) {
+				found = true
+				return false
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// literalInRulePosition walks from a literal up to its declaration and
+// reports whether it is consumed by a rule operation, either directly or
+// through a local binding that is used as a rule operand.
+func literalInRulePosition(d *decl, lit *ast.BasicLit, locals map[string]ast.Expr) bool {
+	var child ast.Node = lit
+	for node := d.file.parents[lit]; node != nil && node != d.node; node = d.file.parents[node] {
+		switch n := node.(type) {
+		case *ast.CallExpr:
+			for _, arg := range n.Args {
+				if arg == child && sinkCallees[callName(n)] {
+					return true
+				}
+			}
+		case *ast.BinaryExpr:
+			if isComparisonOp(n.Op) {
+				return true
+			}
+		case *ast.AssignStmt:
+			for i, rhs := range n.Rhs {
+				if rhs != child || i >= len(n.Lhs) {
+					continue
+				}
+				if id, ok := n.Lhs[i].(*ast.Ident); ok && id.Name != "_" {
+					if nameUsedInRulePosition(d, id.Name) {
+						return true
+					}
+				}
+			}
+		case *ast.ValueSpec:
+			for i, value := range n.Values {
+				if value != child || i >= len(n.Names) {
+					continue
+				}
+				if nameUsedInRulePosition(d, n.Names[i].Name) {
+					return true
+				}
+			}
+		}
+		child = node
+	}
+	return false
+}
+
+// protocolRuleEvidence reports a private protocol rule kept by a declaration:
+// a colon-form protocol literal anywhere in its body (including local
+// const/var declarations), the bare `commit-id` token used as a rule operand,
+// or a local/package-level value carrying protocol text that the declaration
+// consumes in a rule operation. Diagnostic labels such as a debug log field
+// named "commit-id" are not rules.
+func protocolRuleEvidence(p *pkg, d *decl, exclude map[*decl]bool) string {
+	locals := localBindings(d)
+	var evidence string
+	if d.body == nil {
+		return ""
+	}
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		if evidence != "" {
+			return false
+		}
+		lit, ok := n.(*ast.BasicLit)
+		if !ok || lit.Kind != token.STRING {
+			return true
+		}
+		value := unquoteString(lit.Value)
+		if colonProtocolLiteral(value) {
+			evidence = fmt.Sprintf("%s keeps the protocol literal %q", d.name, value)
+			return false
+		}
+		if value == "commit-id" && literalInRulePosition(d, lit, locals) {
+			evidence = fmt.Sprintf("%s uses the protocol token %q as a rule", d.name, value)
+			return false
+		}
+		// A protocol literal that is split into fragments is still a private
+		// copy: fold the expression the literal belongs to and flag it when
+		// the folded value carries the protocol prefix.
+		if parent, ok := d.file.parents[lit].(ast.Expr); ok {
+			if folded := p.foldStrings(d.file, locals, parent, 0, nil); len(folded) > 0 {
+				for _, fragment := range folded {
+					if colonProtocolLiteral(fragment) {
+						evidence = fmt.Sprintf("%s assembles the protocol literal %q", d.name, fragment)
+						return false
+					}
+				}
+			}
+		}
+		return true
+	})
+	if evidence != "" {
+		return evidence
+	}
+	for name := range d.idents {
+		if !nameUsedInRulePosition(d, name) {
+			continue
+		}
+		if bound := locals[name]; bound != nil {
+			if exprHasProtocolText(p, bound, locals, 0) {
+				return fmt.Sprintf("%s consumes the local %s carrying commit-id protocol text in a rule", d.name, name)
+			}
+			continue
+		}
+		if isImportName(d.file, name) {
+			continue
+		}
+		if target := p.decls[name]; target != nil && (target.kind == "const" || target.kind == "var") {
+			if exclude[target] {
+				continue
+			}
+			if exprHasProtocolText(p, target.value, nil, 0) {
+				return fmt.Sprintf("%s consumes the private %s %s carrying commit-id protocol text in a rule", d.name, target.kind, target.name)
+			}
+		}
+	}
+	if evidence := p.privateExtractionEvidence(d); evidence != "" {
+		return evidence
+	}
+	return ""
+}
+
+// exprHasProtocolText reports whether the expression reaches a colon-form
+// protocol literal or the bare `commit-id` token through local bindings and
+// package-level const/var initializers. Concatenations are folded first, so a
+// protocol text assembled from fragments such as "commit" + "-id:" is
+// recognized even though no single literal carries the full prefix.
+func exprHasProtocolText(p *pkg, expr ast.Expr, locals map[string]ast.Expr, depth int) bool {
+	if expr == nil || depth > 12 {
+		return false
+	}
+	if folded := p.foldStrings(nil, locals, expr, 0, nil); len(folded) > 0 {
+		for _, value := range folded {
+			if colonProtocolLiteral(value) {
+				return true
+			}
+		}
+	}
+	switch v := expr.(type) {
+	case *ast.BasicLit:
+		if v.Kind != token.STRING {
+			return false
+		}
+		value := unquoteString(v.Value)
+		return colonProtocolLiteral(value) || value == "commit-id"
+	case *ast.Ident:
+		if v.Name == "_" {
+			return false
+		}
+		if bound, ok := locals[v.Name]; ok {
+			return exprHasProtocolText(p, bound, locals, depth+1)
+		}
+		if isImportName(nil, v.Name) {
+			return false
+		}
+		if next := p.decls[v.Name]; next != nil && (next.kind == "const" || next.kind == "var") {
+			return exprHasProtocolText(p, next.value, nil, depth+1)
+		}
+		return false
+	case *ast.ParenExpr:
+		return exprHasProtocolText(p, v.X, locals, depth+1)
+	case *ast.BinaryExpr:
+		return exprHasProtocolText(p, v.X, locals, depth+1) || exprHasProtocolText(p, v.Y, locals, depth+1)
+	case *ast.SelectorExpr:
+		return exprHasProtocolText(p, v.X, locals, depth+1)
+	case *ast.CallExpr:
+		for _, arg := range v.Args {
+			if exprHasProtocolText(p, arg, locals, depth+1) {
+				return true
+			}
+		}
+	case *ast.IndexExpr:
+		return exprHasProtocolText(p, v.X, locals, depth+1)
+	case *ast.SliceExpr:
+		return exprHasProtocolText(p, v.X, locals, depth+1)
+	case *ast.StarExpr:
+		return exprHasProtocolText(p, v.X, locals, depth+1)
+	case *ast.UnaryExpr:
+		return exprHasProtocolText(p, v.X, locals, depth+1)
+	case *ast.KeyValueExpr:
+		return exprHasProtocolText(p, v.Value, locals, depth+1)
+	case *ast.CompositeLit:
+		for _, elt := range v.Elts {
+			if exprHasProtocolText(p, elt, locals, depth+1) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// localNames collects every identifier declared inside the function scope:
+// receiver, parameters, named results, short variable declarations, var/const
+// declarations and range variables. Identifiers shadowed this way never
+// resolve to package-level declarations in the data-flow walks.
+func localNames(d *decl) map[string]bool {
+	names := map[string]bool{}
+	if d.body == nil {
+		return names
+	}
+	if fn, ok := d.node.(*ast.FuncDecl); ok {
+		collectFieldNames(fn.Recv, names)
+		collectFieldNames(fn.Type.Params, names)
+		collectFieldNames(fn.Type.Results, names)
+	}
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		switch item := n.(type) {
+		case *ast.AssignStmt:
+			if item.Tok == token.DEFINE {
+				for _, lhs := range item.Lhs {
+					if id, ok := lhs.(*ast.Ident); ok {
+						names[id.Name] = true
+					}
+				}
+			}
+		case *ast.DeclStmt:
+			if gd, ok := item.Decl.(*ast.GenDecl); ok {
+				for _, spec := range gd.Specs {
+					if vs, ok := spec.(*ast.ValueSpec); ok {
+						for _, id := range vs.Names {
+							names[id.Name] = true
+						}
+					}
+				}
+			}
+		case *ast.RangeStmt:
+			for _, expr := range []ast.Expr{item.Key, item.Value} {
+				if id, ok := expr.(*ast.Ident); ok {
+					names[id.Name] = true
+				}
+			}
+		}
+		return true
+	})
+	return names
+}
+
+func collectFieldNames(fields *ast.FieldList, names map[string]bool) {
+	if fields == nil {
+		return
+	}
+	for _, field := range fields.List {
+		for _, name := range field.Names {
+			names[name.Name] = true
+		}
+	}
+}
+
+// setBinding records the value expression of a local variable. When a name is
+// assigned more than once, a self-referential update such as
+// `value = value[:index]` keeps the earlier binding, because the update only
+// narrows the value the variable already carries; a plain reassignment
+// replaces the binding so the newest value wins.
+func setBinding(out map[string]ast.Expr, name string, value ast.Expr) {
+	if call, ok := value.(*ast.CallExpr); ok {
+		if ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == "append" && len(call.Args) > 0 {
+			if first, ok := call.Args[0].(*ast.Ident); ok && first.Name == name {
+				if previous, ok := out[name]; ok {
+					copyCall := *call
+					copyCall.Args = append([]ast.Expr{previous}, call.Args[1:]...)
+					value = &copyCall
+				}
+				out[name] = value
+				return
+			}
+		}
+	}
+	if _, ok := out[name]; ok && exprContainsIdent(value, name, 0) {
+		return
+	}
+	out[name] = value
+}
+
+// identUseIsDiscarded reports whether an occurrence of an identifier is a
+// blank assignment that throws the value away, as in `_ = formatted`.
+func identUseIsDiscarded(f *parsedFile, id *ast.Ident) bool {
+	stmt, ok := f.parents[id].(*ast.AssignStmt)
+	if !ok {
+		return false
+	}
+	for index, rhs := range stmt.Rhs {
+		if rhs != id {
+			continue
+		}
+		if len(stmt.Rhs) == 1 && len(stmt.Lhs) > 1 {
+			for _, lhs := range stmt.Lhs {
+				if !isBlankIdent(lhs) {
+					return false
+				}
+			}
+			return true
+		}
+		if index < len(stmt.Lhs) {
+			return isBlankIdent(stmt.Lhs[index])
+		}
+		return false
+	}
+	return false
+}
+
+// identIsDeclaration reports whether an occurrence of an identifier declares
+// the variable instead of reading it.
+func identIsDeclaration(f *parsedFile, id *ast.Ident) bool {
+	switch parent := f.parents[id].(type) {
+	case *ast.AssignStmt:
+		for _, lhs := range parent.Lhs {
+			if lhs == id {
+				return true
+			}
+		}
+	case *ast.ValueSpec:
+		for _, name := range parent.Names {
+			if name == id {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// localNameDiscarded reports whether every read of the local variable name in
+// d is a blank assignment, so the value it carries is never observed.
+func localNameDiscarded(d *decl, name string) bool {
+	observed := false
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		id, ok := n.(*ast.Ident)
+		if !ok || id.Name != name {
+			return true
+		}
+		if identIsDeclaration(d.file, id) || identUseIsDiscarded(d.file, id) {
+			return true
+		}
+		observed = true
+		return false
+	})
+	return !observed
+}
+
+// valueDiscarded reports whether the value produced by expr is provably never
+// observed: the expression is a bare statement, it is assigned to a blank
+// identifier, or it is bound to a local variable whose every read is a blank
+// assignment. An expression used as a call argument or an operand is not
+// discarded, so a diagnostic message that merely contains the protocol text is
+// not mistaken for a dropped capability result.
+func valueDiscarded(d *decl, expr ast.Expr) bool {
+	switch parent := d.file.parents[expr].(type) {
+	case *ast.ExprStmt:
+		return true
+	case *ast.AssignStmt:
+		for index, rhs := range parent.Rhs {
+			if rhs != expr {
+				continue
+			}
+			if len(parent.Rhs) == 1 && len(parent.Lhs) > 1 {
+				for _, lhs := range parent.Lhs {
+					if !isBlankIdent(lhs) {
+						return false
+					}
+				}
+				return true
+			}
+			if index >= len(parent.Lhs) {
+				return false
+			}
+			if isBlankIdent(parent.Lhs[index]) {
+				return true
+			}
+			if id, ok := parent.Lhs[index].(*ast.Ident); ok {
+				return localNameDiscarded(d, id.Name)
+			}
+			return false
+		}
+	case *ast.ValueSpec:
+		for index, value := range parent.Values {
+			if value != expr || index >= len(parent.Names) {
+				continue
+			}
+			if parent.Names[index].Name == "_" {
+				return true
+			}
+			return localNameDiscarded(d, parent.Names[index].Name)
+		}
+	}
+	return false
+}
+
+// localBindings maps the names assigned inside a function body to the
+// expression they are bound to. It is used to follow a value from the call
+// that produced it to the place where it is consumed.
+func localBindings(d *decl) map[string]ast.Expr {
+	out := map[string]ast.Expr{}
+	if d.body == nil {
+		return out
+	}
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		switch item := n.(type) {
+		case *ast.AssignStmt:
+			if len(item.Rhs) == len(item.Lhs) {
+				for i, lhs := range item.Lhs {
+					if id, ok := lhs.(*ast.Ident); ok && id.Name != "_" {
+						setBinding(out, id.Name, item.Rhs[i])
+					}
+				}
+			} else if len(item.Rhs) == 1 {
+				for _, lhs := range item.Lhs {
+					if id, ok := lhs.(*ast.Ident); ok && id.Name != "_" {
+						setBinding(out, id.Name, item.Rhs[0])
+					}
+				}
+			}
+		case *ast.ValueSpec:
+			for i, id := range item.Names {
+				if i < len(item.Values) {
+					setBinding(out, id.Name, item.Values[i])
+				} else if len(item.Values) > 0 {
+					setBinding(out, id.Name, item.Values[0])
+				}
+			}
+		case *ast.RangeStmt:
+			if id, ok := item.Value.(*ast.Ident); ok && id.Name != "_" {
+				setBinding(out, id.Name, item.X)
+			}
+		}
+		return true
+	})
+	return out
+}
+
+// cloneSeen copies the identifier guard used by the folding and data-flow
+// walks, so sibling branches cannot block each other.
+func cloneSeen(seen map[string]bool) map[string]bool {
+	out := make(map[string]bool, len(seen))
+	for name, value := range seen {
+		out[name] = value
+	}
+	return out
+}
+
+// foldStrings returns the constant string values that expr can produce,
+// following local bindings, package-level const/var initializers and the
+// string-building calls whose semantics are known (concatenation, Sprintf,
+// QuoteMeta, strings.Join and the String method of a compiled regexp). It
+// returns nil when the value is not statically known.
+func (p *pkg) foldStrings(f *parsedFile, locals map[string]ast.Expr, expr ast.Expr, depth int, seen map[string]bool) []string {
+	if expr == nil || depth > 16 {
+		return nil
+	}
+	if seen == nil {
+		seen = map[string]bool{}
+	}
+	switch v := expr.(type) {
+	case *ast.BasicLit:
+		switch v.Kind {
+		case token.STRING:
+			return []string{unquoteString(v.Value)}
+		case token.INT:
+			if number, err := strconv.ParseInt(v.Value, 0, 64); err == nil {
+				return []string{strconv.FormatInt(number, 10)}
+			}
+			return []string{v.Value}
+		case token.FLOAT:
+			return []string{v.Value}
+		case token.CHAR:
+			return []string{unquoteString(v.Value)}
+		}
+	case *ast.Ident:
+		if v.Name == "_" || seen[v.Name] {
+			return nil
+		}
+		if locals != nil {
+			if bound, ok := locals[v.Name]; ok {
+				seen[v.Name] = true
+				return p.foldStrings(f, locals, bound, depth+1, seen)
+			}
+		}
+		if isImportName(f, v.Name) {
+			return nil
+		}
+		if next := p.decls[v.Name]; next != nil && (next.kind == "const" || next.kind == "var") {
+			seen[v.Name] = true
+			return p.foldStrings(f, nil, next.value, depth+1, seen)
+		}
+	case *ast.ParenExpr:
+		return p.foldStrings(f, locals, v.X, depth+1, seen)
+	case *ast.BinaryExpr:
+		if v.Op != token.ADD {
+			return nil
+		}
+		left := p.foldStrings(f, locals, v.X, depth+1, cloneSeen(seen))
+		right := p.foldStrings(f, locals, v.Y, depth+1, cloneSeen(seen))
+		if len(left) == 0 || len(right) == 0 {
+			return nil
+		}
+		var out []string
+		for _, a := range left {
+			for _, b := range right {
+				out = append(out, a+b)
+				if len(out) > 16 {
+					return nil
+				}
+			}
+		}
+		return out
+	case *ast.CallExpr:
+		return p.foldCall(f, locals, v, depth, seen)
+	}
+	return nil
+}
+
+func (p *pkg) foldCall(f *parsedFile, locals map[string]ast.Expr, call *ast.CallExpr, depth int, seen map[string]bool) []string {
+	switch callName(call) {
+	case "Itoa":
+		if len(call.Args) == 1 && resolveImport(f, callQualifier(call)) == "strconv" {
+			values := p.foldStrings(f, locals, call.Args[0], depth+1, cloneSeen(seen))
+			if len(values) == 1 {
+				if value, err := strconv.Atoi(values[0]); err == nil {
+					return []string{strconv.Itoa(value)}
+				}
+			}
+		}
+
+	case "Sprintf":
+		if len(call.Args) < 1 {
+			return nil
+		}
+		formats := p.foldStrings(f, locals, call.Args[0], depth+1, cloneSeen(seen))
+		if len(formats) == 0 {
+			return nil
+		}
+		var values []string
+		for _, arg := range call.Args[1:] {
+			argValues := p.foldStrings(f, locals, arg, depth+1, cloneSeen(seen))
+			if len(argValues) == 0 {
+				return nil
+			}
+			values = append(values, argValues[0])
+		}
+		var out []string
+		for _, format := range formats {
+			if rendered, ok := renderFormat(format, values); ok {
+				out = append(out, rendered)
+			}
+		}
+		return out
+	case "Sprint", "Sprintln":
+		var out []string
+		for _, arg := range call.Args {
+			argValues := p.foldStrings(f, locals, arg, depth+1, cloneSeen(seen))
+			if len(argValues) == 0 {
+				return nil
+			}
+			if out == nil {
+				out = argValues
+				continue
+			}
+			var next []string
+			for _, a := range out {
+				for _, b := range argValues {
+					next = append(next, a+b)
+				}
+			}
+			out = next
+		}
+		return out
+	case "Join":
+		if len(call.Args) != 2 {
+			return nil
+		}
+		elements := p.foldStringElements(f, locals, call.Args[0], depth+1, seen)
+		separators := p.foldStrings(f, locals, call.Args[1], depth+1, cloneSeen(seen))
+		if elements == nil || len(separators) == 0 {
+			return nil
+		}
+		return []string{strings.Join(elements, separators[0])}
+	case "QuoteMeta":
+		if len(call.Args) == 1 {
+			if values := p.foldStrings(f, locals, call.Args[0], depth+1, cloneSeen(seen)); len(values) > 0 {
+				out := make([]string, 0, len(values))
+				for _, value := range values {
+					out = append(out, regexp.QuoteMeta(value))
+				}
+				return out
+			}
+		}
+	case "MustCompile", "Compile":
+		if len(call.Args) == 1 {
+			return p.foldStrings(f, locals, call.Args[0], depth+1, cloneSeen(seen))
+		}
+	case "String":
+		if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+			return p.regexpPattern(f, locals, sel.X, depth+1, seen)
+		}
+	}
+	return nil
+}
+
+func (p *pkg) foldStringElements(f *parsedFile, locals map[string]ast.Expr, expr ast.Expr, depth int, seen map[string]bool) []string {
+	lit, ok := expr.(*ast.CompositeLit)
+	if !ok {
+		return nil
+	}
+	var out []string
+	for _, element := range lit.Elts {
+		values := p.foldStrings(f, locals, element, depth+1, cloneSeen(seen))
+		if len(values) == 0 {
+			return nil
+		}
+		out = append(out, values[0])
+	}
+	return out
+}
+
+// regexpPattern resolves an expression to the source text of the regexp it
+// holds, following locals, package-level variables and the MustCompile /
+// Compile calls that build them.
+func (p *pkg) regexpPattern(f *parsedFile, locals map[string]ast.Expr, expr ast.Expr, depth int, seen map[string]bool) []string {
+	if expr == nil || depth > 16 {
+		return nil
+	}
+	if seen == nil {
+		seen = map[string]bool{}
+	}
+	switch v := expr.(type) {
+	case *ast.Ident:
+		if v.Name == "_" || seen[v.Name] {
+			return nil
+		}
+		if locals != nil {
+			if bound, ok := locals[v.Name]; ok {
+				seen[v.Name] = true
+				return p.regexpPattern(f, locals, bound, depth+1, seen)
+			}
+		}
+		if isImportName(f, v.Name) {
+			return nil
+		}
+		if next := p.decls[v.Name]; next != nil && (next.kind == "const" || next.kind == "var") {
+			seen[v.Name] = true
+			return p.regexpPattern(f, nil, next.value, depth+1, seen)
+		}
+	case *ast.ParenExpr:
+		return p.regexpPattern(f, locals, v.X, depth+1, seen)
+	case *ast.CallExpr:
+		switch callName(v) {
+		case "MustCompile", "Compile":
+			if len(v.Args) == 1 {
+				return p.foldStrings(f, locals, v.Args[0], depth+1, cloneSeen(seen))
+			}
+		}
+	}
+	return nil
+}
+
+// renderFormat substitutes the known argument values into a constant format
+// string. Only the verbs used by the string-building code of this repository
+// are supported; anything else leaves the value unknown.
+func renderFormat(format string, values []string) (string, bool) {
+	var out strings.Builder
+	argIndex := 0
+	for index := 0; index < len(format); index++ {
+		if format[index] != '%' {
+			out.WriteByte(format[index])
+			continue
+		}
+		if index+1 >= len(format) {
+			return "", false
+		}
+		verb := format[index+1]
+		index++
+		switch verb {
+		case '%':
+			out.WriteByte('%')
+		case 's', 'd', 'v', 'q', 'x', 'X':
+			if argIndex >= len(values) {
+				return "", false
+			}
+			value := values[argIndex]
+			argIndex++
+			if verb == 'q' {
+				out.WriteString(strconv.Quote(value))
+			} else {
+				out.WriteString(value)
+			}
+		default:
+			return "", false
+		}
+	}
+	if argIndex != len(values) {
+		return "", false
+	}
+	return out.String(), true
+}
+
+// returnedExprs returns the expressions whose values are returned by d:
+// explicit return operands and the named results of a bare return. Nested
+// function literals are not followed.
+func returnedExprs(d *decl) []ast.Expr {
+	var out []ast.Expr
+	if d.body == nil {
+		return out
+	}
+	named := namedResultIdents(d)
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		switch item := n.(type) {
+		case *ast.FuncLit:
+			return false
+		case *ast.ReturnStmt:
+			if len(item.Results) == 0 {
+				for _, ident := range named {
+					out = append(out, ident)
+				}
+			} else {
+				out = append(out, item.Results...)
+			}
+		}
+		return true
+	})
+	return out
+}
+
+func namedResultIdents(d *decl) []*ast.Ident {
+	var out []*ast.Ident
+	fn, ok := d.node.(*ast.FuncDecl)
+	if !ok || fn.Type.Results == nil {
+		return out
+	}
+	for _, field := range fn.Type.Results.List {
+		for _, name := range field.Names {
+			if name.Name != "_" {
+				out = append(out, name)
+			}
+		}
+	}
+	return out
+}
+
+func parameterIdent(d *decl, index int) ast.Node {
+	fn, ok := d.node.(*ast.FuncDecl)
+	if !ok || fn.Type.Params == nil {
+		return nil
+	}
+	position := 0
+	for _, field := range fn.Type.Params.List {
+		count := len(field.Names)
+		if count == 0 {
+			count = 1
+		}
+		if index < position+count {
+			if len(field.Names) > 0 {
+				return field.Names[index-position]
+			}
+			return field.Type
+		}
+		position += count
+	}
+	return nil
+}
+
+// paramFlowsToReturn reports whether the value of the parameter at index i of
+// g reaches a value returned by g, following local bindings and the known
+// string-building calls. This is the delegation evidence that lets a private
+// wrapper return the value it was given without accepting wrappers that
+// discard it.
+func (p *pkg) paramFlowsToReturn(g *decl, index int) bool {
+	if g == nil || g.body == nil {
+		return false
+	}
+	param := parameterIdent(g, index)
+	if param == nil {
+		return false
+	}
+	locals := localBindings(g)
+	for _, ret := range returnedExprs(g) {
+		if p.exprDependsOn(g, g.file, locals, ret, param, 0, map[string]bool{}) {
+			return true
+		}
+	}
+	return false
+}
+
+// exprDependsOn reports whether the value of expr depends on the value
+// produced by target, following local bindings, package-level const/var
+// initializers, the known string-building calls and provable same-package
+// delegation through parameters. An argument of an unknown call does not make
+// the call result depend on that argument.
+func (p *pkg) exprDependsOn(d *decl, f *parsedFile, locals map[string]ast.Expr, expr ast.Expr, target ast.Node, depth int, seen map[string]bool) bool {
+	if expr == nil || depth > 16 {
+		return false
+	}
+	if target != nil && expr == target {
+		return true
+	}
+	if seen == nil {
+		seen = map[string]bool{}
+	}
+	switch v := expr.(type) {
+	case *ast.Ident:
+		if v.Name == "_" || seen[v.Name] {
+			return false
+		}
+		if locals != nil {
+			if bound, ok := locals[v.Name]; ok {
+				seen[v.Name] = true
+				return p.exprDependsOn(d, f, locals, bound, target, depth+1, seen)
+			}
+		}
+		if isImportName(f, v.Name) {
+			return false
+		}
+		if next := d.pkg.decls[v.Name]; next != nil && (next.kind == "const" || next.kind == "var") {
+			seen[v.Name] = true
+			return p.exprDependsOn(d, f, nil, next.value, target, depth+1, seen)
+		}
+	case *ast.ParenExpr:
+		return p.exprDependsOn(d, f, locals, v.X, target, depth+1, seen)
+	case *ast.BinaryExpr:
+		return p.exprDependsOn(d, f, locals, v.X, target, depth+1, cloneSeen(seen)) ||
+			p.exprDependsOn(d, f, locals, v.Y, target, depth+1, cloneSeen(seen))
+	case *ast.IndexExpr:
+		return p.exprDependsOn(d, f, locals, v.X, target, depth+1, seen)
+	case *ast.SliceExpr:
+		return p.exprDependsOn(d, f, locals, v.X, target, depth+1, seen)
+	case *ast.StarExpr:
+		return p.exprDependsOn(d, f, locals, v.X, target, depth+1, seen)
+	case *ast.UnaryExpr:
+		return p.exprDependsOn(d, f, locals, v.X, target, depth+1, seen)
+	case *ast.SelectorExpr:
+		return p.exprDependsOn(d, f, locals, v.X, target, depth+1, seen)
+	case *ast.KeyValueExpr:
+		return p.exprDependsOn(d, f, locals, v.Value, target, depth+1, seen)
+	case *ast.CompositeLit:
+		for _, element := range v.Elts {
+			if p.exprDependsOn(d, f, locals, element, target, depth+1, cloneSeen(seen)) {
+				return true
+			}
+		}
+	case *ast.CallExpr:
+		if transparentCall(d, v) {
+			for _, arg := range v.Args {
+				if p.exprDependsOn(d, f, locals, arg, target, depth+1, cloneSeen(seen)) {
+					return true
+				}
+			}
+			return false
+		}
+		if helper := samePackageFunc(d.pkg, v); helper != nil && helper != d {
+			for index, arg := range v.Args {
+				if p.paramFlowsToReturn(helper, index) &&
+					p.exprDependsOn(d, f, locals, arg, target, depth+1, cloneSeen(seen)) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// samePackageFunc resolves a call to a function or method declaration of the
+// same package. Methods are matched by base name, which can only widen the
+// search.
+func samePackageFunc(p *pkg, call *ast.CallExpr) *decl {
+	if call == nil || p == nil {
+		return nil
+	}
+	switch fun := call.Fun.(type) {
+	case *ast.Ident:
+		target := p.decls[fun.Name]
+		if target != nil && (target.kind == "func" || target.kind == "method") {
+			return target
+		}
+	case *ast.SelectorExpr:
+		if _, ok := fun.X.(*ast.Ident); ok {
+			for _, candidate := range p.order {
+				if candidate.kind == "method" && candidate.base == fun.Sel.Name {
+					return candidate
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// returnedIdents returns the local identifiers that carry a value returned by
+// d (directly or through local bindings), including the named results.
+func returnedIdents(d *decl) map[string]bool {
+	out := map[string]bool{}
+	for _, ident := range namedResultIdents(d) {
+		out[ident.Name] = true
+	}
+	locals := localBindings(d)
+	var visit func(expr ast.Expr, depth int)
+	visit = func(expr ast.Expr, depth int) {
+		if expr == nil || depth > 12 {
+			return
+		}
+		switch v := expr.(type) {
+		case *ast.Ident:
+			if v.Name == "_" || out[v.Name] {
+				return
+			}
+			if bound, ok := locals[v.Name]; ok {
+				out[v.Name] = true
+				visit(bound, depth+1)
+			}
+		case *ast.ParenExpr:
+			visit(v.X, depth+1)
+		case *ast.BinaryExpr:
+			visit(v.X, depth+1)
+			visit(v.Y, depth+1)
+		case *ast.CallExpr:
+			visit(v.Fun, depth+1)
+			for _, arg := range v.Args {
+				visit(arg, depth+1)
+			}
+		case *ast.SelectorExpr:
+			visit(v.X, depth+1)
+		case *ast.IndexExpr:
+			visit(v.X, depth+1)
+		case *ast.SliceExpr:
+			visit(v.X, depth+1)
+		case *ast.StarExpr:
+			visit(v.X, depth+1)
+		case *ast.UnaryExpr:
+			visit(v.X, depth+1)
+		case *ast.KeyValueExpr:
+			visit(v.Value, depth+1)
+		case *ast.CompositeLit:
+			for _, element := range v.Elts {
+				visit(element, depth+1)
+			}
+		}
+	}
+	for _, ret := range returnedExprs(d) {
+		visit(ret, 0)
+	}
+	return out
+}
+
+// blockDecidesResult reports whether a block returns a value or assigns one of
+// the identifiers that the enclosing declaration returns, so a condition that
+// guards this block decides an observable result.
+func blockDecidesResult(d *decl, block *ast.BlockStmt) bool {
+	if block == nil {
+		return false
+	}
+	returned := returnedIdents(d)
+	decides := false
+	ast.Inspect(block, func(n ast.Node) bool {
+		if decides {
+			return false
+		}
+		switch item := n.(type) {
+		case *ast.FuncLit:
+			return false
+		case *ast.ReturnStmt:
+			decides = true
+			return false
+		case *ast.AssignStmt:
+			for _, lhs := range item.Lhs {
+				if id, ok := lhs.(*ast.Ident); ok && returned[id.Name] {
+					decides = true
+					return false
+				}
+			}
+		}
+		return true
+	})
+	return decides
+}
+
+// flowsToReturnOrDecision reports whether the value produced by target reaches
+// a value returned by d or decides a branch that returns a value.
+func (p *pkg) flowsToReturnOrDecision(d *decl, target ast.Node) bool {
+	if d == nil || d.body == nil || target == nil {
+		return false
+	}
+	locals := localBindings(d)
+	for _, ret := range returnedExprs(d) {
+		if p.exprDependsOn(d, d.file, locals, ret, target, 0, map[string]bool{}) {
+			return true
+		}
+	}
+	decided := false
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		if decided {
+			return false
+		}
+		switch item := n.(type) {
+		case *ast.FuncLit:
+			return false
+		case *ast.IfStmt:
+			if p.exprDependsOn(d, d.file, locals, item.Cond, target, 0, map[string]bool{}) {
+				if blockDecidesResult(d, item.Body) {
+					decided = true
+					return false
+				}
+				if elseBlock, ok := item.Else.(*ast.BlockStmt); ok && blockDecidesResult(d, elseBlock) {
+					decided = true
+					return false
+				}
+			}
+		case *ast.ForStmt:
+			if item.Cond != nil && p.exprDependsOn(d, d.file, locals, item.Cond, target, 0, map[string]bool{}) &&
+				blockDecidesResult(d, item.Body) {
+				decided = true
+				return false
+			}
+		}
+		return true
+	})
+	return decided
+}
+
+func returnsStringSlice(d *decl) bool {
+	function, ok := d.node.(*ast.FuncDecl)
+	if !ok || function.Type.Results == nil || len(function.Type.Results.List) != 1 {
+		return false
+	}
+	array, ok := function.Type.Results.List[0].Type.(*ast.ArrayType)
+	if !ok || array.Len != nil {
+		return false
+	}
+	element, ok := array.Elt.(*ast.Ident)
+	return ok && element.Name == "string"
+}
+
+func (p *pkg) callFeedsReturnedSlice(d *decl, target ast.Node) bool {
+	if !returnsStringSlice(d) {
+		return p.flowsToReturnOrDecision(d, target)
+	}
+	locals := localBindings(d)
+	for _, result := range returnedExprs(d) {
+		if p.exprDependsOn(d, d.file, locals, result, target, 0, map[string]bool{}) {
+			return true
+		}
+	}
+	return false
+}
+
+// callFlowsIntoReturnOf reports whether a call to helper h inside d feeds a
+// value returned by d (or decides such a return), which makes the helper's
+// own result observable through d.
+func (p *pkg) callFlowsIntoReturnOf(d *decl, h *decl) bool {
+	if d == nil || h == nil || d.body == nil {
+		return false
+	}
+	seen := map[*decl]bool{}
+	var visit func(*decl) bool
+	visit = func(current *decl) bool {
+		if current == nil || current.body == nil || seen[current] {
+			return false
+		}
+		seen[current] = true
+		found := false
+		ast.Inspect(current.body, func(node ast.Node) bool {
+			if found {
+				return false
+			}
+			if _, ok := node.(*ast.FuncLit); ok {
+				return false
+			}
+			if call, ok := node.(*ast.CallExpr); ok {
+				next := samePackageFunc(p, call)
+				if next != nil && p.callFeedsReturnedSlice(current, call) && (next == h || returnsStringSlice(current) && visit(next)) {
+					found = true
+					return false
+				}
+			}
+			return true
+		})
+		return found
+	}
+	return visit(d)
+}
+
+// exactShapePattern reports whether a folded regexp source carries the
+// commit-id prefix together with the exact eight-lowercase-hex identifier
+// shape. A case-tolerant class such as [a-fA-F0-9] or a different repeat count
+// such as {40} does not count.
+func exactShapePattern(pattern string) bool {
+	if !strings.Contains(pattern, "commit-id:") && !strings.Contains(pattern, `commit-id\:`) {
+		return false
+	}
+	found := false
+	for _, match := range hexClassQuantifierPattern.FindAllStringSubmatch(pattern, -1) {
+		if match[2] != "8" {
+			continue
+		}
+		switch match[1] {
+		case "a-f0-9", "0-9a-f":
+			found = true
+		}
+	}
+	return found
+}
+
+// exprCarriesPrefixValue reports whether the expression reaches a value that
+// folds to the commit-id prefix, including partial expressions such as
+// len(CommitIDPrefix) where only a sub-expression is known.
+func (p *pkg) exprCarriesPrefixValue(d *decl, locals map[string]ast.Expr, expr ast.Expr, depth int) bool {
+	if expr == nil || depth > 12 {
+		return false
+	}
+	if folded := p.foldStrings(d.file, locals, expr, 0, nil); len(folded) > 0 {
+		for _, value := range folded {
+			if prefixDefiningLiteral(value) {
+				return true
+			}
+		}
+	}
+	switch v := expr.(type) {
+	case *ast.ParenExpr:
+		return p.exprCarriesPrefixValue(d, locals, v.X, depth+1)
+	case *ast.BinaryExpr:
+		return p.exprCarriesPrefixValue(d, locals, v.X, depth+1) || p.exprCarriesPrefixValue(d, locals, v.Y, depth+1)
+	case *ast.CallExpr:
+		for _, arg := range v.Args {
+			if p.exprCarriesPrefixValue(d, locals, arg, depth+1) {
+				return true
+			}
+		}
+	case *ast.IndexExpr:
+		return p.exprCarriesPrefixValue(d, locals, v.X, depth+1)
+	case *ast.SliceExpr:
+		return p.exprCarriesPrefixValue(d, locals, v.X, depth+1)
+	case *ast.StarExpr:
+		return p.exprCarriesPrefixValue(d, locals, v.X, depth+1)
+	case *ast.UnaryExpr:
+		return p.exprCarriesPrefixValue(d, locals, v.X, depth+1)
+	case *ast.SelectorExpr:
+		return p.exprCarriesPrefixValue(d, locals, v.X, depth+1)
+	}
+	return false
+}
+
+// formatProducingExpr reports whether the expression builds text that carries
+// the protocol prefix, either by concatenation or by a formatting call whose
+// argument carries the prefix. Predicates and other boolean operations are
+// not format evidence.
+func (p *pkg) formatProducingExpr(d *decl, locals map[string]ast.Expr, expr ast.Expr, depth int) bool {
+	if expr == nil || depth > 12 {
+		return false
+	}
+	switch v := expr.(type) {
+	case *ast.Ident:
+		if bound, ok := locals[v.Name]; ok {
+			return p.formatProducingExpr(d, locals, bound, depth+1)
+		}
+	case *ast.ParenExpr:
+		return p.formatProducingExpr(d, locals, v.X, depth+1)
+	case *ast.BinaryExpr:
+		if v.Op != token.ADD {
+			return false
+		}
+		if p.exprCarriesPrefixValue(d, locals, v.X, 0) || p.exprCarriesPrefixValue(d, locals, v.Y, 0) {
+			return true
+		}
+		return p.formatProducingExpr(d, locals, v.X, depth+1) || p.formatProducingExpr(d, locals, v.Y, depth+1)
+	case *ast.CallExpr:
+		if !formatCallees[callName(v)] {
+			return false
+		}
+		for _, arg := range v.Args {
+			if p.exprCarriesPrefixValue(d, locals, arg, 0) {
+				return true
+			}
+		}
+	case *ast.SelectorExpr:
+		return p.formatProducingExpr(d, locals, v.X, depth+1)
+	case *ast.IndexExpr:
+		return p.formatProducingExpr(d, locals, v.X, depth+1)
+	case *ast.SliceExpr:
+		return p.formatProducingExpr(d, locals, v.X, depth+1)
+	case *ast.StarExpr:
+		return p.formatProducingExpr(d, locals, v.X, depth+1)
+	case *ast.UnaryExpr:
+		return p.formatProducingExpr(d, locals, v.X, depth+1)
+	}
+	return false
+}
+
+// splitSeparatorCallees are the calls that take a separator or delimiter and
+// therefore encode a parsing rule when the separator is the protocol colon.
+var splitSeparatorCallees = map[string]bool{
+	"Split":      true,
+	"SplitN":     true,
+	"SplitAfter": true,
+	"Cut":        true,
+	"Index":      true,
+	"IndexAny":   true,
+	"LastIndex":  true,
+}
+
+// privateExtractionEvidence reports a private parsing rule that does not spell
+// out the protocol literal: a split or index operation whose separator is the
+// protocol colon and whose result feeds a returned value or a CommitID field.
+func (p *pkg) privateExtractionEvidence(d *decl) string {
+	if d.body == nil {
+		return ""
+	}
+	locals := localBindings(d)
+	feedsCommitID := commitIDFlowTargets(d)
+	var evidence string
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		if evidence != "" {
+			return false
+		}
+		call, ok := n.(*ast.CallExpr)
+		if !ok || !splitSeparatorCallees[callName(call)] || d.file.isDiscarded(call) {
+			return true
+		}
+		separator := false
+		for _, arg := range call.Args[1:] {
+			if folded := p.foldStrings(d.file, locals, arg, 0, nil); len(folded) > 0 {
+				for _, value := range folded {
+					if strings.Contains(value, ":") {
+						separator = true
+					}
+				}
+			}
+		}
+		if !separator {
+			return true
+		}
+		if p.flowsToReturnOrDecision(d, call) || feedsCommitID[call] {
+			evidence = fmt.Sprintf("%s extracts the identifier with a private split rule %q", d.name, normalizeSpace(sourceOf(d.file, call)))
+			return false
+		}
+		return true
+	})
+	return evidence
+}
+
+// commitIDFlowTargets collects the call expressions that feed a CommitID
+// field assignment or struct-literal value of the declaration.
+func commitIDFlowTargets(d *decl) map[ast.Node]bool {
+	out := map[ast.Node]bool{}
+	if d.body == nil {
+		return out
+	}
+	locals := localBindings(d)
+	add := func(expr ast.Expr) {
+		for _, call := range callsReached(d, locals, expr) {
+			out[call] = true
+		}
+	}
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		switch item := n.(type) {
+		case *ast.AssignStmt:
+			for index, lhs := range item.Lhs {
+				if isCommitIDSelector(lhs) {
+					add(assignmentRHSExpr(item, index))
+				}
+			}
+		case *ast.KeyValueExpr:
+			if id, ok := item.Key.(*ast.Ident); ok && id.Name == "CommitID" {
+				add(item.Value)
+			}
+		}
+		return true
+	})
+	return out
+}
+
+func isCommitIDSelector(expr ast.Expr) bool {
+	sel, ok := expr.(*ast.SelectorExpr)
+	return ok && sel.Sel.Name == "CommitID"
+}
+
+func assignmentRHSExpr(stmt *ast.AssignStmt, index int) ast.Expr {
+	if len(stmt.Rhs) == len(stmt.Lhs) && index < len(stmt.Rhs) {
+		return stmt.Rhs[index]
+	}
+	if len(stmt.Rhs) == 1 {
+		return stmt.Rhs[0]
+	}
+	return nil
+}
+
+// valueClosure walks the value dependencies of a declaration: itself plus
+// every package-level const/var reachable through identifier references in
+// its initializer/body. Function calls are deliberately not followed, so a
+// declaration does not inherit protocol literals merely because it calls some
+// unrelated function that happens to mention the protocol.
+func (p *pkg) valueClosure(d *decl) []*decl {
+	seen := map[*decl]bool{}
+	var out []*decl
+	var visit func(cur *decl)
+	visit = func(cur *decl) {
+		if cur == nil || seen[cur] {
+			return
+		}
+		seen[cur] = true
+		out = append(out, cur)
+		locals := localNames(cur)
+		for name := range cur.idents {
+			if locals[name] || isImportName(cur.file, name) {
+				continue
+			}
+			next := p.decls[name]
+			if next == nil || next == cur {
+				continue
+			}
+			if next.kind == "const" || next.kind == "var" {
+				visit(next)
+			}
+		}
+	}
+	visit(d)
+	return out
+}
+
+// callClosure follows same-package function calls (including method calls
+// resolved by base name) from a declaration.
+func (p *pkg) callClosure(d *decl) []*decl {
+	seen := map[*decl]bool{}
+	var out []*decl
+	var visit func(cur *decl, depth int)
+	visit = func(cur *decl, depth int) {
+		if cur == nil || depth > 3 || seen[cur] {
+			return
+		}
+		seen[cur] = true
+		out = append(out, cur)
+		for _, call := range cur.calls {
+			if call.qual == "" {
+				next := p.decls[call.fnName]
+				if next == nil || next == cur || next.kind != "func" {
+					continue
+				}
+				visit(next, depth+1)
+				continue
+			}
+			// A same-package helper may also be implemented as a method
+			// (for example a private parser type). Follow method calls by
+			// base name so protocol text cannot be hidden behind a
+			// qualified call; name collisions only widen the search.
+			for _, candidate := range p.order {
+				if candidate.kind == "method" && candidate.base == call.fnName && candidate != cur {
+					visit(candidate, depth+1)
+				}
+			}
+		}
+	}
+	visit(d, 0)
+	return out
+}
+
+func (p *pkg) definesPrefix(d *decl) bool {
+	for _, member := range p.valueClosure(d) {
+		for _, lit := range member.literals {
+			if prefixDefiningLiteral(lit) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// evalExpr reports whether the expression reaches a protocol prefix literal
+// and an eight-hex shape literal, following local bindings and package-level
+// const/var initializers.
+func receiverOf(call *ast.CallExpr) ast.Expr {
+	if call == nil {
+		return nil
+	}
+	if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+		return sel.X
+	}
+	return nil
+}
+
+func callQualifier(call *ast.CallExpr) string {
+	if call == nil {
+		return ""
+	}
+	if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+		if id, ok := sel.X.(*ast.Ident); ok {
+			return id.Name
+		}
+	}
+	return ""
+}
+
+func callName(call *ast.CallExpr) string {
+	if call == nil {
+		return ""
+	}
+	switch fun := call.Fun.(type) {
+	case *ast.Ident:
+		return fun.Name
+	case *ast.SelectorExpr:
+		return fun.Sel.Name
+	}
+	return ""
+}
+
+// protocolMatchEvidence reports whether the declaration (or a provable helper
+// it delegates to) compiles a pattern carrying both the commit-id prefix and
+// the exact eight-lowercase-hex shape and applies it with a match call. usable
+// means the match result reaches a returned value or decides one; unconsumed
+// means the match is performed but its result is dropped, which is how a no-op
+// capability is detected. The pattern is folded from the actual expression, so
+// a case-tolerant class, a different repeat count or a discarded match call is
+// not evidence of parsing.
+func (p *pkg) protocolMatchEvidence(d *decl) (usable, unconsumed bool) {
+	prefixPredicate, _ := p.prefixPredicateEvidence(d)
+	prefixSlice, _ := p.prefixSliceEvidence(d)
+	for _, f := range p.callClosure(d) {
+		if f == nil || f.body == nil {
+			continue
+		}
+		if f != d && !p.callFlowsIntoReturnOf(d, f) {
+			continue
+		}
+		locals := localBindings(f)
+		for _, call := range f.calls {
+			if !matchCallees[call.fnName] || !call.used {
+				continue
+			}
+			recv := receiverOf(call.expr)
+			if recv == nil {
+				continue
+			}
+			shaped := false
+			for _, pattern := range p.regexpPattern(f.file, locals, recv, 0, nil) {
+				// A separate shape checker is valid when its used result and
+				// the prefix operation both govern this capability's result.
+				identifierOnly := pattern == "^[a-f0-9]{8}$" || pattern == "^[0-9a-f]{8}$"
+				if exactShapePattern(pattern) || identifierOnly && (prefixPredicate || prefixSlice) {
+					shaped = true
+				}
+			}
+			if !shaped {
+				continue
+			}
+			if p.flowsToReturnOrDecision(f, call.expr) {
+				usable = true
+			} else if valueDiscarded(f, call.expr) {
+				unconsumed = true
+			}
+		}
+	}
+	return usable, unconsumed
+}
+
+// hasProtocolMatchCall reports whether the declaration applies an exact
+// prefix+shape regexp match whose result reaches a value the declaration
+// returns (or decides such a return).
+func (p *pkg) hasProtocolMatchCall(d *decl) bool {
+	usable, _ := p.protocolMatchEvidence(d)
+	return usable
+}
+
+// prefixPredicateEvidence reports whether the declaration consumes the
+// protocol prefix in a string predicate or split call. usable means the
+// predicate result reaches a returned value or decides one; unconsumed means
+// the predicate is evaluated but its result is dropped.
+func (p *pkg) prefixPredicateEvidence(d *decl) (usable, unconsumed bool) {
+	for _, f := range p.callClosure(d) {
+		if f == nil || f.body == nil {
+			continue
+		}
+		if f != d && !p.callFlowsIntoReturnOf(d, f) {
+			continue
+		}
+		locals := localBindings(f)
+		for _, call := range f.calls {
+			if !call.used || !prefixCallees[call.fnName] {
+				continue
+			}
+			operand := false
+			for _, arg := range call.expr.Args {
+				if p.exprCarriesPrefixValue(f, locals, arg, 0) {
+					operand = true
+				}
+			}
+			if recv := receiverOf(call.expr); recv != nil && p.exprCarriesPrefixValue(f, locals, recv, 0) {
+				operand = true
+			}
+			if !operand {
+				continue
+			}
+			if p.flowsToReturnOrDecision(f, call.expr) {
+				usable = true
+			} else if valueDiscarded(f, call.expr) {
+				unconsumed = true
+			}
+		}
+	}
+	return usable, unconsumed
+}
+
+// prefixSliceEvidence reports whether the declaration slices or indexes a line
+// with the protocol prefix, which is how the loose parser obtains the
+// identifier without applying the shape. usable means the extracted value
+// reaches a returned value or decides one; unconsumed means the extraction is
+// performed but its result is dropped.
+func (p *pkg) prefixSliceEvidence(d *decl) (usable, unconsumed bool) {
+	for _, f := range p.callClosure(d) {
+		if f == nil || f.body == nil {
+			continue
+		}
+		if f != d && !p.callFlowsIntoReturnOf(d, f) {
+			continue
+		}
+		locals := localBindings(f)
+		ast.Inspect(f.body, func(n ast.Node) bool {
+			var node ast.Expr
+			var index ast.Expr
+			switch item := n.(type) {
+			case *ast.FuncLit:
+				return false
+			case *ast.SliceExpr:
+				node = item
+				index = item.Low
+			case *ast.IndexExpr:
+				node = item
+				index = item.Index
+			default:
+				return true
+			}
+			if index == nil || !p.exprCarriesPrefixValue(f, locals, index, 0) {
+				return true
+			}
+			if p.flowsToReturnOrDecision(f, node) {
+				usable = true
+			} else if valueDiscarded(f, node) {
+				unconsumed = true
+			}
+			return true
+		})
+	}
+	return usable, unconsumed
+}
+
+// parseEvidence combines the three parse shapes into one report: usable is
+// true when any parse operation result reaches a returned value, unconsumed
+// when any qualifying operation result is dropped.
+func (p *pkg) parseEvidence(d *decl) (usable, unconsumed bool) {
+	matchUsable, matchDropped := p.protocolMatchEvidence(d)
+	predicateUsable, predicateDropped := p.prefixPredicateEvidence(d)
+	sliceUsable, sliceDropped := p.prefixSliceEvidence(d)
+	return matchUsable || predicateUsable || sliceUsable, matchDropped || predicateDropped || sliceDropped
+}
+
+func (p *pkg) hasParseEvidence(d *decl) bool {
+	usable, _ := p.parseEvidence(d)
+	return usable
+}
+
+// formatEvidence reports whether the declaration returns text built from the
+// protocol prefix by concatenation or by a formatting call. usable means the
+// produced text is returned; unconsumed means a format operation built from
+// the prefix is performed but its result is dropped, so a function that builds
+// the text and returns a constant is not evidence of formatting.
+func (p *pkg) formatEvidence(d *decl) (usable, unconsumed bool) {
+	for _, f := range p.callClosure(d) {
+		if f == nil || f.body == nil {
+			continue
+		}
+		if f != d && !p.callFlowsIntoReturnOf(d, f) {
+			continue
+		}
+		locals := localBindings(f)
+		for _, ret := range returnedExprs(f) {
+			if p.formatProducingExpr(f, locals, ret, 0) {
+				usable = true
+			}
+		}
+		for _, call := range f.calls {
+			if !call.used || !formatCallees[call.fnName] {
+				continue
+			}
+			built := false
+			for _, arg := range call.expr.Args {
+				if p.exprCarriesPrefixValue(f, locals, arg, 0) {
+					built = true
+				}
+			}
+			if built && !p.flowsToReturnOrDecision(f, call.expr) && valueDiscarded(f, call.expr) {
+				unconsumed = true
+			}
+		}
+		ast.Inspect(f.body, func(n ast.Node) bool {
+			switch item := n.(type) {
+			case *ast.FuncLit:
+				return false
+			case *ast.BinaryExpr:
+				if item.Op == token.ADD && p.exprCarriesPrefixValue(f, locals, item, 0) && !p.flowsToReturnOrDecision(f, item) && valueDiscarded(f, item) {
+					unconsumed = true
+				}
+			}
+			return true
+		})
+	}
+	return usable, unconsumed
+}
+
+func (p *pkg) hasFormatterEvidence(d *decl) bool {
+	usable, _ := p.formatEvidence(d)
+	return usable
+}
+
+// brokenCapabilityNames returns the exported prefix-defining functions that
+// perform a parse or format operation whose result is dropped. Such a
+// declaration looks like the shared capability but produces nothing, so it can
+// neither satisfy the capability contract nor be offered to consumers.
+// claimsCapabilityOperation reports whether the declaration defines the
+// protocol prefix and performs (or attempts) a parse or format operation, so
+// it is a commit-id capability rather than an unrelated exported function
+// whose call graph merely mentions the prefix.
+func (p *pkg) claimsCapabilityOperation(d *decl) bool {
+	if d == nil || !p.definesPrefix(d) {
+		return false
+	}
+	parseUsable, parseDropped := p.parseEvidence(d)
+	formatUsable, formatDropped := p.formatEvidence(d)
+	return parseUsable || parseDropped || formatUsable || formatDropped
+}
+
+func brokenCapabilityNames(g *pkg) []string {
+	var out []string
+	for _, d := range g.order {
+		if d.kind != "func" || d.recv != "" || !d.exported || !g.claimsCapabilityOperation(d) {
+			continue
+		}
+		parseUsable, parseDropped := g.parseEvidence(d)
+		formatUsable, formatDropped := g.formatEvidence(d)
+		if parseDropped && !parseUsable {
+			out = append(out, d.name+" (parse result dropped)")
+		}
+		if formatDropped && !formatUsable {
+			out = append(out, d.name+" (format result dropped)")
+		}
+	}
+	return uniqueSorted(out)
+}
+
+// gitCapabilityFuncs returns the exported package-level functions of the git
+// package that actually define the protocol prefix and perform a parse or a
+// format operation.
+func gitCapabilityFuncs(g *pkg) []*decl {
+	out := append(gitParseCapabilityFuncs(g), gitFormatCapabilityFuncs(g)...)
+	return out
+}
+
+// gitParseCapabilityFuncs returns the exported prefix-defining functions whose
+// parse operation result reaches their own return value.
+func gitParseCapabilityFuncs(g *pkg) []*decl {
+	var out []*decl
+	for _, d := range g.order {
+		if d.kind != "func" || d.recv != "" || !d.exported {
+			continue
+		}
+		if !g.definesPrefix(d) {
+			continue
+		}
+		if g.hasParseEvidence(d) {
+			out = append(out, d)
+		}
+	}
+	return out
+}
+
+// gitFormatCapabilityFuncs returns the exported prefix-defining functions
+// whose returned text is built from the prefix.
+func gitFormatCapabilityFuncs(g *pkg) []*decl {
+	var out []*decl
+	for _, d := range g.order {
+		if d.kind != "func" || d.recv != "" || !d.exported {
+			continue
+		}
+		if !g.definesPrefix(d) {
+			continue
+		}
+		if g.hasFormatterEvidence(d) {
+			out = append(out, d)
+		}
+	}
+	return out
+}
+
+// foldsToPrefix reports whether the declaration's value folds to the protocol
+// prefix text (the bare token or the colon form). Only such declarations can
+// be the single shared source of the protocol.
+func (p *pkg) foldsToPrefix(d *decl) bool {
+	if d == nil || d.value == nil {
+		return false
+	}
+	for _, value := range p.foldStrings(d.file, nil, d.value, 0, nil) {
+		if prefixDefiningLiteral(value) {
+			return true
+		}
+	}
+	return false
+}
+
+// controllingConditions returns the conditions of the branches that decide a
+// returned value of d, so the values read only to make that decision are part
+// of the observable behavior of d.
+func controllingConditions(d *decl) []ast.Expr {
+	var out []ast.Expr
+	if d.body == nil {
+		return out
+	}
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		switch item := n.(type) {
+		case *ast.FuncLit:
+			return false
+		case *ast.IfStmt:
+			decides := blockDecidesResult(d, item.Body)
+			if elseBlock, ok := item.Else.(*ast.BlockStmt); ok && blockDecidesResult(d, elseBlock) {
+				decides = true
+			}
+			if decides {
+				out = append(out, item.Cond)
+			}
+		case *ast.ForStmt:
+			if item.Cond != nil && blockDecidesResult(d, item.Body) {
+				out = append(out, item.Cond)
+			}
+		}
+		return true
+	})
+	return out
+}
+
+// valueFeedingSources returns the package-level const/var names whose values
+// feed the returned values of d (or the branches that decide them), following
+// local bindings and package-level initializers. A blank reference such as
+// `_ = CommitIDPrefix` does not feed any value and is therefore not a source.
+func (p *pkg) valueFeedingSources(d *decl) map[string]bool {
+	out := map[string]bool{}
+	if d == nil || d.body == nil {
+		return out
+	}
+	seen := map[string]bool{}
+	locals := localBindings(d)
+	var visit func(expr ast.Expr, depth int)
+	visit = func(expr ast.Expr, depth int) {
+		if expr == nil || depth > 12 {
+			return
+		}
+		switch v := expr.(type) {
+		case *ast.Ident:
+			if v.Name == "_" || seen[v.Name] {
+				return
+			}
+			if bound, ok := locals[v.Name]; ok {
+				seen[v.Name] = true
+				visit(bound, depth+1)
+				return
+			}
+			if isImportName(d.file, v.Name) {
+				return
+			}
+			if target := p.decls[v.Name]; target != nil && (target.kind == "const" || target.kind == "var") {
+				out[v.Name] = true
+				seen[v.Name] = true
+				visit(target.value, depth+1)
+			}
+		case *ast.ParenExpr:
+			visit(v.X, depth+1)
+		case *ast.BinaryExpr:
+			visit(v.X, depth+1)
+			visit(v.Y, depth+1)
+		case *ast.CallExpr:
+			visit(v.Fun, depth+1)
+			for _, arg := range v.Args {
+				visit(arg, depth+1)
+			}
+		case *ast.SelectorExpr:
+			visit(v.X, depth+1)
+		case *ast.IndexExpr:
+			visit(v.X, depth+1)
+		case *ast.SliceExpr:
+			visit(v.X, depth+1)
+			visit(v.Low, depth+1)
+			visit(v.High, depth+1)
+		case *ast.StarExpr:
+			visit(v.X, depth+1)
+		case *ast.UnaryExpr:
+			visit(v.X, depth+1)
+		case *ast.KeyValueExpr:
+			visit(v.Value, depth+1)
+		case *ast.CompositeLit:
+			for _, element := range v.Elts {
+				visit(element, depth+1)
+			}
+		}
+	}
+	for _, ret := range returnedExprs(d) {
+		visit(ret, 0)
+	}
+	for _, cond := range controllingConditions(d) {
+		visit(cond, 0)
+	}
+	return out
+}
+
+// prefixSourceNames returns the package-level const/var declarations that both
+// define the protocol prefix and feed the observable behavior of target. A
+// declaration that is only blank-referenced, or that merely contains the
+// literal without feeding the parse/format result, is not a source.
+func prefixSourceNames(g *pkg, target *decl) map[string]bool {
+	out := map[string]bool{}
+	if target == nil {
+		return out
+	}
+	if target.kind == "const" || target.kind == "var" {
+		if g.foldsToPrefix(target) {
+			out[target.name] = true
+		}
+		return out
+	}
+	for _, helper := range g.callClosure(target) {
+		if helper != target && !g.callFlowsIntoReturnOf(target, helper) {
+			continue
+		}
+		for name := range g.valueFeedingSources(helper) {
+			member := g.decls[name]
+			if member != nil && (member.kind == "const" || member.kind == "var") && g.foldsToPrefix(member) {
+				out[name] = true
+			}
+		}
+	}
+	return out
+}
+
+// capabilityTarget resolves a call expression to an exported git capability
+// function: a same-package call when site lives in package git, or a selector
+// call whose qualifier resolves to the git import otherwise.
+func capabilityTarget(m *repoModel, g *pkg, site *decl, call *ast.CallExpr) *decl {
+	if call == nil {
+		return nil
+	}
+	switch fun := call.Fun.(type) {
+	case *ast.Ident:
+		if site.pkg != g {
+			return nil
+		}
+		target := g.decls[fun.Name]
+		if target != nil && target.kind == "func" && target.recv == "" && target.exported {
+			return target
+		}
+	case *ast.SelectorExpr:
+		qual, ok := fun.X.(*ast.Ident)
+		if !ok || resolveImport(site.file, qual.Name) != gitImportPath {
+			return nil
+		}
+		target := g.decls[fun.Sel.Name]
+		if target != nil && target.kind == "func" && target.recv == "" && target.exported {
+			return target
+		}
+	}
+	return nil
+}
+
+// capabilityCallsResolved resolves a used call to an exported git capability
+// function, following provable delegation: a same-package helper that is
+// called (with its result consumed) and itself calls the capability also
+// counts, so an implementation that wraps the shared API behind a private
+// helper is accepted. The helper's own calls must be used as well.
+func capabilityCallsResolved(m *repoModel, g *pkg, owner *decl, call *ast.CallExpr, depth int, seen map[*decl]bool) []*decl {
+	if call == nil || owner.file.isDiscarded(call) {
+		return nil
+	}
+	return exprOrigins(m, g, owner, localBindings(owner), call, depth, seen)
+}
+
+// exprOrigins returns the exported git capability functions whose results
+// contribute to the value of expr. It follows local bindings, the known
+// string-building calls and provable same-package delegation: a helper that
+// returns the value it was given carries the argument origins, and a helper
+// that returns a capability call carries that capability. An argument of an
+// unknown wrapper does not make the wrapper result originate from that
+// argument.
+func exprOrigins(m *repoModel, g *pkg, site *decl, locals map[string]ast.Expr, expr ast.Expr, depth int, seen map[*decl]bool) []*decl {
+	if expr == nil || depth > 12 {
+		return nil
+	}
+	if seen == nil {
+		seen = map[*decl]bool{}
+	}
+	var out []*decl
+	add := func(targets []*decl) {
+		for _, target := range targets {
+			if target != nil {
+				out = append(out, target)
+			}
+		}
+	}
+	switch v := expr.(type) {
+	case *ast.Ident:
+		if v.Name == "_" {
+			return nil
+		}
+		if bound, ok := locals[v.Name]; ok {
+			return exprOrigins(m, g, site, locals, bound, depth+1, seen)
+		}
+	case *ast.ParenExpr:
+		return exprOrigins(m, g, site, locals, v.X, depth+1, seen)
+	case *ast.BinaryExpr:
+		add(exprOrigins(m, g, site, locals, v.X, depth+1, cloneDeclSet(seen)))
+		add(exprOrigins(m, g, site, locals, v.Y, depth+1, cloneDeclSet(seen)))
+	case *ast.IndexExpr:
+		add(exprOrigins(m, g, site, locals, v.X, depth+1, seen))
+	case *ast.SliceExpr:
+		add(exprOrigins(m, g, site, locals, v.X, depth+1, seen))
+	case *ast.StarExpr:
+		add(exprOrigins(m, g, site, locals, v.X, depth+1, seen))
+	case *ast.UnaryExpr:
+		add(exprOrigins(m, g, site, locals, v.X, depth+1, seen))
+	case *ast.SelectorExpr:
+		add(exprOrigins(m, g, site, locals, v.X, depth+1, seen))
+	case *ast.KeyValueExpr:
+		add(exprOrigins(m, g, site, locals, v.Value, depth+1, seen))
+	case *ast.CompositeLit:
+		for _, element := range v.Elts {
+			add(exprOrigins(m, g, site, locals, element, depth+1, cloneDeclSet(seen)))
+		}
+	case *ast.CallExpr:
+		if target := capabilityTarget(m, g, site, v); target != nil {
+			if !site.file.isDiscarded(v) {
+				add([]*decl{target})
+			}
+		}
+		if helper := samePackageFunc(site.pkg, v); helper != nil && helper != site && !seen[helper] {
+			seen[helper] = true
+			helperLocals := localBindings(helper)
+			for _, ret := range returnedExprs(helper) {
+				add(exprOrigins(m, g, helper, helperLocals, ret, depth+1, cloneDeclSet(seen)))
+			}
+			for index, arg := range v.Args {
+				if site.pkg.paramFlowsToReturn(helper, index) {
+					add(exprOrigins(m, g, site, locals, arg, depth+1, cloneDeclSet(seen)))
+				}
+			}
+		} else if transparentCall(site, v) {
+			for _, arg := range v.Args {
+				add(exprOrigins(m, g, site, locals, arg, depth+1, cloneDeclSet(seen)))
+			}
+		}
+	}
+	return out
+}
+
+func cloneDeclSet(seen map[*decl]bool) map[*decl]bool {
+	out := make(map[*decl]bool, len(seen))
+	for target, value := range seen {
+		out[target] = value
+	}
+	return out
+}
+
+// callsReached collects every call expression reachable from expr by
+// following local variable bindings.
+func callsReached(site *decl, locals map[string]ast.Expr, expr ast.Expr) []*ast.CallExpr {
+	var out []*ast.CallExpr
+	seen := map[string]bool{}
+	var walk func(e ast.Expr, depth int)
+	walk = func(e ast.Expr, depth int) {
+		if e == nil || depth > 12 {
+			return
+		}
+		switch v := e.(type) {
+		case *ast.CallExpr:
+			out = append(out, v)
+			walk(v.Fun, depth+1)
+			for _, arg := range v.Args {
+				walk(arg, depth+1)
+			}
+		case *ast.Ident:
+			if v.Name == "_" || seen[v.Name] {
+				return
+			}
+			if bound, ok := locals[v.Name]; ok {
+				seen[v.Name] = true
+				walk(bound, depth+1)
+			}
+		case *ast.ParenExpr:
+			walk(v.X, depth+1)
+		case *ast.BinaryExpr:
+			walk(v.X, depth+1)
+			walk(v.Y, depth+1)
+		case *ast.SelectorExpr:
+			walk(v.X, depth+1)
+		case *ast.IndexExpr:
+			walk(v.X, depth+1)
+		case *ast.SliceExpr:
+			walk(v.X, depth+1)
+		case *ast.StarExpr:
+			walk(v.X, depth+1)
+		case *ast.UnaryExpr:
+			walk(v.X, depth+1)
+		case *ast.CompositeLit:
+			for _, elt := range v.Elts {
+				walk(elt, depth+1)
+			}
+		case *ast.KeyValueExpr:
+			walk(v.Value, depth+1)
+		}
+	}
+	walk(expr, 0)
+	return out
+}
+
+func resolveImport(f *parsedFile, qualifier string) string {
+	if f == nil {
+		return ""
+	}
+	return f.imports[qualifier]
+}
+
+func joinComma(values []string) string {
+	return strings.Join(values, ", ")
+}
+
+func uniqueSorted(values []string) []string {
+	seen := map[string]bool{}
+	var out []string
+	for _, value := range values {
+		if !seen[value] {
+			seen[value] = true
+			out = append(out, value)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func names(decls []*decl) []string {
+	var out []string
+	for _, d := range decls {
+		out = append(out, d.pkg.dir+":"+d.name)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func structFieldTypes(d *decl) map[string]string {
+	out := map[string]string{}
+	if d == nil || d.typeSpec == nil {
+		return out
+	}
+	structType, ok := d.typeSpec.Type.(*ast.StructType)
+	if !ok {
+		return out
+	}
+	for _, field := range structType.Fields.List {
+		typeText := normalizeSpace(sourceOf(d.file, field.Type))
+		for _, name := range field.Names {
+			out[name.Name] = typeText
+		}
+	}
+	return out
+}
+
+// interfaceMethods returns the declared method name -> signature of an
+// interface type. Embedded interfaces are returned under their type name with
+// an empty signature.
+func interfaceMethods(d *decl) map[string]string {
+	out := map[string]string{}
+	if d == nil || d.typeSpec == nil {
+		return out
+	}
+	iface, ok := d.typeSpec.Type.(*ast.InterfaceType)
+	if !ok {
+		return out
+	}
+	for _, field := range iface.Methods.List {
+		if len(field.Names) == 0 {
+			out[normalizeSpace(sourceOf(d.file, field.Type))] = ""
+			continue
+		}
+		signature := normalizeSpace(sourceBetween(d.file, field.Names[0].Pos(), field.Type.End()))
+		for _, name := range field.Names {
+			out[name.Name] = signature
+		}
+	}
+	return out
+}
+
+func TestCapabilitySliceResultFlow(t *testing.T) {
+	makePackage := func(name, source string, imports map[string]string) *pkg {
+		t.Helper()
+		fset := token.NewFileSet()
+		file, err := parser.ParseFile(fset, name+".go", source, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		parsed := &parsedFile{rel: name + ".go", pkgName: name, file: file, src: []byte(source), fset: fset, imports: imports, parents: buildParents(file)}
+		result := &pkg{name: name, decls: map[string]*decl{}, files: []*parsedFile{parsed}}
+		buildPackageDecls(result)
+		return result
+	}
+	g := makePackage("git", `package git
+import "strings"
+const Prefix = "commit-id:"
+func HasPrefix(line string) bool { return strings.HasPrefix(line, Prefix) }
+func Parse(line string) (string, bool) {
+	if !HasPrefix(line) { return "", false }
+	return strings.Split(line, ":")[1], true
+}
+func ParseMany(body string) []string {
+	ids := []string{}
+	for _, line := range strings.Split(body, "\n") {
+		if id, ok := Parse(line); ok { ids = append(ids, id) }
+	}
+	return ids
+}
+func Ignore(body string) []string { _, _ = Parse(body); return []string{"fixed"} }
+func Shadow(body string) []string {
+	append := func(ids []string, id string) []string { return []string{"fixed"} }
+	ids := []string{}
+	id, _ := Parse(body)
+	ids = append(ids, id)
+	return ids
+}
+func DecisionOnly(body string) []string {
+	ids := []string{}
+	if _, ok := Parse(body); ok { ids = append(ids, "fixed") }
+	return ids
+}`, nil)
+	client := makePackage("client", `package client
+import "github.com/ejoffe/spr/git"
+func Values(body string) { for _, id := range git.ParseMany(body) { _ = git.Commit{CommitID: id} } }
+func Index(body string) { for index := range git.ParseMany(body) { _ = git.Commit{CommitID: index} } }
+func Discard(body string) { for _, id := range git.ParseMany(body) { _ = id; _ = git.Commit{CommitID: "fixed"} } }
+func IgnoredHelper(body string) { for _, id := range git.Ignore(body) { _ = git.Commit{CommitID: id} } }
+func ShadowedAppend(body string) { for _, id := range git.Shadow(body) { _ = git.Commit{CommitID: id} } }
+func ConditionalOnly(body string) { for _, id := range git.DecisionOnly(body) { _ = git.Commit{CommitID: id} } }
+`, map[string]string{"git": gitImportPath})
+	model := &repoModel{pkgs: map[string]*pkg{"git": g, "client": client}}
+	for _, test := range []struct {
+		name string
+		want bool
+	}{
+		{"Values", true},
+		{"Index", false},
+		{"Discard", false},
+		{"IgnoredHelper", false},
+		{"ShadowedAppend", false},
+		{"ConditionalOnly", false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			targets := parseTargets(model, g, client.decls[test.name])
+			if (len(targets) > 0) != test.want {
+				t.Fatalf("parse target found = %t, want %t", len(targets) > 0, test.want)
+			}
+			if test.want && !prefixCarryingSources(g, targets)["Prefix"] {
+				t.Fatal("parsed values do not trace back to the shared prefix")
+			}
+		})
+	}
+}
