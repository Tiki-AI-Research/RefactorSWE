index 0000000000000000000000000000000000000000..8a70c30345475b306052ba93e4b258432a19fd91
--- /dev/null
+++ b/cmd/reword/p2p_reword_regression_test.go
@@ -0,0 +1,224 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// These tests exercise the external editor-helper contract of the
+// spr_reword_helper binary instead of internal functions, so the written
+// bytes stay pinned while the implementation is free to move.
+
+func p2pRepoRoot(t *testing.T) string {
+	t.Helper()
+	dir, err := os.Getwd()
+	require.NoError(t, err)
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		require.NotEqual(t, parent, dir, "go.mod not found above %s", dir)
+		dir = parent
+	}
+}
+
+func p2pGoBinary(t *testing.T) string {
+	t.Helper()
+	if path, err := exec.LookPath("go"); err == nil {
+		return path
+	}
+	for _, candidate := range []string{
+		"/opt/envpipe/runtime/bin/go",
+		"/usr/local/go/bin/go",
+		"/usr/lib/go/bin/go",
+	} {
+		if info, err := os.Stat(candidate); err == nil && !info.IsDir() {
+			return candidate
+		}
+	}
+	t.Fatalf("go toolchain not found on PATH")
+	return ""
+}
+
+func p2pBuildRewordHelper(t *testing.T) string {
+	t.Helper()
+	root := p2pRepoRoot(t)
+
+	execDir := os.Getenv("VERIFIER_EXEC_DIR")
+	if execDir == "" || os.MkdirAll(execDir, 0o755) != nil {
+		execDir = t.TempDir()
+	}
+
+	name := fmt.Sprintf("spr_reword_helper_%d_%s", os.Getpid(),
+		strings.NewReplacer("/", "_", "\\", "_").Replace(t.Name()))
+	binary, err := filepath.Abs(filepath.Join(execDir, name))
+	require.NoError(t, err)
+
+	cmd := exec.Command(p2pGoBinary(t), "build", "-o", binary, "./cmd/reword")
+	cmd.Dir = root
+	cmd.Env = os.Environ()
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("building spr_reword_helper failed: %v\n%s", err, out)
+	}
+	return binary
+}
+
+func p2pGitEnv() []string {
+	return append(os.Environ(),
+		"GIT_CONFIG_GLOBAL=/dev/null",
+		"GIT_CONFIG_SYSTEM=/dev/null",
+		"GIT_AUTHOR_NAME=p2p",
+		"GIT_AUTHOR_EMAIL=p2p@example.com",
+		"GIT_COMMITTER_NAME=p2p",
+		"GIT_COMMITTER_EMAIL=p2p@example.com",
+	)
+}
+
+func p2pNewGitRepo(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	cmd := exec.Command("git", "init", "-q")
+	cmd.Dir = dir
+	cmd.Env = p2pGitEnv()
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("git init failed: %v\n%s", err, out)
+	}
+	return dir
+}
+
+func p2pRunGit(t *testing.T, dir string, args ...string) string {
+	t.Helper()
+	cmd := exec.Command("git", args...)
+	cmd.Dir = dir
+	cmd.Env = p2pGitEnv()
+	out, err := cmd.CombinedOutput()
+	require.NoError(t, err, "git %v failed: %s", args, out)
+	return strings.TrimSpace(string(out))
+}
+
+func p2pRunRewordHelper(t *testing.T, binary string, dir string, args ...string) {
+	t.Helper()
+	cmd := exec.Command(binary, args...)
+	cmd.Dir = dir
+	cmd.Env = p2pGitEnv()
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("spr_reword_helper %v failed: %v\n%s", args, err, out)
+	}
+}
+
+func p2pWriteFile(t *testing.T, path string, content string) {
+	t.Helper()
+	require.NoError(t, os.WriteFile(path, []byte(content), 0o644))
+}
+
+func p2pReadFile(t *testing.T, path string) string {
+	t.Helper()
+	content, err := os.ReadFile(path)
+	require.NoError(t, err)
+	return string(content)
+}
+
+// TestRewordHelperAppendsCommitIDToSingleLineMessage pins the extra newline
+// written for single-line messages plus the exact appended identifier line.
+func TestRewordHelperAppendsCommitIDToSingleLineMessage(t *testing.T) {
+	binary := p2pBuildRewordHelper(t)
+	repo := p2pNewGitRepo(t)
+	messageFile := filepath.Join(repo, "COMMIT_EDITMSG")
+	p2pWriteFile(t, messageFile, "Supergalactic speed")
+
+	p2pRunRewordHelper(t, binary, repo, messageFile)
+
+	content := p2pReadFile(t, messageFile)
+	assert.Regexp(t, regexp.MustCompile(`\ASupergalactic speed\n\ncommit-id:[0-9a-f]{8}\n\z`), content)
+	assert.Equal(t, 1, strings.Count(content, "commit-id:"))
+}
+
+// TestRewordHelperAppendsCommitIDToMultiLineMessage pins the appended line for
+// a message that already has a body.
+func TestRewordHelperAppendsCommitIDToMultiLineMessage(t *testing.T) {
+	binary := p2pBuildRewordHelper(t)
+	repo := p2pNewGitRepo(t)
+	messageFile := filepath.Join(repo, "COMMIT_EDITMSG")
+	p2pWriteFile(t, messageFile, "Supergalactic speed\n\nSuper universe body.\n")
+
+	p2pRunRewordHelper(t, binary, repo, messageFile)
+
+	content := p2pReadFile(t, messageFile)
+	assert.Regexp(t, regexp.MustCompile(`\ASupergalactic speed\n\nSuper universe body\.\n\ncommit-id:[0-9a-f]{8}\n\z`), content)
+	assert.Equal(t, 1, strings.Count(content, "commit-id:"))
+}
+
+// TestRewordHelperLeavesFileWithExistingCommitIDUnchanged pins that a file
+// that already contains a commit-id line is not touched at all.
+func TestRewordHelperLeavesFileWithExistingCommitIDUnchanged(t *testing.T) {
+	binary := p2pBuildRewordHelper(t)
+	repo := p2pNewGitRepo(t)
+	messageFile := filepath.Join(repo, "COMMIT_EDITMSG")
+	original := "Supergalactic speed\n\ncommit-id:deadbeef\n"
+	p2pWriteFile(t, messageFile, original)
+
+	p2pRunRewordHelper(t, binary, repo, messageFile)
+
+	assert.Equal(t, original, p2pReadFile(t, messageFile))
+}
+
+// TestRewordHelperLeavesEmptyMessageUnchanged pins that an empty message is
+// left untouched.
+func TestRewordHelperLeavesEmptyMessageUnchanged(t *testing.T) {
+	binary := p2pBuildRewordHelper(t)
+	repo := p2pNewGitRepo(t)
+	messageFile := filepath.Join(repo, "COMMIT_EDITMSG")
+	p2pWriteFile(t, messageFile, "")
+
+	p2pRunRewordHelper(t, binary, repo, messageFile)
+
+	assert.Equal(t, "", p2pReadFile(t, messageFile))
+}
+
+// TestRewordHelperLeavesCommentOnlyMessageUnchanged pins that a message with
+// no content other than comments is left untouched.
+func TestRewordHelperLeavesCommentOnlyMessageUnchanged(t *testing.T) {
+	binary := p2pBuildRewordHelper(t)
+	repo := p2pNewGitRepo(t)
+	messageFile := filepath.Join(repo, "COMMIT_EDITMSG")
+	original := "# Please enter the commit message for your changes.\n#\n# On branch master\n"
+	p2pWriteFile(t, messageFile, original)
+
+	p2pRunRewordHelper(t, binary, repo, messageFile)
+
+	assert.Equal(t, original, p2pReadFile(t, messageFile))
+}
+
+// TestRewordHelperRewritesOnlyPickEntriesWithoutCommitID pins the rebase-todo
+// behavior: pick entries whose commit message lacks commit-id text become
+// reword entries, while picks that already have an identifier and non-pick
+// entries stay as they are.
+func TestRewordHelperRewritesOnlyPickEntriesWithoutCommitID(t *testing.T) {
+	binary := p2pBuildRewordHelper(t)
+	repo := p2pNewGitRepo(t)
+
+	p2pRunGit(t, repo, "commit", "-q", "--allow-empty", "-m", "First subject", "-m", "commit-id:aaaaaaaa")
+	withID := p2pRunGit(t, repo, "rev-parse", "HEAD")
+	p2pRunGit(t, repo, "commit", "-q", "--allow-empty", "-m", "Second subject")
+	withoutID := p2pRunGit(t, repo, "rev-parse", "HEAD")
+
+	todoFile := filepath.Join(repo, "git-rebase-todo")
+	todo := fmt.Sprintf("pick %s First subject\npick %s Second subject\nreword %s Third subject\n",
+		withID, withoutID, withID)
+	p2pWriteFile(t, todoFile, todo)
+
+	p2pRunRewordHelper(t, binary, repo, todoFile)
+
+	expected := fmt.Sprintf("pick %s First subject\nreword %s Second subject\nreword %s Third subject\n",
+		withID, withoutID, withID)
+	assert.Equal(t, expected, p2pReadFile(t, todoFile))
+}
