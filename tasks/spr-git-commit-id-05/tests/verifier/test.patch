+package githubclient
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/ejoffe/spr/config"
+	"github.com/ejoffe/spr/git"
+	"github.com/ejoffe/spr/github/githubclient/fezzik_types"
+	"github.com/ejoffe/spr/github/githubclient/gen/genclient"
+	"github.com/stretchr/testify/require"
+)
+
+// TestMatchPullRequestStackGraphQLTolerance pins the GraphQL message-body
+// tolerance: only lines that start with the commit-id prefix are matched, and
+// the value after the first colon is taken up to the next colon or the end of
+// the line verbatim. The eight-lowercase-hex and whitespace rules of the local
+// commit log are not applied, so whitespace, non-hex and empty values are kept
+// as they are.
+func TestMatchPullRequestStackGraphQLTolerance(t *testing.T) {
+	messageBody := "commit-id:1:second\n" +
+		"commit-id: 00000009\n" +
+		" commit-id:indented\n" +
+		"commit-id:not-hex\n" +
+		"commit-id:\n" +
+		"body text commit-id:middle\n"
+
+	prs := fezzik_types.PullRequestConnection{
+		Nodes: &fezzik_types.PullRequestsViewerPullRequestsNodes{
+			{
+				Id:          "1",
+				HeadRefName: "spr/master/00000001",
+				BaseRefName: "master",
+				Commits: fezzik_types.PullRequestsViewerPullRequestsNodesCommits{
+					Nodes: &fezzik_types.PullRequestsViewerPullRequestsNodesCommitsNodes{
+						{
+							fezzik_types.PullRequestsViewerPullRequestsNodesCommitsNodesCommit{
+								Oid:             "oid1",
+								MessageHeadline: "headline",
+								MessageBody:     messageBody,
+							},
+						},
+					},
+				},
+			},
+		},
+	}
+
+	actual := matchPullRequestStack(&config.RepoConfig{}, "spr", "master",
+		[]git.Commit{{CommitID: "00000001"}}, prs)
+
+	require.Len(t, actual, 1)
+	require.Equal(t, []git.Commit{
+		{CommitID: "1", CommitHash: "oid1", Subject: "headline", Body: messageBody},
+		{CommitID: " 00000009", CommitHash: "oid1", Subject: "headline", Body: messageBody},
+		{CommitID: "not-hex", CommitHash: "oid1", Subject: "headline", Body: messageBody},
+		{CommitID: "", CommitHash: "oid1", Subject: "headline", Body: messageBody},
+	}, actual[0].Commits)
+}
+
+type p2pPrefixAPI struct {
+	genclient.Client
+	response *genclient.PullRequestsResponse
+}
+
+func (a *p2pPrefixAPI) PullRequests(context.Context, string, string) (*genclient.PullRequestsResponse, error) {
+	return a.response, nil
+}
+
+type p2pPrefixGit struct {
+	git.GitInterface
+	logText string
+}
+
+func (g *p2pPrefixGit) MustGit(args string, output *string) {
+	if strings.HasPrefix(args, "log ") && output != nil {
+		*output = g.logText
+	}
+}
+
+func (g *p2pPrefixGit) Git(args string, output *string) error {
+	if strings.HasPrefix(args, "branch ") && output != nil {
+		*output = "* feature\n"
+	}
+	return nil
+}
+
+// The configured prefix controls both remote heads and links between PRs.
+func TestGetInfoMatchesConfiguredBranchPrefix(t *testing.T) {
+	cfg := config.EmptyConfig()
+	cfg.User.BranchPrefix = "team.review"
+	cfg.Repo.GitHubRemote = "origin"
+	cfg.Repo.GitHubBranch = "master"
+	const bottomBranch = "team.review/master/00000001"
+	const topBranch = "team.review/master/00000002"
+	const bottomHash = "c100000000000000000000000000000000000000"
+	const topHash = "c200000000000000000000000000000000000000"
+	nodes := fezzik_types.PullRequestsViewerPullRequestsNodes{}
+	// Supply the remote records in reverse order to exercise stack ordering.
+	for _, entry := range []struct{ id, head, base, hash, subject string }{
+		{"00000002", topBranch, bottomBranch, "remote2", "second"},
+		{"00000001", bottomBranch, "master", "remote1", "first"},
+		{"00000002", "spr/master/00000002", "master", "decoy", "wrong prefix"},
+	} {
+		decision := fezzik_types.PullRequestReviewDecision_CHANGES_REQUESTED
+		if entry.id == "00000001" {
+			decision = fezzik_types.PullRequestReviewDecision_APPROVED
+		}
+		nodes = append(nodes, fezzik_types.PullRequestsViewerPullRequestsNodes{
+			{
+				Id: entry.id, HeadRefName: entry.head, BaseRefName: entry.base,
+				ReviewDecision: &decision,
+				Commits: fezzik_types.PullRequestsViewerPullRequestsNodesCommits{
+					Nodes: &fezzik_types.PullRequestsViewerPullRequestsNodesCommitsNodes{
+						{Commit: fezzik_types.PullRequestsViewerPullRequestsNodesCommitsNodesCommit{
+							Oid: entry.hash, MessageHeadline: entry.subject, MessageBody: "commit-id:" + entry.id,
+						}},
+					},
+				},
+			},
+		}...)
+	}
+	api := &p2pPrefixAPI{response: &genclient.PullRequestsResponse{
+		Viewer:     genclient.PullRequestsViewer{PullRequests: fezzik_types.PullRequestConnection{Nodes: &nodes}},
+		Repository: &genclient.PullRequestsRepository{Id: "repo"},
+	}}
+	entry := func(hash, subject, id string) string {
+		return fmt.Sprintf("\ncommit %s\nAuthor: Test\nDate: Test\n\n\t%s\n\n\tcommit-id:%s\n", hash, subject, id)
+	}
+	gitcmd := &p2pPrefixGit{logText: entry(topHash, "second", "00000002") + entry(bottomHash, "first", "00000001")}
+	c := &client{config: cfg, api: api}
+	info := c.GetInfo(context.Background(), gitcmd)
+
+	require.Len(t, info.PullRequests, 2)
+	for i, want := range []struct{ id, head, base, hash, subject string }{
+		{"00000001", bottomBranch, "master", "remote1", "first"},
+		{"00000002", topBranch, bottomBranch, "remote2", "second"},
+	} {
+		pr := info.PullRequests[i]
+		require.Equal(t, want.id, pr.ID)
+		require.Equal(t, want.head, pr.FromBranch)
+		require.Equal(t, want.base, pr.ToBranch)
+		require.Equal(t, want.id == "00000001", pr.MergeStatus.ReviewApproved)
+		commit := git.Commit{CommitID: want.id, CommitHash: want.hash, Subject: want.subject, Body: "commit-id:" + want.id}
+		require.Equal(t, commit, pr.Commit)
+		require.Equal(t, []git.Commit{commit}, pr.Commits)
+	}
+}
+
+func TestGetInfoPreservesEmptyPullRequestSlice(t *testing.T) {
+	cfg := config.EmptyConfig()
+	cfg.User.BranchPrefix = "spr"
+	cfg.Repo.GitHubRemote = "origin"
+	cfg.Repo.GitHubBranch = "master"
+	logText := "\ncommit c100000000000000000000000000000000000000\nAuthor: Test\nDate: Test\n\n\tsubject\n\n\tcommit-id:00000001\n"
+	emptyNodes := fezzik_types.PullRequestsViewerPullRequestsNodes{}
+	unmatchedNodes := fezzik_types.PullRequestsViewerPullRequestsNodes{{
+		Id: "other", HeadRefName: "spr/master/00000002", BaseRefName: "master",
+		Commits: fezzik_types.PullRequestsViewerPullRequestsNodesCommits{
+			Nodes: &fezzik_types.PullRequestsViewerPullRequestsNodesCommitsNodes{{
+				Commit: fezzik_types.PullRequestsViewerPullRequestsNodesCommitsNodesCommit{
+					Oid: "remote", MessageBody: "commit-id:00000002",
+				},
+			}},
+		},
+	}}
+	for _, tc := range []struct {
+		name    string
+		logText string
+		nodes   *fezzik_types.PullRequestsViewerPullRequestsNodes
+		wantNil bool
+	}{
+		{"empty local stack", "", &unmatchedNodes, false},
+		{"nil nodes", logText, nil, false},
+		{"empty nodes", logText, &emptyNodes, true},
+		{"unmatched node", logText, &unmatchedNodes, true},
+	} {
+		api := &p2pPrefixAPI{response: &genclient.PullRequestsResponse{
+			Viewer:     genclient.PullRequestsViewer{PullRequests: fezzik_types.PullRequestConnection{Nodes: tc.nodes}},
+			Repository: &genclient.PullRequestsRepository{Id: "repo"},
+		}}
+		info := (&client{config: cfg, api: api}).GetInfo(context.Background(), &p2pPrefixGit{logText: tc.logText})
+		require.NotNil(t, info, tc.name)
+		require.Empty(t, info.PullRequests, tc.name)
+		if gotNil := info.PullRequests == nil; gotNil != tc.wantNil {
+			t.Errorf("%s: PullRequests == nil: got %t, want %t", tc.name, gotNil, tc.wantNil)
+		}
+	}
+}
