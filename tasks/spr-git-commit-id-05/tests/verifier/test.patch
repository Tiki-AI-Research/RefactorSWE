+// diffSets returns the symmetric difference between the observed set and the
+// frozen baseline, prefixed so additions and removals are distinguishable.
+func diffSets(observed map[string]bool, baseline []string) []string {
+	frozen := map[string]bool{}
+	for _, name := range baseline {
+		frozen[name] = true
+	}
+	var out []string
+	for name := range observed {
+		if !frozen[name] {
+			out = append(out, "added "+name)
+		}
+	}
+	for name := range frozen {
+		if !observed[name] {
+			out = append(out, "removed "+name)
+		}
+	}
+	return uniqueSorted(out)
+}
