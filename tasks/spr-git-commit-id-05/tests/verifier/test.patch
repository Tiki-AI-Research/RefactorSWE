@@ -0,0 +1,585 @@
+#!/usr/bin/env python3
+"""P2P selector runner that produces a regular JUnit report.
+
+The runner executes every declared ``<test file>::<exact leaf>`` selector with
+``go test -json`` and writes a JUnit XML report for the pipeline.
+
+Selection input comes only from plan-managed assets:
+
+* the pipeline materialized selection file (``{p2p_select}`` / ``config.json``,
+  passed with ``--select``/``--config`` or discovered next to the repository),
+  and
+* the leaves declared by the plan's own test assets: the P2P test files listed
+  in ``test_paths`` plus the Baseline restoration paths, discovered by reading
+  those declared files.
+
+The runner never carries its own selector list and never needs a separate
+selection file, so it also runs on a Baseline that only contains the P2P test
+files.
+
+Build products that must be executed (the ``go test`` work directory holding
+the compiled test binary, and the helper binary built by the reword tests) are
+placed in the controlled execution directory ``VERIFIER_EXEC_DIR`` when the
+pipeline provides one, because a ``noexec`` temporary mount cannot run them.
+"""
+
+import argparse
+import json
+import os
+import re
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+from xml.sax.saxutils import escape, quoteattr
+
+# Declared plan assets (top-level test_paths + restoration_paths).  Used to
+# scope selector discovery and to ignore selectors that are not part of this
+# P2P plan.
+DECLARED_PATHS = [
+    "cmd/reword/p2p_reword_regression_test.go",
+    "git/mockgit/p2p_mockgit_regression_test.go",
+    "git/p2p_commitid_regression_test.go",
+    "github/githubclient/p2p_graphql_regression_test.go",
+    "test/p2p_runner.py",
+    "git/commit_test.go",
+    "git/helpers_test.go",
+    "github/githubclient/client_test.go",
+    "config/config_test.go",
+    "config/config_parser/config_parser_test.go",
+    "github/pullrequest_test.go",
+    "github/template/template_basic/template_test.go",
+    "github/template/template_custom/template_test.go",
+    "github/template/template_stack/template_test.go",
+    "github/template/template_why_what/template_test.go",
+    "spr/spr_test.go",
+]
+
+SELECTOR_RE = re.compile(r"^[A-Za-z0-9_./\\-]+\.(?:go|py|js|ts|tsx|jsx|java|kt|rb|rs)::Test[A-Za-z0-9_]+(?:/[A-Za-z0-9_./:<>()-]+)*$")
+GO_LEAF_RE = re.compile(r"^func\s+(Test[A-Za-z0-9_]*)\s*\(", re.M)
+ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
+PLACEHOLDER_RE = re.compile(r"^\{[A-Za-z_]+\}$")
+MAX_DETAIL = 8000
+
+
+def log(message):
+    sys.stdout.write("p2p_runner: %s\n" % message)
+    sys.stdout.flush()
+
+
+def repo_root_from_script():
+    return Path(__file__).resolve().parent.parent
+
+
+def normalize_selector(selector, repo):
+    selector = selector.strip().strip(",").strip('"').strip("'")
+    if selector.startswith("- "):
+        selector = selector[2:].strip()
+    if "::" not in selector:
+        return None
+    file_part, leaf = selector.split("::", 1)
+    file_part = file_part.replace("\\", "/").strip()
+    leaf = leaf.strip()
+    if not file_part or not leaf:
+        return None
+    if file_part.startswith("./"):
+        file_part = file_part[2:]
+    if os.path.isabs(file_part):
+        try:
+            file_part = os.path.relpath(file_part, str(repo)).replace("\\", "/")
+        except ValueError:
+            return None
+    if leaf.startswith("./"):
+        leaf = leaf[2:]
+    return "%s::%s" % (file_part, leaf)
+
+
+def collect_selectors_from_json(text):
+    found = []
+
+    def walk(node):
+        if isinstance(node, str):
+            candidate = node.strip()
+            if SELECTOR_RE.match(candidate) and candidate not in found:
+                found.append(candidate)
+        elif isinstance(node, dict):
+            for value in node.values():
+                walk(value)
+        elif isinstance(node, list):
+            for value in node:
+                walk(value)
+
+    try:
+        walk(json.loads(text))
+    except ValueError:
+        return []
+    return found
+
+
+def parse_selection_text(text):
+    stripped = text.strip()
+    if not stripped:
+        return []
+    if stripped[0] in "[{":
+        selectors = collect_selectors_from_json(stripped)
+        if selectors:
+            return selectors
+    selectors = []
+    for line in stripped.splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or line.startswith("//"):
+            continue
+        candidate = None
+        if SELECTOR_RE.match(line.strip(",").strip('"').strip("'")):
+            candidate = line.strip(",").strip('"').strip("'")
+        else:
+            for token in re.split(r"[\s,]+", line):
+                token = token.strip(",").strip('"').strip("'")
+                if SELECTOR_RE.match(token):
+                    candidate = token
+                    break
+        if candidate and candidate not in selectors:
+            selectors.append(candidate)
+    return selectors
+
+
+def discover_declared_leaves(repo):
+    """Collect the exact leaves declared by the plan's own test assets."""
+    selectors = []
+    for rel in DECLARED_PATHS:
+        if not rel.endswith(".go"):
+            continue
+        path = repo / rel
+        try:
+            if not path.is_file():
+                continue
+            text = path.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            continue
+        for match in GO_LEAF_RE.finditer(text):
+            selector = "%s::%s" % (rel, match.group(1))
+            if selector not in selectors:
+                selectors.append(selector)
+    return selectors
+
+
+def candidate_selection_files(select_arg, config_arg, repo):
+    candidates = []
+    for arg in (select_arg, config_arg):
+        if not arg or PLACEHOLDER_RE.match(arg.strip()):
+            continue
+        arg_path = Path(arg)
+        candidates.append(arg_path)
+        candidates.append(repo / arg)
+        if arg_path.is_dir():
+            candidates.append(arg_path / "p2p_select.txt")
+            candidates.append(arg_path / "config.json")
+    cwd = Path.cwd()
+    for base in (repo, repo.parent, repo.parent.parent, cwd):
+        candidates.extend([
+            base / "p2p_select.txt",
+            base / "verifier" / "p2p_select.txt",
+            base / "config.json",
+            base / "verifier" / "config.json",
+        ])
+    for env_name in ("P2P_SELECT", "P2P_SELECT_FILE", "P2P_SELECT_PATH", "VERIFIER_P2P_SELECT", "CONFIG", "VERIFIER_CONFIG"):
+        value = os.environ.get(env_name)
+        if value:
+            candidates.append(Path(value))
+    return candidates
+
+
+def load_selectors(select_arg, config_arg, repo):
+    selectors = []
+    seen = set()
+
+    def add(found, origin):
+        new = 0
+        for selector in found:
+            if selector not in seen:
+                seen.add(selector)
+                selectors.append(selector)
+                new += 1
+        if new:
+            log("selection input from %s (%d selector entries)" % (origin, new))
+
+    for candidate in candidate_selection_files(select_arg, config_arg, repo):
+        try:
+            if not candidate.is_file():
+                continue
+            text = candidate.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            continue
+        add(parse_selection_text(text), candidate)
+
+    for arg in (select_arg, config_arg):
+        if not arg or PLACEHOLDER_RE.match(arg.strip()):
+            continue
+        text = arg.strip()
+        if text.startswith("[") or text.startswith("{"):
+            add(collect_selectors_from_json(text), "--select argument (JSON)")
+        else:
+            add(parse_selection_text(text), "--select argument (inline)")
+
+    return selectors
+
+
+def filter_selectors(selectors, repo):
+    allowed = set(DECLARED_PATHS)
+    kept = []
+    dropped = []
+    for selector in selectors:
+        normalized = normalize_selector(selector, repo)
+        if normalized is None:
+            continue
+        file_part = normalized.split("::", 1)[0]
+        if file_part in allowed:
+            if normalized not in kept:
+                kept.append(normalized)
+        else:
+            dropped.append(normalized)
+    if dropped:
+        log("ignoring selectors outside the declared P2P paths: %s" % ", ".join(dropped))
+    return kept
+
+
+def build_selection(select_arg, config_arg, repo, node_selector=""):
+    if node_selector:
+        normalized = normalize_selector(node_selector, repo)
+        if normalized is None:
+            log("cannot parse selector %r" % node_selector)
+            return []
+        if normalized.split("::", 1)[0] not in set(DECLARED_PATHS):
+            log("selector %s is outside the declared P2P paths" % normalized)
+        return [normalized]
+
+    external = filter_selectors(load_selectors(select_arg, config_arg, repo), repo)
+    declared = discover_declared_leaves(repo)
+    merged = list(declared)
+    for selector in external:
+        if selector not in merged:
+            merged.append(selector)
+    if declared:
+        log("discovered %d declared leaves from the P2P test assets" % len(declared))
+    return merged
+
+
+def find_go():
+    go = shutil.which("go")
+    if go:
+        return go
+    for candidate in ("/opt/envpipe/runtime/bin/go", "/usr/local/go/bin/go", "/usr/lib/go/bin/go"):
+        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    return None
+
+
+EXEC_FALLBACK_DIRNAME = ".p2p_exec_tmp"
+
+
+def probe_exec(directory):
+    """Return True when a file written into *directory* can be executed.
+
+    A ``noexec`` filesystem cannot run the compiled ``go test`` binary, so a
+    candidate directory is probed with a copy of a real executable before it is
+    used for build products.
+    """
+    try:
+        directory.mkdir(parents=True, exist_ok=True)
+    except OSError:
+        return False
+
+    probe = directory / (".p2p_exec_probe_%d" % os.getpid())
+    shell = shutil.which("sh") or "/bin/sh"
+    try:
+        if os.path.isfile(shell):
+            shutil.copy2(shell, probe)
+            command = [str(probe), "-c", "exit 0"]
+        else:
+            probe.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
+            probe.chmod(0o755)
+            command = [str(probe)]
+        completed = subprocess.run(
+            command,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            timeout=30,
+        )
+        return completed.returncode == 0
+    except (OSError, subprocess.SubprocessError):
+        return False
+    finally:
+        try:
+            probe.unlink()
+        except OSError:
+            pass
+
+
+def resolve_exec_dir(repo):
+    """Pick the directory used for build products that must be executed.
+
+    ``VERIFIER_EXEC_DIR`` is the pipeline-provided controlled execution
+    directory and is preferred.  ``TMPDIR`` keeps the default behavior when it
+    can execute files, and a repository-local scratch directory is the last
+    resort so a ``noexec`` temporary mount cannot block the replay.
+    """
+    candidates = []
+    declared = os.environ.get("VERIFIER_EXEC_DIR", "").strip()
+    if declared:
+        candidates.append(Path(declared))
+    candidates.append(Path(tempfile.gettempdir()))
+    fallback = repo / EXEC_FALLBACK_DIRNAME
+    candidates.append(fallback)
+
+    for candidate in candidates:
+        if probe_exec(candidate):
+            return candidate, candidate == fallback
+    if declared:
+        return Path(declared), False
+    return None, False
+
+
+def build_env(exec_dir):
+    env = os.environ.copy()
+    env["GOFLAGS"] = "-mod=readonly"
+    env["GOPROXY"] = "off"
+    env["GOTOOLCHAIN"] = "local"
+    if exec_dir is not None:
+        env["GOTMPDIR"] = str(exec_dir)
+        env["VERIFIER_EXEC_DIR"] = str(exec_dir)
+    return env
+
+
+def strip_ansi(text):
+    return ANSI_RE.sub("", text)
+
+
+def run_selector(repo, go_binary, selector, timeout, exec_dir=None):
+    file_part, leaf = selector.split("::", 1)
+    package_dir = os.path.dirname(file_part) or "."
+    package_arg = "./" + package_dir if package_dir != "." else "."
+    command = [go_binary, "test", "-count=1", "-json", "-run", "^%s$" % re.escape(leaf), package_arg]
+
+    env = build_env(exec_dir)
+
+    started = time.time()
+    timed_out = False
+    try:
+        process = subprocess.Popen(
+            command,
+            cwd=str(repo),
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            start_new_session=True,
+        )
+    except OSError as exc:
+        return {
+            "selector": selector,
+            "status": "error",
+            "time": 0.0,
+            "message": "failed to start go test: %s" % exc,
+            "detail": " ".join(command),
+        }
+
+    try:
+        raw, _ = process.communicate(timeout=timeout)
+        output = raw.decode("utf-8", "replace")
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        try:
+            os.killpg(process.pid, signal.SIGKILL)
+        except OSError:
+            pass
+        raw, _ = process.communicate()
+        output = raw.decode("utf-8", "replace")
+
+    elapsed = time.time() - started
+    if timed_out:
+        return {
+            "selector": selector,
+            "status": "error",
+            "time": elapsed,
+            "message": "timed out after %ss" % timeout,
+            "detail": strip_ansi(output)[-MAX_DETAIL:],
+        }
+
+    leaf_status = None
+    subtest_failed = False
+    package_output = []
+    test_output = {}
+    for line in output.splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            if line:
+                package_output.append(line)
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            package_output.append(line)
+            continue
+        test_name = event.get("Test")
+        action = event.get("Action")
+        if event.get("Output"):
+            if test_name is None:
+                package_output.append(event["Output"].rstrip("\n"))
+            else:
+                test_output.setdefault(test_name, []).append(event["Output"].rstrip("\n"))
+        if not test_name:
+            continue
+        if test_name == leaf and action in ("pass", "fail", "skip"):
+            leaf_status = action
+        elif test_name.startswith(leaf + "/") and action == "fail":
+            subtest_failed = True
+
+    if leaf_status is None:
+        if subtest_failed:
+            leaf_status = "fail"
+        else:
+            return {
+                "selector": selector,
+                "status": "error",
+                "time": elapsed,
+                "message": "selector was not collected or did not execute",
+                "detail": strip_ansi("\n".join(package_output))[-MAX_DETAIL:] or strip_ansi(output)[-MAX_DETAIL:],
+            }
+
+    leaf_output = []
+    for name in sorted(test_output):
+        if name == leaf or name.startswith(leaf + "/"):
+            leaf_output.extend(test_output[name])
+    detail = strip_ansi("\n".join(leaf_output + package_output))[-MAX_DETAIL:]
+    if leaf_status == "pass":
+        return {"selector": selector, "status": "pass", "time": elapsed, "message": "", "detail": ""}
+    if leaf_status == "skip":
+        return {
+            "selector": selector,
+            "status": "skipped",
+            "time": elapsed,
+            "message": "selector was skipped",
+            "detail": detail,
+        }
+    return {
+        "selector": selector,
+        "status": "fail",
+        "time": elapsed,
+        "message": "test assertions failed",
+        "detail": detail,
+    }
+
+
+def write_junit(report_path, results):
+    tests = len(results)
+    failures = sum(1 for r in results if r["status"] == "fail")
+    errors = sum(1 for r in results if r["status"] == "error")
+    skipped = sum(1 for r in results if r["status"] == "skipped")
+    total_time = sum(r["time"] for r in results)
+
+    lines = []
+    lines.append('<?xml version="1.0" encoding="UTF-8"?>')
+    lines.append(
+        '<testsuites name="p2p" tests="%d" failures="%d" errors="%d" skipped="%d" time="%.3f">'
+        % (tests, failures, errors, skipped, total_time)
+    )
+    lines.append(
+        '  <testsuite name="p2p" tests="%d" failures="%d" errors="%d" skipped="%d" time="%.3f">'
+        % (tests, failures, errors, skipped, total_time)
+    )
+    lines.append("    <properties>")
+    lines.append('      <property name="runner" value="test/p2p_runner.py"/>')
+    lines.append("    </properties>")
+    for result in results:
+        file_part, leaf = result["selector"].split("::", 1)
+        attributes = 'classname=%s name=%s time="%.3f" selector=%s' % (
+            quoteattr(file_part),
+            quoteattr(leaf),
+            result["time"],
+            quoteattr(result["selector"]),
+        )
+        if result["status"] == "pass":
+            lines.append("    <testcase %s/>" % attributes)
+        elif result["status"] == "fail":
+            lines.append("    <testcase %s>" % attributes)
+            lines.append(
+                "      <failure type=\"failure\" message=%s>%s</failure>"
+                % (quoteattr(result["message"]), escape(result["detail"]))
+            )
+            lines.append("    </testcase>")
+        elif result["status"] == "skipped":
+            lines.append("    <testcase %s>" % attributes)
+            lines.append("      <skipped message=%s/>" % quoteattr(result["message"]))
+            lines.append("    </testcase>")
+        else:
+            lines.append("    <testcase %s>" % attributes)
+            lines.append(
+                "      <error type=\"error\" message=%s>%s</error>"
+                % (quoteattr(result["message"]), escape(result["detail"]))
+            )
+            lines.append("    </testcase>")
+    lines.append("  </testsuite>")
+    lines.append("</testsuites>")
+    lines.append("")
+
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    report_path.write_text("\n".join(lines), encoding="utf-8")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Run P2P selectors and write a JUnit report")
+    parser.add_argument("--report", required=True, help="path of the JUnit report to write")
+    parser.add_argument("--select", default="", help="path or content of the p2p selection file")
+    parser.add_argument("--config", default="", help="path of the materialized config.json")
+    parser.add_argument("--node", default="", help="run a single selector")
+    parser.add_argument("--repo", default="", help="repository root (defaults to the runner's parent directory)")
+    parser.add_argument("--timeout", type=float, default=180.0, help="per selector timeout in seconds")
+    args = parser.parse_args()
+
+    repo = Path(args.repo).resolve() if args.repo else repo_root_from_script()
+    report_path = Path(args.report)
+
+    go_binary = find_go()
+    if not go_binary:
+        log("go toolchain not found; cannot run selectors")
+        return 1
+
+    # A hostile umask must not strip the executable bit from the compiled test
+    # binary or from the fake helper written by the git tests.
+    os.umask(0o022)
+
+    selectors = build_selection(args.select, args.config, repo, args.node)
+
+    if not selectors:
+        log("no P2P selectors found; refusing to write an empty report")
+        return 1
+
+    exec_dir, used_fallback = resolve_exec_dir(repo)
+    if exec_dir is not None:
+        log("executing build products from %s" % exec_dir)
+
+    log("running %d selectors from %s" % (len(selectors), repo))
+    results = []
+    try:
+        for selector in selectors:
+            result = run_selector(repo, go_binary, selector, args.timeout, exec_dir)
+            log("%-9s %s" % (result["status"], selector))
+            results.append(result)
+    finally:
+        if used_fallback:
+            shutil.rmtree(exec_dir, ignore_errors=True)
+
+    write_junit(report_path, results)
+
+    passed = sum(1 for r in results if r["status"] == "pass")
+    failed = sum(1 for r in results if r["status"] == "fail")
+    errored = sum(1 for r in results if r["status"] == "error")
+    skipped = sum(1 for r in results if r["status"] == "skipped")
+    log("report written to %s (pass=%d fail=%d error=%d skipped=%d)" % (report_path, passed, failed, errored, skipped))
+    return 1 if failed or errored or skipped else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
