new file mode 100644
index 0000000000000000000000000000000000000000..427940c62337af5da4bb0f1141b2fea5535f3efa
--- /dev/null
+++ b/test/f2p/capability_test.go
@@ -0,0 +1,838 @@
+package f2p
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// An exported parser must obtain its result from the shared prefix protocol.
+func TestGitCapabilityExportsPrefixAwareParser(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	if len(gitParseCapabilityFuncs(g)) == 0 {
+		t.Fatalf("package git exports no package-level commit-id parse capability whose parsed result reaches its return value; exported declarations: %s",
+			joinComma(g.exportedNames()))
+	}
+}
+
+// An exported formatter must build returned text from the shared prefix.
+func TestGitCapabilityExportsPrefixAwareFormatter(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	if len(gitFormatCapabilityFuncs(g)) == 0 {
+		t.Fatalf("package git exports no package-level commit-id format capability whose returned text is built from the prefix; exported declarations: %s",
+			joinComma(g.exportedNames()))
+	}
+}
+
+func TestGitCapabilityReturnsOperationResult(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	if broken := brokenCapabilityNames(g); len(broken) > 0 {
+		t.Fatalf("package git exports commit-id capabilities that perform an operation whose result is dropped, so they produce nothing: %s",
+			joinComma(broken))
+	}
+}
+
+func (p *pkg) exportedNames() []string {
+	var names []string
+	for _, d := range p.order {
+		if d.exported && d.recv == "" {
+			names = append(names, d.kind+" "+d.name)
+		}
+	}
+	sort.Strings(names)
+	return names
+}
+
+// TestGitCapabilityEnforcesIdentifierShape verifies the second half of the new
+// public contract: the shared capability must cover the identifier shape, so
+// the eight-lowercase-hex rule is defined once and applied by a real match
+// instead of being copied into every parsing site.
+//
+// The leaf requires a compiled regexp whose argument closure carries both the
+// prefix and the shape literal and that is applied through a regexp match call
+// (FindStringSubmatch, MatchString, ...). Referencing an unrelated helper
+// whose name contains "hex" or whose body happens to contain a hex class does
+// not count.
+//
+// Baseline fails this leaf because the eight-hex shape is only compiled and
+// matched inside the private parseLocalCommitStack and BranchNameRegex
+// functions, never behind an exported commit-id capability.
+func TestGitCapabilityEnforcesIdentifierShape(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	var covering []string
+	for _, d := range g.order {
+		if d.kind != "func" || d.recv != "" || !d.exported {
+			continue
+		}
+		if !g.definesPrefix(d) {
+			continue
+		}
+		if g.hasProtocolMatchCall(d) {
+			covering = append(covering, d.name)
+		}
+	}
+	if len(covering) == 0 {
+		t.Fatalf("package git exports no commit-id capability that compiles and applies the eight-lowercase-hex identifier shape; exported declarations: %s",
+			joinComma(g.exportedNames()))
+	}
+}
+
+// capabilityUse records a capability call that appears in an observable
+// position of a consumer declaration together with the role of that position:
+// emission (the text of a write call), parse (a CommitID field or a branch
+// condition that decides a returned value) or return.
+type capabilityUse struct {
+	target *decl
+	role   string
+}
+
+// positionCapabilityUses inspects one observable expression of d. A capability
+// call whose result contributes to the expression value is recorded as a use;
+// a capability call that appears in the expression but whose result is
+// swallowed by an unrelated wrapper is reported as broken, because the
+// consumer never obtains the protocol through it.
+func positionCapabilityUses(m *repoModel, g *pkg, d *decl, locals map[string]ast.Expr, expr ast.Expr, role string) (uses []capabilityUse, broken []string) {
+	if expr == nil {
+		return nil, nil
+	}
+	origins := map[*decl]bool{}
+	for _, target := range exprOrigins(m, g, d, locals, expr, 0, nil) {
+		if target != nil {
+			origins[target] = true
+		}
+	}
+	for _, call := range callsReached(d, locals, expr) {
+		target := capabilityTarget(m, g, d, call)
+		if target == nil || !g.claimsCapabilityOperation(target) {
+			continue
+		}
+		if origins[target] {
+			uses = append(uses, capabilityUse{target: target, role: role})
+			continue
+		}
+		broken = append(broken, fmt.Sprintf("%s.%s: the result of git.%s does not contribute to the %s value",
+			d.pkg.name, d.name, target.name, role))
+	}
+	return uses, broken
+}
+
+// observableCapabilityUses returns every capability use that reaches an
+// observable position of d and every capability call that fails to: a call
+// whose result is swallowed by an unrelated wrapper, or a capability whose
+// implementation drops its parse/format result.
+func observableCapabilityUses(m *repoModel, g *pkg, d *decl) (uses []capabilityUse, broken []string) {
+	if d.body == nil {
+		return nil, nil
+	}
+	locals := localBindings(d)
+	add := func(u []capabilityUse, b []string) {
+		uses = append(uses, u...)
+		broken = append(broken, b...)
+	}
+	for _, ret := range returnedExprs(d) {
+		u, b := positionCapabilityUses(m, g, d, locals, ret, "return")
+		add(u, b)
+	}
+	ast.Inspect(d.body, func(n ast.Node) bool {
+		switch item := n.(type) {
+		case *ast.FuncLit:
+			return false
+		case *ast.CallExpr:
+			if writeCallees[callName(item)] {
+				for _, arg := range item.Args {
+					u, b := positionCapabilityUses(m, g, d, locals, arg, "emission")
+					add(u, b)
+				}
+			}
+		case *ast.AssignStmt:
+			for index, lhs := range item.Lhs {
+				if isCommitIDField(lhs) {
+					u, b := positionCapabilityUses(m, g, d, locals, assignmentRHS(item, index), "parse")
+					add(u, b)
+				}
+			}
+		case *ast.KeyValueExpr:
+			if id, ok := item.Key.(*ast.Ident); ok && id.Name == "CommitID" {
+				u, b := positionCapabilityUses(m, g, d, locals, item.Value, "parse")
+				add(u, b)
+			}
+		case *ast.IfStmt:
+			if blockDecidesResult(d, item.Body) || elseDecidesResult(d, item.Else) {
+				u, b := positionCapabilityUses(m, g, d, locals, item.Cond, "parse")
+				add(u, b)
+				add(initCapabilityUses(m, g, d, locals, item.Init, item.Cond))
+			}
+		case *ast.ForStmt:
+			if item.Cond != nil && blockDecidesResult(d, item.Body) {
+				u, b := positionCapabilityUses(m, g, d, locals, item.Cond, "parse")
+				add(u, b)
+				add(initCapabilityUses(m, g, d, locals, item.Init, item.Cond))
+			}
+		}
+		return true
+	})
+	return uses, broken
+}
+
+// initCapabilityUses inspects the init statement of a branch whose condition
+// reads the initialized names, so `if id, ok := git.ParseCommitID(line); ok`
+// counts as obtaining the identifier.
+func initCapabilityUses(m *repoModel, g *pkg, d *decl, locals map[string]ast.Expr, init ast.Stmt, cond ast.Expr) (uses []capabilityUse, broken []string) {
+	stmt, ok := init.(*ast.AssignStmt)
+	if !ok {
+		return nil, nil
+	}
+	for index, lhs := range stmt.Lhs {
+		id, ok := lhs.(*ast.Ident)
+		if !ok || id.Name == "_" || !exprContainsIdent(cond, id.Name, 0) {
+			continue
+		}
+		u, b := positionCapabilityUses(m, g, d, locals, assignmentRHS(stmt, index), "parse")
+		uses = append(uses, u...)
+		broken = append(broken, b...)
+	}
+	return uses, broken
+}
+
+// elseDecidesResult reports whether an else branch decides a returned value of
+// d, following chained else-if statements.
+func elseDecidesResult(d *decl, node ast.Node) bool {
+	switch branch := node.(type) {
+	case *ast.BlockStmt:
+		return blockDecidesResult(d, branch)
+	case *ast.IfStmt:
+		return blockDecidesResult(d, branch.Body) || elseDecidesResult(d, branch.Else)
+	}
+	return false
+}
+
+// crossPackageCapabilityReport returns the production uses outside package git
+// that obtain the commit-id protocol through an exported git capability whose
+// operation result is returned (valid), and the uses that call such a
+// capability without obtaining a usable value (broken). A consumer that calls
+// a capability whose implementation drops the parse/format result, or that
+// swallows the result in an unrelated wrapper, does not obtain the protocol
+// and makes the report broken.
+func crossPackageCapabilityReport(m *repoModel, g *pkg) (valid, broken []string) {
+	for dir, p := range m.pkgs {
+		if p == g {
+			continue
+		}
+		for _, d := range p.order {
+			uses, failures := observableCapabilityUses(m, g, d)
+			for _, use := range uses {
+				usable := false
+				switch use.role {
+				case "emission":
+					usable = g.hasFormatterEvidence(use.target)
+				case "parse":
+					usable = g.hasParseEvidence(use.target)
+				default:
+					usable = g.hasParseEvidence(use.target) || g.hasFormatterEvidence(use.target)
+				}
+				label := dir + "." + d.name + " -> git." + use.target.name
+				if usable {
+					valid = append(valid, label)
+				} else {
+					failures = append(failures, label+" (the capability has no usable "+use.role+" implementation)")
+				}
+			}
+			broken = append(broken, failures...)
+		}
+	}
+	return uniqueSorted(valid), uniqueSorted(broken)
+}
+
+// crossPackageCapabilityCalls returns the valid cross-package capability uses,
+// i.e. the consumer calls that actually obtain the protocol.
+func crossPackageCapabilityCalls(m *repoModel, g *pkg) []string {
+	valid, _ := crossPackageCapabilityReport(m, g)
+	return valid
+}
+
+// A production caller outside git must obtain the protocol through the shared API.
+func TestSharedCapabilityReachedFromAnotherPackage(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	consumers, _ := crossPackageCapabilityReport(m, g)
+	if len(consumers) == 0 {
+		t.Fatalf("no production code outside package git obtains the commit-id protocol through a used call to an exported git capability")
+	}
+}
+
+func TestCrossPackageCapabilityCallsReturnUsableValues(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	_, broken := crossPackageCapabilityReport(m, g)
+	if len(broken) > 0 {
+		t.Fatalf("production code outside package git calls a commit-id capability without obtaining a usable value: %s",
+			joinComma(broken))
+	}
+}
+
+// baselineGitExportedFuncs is the public function surface of package git
+// frozen by the task contract. Each entry maps the function name to the exact
+// normalized signature that must be preserved.
+var baselineGitExportedFuncs = map[string]string{
+	"BranchNameFromCommit": "(cfg *config.Config, commit Commit) string",
+	"BranchNameRegex":      "(branchPrefix string) *regexp.Regexp",
+	"GetLocalBranchName":   "(gitcmd GitInterface) string",
+	"GetLocalCommitStack":  "(cfg *config.Config, gitcmd GitInterface) []Commit",
+	"GetLocalTopCommit":    "(cfg *config.Config, gitcmd GitInterface) *Commit",
+}
+
+// baselineCommitFields is the frozen public field set of git.Commit.
+var baselineCommitFields = map[string]string{
+	"CommitID":   "string",
+	"CommitHash": "string",
+	"Subject":    "string",
+	"Body":       "string",
+	"WIP":        "bool",
+}
+
+// baselineGitInterfaceMethods is the frozen method set of git.GitInterface.
+var baselineGitInterfaceMethods = map[string]string{
+	"GitWithEditor":      "GitWithEditor(args string, output *string, editorCmd string) error",
+	"Git":                "Git(args string, output *string) error",
+	"MustGit":            "MustGit(args string, output *string)",
+	"RootDir":            "RootDir() string",
+	"DeleteRemoteBranch": "DeleteRemoteBranch(ctx context.Context, branch string) error",
+}
+
+func assertExternalCompatibility(t *testing.T, root, source string) {
+	t.Helper()
+	sourcePath := filepath.Join(t.TempDir(), "main.go")
+	if err := os.WriteFile(sourcePath, []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	goBinary, err := exec.LookPath("go")
+	if err != nil {
+		goBinary = filepath.Join(runtime.GOROOT(), "bin", "go")
+	}
+	command := exec.Command(goBinary, "run", sourcePath)
+	command.Dir = root
+	if output, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("external compatibility check failed: %v\n%s", err, output)
+	}
+}
+
+func TestExistingGitFunctionsPreserved(t *testing.T) {
+	m := loadRepo(t)
+	g := m.mustPkg(t, "git")
+
+	for name, want := range baselineGitExportedFuncs {
+		d := g.decls[name]
+		if d == nil || d.kind != "func" || d.recv != "" {
+			t.Fatalf("package git no longer declares the exported function %s", name)
+		}
+		if !d.exported {
+			t.Fatalf("package git no longer exports %s", name)
+		}
+		if d.signature != want {
+			t.Fatalf("%s signature changed to %q, want %q", name, d.signature, want)
+		}
+	}
