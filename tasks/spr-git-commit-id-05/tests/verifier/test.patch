+package mockgit
+
+import (
+	"testing"
+
+	"github.com/ejoffe/spr/git"
+	"github.com/stretchr/testify/require"
+)
+
+// TestMockGitFabricatedLogTextByteIdentical pins the byte-identical log text
+// fabricated by the in-memory git test double: the commit header block, the
+// tab-indented subject line, the tab-indented commit-id line and the blank
+// lines around them must not change.
+func TestMockGitFabricatedLogTextByteIdentical(t *testing.T) {
+	mock := NewMockGit(t)
+	commits := []*git.Commit{
+		{
+			CommitID:   "053f6d16",
+			CommitHash: "d89e0e460ed817c81641f32b1a506b60164b4403",
+			Subject:    "Supergalactic speed",
+		},
+		{
+			CommitID:   "39c84ea3",
+			CommitHash: "d604099d6604949e786e3d781919d43e46e88521",
+			Subject:    "More engine power",
+		},
+	}
+	mock.ExpectLogAndRespond(commits)
+
+	var output string
+	require.NoError(t, mock.Git("log --format=medium --no-color origin/master..HEAD", &output))
+
+	expected := "commit d89e0e460ed817c81641f32b1a506b60164b4403\n" +
+		"Author: Eitan Joffe <ejoffe@gmail.com>\n" +
+		"Date:   Fri Jun 11 14:15:49 2021 -0700\n" +
+		"\n" +
+		"\tSupergalactic speed\n" +
+		"\n" +
+		"\tcommit-id:053f6d16\n" +
+		"\n" +
+		"commit d604099d6604949e786e3d781919d43e46e88521\n" +
+		"Author: Eitan Joffe <ejoffe@gmail.com>\n" +
+		"Date:   Fri Jun 11 14:15:49 2021 -0700\n" +
+		"\n" +
+		"\tMore engine power\n" +
+		"\n" +
+		"\tcommit-id:39c84ea3\n" +
+		"\n"
+
+	require.Equal(t, expected, output)
+	mock.ExpectationsMet()
+}
diff --git a/git/p2p_commitid_regression_test.go b/git/p2p_commitid_regression_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4950ce914477c7c2b560f88f6fd1700823d50c81
--- /dev/null
+++ b/git/p2p_commitid_regression_test.go
@@ -0,0 +1,280 @@
+package git
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/ejoffe/spr/config"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// p2pCommitLogEntry builds one entry of `git log --format=medium` output the
+// way the parser expects it: four header lines, a blank line, the tab-indented
+// subject, a blank line and the tab-indented commit-id line.
+func p2pCommitLogEntry(hash string, subject string, commitID string) string {
+	return fmt.Sprintf(
+		"\ncommit %s (HEAD -> master)\nAuthor: Han Solo\nDate:   Wed May 21 19:53:12 1980 -0700\n\n\t%s\n\n\tcommit-id:%s\n",
+		hash, subject, commitID)
+}
+
+// p2pFakeGit is a deterministic GitInterface used by the P2P regression tests
+// so that GetLocalCommitStack can be exercised without running git.
+type p2pFakeGit struct {
+	logText     string
+	logTexts    []string
+	logCalls    int
+	editorCalls int
+}
+
+func (f *p2pFakeGit) Git(args string, output *string) error {
+	if strings.HasPrefix(args, "log ") {
+		f.logCalls++
+		if output != nil {
+			*output = f.logText
+			if len(f.logTexts) > 0 {
+				index := f.logCalls - 1
+				if index >= len(f.logTexts) {
+					index = len(f.logTexts) - 1
+				}
+				*output = f.logTexts[index]
+			}
+		}
+	}
+	return nil
+}
+
+func (f *p2pFakeGit) MustGit(args string, output *string) {
+	if err := f.Git(args, output); err != nil {
+		panic(err)
+	}
+}
+
+func (f *p2pFakeGit) GitWithEditor(args string, output *string, editorCmd string) error {
+	f.editorCalls++
+	return nil
+}
+
+func (f *p2pFakeGit) RootDir() string {
+	return ""
+}
+
+func (f *p2pFakeGit) DeleteRemoteBranch(ctx context.Context, branch string) error {
+	return nil
+}
+
+func p2pTestConfig() *config.Config {
+	cfg := config.EmptyConfig()
+	cfg.Repo.GitHubRemote = "origin"
+	cfg.Repo.GitHubBranch = "master"
+	return cfg
+}
+
+// TestParseLocalCommitStackIdentifierTolerance pins the local commit-log
+// identifier tolerance: the prefix may be preceded by other text, optional
+// whitespace may follow the colon, the identifier is the first eight lowercase
+// hexadecimal characters, and trailing characters neither change the parsed
+// value nor prevent the line from being recognized. Uppercase or short
+// identifiers are not recognized and make the whole log invalid.
+func TestParseLocalCommitStackIdentifierTolerance(t *testing.T) {
+	const hash = "d89e0e460ed817c81641f32b1a506b60164b4403"
+
+	tests := []struct {
+		name       string
+		idLine     string
+		expectedID string
+		valid      bool
+	}{
+		{name: "plain identifier", idLine: "\tcommit-id:053f6d16", expectedID: "053f6d16", valid: true},
+		{name: "whitespace after colon", idLine: "\tcommit-id:   053f6d16", expectedID: "053f6d16", valid: true},
+		{name: "prefix preceded by subject text", idLine: "\tnote commit-id:053f6d16", expectedID: "053f6d16", valid: true},
+		{name: "trailing text after identifier", idLine: "\tcommit-id:053f6d16extra", expectedID: "053f6d16", valid: true},
+		{name: "trailing colon after identifier", idLine: "\tcommit-id:053f6d16:more", expectedID: "053f6d16", valid: true},
+		{name: "uppercase hex is not an identifier", idLine: "\tcommit-id:053F6D16", valid: false},
+		{name: "seven hex characters are not an identifier", idLine: "\tcommit-id:053f6d1", valid: false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			logText := "\ncommit " + hash + " (HEAD -> master)\n" +
+				"Author: Han Solo\n" +
+				"Date:   Wed May 21 19:53:12 1980 -0700\n" +
+				"\n" +
+				"\tSupergalactic speed\n" +
+				"\n" +
+				tc.idLine + "\n"
+
+			commits, valid := parseLocalCommitStack(logText)
+			assert.Equal(t, tc.valid, valid)
+
+			if !tc.valid {
+				assert.Nil(t, commits)
+				return
+			}
+
+			require.Len(t, commits, 1)
+			assert.Equal(t, hash, commits[0].CommitHash)
+			assert.Equal(t, tc.expectedID, commits[0].CommitID)
+			assert.Equal(t, "Supergalactic speed", commits[0].Subject)
+			assert.Equal(t, "", commits[0].Body)
+			assert.False(t, commits[0].WIP)
+		})
+	}
+}
+
+// TestParseLocalCommitStackWIPFlag pins the WIP flag: it is set only for
+// subjects that start with "WIP" after trimming.
+func TestParseLocalCommitStackWIPFlag(t *testing.T) {
+	const hash = "d89e0e460ed817c81641f32b1a506b60164b4403"
+
+	parse := func(subject string) Commit {
+		t.Helper()
+		logText := p2pCommitLogEntry(hash, subject, "053f6d16")
+		commits, valid := parseLocalCommitStack(logText)
+		require.True(t, valid, "subject %q should parse", subject)
+		require.Len(t, commits, 1)
+		return commits[0]
+	}
+
+	wip := parse("WIP: still cooking")
+	assert.True(t, wip.WIP)
+	assert.Equal(t, "WIP: still cooking", wip.Subject)
+
+	lowercase := parse("wip: lowercase subject")
+	assert.False(t, lowercase.WIP)
+	assert.Equal(t, "wip: lowercase subject", lowercase.Subject)
+
+	plain := parse("Work in progress")
+	assert.False(t, plain.WIP)
+	assert.Equal(t, "Work in progress", plain.Subject)
+}
+
+// TestParseLocalCommitStackAllOrNothingOnInvalidEntry pins that a log with any
+// commit missing a valid identifier is reported as entirely invalid, without
+// yielding the commits that were parsed before the failure.
+func TestParseLocalCommitStackAllOrNothingOnInvalidEntry(t *testing.T) {
+	valid := p2pCommitLogEntry("d89e0e460ed817c81641f32b1a506b60164b4403", "Supergalactic speed", "053f6d16")
+	invalid := "\ncommit d604099d6604949e786e3d781919d43e46e88521 (HEAD -> master)\n" +
+		"Author: Han Solo\n" +
+		"Date:   Wed May 21 19:52:51 1980 -0700\n" +
+		"\n" +
+		"\tMore engine power\n"
+
+	commits, ok := parseLocalCommitStack(valid + invalid)
+	assert.False(t, ok)
+	assert.Nil(t, commits)
+
+	commits, ok = parseLocalCommitStack(invalid + valid)
+	assert.False(t, ok)
+	assert.Nil(t, commits)
+}
+
+// TestGetLocalCommitStackOrderingAndTopCommit pins the stack contract: the
+// returned commits are ordered with the bottom of the stack first, the top
+// commit is the last element, and an empty stack yields no commits and a nil
+// top commit.
+func TestGetLocalCommitStackOrderingAndTopCommit(t *testing.T) {
+	cfg := p2pTestConfig()
+
+	logText := p2pCommitLogEntry("c300000000000000000000000000000000000000", "third", "00000003") +
+		p2pCommitLogEntry("c200000000000000000000000000000000000000", "second", "00000002") +
+		p2pCommitLogEntry("c100000000000000000000000000000000000000", "first", "00000001")
+
+	gitcmd := &p2pFakeGit{logText: logText}
+	commits := GetLocalCommitStack(cfg, gitcmd)
+	require.Len(t, commits, 3)
+	assert.Equal(t, []string{"00000001", "00000002", "00000003"},
+		[]string{commits[0].CommitID, commits[1].CommitID, commits[2].CommitID})
+	assert.Equal(t, []string{"first", "second", "third"},
+		[]string{commits[0].Subject, commits[1].Subject, commits[2].Subject})
+
+	top := GetLocalTopCommit(cfg, gitcmd)
+	require.NotNil(t, top)
+	assert.Equal(t, "00000003", top.CommitID)
+	assert.Equal(t, "third", top.Subject)
+
+	empty := &p2pFakeGit{}
+	assert.Empty(t, GetLocalCommitStack(cfg, empty))
+	assert.Nil(t, GetLocalTopCommit(cfg, empty))
+}
+
+// p2pHelperDir returns a directory whose files can be executed: the
+// pipeline-provided VERIFIER_EXEC_DIR when present, because a noexec temporary
+// mount cannot run the fake helper.
+func p2pHelperDir(t *testing.T) string {
+	t.Helper()
+	if execDir := os.Getenv("VERIFIER_EXEC_DIR"); execDir != "" {
+		require.NoError(t, os.MkdirAll(execDir, 0o755))
+		return execDir
+	}
+	return t.TempDir()
+}
+
+// TestGetLocalCommitStackPanicsAfterRewordRetry pins the failure semantics of
+// an unresolved missing identifier: after the reword retry the stack call
+// panics with the existing diagnostic instead of returning partial commits.
+func TestGetLocalCommitStackPanicsAfterRewordRetry(t *testing.T) {
+	helperDir := p2pHelperDir(t)
+	helperPath := filepath.Join(helperDir, "spr_reword_helper")
+	require.NoError(t, os.WriteFile(helperPath, []byte("#!/bin/sh\nexit 0\n"), 0o755))
+	t.Setenv("PATH", helperDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+
+	cfg := p2pTestConfig()
+	logText := "\ncommit d89e0e460ed817c81641f32b1a506b60164b4403 (HEAD -> master)\n" +
+		"Author: Han Solo\n" +
+		"Date:   Wed May 21 19:53:12 1980 -0700\n" +
+		"\n" +
+		"\tSupergalactic speed\n"
+	gitcmd := &p2pFakeGit{logText: logText}
+
+	var recovered interface{}
+	func() {
+		defer func() {
+			recovered = recover()
+		}()
+		GetLocalCommitStack(cfg, gitcmd)
+	}()
+
+	require.NotNil(t, recovered, "GetLocalCommitStack should panic when no commit-id can be resolved")
+	message := fmt.Sprint(recovered)
+	assert.Equal(t, "unable to fetch local commits\n"+
+		" most likely this is an issue with missing commit-id in the commit body\n", message)
+	assert.Equal(t, 1, gitcmd.editorCalls, "the reword retry should run exactly once")
+	assert.Equal(t, 2, gitcmd.logCalls, "the commit log should be read again after the reword retry")
+}
+
+// Subject whitespace is trimmed through the public stack entry point.
+func TestGetLocalCommitStackTrimsSubjectWhitespace(t *testing.T) {
+	const hash = "d89e0e460ed817c81641f32b1a506b60164b4403"
+	gitcmd := &p2pFakeGit{logText: p2pCommitLogEntry(hash, "  Supergalactic speed  ", "053f6d16")}
+	commits := GetLocalCommitStack(p2pTestConfig(), gitcmd)
+	require.Len(t, commits, 1)
+	assert.Equal(t, "Supergalactic speed", commits[0].Subject)
+}
+
+// A successful reword retry returns the complete reparsed stack.
+func TestGetLocalCommitStackReturnsRecoveredStack(t *testing.T) {
+	helperDir := p2pHelperDir(t)
+	helperPath := filepath.Join(helperDir, "spr_reword_helper")
+	require.NoError(t, os.WriteFile(helperPath, []byte("#!/bin/sh\nexit 0\n"), 0o755))
+	t.Setenv("PATH", helperDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+
+	const bottomHash = "c100000000000000000000000000000000000000"
+	const topHash = "c200000000000000000000000000000000000000"
+	bottom := p2pCommitLogEntry(bottomHash, "first", "00000001")
+	top := p2pCommitLogEntry(topHash, "WIP: second", "00000002")
+	invalidTop := strings.Replace(top, "\tcommit-id:00000002\n", "", 1)
+	gitcmd := &p2pFakeGit{logTexts: []string{invalidTop + bottom, top + bottom}}
+
+	commits := GetLocalCommitStack(p2pTestConfig(), gitcmd)
+	assert.Equal(t, []Commit{
+		{CommitID: "00000001", CommitHash: bottomHash, Subject: "first"},
+		{CommitID: "00000002", CommitHash: topHash, Subject: "WIP: second", WIP: true},
+	}, commits)
+	assert.Equal(t, 1, gitcmd.editorCalls)
+	assert.Equal(t, 2, gitcmd.logCalls)
+}
