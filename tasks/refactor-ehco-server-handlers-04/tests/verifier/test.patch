+const (
+	deadProxy        = "http://127.0.0.1:9"
+	perNodeTimeout   = 150 * time.Second
+	goTestFlagReason = "-timeout=120s"
+)
+
+type statusKind string
+
+const (
+	statusPass  statusKind = "pass"
+	statusFail  statusKind = "fail"
+	statusSkip  statusKind = "skip"
+	statusError statusKind = "error"
+)
+
+type nodeResult struct {
+	Node     node
+	Status   statusKind
+	Detail   string
+	Output   string
+	Elapsed  time.Duration
+	Selector string
+}
+
+func main() {
+	reportPath := flag.String("report", "", "JUnit XML output path (the pipeline's {report} placeholder)")
+	selectPath := flag.String("select", "", "optional selector list materialised by the pipeline; used only as a cross-check")
+	flag.Parse()
+
+	if strings.TrimSpace(*reportPath) == "" {
+		fmt.Fprintln(os.Stderr, "p2prunner: --report <path> is required")
+		os.Exit(2)
+	}
+
+	root, err := findRepoRoot()
+	if err != nil {
+		res := errorResults(fmt.Sprintf("locate repository root: %v", err))
+		if werr := writeReport(*reportPath, res); werr != nil {
+			fmt.Fprintf(os.Stderr, "p2prunner: %v (report: %v)\n", err, werr)
+			os.Exit(1)
+		}
+		fmt.Fprintf(os.Stderr, "p2prunner: %v\n", err)
+		fmt.Printf("p2prunner: 0/%d nodes passed (repository root missing)\n", len(res))
+		os.Exit(0)
+	}
+
+	if *selectPath != "" {
+		crossCheckSelectors(*selectPath)
+	}
+
+	ctx := context.Background()
+	results := make([]nodeResult, 0, len(declaredNodes))
+
+	if derr := ensureDist(root); derr != nil {
+		results = errorResults(fmt.Sprintf("materialise internal/web/webui/dist: %v", derr))
+	} else {
+		for _, n := range declaredNodes {
+			r := runNode(ctx, root, n)
+			results = append(results, r)
+			fmt.Printf("p2prunner: %-9s %s\n", r.Status, n.Selector)
+			if r.Status != statusPass {
+				fmt.Printf("p2prunner:   %s\n", firstLine(r.Detail))
+			}
+		}
+	}
+
+	if werr := writeReport(*reportPath, results); werr != nil {
+		fmt.Fprintf(os.Stderr, "p2prunner: write report %s: %v\n", *reportPath, werr)
+		os.Exit(1)
+	}
+	passed := 0
+	for _, r := range results {
+		if r.Status == statusPass {
+			passed++
+		}
+	}
+	fmt.Printf("p2prunner: %d/%d nodes passed; report written to %s\n", passed, len(results), *reportPath)
+	if passed != len(results) {
+		os.Exit(1)
+	}
+	os.Exit(0)
+}
+
+func findRepoRoot() (string, error) {
+	dir, err := os.Getwd()
+	if err != nil {
+		return "", err
+	}
+	for {
+		if b, err := os.ReadFile(filepath.Join(dir, "go.mod")); err == nil &&
+			strings.Contains(string(b), "module github.com/Ehco1996/ehco") {
+			return dir, nil
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "", fmt.Errorf("go.mod of github.com/Ehco1996/ehco not found above %s", dir)
+		}
+		dir = parent
+	}
+}
+
+// ensureDist re-creates the generated SPA embed tree on a pristine
+// checkout. internal/web/webui/dist is gitignored, so a baseline + patch
+// workspace has no UI build; the committed snapshot under
+// internal/web/tests/testdata/dist_snapshot carries the same layout
+// (index.html, favicon.svg, hashed assets) and is copied verbatim.
+func ensureDist(root string) error {
+	dst := filepath.Join(root, "internal", "web", "webui", "dist")
+	if fileExists(filepath.Join(dst, "index.html")) {
+		return nil
+	}
+	src := filepath.Join(root, "internal", "web", "tests", "testdata", "dist_snapshot")
+	if !fileExists(filepath.Join(src, "index.html")) {
+		return fmt.Errorf("neither %s nor the committed dist snapshot exist", dst)
+	}
+	if err := os.MkdirAll(dst, 0o755); err != nil {
+		return err
+	}
+	return os.CopyFS(dst, os.DirFS(src))
+}
+
+func fileExists(p string) bool {
+	fi, err := os.Stat(p)
+	return err == nil && !fi.IsDir()
+}
+
+// crossCheckSelectors reads the pipeline's selector list when it is present
+// and reports mismatches against the declared set. It never shrinks the
+// executed set: the frozen report must keep covering every declared node.
+func crossCheckSelectors(path string) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		// The placeholder may be passed verbatim when the harness does not
+		// materialise the file; that is not an error.
+		return
+	}
+	known := map[string]bool{}
+	for _, n := range declaredNodes {
+		known[n.Selector] = true
+	}
+	unknown := []string{}
+	for _, line := range strings.Split(string(b), "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		if !known[line] {
+			unknown = append(unknown, line)
+		}
+	}
+	if len(unknown) > 0 {
+		fmt.Fprintf(os.Stderr, "p2prunner: warning: %d selectors from %s are not declared: %s\n",
+			len(unknown), path, strings.Join(unknown, ", "))
+	}
+}
+
+type goTestEvent struct {
+	Action  string  `json:"Action"`
+	Test    string  `json:"Test"`
+	Output  string  `json:"Output"`
+	Elapsed float64 `json:"Elapsed"`
+	Package string  `json:"Package"`
+}
+
+func runNode(parent context.Context, root string, n node) nodeResult {
+	ctx, cancel := context.WithTimeout(parent, perNodeTimeout)
+	defer cancel()
+
+	cmd := exec.CommandContext(ctx, "go", "test", "-json", "-count=1", goTestFlagReason,
+		"-run", "^"+regexp.QuoteMeta(n.Leaf)+"$", n.Pkg)
+	cmd.Dir = root
+	cmd.Env = childEnv()
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+
+	start := time.Now()
+	runErr := cmd.Run()
+	elapsed := time.Since(start)
+
+	res := nodeResult{Node: n, Selector: n.Selector, Status: statusError, Elapsed: elapsed}
+	var out strings.Builder
+	var status statusKind
+	for _, line := range strings.Split(stdout.String(), "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		var ev goTestEvent
+		if err := json.Unmarshal([]byte(line), &ev); err != nil {
+			out.WriteString(line)
+			out.WriteString("\n")
+			continue
+		}
+		out.WriteString(ev.Output)
+		if ev.Test == n.Leaf {
+			switch ev.Action {
+			case "pass":
+				status = statusPass
+				res.Elapsed = time.Duration(ev.Elapsed * float64(time.Second))
+			case "fail":
+				status = statusFail
+				res.Elapsed = time.Duration(ev.Elapsed * float64(time.Second))
+			case "skip":
+				status = statusSkip
+				res.Elapsed = time.Duration(ev.Elapsed * float64(time.Second))
+			}
+		}
+	}
+	res.Output = clamp(out.String(), 16*1024)
+
+	if ctx.Err() != nil || regexp.MustCompile(`(?m)^(panic:|fatal error:)`).MatchString(out.String()+stderr.String()) {
+		res.Status = statusError
+		res.Detail = "go test process crash"
+		if ctx.Err() != nil {
+			res.Detail = "go test timed out"
+		}
+		res.Output = clamp(res.Output+"\n"+stderr.String(), 16*1024)
+		return res
+	}
+
+	switch {
+	case status == statusPass:
+		res.Status = statusPass
+		res.Detail = "passed"
+	case status == statusFail:
+		res.Status = statusFail
+		res.Detail = "go test reported the node as failed"
+		res.Output = clamp(res.Output+"\n"+stderr.String(), 16*1024)
+	case status == statusSkip:
+		res.Status = statusSkip
+		res.Detail = "go test reported the node as skipped"
+	default:
+		res.Status = statusError
+		detail := "node produced no result"
+		if runErr != nil {
+			detail = "go test invocation failed: " + runErr.Error()
+		} else if strings.Contains(out.String(), "build failed") {
+			detail = "package build failed"
+		}
+		res.Detail = detail
+		res.Output = clamp(res.Output+"\n"+stderr.String()+"\n"+firstLine(runErr.Error()), 16*1024)
+	}
+	if res.Status != statusPass {
+		fmt.Fprintf(os.Stderr, "p2prunner[%s]: %s\n", n.Selector, firstLine(res.Detail))
+	}
+	return res
+}
+
+func childEnv() []string {
+	env := os.Environ()
+	env = append(env,
+		"HTTP_PROXY="+deadProxy, "HTTPS_PROXY="+deadProxy, "ALL_PROXY="+deadProxy,
+		"NO_PROXY=127.0.0.1,localhost",
+		"GOTOOLCHAIN=local",
+	)
+	return env
+}
+
+func errorResults(detail string) []nodeResult {
+	res := make([]nodeResult, 0, len(declaredNodes))
+	for _, n := range declaredNodes {
+		res = append(res, nodeResult{Node: n, Selector: n.Selector, Status: statusError, Detail: detail, Output: detail})
+	}
+	return res
+}
+
+type xmlMessage struct {
+	Message string `xml:"message,attr"`
+	Type    string `xml:"type,attr,omitempty"`
+	Text    string `xml:",chardata"`
+}
+
+type xmlCase struct {
+	Classname string      `xml:"classname,attr"`
+	Name      string      `xml:"name,attr"`
+	File      string      `xml:"file,attr,omitempty"`
+	Time      string      `xml:"time,attr"`
+	Failure   *xmlMessage `xml:"failure,omitempty"`
+	Error     *xmlMessage `xml:"error,omitempty"`
+	Skipped   *xmlMessage `xml:"skipped,omitempty"`
+	SystemOut string      `xml:"system-out,omitempty"`
+}
+
+type xmlSuite struct {
+	Name      string    `xml:"name,attr"`
+	Tests     int       `xml:"tests,attr"`
+	Failures  int       `xml:"failures,attr"`
+	Errors    int       `xml:"errors,attr"`
+	Skipped   int       `xml:"skipped,attr"`
+	Time      string    `xml:"time,attr"`
+	Timestamp string    `xml:"timestamp,attr"`
+	Cases     []xmlCase `xml:"testcase"`
+}
+
+type xmlSuites struct {
+	XMLName  xml.Name   `xml:"testsuites"`
+	Name     string     `xml:"name,attr"`
+	Tests    int        `xml:"tests,attr"`
+	Failures int        `xml:"failures,attr"`
+	Errors   int        `xml:"errors,attr"`
+	Skipped  int        `xml:"skipped,attr"`
+	Time     string     `xml:"time,attr"`
+	Suites   []xmlSuite `xml:"testsuite"`
+}
+
+func writeReport(path string, results []nodeResult) error {
+	suite := xmlSuite{
+		Name:      "ehco-web-server-p2p",
+		Timestamp: time.Now().UTC().Format(time.RFC3339),
+	}
+	var total time.Duration
+	for _, r := range results {
+		file := r.Selector
+		if i := strings.Index(file, "::"); i >= 0 {
+			file = file[:i]
+		}
+		c := xmlCase{
+			Classname: file,
+			Name:      r.Node.Leaf,
+			File:      file,
+			Time:      fmt.Sprintf("%.3f", r.Elapsed.Seconds()),
+			SystemOut: "selector: " + r.Selector + "\n" + r.Output,
+		}
+		switch r.Status {
+		case statusPass:
+			// no child element
+		case statusFail:
+			suite.Failures++
+			c.Failure = &xmlMessage{Message: r.Detail, Type: "AssertionFailure", Text: r.Output}
+		case statusSkip:
+			suite.Skipped++
+			c.Skipped = &xmlMessage{Message: r.Detail, Text: r.Output}
+		default:
+			suite.Errors++
+			c.Error = &xmlMessage{Message: r.Detail, Type: "not-run", Text: r.Output}
+		}
+		total += r.Elapsed
+		suite.Cases = append(suite.Cases, c)
+	}
+	suite.Tests = len(suite.Cases)
+	suite.Time = fmt.Sprintf("%.3f", total.Seconds())
+
+	out := xmlSuites{
+		Name:     suite.Name,
+		Tests:    suite.Tests,
+		Failures: suite.Failures,
+		Errors:   suite.Errors,
+		Skipped:  suite.Skipped,
+		Time:     suite.Time,
+		Suites:   []xmlSuite{suite},
+	}
+	body, err := xml.MarshalIndent(out, "", "  ")
+	if err != nil {
+		return err
+	}
+	doc := append([]byte(xml.Header), body...)
+	doc = append(doc, '\n')
+	if dir := filepath.Dir(path); dir != "" {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			return err
+		}
+	}
+	return os.WriteFile(path, doc, 0o644)
+}
+
+func clamp(s string, max int) string {
+	if len(s) <= max {
+		return s
+	}
+	return s[:max] + "\n... (truncated)"
+}
+
+func firstLine(s string) string {
+	s = strings.TrimSpace(s)
+	if i := strings.IndexByte(s, '\n'); i >= 0 {
+		s = s[:i]
+	}
+	if len(s) > 400 {
+		s = s[:400] + "..."
+	}
+	return s
+}
