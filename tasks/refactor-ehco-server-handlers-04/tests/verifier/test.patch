+func TestP2P_WebSocket_LogsBroadcast(t *testing.T) {
+	if err := ehcolog.InitGlobalLogger("info"); err != nil {
+		t.Fatalf("InitGlobalLogger: %v", err)
+	}
+	e := p2pStart(t, p2pOpts{cfg: &config.Config{}})
+
+	// A non-upgrade request must not succeed and must not be answered by the
+	// SPA fallback: /ws/logs is a real upgrade endpoint.
+	st, _, body := e.do(http.MethodGet, "/ws/logs", nil)
+	if st == http.StatusOK || st == http.StatusNotFound || strings.Contains(string(body), p2pShellMark) {
+		t.Fatalf("plain GET /ws/logs = %d %q, want the websocket handler to reject the non-upgrade request", st, string(body))
+	}
+
+	wsURL := "ws" + strings.TrimPrefix(e.base, "http") + "/ws/logs"
+	connA, brA, _, err := ws.Dial(context.Background(), wsURL)
+	if err != nil {
+		t.Fatalf("dial /ws/logs (ws.Dial returns an error for any non-101 handshake): %v", err)
+	}
+	defer connA.Close()
+	p2pAwaitLogSubscription(t, connA, brA)
+
+	probeA := fmt.Sprintf("p2p-ws-probe-a-%d", time.Now().UnixNano())
+	zap.L().Info(probeA)
+	p2pReadProbe(t, connA, brA, probeA)
+
+	connB, brB, _, err := ws.Dial(context.Background(), wsURL)
+	if err != nil {
+		t.Fatalf("dial second /ws/logs: %v", err)
+	}
+	defer connB.Close()
+	p2pAwaitLogSubscription(t, connB, brB)
+
+	probeB := fmt.Sprintf("p2p-ws-probe-b-%d", time.Now().UnixNano())
+	zap.L().Info(probeB)
+	p2pReadProbe(t, connA, brA, probeB)
+	p2pReadProbe(t, connB, brB, probeB)
+
+	// A client that dies must not take the remaining subscribers with it.
+	connA.Close()
+	probeC := fmt.Sprintf("p2p-ws-probe-c-%d", time.Now().UnixNano())
+	zap.L().Info(probeC)
+	p2pReadProbe(t, connB, brB, probeC)
+
+	probeD := fmt.Sprintf("p2p-ws-write-failure-%d", time.Now().UnixNano())
+	broken := &p2pBrokenSubscriber{marker: probeD}
+	ehcolog.AddWebSocketConn(broken)
+	defer ehcolog.RemoveWebSocketConn(broken)
+	zap.L().Info(probeD)
+	p2pReadProbe(t, connB, brB, probeD)
+	if writes, closes := broken.failures(); writes != 1 || closes != 1 {
+		t.Fatalf("failed log subscriber was not closed: writes=%d closes=%d", writes, closes)
+	}
+	probeE := fmt.Sprintf("p2p-ws-after-write-failure-%d", time.Now().UnixNano())
+	zap.L().Info(probeE)
+	p2pReadProbe(t, connB, brB, probeE)
+	if writes, closes := broken.failures(); writes != 1 || closes != 1 {
+		t.Fatalf("failed log subscriber remained registered: writes=%d closes=%d", writes, closes)
+	}
+}
+
+type p2pBrokenSubscriber struct {
+	net.Conn
+	marker       string
+	mu           sync.Mutex
+	failedWrites int
+	closeCalls   int
+}
+
+func (connection *p2pBrokenSubscriber) Write(payload []byte) (int, error) {
+	connection.mu.Lock()
+	defer connection.mu.Unlock()
+	if connection.failedWrites > 0 || bytes.Contains(payload, []byte(connection.marker)) {
+		connection.failedWrites++
+		return 0, errors.New("controlled WebSocket subscriber write failure")
+	}
+	return len(payload), nil
+}
+
+func (connection *p2pBrokenSubscriber) Close() error {
+	connection.mu.Lock()
+	defer connection.mu.Unlock()
+	connection.closeCalls++
+	return nil
+}
+
+func (connection *p2pBrokenSubscriber) failures() (int, int) {
+	connection.mu.Lock()
+	defer connection.mu.Unlock()
+	return connection.failedWrites, connection.closeCalls
+}
+
+func p2pReadProbe(t *testing.T, conn net.Conn, br *bufio.Reader, needle string) {
+	t.Helper()
+	// gobwas returns a buffered reader only when the handshake response
+	// carried more bytes than the header block; fall back to the raw conn.
+	var r io.Reader = conn
+	if br != nil {
+		r = br
+	}
+	deadline := time.Now().Add(10 * time.Second)
+	for time.Now().Before(deadline) {
+		_ = conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+		f, err := ws.ReadFrame(r)
+		if err != nil {
+			if ne, ok := err.(net.Error); ok && ne.Timeout() {
+				continue
+			}
+			t.Fatalf("read ws frame while waiting for %q: %v", needle, err)
+		}
+		if strings.Contains(string(f.Payload), needle) {
+			return
+		}
+	}
+	t.Fatalf("log line %q was never broadcast to the websocket client", needle)
+}
+
+func min(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+func p2pJSONEqual(test *testing.T, label string, actual []byte, expected any) {
+	test.Helper()
+	expectedJSON, err := json.Marshal(expected)
+	if err != nil {
+		test.Fatalf("marshal expected %s: %v", label, err)
+	}
+	var actualValue, expectedValue any
+	if err := json.Unmarshal(actual, &actualValue); err != nil {
+		test.Fatalf("decode actual %s: %v", label, err)
+	}
+	if err := json.Unmarshal(expectedJSON, &expectedValue); err != nil {
+		test.Fatalf("decode expected %s: %v", label, err)
+	}
+	if !reflect.DeepEqual(actualValue, expectedValue) {
+		test.Fatalf("%s payload changed: got %s want %s", label, actual, expectedJSON)
+	}
+}
+
+func p2pRequestContext(test *testing.T, captured context.Context) {
+	test.Helper()
+	if captured == nil || captured.Done() == nil {
+		test.Fatal("source did not receive the HTTP request context")
+	}
+	select {
+	case <-captured.Done():
+	case <-time.After(time.Second):
+		test.Fatal("source context outlived the completed HTTP request")
+	}
+}
+
+// HTTP 101 can reach the client before AddWebSocketConn executes. Readiness
+// probes retry only setup; all delivery/fanout/removal assertions stay one-shot.
+func p2pAwaitLogSubscription(t *testing.T, conn net.Conn, br *bufio.Reader) {
+	t.Helper()
+	marker := fmt.Sprintf("p2p-ws-ready-%d", time.Now().UnixNano())
+	stop, done := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		ticker := time.NewTicker(25 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			zap.L().Info(marker)
+			select {
+			case <-stop:
+				return
+			case <-ticker.C:
+			}
+		}
+	}()
+	defer func() { close(stop); <-done }()
+	p2pReadProbe(t, conn, br, marker)
+}
