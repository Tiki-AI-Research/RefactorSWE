+)
+
+// Import the candidate's real dependency export data. Type aliases and generic
+// arguments are resolved by Go, not by matching a rendered field declaration.
+func (p *pkgInfo) loadSemanticTypes(t testing.TB) {
+	p.tb = t
+	cmd := exec.Command("go", "list", "-mod=readonly", "-deps", "-export", "-json", "./internal/web")
+	cmd.Dir = p.root
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	raw, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("infrastructure error: load Go type data: %v: %s", err, stderr.String())
+	}
+	exports := map[string]string{}
+	active := map[string]bool{}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	for {
+		var item struct {
+			ImportPath, Export, Dir string
+			GoFiles, CgoFiles       []string
+		}
+		err := dec.Decode(&item)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("infrastructure error: decode Go export inventory: %v", err)
+		}
+		exports[item.ImportPath] = item.Export
+		if item.ImportPath == "github.com/Ehco1996/ehco/internal/web" {
+			for _, name := range append(item.GoFiles, item.CgoFiles...) {
+				active[filepath.Base(name)] = true
+			}
+		}
+	}
+	if len(active) == 0 {
+		t.Fatal("infrastructure error: missing active web source inventory")
+	}
+	files := p.files[:0]
+	for _, f := range p.files {
+		if active[p.fileByPos[f]] {
+			files = append(files, f)
+		}
+	}
+	p.files = files
+	imp := importer.ForCompiler(p.fset, "gc", func(path string) (io.ReadCloser, error) {
+		name := exports[path]
+		if name == "" {
+			return nil, fmt.Errorf("missing export data for %s", path)
+		}
+		return os.Open(name)
+	})
+	p.typeInfo = &types.Info{Types: map[ast.Expr]types.TypeAndValue{}, Defs: map[*ast.Ident]types.Object{}, Uses: map[*ast.Ident]types.Object{}, Selections: map[*ast.SelectorExpr]*types.Selection{}}
+	cfg := types.Config{Importer: imp}
+	p.typePkg, err = cfg.Check("github.com/Ehco1996/ehco/internal/web", p.fset, p.files, p.typeInfo)
+	if err != nil {
+		t.Fatalf("infrastructure error: type-check web ownership: %v", err)
+	}
+	p.contracts = map[string]types.Type{}
+	for _, spec := range []struct{ label, path, name string }{
+		{"cmgr.Cmgr", "github.com/Ehco1996/ehco/internal/cmgr", "Cmgr"},
+		{"config.Config", "github.com/Ehco1996/ehco/internal/config", "Config"},
+		{"glue.Reloader", "github.com/Ehco1996/ehco/internal/glue", "Reloader"},
+		{"glue.HealthChecker", "github.com/Ehco1996/ehco/internal/glue", "HealthChecker"},
+		{"echo.Echo", "github.com/labstack/echo/v4", "Echo"},
+		{"atomic.Pointer", "sync/atomic", "Pointer"},
+	} {
+		pkg, err := imp.Import(spec.path)
+		if err != nil {
+			t.Fatalf("infrastructure error: import contract %s: %v", spec.path, err)
+		}
+		obj := pkg.Scope().Lookup(spec.name)
+		if obj == nil {
+			t.Fatalf("infrastructure error: contract %s missing", spec.label)
+		}
+		p.contracts[spec.label] = obj.Type()
+	}
+	for _, name := range []string{"Server", "authenticator"} {
+		if obj := p.typePkg.Scope().Lookup(name); obj != nil {
+			p.contracts[name] = obj.Type()
+		}
+	}
+}
+
+func unpoint(typ types.Type) types.Type {
+	for {
+		typ = types.Unalias(typ)
+		ptr, ok := typ.(*types.Pointer)
+		if !ok {
+			return typ
+		}
+		typ = ptr.Elem()
+	}
+}
+func semanticTypeText(typ types.Type) string {
+	return types.TypeString(typ, func(pkg *types.Package) string { return pkg.Name() })
+}
+func sameNamedOrigin(a, b types.Type) bool {
+	x, xok := unpoint(a).(*types.Named)
+	y, yok := unpoint(b).(*types.Named)
+	return xok && yok && x.Origin().Obj() == y.Origin().Obj()
+}
+func coversInterface(actual, contract *types.Interface) bool {
+	actual.Complete()
+	contract.Complete()
+	if contract.NumMethods() == 0 {
+		return false
+	}
+	for i := 0; i < contract.NumMethods(); i++ {
+		expected := contract.Method(i)
+		found := false
+		for j := 0; j < actual.NumMethods(); j++ {
+			got := actual.Method(j)
+			if got.Id() == expected.Id() && types.Identical(got.Type(), expected.Type()) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+func (p *pkgInfo) fieldType(si *structInfo, field fieldInfo) types.Type {
+	if fields := p.syntheticFields[si.name]; fields != nil {
+		return fields[field.name]
+	}
+	obj := p.typePkg.Scope().Lookup(si.name)
+	if obj == nil {
+		p.tb.Fatalf("infrastructure error: missing type for %s", si.name)
+	}
+	st, ok := unpoint(obj.Type()).Underlying().(*types.Struct)
+	if !ok {
+		p.tb.Fatalf("infrastructure error: nonstruct owner %s", si.name)
+	}
+	for i := 0; i < st.NumFields(); i++ {
+		if st.Field(i).Name() == field.name {
+			return st.Field(i).Type()
+		}
+	}
+	p.tb.Fatalf("infrastructure error: missing semantic field %s.%s", si.name, field.name)
+	return nil
+}
+func (p *pkgInfo) fieldContractLabels(si *structInfo, field fieldInfo) string {
+	typ := unpoint(p.fieldType(si, field))
+	var labels []string
+	for label, contract := range p.contracts {
+		known := unpoint(contract)
+		match := sameNamedOrigin(typ, known) || types.Identical(typ, known)
+		if actual, ok := typ.Underlying().(*types.Interface); ok {
+			if expected, ok := known.Underlying().(*types.Interface); ok {
+				match = match || coversInterface(actual, expected)
+			}
+		} else if _, ok := known.Underlying().(*types.Struct); ok {
+			// A new named type with the entire public Config/Server shape remains wide.
+			if label == "config.Config" || label == "Server" {
+				match = match || types.Identical(typ.Underlying(), known.Underlying())
+			}
+		}
+		if match {
+			labels = append(labels, label)
+		}
+	}
+	// A local optional-holder struct is not its type argument. Its own methods
+	// and state are distinct from a direct business interface or raw atomic slot.
+	return strings.Join(labels, " ")
+}
+func (p *pkgInfo) semanticReceiver(sel *ast.SelectorExpr) string {
+	if selection := p.typeInfo.Selections[sel]; selection != nil {
+		if fn, ok := selection.Obj().(*types.Func); ok {
+			sig := fn.Type().(*types.Signature)
+			if sig.Recv() != nil {
+				return semanticTypeText(sig.Recv().Type())
+			}
+		}
+	}
+	if typ := p.typeInfo.TypeOf(sel.X); typ != nil {
+		return semanticTypeText(typ)
+	}
+	return ""
+}
+
+// Permissions come from the routes the owner actually serves, never its name
+// or a fixed count of families. Wide Config/manager dependencies remain wide.
+func (p *pkgInfo) ownerForbidden(si *structInfo) []string {
+	owned := map[string]bool{}
+	for _, family := range handlerFamilies {
+		for _, owner := range p.familyTypes(family) {
+			if owner == si.name {
+				owned[family.name] = true
+			}
+		}
+	}
+	result := []string{reCMGR, reServerType, reEchoEngine}
+	if !owned["config"] {
+		result = append(result, reReloader)
+	}
+	if !owned["health_check"] {
+		result = append(result, reHealth)
+	}
+	if !owned["auth"] {
+		result = append(result, reAuthentic)
+	}
+	if (!owned["auth"] && !owned["config"]) || owned["health_check"] || owned["node_metrics"] || owned["overview"] {
+		result = append(result, reConfig)
+	}
+	return result
+}
diff --git a/tests/f2p/closure_ownership_test.go b/tests/f2p/closure_ownership_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2b7e1e98986a15290fc62f557b67bf5cb99a1a42
--- /dev/null
+++ b/tests/f2p/closure_ownership_test.go
@@ -0,0 +1,176 @@
+package f2p
+
+import (
+	"fmt"
+	"go/ast"
+	"go/types"
+)
+
+func (p *pkgInfo) valueObject(expr ast.Expr) types.Object {
+	switch e := expr.(type) {
+	case *ast.Ident:
+		return p.typeInfo.ObjectOf(e)
+	case *ast.SelectorExpr:
+		if s := p.typeInfo.Selections[e]; s != nil {
+			return s.Obj()
+		}
+		return p.typeInfo.ObjectOf(e.Sel)
+	case *ast.ParenExpr:
+		return p.valueObject(e.X)
+	}
+	return nil
+}
+func (p *pkgInfo) buildHandlerSources() {
+	p.valueSources = map[types.Object][]ast.Expr{}
+	p.functionDecls = map[types.Object]*ast.FuncDecl{}
+	p.syntheticFields = map[string]map[string]types.Type{}
+	add := func(obj types.Object, value ast.Expr) {
+		if obj != nil {
+			p.valueSources[obj] = append(p.valueSources[obj], value)
+		}
+	}
+	for _, fn := range p.funcs {
+		p.functionDecls[p.typeInfo.ObjectOf(fn.decl.Name)] = fn.decl
+	}
+	for _, file := range p.files {
+		ast.Inspect(file, func(node ast.Node) bool {
+			switch n := node.(type) {
+			case *ast.AssignStmt:
+				for i, lhs := range n.Lhs {
+					if i < len(n.Rhs) {
+						add(p.valueObject(lhs), n.Rhs[i])
+					}
+				}
+			case *ast.ValueSpec:
+				for i, id := range n.Names {
+					if i < len(n.Values) {
+						add(p.typeInfo.ObjectOf(id), n.Values[i])
+					}
+				}
+			case *ast.CompositeLit:
+				typ := p.typeInfo.TypeOf(n)
+				if typ == nil {
+					break
+				}
+				st, ok := unpoint(typ).Underlying().(*types.Struct)
+				if !ok {
+					break
+				}
+				for i, element := range n.Elts {
+					value := element
+					if kv, ok := element.(*ast.KeyValueExpr); ok {
+						id, ok := kv.Key.(*ast.Ident)
+						if !ok {
+							continue
+						}
+						value = kv.Value
+						for j := 0; j < st.NumFields(); j++ {
+							if st.Field(j).Name() == id.Name {
+								add(st.Field(j), value)
+							}
+						}
+					} else if i < st.NumFields() {
+						add(st.Field(i), value)
+					}
+				}
+			case *ast.CallExpr:
+				if fn, ok := p.valueObject(n.Fun).(*types.Func); ok {
+					sig := fn.Type().(*types.Signature)
+					for i, arg := range n.Args {
+						if i >= sig.Params().Len() {
+							break
+						}
+						param := sig.Params().At(i)
+						if _, ok := param.Type().Underlying().(*types.Signature); ok {
+							add(param, arg)
+						}
+					}
+				}
+			}
+			return true
+		})
+	}
+}
+
+// Resolve the value that will actually handle the request. A function-valued
+// routing field is storage, not the owner of the closure's captured state.
+func (p *pkgInfo) handlerOwners(expr ast.Expr, seen map[ast.Expr]bool) []string {
+	if expr == nil || seen[expr] {
+		return nil
+	}
+	seen[expr] = true
+	var result []string
+	follow := func(value ast.Expr) { result = append(result, p.handlerOwners(value, seen)...) }
+	switch e := expr.(type) {
+	case *ast.ParenExpr:
+		follow(e.X)
+	case *ast.FuncLit:
+		result = append(result, p.captureOwner(e, e.Body))
+	case *ast.CallExpr:
+		if decl := p.functionDecls[p.valueObject(e.Fun)]; decl != nil && decl.Body != nil {
+			ast.Inspect(decl.Body, func(node ast.Node) bool {
+				if _, ok := node.(*ast.FuncLit); ok {
+					return false
+				}
+				if r, ok := node.(*ast.ReturnStmt); ok {
+					for _, value := range r.Results {
+						follow(value)
+					}
+				}
+				return true
+			})
+		} else if _, ok := p.typeInfo.Types[e.Fun]; ok && len(e.Args) == 1 {
+			// Named function-type conversion preserves the underlying callable.
+			if p.typeInfo.Types[e.Fun].IsType() {
+				follow(e.Args[0])
+			}
+		}
+	case *ast.SelectorExpr:
+		if selection := p.typeInfo.Selections[e]; selection != nil && selection.Kind() == types.MethodVal {
+			result = append(result, p.semanticReceiver(e))
+		} else {
+			for _, value := range p.valueSources[p.valueObject(e)] {
+				follow(value)
+			}
+		}
+	case *ast.Ident:
+		if decl := p.functionDecls[p.valueObject(e)]; decl != nil && decl.Body != nil {
+			result = append(result, p.captureOwner(decl, decl.Body))
+		} else {
+			for _, value := range p.valueSources[p.valueObject(e)] {
+				follow(value)
+			}
+		}
+	}
+	return result
+}
+func (p *pkgInfo) captureOwner(scope ast.Node, body *ast.BlockStmt) string {
+	name := fmt.Sprintf("closure_%d", scope.Pos())
+	if p.structs[name] != nil {
+		return name
+	}
+	si := &structInfo{name: name, file: p.fset.Position(scope.Pos()).Filename}
+	fields := map[string]types.Type{}
+	ast.Inspect(body, func(node ast.Node) bool {
+		id, ok := node.(*ast.Ident)
+		if !ok {
+			return true
+		}
+		obj, ok := p.typeInfo.Uses[id].(*types.Var)
+		if !ok || obj.IsField() {
+			return true
+		}
+		if obj.Pos() >= scope.Pos() && obj.Pos() < scope.End() {
+			return true
+		}
+		key := fmt.Sprintf("%s_%d", obj.Name(), obj.Pos())
+		if fields[key] == nil {
+			fields[key] = obj.Type()
+			si.fields = append(si.fields, fieldInfo{name: key, typ: semanticTypeText(obj.Type())})
+		}
+		return true
+	})
+	p.syntheticFields[name] = fields
+	p.structs[name] = si
+	return name
+}
diff --git a/internal/web/tests/p2p_db_precedence_test.go b/internal/web/tests/p2p_db_precedence_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..61666d09b767c9845bf50b138f89213768db020d
--- /dev/null
+++ b/internal/web/tests/p2p_db_precedence_test.go
@@ -0,0 +1,91 @@
+package tests
+
+import (
+	"fmt"
+	"github.com/Ehco1996/ehco/internal/config"
+	"github.com/Ehco1996/ehco/internal/glue"
+	"github.com/Ehco1996/ehco/internal/web"
+	"github.com/prometheus/client_golang/prometheus"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+type auditHTTP struct {
+	server *web.Server
+	url    string
+	client *http.Client
+}
+
+func auditStart(t *testing.T, cfg *config.Config, relay glue.Reloader) *auditHTTP {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.WebHost = "127.0.0.1"
+	cfg.WebPort = listener.Addr().(*net.TCPAddr).Port
+	listener.Close()
+	registry := prometheus.NewRegistry()
+	prometheus.DefaultRegisterer = registry
+	prometheus.DefaultGatherer = registry
+	server, err := web.NewServer(cfg, relay, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := &auditHTTP{server: server, url: fmt.Sprintf("http://127.0.0.1:%d", cfg.WebPort), client: &http.Client{Timeout: 2 * time.Second}}
+	done := make(chan error, 1)
+	go func() { done <- server.Start() }()
+	t.Cleanup(func() {
+		server.Stop()
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+			t.Error("listener failed to stop")
+		}
+	})
+	for deadline := time.Now().Add(5 * time.Second); time.Now().Before(deadline); time.Sleep(10 * time.Millisecond) {
+		response, err := h.client.Get(h.url + "/api/v1/auth/info")
+		if err == nil {
+			io.Copy(io.Discard, response.Body)
+			response.Body.Close()
+			return h
+		}
+	}
+	t.Fatal("HTTP listener did not start")
+	return nil
+}
+func (h *auditHTTP) request(t *testing.T, method, path, body, token string) (int, []byte) {
+	t.Helper()
+	request, err := http.NewRequest(method, h.url+path, strings.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Header.Set("Content-Type", "application/json")
+	if token != "" {
+		request.Header.Set("X-Ehco-Token", token)
+	}
+	response, err := h.client.Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	data, err := io.ReadAll(response.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return response.StatusCode, data
+}
+func TestP2P_DBMalformedInputPrecedesMissingBackend(t *testing.T) {
+	h := auditStart(t, &config.Config{}, nil)
+	for _, path := range []string{"/api/v1/db/cleanup", "/api/v1/db/truncate"} {
+		status, body := h.request(t, "POST", path, `{"broken":`, "")
+		t.Logf("%s -> %d %s", path, status, body)
+		if status != 400 {
+			t.Errorf("malformed JSON must keep the preexisting 400 before consulting an absent backend; got %d", status)
+		}
+	}
+}
