+func TestP2P_Auth_SessionLoginLogout(t *testing.T) {
+	e := p2pStart(t, p2pOpts{cfg: &config.Config{DashboardPass: p2pPassword}})
+
+	st, _, _ := e.do(http.MethodGet, "/api/v1/version", nil)
+	p2pWant(t, "anonymous protected route", st, http.StatusUnauthorized)
+
+	st, _, _ = e.do(http.MethodPost, "/api/v1/auth/login", p2pJSONReq(http.MethodPost, "/api/v1/auth/login", `{"password":`))
+	p2pWant(t, "login with malformed body", st, http.StatusBadRequest)
+
+	st, _, _ = e.do(http.MethodPost, "/api/v1/auth/login", p2pJSONReq(http.MethodPost, "/api/v1/auth/login", `{"password":"wrong"}`))
+	p2pWant(t, "login with wrong password", st, http.StatusUnauthorized)
+
+	st, hdr, body := e.do(http.MethodPost, "/api/v1/auth/login", p2pJSONReq(http.MethodPost, "/api/v1/auth/login", `{"password":"`+p2pPassword+`"}`))
+	p2pWant(t, "login with correct password", st, http.StatusOK)
+	m := p2pJSON(t, "login", body)
+	if v := p2pKey(t, "login", m, "authenticated"); v != true {
+		t.Fatalf("login body authenticated = %v, want true", v)
+	}
+	sid := p2pFindCookie(t, "login", hdr, "ehco_sid")
+	if sid.Value == "" {
+		t.Fatal("login did not issue a non-empty ehco_sid session cookie")
+	}
+	if !sid.HttpOnly {
+		t.Fatal("session cookie must stay HttpOnly")
+	}
+	session := &http.Cookie{Name: "ehco_sid", Value: sid.Value}
+
+	st, _, _ = e.do(http.MethodGet, "/api/v1/version", &p2pReq{cookies: []*http.Cookie{session}})
+	p2pWant(t, "protected route with session cookie", st, http.StatusOK)
+
+	st, outHdr, body := e.do(http.MethodPost, "/api/v1/auth/logout", &p2pReq{cookies: []*http.Cookie{session}})
+	p2pWant(t, "logout", st, http.StatusOK)
+	m = p2pJSON(t, "logout", body)
+	if v := p2pKey(t, "logout", m, "authenticated"); v != false {
+		t.Fatalf("logout body authenticated = %v, want false", v)
+	}
+	cleared := p2pFindCookie(t, "logout", outHdr, "ehco_sid")
+	if cleared.Value != "" {
+		t.Fatalf("logout must clear the session cookie, got value %q", cleared.Value)
+	}
+
+	st, _, _ = e.do(http.MethodGet, "/api/v1/version", &p2pReq{cookies: []*http.Cookie{session}})
+	p2pWant(t, "revoked session", st, http.StatusUnauthorized)
+
+	st, _, body = e.do(http.MethodPost, "/api/v1/auth/logout", nil)
+	p2pWant(t, "logout while unauthenticated", st, http.StatusOK)
