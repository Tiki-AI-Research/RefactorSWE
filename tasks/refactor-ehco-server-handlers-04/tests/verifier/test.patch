+func TestP2P_Reload_NonBlockingSideEffects(t *testing.T) {
+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	defer unblock()
+	relay := &p2pFakeReloader{started: make(chan bool, 1), release: release}
+	xray := &p2pFakeReloader{started: make(chan bool, 1)}
+	e := p2pStart(t, p2pOpts{cfg: &config.Config{}, relay: relay})
+	e.srv.SetXrayReloader(xray)
+
+	start := time.Now()
+	st, _, body := e.do(http.MethodPost, "/api/v1/config/reload/", nil)
+	elapsed := time.Since(start)
+	p2pWant(t, "reload", st, http.StatusOK)
+	if string(body) != "reload success" {
+		t.Fatalf("reload body = %q, want %q", string(body), "reload success")
+	}
+	if elapsed > time.Second {
+		t.Fatalf("reload response blocked on the reload hook for %s; it must not wait for completion", elapsed)
+	}
+	select {
+	case force := <-relay.started:
+		if !force {
+			t.Fatal("relay reload must receive force=true")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("wired relay reloader was not called")
+	}
+	select {
+	case <-xray.started:
+		t.Fatal("xray reload ran before the relay reloader finished")
+	default:
+	}
+	unblock()
+	select {
+	case force := <-xray.started:
+		if !force {
+			t.Fatal("xray reload must receive force=true")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("late-wired xray reloader was not called")
+	}
+}
