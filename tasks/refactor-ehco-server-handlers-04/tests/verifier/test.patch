+type contextKey struct{}
+
+func TestUpdateCheck(test *testing.T) {
+	engine := newEngine(test, "")
+	expected := &updater.CheckResult{Channel: "probe-channel", LatestVersion: "probe-version", ReleaseName: "probe-release", UpdateAvailable: true}
+	expectedValue := *expected
+	for _, selection := range []struct{ path, channel string }{
+		{"/api/v1/update/check", updater.ChannelAuto},
+		{"/api/v1/update/check?channel=nightly", updater.ChannelNightly},
+	} {
+		called := false
+		updater.ContractCheck = func(ctx context.Context, channel, version, revision string) (*updater.CheckResult, error) {
+			called = true
+			if channel != selection.channel || version != constant.Version || revision != constant.GitRevision || ctx.Value(contextKey{}) != "request-context" {
+				test.Fatalf("update/check parameters changed: %q %q %q context=%v", channel, version, revision, ctx.Value(contextKey{}))
+			}
+			return expected, nil
+		}
+		ctx := context.WithValue(context.Background(), contextKey{}, "request-context")
+		response := request(engine, http.MethodGet, selection.path, "", nil, ctx)
+		if !called || response.Code != http.StatusOK {
+			test.Fatalf("update/check did not call its source successfully: %d %s", response.Code, response.Body.String())
+		}
+		var actual updater.CheckResult
+		if err := json.Unmarshal(response.Body.Bytes(), &actual); err != nil || !reflect.DeepEqual(actual, expectedValue) {
+			test.Fatalf("update/check source payload changed: %s", response.Body.String())
+		}
+	}
+}
+
+func TestUpdatePlatform(test *testing.T) {
+	fixture.GOOS = "darwin"
+	engine := newEngine(test, "")
+	called := make(chan struct{}, 1)
+	updater.ContractApply = func(context.Context, updater.ApplyOptions, string, string, *zap.SugaredLogger) error {
+		called <- struct{}{}
+		return nil
+	}
+	response := request(engine, http.MethodPost, "/api/v1/update/apply", `{"force":true}`, nil, nil)
+	if response.Code != http.StatusBadRequest {
+		test.Fatalf("non-Linux update was not rejected: %d", response.Code)
+	}
+	select {
+	case <-called:
+		test.Fatal("non-Linux request executed the update")
+	case <-time.After(50 * time.Millisecond):
+	}
+}
+
+type applyCall struct {
+	options  updater.ApplyOptions
+	version  string
+	revision string
+	ctx      context.Context
+}
+
+func TestUpdateApply(test *testing.T) {
+	fixture.GOOS = "linux"
+	engine := newEngine(test, "")
+	for _, scenario := range []struct {
+		body    string
+		options updater.ApplyOptions
+	}{
+		{`{}`, updater.ApplyOptions{Channel: updater.ChannelAuto}},
+		{`{"channel":"nightly","force":true,"restart":true}`, updater.ApplyOptions{Channel: updater.ChannelNightly, Force: true, Restart: true}},
+	} {
+		func() {
+			started := make(chan applyCall, 1)
+			release := make(chan struct{})
+			finished := make(chan struct{})
+			defer close(release)
+			updater.ContractApply = func(ctx context.Context, options updater.ApplyOptions, version, revision string, logger *zap.SugaredLogger) error {
+				started <- applyCall{options: options, version: version, revision: revision, ctx: ctx}
+				<-release
+				close(finished)
+				return nil
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			response := make(chan *httptest.ResponseRecorder, 1)
+			go func() { response <- request(engine, http.MethodPost, "/api/v1/update/apply", scenario.body, nil, ctx) }()
+			select {
+			case result := <-response:
+				if result.Code != http.StatusAccepted || result.Body.Len() != 0 {
+					test.Fatalf("update/apply response changed: %d %s", result.Code, result.Body.String())
+				}
+			case <-time.After(time.Second):
+				test.Fatal("update/apply waited for its blocked source")
+			}
+			var call applyCall
+			select {
+			case call = <-started:
+			case <-time.After(time.Second):
+				test.Fatal("update/apply source was never called")
+			}
+			cancel()
+			if call.options != scenario.options || call.version != constant.Version || call.revision != constant.GitRevision {
+				test.Fatalf("update/apply options changed: %#v", call)
+			}
+			if call.ctx.Err() != nil {
+				test.Fatal("background update uses the canceled request context")
+			}
+			test.Cleanup(func() {
+				select {
+				case <-finished:
+				case <-time.After(time.Second):
+					test.Error("background update did not exit after releasing its source")
+				}
+			})
+		}()
+	}
+}
+
+func TestWebSocketLifecycle(test *testing.T) {
+	if err := webLog.InitGlobalLogger("info"); err != nil {
+		test.Fatal(err)
+	}
+	engine := newEngine(test, "")
+	server := httptest.NewServer(engine)
+	defer server.Close()
+	added := make(chan net.Conn, 1)
+	removed := make(chan net.Conn, 1)
+	webLog.ContractAddObserver = func(connection net.Conn) { added <- connection }
+	webLog.ContractRemoveObserver = func(connection net.Conn) { removed <- connection }
+	connection, _, _, err := ws.Dial(context.Background(), "ws"+strings.TrimPrefix(server.URL, "http")+"/ws/logs")
+	if err != nil {
+		test.Fatal(err)
+	}
+	defer connection.Close()
+	var registered net.Conn
+	select {
+	case registered = <-added:
+	case <-time.After(time.Second):
+		test.Fatal("open WebSocket was not registered")
+	}
+	connection.Close()
+	select {
+	case detached := <-removed:
+		if detached != registered {
+			test.Fatal("a different connection was unregistered")
+		}
+	case <-time.After(time.Second):
+		test.Fatal("closed WebSocket was not unregistered")
+	}
+	deadline := time.Now().Add(time.Second)
+	for {
+		if err := registered.SetDeadline(time.Now().Add(time.Second)); err != nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			test.Fatal("server WebSocket connection was not locally closed")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
