+func TestP2P_Lifecycle_InvalidConfigRejected(t *testing.T) {
+	for _, port := range []int{0, -1, 65536, 70000} {
+		srv, err := web.NewServer(&config.Config{WebPort: port}, nil, nil, nil)
+		if err == nil {
+			t.Fatalf("NewServer(web_port=%d) returned %v, want a construction error", port, srv)
+		}
+	}
+}
+
+func TestP2P_Lifecycle_StartStopServesRoutes(t *testing.T) {
+	e := p2pStart(t, p2pOpts{})
+	st, _, body := e.do(http.MethodGet, "/api/v1/auth/info", nil)
+	p2pWant(t, "GET /api/v1/auth/info", st, http.StatusOK)
+	m := p2pJSON(t, "auth/info", body)
+	if v := p2pKey(t, "auth/info", m, "auth_required"); v != false {
+		t.Fatalf("auth_required = %v, want false for a credential-less config", v)
+	}
+	if v := p2pKey(t, "auth/info", m, "authenticated"); v != true {
+		t.Fatalf("authenticated = %v, want true with auth disabled", v)
+	}
+	if err := e.srv.Stop(); err != nil {
+		t.Fatalf("Stop: %v", err)
+	}
+	e.client.CloseIdleConnections()
+	connection, err := net.DialTimeout("tcp", strings.TrimPrefix(e.base, "http://"), time.Second)
+	if err == nil {
+		connection.Close()
+		t.Fatal("Stop left the HTTP listener accepting connections")
+	}
+}
+
+func TestP2P_Helpers_ExportedReusable(t *testing.T) {
+	constructorType := reflect.TypeOf((func(*config.Config, glue.Reloader, glue.HealthChecker, cmgr.Cmgr) (*web.Server, error))(nil))
+	if actual := reflect.TypeOf(web.NewServer); !actual.AssignableTo(constructorType) {
+		t.Fatalf("NewServer cannot be used as the existing exported constructor factory: got %v, want %v", actual, constructorType)
+	}
+
+	e := web.NewEchoServer()
+	if e == nil {
+		t.Fatal("NewEchoServer returned nil")
+	}
+	if !e.Debug || !e.HidePort || !e.HideBanner {
+		t.Fatalf("NewEchoServer flags changed: Debug=%v HidePort=%v HideBanner=%v", e.Debug, e.HidePort, e.HideBanner)
+	}
+	e.Use(web.NginxLogMiddleware(zap.NewNop().Sugar()))
+	e.GET("/probe", func(c echo.Context) error { return c.String(http.StatusOK, "helper-ok") })
+	rr := httptest.NewRecorder()
+	e.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, "/probe", nil))
+	if rr.Code != http.StatusOK || rr.Body.String() != "helper-ok" {
+		t.Fatalf("NewEchoServer+NginxLogMiddleware: got %d %q", rr.Code, rr.Body.String())
+	}
+
+	h := web.MakeIndexF()
+	if h == nil {
+		t.Fatal("MakeIndexF returned nil")
+	}
+	rr2 := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+	req.RemoteAddr = "203.0.113.9:4567"
+	h(rr2, req)
+	if rr2.Code != http.StatusOK || !strings.Contains(rr2.Body.String(), "203.0.113.9") {
+		t.Fatalf("MakeIndexF: got %d %q", rr2.Code, rr2.Body.String())
+	}
+}
