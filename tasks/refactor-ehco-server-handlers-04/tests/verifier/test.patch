+type p2pFakeStatus struct{ snap glue.XraySnapshot }
+
+func (f *p2pFakeStatus) Snapshot() glue.XraySnapshot { return f.snap }
+
+type p2pFakeReloader struct {
+	mu      sync.Mutex
+	calls   int
+	delay   time.Duration
+	err     error
+	started chan bool
+	release <-chan struct{}
+}
+
+func (f *p2pFakeReloader) Reload(force bool) error {
+	if f.started != nil {
+		f.started <- force
+	}
+	if f.release != nil {
+		<-f.release
+	}
+	if f.delay > 0 {
+		time.Sleep(f.delay)
+	}
+	f.mu.Lock()
+	f.calls++
+	f.mu.Unlock()
+	return f.err
+}
+
+func (f *p2pFakeReloader) count() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.calls
+}
+
+func (f *p2pFakeReloader) wait(t *testing.T, want int, timeout time.Duration) {
+	t.Helper()
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		if f.count() >= want {
+			return
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	t.Fatalf("reload hook: got %d calls, want at least %d within %s", f.count(), want, timeout)
+}
+
+type p2pFakeHealth struct {
+	mu   sync.Mutex
+	fail bool
+}
+
+func (f *p2pFakeHealth) setFail(v bool) {
+	f.mu.Lock()
+	f.fail = v
+	f.mu.Unlock()
+}
+
+func (f *p2pFakeHealth) HealthCheck(ctx context.Context, relayLabel string) (int64, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.fail {
+		return 0, errors.New("p2p health failure")
+	}
+	return 42, nil
+}
+
+// p2pFakeConnMgr implements cmgr.Cmgr. The embedded nil interface keeps the
+// unused methods honest: calling one panics instead of silently succeeding.
+type p2pFakeConnMgr struct {
+	cmgr.Cmgr
+
+	mu sync.Mutex
+
+	metricResp *ms.QueryNodeMetricsResp
+	metricErr  error
+	lastMetric *ms.QueryNodeMetricsReq
+
+	healthErr     error
+	healthResp    *ms.DBHealth
+	healthContext context.Context
+	cleanupErr    error
+	cleanupResp   *ms.MaintenanceResult
+	lastDays      int
+	vacuumErr     error
+	vacuumResp    *ms.MaintenanceResult
+	vacuumContext context.Context
+	truncateErr   error
+	lastConfirm   string
+	resetErr      error
+}
+
+func (f *p2pFakeConnMgr) setHealth(err error) {
+	f.mu.Lock()
+	f.healthErr = err
+	f.mu.Unlock()
+}
+
+func (f *p2pFakeConnMgr) metricRequest() *ms.QueryNodeMetricsReq {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.lastMetric
+}
+
+func (f *p2pFakeConnMgr) QueryNodeMetrics(ctx context.Context, req *ms.QueryNodeMetricsReq) (*ms.QueryNodeMetricsResp, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	cp := *req
+	f.lastMetric = &cp
+	if f.metricErr != nil {
+		return nil, f.metricErr
+	}
+	if f.metricResp != nil {
+		return f.metricResp, nil
+	}
+	return &ms.QueryNodeMetricsResp{}, nil
+}
+
+func (f *p2pFakeConnMgr) DBHealth(ctx context.Context) (*ms.DBHealth, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.healthContext = ctx
+	if f.healthErr != nil {
+		return nil, f.healthErr
+	}
+	if f.healthResp != nil {
+		return f.healthResp, nil
+	}
+	return &ms.DBHealth{FileBytes: 1, PageCount: 1, PageSize: 4096}, nil
+}
+
+func (f *p2pFakeConnMgr) DBCleanup(ctx context.Context, days int) (*ms.MaintenanceResult, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.lastDays = days
+	if f.cleanupErr != nil {
+		return nil, f.cleanupErr
+	}
+	if f.cleanupResp != nil {
+		return f.cleanupResp, nil
+	}
+	return &ms.MaintenanceResult{NodeDeleted: 1}, nil
+}
+
+func (f *p2pFakeConnMgr) DBVacuum(ctx context.Context) (*ms.MaintenanceResult, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.vacuumContext = ctx
+	if f.vacuumErr != nil {
+		return nil, f.vacuumErr
+	}
+	if f.vacuumResp != nil {
+		return f.vacuumResp, nil
+	}
+	return &ms.MaintenanceResult{BytesBefore: 10, BytesAfter: 5}, nil
+}
+
+func (f *p2pFakeConnMgr) DBTruncate(ctx context.Context, confirm string) (*ms.MaintenanceResult, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.lastConfirm = confirm
+	if f.truncateErr != nil {
+		return nil, f.truncateErr
+	}
+	return &ms.MaintenanceResult{NodeDeleted: 2}, nil
+}
+
+func (f *p2pFakeConnMgr) DBResetStats() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.resetErr
+}
