+// Command p2prunner executes the frozen P2P selector set for the ehco web
+// admin server split and writes a single standard JUnit XML report.
+//
+// Design constraints:
+//   - stdlib only, so it builds from the frozen module cache with no network;
+//   - every selector runs in its own `go test` process, so a panic, hang or
+//     build failure in one node cannot hide the results of the others;
+//   - the gitignored internal/web/webui/dist embed tree is materialised from
+//     the committed testdata snapshot when it is missing, so the package can
+//     be compiled on a pristine baseline checkout with no SPA toolchain;
+//   - a report is always written for every declared selector. A node that
+//     produced no result is reported as an <error> (NOT_RUN), never as a pass,
+//     a skip or an empty report.
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+)
+
+type node struct {
+	Selector string // <path>::<exact leaf>, as frozen in the plan
+	Pkg      string // go package to run, e.g. ./internal/web
+	Leaf     string // exact top level test function name
+}
+
+// declaredNodes mirrors evidence/p2p-plan.json, minus the white-box Baseline
+// nodes from internal/web/auth_test.go: those referenced unexported symbols
+// of package web, while the task leaves internal types and layout to the
+// candidate. Their behavior is covered by the black-box TestP2P_Auth_* and
+// session contract nodes below (2026-11-19). p2p_select.txt is only used as a
+// cross-check; execution always covers the full declared set so the report
+// can never silently shrink.
