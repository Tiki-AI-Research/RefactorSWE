+
+type p2pOpts struct {
+	cfg    *config.Config
+	relay  glue.Reloader
+	health glue.HealthChecker
+	mgr    cmgr.Cmgr
+}
+
+type p2pEnv struct {
+	t      *testing.T
+	srv    *web.Server
+	cfg    *config.Config
+	base   string
+	client *http.Client
+}
+
+func p2pFreePort(t *testing.T) int {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("reserve loopback port: %v", err)
+	}
+	defer l.Close()
+	return l.Addr().(*net.TCPAddr).Port
+}
+
+func p2pStart(t *testing.T, o p2pOpts) *p2pEnv {
+	t.Helper()
+	cfg := o.cfg
+	if cfg == nil {
+		cfg = &config.Config{}
+	}
+	if cfg.WebHost == "" {
+		cfg.WebHost = "127.0.0.1"
+	}
+	cfg.WebPort = p2pFreePort(t)
+	srv, err := web.NewServer(cfg, o.relay, o.health, o.mgr)
+	if err != nil {
+		t.Fatalf("NewServer(web_port=%d): %v", cfg.WebPort, err)
+	}
+	base := fmt.Sprintf("http://127.0.0.1:%d", cfg.WebPort)
+	client := &http.Client{Timeout: 15 * time.Second}
+	startErr := make(chan error, 1)
+	go func() { startErr <- srv.Start() }()
+	deadline := time.Now().Add(20 * time.Second)
+	for {
+		if time.Now().After(deadline) {
+			t.Fatalf("server did not become ready at %s", base)
+		}
+		resp, err := client.Get(base + "/api/v1/auth/info")
+		if err == nil {
+			resp.Body.Close()
+			break
+		}
+		select {
+		case serr := <-startErr:
+			t.Fatalf("server start failed: %v", serr)
+		default:
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+	t.Cleanup(func() {
+		if err := srv.Stop(); err != nil {
+			t.Logf("stop web server: %v", err)
+		}
+	})
+	return &p2pEnv{t: t, srv: srv, cfg: cfg, base: base, client: client}
+}
+
+type p2pReq struct {
+	hdr     map[string]string
+	cookies []*http.Cookie
+	body    []byte
+}
+
+func p2pJSONReq(method, path, payload string) *p2pReq {
+	return &p2pReq{hdr: map[string]string{"Content-Type": "application/json"}, body: []byte(payload)}
+}
+
+func (e *p2pEnv) do(method, path string, r *p2pReq) (int, http.Header, []byte) {
+	e.t.Helper()
+	var body io.Reader
+	if r != nil && r.body != nil {
+		body = bytes.NewReader(r.body)
+	}
+	req, err := http.NewRequest(method, e.base+path, body)
+	if err != nil {
+		e.t.Fatalf("build request %s %s: %v", method, path, err)
+	}
+	if r != nil {
+		for k, v := range r.hdr {
+			req.Header.Set(k, v)
+		}
+		for _, c := range r.cookies {
+			req.AddCookie(c)
+		}
+	}
+	resp, err := e.client.Do(req)
+	if err != nil {
+		e.t.Fatalf("%s %s: %v", method, path, err)
+	}
+	defer resp.Body.Close()
+	raw, err := io.ReadAll(resp.Body)
+	if err != nil {
+		e.t.Fatalf("read %s %s body: %v", method, path, err)
+	}
+	return resp.StatusCode, resp.Header, raw
+}
+
+func p2pWant(t *testing.T, what string, got, want int) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("%s: got status %d, want %d", what, got, want)
+	}
+}
+
+func p2pJSON(t *testing.T, what string, body []byte) map[string]any {
+	t.Helper()
+	var m map[string]any
+	if err := json.Unmarshal(body, &m); err != nil {
+		t.Fatalf("%s: response is not a JSON object (%q): %v", what, string(body), err)
+	}
+	return m
+}
+
+func p2pKey(t *testing.T, what string, m map[string]any, key string) any {
+	t.Helper()
+	v, ok := m[key]
+	if !ok {
+		t.Fatalf("%s: response %v is missing key %q", what, m, key)
+	}
+	return v
+}
+
+func p2pNoKey(t *testing.T, what string, m map[string]any, key string) {
+	t.Helper()
+	if v, ok := m[key]; ok {
+		t.Fatalf("%s: response must omit %q when the source is absent, got %v", what, key, v)
+	}
+}
+
+func p2pNumber(t *testing.T, what string, m map[string]any, key string) float64 {
+	t.Helper()
+	f, ok := p2pKey(t, what, m, key).(float64)
+	if !ok {
+		t.Fatalf("%s: key %q is not a number: %v", what, key, m[key])
+	}
+	return f
+}
+
+func p2pFindCookie(t *testing.T, what string, hdr http.Header, name string) *http.Cookie {
+	t.Helper()
+	for _, c := range (&http.Response{Header: hdr}).Cookies() {
+		if c.Name == name {
+			return c
+		}
+	}
+	t.Fatalf("%s: no %q cookie in %v", what, name, hdr.Values("Set-Cookie"))
+	return nil
+}
