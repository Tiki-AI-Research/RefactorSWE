+func checkFamilyNarrow(t *testing.T, f family) {
+	t.Helper()
+	p := loadPackage(t)
+	types := p.familyTypes(f)
+	if len(types) == 0 {
+		t.Fatalf("infrastructure error: cannot attribute handler ownership for family %q; unresolved coverage is not a pass", f.name)
+	}
+	var hits []string
+	for _, typ := range types {
+		si := p.structs[typ]
+		if si == nil {
+			continue
+		}
+		hits = append(hits, p.fieldsMatching(si, p.ownerForbidden(si))...)
+		for _, field := range si.fields {
+			if p.hasConcreteServiceDependency(field.typ, si.file, map[string]bool{}) {
+				hits = append(hits, fmt.Sprintf("%s.%s: concrete service dependency %s", si.name, field.name, field.typ))
+			}
+		}
+	}
+	if len(hits) > 0 {
+		t.Fatalf("the %s handler family still depends on state outside its own responsibility (REQ-STRUCT-001/002): handler type(s) %s declare %s",
+			f.name, strings.Join(types, ", "), strings.Join(hits, "; "))
+	}
+}
