+// Command f2prunner executes the F2P (fail-to-pass) structural selector set
+// for the ehco web admin god-object split together with the frozen P2P
+// selectors, and writes one standard JUnit XML report.
+//
+// Design constraints:
+//   - stdlib only, so it builds from the frozen module cache with no network;
+//   - the exact selector set comes from the pipeline's {config} p2p/f2p
+//     arrays (exact leaves, never a test file or a broad pattern); the
+//     frozen P2P-only {p2p_select} list and the F2P owner's declared set are
+//     used only as fallbacks when the config placeholder is not materialised;
+//   - every selector runs in its own `go test` process, so a panic, hang or
+//     build failure in one node cannot hide the results of the others;
+//   - the gitignored internal/web/webui/dist embed tree is materialised from
+//     the committed testdata snapshot when it is missing, so the packages can
+//     be compiled on a pristine baseline checkout with no SPA toolchain;
+//   - a report is always written for every selected node. A node that
+//     produced no result is reported as an <error> (NOT_RUN), never as a
+//     pass, a skip or an empty report.
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// f2pDeclaredSelectors mirrors the F2P owner's verification plan. It is only
+// used when the pipeline's {config} file is not available.
+var f2pDeclaredSelectors = []string{
+	"tests/f2p/f2p_split_test.go::TestF2P_ServerTypeDeclaresNoRequestHandlers",
+	"tests/f2p/f2p_split_test.go::TestF2P_ServerDropsHandlerSubsystemState",
+	"tests/f2p/f2p_split_test.go::TestF2P_ServerDropsRelayAndHealthContracts",
+	"tests/f2p/f2p_split_test.go::TestF2P_ServerDropsLateWiredHookStorage",
+	"tests/f2p/f2p_split_test.go::TestF2P_RoutesNotMountedFromServerMethods",
+	"tests/f2p/f2p_split_test.go::TestF2P_AuthHandlerNarrowDependencies",
+	"tests/f2p/f2p_split_test.go::TestF2P_ConfigHandlerNarrowDependencies",
+	"tests/f2p/f2p_split_test.go::TestF2P_DBHandlerNarrowDependencies",
+	"tests/f2p/f2p_split_test.go::TestF2P_HealthCheckHandlerNarrowDependencies",
+	"tests/f2p/f2p_split_test.go::TestF2P_NodeMetricsHandlerNarrowDependencies",
+	"tests/f2p/f2p_split_test.go::TestF2P_OverviewHandlerNarrowDependencies",
+	"tests/f2p/f2p_split_test.go::TestF2P_UpdateHandlerNarrowDependencies",
+	"tests/f2p/f2p_split_test.go::TestF2P_LogStreamHandlerNarrowDependencies",
+}
+
+const (
+	statusPass  = "PASS"
+	statusFail  = "FAIL"
+	statusSkip  = "SKIP"
+	statusError = "NOT_RUN"
+	deadProxy   = "http://127.0.0.1:9"
+)
+
+type selector struct {
+	ID  string // <path>::<exact leaf>
+	Pkg string // go package to run, e.g. ./internal/web
+}
+
+func newSelector(id string) (selector, bool) {
+	idx := strings.Index(id, "::")
+	if idx <= 0 || idx+2 >= len(id) {
+		return selector{}, false
+	}
+	file, leaf := id[:idx], id[idx+2:]
+	pkg := "./" + filepath.ToSlash(filepath.Dir(file))
+	if pkg == "./." {
+		return selector{}, false
+	}
+	_ = leaf
+	return selector{ID: id, Pkg: pkg}, true
+}
+
+func leafOf(id string) string {
+	idx := strings.Index(id, "::")
+	if idx < 0 {
+		return id
+	}
+	return id[idx+2:]
+}
+
+func fileOf(id string) string {
+	idx := strings.Index(id, "::")
+	if idx < 0 {
+		return id
+	}
+	return id[:idx]
+}
+
+type nodeResult struct {
+	Sel     selector
+	Status  string
+	Detail  string
+	Output  string
+	Elapsed time.Duration
+}
+
+func main() {
+	reportPath := flag.String("report", "", "JUnit XML output path (the pipeline's {report} placeholder)")
+	configPath := flag.String("config", "", "pipeline config.json carrying the frozen p2p and f2p selector arrays (the {config} placeholder)")
+	selectPath := flag.String("select", "", "optional frozen P2P-only selector list (the {p2p_select} placeholder)")
+	nodeTimeout := flag.Float64("node-timeout", 150, "per-node go test timeout in seconds")
+	f2pOnly := flag.Bool("f2p-only", false, "run only the F2P selectors even when --config carries p2p selectors")
+	flag.Parse()
+
+	if strings.TrimSpace(*reportPath) == "" {
+		fmt.Fprintln(os.Stderr, "f2prunner: --report <path> is required")
+		os.Exit(2)
+	}
+
+	root, err := findRepoRoot()
+	if err != nil {
+		fallbackF2P, fallbackP2P, _ := resolveSelectors("", "", false)
+		res := errorResultsFor(append(fallbackP2P, fallbackF2P...), fmt.Sprintf("locate repository root: %v", err))
+		writeReportOrExit(*reportPath, res)
+		fmt.Fprintf(os.Stderr, "f2prunner: %v\n", err)
+		fmt.Printf("f2prunner: 0/%d nodes passed (repository root missing)\n", len(res))
+		os.Exit(0)
+	}
+
+	f2pSel, p2pSel, srcNotes := resolveSelectors(*configPath, *selectPath, *f2pOnly)
+	fmt.Printf("f2prunner: selector sources: %s\n", strings.Join(srcNotes, "; "))
+	if err := validateSelectors(p2pSel, f2pSel); err != nil {
+		fmt.Fprintf(os.Stderr, "f2prunner: %v\n", err)
+		os.Exit(2)
+	}
+	all := append(append([]string{}, p2pSel...), f2pSel...)
+
+	ctx := context.Background()
+	var results []nodeResult
+	if derr := ensureDist(root); derr != nil {
+		results = errorResultsFor(all, fmt.Sprintf("materialise internal/web/webui/dist: %v", derr))
+	} else {
+		for _, id := range all {
+			sel, ok := newSelector(id)
+			if !ok {
+				results = append(results, nodeResult{Sel: selector{ID: id}, Status: statusError, Detail: "malformed selector"})
+				continue
+			}
+			r := runNode(ctx, root, sel, time.Duration(*nodeTimeout*float64(time.Second)))
+			results = append(results, r)
+			fmt.Printf("f2prunner: %-9s %s\n", r.Status, r.Sel.ID)
+			if r.Status != statusPass {
+				fmt.Printf("f2prunner:   %s\n", firstLine(r.Detail))
+			}
+		}
+	}
+
+	if werr := writeReport(*reportPath, results); werr != nil {
+		fmt.Fprintf(os.Stderr, "f2prunner: write report %s: %v\n", *reportPath, werr)
+		os.Exit(1)
+	}
+	passed := 0
+	for _, r := range results {
+		if r.Status == statusPass {
+			passed++
+		}
+	}
+	fmt.Printf("f2prunner: %d/%d nodes passed; report written to %s\n", passed, len(results), *reportPath)
+	if passed != len(results) {
+		os.Exit(1)
+	}
+	os.Exit(0)
+}
+
+// ---------------------------------------------------------------------------
+// selector resolution
+// ---------------------------------------------------------------------------
+
+// resolveSelectors prefers the pipeline's canonical config.json ({config}),
+// which carries the frozen p2p and f2p exact selector arrays. When the
+// placeholder was not materialised it falls back to the frozen P2P-only
+// {p2p_select} list plus the F2P owner's declared selector set.
+func resolveSelectors(configPath, selectPath string, f2pOnly bool) (f2p, p2p []string, notes []string) {
+	var cfgP2P, cfgF2P []string
+	if strings.TrimSpace(configPath) != "" && !strings.Contains(configPath, "{") {
+		if raw, err := os.ReadFile(configPath); err == nil {
+			cfgP2P, cfgF2P = extractConfigSelectors(raw)
+			if len(cfgP2P) > 0 || len(cfgF2P) > 0 {
+				notes = append(notes, fmt.Sprintf("config=%s (p2p=%d, f2p=%d)", configPath, len(cfgP2P), len(cfgF2P)))
+			} else {
+				notes = append(notes, fmt.Sprintf("config=%s carries no p2p/f2p selectors", configPath))
+			}
+		} else {
+			notes = append(notes, fmt.Sprintf("config=%s unreadable: %v", configPath, err))
+		}
+	} else if strings.TrimSpace(configPath) != "" {
+		notes = append(notes, "config placeholder not materialised")
+	}
+
+	f2p = cfgF2P
+	if len(f2p) == 0 {
+		f2p = append([]string{}, f2pDeclaredSelectors...)
+		notes = append(notes, fmt.Sprintf("f2p=%d declared selectors (built-in)", len(f2p)))
+	}
+	if !f2pOnly {
+		p2p = cfgP2P
+		if len(p2p) == 0 && strings.TrimSpace(selectPath) != "" && !strings.Contains(selectPath, "{") {
+			if b, err := os.ReadFile(selectPath); err == nil {
+				for _, line := range strings.Split(string(b), "\n") {
+					line = strings.TrimSpace(line)
+					if line == "" || strings.HasPrefix(line, "#") {
+						continue
+					}
+					p2p = append(p2p, line)
+				}
+				notes = append(notes, fmt.Sprintf("p2p=%d selectors from p2p_select", len(p2p)))
+			}
+		}
+	}
+	p2p = dedupe(p2p)
+	f2p = dedupe(f2p)
+	if !f2pOnly {
+		notes = append(notes, fmt.Sprintf("p2p=%d selectors", len(p2p)))
+	} else {
+		notes = append(notes, "f2p-only requested")
+	}
+	return f2p, p2p, notes
+}
+
+func dedupe(in []string) []string {
+	seen := map[string]bool{}
+	out := make([]string, 0, len(in))
+	for _, s := range in {
+		s = strings.TrimSpace(s)
+		if s == "" || seen[s] {
+			continue
+		}
+		seen[s] = true
+		out = append(out, s)
+	}
+	return out
+}
+
+func validateSelectors(p2p, f2p []string) error {
+	if len(p2p) == 0 && len(f2p) == 0 {
+		return fmt.Errorf("no selectors to run: {config} was not materialised and no fallback is available")
+	}
+	for _, id := range append(append([]string{}, p2p...), f2p...) {
+		if _, ok := newSelector(id); !ok {
+			return fmt.Errorf("selector %q is not an exact <path>::<leaf> selector", id)
+		}
+	}
+	return nil
+}
+
+// extractConfigSelectors reads the frozen p2p and f2p exact selector arrays
+// from the pipeline's config.json. It accepts plain string arrays as well as
+// arrays of row objects and a gates-style fallback, so the runner follows the
+// declared selection set instead of any test file or broad pattern.
+func extractConfigSelectors(raw []byte) (p2p, f2p []string) {
+	var doc map[string]any
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		return nil, nil
+	}
+	if nested, ok := doc["plan"].(map[string]any); ok {
+		for k, v := range nested {
+			if _, exists := doc[k]; !exists {
+				doc[k] = v
+			}
+		}
+	}
+	p2p = stringArray(doc["p2p"])
+	f2p = stringArray(doc["f2p"])
+	if len(p2p) == 0 || len(f2p) == 0 {
+		if gates, ok := doc["gates"].([]any); ok {
+			for _, g := range gates {
+				gm, ok := g.(map[string]any)
+				if !ok {
+					continue
+				}
+				kind, _ := gm["kind"].(string)
+				tests := stringArray(gm["tests"])
+				switch strings.ToUpper(kind) {
+				case "P2P":
+					p2p = append(p2p, tests...)
+				case "F2P":
+					f2p = append(f2p, tests...)
+				}
+			}
+		}
+	}
+	return dedupe(p2p), dedupe(f2p)
+}
+
+func stringArray(v any) []string {
+	arr, ok := v.([]any)
+	if !ok {
+		if ss, ok := v.([]string); ok {
+			return dedupe(ss)
+		}
+		return nil
+	}
+	var out []string
+	for _, item := range arr {
+		switch e := item.(type) {
+		case string:
+			out = append(out, e)
+		case map[string]any:
+			for _, key := range []string{"selector", "test", "id", "name"} {
+				if s, ok := e[key].(string); ok && strings.Contains(s, "::") {
+					out = append(out, s)
+					break
+				}
+			}
+		}
+	}
+	return dedupe(out)
+}
+
+// ---------------------------------------------------------------------------
+// node execution
+// ---------------------------------------------------------------------------
+
+func findRepoRoot() (string, error) {
+	dir, err := os.Getwd()
+	if err != nil {
+		return "", err
+	}
+	for {
+		if b, err := os.ReadFile(filepath.Join(dir, "go.mod")); err == nil &&
+			strings.Contains(string(b), "module github.com/Ehco1996/ehco") {
+			return dir, nil
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "", fmt.Errorf("go.mod of github.com/Ehco1996/ehco not found above %s", dir)
+		}
+		dir = parent
+	}
+}
+
+// ensureDist re-creates the generated SPA embed tree on a pristine checkout.
+// internal/web/webui/dist is gitignored, so a baseline + patch workspace has
+// no UI build; the committed snapshot under internal/web/tests/testdata/
+// dist_snapshot carries the same layout and is copied verbatim.
+func ensureDist(root string) error {
+	dst := filepath.Join(root, "internal", "web", "webui", "dist")
+	if fileExists(filepath.Join(dst, "index.html")) {
+		return nil
+	}
+	src := filepath.Join(root, "internal", "web", "tests", "testdata", "dist_snapshot")
+	if !fileExists(filepath.Join(src, "index.html")) {
+		return fmt.Errorf("neither %s nor the committed dist snapshot exist", dst)
+	}
+	if err := os.MkdirAll(dst, 0o755); err != nil {
+		return err
+	}
+	return os.CopyFS(dst, os.DirFS(src))
+}
+
+func fileExists(p string) bool {
+	fi, err := os.Stat(p)
+	return err == nil && !fi.IsDir()
+}
+
+type goTestEvent struct {
+	Action  string  `json:"Action"`
+	Test    string  `json:"Test"`
+	Output  string  `json:"Output"`
+	Elapsed float64 `json:"Elapsed"`
+	Package string  `json:"Package"`
+}
+
+func runNode(parent context.Context, root string, sel selector, timeout time.Duration) nodeResult {
+	ctx, cancel := context.WithTimeout(parent, timeout)
+	defer cancel()
+
+	leaf := leafOf(sel.ID)
+	cmd := exec.CommandContext(ctx, "go", "test", "-json", "-count=1",
+		"-run", "^"+regexp.QuoteMeta(leaf)+"$", sel.Pkg)
+	cmd.Dir = root
+	cmd.Env = childEnv()
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+
+	start := time.Now()
+	runErr := cmd.Run()
+	elapsed := time.Since(start)
+
+	res := nodeResult{Sel: sel, Status: statusError, Elapsed: elapsed}
+	var out strings.Builder
+	status := ""
+	for _, line := range strings.Split(stdout.String(), "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		var ev goTestEvent
+		if err := json.Unmarshal([]byte(line), &ev); err != nil {
+			out.WriteString(line)
+			out.WriteString("\n")
+			continue
+		}
+		out.WriteString(ev.Output)
+		if ev.Test == leaf {
+			switch ev.Action {
+			case "pass":
+				status = statusPass
+				res.Elapsed = time.Duration(ev.Elapsed * float64(time.Second))
+			case "fail":
+				status = statusFail
+				res.Elapsed = time.Duration(ev.Elapsed * float64(time.Second))
+			case "skip":
+				status = statusSkip
+				res.Elapsed = time.Duration(ev.Elapsed * float64(time.Second))
+			}
+		}
+	}
+	res.Output = clamp(out.String(), 16*1024)
+
+	if ctx.Err() != nil || regexp.MustCompile(`(?m)^(panic:|fatal error:)`).MatchString(out.String()+stderr.String()) {
+		res.Status = statusError
+		res.Detail = "go test process crash"
+		if ctx.Err() != nil {
+			res.Detail = "go test timed out"
+		}
+		res.Output = clamp(res.Output+"\n"+stderr.String(), 16*1024)
+		return res
+	}
+
+	switch status {
+	case statusPass:
+		res.Status = statusPass
+		res.Detail = "passed"
+	case statusFail:
+		res.Status = statusFail
+		res.Detail = "go test reported the node as failed"
+		res.Output = clamp(res.Output+"\n"+stderr.String(), 16*1024)
+	case statusSkip:
+		res.Status = statusSkip
+		res.Detail = "go test reported the node as skipped"
+	default:
+		res.Status = statusError
+		detail := "node produced no result"
+		if runErr != nil {
+			detail = "go test invocation failed: " + runErr.Error()
+		} else if strings.Contains(out.String(), "build failed") {
+			detail = "package build failed"
+		}
+		res.Detail = detail
+		errText := ""
+		if runErr != nil {
+			errText = firstLine(runErr.Error())
+		}
+		res.Output = clamp(strings.TrimRight(res.Output+"\n"+stderr.String()+"\n"+errText, "\n"), 16*1024)
+	}
+	if res.Status != statusPass {
+		fmt.Fprintf(os.Stderr, "f2prunner[%s]: %s\n", sel.ID, firstLine(res.Detail))
+	}
+	return res
+}
+
+func childEnv() []string {
+	env := os.Environ()
+	env = append(env,
+		"HTTP_PROXY="+deadProxy, "HTTPS_PROXY="+deadProxy, "ALL_PROXY="+deadProxy,
+		"NO_PROXY=127.0.0.1,localhost",
+		"GOTOOLCHAIN=local",
+	)
+	return env
+}
+
+func errorResultsFor(ids []string, detail string) []nodeResult {
+	res := make([]nodeResult, 0, len(ids))
+	for _, id := range ids {
+		sel, ok := newSelector(id)
+		if !ok {
+			sel = selector{ID: id}
+		}
+		res = append(res, nodeResult{Sel: sel, Status: statusError, Detail: detail, Output: detail})
+	}
+	return res
+}
+
+// ---------------------------------------------------------------------------
+// JUnit report
+// ---------------------------------------------------------------------------
+
+type xmlMessage struct {
+	Message string `xml:"message,attr"`
+	Type    string `xml:"type,attr,omitempty"`
+	Text    string `xml:",chardata"`
+}
+
+type xmlCase struct {
+	Classname string      `xml:"classname,attr"`
+	Name      string      `xml:"name,attr"`
+	File      string      `xml:"file,attr,omitempty"`
+	Time      string      `xml:"time,attr"`
+	Failure   *xmlMessage `xml:"failure,omitempty"`
+	Error     *xmlMessage `xml:"error,omitempty"`
+	Skipped   *xmlMessage `xml:"skipped,omitempty"`
+	SystemOut string      `xml:"system-out,omitempty"`
+}
+
+type xmlSuite struct {
+	Name      string    `xml:"name,attr"`
+	Tests     int       `xml:"tests,attr"`
+	Failures  int       `xml:"failures,attr"`
+	Errors    int       `xml:"errors,attr"`
+	Skipped   int       `xml:"skipped,attr"`
+	Time      string    `xml:"time,attr"`
+	Timestamp string    `xml:"timestamp,attr"`
+	Cases     []xmlCase `xml:"testcase"`
+}
+
+type xmlSuites struct {
+	XMLName  xml.Name   `xml:"testsuites"`
+	Name     string     `xml:"name,attr"`
+	Tests    int        `xml:"tests,attr"`
+	Failures int        `xml:"failures,attr"`
+	Errors   int        `xml:"errors,attr"`
+	Skipped  int        `xml:"skipped,attr"`
+	Time     string     `xml:"time,attr"`
+	Suites   []xmlSuite `xml:"testsuite"`
+}
+
+func writeReport(path string, results []nodeResult) error {
+	suite := xmlSuite{
+		Name:      "ehco-web-server-f2p",
+		Timestamp: time.Now().UTC().Format(time.RFC3339),
+	}
+	var total time.Duration
+	for _, r := range results {
+		file := fileOf(r.Sel.ID)
+		c := xmlCase{
+			Classname: file,
+			Name:      leafOf(r.Sel.ID),
+			File:      file,
+			Time:      fmt.Sprintf("%.3f", r.Elapsed.Seconds()),
+			SystemOut: "selector: " + r.Sel.ID + "\n" + r.Output,
+		}
+		switch r.Status {
+		case statusPass:
+			// no child element
+		case statusFail:
+			suite.Failures++
+			c.Failure = &xmlMessage{Message: r.Detail, Type: "AssertionFailure", Text: r.Output}
+		case statusSkip:
+			suite.Skipped++
+			c.Skipped = &xmlMessage{Message: r.Detail, Text: r.Output}
+		default:
+			suite.Errors++
+			c.Error = &xmlMessage{Message: r.Detail, Type: "not-run", Text: r.Output}
+		}
+		total += r.Elapsed
+		suite.Cases = append(suite.Cases, c)
+	}
+	suite.Tests = len(suite.Cases)
+	suite.Time = fmt.Sprintf("%.3f", total.Seconds())
+
+	out := xmlSuites{
+		Name:     suite.Name,
+		Tests:    suite.Tests,
+		Failures: suite.Failures,
+		Errors:   suite.Errors,
+		Skipped:  suite.Skipped,
+		Time:     suite.Time,
+		Suites:   []xmlSuite{suite},
+	}
+	body, err := xml.MarshalIndent(out, "", "  ")
+	if err != nil {
+		return err
+	}
+	doc := append([]byte(xml.Header), body...)
+	doc = append(doc, '\n')
+	if dir := filepath.Dir(path); dir != "" {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			return err
+		}
+	}
+	return os.WriteFile(path, doc, 0o644)
+}
+
+func writeReportOrExit(path string, res []nodeResult) {
+	if err := writeReport(path, res); err != nil {
+		fmt.Fprintf(os.Stderr, "f2prunner: write report %s: %v\n", path, err)
+		os.Exit(1)
+	}
+}
+
+func clamp(s string, max int) string {
+	if len(s) <= max {
+		return s
+	}
+	return s[:max] + "\n... (truncated)"
+}
+
+func firstLine(s string) string {
+	s = strings.TrimSpace(s)
+	if i := strings.IndexByte(s, '\n'); i >= 0 {
+		s = s[:i]
+	}
+	if len(s) > 400 {
+		s = s[:400] + "..."
+	}
+	return s
+}
