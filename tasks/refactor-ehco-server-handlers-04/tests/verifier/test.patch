+func TestP2P_SPA_FallbackBoundaryAndAssets(t *testing.T) {
+	e := p2pStart(t, p2pOpts{cfg: &config.Config{}})
+	expectedShell, err := os.ReadFile(filepath.Join("..", "webui", "dist", "index.html"))
+	if err != nil {
+		t.Fatalf("read embedded shell fixture: %v", err)
+	}
+
+	st, hdr, body := e.do(http.MethodGet, "/", nil)
+	p2pWant(t, "GET /", st, http.StatusOK)
+	if ct := hdr.Get("Content-Type"); !strings.Contains(ct, "text/html") {
+		t.Fatalf("GET / content-type = %q, want text/html", ct)
+	}
+	if !strings.Contains(string(body), p2pShellMark) {
+		t.Fatalf("GET / did not return the SPA shell: %q", string(body))
+	}
+
+	st, _, body = e.do(http.MethodGet, "/index.html", nil)
+	p2pWant(t, "GET /index.html", st, http.StatusOK)
+	if !strings.Contains(string(body), p2pShellMark) {
+		t.Fatalf("GET /index.html did not return the SPA shell")
+	}
+
+	st, _, body = e.do(http.MethodGet, "/some/client/side/route", nil)
+	p2pWant(t, "GET catch-all", st, http.StatusOK)
+	if !strings.Contains(string(body), p2pShellMark) {
+		t.Fatalf("client-side route did not fall through to the SPA shell")
+	}
+	for _, path := range []string{"/", "/index.html", "/some/client/side/route"} {
+		status, headers, response := e.do(http.MethodGet, path, nil)
+		p2pWant(t, path, status, http.StatusOK)
+		if headers.Get("Content-Type") != "text/html; charset=utf-8" || headers.Get("Cache-Control") != "no-store" {
+			t.Fatalf("SPA response headers changed for %s: %v", path, headers)
+		}
+		if !bytes.Equal(response, expectedShell) {
+			t.Fatalf("SPA routes do not return the same embedded shell: %s", path)
+		}
+	}
+
+	notShell := []string{"/api/v1/p2p-not-a-route", "/ws/p2p-not-a-route", "/metrics/p2p-not-a-route", "/debug/p2p-not-a-route", "/assets/p2p-not-a-real-bundle.js"}
+	for _, p := range notShell {
+		st, _, body = e.do(http.MethodGet, p, nil)
+		p2pWant(t, "GET "+p, st, http.StatusNotFound)
+		if strings.Contains(string(body), p2pShellMark) {
+			t.Fatalf("GET %s returned the SPA shell; reserved prefixes must stay 404", p)
+		}
+	}
+
+	st, _, body = e.do(http.MethodGet, "/favicon.svg", nil)
+	p2pWant(t, "GET /favicon.svg", st, http.StatusOK)
+	if !strings.Contains(string(body), "<svg") {
+		t.Fatalf("GET /favicon.svg did not return the SVG asset")
+	}
+
+	_, _, shell := e.do(http.MethodGet, "/", nil)
+	if asset := p2pFirstAssetPath(shell); asset != "" {
+		expectedAsset, err := os.ReadFile(filepath.Join("..", "webui", "dist", strings.TrimPrefix(asset, "/")))
+		if err != nil {
+			t.Fatalf("read embedded asset fixture: %v", err)
+		}
+		st, _, body = e.do(http.MethodGet, asset, nil)
+		p2pWant(t, "GET "+asset, st, http.StatusOK)
+		if !bytes.Equal(body, expectedAsset) {
+			t.Fatalf("static asset content changed: %s", asset)
+		}
+	} else {
+		t.Fatal("embedded shell has no positive static asset fixture")
+	}
+}
+
+func p2pFirstAssetPath(html []byte) string {
+	s := string(html)
+	i := strings.Index(s, "assets/")
+	if i < 0 {
+		return ""
+	}
+	rest := s[i:]
+	if end := strings.IndexAny(rest, "\"' \n"); end > 0 {
+		rest = rest[:end]
+	}
+	return "/" + rest
+}
