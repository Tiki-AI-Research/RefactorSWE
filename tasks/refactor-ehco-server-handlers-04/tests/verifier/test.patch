+func TestP2P_Auth_PublicPathsAndAnonymousRejection(t *testing.T) {
+	e := p2pStart(t, p2pOpts{cfg: &config.Config{DashboardPass: p2pPassword, ApiToken: p2pToken}})
+
+	protected := []struct{ method, path string }{
+		{http.MethodGet, "/metrics/"},
+		{http.MethodGet, "/debug/pprof/"},
+		{http.MethodGet, "/api/v1/config/"},
+		{http.MethodPost, "/api/v1/config/reload/"},
+		{http.MethodGet, "/api/v1/overview"},
+		{http.MethodGet, "/api/v1/version"},
+		{http.MethodGet, "/api/v1/node_metrics/"},
+		{http.MethodGet, "/api/v1/health_check/"},
+		{http.MethodGet, "/api/v1/db/health"},
+		{http.MethodPost, "/api/v1/db/cleanup"},
+		{http.MethodGet, "/ws/logs"},
+	}
+	for _, p := range protected {
+		st, _, _ := e.do(p.method, p.path, nil)
+		p2pWant(t, fmt.Sprintf("anonymous %s %s", p.method, p.path), st, http.StatusUnauthorized)
+	}
+
+	public := []struct {
+		method, path string
+		body         *p2pReq
+	}{
+		{http.MethodGet, "/", nil},
+		{http.MethodGet, "/index.html", nil},
+		{http.MethodGet, "/favicon.svg", nil},
+		{http.MethodGet, "/favicon.ico", nil},
+		{http.MethodGet, "/robots.txt", nil},
+		{http.MethodGet, "/assets/p2p-not-a-real-bundle.js", nil},
+		{http.MethodGet, "/api/v1/auth/info", nil},
+		{http.MethodPost, "/api/v1/auth/login", p2pJSONReq(http.MethodPost, "/api/v1/auth/login", `{"password":`)},
+		{http.MethodPost, "/api/v1/auth/logout", nil},
+	}
+	for _, p := range public {
+		st, _, _ := e.do(p.method, p.path, p.body)
+		if st == http.StatusUnauthorized {
+			t.Fatalf("public %s %s returned 401; it must stay reachable without credentials", p.method, p.path)
+		}
+	}
+
+	st, _, body := e.do(http.MethodGet, "/api/v1/auth/login", nil)
+	if st == http.StatusUnauthorized {
+		t.Fatalf("GET on a POST-only public path must not 401 (got %d, body %q)", st, body)
+	}
+}
