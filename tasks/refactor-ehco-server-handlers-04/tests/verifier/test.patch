+// familyTypes returns the receiver types that serve a route family, resolved
+// from the route registration wiring first and from the historic handler
+// method names as a fallback. The result never guesses from type names.
+func (p *pkgInfo) familyTypes(f family) []string {
+	return p.receiverTypesForPaths(f.paths, f.methodNames)
+}
+
+func (p *pkgInfo) receiverTypesForPaths(paths, methodNames []string) []string {
+	pathSet := map[string]bool{}
+	for _, pth := range paths {
+		pathSet[pth] = true
+	}
+	nameSet := map[string]bool{}
+	for _, n := range methodNames {
+		nameSet[n] = true
+	}
+	seen := map[string]bool{}
+	var out []string
+	add := func(typ string) {
+		base := baseTypeName(typ)
+		if base == "" || seen[base] {
+			return
+		}
+		seen[base] = true
+		out = append(out, base)
+	}
+	for _, rm := range p.routeMounts {
+		if rm.path == "" || !pathSet[rm.path] || rm.recvType == "" {
+			continue
+		}
+		add(rm.recvType)
+	}
+	for _, m := range p.methods {
+		if !nameSet[m.name] {
+			continue
+		}
+		isHandler := false
+		for _, prm := range m.params {
+			if p.isEchoContext(m.file, prm.typ) {
+				isHandler = true
+				break
+			}
+		}
+		if isHandler {
+			add(m.recv)
+		}
+	}
+	return out
+}
