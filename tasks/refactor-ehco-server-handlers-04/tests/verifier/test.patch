+func runProbe(test *testing.T, name string) {
+	test.Helper()
+	root, err := filepath.Abs(filepath.Join("..", ".."))
+	if err != nil {
+		test.Fatal(err)
+	}
+	directory := test.TempDir()
+	overlay := map[string]string{}
+	writeOverlay := func(target string, content []byte) {
+		test.Helper()
+		path := filepath.Join(directory, fmt.Sprintf("overlay-%d.go", len(overlay)))
+		formatted, err := format.Source(content)
+		if err != nil {
+			test.Fatalf("format contract fixture %s: %v", target, err)
+		}
+		if err := os.WriteFile(path, formatted, 0o600); err != nil {
+			test.Fatal(err)
+		}
+		overlay[filepath.Join(root, filepath.FromSlash(target))] = path
+	}
+	for _, folder := range []string{"internal/web", "internal/updater", "pkg/log"} {
+		err := filepath.WalkDir(filepath.Join(root, folder), func(path string, entry os.DirEntry, walkError error) error {
+			if walkError != nil {
+				return walkError
+			}
+			if entry.IsDir() && (entry.Name() == "tests" || entry.Name() == "webui") {
+				return filepath.SkipDir
+			}
+			if entry.IsDir() || !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+				return nil
+			}
+			fileset := token.NewFileSet()
+			source, err := parser.ParseFile(fileset, path, nil, 0)
+			if err != nil {
+				return err
+			}
+			changed := false
+			if folder == "internal/web" {
+				aliases := importAliases(source)
+				ast.Inspect(source, func(node ast.Node) bool {
+					selector, ok := node.(*ast.SelectorExpr)
+					if !ok {
+						return true
+					}
+					qualifier, ok := selector.X.(*ast.Ident)
+					if !ok {
+						return true
+					}
+					dependency := aliases[qualifier.Name]
+					if (dependency == "time" && selector.Sel.Name == "Now") || (dependency == "runtime" && selector.Sel.Name == "GOOS") {
+						qualifier.Name = "taskContractFixture"
+						changed = true
+					}
+					return true
+				})
+				if changed {
+					addImport(source, "taskContractFixture", "github.com/Ehco1996/ehco/tests/contracts/fixture")
+				}
+			}
+			if folder == "internal/updater" {
+				for _, declaration := range source.Decls {
+					function, ok := declaration.(*ast.FuncDecl)
+					if !ok || function.Recv != nil {
+						continue
+					}
+					switch function.Name.Name {
+					case "Check":
+						function.Body = hookBody(function, "ContractCheck")
+						changed = true
+					case "Apply":
+						function.Body = hookBody(function, "ContractApply")
+						changed = true
+					}
+				}
+			}
+			if folder == "pkg/log" {
+				for _, declaration := range source.Decls {
+					function, ok := declaration.(*ast.FuncDecl)
+					if !ok || function.Recv != nil {
+						continue
+					}
+					observer := ""
+					if function.Name.Name == "AddWebSocketConn" {
+						observer = "ContractAddObserver"
+					}
+					if function.Name.Name == "RemoveWebSocketConn" {
+						observer = "ContractRemoveObserver"
+					}
+					if observer != "" {
+						function.Body.List = append(function.Body.List, fixtureBody("if "+observer+" != nil { "+observer+"(conn) }").List...)
+						changed = true
+					}
+				}
+			}
+			if changed {
+				removeUnusedImports(source, folder == "internal/web")
+				var content bytes.Buffer
+				if err := format.Node(&content, fileset, source); err != nil {
+					return err
+				}
+				relative, err := filepath.Rel(root, path)
+				if err != nil {
+					return err
+				}
+				writeOverlay(filepath.ToSlash(relative), content.Bytes())
+			}
+			return nil
+		})
+		if err != nil {
+			test.Fatalf("prepare contract dependency overlay: %v", err)
+		}
+	}
+	writeOverlay("internal/updater/task_contract_hooks.go", []byte(updaterHooks))
+	writeOverlay("pkg/log/task_contract_hooks.go", []byte(logHooks))
+	probe, err := os.ReadFile(filepath.Join(root, "tests/contracts/probe_test.go.txt"))
+	if err != nil {
+		test.Fatal(err)
+	}
+	writeOverlay("tests/contracts/probes/core_test.go", probe)
+	manifest, err := json.Marshal(map[string]any{"Replace": overlay})
+	if err != nil {
+		test.Fatal(err)
+	}
+	manifestPath := filepath.Join(directory, "overlay.json")
+	if err := os.WriteFile(manifestPath, manifest, 0o600); err != nil {
+		test.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 110*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, "go", "test", "-overlay", manifestPath, "-count=1", "-timeout=90s", "-run", "^"+name+"$", "./tests/contracts/probes")
