+// TestF2P_ServerTypeDeclaresNoRequestHandlers verifies REQ-STRUCT-001: the
+// remaining server type stays limited to HTTP lifecycle, middleware and
+// routing, so it must not declare request-entry-point methods that take an
+// echo.Context and hand request handling to the god object.
+func TestF2P_ServerTypeDeclaresNoRequestHandlers(t *testing.T) {
+	p := loadPackage(t)
+	si := p.serverTypeMissing(t)
+	var violations []string
+	for _, m := range p.methods {
+		if m.recv != si.name {
+			continue
+		}
+		for _, prm := range m.params {
+			if p.isEchoContext(m.file, prm.typ) {
+				violations = append(violations, fmt.Sprintf("%s.%s (%s)", m.recv, m.name, m.file))
+				break
+			}
+		}
+	}
+	if len(violations) > 0 {
+		t.Fatalf("the admin server type still owns %d request handler(s) (REQ-STRUCT-001); the six handler families must be moved off %s: %s",
+			len(violations), si.name, strings.Join(violations, ", "))
+	}
+}
