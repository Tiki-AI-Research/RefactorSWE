+const (
+	p2pDeadProxy = "http://127.0.0.1:9"
+	p2pShellMark = `<div id="root">`
+	p2pToken     = "p2p-bearer-token"
+	p2pPassword  = "p2p-dashboard-pass"
+)
+
+// init keeps every node hermetic: any outbound HTTP call (the self-update
+// endpoints are the only ones) must fail immediately instead of silently
+// depending on replay-time network access. Loopback is never proxied.
+func init() {
+	os.Setenv("HTTP_PROXY", p2pDeadProxy)
+	os.Setenv("HTTPS_PROXY", p2pDeadProxy)
+	os.Setenv("ALL_PROXY", p2pDeadProxy)
+	os.Setenv("NO_PROXY", "127.0.0.1,localhost")
+}
