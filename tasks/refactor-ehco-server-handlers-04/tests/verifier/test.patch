+	mgr.truncateErr = fmt.Errorf("wrapped confirmation: %w", ms.ErrTruncateNotConfirmed)
+	mgr.mu.Unlock()
+	st, _, body = e.do(http.MethodPost, "/api/v1/db/truncate", p2pJSONReq(http.MethodPost, "/api/v1/db/truncate", `{"confirm":""}`))
+	p2pWant(t, "wrapped unconfirmed truncate", st, http.StatusBadRequest)
+	if p2pKey(t, "truncate error", p2pJSON(t, "truncate error", body), "message") != mgr.truncateErr.Error() {
+		t.Fatalf("truncate error message changed: %s", body)
+	}
+	wrappedDisabled := fmt.Errorf("wrapped metrics: %w", cmgr.ErrMetricsDisabled)
+	mgr.mu.Lock()
+	mgr.healthErr, mgr.cleanupErr, mgr.vacuumErr, mgr.truncateErr, mgr.resetErr = wrappedDisabled, wrappedDisabled, wrappedDisabled, wrappedDisabled, wrappedDisabled
+	mgr.mu.Unlock()
+	for _, endpoint := range []struct{ method, path, payload string }{
+		{http.MethodGet, "/api/v1/db/health", ""},
+		{http.MethodPost, "/api/v1/db/cleanup", `{"older_than_days":7}`},
+		{http.MethodPost, "/api/v1/db/vacuum", ""},
+		{http.MethodPost, "/api/v1/db/truncate", `{"confirm":"yes I am sure"}`},
+		{http.MethodPost, "/api/v1/db/reset_stats", ""},
+	} {
+		status, _, response := e.do(endpoint.method, endpoint.path, p2pJSONReq(endpoint.method, endpoint.path, endpoint.payload))
+		p2pWant(t, "wrapped disabled metrics "+endpoint.path, status, http.StatusServiceUnavailable)
+		if p2pKey(t, endpoint.path, p2pJSON(t, endpoint.path, response), "message") != wrappedDisabled.Error() {
+			t.Fatalf("domain error message changed for %s: %s", endpoint.path, response)
+		}
+	}
+
