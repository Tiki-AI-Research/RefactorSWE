+	st, _, _ = e.do(http.MethodPost, "/api/v1/db/truncate", p2pJSONReq(http.MethodPost, "/api/v1/db/truncate", `{"confirm":"yes I am sure"}`))
+	p2pWant(t, "db/truncate", st, http.StatusOK)
+	mgr.mu.Lock()
+	confirm := mgr.lastConfirm
+	mgr.mu.Unlock()
