+func TestP2P_NodeMetrics_QueryParamContract(t *testing.T) {
+	mgr := &p2pFakeConnMgr{}
+	e := p2pStart(t, p2pOpts{cfg: &config.Config{}, mgr: mgr})
+
+	before := time.Now().Unix()
+	st, _, _ := e.do(http.MethodGet, "/api/v1/node_metrics/", nil)
+	p2pWant(t, "node_metrics defaults", st, http.StatusOK)
+	after := time.Now().Unix()
+	req := mgr.metricRequest()
+	if req == nil {
+		t.Fatal("node_metrics did not query the connection manager")
+	}
+	if req.StartTimestamp > before-50 || req.StartTimestamp < before-75 {
+		t.Fatalf("default start_ts = %d, want a 60s window ending now (%d..%d)", req.StartTimestamp, before-75, before-50)
+	}
+	if req.EndTimestamp < before-5 || req.EndTimestamp > after+5 {
+		t.Fatalf("default end_ts = %d, want now (%d..%d)", req.EndTimestamp, before-5, after+5)
+	}
+	if req.Num != -1 {
+		t.Fatalf("default Num = %d, want -1 (all samples)", req.Num)
+	}
+	if req.Step != 0 {
+		t.Fatalf("default Step = %d, want 0", req.Step)
+	}
+
+	st, _, _ = e.do(http.MethodGet, "/api/v1/node_metrics/?start_ts=1000&end_ts=2000&step=30&latest=true", nil)
+	p2pWant(t, "node_metrics explicit params", st, http.StatusOK)
+	req = mgr.metricRequest()
+	if req.StartTimestamp != 1000 || req.EndTimestamp != 2000 || req.Step != 30 || req.Num != 1 {
+		t.Fatalf("explicit params lost: %+v", req)
+	}
+
+	st, _, _ = e.do(http.MethodGet, "/api/v1/node_metrics/?start_ts=1000&end_ts=2000&latest=false", nil)
+	p2pWant(t, "node_metrics latest=false", st, http.StatusOK)
+	if req = mgr.metricRequest(); req.Num != -1 || req.Step != 0 {
+		t.Fatalf("latest=false params: %+v", req)
+	}
+
+	st, _, _ = e.do(http.MethodGet, "/api/v1/node_metrics/?start_ts=abc", nil)
+	p2pWant(t, "node_metrics unparsable start_ts falls back to the default window", st, http.StatusOK)
+
+	st, _, _ = e.do(http.MethodGet, "/api/v1/node_metrics/?start_ts=2000&end_ts=2000", nil)
+	p2pWant(t, "node_metrics start == end", st, http.StatusBadRequest)
+	st, _, _ = e.do(http.MethodGet, "/api/v1/node_metrics/?start_ts=3000&end_ts=2000", nil)
+	p2pWant(t, "node_metrics start > end", st, http.StatusBadRequest)
+}
