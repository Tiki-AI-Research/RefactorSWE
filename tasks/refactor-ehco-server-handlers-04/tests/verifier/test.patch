+// ---------------------------------------------------------------------------
+// F2P nodes: the admin server type stops owning the handler families
+
+func (pkg *pkgInfo) hasConcreteServiceDependency(typeText, filename string, visited map[string]bool) bool {
+	expression, err := parser.ParseExpr(typeText)
+	if err != nil {
+		return false
+	}
+	isConcrete := func(path, name string) bool {
+		return (strings.HasSuffix(path, "/internal/cmgr/ms") && name == "MetricsStore") ||
+			(strings.HasSuffix(path, "/internal/relay") && name == "Server") ||
+			(strings.HasSuffix(path, "/pkg/xray") && name == "XrayServer")
+	}
+	imports := map[string]string{}
+	for _, source := range pkg.files {
+		if pkg.fileByPos[source] != filename {
+			continue
+		}
+		for _, declaration := range source.Imports {
+			path, err := strconv.Unquote(declaration.Path.Value)
+			if err != nil {
+				continue
+			}
+			alias := filepath.Base(path)
+			if declaration.Name != nil {
+				alias = declaration.Name.Name
+			}
+			imports[alias] = path
+		}
+	}
+	concrete := false
+	ast.Inspect(expression, func(node ast.Node) bool {
+		switch value := node.(type) {
+		case *ast.SelectorExpr:
+			qualifier, ok := value.X.(*ast.Ident)
+			if !ok {
+				return true
+			}
+			path := imports[qualifier.Name]
+			if isConcrete(path, value.Sel.Name) {
+				concrete = true
+			}
+			return false
+		case *ast.Ident:
+			if isConcrete(imports["."], value.Name) {
+				concrete = true
+				return false
+			}
+			if visited[value.Name] {
+				return false
+			}
+			visited[value.Name] = true
+			for _, source := range pkg.files {
+				for _, declaration := range source.Decls {
+					group, ok := declaration.(*ast.GenDecl)
+					if !ok || group.Tok != token.TYPE {
+						continue
+					}
+					for _, item := range group.Specs {
+						definition := item.(*ast.TypeSpec)
+						if definition.Name.Name == value.Name && pkg.hasConcreteServiceDependency(exprText(pkg.fset, definition.Type), pkg.fileByPos[source], visited) {
+							concrete = true
+						}
+					}
+				}
+			}
+		}
+		return !concrete
+	})
+	return concrete
+}
