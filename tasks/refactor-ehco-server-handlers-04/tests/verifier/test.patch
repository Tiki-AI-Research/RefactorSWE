+func importAliases(source *ast.File) map[string]string {
+	aliases := map[string]string{}
+	for _, declaration := range source.Imports {
+		path, _ := strconv.Unquote(declaration.Path.Value)
+		name := filepath.Base(path)
+		if declaration.Name != nil {
+			name = declaration.Name.Name
+		}
+		aliases[name] = path
+	}
+	return aliases
+}
+
+func addImport(source *ast.File, alias, path string) {
+	declaration := &ast.ImportSpec{Name: ast.NewIdent(alias), Path: &ast.BasicLit{Kind: token.STRING, Value: strconv.Quote(path)}}
+	source.Imports = append(source.Imports, declaration)
+	source.Decls = append([]ast.Decl{&ast.GenDecl{Tok: token.IMPORT, Specs: []ast.Spec{declaration}}}, source.Decls...)
+}
+
+func removeUnusedImports(source *ast.File, clockOnly bool) {
+	used := map[string]bool{}
+	ast.Inspect(source, func(node ast.Node) bool {
+		if selector, ok := node.(*ast.SelectorExpr); ok {
+			if qualifier, ok := selector.X.(*ast.Ident); ok {
+				used[qualifier.Name] = true
+			}
+		}
+		return true
+	})
+	declarations := []ast.Decl{}
+	imports := []*ast.ImportSpec{}
+	for _, declaration := range source.Decls {
+		group, ok := declaration.(*ast.GenDecl)
+		if !ok || group.Tok != token.IMPORT {
+			declarations = append(declarations, declaration)
+			continue
+		}
+		retained := []ast.Spec{}
+		for _, item := range group.Specs {
+			entry := item.(*ast.ImportSpec)
+			path, _ := strconv.Unquote(entry.Path.Value)
+			name := filepath.Base(path)
+			if entry.Name != nil {
+				name = entry.Name.Name
+			}
+			if name == "_" || name == "." || used[name] || (clockOnly && path != "time" && path != "runtime") {
+				retained = append(retained, entry)
+				imports = append(imports, entry)
+			}
+		}
+		if len(retained) > 0 {
+			group.Specs = retained
+			declarations = append(declarations, group)
+		}
+	}
+	source.Decls = declarations
+	source.Imports = imports
+}
+
+func fixtureBody(statements string) *ast.BlockStmt {
+	source, err := parser.ParseFile(token.NewFileSet(), "fixture.go", "package fixture\nfunc fixture(){"+statements+"}", 0)
+	if err != nil {
+		panic(err)
+	}
+	return source.Decls[0].(*ast.FuncDecl).Body
+}
+
+func hookBody(function *ast.FuncDecl, name string) *ast.BlockStmt {
+	arguments := []string{}
+	for _, parameter := range function.Type.Params.List {
+		for _, identifier := range parameter.Names {
+			arguments = append(arguments, identifier.Name)
+		}
+	}
+	return fixtureBody("return " + name + "(" + strings.Join(arguments, ",") + ")")
+}
+
+const updaterHooks = `package updater
+import("context"; "go.uber.org/zap")
+var ContractCheck func(context.Context, string, string, string) (*CheckResult, error)
+var ContractApply func(context.Context, ApplyOptions, string, string, *zap.SugaredLogger) error
+`
+
+const logHooks = `package log
+import "net"
+var ContractAddObserver func(net.Conn)
+var ContractRemoveObserver func(net.Conn)
+`
