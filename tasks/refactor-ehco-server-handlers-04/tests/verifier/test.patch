+func newEngine(test *testing.T, password string) *echo.Echo {
+	test.Helper()
+	server, err := web.NewServer(&config.Config{WebHost: "127.0.0.1", WebPort: 19876, DashboardPass: password}, nil, nil, nil)
+	if err != nil {
+		test.Fatal(err)
+	}
+	engineType := reflect.TypeOf((*echo.Echo)(nil))
+	visited := map[uintptr]bool{}
+	var find func(reflect.Value, int) *echo.Echo
+	find = func(value reflect.Value, depth int) *echo.Echo {
+		if depth > 12 || !value.IsValid() {
+			return nil
+		}
+		if value.Kind() == reflect.Interface {
+			if value.IsNil() {
+				return nil
+			}
+			return find(value.Elem(), depth+1)
+		}
+		if value.Kind() == reflect.Pointer {
+			if value.IsNil() {
+				return nil
+			}
+			if value.Type() == engineType {
+				return (*echo.Echo)(unsafe.Pointer(value.Pointer()))
+			}
+			address := value.Pointer()
+			if visited[address] {
+				return nil
+			}
+			visited[address] = true
+			return find(value.Elem(), depth+1)
+		}
+		if value.Kind() == reflect.Struct {
+			for field := 0; field < value.NumField(); field++ {
+				if result := find(value.Field(field), depth+1); result != nil {
+					return result
+				}
+			}
+		}
+		return nil
+	}
+	if engine := find(reflect.ValueOf(server), 0); engine != nil {
+		return engine
+	}
+	if engine := find(reflect.ValueOf(server.APIGroup()), 0); engine != nil {
+		return engine
+	}
+	test.Fatal("the public server/routing-group capabilities expose no Echo engine for the contract fixture")
+	return nil
+}
+
+func request(engine *echo.Echo, method, path, body string, cookie *http.Cookie, ctx context.Context) *httptest.ResponseRecorder {
+	incoming := httptest.NewRequest(method, path, strings.NewReader(body))
+	incoming.Header.Set("Content-Type", "application/json")
+	if cookie != nil {
+		incoming.AddCookie(cookie)
+	}
+	if ctx != nil {
+		incoming = incoming.WithContext(ctx)
+	}
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, incoming)
+	return response
+}
+
+func sessionCookie(test *testing.T, response *httptest.ResponseRecorder) *http.Cookie {
+	test.Helper()
+	for _, cookie := range response.Result().Cookies() {
+		if cookie.Name == "ehco_sid" {
+			return cookie
+		}
+	}
+	test.Fatalf("session cookie was not issued: status=%d headers=%v", response.Code, response.Header())
+	return nil
+}
+
+func TestSessionExpiry(test *testing.T) {
+	initial := time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)
+	fixture.SetNow(initial)
+	engine := newEngine(test, "contract-password")
+	login := request(engine, http.MethodPost, "/api/v1/auth/login", `{"password":"contract-password"}`, nil, nil)
+	if login.Code != http.StatusOK {
+		test.Fatalf("login failed: %d %s", login.Code, login.Body.String())
+	}
+	cookie := sessionCookie(test, login)
+	if !cookie.Expires.Equal(initial.Add(7 * 24 * time.Hour)) {
+		test.Fatalf("session lifetime changed: %s", cookie.Expires)
+	}
+	fixture.SetNow(initial.Add(7*24*time.Hour + time.Second))
+	expired := request(engine, http.MethodGet, "/api/v1/version", "", cookie, nil)
+	if expired.Code != http.StatusUnauthorized {
+		test.Fatalf("expired session remained authorized: %d", expired.Code)
+	}
+	fixture.SetNow(initial.Add(time.Hour))
+	reused := request(engine, http.MethodGet, "/api/v1/version", "", cookie, nil)
+	if reused.Code != http.StatusUnauthorized {
+		test.Fatal("expired session was not removed from the authorization state")
+	}
+}
+
+func TestSessionRenewal(test *testing.T) {
+	initial := time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)
+	fixture.SetNow(initial)
+	engine := newEngine(test, "contract-password")
+	login := request(engine, http.MethodPost, "/api/v1/auth/login", `{"password":"contract-password"}`, nil, nil)
+	cookie := sessionCookie(test, login)
+	fixture.SetNow(initial.Add(2 * 24 * time.Hour))
+	renewed := request(engine, http.MethodGet, "/api/v1/version", "", cookie, nil)
+	if renewed.Code != http.StatusOK {
+		test.Fatalf("valid session was rejected: %d", renewed.Code)
+	}
+	renewedCookie := sessionCookie(test, renewed)
+	if renewedCookie.Value != cookie.Value || !renewedCookie.Expires.Equal(initial.Add(9*24*time.Hour)) {
+		test.Fatalf("session cookie did not slide: %#v", renewedCookie)
+	}
+	fixture.SetNow(initial.Add(8 * 24 * time.Hour))
+	stillValid := request(engine, http.MethodGet, "/api/v1/version", "", cookie, nil)
+	if stillValid.Code != http.StatusOK {
+		test.Fatal("cookie renewal did not extend the stored authorization lifetime")
+	}
+}
