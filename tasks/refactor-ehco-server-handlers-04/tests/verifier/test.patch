+package fixture
+
+import (
+	"runtime"
+	"sync/atomic"
+	"time"
+)
+
+var clock atomic.Int64
+var GOOS = runtime.GOOS
+
+func Now() time.Time {
+	if timestamp := clock.Load(); timestamp != 0 {
+		return time.Unix(0, timestamp).UTC()
+	}
+	return time.Now()
+}
+
+func SetNow(value time.Time) {
+	clock.Store(value.UnixNano())
+}
