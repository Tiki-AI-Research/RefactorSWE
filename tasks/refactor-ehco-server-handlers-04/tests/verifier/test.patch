+func (p *pkgInfo) serverTypeMissing(t *testing.T) *structInfo {
+	t.Helper()
+	si := p.serverStruct()
+	if si == nil {
+		t.Fatalf("internal/web no longer declares the admin server type `Server`; the split must keep the public server entry point")
+	}
+	return si
+}
