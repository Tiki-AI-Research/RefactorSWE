diff --git a/tests/f2p/f2p_split_test.go b/tests/f2p/f2p_split_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f6bb6d56de3f4aa976bfc905354a9e1099e11ad2
--- /dev/null
+++ b/tests/f2p/f2p_split_test.go
@@ -0,0 +1,862 @@
+// Package f2p hosts the F2P (fail-to-pass) structural selectors for the
+// ehco web admin god-object split (case T6).
+//
+// The frozen P2P suite guards the public HTTP contract, which is preserved by
+// the split. These nodes guard the change itself: the structural requirements
+// REQ-STRUCT-001..003 state that the admin server type must stop owning the
+// handler families, that each family must declare only the dependencies it
+// uses (narrow, purpose-specific contracts rather than the whole server), and
+// that the late-wired optional hooks must be explicit holder state instead of
+// raw god-object properties.
+//
+// Every node reads the production sources of package internal/web (there is no
+// unexported-identifier coupling and no runtime assembly), so a faithful split
+// of any shape passes while the pre-split god object fails:
+//
+//   - the admin Server type declares no request-handler methods,
+//   - it holds none of the handler subsystems' handles (connection manager,
+//     configuration snapshot, relay/health contracts, late-bound hook atoms),
+//   - routes are not mounted from Server methods,
+//   - each family's handler type carries only that family's dependencies.
+//
+// Each node is an exact leaf, independently selectable and independently
+// scored. Unresolved ownership is an infrastructure/coverage error, not a pass.
+package f2p
+
+import (
+	"bytes"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/printer"
+	"go/token"
+	"go/types"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// ---------------------------------------------------------------------------
+// minimal reader for the production package internal/web
+// ---------------------------------------------------------------------------
+
+type fieldInfo struct {
+	name     string
+	typ      string
+	embedded bool
+}
+
+type structInfo struct {
+	file   string
+	name   string
+	fields []fieldInfo
+}
+
+type paramInfo struct {
+	name string
+	typ  string
+}
+
+type methodInfo struct {
+	file   string
+	recv   string // base type name of the receiver, e.g. "Server"
+	name   string
+	params []paramInfo
+}
+
+type funcInfo struct {
+	file   *ast.File
+	decl   *ast.FuncDecl
+	params []paramInfo
+	locals map[string]string
+}
+
+type pkgInfo struct {
+	valueSources    map[types.Object][]ast.Expr
+	functionDecls   map[types.Object]*ast.FuncDecl
+	syntheticFields map[string]map[string]types.Type
+	tb              testing.TB
+	typePkg         *types.Package
+	typeInfo        *types.Info
+	contracts       map[string]types.Type
+	fset            *token.FileSet
+	root            string
+	dir             string
+	files           []*ast.File
+	fileByPos       map[*ast.File]string // file -> base name
+	imports         map[*ast.File]map[string]string
+	structs         map[string]*structInfo
+	methods         []methodInfo
+	funcs           []*funcInfo
+	routeMounts     []routeMount
+}
+
+type routeMount struct {
+	file     string
+	method   string // GET/POST/...
+	path     string // literal path when available
+	recvText string // rendered receiver expression of the handler value
+	recvType string // resolved receiver type text, "" when unresolved
+}
+
+func findRepoRoot(tb testing.TB) string {
+	tb.Helper()
+	dir, err := os.Getwd()
+	if err != nil {
+		tb.Fatalf("getwd: %v", err)
+	}
+	for {
+		b, err := os.ReadFile(filepath.Join(dir, "go.mod"))
+		if err == nil && strings.Contains(string(b), "module github.com/Ehco1996/ehco") {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			tb.Fatalf("go.mod of github.com/Ehco1996/ehco not found above %s", dir)
+		}
+		dir = parent
+	}
+}
+
+func exprText(fset *token.FileSet, e ast.Expr) string {
+	if e == nil {
+		return ""
+	}
+	var b bytes.Buffer
+	if err := printer.Fprint(&b, fset, e); err != nil {
+		return ""
+	}
+	return b.String()
+}
+
+// importLocalName approximates the package name a default (unaliased)
+// import binds: the last path element, unless it is a semantic version
+// suffix such as the "v4" of github.com/labstack/echo/v4.
+func importLocalName(path string) string {
+	name := filepath.Base(path)
+	if versionSuffix.MatchString(name) {
+		name = filepath.Base(filepath.Dir(path))
+	}
+	return name
+}
+
+var versionSuffix = regexp.MustCompile(`^v[0-9]+$`)
+
+func baseTypeName(typ string) string {
+	s := strings.TrimSpace(typ)
+	for strings.HasPrefix(s, "*") {
+		s = strings.TrimSpace(strings.TrimPrefix(s, "*"))
+	}
+	if i := strings.IndexByte(s, '['); i >= 0 {
+		s = s[:i]
+	}
+	if i := strings.LastIndexByte(s, '.'); i >= 0 {
+		s = s[i+1:]
+	}
+	return s
+}
+
+func loadPackage(tb testing.TB) *pkgInfo {
+	tb.Helper()
+	root := findRepoRoot(tb)
+	dir := filepath.Join(root, "internal", "web")
+	ents, err := os.ReadDir(dir)
+	if err != nil {
+		tb.Fatalf("read %s: %v", dir, err)
+	}
+	pkg := &pkgInfo{
+		fset:      token.NewFileSet(),
+		root:      root,
+		dir:       dir,
+		fileByPos: map[*ast.File]string{},
+		imports:   map[*ast.File]map[string]string{},
+		structs:   map[string]*structInfo{},
+	}
+	for _, ent := range ents {
+		name := ent.Name()
+		if ent.IsDir() || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+		f, err := parser.ParseFile(pkg.fset, filepath.Join(dir, name), nil, parser.ParseComments)
+		if err != nil {
+			tb.Fatalf("parse %s: %v", name, err)
+		}
+		pkg.files = append(pkg.files, f)
+		pkg.fileByPos[f] = name
+		m := map[string]string{}
+		for _, imp := range f.Imports {
+			path, err := strconv.Unquote(imp.Path.Value)
+			if err != nil {
+				continue
+			}
+			local := importLocalName(path)
+			if imp.Name != nil {
+				local = imp.Name.Name
+			}
+			m[local] = path
+		}
+		pkg.imports[f] = m
+	}
+	if len(pkg.files) == 0 {
+		tb.Fatalf("no production .go files found in %s", dir)
+	}
+	pkg.loadSemanticTypes(tb)
+	pkg.collect(tb)
+	return pkg
+}
+
+func (p *pkgInfo) collect(tb testing.TB) {
+	for _, f := range p.files {
+		file := p.fileByPos[f]
+		for _, decl := range f.Decls {
+			switch d := decl.(type) {
+			case *ast.GenDecl:
+				if d.Tok != token.TYPE {
+					continue
+				}
+				for _, spec := range d.Specs {
+					ts, ok := spec.(*ast.TypeSpec)
+					if !ok {
+						continue
+					}
+					st, ok := ts.Type.(*ast.StructType)
+					if !ok {
+						continue
+					}
+					info := &structInfo{file: file, name: ts.Name.Name}
+					for _, fld := range st.Fields.List {
+						typ := exprText(p.fset, fld.Type)
+						if len(fld.Names) == 0 {
+							info.fields = append(info.fields, fieldInfo{name: baseTypeName(typ), typ: typ, embedded: true})
+							continue
+						}
+						for _, n := range fld.Names {
+							info.fields = append(info.fields, fieldInfo{name: n.Name, typ: typ})
+						}
+					}
+					p.structs[ts.Name.Name] = info
+				}
+			case *ast.FuncDecl:
+				if d.Name == nil {
+					continue
+				}
+				fn := &funcInfo{file: f, decl: d, locals: map[string]string{}}
+				if d.Type.Params != nil {
+					for _, fld := range d.Type.Params.List {
+						typ := exprText(p.fset, fld.Type)
+						if semantic := p.typeInfo.TypeOf(fld.Type); semantic != nil {
+							typ = semanticTypeText(types.Unalias(semantic))
+						}
+						names := fld.Names
+						if len(names) == 0 {
+							fn.params = append(fn.params, paramInfo{name: "", typ: typ})
+							continue
+						}
+						for _, n := range names {
+							fn.params = append(fn.params, paramInfo{name: n.Name, typ: typ})
+						}
+					}
+				}
+				if d.Body != nil {
+					p.collectLocals(d.Body, fn.locals)
+				}
+				p.funcs = append(p.funcs, fn)
+				if d.Recv != nil && len(d.Recv.List) > 0 {
+					recvType := exprText(p.fset, d.Recv.List[0].Type)
+					if typ := p.typeInfo.TypeOf(d.Recv.List[0].Type); typ != nil {
+						recvType = semanticTypeText(unpoint(typ))
+					}
+					p.methods = append(p.methods, methodInfo{
+						file:   file,
+						recv:   baseTypeName(recvType),
+						name:   d.Name.Name,
+						params: fn.params,
+					})
+				}
+			}
+		}
+	}
+	p.buildHandlerSources()
+	p.collectRoutes()
+}
+
+// collectLocals records every identifier that is explicitly bound to a type
+// inside a function body (parameter declarations are handled by the caller).
+func (p *pkgInfo) collectLocals(body *ast.BlockStmt, out map[string]string) {
+	ast.Inspect(body, func(n ast.Node) bool {
+		switch s := n.(type) {
+		case *ast.DeclStmt:
+			gd, ok := s.Decl.(*ast.GenDecl)
+			if !ok || gd.Tok != token.VAR {
+				break
+			}
+			for _, spec := range gd.Specs {
+				vs, ok := spec.(*ast.ValueSpec)
+				if !ok {
+					continue
+				}
+				typ := exprText(p.fset, vs.Type)
+				if typ == "" && len(vs.Values) == 1 {
+					typ = p.inferValueType(vs.Values[0])
+				}
+				for _, n := range vs.Names {
+					if typ != "" {
+						out[n.Name] = typ
+					}
+				}
+			}
+		case *ast.AssignStmt:
+			if s.Tok != token.DEFINE && s.Tok != token.ASSIGN {
+				break
+			}
+			for i, lhs := range s.Lhs {
+				id, ok := lhs.(*ast.Ident)
+				if !ok || i >= len(s.Rhs) {
+					continue
+				}
+				if typ := p.inferValueType(s.Rhs[i]); typ != "" {
+					out[id.Name] = typ
+				}
+			}
+		}
+		return true
+	})
+}
+
+func (p *pkgInfo) inferValueType(e ast.Expr) string {
+	switch v := e.(type) {
+	case *ast.UnaryExpr:
+		if v.Op == token.AND {
+			return p.inferValueType(v.X)
+		}
+	case *ast.CompositeLit:
+		return exprText(p.fset, v.Type)
+	case *ast.CallExpr:
+		if id, ok := v.Fun.(*ast.Ident); ok && id.Name == "new" && len(v.Args) == 1 {
+			return "*" + exprText(p.fset, v.Args[0])
+		}
+	case *ast.ParenExpr:
+		return p.inferValueType(v.X)
+	}
+	return ""
+}
+
+var routeMethods = map[string]bool{
+	"GET": true, "POST": true, "PUT": true, "DELETE": true,
+	"PATCH": true, "HEAD": true, "OPTIONS": true, "Any": true,
+}
+
+func (p *pkgInfo) collectRoutes() {
+	for _, fn := range p.funcs {
+		if fn.decl.Body == nil {
+			continue
+		}
+		bindings := map[string]string{}
+		for k, v := range fn.locals {
+			bindings[k] = v
+		}
+		for _, prm := range fn.params {
+			if prm.name != "" {
+				bindings[prm.name] = prm.typ
+			}
+		}
+		file := p.fileByPos[fn.file]
+		ast.Inspect(fn.decl.Body, func(n ast.Node) bool {
+			call, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			sel, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok || !routeMethods[sel.Sel.Name] {
+				return true
+			}
+			rm := routeMount{file: file, method: sel.Sel.Name}
+			if len(call.Args) >= 1 {
+				if lit, ok := call.Args[0].(*ast.BasicLit); ok && lit.Kind == token.STRING {
+					if s, err := strconv.Unquote(lit.Value); err == nil {
+						rm.path = s
+					}
+				}
+			}
+
+			if len(call.Args) >= 2 {
+				owners := p.handlerOwners(call.Args[1], map[ast.Expr]bool{})
+				for _, owner := range owners {
+					bound := rm
+					bound.recvType = owner
+					bound.recvText = exprText(p.fset, call.Args[1])
+					p.routeMounts = append(p.routeMounts, bound)
+				}
+				if len(owners) == 0 {
+					p.routeMounts = append(p.routeMounts, rm)
+				}
+			}
+
+			return true
+		})
+	}
+}
+
+func (p *pkgInfo) resolveExprType(e ast.Expr, bindings map[string]string) string {
+	switch v := e.(type) {
+	case *ast.Ident:
+		return bindings[v.Name]
+	case *ast.ParenExpr:
+		return p.resolveExprType(v.X, bindings)
+	case *ast.UnaryExpr:
+		if v.Op == token.AND {
+			return p.resolveExprType(v.X, bindings)
+		}
+	case *ast.CompositeLit:
+		return exprText(p.fset, v.Type)
+	case *ast.CallExpr:
+		return p.inferValueType(v)
+	case *ast.IndexExpr:
+		return p.resolveExprType(v.X, bindings)
+	case *ast.SelectorExpr:
+		base := p.resolveExprType(v.X, bindings)
+		if base == "" {
+			return ""
+		}
+		st, ok := p.structs[baseTypeName(base)]
+		if !ok {
+			return ""
+		}
+		for _, fld := range st.fields {
+			if fld.name == v.Sel.Name {
+				return fld.typ
+			}
+		}
+	}
+	return ""
+}
+
+// isEchoContext reports whether the rendered type text refers to echo.Context
+// in the file where the type was written.
+func (p *pkgInfo) isEchoContext(file string, typ string) bool {
+	typ = strings.TrimSpace(typ)
+	for _, f := range p.files {
+		if p.fileByPos[f] != file {
+			continue
+		}
+		for local, path := range p.imports[f] {
+			if path != "github.com/labstack/echo/v4" {
+				continue
+			}
+			if typ == local+".Context" || (local == "." && typ == "Context") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (p *pkgInfo) serverStruct() *structInfo {
+	return p.structs["Server"]
+}
+
+func (p *pkgInfo) fieldsMatching(si *structInfo, patterns []string) []string {
+	var hits []string
+	for _, fld := range si.fields {
+		for _, pat := range patterns {
+			if regexp.MustCompile(pat).MatchString(p.fieldContractLabels(si, fld)) {
+				label := fld.name
+				if label == "" {
+					label = "(embedded)"
+				}
+				hits = append(hits, fmt.Sprintf("%s.%s: %s", si.name, label, fld.typ))
+				break
+			}
+		}
+	}
+	return hits
+}
