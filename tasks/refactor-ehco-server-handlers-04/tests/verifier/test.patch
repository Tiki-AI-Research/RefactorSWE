+	st, _, body = e.do(http.MethodPost, "/api/v1/db/vacuum", nil)
+	p2pWant(t, "db/vacuum", st, http.StatusOK)
+	p2pJSONEqual(t, "vacuum source payload", body, json.RawMessage(expectedVacuum))
+	mgr.mu.Lock()
