+				}
+			},
+		},
+		{
+			name:       "explicit timestamps",
+			query:      fmt.Sprintf("?start_ts=%d&end_ts=%d", now-100, now),
+			expectCode: http.StatusOK,
+			verifyReq: func(t *testing.T, req *ms.QueryNodeMetricsReq) {
+				if req.StartTimestamp != now-100 || req.EndTimestamp != now {
+					t.Errorf("unexpected range: %d to %d", req.StartTimestamp, req.EndTimestamp)
+				}
+			},
+		},
+		{
+			name:       "latest=true sets Num=1",
+			query:      "?latest=true",
+			expectCode: http.StatusOK,
+			verifyReq: func(t *testing.T, req *ms.QueryNodeMetricsReq) {
+				if req.Num != 1 {
+					t.Errorf("expected Num=1, got %d", req.Num)
+				}
+			},
+		},
+		{
+			name:       "step > 0 passed through",
+			query:      "?step=15",
+			expectCode: http.StatusOK,
+			verifyReq: func(t *testing.T, req *ms.QueryNodeMetricsReq) {
+				if req.Step != 15 {
+					t.Errorf("expected Step=15, got %d", req.Step)
+				}
+			},
+		},
+		{
+			name:       "invalid time range start >= end returns 400",
+			query:      fmt.Sprintf("?start_ts=%d&end_ts=%d", now+100, now),
+			expectCode: http.StatusBadRequest,
