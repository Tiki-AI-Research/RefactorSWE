+	if srcWithNilCfg.RuleCount() != 0 {
+		t.Errorf("expected 0 rules for nil cfg, got %d", srcWithNilCfg.RuleCount())
+	}
+	if !srcWithNilCfg.LastReloadTime().IsZero() {
+		t.Errorf("expected zero time for nil cfg, got %v", srcWithNilCfg.LastReloadTime())
+	}
+
+	// 3. configRuleSource with initialized Config
+	tmpDir := t.TempDir()
+	cfgPath := filepath.Join(tmpDir, "config.json")
+	if err := os.WriteFile(cfgPath, []byte(`{"relay_configs":[{"listen":"127.0.0.1:1000","listen_type":"raw","transport_type":"raw"},{"listen":"127.0.0.1:1001","listen_type":"raw","transport_type":"raw"}]}`), 0644); err != nil {
+		t.Fatalf("write temp config: %v", err)
+	}
+	cfg := config.NewConfig(cfgPath)
+	if err := cfg.LoadConfig(true); err != nil {
+		t.Fatalf("load config: %v", err)
+	}
+
+	src := newConfigRuleSource(cfg)
+	if src.RuleCount() != 2 {
+		t.Errorf("expected 2 rules, got %d", src.RuleCount())
+	}
+	if src.LastReloadTime().IsZero() {
+		t.Fatal("expected non-zero LastReloadTime after LoadConfig")
+	}
+	if !src.LastReloadTime().Equal(cfg.LastLoadTime()) {
+		t.Errorf("expected LastReloadTime %v to match cfg.LastLoadTime %v", src.LastReloadTime(), cfg.LastLoadTime())
+	}
+
+	// Overview handler using this configRuleSource
+	h := newOverviewHandler(src, nil, nil)
+	e := echo.New()
+	req := httptest.NewRequest(http.MethodGet, "/api/v1/overview", nil)
+	rec := httptest.NewRecorder()
+	c := e.NewContext(req, rec)
+	if err := h.Overview(c); err != nil {
+		t.Fatalf("Overview: %v", err)
+	}
+	var resp OverviewResp
+	if err := json.Unmarshal(rec.Body.Bytes(), &resp); err != nil {
+		t.Fatalf("unmarshal OverviewResp: %v", err)
+	}
+	if resp.Rules != 2 {
+		t.Errorf("expected 2 rules in overview, got %d", resp.Rules)
+	}
+	if !resp.LastReloadAt.Equal(cfg.LastLoadTime()) {
+		t.Errorf("expected overview LastReloadAt %v to match cfg.LastLoadTime %v", resp.LastReloadAt, cfg.LastLoadTime())
+	}
+}
