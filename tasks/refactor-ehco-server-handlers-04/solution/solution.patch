+	s, err := NewServer(cfg, reloaderMock, checkerMock, cmgrMock)
+	if err != nil {
+		t.Fatalf("NewServer: %v", err)
+	}
+
+	// 9 public paths: anonymous must NOT be 401
+	publicPaths := []struct {
+		method string
+		path   string
+		body   string
+	}{
+		{http.MethodGet, "/", ""},
+		{http.MethodGet, "/index.html", ""},
+		{http.MethodGet, "/favicon.ico", ""},
+		{http.MethodGet, "/favicon.svg", ""},
+		{http.MethodGet, "/robots.txt", ""},
+		{http.MethodGet, "/assets/test.css", ""},
+		{http.MethodGet, "/api/v1/auth/info", ""},
+		{http.MethodPost, "/api/v1/auth/login", `{"password":"secretpass"}`},
+		{http.MethodPost, "/api/v1/auth/logout", ""},
+	}
+
+	for _, p := range publicPaths {
+		req := httptest.NewRequest(p.method, p.path, strings.NewReader(p.body))
+		req.Header.Set("Content-Type", "application/json")
+		rec := httptest.NewRecorder()
+		s.e.ServeHTTP(rec, req)
+		if rec.Code == http.StatusUnauthorized {
+			t.Errorf("public path %s %s returned 401", p.method, p.path)
+		}
+		if p.path == "/api/v1/auth/logout" {
+			if rec.Code != http.StatusOK {
+				t.Errorf("anonymous logout expected 200, got %d", rec.Code)
+			}
+			var body map[string]any
+			if err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
+				t.Errorf("unmarshal anonymous logout response: %v", err)
+			} else if auth, ok := body["authenticated"].(bool); !ok || auth {
+				t.Errorf("expected authenticated: false, got %v", body["authenticated"])
+			}
+		}
+	}
+
+	// Protected routes: anonymous must be 401
+	protectedPaths := []struct {
+		method string
+		path   string
+	}{
+		{http.MethodGet, "/metrics/"},
+		{http.MethodGet, "/debug/pprof/"},
+		{http.MethodGet, "/api/v1/config/"},
+		{http.MethodPost, "/api/v1/config/reload/"},
+		{http.MethodGet, "/api/v1/health_check/"},
+		{http.MethodGet, "/api/v1/node_metrics/"},
+		{http.MethodGet, "/api/v1/overview"},
+		{http.MethodGet, "/api/v1/version"},
+		{http.MethodGet, "/api/v1/update/check"},
+		{http.MethodPost, "/api/v1/update/apply"},
+		{http.MethodGet, "/api/v1/db/health"},
+		{http.MethodPost, "/api/v1/db/cleanup"},
+		{http.MethodPost, "/api/v1/db/vacuum"},
+		{http.MethodPost, "/api/v1/db/truncate"},
+		{http.MethodPost, "/api/v1/db/reset_stats"},
+		{http.MethodGet, "/ws/logs"},
+	}
+
+	for _, p := range protectedPaths {
+		req := httptest.NewRequest(p.method, p.path, nil)
+		rec := httptest.NewRecorder()
+		s.e.ServeHTTP(rec, req)
+		if rec.Code != http.StatusUnauthorized {
+			t.Errorf("protected path %s %s anonymous: expected 401, got %d", p.method, p.path, rec.Code)
+		}
+	}
+
+	// Protected path with credentials: Bearer and X-Ehco-Token
+	for _, authHeader := range []struct {
+		key   string
+		value string
+	}{
+		{"Authorization", "Bearer mytoken"},
+		{"X-Ehco-Token", "mytoken"},
+	} {
+		reqAuth := httptest.NewRequest(http.MethodGet, "/api/v1/config/", nil)
+		reqAuth.Header.Set(authHeader.key, authHeader.value)
+		recAuth := httptest.NewRecorder()
+		s.e.ServeHTTP(recAuth, reqAuth)
+		if recAuth.Code == http.StatusUnauthorized {
+			t.Errorf("protected path with %s returned 401", authHeader.key)
+		}
+	}
+}
