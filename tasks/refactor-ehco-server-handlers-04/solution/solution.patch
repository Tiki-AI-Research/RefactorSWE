+func TestOverview_SourcesOptional(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+
+	rules := &fakeRuleSource{rules: 5, time: now}
+	status := &fakeStatusSource{snap: glue.XraySnapshot{Conns: 12}, ok: true}
+	metrics := &fakeNodeQuerier{data: []ms.NodeMetrics{{CPUUsage: 25.5}}}
+
+	cases := []struct {
+		name        string
+		ruleSrc     RuleSource
+		statusSrc   StatusSource
+		metricSrc   NodeMetricsQuerier
+		expectRules int
+		hasXray     bool
+		hasHost     bool
+	}{
+		{"all nil", nil, nil, nil, 0, false, false},
+		{"rules only", rules, nil, nil, 5, false, false},
+		{"status only", nil, status, nil, 0, true, false},
+		{"metrics only", nil, nil, metrics, 0, false, true},
+		{"rules + status", rules, status, nil, 5, true, false},
+		{"rules + metrics", rules, nil, metrics, 5, false, true},
+		{"all three present", rules, status, metrics, 5, true, true},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			h := newOverviewHandler(tc.ruleSrc, tc.statusSrc, tc.metricSrc)
+			e := echo.New()
+			req := httptest.NewRequest(http.MethodGet, "/api/v1/overview", nil)
+			rec := httptest.NewRecorder()
+			c := e.NewContext(req, rec)
+
+			if err := h.Overview(c); err != nil {
+				t.Fatalf("Overview: %v", err)
+			}
+			if rec.Code != http.StatusOK {
+				t.Fatalf("expected 200, got %d", rec.Code)
+			}
+
+			body := rec.Body.String()
+			// Must never contain null for xray or host
+			if strings.Contains(body, `"xray":null`) {
+				t.Errorf("xray is null in %s", body)
+			}
+			if strings.Contains(body, `"host":null`) {
+				t.Errorf("host is null in %s", body)
+			}
+
+			// last_reload_at is always serialized
+			if !strings.Contains(body, `"last_reload_at"`) {
+				t.Errorf("last_reload_at missing in %s", body)
+			}
+
+			var resp OverviewResp
+			if err := json.Unmarshal(rec.Body.Bytes(), &resp); err != nil {
+				t.Fatalf("unmarshal OverviewResp: %v", err)
+			}
+
+			// rules count must match expectation
+			if resp.Rules != tc.expectRules {
+				t.Errorf("expected rules %d, got %d", tc.expectRules, resp.Rules)
+			}
+
+			// last_reload_at must equal LastReloadTime() when ruleSrc is present, or zero when absent
+			if tc.ruleSrc != nil {
+				expectedTime := tc.ruleSrc.LastReloadTime()
+				if !resp.LastReloadAt.Equal(expectedTime) {
+					t.Errorf("expected LastReloadAt %v, got %v", expectedTime, resp.LastReloadAt)
+				}
+			} else {
+				if !resp.LastReloadAt.IsZero() {
+					t.Errorf("expected zero LastReloadAt when ruleSrc is nil, got %v", resp.LastReloadAt)
+				}
+			}
+
+			if tc.hasXray != (resp.Xray != nil) {
+				t.Errorf("xray presence mismatch: expected %v, got %v", tc.hasXray, resp.Xray != nil)
+			}
+			if tc.hasHost != (resp.Host != nil) {
+				t.Errorf("host presence mismatch: expected %v, got %v", tc.hasHost, resp.Host != nil)
+			}
+		})
+	}
+
+	// Verify host query params
+	querier := &fakeNodeQuerier{data: []ms.NodeMetrics{{CPUUsage: 10}}}
+	h := newOverviewHandler(nil, nil, querier)
+	e := echo.New()
+	req := httptest.NewRequest(http.MethodGet, "/api/v1/overview", nil)
+	rec := httptest.NewRecorder()
+	c := e.NewContext(req, rec)
+	_ = h.Overview(c)
+	if querier.req == nil {
+		t.Fatal("QueryNodeMetrics was not called")
+	}
+	if querier.req.Num != 1 {
+		t.Errorf("expected Num=1, got %d", querier.req.Num)
+	}
+	diff := querier.req.EndTimestamp - querier.req.StartTimestamp
+	if diff != 300 {
+		t.Errorf("expected 300s window, got %d", diff)
+	}
+}
