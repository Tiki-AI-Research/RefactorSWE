+func TestSessionStore_ExpiryPruneAndSlide(t *testing.T) {
+	store := newSessionStore()
+	sid, exp, err := store.issue()
+	if err != nil {
+		t.Fatalf("issue: %v", err)
+	}
+
+	// Validate fresh session: returns true and slides expiry
+	ok, newExp := store.validate(sid)
+	if !ok {
+		t.Fatal("expected validate to be true")
+	}
+	if newExp.Before(exp) {
+		t.Fatalf("expected slide forward, got %v < %v", newExp, exp)
+	}
+
+	// Artificially expire the session
+	store.mu.Lock()
+	store.sessions[sid] = time.Now().Add(-1 * time.Hour)
+	store.mu.Unlock()
+
+	// Validate expired session: should return false and prune entry
+	ok, _ = store.validate(sid)
+	if ok {
+		t.Fatal("expected expired session to validate false")
+	}
+	store.mu.Lock()
+	_, exists := store.sessions[sid]
+	store.mu.Unlock()
+	if exists {
+		t.Fatal("expected expired session to be pruned from sessions map")
+	}
+}
