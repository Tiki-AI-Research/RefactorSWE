+		{
+			name:       "querier error returns 500",
+			query:      "",
+			mockErr:    errors.New("db error"),
+			expectCode: http.StatusInternalServerError,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			q := &fakeNodeQuerier{err: tc.mockErr}
