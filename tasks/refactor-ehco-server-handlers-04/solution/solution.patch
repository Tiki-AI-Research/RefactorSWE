+func TestLogStream_FanoutDeadConnRemoval(t *testing.T) {
+	syncher := log.NewWebSocketLogSyncher()
+
+	// Create 2 TCP loopback pairs to simulate 2 connected clients
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	defer ln.Close()
+
+	c1, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatalf("dial c1: %v", err)
+	}
+	s1, err := ln.Accept()
+	if err != nil {
+		t.Fatalf("accept s1: %v", err)
+	}
+
+	c2, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatalf("dial c2: %v", err)
+	}
+	s2, err := ln.Accept()
+	if err != nil {
+		t.Fatalf("accept s2: %v", err)
+	}
+
+	syncher.AddConn(s1)
+	syncher.AddConn(s2)
+
+	// Force s1 to fail on write: set linger 0 and close client c1, and close s1
+	if tcpC1, ok := c1.(*net.TCPConn); ok {
+		_ = tcpC1.SetLinger(0)
+	}
+	_ = c1.Close()
+	_ = s1.Close()
+
+	// Write log frame through syncher
+	logEntry := []byte(`{"msg":"surviving client log"}`)
+	n, err := syncher.Write(logEntry)
+	if err != nil {
+		t.Fatalf("syncher.Write error: %v", err)
+	}
+	if n != len(logEntry) {
+		t.Errorf("expected n=%d, got %d", len(logEntry), n)
+	}
+
+	// c2 should receive the frame despite s1 failing
+	_ = c2.SetReadDeadline(time.Now().Add(1 * time.Second))
+	data, op, err := wsutil.ReadServerData(c2)
+	if err != nil {
+		t.Fatalf("c2 failed reading frame: %v", err)
+	}
+	if op != ws.OpText {
+		t.Errorf("expected OpText, got %v", op)
+	}
+	if !strings.Contains(string(data), "surviving client log") {
+		t.Errorf("expected frame to contain log message, got %s", string(data))
+	}
+
+	// Remove c2 via RemoveConn
+	syncher.RemoveConn(s2)
+	_ = c2.Close()
+	_ = s2.Close()
+
+	// Writing when no connections are active should succeed cleanly
+	if _, err := syncher.Write(logEntry); err != nil {
+		t.Errorf("write with zero conns error: %v", err)
+	}
+
+	// Test global AddWebSocketConn and RemoveWebSocketConn helpers
+	s3, c3 := net.Pipe()
+	log.AddWebSocketConn(s3)
+	log.RemoveWebSocketConn(s3)
+	_ = s3.Close()
+	_ = c3.Close()
+}
