+func TestHandleLogin_Outcomes(t *testing.T) {
+	e := echo.New()
+
+	// 1. Neither DashboardPass nor ApiToken configured: 200 authenticated: true, no session issued
+	authOpen := newAuthenticator(&config.Config{})
+	reqOpen := httptest.NewRequest(http.MethodPost, "/api/v1/auth/login", strings.NewReader(`{"password":"any"}`))
+	reqOpen.Header.Set("Content-Type", "application/json")
+	recOpen := httptest.NewRecorder()
+	cOpen := e.NewContext(reqOpen, recOpen)
+	if err := authOpen.HandleLogin(cOpen); err != nil {
+		t.Fatalf("HandleLogin open: %v", err)
+	}
+	if recOpen.Code != http.StatusOK {
+		t.Fatalf("expected 200, got %d", recOpen.Code)
+	}
+	if !strings.Contains(recOpen.Body.String(), `"authenticated":true`) {
+		t.Fatalf("expected authenticated:true in %s", recOpen.Body.String())
+	}
+	if len(recOpen.Result().Cookies()) != 0 {
+		t.Fatal("open dashboard should not issue cookies")
+	}
+
+	// 2. Only ApiToken set (machine only): 403 Forbidden
+	authMachineOnly := newAuthenticator(&config.Config{ApiToken: "some-token"})
+	reqMachine := httptest.NewRequest(http.MethodPost, "/api/v1/auth/login", strings.NewReader(`{"password":"any"}`))
+	reqMachine.Header.Set("Content-Type", "application/json")
+	recMachine := httptest.NewRecorder()
+	cMachine := e.NewContext(reqMachine, recMachine)
+	errMachine := authMachineOnly.HandleLogin(cMachine)
+	if errMachine == nil {
+		t.Fatal("expected 403, got nil")
+	}
+	httpErrM, ok := errMachine.(*echo.HTTPError)
+	if !ok || httpErrM.Code != http.StatusForbidden {
+		t.Fatalf("expected 403, got %v", errMachine)
+	}
+
+	// 3. Malformed JSON body: 400 Bad Request
+	authPass := newAuthenticator(&config.Config{DashboardPass: "correct-pass"})
+	reqBadJSON := httptest.NewRequest(http.MethodPost, "/api/v1/auth/login", strings.NewReader(`invalid json`))
+	reqBadJSON.Header.Set("Content-Type", "application/json")
+	recBadJSON := httptest.NewRecorder()
+	cBadJSON := e.NewContext(reqBadJSON, recBadJSON)
+	errBadJSON := authPass.HandleLogin(cBadJSON)
+	if errBadJSON == nil {
+		t.Fatal("expected 400, got nil")
+	}
+	httpErrBad, ok := errBadJSON.(*echo.HTTPError)
+	if !ok || httpErrBad.Code != http.StatusBadRequest {
+		t.Fatalf("expected 400, got %v", errBadJSON)
+	}
+
+	// 4. Wrong password: 401 Unauthorized
+	reqWrong := httptest.NewRequest(http.MethodPost, "/api/v1/auth/login", strings.NewReader(`{"password":"wrong-pass"}`))
+	reqWrong.Header.Set("Content-Type", "application/json")
+	recWrong := httptest.NewRecorder()
+	cWrong := e.NewContext(reqWrong, recWrong)
+	errWrong := authPass.HandleLogin(cWrong)
+	if errWrong == nil {
+		t.Fatal("expected 401, got nil")
+	}
+	httpErrWrong, ok := errWrong.(*echo.HTTPError)
+	if !ok || httpErrWrong.Code != http.StatusUnauthorized {
+		t.Fatalf("expected 401, got %v", errWrong)
+	}
+
+	// 5. Correct password: 200 + sets session cookie
+	reqCorrect := httptest.NewRequest(http.MethodPost, "/api/v1/auth/login", strings.NewReader(`{"password":"correct-pass"}`))
+	reqCorrect.Header.Set("Content-Type", "application/json")
+	recCorrect := httptest.NewRecorder()
+	cCorrect := e.NewContext(reqCorrect, recCorrect)
+	if err := authPass.HandleLogin(cCorrect); err != nil {
+		t.Fatalf("expected success, got %v", err)
+	}
+	if recCorrect.Code != http.StatusOK {
+		t.Fatalf("expected 200, got %d", recCorrect.Code)
+	}
+	cookies := recCorrect.Result().Cookies()
+	var sidCookie *http.Cookie
+	for _, ck := range cookies {
+		if ck.Name == sessionCookieName {
+			sidCookie = ck
+		}
+	}
+	if sidCookie == nil || sidCookie.Value == "" {
+		t.Fatal("session cookie was not issued")
+	}
+
+	// 6. Logout: clears cookie and revokes session
+	reqLogout := httptest.NewRequest(http.MethodPost, "/api/v1/auth/logout", nil)
+	reqLogout.AddCookie(sidCookie)
+	recLogout := httptest.NewRecorder()
+	cLogout := e.NewContext(reqLogout, recLogout)
+	if err := authPass.HandleLogout(cLogout); err != nil {
+		t.Fatalf("logout failed: %v", err)
+	}
+	if recLogout.Code != http.StatusOK {
+		t.Fatalf("expected 200, got %d", recLogout.Code)
+	}
+	var logoutBody map[string]any
+	if err := json.Unmarshal(recLogout.Body.Bytes(), &logoutBody); err != nil {
+		t.Fatalf("unmarshal logout body: %v", err)
+	}
+	if authVal, ok := logoutBody["authenticated"].(bool); !ok || authVal {
+		t.Fatalf("expected authenticated: false, got %v", logoutBody["authenticated"])
+	}
+	logoutCookies := recLogout.Result().Cookies()
+	var clearedCookie *http.Cookie
+	for _, ck := range logoutCookies {
+		if ck.Name == sessionCookieName {
+			clearedCookie = ck
+		}
+	}
+	if clearedCookie == nil || clearedCookie.MaxAge >= 0 {
+		t.Fatal("cookie was not cleared on logout")
+	}
+	// Session in store should now be revoked
+	if ok, _ := authPass.sessions.validate(sidCookie.Value); ok {
+		t.Fatal("session was not revoked on logout")
+	}
+
+	// 7. Logout when already unauthenticated (no cookie at all): idempotent 200, authenticated: false
+	reqLogoutUnauth := httptest.NewRequest(http.MethodPost, "/api/v1/auth/logout", nil)
+	recLogoutUnauth := httptest.NewRecorder()
+	cLogoutUnauth := e.NewContext(reqLogoutUnauth, recLogoutUnauth)
+	if err := authPass.HandleLogout(cLogoutUnauth); err != nil {
+		t.Fatalf("logout when already unauthenticated failed: %v", err)
+	}
+	if recLogoutUnauth.Code != http.StatusOK {
+		t.Fatalf("expected 200 on unauthenticated logout, got %d", recLogoutUnauth.Code)
+	}
+	var unauthBody map[string]any
+	if err := json.Unmarshal(recLogoutUnauth.Body.Bytes(), &unauthBody); err != nil {
+		t.Fatalf("unmarshal unauthenticated logout: %v", err)
+	}
+	if authVal, ok := unauthBody["authenticated"].(bool); !ok || authVal {
+		t.Fatalf("expected authenticated: false, got %v", unauthBody["authenticated"])
+	}
+
+	// 8. Logout with stale/invalid session cookie: idempotent 200, authenticated: false, clears cookie
+	reqLogoutInvalid := httptest.NewRequest(http.MethodPost, "/api/v1/auth/logout", nil)
+	reqLogoutInvalid.AddCookie(&http.Cookie{Name: sessionCookieName, Value: "non-existent-sid"})
+	recLogoutInvalid := httptest.NewRecorder()
