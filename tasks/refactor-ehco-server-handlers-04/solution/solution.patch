+func TestUpdateHandler_Outcomes(t *testing.T) {
+	e := echo.New()
+	h := newUpdateHandler(nil)
+
+	// 1. Version returns VersionInfo with 200
+	reqV := httptest.NewRequest(http.MethodGet, "/api/v1/version", nil)
+	recV := httptest.NewRecorder()
+	cV := e.NewContext(reqV, recV)
+	if err := h.Version(cV); err != nil {
+		t.Fatalf("Version: %v", err)
+	}
+	if recV.Code != http.StatusOK {
+		t.Fatalf("expected 200, got %d", recV.Code)
+	}
+	var vInfo VersionInfo
+	if err := json.Unmarshal(recV.Body.Bytes(), &vInfo); err != nil {
+		t.Fatalf("unmarshal VersionInfo: %v", err)
+	}
+	if vInfo.GoOS != runtime.GOOS || vInfo.GoArch != runtime.GOARCH {
+		t.Fatalf("unexpected OS/Arch in VersionInfo: %+v", vInfo)
+	}
+
+	// 2. UpdateCheck maps upstream error to 502 Bad Gateway
+	// With canceled context, updater.Check fails immediately
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	reqCheck := httptest.NewRequest(http.MethodGet, "/api/v1/update/check", nil).WithContext(ctx)
+	recCheck := httptest.NewRecorder()
+	cCheck := e.NewContext(reqCheck, recCheck)
+	errCheck := h.UpdateCheck(cCheck)
+	if errCheck == nil {
+		t.Fatalf("expected 502 error for canceled context, got nil")
+	}
+	httpErrCheck, ok := errCheck.(*echo.HTTPError)
+	if !ok || httpErrCheck.Code != http.StatusBadGateway {
+		t.Fatalf("expected 502 Bad Gateway, got %v", errCheck)
+	}
+
+	// 3. UpdateApply
+	// 3a. Malformed body returns 400
+	reqBadBody := httptest.NewRequest(http.MethodPost, "/api/v1/update/apply", strings.NewReader("malformed-body"))
+	reqBadBody.Header.Set("Content-Type", "application/json")
+	recBadBody := httptest.NewRecorder()
+	cBadBody := e.NewContext(reqBadBody, recBadBody)
+	errBadBody := h.UpdateApply(cBadBody)
+	if runtime.GOOS == "linux" {
+		if errBadBody == nil {
+			t.Fatal("expected 400 on malformed body, got nil")
+		}
+		if httpErr, ok := errBadBody.(*echo.HTTPError); !ok || httpErr.Code != http.StatusBadRequest {
+			t.Fatalf("expected 400 for malformed body, got %v", errBadBody)
+		}
+	} else {
+		if errBadBody == nil {
+			t.Fatal("expected 400 on non-linux, got nil")
+		}
+		if httpErr, ok := errBadBody.(*echo.HTTPError); !ok || httpErr.Code != http.StatusBadRequest {
+			t.Fatalf("expected 400 on non-linux, got %v", errBadBody)
+		}
+	}
+
+	// 3b. Valid body: on linux returns 202 without waiting; on non-linux returns 400
+	reqValid := httptest.NewRequest(http.MethodPost, "/api/v1/update/apply",
+		strings.NewReader(`{"channel":"stable","force":false,"restart":false}`))
+	reqValid.Header.Set("Content-Type", "application/json")
+	recValid := httptest.NewRecorder()
+	cValid := e.NewContext(reqValid, recValid)
+	errValid := h.UpdateApply(cValid)
+	if runtime.GOOS == "linux" {
+		if errValid != nil {
+			t.Fatalf("expected 202 on linux, got err: %v", errValid)
+		}
+		if recValid.Code != http.StatusAccepted {
+			t.Fatalf("expected 202 Accepted, got %d", recValid.Code)
+		}
+	} else {
+		if errValid == nil {
+			t.Fatal("expected 400 on non-linux, got nil")
+		}
+		if httpErr, ok := errValid.(*echo.HTTPError); !ok || httpErr.Code != http.StatusBadRequest {
+			t.Fatalf("expected 400 on non-linux, got %v", errValid)
+		}
+	}
+}
