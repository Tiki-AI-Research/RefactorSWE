+func TestServerXraySetters_LateBinding(t *testing.T) {
+	// Zero-value server doesn't panic
+	var zeroS Server
+	zeroS.SetXrayStatus(nil)
+	zeroS.SetXrayReloader(nil)
+	zeroS.SetXrayStatus(&fakeXrayStatus{})
+	zeroS.SetXrayReloader(&fakeReloader{})
+
+	unregisterTestMetrics()
+	defer unregisterTestMetrics()
+
+	cfg := &config.Config{
+		WebHost: "127.0.0.1",
+		WebPort: 19004,
+	}
+	relayReloader := &fakeReloader{}
+	s, err := NewServer(cfg, relayReloader, nil, nil)
+	if err != nil {
+		t.Fatalf("NewServer: %v", err)
+	}
+
+	// Passing nil before setter does not panic
+	s.SetXrayStatus(nil)
+	s.SetXrayReloader(nil)
+
+	// First overview request: no xray
+	req := httptest.NewRequest(http.MethodGet, "/api/v1/overview", nil)
+	rec := httptest.NewRecorder()
+	s.e.ServeHTTP(rec, req)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("expected 200, got %d", rec.Code)
+	}
+	if strings.Contains(rec.Body.String(), `"xray"`) {
+		t.Fatalf("expected xray to be omitted, got %s", rec.Body.String())
+	}
+
+	// Reload before xray reloader: returns 200, only relay reloaded
+	reqReload := httptest.NewRequest(http.MethodPost, "/api/v1/config/reload/", nil)
+	recReload := httptest.NewRecorder()
+	s.e.ServeHTTP(recReload, reqReload)
+	if recReload.Code != http.StatusOK {
+		t.Fatalf("expected 200, got %d", recReload.Code)
+	}
+	time.Sleep(20 * time.Millisecond)
+	if !relayReloader.reloaded.Load() {
+		t.Fatalf("expected relay reloader to be called")
+	}
+
+	// Now set xray status and xray reloader
+	status := &fakeXrayStatus{
+		snap: glue.XraySnapshot{Conns: 42, Users: 10},
+	}
+	s.SetXrayStatus(status)
+
+	xrayReloader := &fakeReloader{}
+	s.SetXrayReloader(xrayReloader)
+
+	// Passing nil afterwards does NOT clear either
+	s.SetXrayStatus(nil)
+	s.SetXrayReloader(nil)
+
+	// Second overview request on same server instance: now has xray
+	rec2 := httptest.NewRecorder()
+	s.e.ServeHTTP(rec2, req)
+	if rec2.Code != http.StatusOK {
+		t.Fatalf("expected 200, got %d", rec2.Code)
+	}
+	var resp OverviewResp
+	if err := json.Unmarshal(rec2.Body.Bytes(), &resp); err != nil {
+		t.Fatalf("unmarshal error: %v", err)
+	}
+	if resp.Xray == nil || resp.Xray.Conns != 42 || resp.Xray.Users != 10 {
+		t.Fatalf("expected xray snapshot (conns=42, users=10), got %+v", resp.Xray)
+	}
+	if resp.Rules != len(cfg.RelayConfigs) {
+		t.Errorf("expected rules %d, got %d", len(cfg.RelayConfigs), resp.Rules)
+	}
+	if !resp.LastReloadAt.Equal(cfg.LastLoadTime()) {
+		t.Errorf("expected LastReloadAt %v, got %v", cfg.LastLoadTime(), resp.LastReloadAt)
+	}
+
+	// Second reload request on same server instance: triggers xray reloader as well
+	relayReloader.reloaded.Store(false)
+	recReload2 := httptest.NewRecorder()
+	s.e.ServeHTTP(recReload2, reqReload)
+	if recReload2.Code != http.StatusOK {
+		t.Fatalf("expected 200, got %d", recReload2.Code)
+	}
+	time.Sleep(50 * time.Millisecond)
+	if !relayReloader.reloaded.Load() {
+		t.Fatalf("expected relay reloader to be called")
+	}
+	if !xrayReloader.reloaded.Load() {
+		t.Fatalf("expected xray reloader to be called after late binding")
+	}
+}
