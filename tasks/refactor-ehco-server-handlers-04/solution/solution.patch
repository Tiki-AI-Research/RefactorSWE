+			t.Errorf("expected relay force=true")
+		}
+	case <-time.After(1 * time.Second):
+		t.Fatal("relay Reload was not called")
+	}
+
+	close(relayReloader.blockCh)
+
+	select {
+	case force := <-xrayReloader.called:
+		if !force {
+			t.Errorf("expected xray force=true")
+		}
+	case <-time.After(1 * time.Second):
+		t.Fatal("xray Reload was not called")
+	}
+
+	close(xrayReloader.blockCh)
+}
