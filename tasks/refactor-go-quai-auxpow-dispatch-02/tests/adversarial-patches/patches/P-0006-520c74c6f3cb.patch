+func TestAuxPowJSONValidationPrecedenceAndWorkObjectHeader(t *testing.T) {
+	// JSON missing fields order: powId -> header -> auxpow2 -> signature -> merkleBranch
+	testCases := []struct {
+		data        string
+		expectedErr string
+	}{
+		{
+			data:        `{}`,
+			expectedErr: "missing required fields 'powId' in AuxPow",
+		},
+		{
+			data:        `{"powId": "0x1"}`,
+			expectedErr: "missing required fields 'header' in AuxPow",
+		},
+		{
+			data:        `{"powId": "0x1", "header": "0x1234"}`,
+			expectedErr: "missing required fields 'auxpow2' in AuxPow",
+		},
+		{
+			data:        `{"powId": "0x1", "header": "0x1234", "auxpow2": "0x"}`,
+			expectedErr: "missing required fields 'signature' in AuxPow",
+		},
+		{
+			data:        `{"powId": "0x1", "header": "0x1234", "auxpow2": "0x", "signature": "0x"}`,
+			expectedErr: "missing required fields 'merkleBranch' in AuxPow",
+		},
+	}
+
+	for _, tc := range testCases {
+		var ap AuxPow
+		err := json.Unmarshal([]byte(tc.data), &ap)
+		require.EqualError(t, err, tc.expectedErr)
+	}
+
+	// WorkObjectHeader.ProtoDecode error propagation when AuxPow header is malformed
+	validWO := &WorkObjectHeader{
+		headerHash:          common.Hash{0x01},
+		parentHash:          common.Hash{0x02},
+		number:              big.NewInt(100),
+		difficulty:          big.NewInt(1000),
+		primeTerminusNumber: big.NewInt(2000000), // > KawPowForkBlock
+		txHash:              common.Hash{0x03},
+		primaryCoinbase:     common.BytesToAddress([]byte{0x04}, common.Location{0, 0}),
+		location:            common.Location{0, 0},
+		mixHash:             common.Hash{0x05},
+		time:                1600000000,
+		nonce:               BlockNonce{0x06},
+		data:                []byte{},
+		lock:                0,
+		auxPow:              auxPowTestData(Kawpow),
+		shaDiffAndCount:     &PowShareDiffAndCount{},
+		scryptDiffAndCount:  &PowShareDiffAndCount{},
+		shaShareTarget:      big.NewInt(100),
+		scryptShareTarget:   big.NewInt(200),
+		kawpowDifficulty:    big.NewInt(1000),
+	}
+	woProto, err := validWO.ProtoEncode()
+	require.NoError(t, err)
+
+	chainID := uint32(Kawpow)
+	woProto.AuxPow = &ProtoAuxPow{
+		ChainId:     &chainID,
+		Header:      []byte{0x01, 0x02, 0x03}, // malformed header
+		Transaction: []byte{0xaa, 0xbb},
+	}
+
+	woh := &WorkObjectHeader{}
+	require.NotPanics(t, func() {
+		err := woh.ProtoDecode(woProto, common.Location{0, 0})
+		require.Error(t, err)
+	})
+}
