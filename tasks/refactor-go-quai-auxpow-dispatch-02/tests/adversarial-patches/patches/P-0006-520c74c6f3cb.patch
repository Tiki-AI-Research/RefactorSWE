+func TestAuxPowJSONDecodeInvariants(t *testing.T) {
+	var (
+		version        int32  = 0x20000000
+		prevBlockHash         = [32]byte{0x01, 0x02, 0x03}
+		merkleRootHash        = [32]byte{0x04, 0x05, 0x06}
+		timestamp      uint32 = 1600000000
+		bits           uint32 = 0x1d00ffff
+		nonce          uint32 = 123456
+		height         uint32 = 789101
+		sig                   = []byte{0xde, 0xad, 0xbe, 0xef}
+		auxpow2               = []byte{0x01, 0x02}
+		tx                    = []byte("sample-tx")
+		branch                = [][]byte{{0xaa, 0xbb}}
+	)
+
+	supportedChains := []struct {
+		name        string
+		powID       PowID
+		expectedLen int
+	}{
+		{"Kawpow", Kawpow, 120},
+		{"SHA_BTC", SHA_BTC, 80},
+		{"SHA_BCH", SHA_BCH, 80},
+		{"Scrypt", Scrypt, 80},
+	}
+
+	for _, sc := range supportedChains {
+		t.Run(sc.name, func(t *testing.T) {
+			hdr := NewBlockHeader(sc.powID, version, prevBlockHash, merkleRootHash, timestamp, bits, nonce, height)
+			require.NotNil(t, hdr)
+			require.Equal(t, sc.expectedLen, len(hdr.Bytes()))
+
+			payload := map[string]interface{}{
+				"powId":        hexutil.Uint64(sc.powID),
+				"header":       hexutil.Bytes(hdr.Bytes()),
+				"auxpow2":      hexutil.Bytes(auxpow2),
+				"signature":    hexutil.Bytes(sig),
+				"merkleBranch": []hexutil.Bytes{hexutil.Bytes(branch[0])},
+				"transaction":  hexutil.Bytes(tx),
+			}
+			jsonBytes, err := json.Marshal(payload)
+			require.NoError(t, err)
+
+			var ap AuxPow
+			require.NoError(t, json.Unmarshal(jsonBytes, &ap))
+			require.Equal(t, sc.powID, ap.PowID())
+			require.NotNil(t, ap.Header())
+			require.Equal(t, hdr.Bytes(), ap.Header().Bytes())
+			require.Equal(t, auxpow2, ap.AuxPow2())
+			require.Equal(t, sig, ap.Signature())
+			require.Equal(t, branch, ap.MerkleBranch())
+			require.Equal(t, tx, ap.Transaction())
+
+			if sc.powID == Kawpow {
+				require.Equal(t, height, ap.Header().Height())
+			}
+		})
+	}
+
+	// Unsupported PowID JSON decode: error must be nil, header unset (nil), other fields populated
+	for _, unsuppID := range []PowID{Progpow, PowID(99)} {
+		t.Run(fmt.Sprintf("Unsupported_%d", unsuppID), func(t *testing.T) {
+			dummyHeader := bytes.Repeat([]byte{0x77}, 80)
+			payload := map[string]interface{}{
+				"powId":        hexutil.Uint64(unsuppID),
+				"header":       hexutil.Bytes(dummyHeader),
+				"auxpow2":      hexutil.Bytes(auxpow2),
+				"signature":    hexutil.Bytes(sig),
+				"merkleBranch": []hexutil.Bytes{hexutil.Bytes(branch[0])},
+				"transaction":  hexutil.Bytes(tx),
+			}
+			jsonBytes, err := json.Marshal(payload)
+			require.NoError(t, err)
+
+			var ap AuxPow
+			require.NoError(t, json.Unmarshal(jsonBytes, &ap))
+			require.Equal(t, unsuppID, ap.PowID())
+			require.Nil(t, ap.Header())
+			require.Equal(t, auxpow2, ap.AuxPow2())
+			require.Equal(t, sig, ap.Signature())
+			require.Equal(t, branch, ap.MerkleBranch())
+			require.Equal(t, tx, ap.Transaction())
+		})
+	}
+}
