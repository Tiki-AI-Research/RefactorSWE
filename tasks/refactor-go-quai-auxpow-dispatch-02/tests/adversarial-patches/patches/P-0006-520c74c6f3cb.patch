+func TestAuxPowMalformedHeaderRobustnessAndOrdering(t *testing.T) {
+	malformedHeaderBytes := []byte{0x01, 0x02, 0x03} // truncated, less than 80 or 120 bytes
+	sentinelSig := []byte("sentinel-sig")
+	sentinelAuxpow2 := []byte("sentinel-auxpow2")
+	sentinelBranch := [][]byte{[]byte("sentinel-branch")}
+	sentinelTx := []byte("sentinel-tx")
+
+	chains := []PowID{Kawpow, SHA_BTC, SHA_BCH, Scrypt}
+
+	for _, powID := range chains {
+		t.Run(fmt.Sprintf("ProtoDecode_Malformed_%v", powID), func(t *testing.T) {
+			chainID := uint32(powID)
+			protoData := &ProtoAuxPow{
+				ChainId:      &chainID,
+				Header:       malformedHeaderBytes,
+				Signature:    []byte("new-sig"),
+				Auxpow2:      []byte("new-auxpow2"),
+				MerkleBranch: [][]byte{[]byte("new-branch")},
+				Transaction:  []byte("new-tx"),
+			}
+
+			ap := &AuxPow{}
+			ap.SetSignature(sentinelSig)
+			ap.auxPow2 = sentinelAuxpow2
+			ap.merkleBranch = sentinelBranch
+			ap.transaction = sentinelTx
+
+			require.NotPanics(t, func() {
+				err := ap.ProtoDecode(protoData)
+				require.Error(t, err)
+			})
+
+			// Decode ordering verification (R14): PowID recorded before header decode
+			require.Equal(t, powID, ap.PowID())
+			// On error, remaining payload fields remain untouched
+			require.Equal(t, sentinelSig, ap.Signature())
+			require.Equal(t, sentinelAuxpow2, ap.AuxPow2())
+			require.Equal(t, sentinelBranch, ap.MerkleBranch())
+			require.Equal(t, sentinelTx, ap.Transaction())
+		})
+
+		t.Run(fmt.Sprintf("JSONUnmarshal_Malformed_%v", powID), func(t *testing.T) {
+			payload := map[string]interface{}{
+				"powId":        hexutil.Uint64(powID),
+				"header":       hexutil.Bytes(malformedHeaderBytes),
+				"auxpow2":      hexutil.Bytes([]byte("new-auxpow2")),
+				"signature":    hexutil.Bytes([]byte("new-sig")),
+				"merkleBranch": []hexutil.Bytes{hexutil.Bytes([]byte("new-branch"))},
+				"transaction":  hexutil.Bytes([]byte("new-tx")),
+			}
+			jsonBytes, err := json.Marshal(payload)
+			require.NoError(t, err)
+
+			ap := &AuxPow{}
+			ap.SetSignature(sentinelSig)
+			ap.auxPow2 = sentinelAuxpow2
+			ap.merkleBranch = sentinelBranch
+			ap.transaction = sentinelTx
+
+			require.NotPanics(t, func() {
+				err := json.Unmarshal(jsonBytes, ap)
+				require.Error(t, err)
+			})
+
+			// PowID was recorded, but following fields untouched on error
+			require.Equal(t, powID, ap.PowID())
+			require.Equal(t, sentinelSig, ap.Signature())
+			require.Equal(t, sentinelAuxpow2, ap.AuxPow2())
+			require.Equal(t, sentinelBranch, ap.MerkleBranch())
+			require.Equal(t, sentinelTx, ap.Transaction())
+		})
+	}
+}
