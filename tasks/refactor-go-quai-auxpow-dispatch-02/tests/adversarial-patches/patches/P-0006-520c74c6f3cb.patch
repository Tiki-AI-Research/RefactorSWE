+func TestAuxPowChainDispatchInvariants(t *testing.T) {
+	var (
+		version        int32  = 0x20000000
+		prevBlockHash         = [32]byte{0x01, 0x02, 0x03}
+		merkleRootHash        = [32]byte{0x04, 0x05, 0x06}
+		timestamp      uint32 = 1600000000
+		bits           uint32 = 0x1d00ffff
+		nonce          uint32 = 123456
+		height         uint32 = 789101
+		txPayload             = []byte("test-auxpow-tx-dispatch-invariants")
+	)
+
+	tests := []struct {
+		name           string
+		powID          PowID
+		expectedLen    int
+		directHeader   func() AuxHeaderData
+		expectedTxHash common.Hash
+	}{
+		{
+			name:        "Kawpow",
+			powID:       Kawpow,
+			expectedLen: 120,
+			directHeader: func() AuxHeaderData {
+				return NewRavencoinBlockHeader(version, prevBlockHash, merkleRootHash, timestamp, bits, height)
+			},
+			expectedTxHash: common.Hash(btchash.DoubleHashH(txPayload)),
+		},
+		{
+			name:        "SHA_BTC",
+			powID:       SHA_BTC,
+			expectedLen: 80,
+			directHeader: func() AuxHeaderData {
+				return NewBitcoinBlockHeader(version, prevBlockHash, merkleRootHash, timestamp, bits, nonce)
+			},
+			expectedTxHash: common.Hash(btchash.DoubleHashH(txPayload)),
+		},
+		{
+			name:        "SHA_BCH",
+			powID:       SHA_BCH,
+			expectedLen: 80,
+			directHeader: func() AuxHeaderData {
+				return NewBitcoinCashBlockHeader(version, prevBlockHash, merkleRootHash, timestamp, bits, nonce)
+			},
+			expectedTxHash: common.Hash(bchhash.DoubleHashH(txPayload)),
+		},
+		{
+			name:        "Scrypt",
+			powID:       Scrypt,
+			expectedLen: 80,
+			directHeader: func() AuxHeaderData {
+				return NewLitecoinBlockHeader(version, prevBlockHash, merkleRootHash, timestamp, bits, nonce)
+			},
+			expectedTxHash: common.Hash(ltchash.DoubleHashH(txPayload)),
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			// 1. Header construction & serialization invariance
+			hdr := NewBlockHeader(tc.powID, version, prevBlockHash, merkleRootHash, timestamp, bits, nonce, height)
+			require.NotNil(t, hdr)
+			directHdr := tc.directHeader()
+			var directBuf bytes.Buffer
+			require.NoError(t, directHdr.Serialize(&directBuf))
+			require.Equal(t, tc.expectedLen, len(hdr.Bytes()))
+			require.Equal(t, directBuf.Bytes(), hdr.Bytes())
+
+			// 2. Hash computation invariance
+			require.Equal(t, directHdr.BlockHash(), hdr.BlockHash())
+			require.Equal(t, directHdr.PowHash(), hdr.PowHash())
+			require.Equal(t, directHdr.GetSealHash(), hdr.SealHash())
+
+			// 3. Tx hash invariance
+			require.Equal(t, tc.expectedTxHash, AuxPowTxHash(tc.powID, txPayload))
+
+			// 4. ProtoDecode via dispatch
+			chainID := uint32(tc.powID)
+			protoData := &ProtoAuxPow{
+				ChainId: &chainID,
+				Header:  hdr.Bytes(),
+			}
+			ap := &AuxPow{}
+			require.NoError(t, ap.ProtoDecode(protoData))
+			require.Equal(t, tc.powID, ap.PowID())
+			require.NotNil(t, ap.Header())
+			require.Equal(t, hdr.Bytes(), ap.Header().Bytes())
+		})
+	}
+
+	// 5. Unsupported PowID negative invariance
+	for _, unsupportedID := range []PowID{Progpow, PowID(99)} {
+		require.Nil(t, NewBlockHeader(unsupportedID, version, prevBlockHash, merkleRootHash, timestamp, bits, nonce, height))
+		require.Equal(t, common.Hash{}, AuxPowTxHash(unsupportedID, txPayload))
+
+		chainID := uint32(unsupportedID)
+		ap := &AuxPow{}
+		err := ap.ProtoDecode(&ProtoAuxPow{ChainId: &chainID})
+		require.EqualError(t, err, "unsupported powId for AuxPow header")
+	}
+}
