+func TestAuxPowNilInnerHeaderZeroValues(t *testing.T) {
+	nilInnerHeader := &AuxPowHeader{}
+	require.NotPanics(t, func() {
+		require.Equal(t, common.Hash{}, nilInnerHeader.BlockHash())
+		require.Equal(t, common.Hash{}, nilInnerHeader.PowHash())
+		require.Equal(t, common.Hash{}, nilInnerHeader.SealHash())
+		require.Equal(t, int32(0), nilInnerHeader.Version())
+		require.Equal(t, [32]byte{}, nilInnerHeader.PrevBlock())
+		require.Equal(t, [32]byte{}, nilInnerHeader.MerkleRoot())
+		require.Equal(t, uint32(0), nilInnerHeader.Timestamp())
+		require.Equal(t, uint32(0), nilInnerHeader.Bits())
+		require.Equal(t, uint32(0), nilInnerHeader.Nonce())
+		require.Equal(t, uint32(0), nilInnerHeader.Height())
+		require.Equal(t, uint64(0), nilInnerHeader.Nonce64())
+		require.Equal(t, common.Hash{}, nilInnerHeader.MixHash())
+		require.Empty(t, nilInnerHeader.Bytes())
+	})
+}
