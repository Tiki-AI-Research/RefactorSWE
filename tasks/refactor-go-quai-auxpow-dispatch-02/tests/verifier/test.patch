+const (
+	p2pVersion   int32  = 0x20000000
+	p2pTimestamp uint32 = 0x5f5e1001
+	p2pBits      uint32 = 0x1d00ffff
+	p2pNonce     uint32 = 0xdeadbeef
+	p2pHeight    uint32 = 0x12345
+)
