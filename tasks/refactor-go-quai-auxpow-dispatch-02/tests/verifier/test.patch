+func TestP2PUnmarshalJSONDecodesEachChainLayout(t *testing.T) {
+	cases := []struct {
+		powID   PowID
+		isInner func(AuxHeaderData) bool
+	}{
+		{Kawpow, func(inner AuxHeaderData) bool { _, ok := inner.(*RavencoinBlockHeader); return ok }},
+		{SHA_BTC, func(inner AuxHeaderData) bool { _, ok := inner.(*BitcoinHeaderWrapper); return ok }},
+		{SHA_BCH, func(inner AuxHeaderData) bool { _, ok := inner.(*BitcoinCashHeaderWrapper); return ok }},
+		{Scrypt, func(inner AuxHeaderData) bool { _, ok := inner.(*LitecoinHeaderWrapper); return ok }},
+	}
+	for _, tc := range cases {
+		var h *AuxPowHeader
+		if tc.powID == Kawpow {
+			h = p2pExtendedKawpowHeader(t)
+		} else {
+			h = p2pBuildHeader(t, tc.powID)
+		}
+		headerBytes := h.Bytes()
+		ap := &AuxPow{}
+		payload := p2pAuxPowJSON(tc.powID, headerBytes, []byte{0x0a}, []byte{0x0b}, []byte{0x0c}, [][]byte{{0x0d}, {0x0e}})
+		if err := json.Unmarshal(payload, ap); err != nil {
+			t.Fatalf("UnmarshalJSON(%s): %v", tc.powID, err)
+		}
+		if ap.PowID() != tc.powID {
+			t.Errorf("decoded PowID = %s, want %s", ap.PowID(), tc.powID)
+		}
+		if ap.Header() == nil {
+			t.Fatalf("%s decoded header is nil", tc.powID)
+		}
+		if !tc.isInner(ap.Header().inner) {
+			t.Errorf("%s decoded inner header type = %T", tc.powID, ap.Header().inner)
+		}
+		if got := ap.Header().Bytes(); !bytes.Equal(got, headerBytes) {
+			t.Errorf("%s decoded header bytes = %x, want %x", tc.powID, got, headerBytes)
+		}
+		if got := ap.Header().Version(); got != p2pVersion {
+			t.Errorf("%s decoded Version() = %#x, want %#x", tc.powID, got, p2pVersion)
+		}
+		if got := ap.Header().Timestamp(); got != p2pTimestamp {
+			t.Errorf("%s decoded Timestamp() = %d, want %d", tc.powID, got, p2pTimestamp)
+		}
+		if got := ap.Header().Bits(); got != p2pBits {
+			t.Errorf("%s decoded Bits() = %#x, want %#x", tc.powID, got, p2pBits)
+		}
+		if tc.powID == Kawpow {
+			if got := ap.Header().Height(); got != p2pHeight {
+				t.Errorf("KAWPOW decoded Height() = %d, want %d", got, p2pHeight)
+			}
+			if got := ap.Header().Nonce64(); got != 0x0102030405060708 {
+				t.Errorf("KAWPOW decoded Nonce64() = %#x, want %#x", got, uint64(0x0102030405060708))
+			}
+			if got := ap.Header().MixHash(); got != p2pHashOf(0x77) {
+				t.Errorf("KAWPOW decoded MixHash() = %x, want %x", got, p2pHashOf(0x77))
+			}
+		} else {
+			if got := ap.Header().Nonce(); got != p2pNonce {
+				t.Errorf("%s decoded Nonce() = %#x, want %#x", tc.powID, got, p2pNonce)
+			}
+			if got := ap.Header().Height(); got != 0 {
+				t.Errorf("%s decoded Height() = %d, want 0", tc.powID, got)
+			}
+		}
+		if !bytes.Equal(ap.AuxPow2(), []byte{0x0a}) {
+			t.Errorf("%s decoded auxpow2 = %x, want %x", tc.powID, ap.AuxPow2(), []byte{0x0a})
+		}
+		if !bytes.Equal(ap.Signature(), []byte{0x0b}) {
+			t.Errorf("%s decoded signature = %x, want %x", tc.powID, ap.Signature(), []byte{0x0b})
+		}
+		if !bytes.Equal(ap.Transaction(), []byte{0x0c}) {
+			t.Errorf("%s decoded transaction = %x, want %x", tc.powID, ap.Transaction(), []byte{0x0c})
+		}
+		if len(ap.MerkleBranch()) != 2 || !bytes.Equal(ap.MerkleBranch()[0], []byte{0x0d}) || !bytes.Equal(ap.MerkleBranch()[1], []byte{0x0e}) {
+			t.Errorf("%s decoded merkle branch = %x, want [[0d] [0e]]", tc.powID, ap.MerkleBranch())
+		}
+	}
+}
