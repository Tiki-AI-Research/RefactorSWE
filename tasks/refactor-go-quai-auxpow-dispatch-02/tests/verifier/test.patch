+func TestP2PProtoAuxPowFieldNumbersAndLayout(t *testing.T) {
+	chainID := uint32(1)
+	signatureTime := uint64(2)
+	msg := &ProtoAuxPow{
+		ChainId:       &chainID,
+		Header:        []byte{0xaa},
+		Signature:     []byte{0xbb},
+		MerkleBranch:  [][]byte{{0xcc}},
+		Transaction:   []byte{0xdd},
+		SignatureTime: &signatureTime,
+		Auxpow2:       []byte{0xee},
+	}
+	raw, err := proto.Marshal(msg)
+	if err != nil {
+		t.Fatalf("proto.Marshal: %v", err)
+	}
+	want := map[protowire.Number]bool{1: false, 2: false, 3: false, 4: false, 5: false, 6: false, 7: false}
+	rest := raw
+	for len(rest) > 0 {
+		num, typ, n := protowire.ConsumeTag(rest)
+		if n < 0 {
+			t.Fatalf("invalid protobuf tag: %v", protowire.ParseError(n))
+		}
+		rest = rest[n:]
+		if _, known := want[num]; !known {
+			t.Fatalf("unexpected protobuf field number %d in ProtoAuxPow", num)
+		}
+		if want[num] {
+			t.Fatalf("protobuf field number %d encoded more than once", num)
+		}
+		want[num] = true
+		m := protowire.ConsumeFieldValue(num, typ, rest)
+		if m < 0 {
+			t.Fatalf("invalid protobuf value for field %d: %v", num, protowire.ParseError(m))
+		}
+		rest = rest[m:]
+	}
+	for num, seen := range want {
+		if !seen {
+			t.Errorf("ProtoAuxPow protobuf field number %d missing; the frozen layout must keep fields chain_id=1 header=2 signature=3 merkle_branch=4 transaction=5 signature_time=6 auxpow2=7", num)
+		}
+	}
+	var back ProtoAuxPow
+	if err := proto.Unmarshal(raw, &back); err != nil {
+		t.Fatalf("proto.Unmarshal: %v", err)
+	}
+	if back.GetChainId() != chainID || back.GetSignatureTime() != signatureTime {
+		t.Errorf("round-trip chain_id/signature_time = %d/%d, want %d/%d", back.GetChainId(), back.GetSignatureTime(), chainID, signatureTime)
+	}
+	if !bytes.Equal(back.GetHeader(), msg.Header) || !bytes.Equal(back.GetSignature(), msg.Signature) ||
+		!bytes.Equal(back.GetTransaction(), msg.Transaction) || !bytes.Equal(back.GetAuxpow2(), msg.Auxpow2) {
+		t.Error("ProtoAuxPow byte fields changed across a protobuf round trip")
+	}
+	if len(back.GetMerkleBranch()) != 1 || !bytes.Equal(back.GetMerkleBranch()[0], msg.MerkleBranch[0]) {
+		t.Error("ProtoAuxPow merkle branch changed across a protobuf round trip")
+	}
+}
