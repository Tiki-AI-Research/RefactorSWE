+// Independent 80-byte KAWPOW seal preimage; do not call candidate serialization
+// or candidate hash helpers to compute the expected result.
+func p2pCheckSealVector(t *testing.T) {
+	t.Helper()
+	prev, merkle := [32]byte{}, [32]byte{}
+	for i := range prev {
+		prev[i] = byte(3*i + 1)
+		merkle[i] = byte(0xf0 - 2*i)
+	}
+	const version int32 = 0x12345678
+	const timestamp uint32 = 0x87654321
+	const bits uint32 = 0x1a2b3c4d
+	const height uint32 = 0x10203040
+	h := NewBlockHeader(Kawpow, version, prev, merkle, timestamp, bits, 0, height)
+	if h == nil {
+		t.Fatal("seal vector construction returned nil")
+	}
+	want := func(height uint32) common.Hash {
+		var input [80]byte
+		binary.LittleEndian.PutUint32(input[0:4], uint32(version))
+		copy(input[4:36], prev[:])
+		copy(input[36:68], merkle[:])
+		binary.LittleEndian.PutUint32(input[68:72], timestamp)
+		binary.LittleEndian.PutUint32(input[72:76], bits)
+		binary.LittleEndian.PutUint32(input[76:80], height)
+		first := sha256.Sum256(input[:])
+		second := sha256.Sum256(first[:])
+		return common.Hash(second)
+	}
+	assertSeal := func(label string, height uint32) {
+		if got, expected := h.SealHash(), want(height); got != expected {
+			t.Errorf("KAWPOW seal %s = %x, want natural-order SHA256D %x", label, got, expected)
+		}
+	}
+	assertSeal("initial", height)
+	h.SetNonce64(0x0123456789abcdef)
+	assertSeal("nonce64 excluded", height)
+	h.SetMixHash(p2pHashOf(0x65))
+	assertSeal("mix excluded", height)
+	h.SetHeight(height + 1)
+	assertSeal("height included", height+1)
+}
