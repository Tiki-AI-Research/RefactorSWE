+func p2pHeaderDecodeError(t *testing.T, id PowID, raw []byte) error {
+	t.Helper()
+	var h AuxHeaderData
+	switch id {
+	case Kawpow:
+		h = &RavencoinBlockHeader{}
+	case SHA_BTC:
+		h = &BitcoinHeaderWrapper{}
+	case SHA_BCH:
+		h = &BitcoinCashHeaderWrapper{}
+	case Scrypt:
+		h = &LitecoinHeaderWrapper{}
+	default:
+		t.Fatalf("unsupported oracle id %s", id)
+	}
+	err := h.Deserialize(bytes.NewReader(raw))
+	if err == nil {
+		t.Fatal("malformed-header oracle did not fail")
+	}
+	return err
+}
