+func TestF2PChainsRegisterOwnHeaderOps(t *testing.T) {
+	p := f2pLoadPackage(t)
+	regs := p.registries()
+	for _, kind := range f2pChainKinds {
+		owner := ""
+		if st := p.types[kind.headerType]; st != nil {
+			owner = st.file
+		}
+		if owner == "" {
+			t.Errorf("F2P: chain header type %s is not declared in %s", kind.headerType, p.dir)
+			continue
+		}
+		events := p.chainEvents(kind.constant)
+		if len(events) == 0 {
+			t.Errorf("%s performs no reachable registration keyed by %s into a package-level dispatch registry; a decorative call that never writes the shared registry does not count", owner, kind.constant)
+			continue
+		}
+		wired := false
+		for _, ev := range events {
+			if regs[ev.registry] == nil && !strings.HasPrefix(ev.registry, "switch:") {
+				continue
+			}
+			ids := p.valueIdents(ev.value)
+			if ids[kind.headerType] || ids[kind.constructor] {
+				wired = true
+				break
+			}
+		}
+		if !wired {
+			t.Errorf("%s registers %s without wiring its own header type %s and constructor %s into the dispatch value; construction and byte-level layout must be owned by the chain file", owner, kind.constant, kind.headerType, kind.constructor)
+		}
+	}
+}
