+func checkAuditUnknownAndPrecedence(t *testing.T) {
+	var rows []interface{}
+	for _, id := range []PowID{0, 5, 99, 0xffffffff} {
+		if NewBlockHeader(id, 0, [32]byte{}, [32]byte{}, 0, 0, 0, 0) != nil || AuxPowTxHash(id, []byte{1}) != (common.Hash{}) {
+			t.Fatal("unknown fallback changed")
+		}
+		for _, reused := range []bool{false, true} {
+			ap := new(AuxPow)
+			if reused {
+				ap = NewAuxPow(SHA_BTC, auditHeader(SHA_BTC), []byte{31}, []byte{32}, [][]byte{{33}}, []byte{34})
+			}
+			old := ap.Header()
+			b, _ := json.Marshal(map[string]interface{}{"powId": hexutil.Uint64(id), "header": hexutil.Bytes{9}, "auxpow2": hexutil.Bytes{1}, "signature": hexutil.Bytes{2}, "merkleBranch": []hexutil.Bytes{{3}}, "transaction": hexutil.Bytes{4}})
+			if e := ap.UnmarshalJSON(b); e != nil || ap.Header() != old || !bytes.Equal(ap.Transaction(), []byte{4}) {
+				t.Fatalf("unknown JSON: %v", e)
+			}
+			e := ap.ProtoDecode(&ProtoAuxPow{ChainId: proto.Uint32(uint32(id)), Signature: []byte{44}})
+			if e == nil || e.Error() != "unsupported powId for AuxPow header" || ap.Header() != old || !bytes.Equal(ap.Signature(), []byte{2}) {
+				t.Fatal("unknown protobuf changed")
+			}
+			if e := ap.ProtoDecode(nil); e != nil || ap.Header() != old || ap.PowID() != id {
+				t.Fatal("nil input mutated receiver")
+			}
+			rows = append(rows, map[string]interface{}{"id": id, "reused": reused, "error": e.Error(), "headerNil": ap.Header() == nil, "sig": ap.Signature()})
+		}
+	}
+	for _, input := range []string{`{}`, `{"powId":"0x2"}`, `{"powId":"0x2","header":"0x00"}`, `{"powId":"0x2","header":"0x00","auxpow2":"0x01"}`, `{"powId":"0x2","header":"0x00","auxpow2":"0x01","signature":"0x02"}`} {
+		ap := NewAuxPow(Kawpow, auditHeader(Kawpow), []byte{31}, []byte{32}, [][]byte{{33}}, []byte{34})
+		before, _ := json.Marshal(auditState(ap))
+		e := ap.UnmarshalJSON([]byte(input))
+		after, _ := json.Marshal(auditState(ap))
+		if e == nil || !bytes.Equal(before, after) {
+			t.Fatal("validation precedence or mutation changed")
+		}
+		rows = append(rows, map[string]interface{}{"input": input, "error": e.Error()})
+	}
+	auditSnapshot(t, "unknown-and-precedence", rows)
+}
