+func p2pAssertOldHeader(t *testing.T, ap *AuxPow, old *AuxPowHeader, before []byte) {
+	t.Helper()
+	if ap.Header() != old {
+		t.Error("decode replaced or cleared the previous header")
+	}
+	if old != nil && !bytes.Equal(old.Bytes(), before) {
+		t.Error("decode mutated previous header bytes")
+	}
+}
