+func TestF2PChainRegistrationFeedsSharedDispatch(t *testing.T) {
+	p := f2pLoadPackage(t)
+	consumerReads := map[string]map[string]bool{}
+	for _, consumer := range f2pConsumers {
+		fn := p.symbol(consumer.sym)
+		if fn == nil {
+			t.Fatalf("F2P: consumer %s is not declared in %s", consumer.label, p.dir)
+		}
+		consumerReads[consumer.label] = p.registryReads(consumer.sym)
+	}
+	writtenByChain := map[string]map[string]bool{}
+	for _, kind := range f2pChainKinds {
+		owner := ""
+		if st := p.types[kind.headerType]; st != nil {
+			owner = st.file
+		}
+		if owner == "" {
+			t.Errorf("F2P: chain header type %s is not declared in %s", kind.headerType, p.dir)
+			continue
+		}
+		written := map[string]bool{}
+		for _, ev := range p.chainEvents(kind.constant) {
+			written[ev.registry] = true
+		}
+		if len(written) == 0 {
+			t.Errorf("%s registers %s into no package-level dispatch registry reachable from initialization or a consumer", owner, kind.constant)
+			continue
+		}
+		writtenByChain[kind.constant] = written
+	}
+	for _, consumer := range f2pConsumers {
+		feeds := false
+		for registry := range consumerReads[consumer.label] {
+			all := true
+			for _, kind := range f2pChainKinds {
+				if !writtenByChain[kind.constant][registry] {
+					all = false
+					break
+				}
+			}
+			if all {
+				feeds = true
+			}
+		}
+		if !feeds {
+			t.Errorf("%s reads registry %v, none of which is written by every chain's reachable registration (%s); each chain's registration must feed the dispatch state its consumer reads", consumer.label, f2pKeys(consumerReads[consumer.label]), f2pChainWriteSummary(writtenByChain))
+		}
+	}
+}
