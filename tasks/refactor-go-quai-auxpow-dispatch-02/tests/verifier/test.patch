+func checkAuditDecodeBoundaries(t *testing.T) {
+	for _, id := range []PowID{Kawpow, SHA_BTC, SHA_BCH, Scrypt} {
+		t.Run(fmt.Sprint(uint32(id)), func(t *testing.T) {
+			header := auditHeader(id)
+			header.SetNonce64(0xfedcba9876543210)
+			header.SetMixHash(common.Hash{21, 22, 23})
+			raw := header.Bytes()
+			var observations []interface{}
+			for n := 0; n <= len(raw)+2; n++ {
+				for _, mode := range []string{"json", "proto"} {
+					payload := append(append([]byte(nil), raw...), 99, 100)[:n]
+					old := auditHeader(Kawpow)
+					ap := NewAuxPow(Kawpow, old, []byte{31}, []byte{32}, [][]byte{{33}}, []byte{34})
+					before, _ := json.Marshal(auditState(ap))
+					var err error
+					if mode == "json" {
+						b, _ := json.Marshal(map[string]interface{}{"powId": hexutil.Uint64(id), "header": hexutil.Bytes(payload), "auxpow2": hexutil.Bytes{1}, "signature": hexutil.Bytes{2}, "merkleBranch": []hexutil.Bytes{{3}}, "transaction": hexutil.Bytes{4}})
+						err = ap.UnmarshalJSON(b)
+					} else {
+						err = ap.ProtoDecode(&ProtoAuxPow{ChainId: proto.Uint32(uint32(id)), Header: payload, Auxpow2: []byte{1}, Signature: []byte{2}, MerkleBranch: [][]byte{{3}}, Transaction: []byte{4}})
+					}
+					if ap.PowID() != id {
+						t.Fatal("identifier was not recorded")
+					}
+					if n < len(raw) {
+						if err == nil || ap.Header() != old || !bytes.Equal(ap.Transaction(), []byte{34}) || !bytes.Equal(ap.Signature(), []byte{32}) || !bytes.Equal(ap.AuxPow2(), []byte{31}) || !bytes.Equal(ap.MerkleBranch()[0], []byte{33}) {
+							t.Fatalf("partial update on %s length %d: %v", mode, n, err)
+						}
+					} else if err != nil || !bytes.Equal(ap.Header().Bytes(), raw) || !bytes.Equal(ap.Transaction(), []byte{4}) {
+						t.Fatalf("valid header decode failed %s %d: %v", mode, n, err)
+					}
+					observations = append(observations, map[string]interface{}{"mode": mode, "n": n, "error": fmt.Sprint(err), "errorType": fmt.Sprintf("%T", err), "state": auditState(ap), "before": string(before)})
+				}
+			}
+			auditSnapshot(t, fmt.Sprintf("decode-%d", id), observations)
+			ap := NewAuxPow(id, header, []byte{1}, []byte{2}, [][]byte{{3}}, []byte{4})
+			encoded := ap.ProtoEncode()
+			round := new(AuxPow)
+			if err := round.ProtoDecode(encoded); err != nil {
+				t.Fatal(err)
+			}
+			if !proto.Equal(round.ProtoEncode(), encoded) {
+				t.Fatal("protobuf round trip changed")
+			}
+			b, _ := json.Marshal(ap.RPCMarshal())
+			round = new(AuxPow)
+			if e := round.UnmarshalJSON(b); e != nil {
+				t.Fatal(e)
+			}
+			out, _ := json.Marshal(round.RPCMarshal())
+			if !bytes.Equal(b, out) {
+				t.Fatal("JSON round trip changed")
+			}
+		})
+	}
+}
