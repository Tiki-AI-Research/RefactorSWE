+func p2pAssertDecodeError(t *testing.T, got, want error) {
+	t.Helper()
+	if got == nil {
+		t.Fatal("header error was suppressed")
+	}
+	if reflect.TypeOf(got) != reflect.TypeOf(want) || got.Error() != want.Error() {
+		t.Errorf("header error = %T(%v), want original %T(%v)", got, got, want, want)
+	}
+	for _, sentinel := range []error{io.EOF, io.ErrUnexpectedEOF} {
+		if errors.Is(want, sentinel) && !errors.Is(got, sentinel) {
+			t.Errorf("original header error identity %v was lost", sentinel)
+		}
+	}
+}
