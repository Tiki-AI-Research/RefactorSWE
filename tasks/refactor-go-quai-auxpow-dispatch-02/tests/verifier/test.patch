+func TestP2PPerChainHashSemantics(t *testing.T) {
+	t.Run("full_boundary_contract", checkAuditAdjacentDispatch)
+	p2pCheckSealVector(t)
+	p2pCheckCopyIsolation(t)
+	prev, merkle := p2pPrevBlock(), p2pMerkleRoot()
+
+	kawpow := p2pBuildHeader(t, Kawpow)
+	if got := kawpow.PowHash(); got != (common.Hash{}) {
+		t.Errorf("KAWPOW PowHash = %x, want zero (it cannot be derived from the header alone)", got)
+	}
+	if kawpow.BlockHash() == (common.Hash{}) {
+		t.Error("KAWPOW BlockHash must be non-zero")
+	}
+	sealBefore := kawpow.SealHash()
+	if sealBefore == (common.Hash{}) {
+		t.Error("KAWPOW SealHash must be non-zero")
+	}
+	blockBefore := kawpow.BlockHash()
+	inner, ok := kawpow.inner.(*RavencoinBlockHeader)
+	if !ok {
+		t.Fatalf("KAWPOW inner header type = %T, want *RavencoinBlockHeader", kawpow.inner)
+	}
+	inner.Nonce64 = 0x0102030405060708
+	inner.MixHash = p2pHashOf(0x5a)
+	if got := kawpow.SealHash(); got != sealBefore {
+		t.Errorf("KAWPOW SealHash changed after nonce64/mixHash changed (%x -> %x); the PoW input must exclude nonce64 and mixHash", sealBefore, got)
+	}
+	if got := kawpow.BlockHash(); got == blockBefore {
+		t.Error("KAWPOW BlockHash must cover the full serialized header, including nonce64 and mixHash")
+	}
+
+	cases := []struct {
+		powID       PowID
+		powIsBlock  bool
+		emptyHeader func() AuxHeaderData
+	}{
+		{SHA_BTC, true, func() AuxHeaderData { return &BitcoinHeaderWrapper{} }},
+		{SHA_BCH, true, func() AuxHeaderData { return &BitcoinCashHeaderWrapper{} }},
+		{Scrypt, false, func() AuxHeaderData { return &LitecoinHeaderWrapper{} }},
+	}
+	for _, tc := range cases {
+		h := p2pBuildHeader(t, tc.powID)
+		if h.BlockHash() == (common.Hash{}) {
+			t.Errorf("%s BlockHash must be non-zero", tc.powID)
+		}
+		if h.PowHash() == (common.Hash{}) {
+			t.Errorf("%s PowHash must be non-zero", tc.powID)
+		}
+		if tc.powIsBlock && h.PowHash() != h.BlockHash() {
+			t.Errorf("%s PowHash (%x) must equal BlockHash (%x)", tc.powID, h.PowHash(), h.BlockHash())
+		}
+		if !tc.powIsBlock && h.PowHash() == h.BlockHash() {
+			t.Errorf("%s PowHash must be the scrypt hash, distinct from the double-SHA256 BlockHash", tc.powID)
+		}
+		if h.SealHash() != (common.Hash{}) {
+			t.Errorf("%s SealHash = %x, want zero", tc.powID, h.SealHash())
+		}
+		if len(h.Bytes()) != 80 {
+			t.Errorf("%s header length = %d, want 80", tc.powID, len(h.Bytes()))
+		}
+		empty := tc.emptyHeader()
+		if err := empty.Deserialize(bytes.NewReader(h.Bytes())); err != nil {
+			t.Fatalf("%s Deserialize(serialized header): %v", tc.powID, err)
+		}
+		rt := NewAuxPowHeader(empty)
+		if rt.BlockHash() != h.BlockHash() {
+			t.Errorf("%s BlockHash changed across serialize/deserialize: %x -> %x", tc.powID, h.BlockHash(), rt.BlockHash())
+		}
+		if rt.PowHash() != h.PowHash() {
+			t.Errorf("%s PowHash changed across serialize/deserialize: %x -> %x", tc.powID, h.PowHash(), rt.PowHash())
+		}
+		other := NewBlockHeader(tc.powID, p2pVersion, prev, merkle, p2pTimestamp, p2pBits, p2pNonce+1, p2pHeight)
+		if other.BlockHash() == h.BlockHash() {
+			t.Errorf("%s BlockHash must change when the nonce changes", tc.powID)
+		}
+	}
+}
