+func auditDouble(b []byte) common.Hash {
+	first := sha256.Sum256(b)
+	return common.Hash(sha256.Sum256(first[:]))
+}
+func auditSnapshot(t *testing.T, key string, v interface{}) {
+	t.Helper()
+	b, e := json.Marshal(v)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var expected map[string]json.RawMessage
+	if e := json.Unmarshal([]byte(frozenAuxPowSnapshots), &expected); e != nil {
+		t.Fatal(e)
+	}
+	var want, got interface{}
+	if e := json.Unmarshal(expected[key], &want); e != nil {
+		t.Fatal(e)
+	}
+	if e := json.Unmarshal(b, &got); e != nil {
+		t.Fatal(e)
+	}
+	wb, _ := json.Marshal(want)
+	gb, _ := json.Marshal(got)
+	if !bytes.Equal(wb, gb) {
+		t.Fatalf("baseline observation changed: %s", key)
+	}
+}
+func auditHeader(id PowID) *AuxPowHeader {
+	return NewBlockHeader(id, -7, [32]byte{1, 2, 3}, [32]byte{4, 5, 6}, 0xfedcba98, 0x1d00ffff, 0x12345678, 0x87654321)
+}
+func auditState(ap *AuxPow) interface{} { return ap.RPCMarshal() }
+
+func checkAuditConstructionAndHashes(t *testing.T) {
+	for _, id := range []PowID{Kawpow, SHA_BTC, SHA_BCH, Scrypt} {
+		t.Run(fmt.Sprint(uint32(id)), func(t *testing.T) {
+			var rows []interface{}
+			for _, v := range []uint32{0, 1, 0x80000000, 0xffffffff} {
+				prev, root := [32]byte{1, 9, 17}, [32]byte{7, 8, 255}
+				h := NewBlockHeader(id, int32(v), prev, root, v, v^0x12345678, v^0x87654321, v^0xabcdef01)
+				var b bytes.Buffer
+				binary.Write(&b, binary.LittleEndian, v)
+				b.Write(prev[:])
+				b.Write(root[:])
+				binary.Write(&b, binary.LittleEndian, v)
+				binary.Write(&b, binary.LittleEndian, v^0x12345678)
+				if id == Kawpow {
+					binary.Write(&b, binary.LittleEndian, v^0xabcdef01)
+					b.Write(make([]byte, 40))
+				} else {
+					binary.Write(&b, binary.LittleEndian, v^0x87654321)
+				}
+				if !bytes.Equal(h.Bytes(), b.Bytes()) {
+					t.Fatalf("layout mismatch id=%v v=%x", id, v)
+				}
+				original := append([]byte(nil), h.Bytes()...)
+				clone := h.Copy()
+				clone.SetNonce(9)
+				clone.SetNonce64(0xffffffffffffffff)
+				clone.SetMixHash(common.Hash{11, 22, 33})
+				clone.SetHeight(42)
+				if !bytes.Equal(h.Bytes(), original) {
+					t.Fatal("copy aliases header")
+				}
+				if id == Kawpow && (h.SealHash() != auditDouble(original[:80]) || clone.SealHash() != auditDouble(clone.Bytes()[:80])) {
+					t.Fatal("KAWPOW seal input changed")
+				}
+				rows = append(rows, map[string]interface{}{"bytes": hex.EncodeToString(h.Bytes()), "block": h.BlockHash(), "pow": h.PowHash(), "seal": h.SealHash(), "clone": hex.EncodeToString(clone.Bytes()), "cloneBlock": clone.BlockHash()})
+			}
+			for _, payload := range [][]byte{nil, {}, {0}, {0, 1, 127, 128, 255}, bytes.Repeat([]byte{0xa5}, 4097)} {
+				if AuxPowTxHash(id, payload) != auditDouble(payload) {
+					t.Fatal("transaction hash changed")
+				}
+			}
+			auditSnapshot(t, fmt.Sprintf("headers-%d", id), rows)
+		})
+	}
+	var zero AuxPowHeader
+	if zero.BlockHash() != (common.Hash{}) || zero.PowHash() != (common.Hash{}) || zero.SealHash() != (common.Hash{}) || zero.Bytes() != nil {
+		t.Fatal("absent inner changed")
+	}
+}
