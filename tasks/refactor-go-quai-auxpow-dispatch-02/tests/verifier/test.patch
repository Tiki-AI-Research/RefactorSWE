+func TestP2PProtoRoundTripKawpowExtendedHeader(t *testing.T) {
+	h := p2pExtendedKawpowHeader(t)
+	ap := p2pNewAuxPow(Kawpow, h)
+
+	raw, err := proto.Marshal(ap.ProtoEncode())
+	if err != nil {
+		t.Fatalf("proto.Marshal: %v", err)
+	}
+	var decodedProto ProtoAuxPow
+	if err := proto.Unmarshal(raw, &decodedProto); err != nil {
+		t.Fatalf("proto.Unmarshal: %v", err)
+	}
+	decoded := &AuxPow{}
+	if err := decoded.ProtoDecode(&decodedProto); err != nil {
+		t.Fatalf("ProtoDecode: %v", err)
+	}
+	if decoded.PowID() != Kawpow {
+		t.Errorf("decoded PowID = %s, want Kawpow", decoded.PowID())
+	}
+	if decoded.Header() == nil {
+		t.Fatal("decoded header is nil")
+	}
+	if _, ok := decoded.Header().inner.(*RavencoinBlockHeader); !ok {
+		t.Fatalf("decoded inner header type = %T, want *RavencoinBlockHeader", decoded.Header().inner)
+	}
+	if got := decoded.Header().Bytes(); !bytes.Equal(got, h.Bytes()) {
+		t.Errorf("decoded header bytes = %x, want %x", got, h.Bytes())
+	}
+	if len(decoded.Header().Bytes()) != 120 {
+		t.Errorf("decoded KAWPOW header length = %d, want 120", len(decoded.Header().Bytes()))
+	}
+	if got := decoded.Header().Height(); got != p2pHeight {
+		t.Errorf("decoded Height() = %d, want %d", got, p2pHeight)
+	}
+	if got := decoded.Header().Nonce64(); got != 0x0102030405060708 {
+		t.Errorf("decoded Nonce64() = %#x, want %#x", got, uint64(0x0102030405060708))
+	}
+	if got := decoded.Header().MixHash(); got != p2pHashOf(0x77) {
+		t.Errorf("decoded MixHash() = %x, want %x", got, p2pHashOf(0x77))
+	}
+	if got := decoded.Header().Version(); got != p2pVersion {
+		t.Errorf("decoded Version() = %#x, want %#x", got, p2pVersion)
+	}
+	if got := decoded.Header().Timestamp(); got != p2pTimestamp {
+		t.Errorf("decoded Timestamp() = %d, want %d", got, p2pTimestamp)
+	}
+	if got := decoded.Header().Bits(); got != p2pBits {
+		t.Errorf("decoded Bits() = %#x, want %#x", got, p2pBits)
+	}
+	if !bytes.Equal(decoded.Signature(), ap.Signature()) {
+		t.Errorf("decoded signature = %x, want %x", decoded.Signature(), ap.Signature())
+	}
+	if !bytes.Equal(decoded.AuxPow2(), ap.AuxPow2()) {
+		t.Errorf("decoded auxpow2 = %x, want %x", decoded.AuxPow2(), ap.AuxPow2())
+	}
+	if !bytes.Equal(decoded.Transaction(), ap.Transaction()) {
+		t.Errorf("decoded transaction = %x, want %x", decoded.Transaction(), ap.Transaction())
+	}
+	if len(decoded.MerkleBranch()) != len(ap.MerkleBranch()) {
+		t.Fatalf("decoded merkle branch length = %d, want %d", len(decoded.MerkleBranch()), len(ap.MerkleBranch()))
+	}
+	for i := range ap.MerkleBranch() {
+		if !bytes.Equal(decoded.MerkleBranch()[i], ap.MerkleBranch()[i]) {
+			t.Errorf("decoded merkle branch[%d] = %x, want %x", i, decoded.MerkleBranch()[i], ap.MerkleBranch()[i])
+		}
+	}
+}
