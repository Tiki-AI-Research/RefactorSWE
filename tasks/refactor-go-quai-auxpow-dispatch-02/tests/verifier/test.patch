+func TestF2PConstructionConsumerDoesNotBranchOnPowID(t *testing.T) {
+	p := f2pLoadPackage(t)
+	fn := p.funcs["NewBlockHeader"]
+	if fn == nil || fn.body == nil {
+		t.Fatalf("F2P: NewBlockHeader is not declared as a package-level function in %s", p.dir)
+	}
+	ids := f2pIdents(fn.body)
+	if hits := f2pIntersect(ids, f2pChainConstants); len(hits) > 0 {
+		t.Errorf("NewBlockHeader still branches on the proof-of-work identifier %v; header construction must consult the consolidated decision", hits)
+	}
+	for _, kind := range f2pChainKinds {
+		if ids[kind.constructor] {
+			t.Errorf("NewBlockHeader still calls the chain-specific constructor %s; construction defaults must be owned by the chain's header file", kind.constructor)
+		}
+	}
+}
