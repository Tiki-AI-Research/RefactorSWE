+// doubleHashLibsIn reports which configured chainhash libraries the given
+// body (or a package-level helper in the same file it calls) double-hashes
+// with.
+func (p *f2pPkg) doubleHashLibsIn(owner string, body *ast.BlockStmt) []string {
+	found := map[string]bool{}
+	seen := map[ast.Node]bool{}
+	var visit func(string, ast.Node)
+	visit = func(file string, node ast.Node) {
+		if node == nil || seen[node] {
+			return
+		}
+		seen[node] = true
+		f := p.files[file]
+		if f == nil {
+			return
+		}
+		ast.Inspect(node, func(n ast.Node) bool {
+			if sel, ok := n.(*ast.SelectorExpr); ok && (sel.Sel.Name == "DoubleHashH" || sel.Sel.Name == "Sum256") {
+				if id, ok := sel.X.(*ast.Ident); ok {
+					for _, lib := range f2pChainHashLibs {
+						if f.imports[id.Name] == lib {
+							found[lib] = true
+						}
+					}
+					if f.imports[id.Name] == "crypto/sha256" && sel.Sel.Name == "Sum256" {
+						found["crypto/sha256"] = true
+					}
+				}
+			}
+			if id, ok := n.(*ast.Ident); ok {
+				if fn := p.funcs[id.Name]; fn != nil && fn.body != nil {
+					visit(fn.file, fn.body)
+				}
+				if v := p.vars[id.Name]; v != nil && v.expr != nil {
+					visit(v.file, v.expr)
+				}
+			}
+			return true
+		})
+	}
+	visit(owner, body)
+	return f2pKeys(found)
+}
+
+func (p *f2pPkg) chainTxHashOwnership(kind f2pChainKind) (bool, string) {
+	if p.types[kind.headerType] == nil {
+		return false, "missing chain header"
+	}
+	for _, ev := range p.chainEvents(kind.constant) {
+		ids := p.valueIdents(ev.value)
+		for name := range ids {
+			if fn := p.funcs[name]; fn != nil {
+				for _, lib := range p.doubleHashLibsIn(fn.file, fn.body) {
+					if lib != "" {
+						return true, ""
+					}
+				}
+			}
+			if v := p.vars[name]; v != nil && v.expr != nil {
+				found := false
+				ast.Inspect(v.expr, func(n ast.Node) bool {
+					if fn, ok := n.(*ast.FuncLit); ok {
+						for _, lib := range p.doubleHashLibsIn(v.file, fn.Body) {
+							if lib != "" {
+								found = true
+							}
+						}
+					}
+					return true
+				})
+				if found {
+					return true, ""
+				}
+			}
+			for key, fn := range p.methods {
+				if strings.HasPrefix(key, name+".") {
+					for _, lib := range p.doubleHashLibsIn(fn.file, fn.body) {
+						if lib != "" {
+							return true, ""
+						}
+					}
+				}
+			}
+		}
+		found := false
+		ast.Inspect(ev.value, func(n ast.Node) bool {
+			if fn, ok := n.(*ast.FuncLit); ok {
+				for _, lib := range p.doubleHashLibsIn(ev.file, fn.Body) {
+					if lib != "" {
+						found = true
+					}
+				}
+			}
+			return true
+		})
+		if found {
+			return true, ""
+		}
+	}
+	return false, "no transaction hashing reaches the chain's registered operations"
+}
+
+func (p *f2pPkg) fileImportsChainHashLib(fileName string) bool {
+	f := p.files[fileName]
+	if f == nil {
+		return false
+	}
+	for _, path := range f.imports {
+		for _, lib := range f2pChainHashLibs {
+			if path == lib {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (p *f2pPkg) fileUsesChainHashLib(fileName string, node ast.Node) bool {
+	f := p.files[fileName]
+	if f == nil || node == nil {
+		return false
+	}
+	aliases := map[string]bool{}
+	for local, path := range f.imports {
+		if path == "crypto/sha256" {
+			aliases[local] = true
+		}
+		for _, lib := range f2pChainHashLibs {
+			if path == lib {
+				aliases[local] = true
+			}
+		}
+	}
+	if len(aliases) == 0 {
+		return false
+	}
+	used := false
+	ast.Inspect(node, func(n ast.Node) bool {
+		sel, ok := n.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		if id, ok := sel.X.(*ast.Ident); ok && aliases[id.Name] {
+			used = true
+		}
+		return true
+	})
+	return used
+}
+
+func f2pConsumerReadSummary(reads map[string]map[string]bool) string {
+	var parts []string
+	for _, consumer := range f2pConsumers {
+		names := f2pKeys(reads[consumer.label])
+		if len(names) == 0 {
+			parts = append(parts, consumer.label+" reads no registry")
+			continue
+		}
+		parts = append(parts, consumer.label+" reads "+strings.Join(names, ","))
+	}
+	return strings.Join(parts, "; ")
+}
