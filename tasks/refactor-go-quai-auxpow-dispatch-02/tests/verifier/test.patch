+func f2pCheckPublicAPI(t *testing.T, p *f2pPkg) {
+	f2pCheckHeaderInterface(t)
+	t.Helper()
+	allowed := map[string]bool{}
+	for _, key := range strings.Fields(f2pBaselinePublicAPI) {
+		allowed[key] = true
+	}
+	check := func(kind, name string) {
+		if ast.IsExported(name) && !allowed[kind+":"+name] {
+			t.Errorf("new public API declaration: %s:%s", kind, name)
+		}
+	}
+	present := map[string]bool{}
+	for name := range p.types {
+		present["type:"+name] = true
+	}
+	for name := range p.funcs {
+		present["func:"+name] = true
+	}
+	for name := range p.vars {
+		present["var:"+name] = true
+	}
+	for name := range p.consts {
+		present["const:"+name] = true
+	}
+	for name := range p.methods {
+		present["method:"+name] = true
+	}
+	for name := range allowed {
+		if !present[name] {
+			t.Errorf("removed public API declaration: %s", name)
+		}
+	}
+	for name := range p.types {
+		check("type", name)
+	}
+	for name := range p.funcs {
+		check("func", name)
+	}
+	for name := range p.vars {
+		check("var", name)
+	}
+	for name := range p.consts {
+		check("const", name)
+	}
+	for key := range p.methods {
+		parts := strings.SplitN(key, ".", 2)
+		if len(parts) == 2 && ast.IsExported(parts[0]) && ast.IsExported(parts[1]) {
+			check("method", key)
+		}
+	}
+}
+
+// Frozen external implementability contract: no private or extra methods may
+// be added to the public interface. Reflection reports a candidate FAIL inside
+// a normal test instead of misclassifying an external compile error as infra.
+type f2pOriginalHeader interface {
+	Serialize(io.Writer) error
+	Deserialize(io.Reader) error
+	BlockHash() common.Hash
+	PowHash() common.Hash
+	Copy() AuxHeaderData
+	GetVersion() int32
+	GetPrevBlock() [32]byte
+	GetMerkleRoot() [32]byte
+	GetTimestamp() uint32
+	GetBits() uint32
+	GetNonce() uint32
+	GetHeight() uint32
+	GetNonce64() uint64
+	GetMixHash() common.Hash
+	GetSealHash() common.Hash
+	SetNonce(uint32)
+	SetNonce64(uint64)
+	SetMixHash(common.Hash)
+	SetHeight(uint32)
+}
+
+func f2pCheckHeaderInterface(t *testing.T) {
+	t.Helper()
+	if reflect.TypeOf(NewBlockHeader) != reflect.TypeOf((func(PowID, int32, [32]byte, [32]byte, uint32, uint32, uint32, uint32) *AuxPowHeader)(nil)) {
+		t.Error("NewBlockHeader signature changed")
+	}
+	if reflect.TypeOf(AuxPowTxHash) != reflect.TypeOf((func(PowID, []byte) common.Hash)(nil)) {
+		t.Error("AuxPowTxHash signature changed")
+	}
+	got := reflect.TypeOf((*AuxHeaderData)(nil)).Elem()
+	want := reflect.TypeOf((*f2pOriginalHeader)(nil)).Elem()
+	if got.NumMethod() != want.NumMethod() {
+		t.Errorf("public AuxHeaderData method set changed: got %d want %d; external implementations must remain valid", got.NumMethod(), want.NumMethod())
+	}
+	for i := 0; i < want.NumMethod(); i++ {
+		method := want.Method(i)
+		actual, ok := got.MethodByName(method.Name)
+		if !ok || actual.Type != method.Type || actual.PkgPath != method.PkgPath {
+			t.Errorf("public AuxHeaderData method signature changed: %s", method.Name)
+		}
+	}
+}
+
+func (p *f2pPkg) sharedFactories() map[string]*f2pFunc {
+	out := map[string]*f2pFunc{}
+	// Intersect the four already-resolved call closures once. This is the same
+	// predicate as checking each function against four freshly built closures.
+	common := p.callClosure(f2pConsumers[0].sym)
+	for _, c := range f2pConsumers[1:] {
+		reachable := p.callClosure(c.sym)
+		for name := range common {
+			if !reachable[name] {
+				delete(common, name)
+			}
+		}
+	}
+	for name := range common {
+		fn := p.funcs[name]
+		if fn == nil {
+			continue
+		}
+		if ast.IsExported(name) || fn.body == nil {
+			continue
+		}
+
+		cases := map[string]bool{}
+		ast.Inspect(fn.body, func(n ast.Node) bool {
+			if clause, ok := n.(*ast.CaseClause); ok {
+				for _, e := range clause.List {
+					if id, ok := e.(*ast.Ident); ok {
+						cases[id.Name] = true
+					}
+				}
+			}
+			return true
+		})
+		all := true
+		for _, kind := range f2pChainKinds {
+			if !cases[kind.constant] {
+				all = false
+			}
+		}
+		if all {
+			out[name] = fn
+		}
+	}
+	return out
+}
+
+func f2pCheckNoParallelHierarchy(t *testing.T, p *f2pPkg) {
+	t.Helper()
+	for _, kind := range f2pChainKinds {
+		for _, ev := range p.chainEvents(kind.constant) {
+			// Only the actual contributed concrete object, not incidental helper types.
+			comp, ok := ev.value.(*ast.CompositeLit)
+			if !ok {
+				continue
+			}
+			name := f2pExprTypeName(comp.Type)
+			if name == kind.headerType {
+				continue
+			}
+			for key, method := range p.methods {
+				if strings.HasPrefix(key, name+".") {
+					ids := p.valueIdents(&ast.FuncLit{Type: method.decl.Type, Body: method.body})
+					if ids[kind.headerType] || ids[kind.constructor] {
+						t.Errorf("parallel chain hierarchy: dispatch uses new %s.%s instead of the existing header seam", name, method.name)
+						break
+					}
+				}
+			}
+		}
+	}
+}
