+func TestP2PNewBlockHeaderKawpowExtendedLayout(t *testing.T) {
+	f2pCheckHeaderInterface(t)
+	t.Run("full_boundary_contract", checkAuditConstructionAndHashes)
+	prev, merkle := p2pPrevBlock(), p2pMerkleRoot()
+	h := NewBlockHeader(Kawpow, p2pVersion, prev, merkle, p2pTimestamp, p2pBits, p2pNonce, p2pHeight)
+	if h == nil {
+		t.Fatal("NewBlockHeader(Kawpow, ...) returned nil")
+	}
+	inner, ok := h.inner.(*RavencoinBlockHeader)
+	if !ok {
+		t.Fatalf("KAWPOW inner header type = %T, want *RavencoinBlockHeader", h.inner)
+	}
+	if inner.Height != p2pHeight {
+		t.Errorf("KAWPOW height = %d, want %d", inner.Height, p2pHeight)
+	}
+	if inner.Nonce64 != 0 {
+		t.Errorf("KAWPOW nonce64 = %d, want 0", inner.Nonce64)
+	}
+	if inner.MixHash != (common.Hash{}) {
+		t.Errorf("KAWPOW mixHash = %x, want zero", inner.MixHash)
+	}
+	if h.Version() != p2pVersion {
+		t.Errorf("Version() = %#x, want %#x", h.Version(), p2pVersion)
+	}
+	if h.PrevBlock() != prev {
+		t.Errorf("PrevBlock() = %x, want %x", h.PrevBlock(), prev)
+	}
+	if h.MerkleRoot() != merkle {
+		t.Errorf("MerkleRoot() = %x, want %x", h.MerkleRoot(), merkle)
+	}
+	if h.Timestamp() != p2pTimestamp {
+		t.Errorf("Timestamp() = %d, want %d", h.Timestamp(), p2pTimestamp)
+	}
+	if h.Bits() != p2pBits {
+		t.Errorf("Bits() = %#x, want %#x", h.Bits(), p2pBits)
+	}
+	if h.Height() != p2pHeight {
+		t.Errorf("Height() = %d, want %d", h.Height(), p2pHeight)
+	}
+	if h.Nonce() != 0 {
+		t.Errorf("KAWPOW Nonce() = %#x, want 0; the 32-bit nonce argument must not leak into a KAWPOW header", h.Nonce())
+	}
+	want := NewRavencoinBlockHeader(p2pVersion, prev, merkle, p2pTimestamp, p2pBits, p2pHeight).EncodeBinaryRavencoinHeader()
+	if got := h.Bytes(); !bytes.Equal(got, want) {
+		t.Errorf("KAWPOW header bytes = %x, want %x", got, want)
+	}
+	if len(h.Bytes()) != 120 {
+		t.Errorf("KAWPOW header length = %d, want 120", len(h.Bytes()))
+	}
+}
