+func p2pExtendedKawpowHeader(t *testing.T) *AuxPowHeader {
+	t.Helper()
+	h := p2pBuildHeader(t, Kawpow)
+	inner, ok := h.inner.(*RavencoinBlockHeader)
+	if !ok {
+		t.Fatalf("KAWPOW inner header type = %T, want *RavencoinBlockHeader", h.inner)
+	}
+	inner.Nonce64 = 0x0102030405060708
+	inner.MixHash = p2pHashOf(0x77)
+	return h
+}
+
+func p2pAuxPowJSON(powID PowID, header, auxpow2, signature, transaction []byte, merkleBranch [][]byte) []byte {
+	branches := make([]string, len(merkleBranch))
+	for i, b := range merkleBranch {
+		branches[i] = `"0x` + hex.EncodeToString(b) + `"`
+	}
+	return []byte(fmt.Sprintf(
+		`{"powId":"0x%x","header":"0x%s","auxpow2":"0x%s","signature":"0x%s","merkleBranch":[%s],"transaction":"0x%s"}`,
+		uint32(powID),
+		hex.EncodeToString(header),
+		hex.EncodeToString(auxpow2),
+		hex.EncodeToString(signature),
+		strings.Join(branches, ","),
+		hex.EncodeToString(transaction),
+	))
+}
+
+func p2pSerializedBytes(t *testing.T, h AuxHeaderData) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := h.Serialize(&buf); err != nil {
+		t.Fatalf("Serialize: %v", err)
+	}
+	return buf.Bytes()
+}
