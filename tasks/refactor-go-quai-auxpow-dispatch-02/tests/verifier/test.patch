+func p2pPrevBlock() [32]byte {
+	var b [32]byte
+	for i := range b {
+		b[i] = 0xa1
+	}
+	return b
+}
+
+func p2pMerkleRoot() [32]byte {
+	var b [32]byte
+	for i := range b {
+		b[i] = 0xb2
+	}
+	return b
+}
+
+func p2pBuildHeader(t *testing.T, powID PowID) *AuxPowHeader {
+	t.Helper()
+	h := NewBlockHeader(powID, p2pVersion, p2pPrevBlock(), p2pMerkleRoot(), p2pTimestamp, p2pBits, p2pNonce, p2pHeight)
+	if h == nil {
+		t.Fatalf("NewBlockHeader(%s, ...) returned nil for a supported chain", powID)
+	}
+	return h
+}
