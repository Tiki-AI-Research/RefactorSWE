+func p2pNewAuxPow(powID PowID, h *AuxPowHeader) *AuxPow {
+	ap := &AuxPow{}
+	ap.SetPowID(powID)
+	ap.SetHeader(h)
+	ap.SetSignature([]byte{0x0a, 0x0b})
+	ap.SetAuxPow2([]byte{0x0c})
+	ap.SetMerkleBranch([][]byte{{0x0d, 0x0e}, {0x0f}})
+	ap.SetTransaction([]byte{0x10, 0x11})
+	return ap
+}
