@@ -0,0 +1,1854 @@
+// Supplemental F2P coverage for the AuxPow proof-of-work identifier dispatch
+// refactor in core/types.
+//
+// The P2P tests pin public behavior. Structural checks trace consumers to
+// identifier-indexed state and chain-owned contributions. Maps, arrays and
+// slices, eager or lazy registration, and function fields or methods are
+// implementation choices rather than acceptance requirements.
+package types
+
+import (
+	"github.com/dominant-strategies/go-quai/common"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// ---------------------------------------------------------------------------
+// Frozen analysis inputs
+// ---------------------------------------------------------------------------
+
+// f2pChainConstants are the supported proof-of-work identifiers whose repeated
+// branching must be consolidated.
+var f2pChainConstants = []string{"Kawpow", "SHA_BTC", "SHA_BCH", "Scrypt"}
+
+// f2pChainHashLibs are the per-chain double-SHA256 libraries.
+var f2pChainHashLibs = []string{
+	"github.com/btcsuite/btcd/chaincfg/chainhash",
+	"github.com/gcash/bchd/chaincfg/chainhash",
+	"github.com/dominant-strategies/ltcd/chaincfg/chainhash",
+}
+
+// f2pChainKind names, per supported identifier, the concrete header type, the
+// per-chain constructor and the chainhash library that own that chain.
+type f2pChainKind struct {
+	constant    string
+	headerType  string
+	constructor string
+	hashLib     string
+}
+
+var f2pChainKinds = []f2pChainKind{
+	{"Kawpow", "RavencoinBlockHeader", "NewRavencoinBlockHeader", "github.com/btcsuite/btcd/chaincfg/chainhash"},
+	{"SHA_BTC", "BitcoinHeaderWrapper", "NewBitcoinBlockHeader", "github.com/btcsuite/btcd/chaincfg/chainhash"},
+	{"SHA_BCH", "BitcoinCashHeaderWrapper", "NewBitcoinCashBlockHeader", "github.com/gcash/bchd/chaincfg/chainhash"},
+	{"Scrypt", "LitecoinHeaderWrapper", "NewLitecoinBlockHeader", "github.com/dominant-strategies/ltcd/chaincfg/chainhash"},
+}
+
+// f2pConsumers lists the shared responsibilities whose identifier branching
+// must be consolidated, addressed as declared in the package sources.
+var f2pConsumers = []struct {
+	label string
+	sym   string
+}{
+	{"NewBlockHeader", "NewBlockHeader"},
+	{"(*AuxPow).UnmarshalJSON", "AuxPow.UnmarshalJSON"},
+	{"(*AuxPow).ProtoDecode", "AuxPow.ProtoDecode"},
+	{"AuxPowTxHash", "AuxPowTxHash"},
+}
+
+// ---------------------------------------------------------------------------
+// Source model
+// ---------------------------------------------------------------------------
+
+type f2pFunc struct {
+	name    string
+	file    string
+	decl    *ast.FuncDecl
+	body    *ast.BlockStmt
+	params  []string
+	results []string
+}
+
+type f2pVarDecl struct {
+	name string
+	file string
+	tok  token.Token
+	spec *ast.ValueSpec
+	expr ast.Expr
+}
+
+type f2pStructField struct {
+	name string
+	typ  ast.Expr
+}
+
+type f2pStruct struct {
+	name   string
+	file   string
+	fields []f2pStructField
+	expr   ast.Expr
+}
+
+type f2pFile struct {
+	name    string
+	syntax  *ast.File
+	imports map[string]string
+}
+
+type f2pPkg struct {
+	dir     string
+	fset    *token.FileSet
+	files   map[string]*f2pFile
+	order   []string
+	funcs   map[string]*f2pFunc
+	methods map[string]*f2pFunc
+	types   map[string]*f2pStruct
+	vars    map[string]*f2pVarDecl
+	consts  map[string]*f2pVarDecl
+}
+
+func f2pPackageDir(t *testing.T) string {
+	t.Helper()
+	var candidates []string
+	if _, file, _, ok := runtime.Caller(0); ok {
+		candidates = append(candidates, filepath.Dir(file))
+	}
+	if wd, err := os.Getwd(); err == nil {
+		candidates = append(candidates, wd)
+	}
+	for _, dir := range candidates {
+		if st, err := os.Stat(filepath.Join(dir, "auxpow.go")); err == nil && !st.IsDir() {
+			return dir
+		}
+	}
+	for _, dir := range candidates {
+		root := dir
+		for i := 0; i < 8; i++ {
+			candidate := filepath.Join(root, "core", "types")
+			if st, err := os.Stat(filepath.Join(candidate, "auxpow.go")); err == nil && !st.IsDir() {
+				return candidate
+			}
+			parent := filepath.Dir(root)
+			if parent == root {
+				break
+			}
+			root = parent
+		}
+	}
+	t.Fatalf("F2P analysis could not locate the core/types package sources (tried %v)", candidates)
+	return ""
+}
+
+func f2pLoadPackage(t *testing.T) *f2pPkg {
+	t.Helper()
+	p := &f2pPkg{
+		dir:     f2pPackageDir(t),
+		fset:    token.NewFileSet(),
+		files:   map[string]*f2pFile{},
+		funcs:   map[string]*f2pFunc{},
+		methods: map[string]*f2pFunc{},
+		types:   map[string]*f2pStruct{},
+		vars:    map[string]*f2pVarDecl{},
+		consts:  map[string]*f2pVarDecl{},
+	}
+	entries, err := os.ReadDir(p.dir)
+	if err != nil {
+		t.Fatalf("F2P analysis cannot list %s: %v", p.dir, err)
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+		parsed, err := parser.ParseFile(p.fset, filepath.Join(p.dir, name), nil, 0)
+		if err != nil {
+			t.Fatalf("F2P analysis cannot parse %s: %v", name, err)
+		}
+		p.files[name] = &f2pFile{name: name, syntax: parsed, imports: map[string]string{}}
+		p.order = append(p.order, name)
+	}
+	sort.Strings(p.order)
+	if len(p.files) == 0 {
+		t.Fatalf("F2P analysis found no production sources in %s", p.dir)
+	}
+	for _, name := range p.order {
+		f := p.files[name]
+		for _, spec := range f.syntax.Imports {
+			path := strings.Trim(spec.Path.Value, `"`)
+			local := path[strings.LastIndex(path, "/")+1:]
+			if spec.Name != nil && spec.Name.Name != "" && spec.Name.Name != "." && spec.Name.Name != "_" {
+				local = spec.Name.Name
+			}
+			f.imports[local] = path
+		}
+		for _, decl := range f.syntax.Decls {
+			switch d := decl.(type) {
+			case *ast.FuncDecl:
+				fn := &f2pFunc{name: d.Name.Name, file: name, decl: d, body: d.Body}
+				fn.params = f2pParamNames(d.Type)
+				fn.results = f2pResultTypeNames(d.Type)
+				if d.Recv == nil || len(d.Recv.List) == 0 {
+					if _, exists := p.funcs[fn.name]; !exists {
+						p.funcs[fn.name] = fn
+					}
+				} else {
+					key := f2pReceiverName(d.Recv.List[0].Type) + "." + fn.name
+					if _, exists := p.methods[key]; !exists {
+						p.methods[key] = fn
+					}
+				}
+			case *ast.GenDecl:
+				switch d.Tok {
+				case token.TYPE:
+					for _, spec := range d.Specs {
+						ts, ok := spec.(*ast.TypeSpec)
+						if !ok {
+							continue
+						}
+						st := &f2pStruct{name: ts.Name.Name, file: name, expr: ts.Type}
+						if styp, ok := ts.Type.(*ast.StructType); ok {
+							for _, field := range styp.Fields.List {
+								for _, id := range field.Names {
+									st.fields = append(st.fields, f2pStructField{name: id.Name, typ: field.Type})
+								}
+							}
+						}
+						if _, exists := p.types[st.name]; !exists {
+							p.types[st.name] = st
+						}
+					}
+				case token.VAR, token.CONST:
+					for _, spec := range d.Specs {
+						vs, ok := spec.(*ast.ValueSpec)
+						if !ok {
+							continue
+						}
+						for i, id := range vs.Names {
+							decl := &f2pVarDecl{name: id.Name, file: name, tok: d.Tok, spec: vs, expr: f2pValueForName(vs, i)}
+							if d.Tok == token.VAR {
+								if _, exists := p.vars[decl.name]; !exists {
+									p.vars[decl.name] = decl
+								}
+							} else {
+								if _, exists := p.consts[decl.name]; !exists {
+									p.consts[decl.name] = decl
+								}
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+	return p
+}
+
+// ---------------------------------------------------------------------------
+// AST helpers
+// ---------------------------------------------------------------------------
+
+func f2pValueForName(vs *ast.ValueSpec, i int) ast.Expr {
+	if len(vs.Values) == len(vs.Names) {
+		if i < len(vs.Values) {
+			return vs.Values[i]
+		}
+		return nil
+	}
+	if len(vs.Values) == 1 {
+		return vs.Values[0]
+	}
+	return nil
+}
+
+func f2pReceiverName(expr ast.Expr) string {
+	switch t := expr.(type) {
+	case *ast.Ident:
+		return t.Name
+	case *ast.StarExpr:
+		return f2pReceiverName(t.X)
+	case *ast.IndexExpr:
+		return f2pReceiverName(t.X)
+	}
+	return ""
+}
+
+func f2pParamNames(ft *ast.FuncType) []string {
+	var out []string
+	if ft == nil || ft.Params == nil {
+		return out
+	}
+	for _, field := range ft.Params.List {
+		if len(field.Names) == 0 {
+			out = append(out, "")
+			continue
+		}
+		for _, name := range field.Names {
+			out = append(out, name.Name)
+		}
+	}
+	return out
+}
+
+func f2pResultTypeNames(ft *ast.FuncType) []string {
+	var out []string
+	if ft == nil || ft.Results == nil {
+		return out
+	}
+	for _, field := range ft.Results.List {
+		name := f2pExprTypeName(field.Type)
+		if len(field.Names) == 0 {
+			out = append(out, name)
+			continue
+		}
+		for range field.Names {
+			out = append(out, name)
+		}
+	}
+	return out
+}
+
+func f2pExprTypeName(expr ast.Expr) string {
+	switch t := expr.(type) {
+	case *ast.Ident:
+		return t.Name
+	case *ast.StarExpr:
+		return f2pExprTypeName(t.X)
+	case *ast.SelectorExpr:
+		return f2pExprTypeName(t.X) + "." + t.Sel.Name
+	case *ast.ParenExpr:
+		return f2pExprTypeName(t.X)
+	}
+	return ""
+}
+
+func f2pIsByteSlice(expr ast.Expr) bool {
+	arr, ok := expr.(*ast.ArrayType)
+	if !ok || arr.Len != nil {
+		return false
+	}
+	id, ok := arr.Elt.(*ast.Ident)
+	return ok && id.Name == "byte"
+}
+
+func f2pIdents(node ast.Node) map[string]bool {
+	out := map[string]bool{}
+	if node == nil {
+		return out
+	}
+	ast.Inspect(node, func(n ast.Node) bool {
+		if id, ok := n.(*ast.Ident); ok {
+			out[id.Name] = true
+		}
+		return true
+	})
+	return out
+}
+
+func f2pCalls(node ast.Node) []*ast.CallExpr {
+	var out []*ast.CallExpr
+	if node == nil {
+		return out
+	}
+	ast.Inspect(node, func(n ast.Node) bool {
+		if call, ok := n.(*ast.CallExpr); ok {
+			out = append(out, call)
+		}
+		return true
+	})
+	return out
+}
+
+func f2pKeys(set map[string]bool) []string {
+	out := make([]string, 0, len(set))
+	for key := range set {
+		out = append(out, key)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func f2pIntersect(set map[string]bool, names []string) []string {
+	var hits []string
+	for _, name := range names {
+		if set[name] {
+			hits = append(hits, name)
+		}
+	}
+	sort.Strings(hits)
+	return hits
+}
+
+func f2pIsIdent(expr ast.Expr, name string) bool {
+	id, ok := expr.(*ast.Ident)
+	return ok && id.Name == name
+}
+
+// ---------------------------------------------------------------------------
+// Package model
+// ---------------------------------------------------------------------------
+
+func (p *f2pPkg) symbol(name string) *f2pFunc {
+	if fn := p.funcs[name]; fn != nil {
+		return fn
+	}
+	return p.methods[name]
+}
+
+func (p *f2pPkg) closureFunc(name string) *f2pFunc {
+	return p.symbol(name)
+}
+
+type f2pRegistry struct {
+	name        string
+	file        string
+	valueType   string
+	valueStruct *f2pStruct
+	fields      map[string]ast.Expr
+}
+
+func f2pMapValueExpr(expr ast.Expr) ast.Expr {
+	switch t := expr.(type) {
+	case *ast.MapType:
+		return t.Value
+	case *ast.ArrayType:
+		return t.Elt
+	case *ast.ParenExpr:
+		return f2pMapValueExpr(t.X)
+	case *ast.CallExpr:
+		if id, ok := t.Fun.(*ast.Ident); ok && id.Name == "make" && len(t.Args) > 0 {
+			return f2pMapValueExpr(t.Args[0])
+		}
+	case *ast.CompositeLit:
+		if t.Type != nil {
+			return f2pMapValueExpr(t.Type)
+		}
+	}
+	return nil
+}
+
+// collectionValue resolves named private containers without fixing their spelling.
+func (p *f2pPkg) collectionValue(expr ast.Expr, depth int) ast.Expr {
+	if depth > len(p.types)+4 {
+		return nil
+	}
+	switch x := expr.(type) {
+	case *ast.Ident:
+		if st := p.types[x.Name]; st != nil {
+			return p.collectionValue(st.expr, depth+1)
+		}
+	case *ast.CompositeLit:
+		return p.collectionValue(x.Type, depth+1)
+	case *ast.ParenExpr:
+		return p.collectionValue(x.X, depth+1)
+	case *ast.CallExpr:
+		if f2pIsIdent(x.Fun, "make") && len(x.Args) > 0 {
+			return p.collectionValue(x.Args[0], depth+1)
+		}
+	}
+	return f2pMapValueExpr(expr)
+}
+
+func f2pRegistryNames(regs map[string]*f2pRegistry) []string {
+	var out []string
+	for name := range regs {
+		out = append(out, name)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// registries finds identifier-indexed storage without prescribing its container
+// kind or requiring a descriptor with function-valued fields.
+func (p *f2pPkg) registries() map[string]*f2pRegistry {
+	out := map[string]*f2pRegistry{}
+	for name, v := range p.vars {
+		var typeExpr ast.Expr
+		if v.spec.Type != nil {
+			typeExpr = v.spec.Type
+		} else {
+			typeExpr = v.expr
+		}
+		for i := 0; i < len(p.types); i++ {
+			id, ok := typeExpr.(*ast.Ident)
+			if !ok || p.types[id.Name] == nil {
+				break
+			}
+			typeExpr = p.types[id.Name].expr
+		}
+		valueExpr := p.collectionValue(typeExpr, 0)
+		if valueExpr == nil {
+			continue
+		}
+		vt := f2pExprTypeName(valueExpr)
+		reg := &f2pRegistry{name: name, file: v.file, valueType: vt}
+		if st := p.types[vt]; st != nil {
+			reg.valueStruct = st
+			reg.fields = map[string]ast.Expr{}
+			for _, f := range st.fields {
+				reg.fields[f.name] = f.typ
+			}
+		}
+		out[name] = reg
+	}
+	return out
+}
+
+// callClosure follows package helpers and resolvable method helpers from start.
+func (p *f2pPkg) callClosure(start string) map[string]bool {
+	seen := map[string]bool{}
+	var visit func(name string)
+	visit = func(name string) {
+		if name == "" || seen[name] {
+			return
+		}
+		fn := p.closureFunc(name)
+		if fn == nil {
+			return
+		}
+		seen[name] = true
+		for _, call := range f2pCalls(fn.body) {
+			target := p.callableForCall(call)
+			if target == nil {
+				continue
+			}
+			for key, method := range p.methods {
+				if method == target {
+					visit(key)
+				}
+			}
+			if p.funcs[target.name] == target {
+				visit(target.name)
+			}
+		}
+	}
+	visit(start)
+	return seen
+}
+
+// closureBodyIdents collects the identifiers appearing in the bodies of the
+// shared delegation closure. Chain-owned registration bodies are boundaries,
+// not repeated mappings in the shared code.
+func (p *f2pPkg) closureBodyIdents(start string) map[string]bool {
+	out := map[string]bool{}
+	for name := range p.callClosure(start) {
+		if p.sharedFactories()[name] != nil {
+			continue
+		}
+		fn := p.closureFunc(name)
+		if fn == nil {
+			continue
+		}
+		owned := false
+		for _, kind := range f2pChainKinds {
+			if st := p.types[kind.headerType]; st != nil && st.file == fn.file && name != start {
+				owned = true
+			}
+		}
+		if owned {
+			continue
+		}
+		if fn.body != nil {
+			for id := range f2pIdents(fn.body) {
+				out[id] = true
+			}
+		} else {
+			for id := range f2pIdents(fn.decl) {
+				out[id] = true
+			}
+		}
+	}
+	return out
+}
+
+// registryReads returns the dispatch registries read (not written) within the
+// delegation closure of start.
+func (p *f2pPkg) registryReads(start string) map[string]bool {
+	regs := p.registries()
+	out := map[string]bool{}
+	for name := range p.callClosure(start) {
+		if p.sharedFactories()[name] != nil {
+			continue
+		}
+		fn := p.closureFunc(name)
+		if fn == nil || fn.body == nil {
+			continue
+		}
+		origins := map[string]string{}
+		for reg := range regs {
+			origins[reg] = reg
+		}
+		if fn.decl.Recv != nil {
+			for _, field := range fn.decl.Recv.List {
+				receiverType := f2pReceiverName(field.Type)
+				for reg := range regs {
+					if f2pExprTypeName(p.vars[reg].spec.Type) == receiverType {
+						for _, local := range field.Names {
+							origins[local.Name] = reg
+						}
+					}
+				}
+			}
+		}
+		assignLHS := map[*ast.IndexExpr]bool{}
+		ast.Inspect(fn.body, func(n ast.Node) bool {
+			as, ok := n.(*ast.AssignStmt)
+			if !ok {
+				return true
+			}
+			allBlank := len(as.Lhs) > 0
+			for _, lhs := range as.Lhs {
+				id, ok := lhs.(*ast.Ident)
+				if !ok || id.Name != "_" {
+					allBlank = false
+				}
+			}
+			if allBlank {
+				for _, rhs := range as.Rhs {
+					ast.Inspect(rhs, func(n ast.Node) bool {
+						if ie, ok := n.(*ast.IndexExpr); ok {
+							assignLHS[ie] = true
+						}
+						return true
+					})
+				}
+			}
+			for _, lhs := range as.Lhs {
+				if ie, ok := lhs.(*ast.IndexExpr); ok {
+					assignLHS[ie] = true
+				}
+			}
+			return true
+		})
+		ast.Inspect(fn.body, func(n ast.Node) bool {
+			ie, ok := n.(*ast.IndexExpr)
+			if !ok || assignLHS[ie] {
+				return true
+			}
+			if id, ok := ie.X.(*ast.Ident); ok && origins[id.Name] != "" {
+				out[origins[id.Name]] = true
+			}
+			return true
+		})
+	}
+	for name := range p.sharedFactories() {
+		if p.callClosure(start)[name] {
+			out["switch:"+name] = true
+		}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Registration model
+// ---------------------------------------------------------------------------
+
+type f2pRegEvent struct {
+	file     string
+	registry string
+	value    ast.Expr
+	anchor   ast.Node
+	via      string
+}
+
+// initializationRoots returns the constructs whose execution is reachable
+// from package initialization or the consumer call graph. This includes lazy
+// registration; init functions are not a required implementation shape.
+func (p *f2pPkg) initializationRoots(fileName string) []ast.Node {
+	var roots []ast.Node
+	f := p.files[fileName]
+	if f == nil {
+		return roots
+	}
+	for _, decl := range f.syntax.Decls {
+		switch d := decl.(type) {
+		case *ast.FuncDecl:
+			if d.Recv == nil && d.Name.Name == "init" && d.Body != nil {
+				roots = append(roots, d.Body)
+			}
+		case *ast.GenDecl:
+			if d.Tok != token.VAR {
+				continue
+			}
+			for _, spec := range d.Specs {
+				vs, ok := spec.(*ast.ValueSpec)
+				if !ok {
+					continue
+				}
+				for _, val := range vs.Values {
+					roots = append(roots, val)
+				}
+			}
+		}
+	}
+	for _, consumer := range f2pConsumers {
+		for symbol := range p.callClosure(consumer.sym) {
+			fn := p.symbol(symbol)
+			if fn != nil && fn.file == fileName && fn.body != nil {
+				roots = append(roots, fn.body)
+			}
+		}
+	}
+	return roots
+}
+
+// mapCompositeLiteral accepts keyed map, array and slice literals.
+func mapCompositeLiteral(expr ast.Expr) *ast.CompositeLit {
+	switch t := expr.(type) {
+	case *ast.CompositeLit:
+		if f2pMapValueExpr(t.Type) != nil {
+			return t
+		}
+	case *ast.ParenExpr:
+		return mapCompositeLiteral(t.X)
+	}
+	return nil
+}
+
+// callableForCall resolves a call target to a package-level function or, for
+// method-style registration, to the receiver-typed method. Candidate methods
+// are matched by receiver type so same-named methods on unrelated types never
+// masquerade as the registration entry point; ambiguous resolution returns nil.
+func (p *f2pPkg) callableForCall(call *ast.CallExpr) *f2pFunc {
+	switch fun := call.Fun.(type) {
+	case *ast.Ident:
+		return p.funcs[fun.Name]
+	case *ast.SelectorExpr:
+		recvType := ""
+		if id, ok := fun.X.(*ast.Ident); ok {
+			if v := p.vars[id.Name]; v != nil {
+				if v.spec.Type != nil {
+					recvType = f2pExprTypeName(v.spec.Type)
+				} else if comp, ok := v.expr.(*ast.CompositeLit); ok {
+					recvType = f2pExprTypeName(comp.Type)
+				}
+			}
+			if recvType == "" {
+				if _, ok := p.types[id.Name]; ok {
+					recvType = id.Name
+				}
+			}
+		}
+		var found *f2pFunc
+		for key, fn := range p.methods {
+			if !strings.HasSuffix(key, "."+fun.Sel.Name) {
+				continue
+			}
+			if recvType != "" && key != recvType+"."+fun.Sel.Name {
+				continue
+			}
+			if found != nil {
+				return nil
+			}
+			found = fn
+		}
+		return found
+	}
+	return nil
+}
+
+// registrationEvents finds package-initialization writes into a dispatch
+// registry keyed by the given proof-of-work identifier. Recognized shapes are
+// a direct registry[key] = value write, a call to a registration function or
+// method whose body performs the keyed write (with the identifier passed at
+// the call site in the key parameter position), and a package-level keyed collection
+// literal that binds the identifier as a key.
+func (p *f2pPkg) registrationEvents(fileName, constant string) []f2pRegEvent {
+	regs := p.registries()
+	if p.files[fileName] == nil {
+		return nil
+	}
+	var events []f2pRegEvent
+	for name, v := range p.vars {
+		if v.file != fileName || regs[name] == nil || v.expr == nil {
+			continue
+		}
+		if comp := mapCompositeLiteral(v.expr); comp != nil {
+			for _, elt := range comp.Elts {
+				kv, ok := elt.(*ast.KeyValueExpr)
+				if !ok || !f2pIsIdent(kv.Key, constant) {
+					continue
+				}
+				events = append(events, f2pRegEvent{file: fileName, registry: name, value: kv.Value, anchor: kv, via: "map-literal-key"})
+			}
+		}
+	}
+	for _, root := range p.initializationRoots(fileName) {
+		ast.Inspect(root, func(n ast.Node) bool {
+			switch node := n.(type) {
+			case *ast.AssignStmt:
+				if len(node.Lhs) != 1 || len(node.Rhs) != 1 {
+					return true
+				}
+				ie, ok := node.Lhs[0].(*ast.IndexExpr)
+				if !ok {
+					return true
+				}
+				rid, ok := ie.X.(*ast.Ident)
+				if !ok || regs[rid.Name] == nil {
+					return true
+				}
+				if !f2pIsIdent(ie.Index, constant) {
+					return true
+				}
+				events = append(events, f2pRegEvent{file: fileName, registry: rid.Name, value: node.Rhs[0], anchor: node, via: "initialization-write"})
+				return true
+			case *ast.CallExpr:
+				events = append(events, p.callRegistrationEvents(node, constant, regs, fileName)...)
+			}
+			return true
+		})
+	}
+	return events
+}
+
+func (p *f2pPkg) callRegistrationEvents(call *ast.CallExpr, constant string, regs map[string]*f2pRegistry, fileName string) []f2pRegEvent {
+	callName := ""
+	switch fun := call.Fun.(type) {
+	case *ast.Ident:
+		callName = fun.Name
+	case *ast.SelectorExpr:
+		callName = fun.Sel.Name
+	default:
+		return nil
+	}
+	target := p.callableForCall(call)
+	if target == nil || target.body == nil {
+		return nil
+	}
+	type write struct {
+		registry string
+		keyParam string
+		value    ast.Expr
+	}
+	var writes []write
+	ast.Inspect(target.body, func(n ast.Node) bool {
+		as, ok := n.(*ast.AssignStmt)
+		if !ok || len(as.Lhs) != 1 || len(as.Rhs) != 1 {
+			return true
+		}
+		ie, ok := as.Lhs[0].(*ast.IndexExpr)
+		if !ok {
+			return true
+		}
+		rid, ok := ie.X.(*ast.Ident)
+		if !ok || regs[rid.Name] == nil {
+			return true
+		}
+		kp, ok := ie.Index.(*ast.Ident)
+		if !ok {
+			return true
+		}
+		writes = append(writes, write{registry: rid.Name, keyParam: kp.Name, value: as.Rhs[0]})
+		return true
+	})
+	var events []f2pRegEvent
+	for _, w := range writes {
+		keyPos := -1
+		for i, param := range target.params {
+			if param == w.keyParam {
+				keyPos = i
+				break
+			}
+		}
+		if keyPos < 0 || keyPos >= len(call.Args) {
+			continue
+		}
+		if !f2pIsIdent(call.Args[keyPos], constant) {
+			continue
+		}
+		value := w.value
+		if rid, ok := w.value.(*ast.Ident); ok {
+			for i, param := range target.params {
+				if param == rid.Name {
+					if i < len(call.Args) {
+						value = call.Args[i]
+					}
+					break
+				}
+			}
+		}
+		if value == nil {
+			continue
+		}
+		events = append(events, f2pRegEvent{file: fileName, registry: w.registry, value: value, anchor: call, via: "initialization-call:" + callName})
+	}
+	return events
+}
+
+// valueIdents returns the identifiers referenced by a registration value,
+// expanding named package-level functions and variables one level so a
+// registration that passes a prebuilt implementation still counts.
+// Follow lexical local declarations as well as global descriptors and helpers.
+// AST objects bind each local use to its declaration, avoiding name-only matches.
+func (p *f2pPkg) valueIdents(expr ast.Expr) map[string]bool {
+	out := map[string]bool{}
+	seen := map[ast.Node]bool{}
+	var visit func(ast.Node)
+	visit = func(node ast.Node) {
+		if node == nil || seen[node] {
+			return
+		}
+		seen[node] = true
+		ast.Inspect(node, func(n ast.Node) bool {
+			if selector, ok := n.(*ast.SelectorExpr); ok {
+				visit(selector.X)
+				return false
+			}
+			id, ok := n.(*ast.Ident)
+			if !ok || id.Name == "_" {
+				return true
+			}
+			out[id.Name] = true
+			if id.Obj != nil {
+				switch d := id.Obj.Decl.(type) {
+				case *ast.AssignStmt:
+					for _, e := range d.Rhs {
+						visit(e)
+					}
+				case *ast.ValueSpec:
+					if d.Type != nil {
+						visit(d.Type)
+					}
+					for _, e := range d.Values {
+						visit(e)
+					}
+				}
+			}
+			if fn := p.funcs[id.Name]; fn != nil && fn.body != nil {
+				visit(fn.body)
+			}
+			if v := p.vars[id.Name]; v != nil && v.expr != nil {
+				visit(v.expr)
+			}
+			if c := p.consts[id.Name]; c != nil && c.expr != nil {
+				visit(c.expr)
+			}
+			return true
+		})
+	}
+	visit(expr)
+	return out
+}
+
+// Identifier binding is permitted anywhere in the package. Ownership follows
+// the contributed operations, not the source filename of the binding.
+func (p *f2pPkg) chainEvents(constant string) []f2pRegEvent {
+	var result []f2pRegEvent
+	for _, file := range p.order {
+		result = append(result, p.registrationEvents(file, constant)...)
+	}
+	for name, fn := range p.sharedFactories() {
+		ast.Inspect(fn.body, func(n ast.Node) bool {
+			clause, ok := n.(*ast.CaseClause)
+			if !ok {
+				return true
+			}
+			matched := false
+			for _, key := range clause.List {
+				if f2pIsIdent(key, constant) {
+					matched = true
+				}
+			}
+			if matched {
+				for _, stmt := range clause.Body {
+					if ret, ok := stmt.(*ast.ReturnStmt); ok {
+						for _, value := range ret.Results {
+							result = append(result, f2pRegEvent{file: fn.file, registry: "switch:" + name, value: value, anchor: clause, via: "shared-factory"})
+						}
+					}
+				}
+			}
+			return true
+		})
+	}
+	return result
+}
