+func p2pCheckCopyIsolation(t *testing.T) {
+	t.Helper()
+	for _, id := range []PowID{Kawpow, SHA_BTC, SHA_BCH, Scrypt} {
+		original := p2pBuildHeader(t, id)
+		before := append([]byte(nil), original.Bytes()...)
+		cp := original.Copy()
+		if cp == nil {
+			t.Fatalf("%s Copy returned nil", id)
+		}
+		if !bytes.Equal(cp.Bytes(), before) {
+			t.Errorf("%s Copy changed initial bytes", id)
+		}
+		changes := []func(){func() { cp.SetNonce(p2pNonce + 1) }}
+		if id == Kawpow {
+			changes = []func(){func() { cp.SetHeight(p2pHeight + 1) }, func() { cp.SetNonce64(0x123456789) }, func() { cp.SetMixHash(p2pHashOf(0x73)) }}
+		}
+		for i, change := range changes {
+			prior := append([]byte(nil), cp.Bytes()...)
+			change()
+			if bytes.Equal(cp.Bytes(), prior) {
+				t.Errorf("%s copy mutation %d did not change its bytes", id, i)
+			}
+			if !bytes.Equal(original.Bytes(), before) {
+				t.Errorf("%s Copy shares mutable inner state (mutation %d)", id, i)
+			}
+		}
+	}
+	empty := (&AuxPowHeader{}).Copy()
+	if empty == nil || empty.inner != nil {
+		t.Error("empty header Copy must retain an unset inner")
+	}
+}
