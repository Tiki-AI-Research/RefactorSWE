+func TestP2PProtoDecodeUnsupportedPowIDErrorAndOrdering(t *testing.T) {
+	for _, powID := range []PowID{Progpow, PowID(7), PowID(99)} {
+		ap := &AuxPow{}
+		ap.SetPowID(SHA_BTC)
+		ap.SetSignature([]byte{0x11})
+		ap.SetAuxPow2([]byte{0x12})
+		ap.SetMerkleBranch([][]byte{{0x13}})
+		ap.SetTransaction([]byte{0x14})
+		chainID := uint32(powID)
+		err := ap.ProtoDecode(&ProtoAuxPow{
+			ChainId:      &chainID,
+			Header:       []byte{0x01, 0x02, 0x03},
+			Signature:    []byte{0x21},
+			MerkleBranch: [][]byte{{0x22}},
+			Transaction:  []byte{0x23},
+			Auxpow2:      []byte{0x24},
+		})
+		if err == nil {
+			t.Fatalf("ProtoDecode(%s) returned nil error, want unsupported-identifier error", powID)
+		}
+		if err.Error() != "unsupported powId for AuxPow header" {
+			t.Errorf("ProtoDecode(%s) error = %q, want %q", powID, err.Error(), "unsupported powId for AuxPow header")
+		}
+		if ap.PowID() != powID {
+			t.Errorf("ProtoDecode(%s) left PowID = %s; the identifier must be recorded before the header bytes are decoded", powID, ap.PowID())
+		}
+		if ap.Header() != nil {
+			t.Errorf("ProtoDecode(%s) set a header for an unsupported identifier", powID)
+		}
+		if !bytes.Equal(ap.Signature(), []byte{0x11}) {
+			t.Errorf("ProtoDecode(%s) modified the signature on the error path", powID)
+		}
+		if !bytes.Equal(ap.AuxPow2(), []byte{0x12}) {
+			t.Errorf("ProtoDecode(%s) modified auxpow2 on the error path", powID)
+		}
+		if len(ap.MerkleBranch()) != 1 || !bytes.Equal(ap.MerkleBranch()[0], []byte{0x13}) {
+			t.Errorf("ProtoDecode(%s) modified the merkle branch on the error path", powID)
+		}
+		if !bytes.Equal(ap.Transaction(), []byte{0x14}) {
+			t.Errorf("ProtoDecode(%s) modified the transaction on the error path", powID)
+		}
+	}
+}
