+"""Task-specific contracts for session state, identity and resource ownership."""
+import ast
+import calendar
+import gc
+import hashlib
+import io
+import sys
+import types
+from contextlib import contextmanager
+from pathlib import Path
+from unittest.mock import patch
+
+import dill
+from dill import session
+
+
+@contextmanager
+def _imported(name):
+    missing = object()
+    old = sys.modules.get(name, missing)
+    module = types.ModuleType(name)
+    module.value = 17
+    sys.modules[name] = module
+    try:
+        yield module
+    finally:
+        if old is missing:
+            sys.modules.pop(name, None)
+        else:
+            sys.modules[name] = old
+
+
+def _runtime(name):
+    module = types.ModuleType(name)
+    module.value = 17
+    assert name not in sys.modules and '__runtime__.' + name not in sys.modules
+    return module
+
+
+def _payload(module, **kwargs):
+    stream = io.BytesIO()
+    assert dill.dump_module(stream, module=module, **kwargs) is None
+    assert not stream.closed
+    return stream.getvalue()
+
+
+def _caught(function):
+    try:
+        function()
+    except BaseException as error:
+        return error
+    return None
+
+
+# ---------------------------------------------------------------------------
+# Independently scored checkpoints
+#
+# A multi-assertion scenario is reported as one F2P selector per checkpoint.
+# The scenario runs once per process and records every checkpoint; each leaf
+# below judges a single checkpoint.  Checkpoints that already hold on the
+# unrefactored baseline are preconditions of every leaf of their scenario, and
+# a scenario that stops before completing fails every leaf, so the leaves pass
+# together exactly when the original combined test passed.
+# ---------------------------------------------------------------------------
+
+
+class _Checkpoints:
+    def __init__(self):
+        self.results = {}
+        self.messages = {}
+        self.preconditions = []
+
+    def check(self, name, condition, message="", precondition=False):
+        if precondition:
+            self.preconditions.append(name)
+        self.messages[name] = message
+        try:
+            self.results[name] = bool(condition())
+        except BaseException:
+            self.results[name] = False
+            raise
+
+    def record(self, name, value, message="", precondition=False):
+        self.check(name, lambda: value, message, precondition)
+
+
+_SCENARIO_OUTCOMES = {}
+
+
+def _scenario_outcome(scenario):
+    if scenario not in _SCENARIO_OUTCOMES:
+        checkpoints = _Checkpoints()
+        try:
+            scenario(checkpoints)
+        except Exception as exc:  # reported by every leaf of this scenario
+            _SCENARIO_OUTCOMES[scenario] = (checkpoints, exc)
+        else:
+            _SCENARIO_OUTCOMES[scenario] = (checkpoints, None)
+    return _SCENARIO_OUTCOMES[scenario]
+
+
+def _assert_checkpoint(scenario, name):
+    checkpoints, stopped = _scenario_outcome(scenario)
+    for required in checkpoints.preconditions:
+        assert checkpoints.results[required], (
+            "precondition %r failed: %s" % (required, checkpoints.messages[required]))
+    if name in checkpoints.results:
+        assert checkpoints.results[name], (
+            "checkpoint %r failed: %s" % (name, checkpoints.messages[name]))
+    if stopped is not None:
+        if isinstance(stopped, AssertionError):
+            raise AssertionError(
+                "scenario stopped before completing: %s" % (stopped,)) from stopped
+        raise stopped
+    assert name in checkpoints.results, "checkpoint %r was not reached" % (name,)
+
+
+def test_implicit_main_returns_none():
+    main = types.ModuleType('__main__')
+    main.value = 17
+    # Do not serialize the runner's imports, traceback machinery or globals.
+    # Both main-module providers are patched for a genuine implicit main load.
+    with patch.dict(sys.modules, {'__main__': main}), patch.object(session, '_main_module', main), patch.object(dill._dill, '_main_module', main):
+        payload = _payload(main)
+        main.value = 99
+        result = dill.load_module(io.BytesIO(payload))
+        assert main.value == 17
+        assert result is None, 'implicit __main__ updates must return None'
+
+
+def test_runtime_function_globals_identity():
+    for refimported in (False, True):
+        module = _runtime('qc_function_globals')
+        module.selfref = module
+        exec('def local(): return value', module.__dict__)
+        restored = dill.load_module(io.BytesIO(_payload(module, refimported=refimported)))
+        assert restored.selfref is restored
+        assert restored.local() == 17
+        # Baseline binds these globals to the restored runtime namespace only
+        # with refimported=True. The default mode permits separate globals.
+        if refimported:
+            assert restored.local.__globals__ is restored.__dict__
+
+
+def test_asdict_function_globals_identity():
+    with _imported('qc_dictionary_globals') as module:
+        module.selfref = module
+        exec('def local(): return value', module.__dict__)
+        before = dict(module.__dict__)
+        state = dill.load_module_asdict(io.BytesIO(_payload(module)))
+        assert state['local']() == 17
+        assert state['local'].__globals__ is state
+        assert state['selfref'].__dict__ is state
+        assert module.__dict__ == before
+
+
+def _reference_payload(module):
+    module.CalendarAlias = calendar.Calendar
+    module.unsupported_list_alias = calendar.mdays
+    return _payload(module, refimported=True)
+
+
+def test_load_supported_import_alias_identity():
+    module = _runtime('qc_load_reference_alias')
+    restored = dill.load_module(io.BytesIO(_reference_payload(module)))
+    assert restored.CalendarAlias is sys.modules['calendar'].Calendar
+
+
+def test_asdict_supported_import_alias_identity():
+    with _imported('qc_asdict_reference_alias') as module:
+        state = dill.load_module_asdict(io.BytesIO(_reference_payload(module)))
+        assert state['CalendarAlias'] is sys.modules['calendar'].Calendar
+
+
+def test_load_does_not_expand_import_alias_set():
+    module = _runtime('qc_load_nonreference_alias')
+    restored = dill.load_module(io.BytesIO(_reference_payload(module)))
+    assert restored.unsupported_list_alias == calendar.mdays
+    assert restored.unsupported_list_alias is not calendar.mdays
+
+
+def test_asdict_does_not_expand_import_alias_set():
+    with _imported('qc_asdict_nonreference_alias') as module:
+        state = dill.load_module_asdict(io.BytesIO(_reference_payload(module)))
+        assert state['unsupported_list_alias'] == calendar.mdays
+        assert state['unsupported_list_alias'] is not calendar.mdays
+
+
+_registration_events = []
+
+
+def _fail_after_registration(key):
+    _registration_events.append(key in sys.modules)
+    if key not in sys.modules:
+        raise AssertionError('test did not reach registered runtime loading')
+    raise ValueError('registered runtime load failed')
+
+
+class _FailOnLoad:
+    def __init__(self, key):
+        self.key = key
+
+    def __reduce__(self):
+        return _fail_after_registration, (self.key,)
+
+
+def _failing_payload(name):
+    module = _runtime(name)
+    key = '__runtime__.' + name
+    module.failure = _FailOnLoad(key)
+    payload = _payload(module)
+    _registration_events.clear()
+    return module, key, payload
+
+
+def test_load_failure_after_registration_cleans_runtime():
+    module, key, payload = _failing_payload('qc_registered_load_failure')
+    try:
+        error = _caught(lambda: dill.load_module(io.BytesIO(payload), module=module))
+        assert _registration_events == [True]
+        assert isinstance(error, ValueError) and str(error) == 'registered runtime load failed'
+        assert key not in sys.modules
+    finally:
+        sys.modules.pop(key, None)
+
+
+def _scenario_asdict_failure_after_registration_cleans_runtime(checkpoints):
+    module, key, payload = _failing_payload('qc_registered_dictionary_failure')
+    try:
+        error = _caught(lambda: dill.load_module_asdict(io.BytesIO(payload)))
+        checkpoints.check(
+            'registration_observed', lambda: _registration_events == [True],
+            'loading must reach the registered runtime module', precondition=True)
+        checkpoints.check(
+            'error_is_value_error', lambda: isinstance(error, ValueError),
+            'the original ValueError must propagate from load_module_asdict')
+        checkpoints.check(
+            'error_message', lambda: str(error) == 'registered runtime load failed',
+            'the original failure message must be preserved')
+        checkpoints.check(
+            'runtime_unregistered', lambda: key not in sys.modules,
+            'the temporary runtime registration must be removed', precondition=True)
+        checkpoints.check(
+            'failure_state_kept', lambda: 'failure' in module.__dict__,
+            'the runtime module state must not be cleared', precondition=True)
+    finally:
+        sys.modules.pop(key, None)
+
+
+def test_asdict_failure_after_registration_cleans_runtime__error_is_value_error():
+    _assert_checkpoint(_scenario_asdict_failure_after_registration_cleans_runtime,
+                       'error_is_value_error')
+
+
+def test_asdict_failure_after_registration_cleans_runtime__error_message():
+    _assert_checkpoint(_scenario_asdict_failure_after_registration_cleans_runtime,
+                       'error_message')
+
+
+class _Stream(io.BytesIO):
+    def __init__(self, data=b'', close_error=False):
+        super().__init__(data)
+        self.events = []
+        self.close_error = close_error
+
+    def close(self):
+        self.events.append('close')
+        super().close()
+        if self.close_error:
+            raise OSError('owned close failed')
+
+
+class _PeekStream(_Stream):
+    def peek(self, count):
+        return self.getvalue()[self.tell():self.tell() + count]
+
+
+class _Bufferable:
+    """Readable, bufferable input without peek, tell or seek."""
+    def __init__(self, data):
+        self.raw = io.BytesIO(data)
+        self.close_calls = 0
+
+    @property
+    def closed(self):
+        return self.raw.closed
+
+    def readable(self):
+        return True
+
+    def read(self, count=-1):
+        return self.raw.read(count)
+
+    def readinto(self, buffer):
+        return self.raw.readinto(buffer)
+
+    def close(self):
+        self.close_calls += 1
+        self.raw.close()
+
+
+class _BufferableTell(_Bufferable):
+    def tell(self):
+        return self.raw.tell()
+
+
+class _BufferableSeek(_Bufferable):
+    def seek(self, *args):
+        return self.raw.seek(*args)
+
+
+def test_borrowed_writer_success_remains_open():
+    stream = _Stream()
+    assert dill.dump_module(stream, module=_runtime('qc_borrowed_writer')) is None
+    assert not stream.closed and stream.events == []
+    assert stream.getvalue()
+
+
+def test_borrowed_writer_failure_remains_open():
+    stream = _Stream()
+    calls = []
+    def fail(pickler, module):
+        calls.append(True)
+        raise ValueError('dump operation failed')
+    with patch.object(session.Pickler, 'dump', fail):
+        error = _caught(lambda: dill.dump_module(stream, module=_runtime('qc_borrowed_dump_failure')))
+    assert calls == [True] and isinstance(error, ValueError)
+    assert not stream.closed and stream.events == []
+
+
+def _borrowed_reader_contract(stream_class, entrypoint):
+    with _imported('qc_borrowed_reader_' + entrypoint) as module:
+        stream = stream_class(_payload(module))
+        result = (dill.load_module(stream) if entrypoint == 'load'
+                  else dill.load_module_asdict(stream))
+        assert (result.value if entrypoint == 'load' else result['value']) == 17
+        assert not stream.closed and stream.events == []
+
+
+def test_load_borrowed_peek_reader_remains_open():
+    _borrowed_reader_contract(_PeekStream, 'load')
+
+
+def test_asdict_borrowed_peek_reader_remains_open():
+    _borrowed_reader_contract(_PeekStream, 'asdict')
+
+
+def test_load_borrowed_seek_reader_remains_open():
+    _borrowed_reader_contract(_Stream, 'load')
+
+
+def test_asdict_borrowed_seek_reader_remains_open():
+    _borrowed_reader_contract(_Stream, 'asdict')
+
+
+def _bufferable_contract(entrypoint):
+    with _imported('qc_bufferable_reader_' + entrypoint) as module:
+        payload = _payload(module)
+        for stream_class in (_Bufferable, _BufferableTell, _BufferableSeek):
+            stream = stream_class(payload)
+            result = (dill.load_module(stream) if entrypoint == 'load'
+                      else dill.load_module_asdict(stream))
+            assert (result.value if entrypoint == 'load' else result['value']) == 17
+            assert stream.closed and stream.close_calls == 1
+
+
+def test_load_bufferable_reader_lifecycle():
+    _bufferable_contract('load')
+
+
+def test_asdict_bufferable_reader_lifecycle():
+    _bufferable_contract('asdict')
+
+
+def _owned_contract(entrypoint, operation_fails, close_fails):
+    name = 'qc_owned_' + entrypoint
+    module = _runtime(name)
+    key = '__runtime__.' + name
+    if entrypoint == 'asdict':
+        # Ownership is an existing imported-module behavior, independently of
+        # the newly clarified clean-runtime dictionary contract.
+        sys.modules[name] = module
+    stream = _Stream(b'' if entrypoint == 'dump' else _payload(module), close_fails)
+    original = session.Pickler.dump if entrypoint == 'dump' else session.Unpickler.load
+    def operation(serializer, *args):
+        stream.events.append('operation')
+        if entrypoint == 'load':
+            assert sys.modules.get(key) is module, 'loading must reach the temporary registration'
+        if operation_fails:
+            raise ValueError('owned operation failed')
+        return original(serializer, *args)
+    opener = '_safe_open_for_writing' if entrypoint == 'dump' else '_safe_open_for_reading'
+    serializer = session.Pickler if entrypoint == 'dump' else session.Unpickler
+    method = 'dump' if entrypoint == 'dump' else 'load'
+    try:
+        with patch.object(session, opener, lambda filename: stream), patch.object(serializer, method, operation):
+            def call():
+                if entrypoint == 'dump':
+                    return dill.dump_module('owned-session', module=module)
+                if entrypoint == 'load':
+                    return dill.load_module('owned-session', module=module)
+                return dill.load_module_asdict('owned-session')
+            error = _caught(call)
+        assert stream.events == ['operation', 'close'], stream.events
+        assert stream.closed
+        if close_fails:
+            assert isinstance(error, OSError) and str(error) == 'owned close failed'
+            if entrypoint == 'load':
+                assert sys.modules.get(key) is module, 'close failure preserves existing runtime registration'
+        elif operation_fails:
+            assert isinstance(error, ValueError) and str(error) == 'owned operation failed'
+            assert key not in sys.modules
+        else:
+            assert error is None, repr(error)
+            assert key not in sys.modules
+    finally:
+        sys.modules.pop(key, None)
+        if entrypoint == 'asdict':
+            sys.modules.pop(name, None)
+
