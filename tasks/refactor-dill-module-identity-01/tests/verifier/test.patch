+#!/usr/bin/env python
+"""Small, independent session persistence regression leaves.
+
+These checks exercise contract edges that are not covered by the baseline
+session smoke tests.  They intentionally use only the public session API.
+"""
+
+import os
+import sys
+import tempfile
+import types
+import warnings
+from io import BytesIO
+from pathlib import Path
+
+import dill
+
+
+def _payload(module, refimported=False):
+    stream = BytesIO()
+    assert dill.dump_module(stream, module=module, refimported=refimported) is None
+    return stream.getvalue()
+
+
+def test_public_roundtrip_return_forms():
+    target = types.ModuleType("p2p_public_roundtrip")
+    target.value = 17
+    data = _payload(target)
+    restored = dill.load_module(BytesIO(data))
+    assert restored.__name__ == target.__name__
+    assert restored.value == 17
+    destination = types.ModuleType(target.__name__)
+    assert dill.load_module(BytesIO(data), module=destination) is None
+    assert destination.value == 17
+
+
+def test_runtime_registration_cleanup():
+    target = types.ModuleType("p2p_runtime_cleanup")
+    target.value = 23
+    data = _payload(target)
+    key = "__runtime__." + target.__name__
+    assert key not in sys.modules
+    restored = dill.load_module(BytesIO(data))
+    assert restored.value == 23
+    assert key not in sys.modules
+
+
+def test_asdict_isolated_and_source_recorded():
+    target = types.ModuleType("p2p_asdict_isolated")
+    target.saved = object()
+    sys.modules[target.__name__] = target
+    try:
+        data = _payload(target)
+        before = dict(target.__dict__)
+        state = dill.load_module_asdict(BytesIO(data))
+    finally:
+        sys.modules.pop(target.__name__, None)
+    assert target.__dict__ == before
+    assert state["__name__"] == target.__name__
+    assert state["__session__"].startswith("<_io.BytesIO object at ")
+    assert state["saved"] is not target.saved
+
+
+def test_imported_module_reference_identity():
+    import calendar
+
+    target = types.ModuleType("p2p_imported_module")
+    target.calendar = calendar
+    sys.modules[target.__name__] = target
+    try:
+        state = dill.load_module_asdict(BytesIO(_payload(target, refimported=True)))
+    finally:
+        sys.modules.pop(target.__name__, None)
+    assert state["calendar"] is sys.modules["calendar"]
+
+
+def test_imported_alias_reference_identity():
+    from calendar import Calendar
+
+    target = types.ModuleType("p2p_imported_alias")
+    target.Calendar = Calendar
+    sys.modules[target.__name__] = target
+    try:
+        state = dill.load_module_asdict(BytesIO(_payload(target, refimported=True)))
+    finally:
+        sys.modules.pop(target.__name__, None)
+    assert state["Calendar"] is sys.modules["calendar"].Calendar
+
+
+def test_symlink_paths_are_rejected():
+    target = types.ModuleType("p2p_symlink")
+    with tempfile.TemporaryDirectory() as directory:
+        real = Path(directory) / "real.pkl"
+        link = Path(directory) / "link.pkl"
+        dill.dump_module(real, module=target)
+        link.symlink_to(real)
+        for function, kwargs in (
+            (dill.dump_module, {"module": target}),
+            (dill.load_module, {}),
+            (dill.load_module_asdict, {}),
+        ):
+            try:
+                function(link, **kwargs)
+            except OSError:
+                pass
+            else:
+                raise AssertionError(function.__name__ + " followed a symlink")
+
+
+def test_incompatible_module_name_is_rejected():
+    target = types.ModuleType("p2p_saved_name")
+    data = _payload(target)
+    wrong = types.ModuleType("p2p_other_name")
+    try:
+        dill.load_module(BytesIO(data), module=wrong)
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("incompatible module name was accepted")
+
+
+def test_non_module_target_is_rejected():
+    target = types.ModuleType("p2p_non_module")
+    try:
+        dill.load_module(BytesIO(_payload(target)), module=42)
+    except TypeError:
+        pass
+    else:
+        raise AssertionError("non-module target was accepted")
+
+
+def test_borrowed_stream_remains_open():
+    target = types.ModuleType("p2p_borrowed_stream")
+    stream = BytesIO(_payload(target))
+    dill.load_module(stream)
+    assert not stream.closed
+
+
+def test_legacy_aliases_preserve_behavior():
+    target = types.ModuleType("p2p_legacy")
+    stream = BytesIO()
+    with warnings.catch_warnings(record=True) as seen:
+        warnings.simplefilter("always")
+        assert dill.dump_module(stream, main=target, byref=False) is None
+    assert len(seen) == 2
+    assert all(item.category is PendingDeprecationWarning for item in seen)
+
+    # asdict historically forwards the legacy main alias to load_module.
+    # An explicit None selects the saved module without changing its source.
+    target.value = 17
+    sys.modules[target.__name__] = target
+    try:
+        data = _payload(target)
+        target.value = 99
+        before = dict(target.__dict__)
+        source = BytesIO(data)
+        with warnings.catch_warnings(record=True) as seen:
+            warnings.simplefilter("always")
+            state = dill.load_module_asdict(source, main=None)
+        assert state["value"] == 17 and state is not target.__dict__
+        assert state["__session__"] == str(source)
+        assert target.__dict__ == before and sys.modules[target.__name__] is target
+        assert not source.closed
+        assert len(seen) == 1 and seen[0].category is PendingDeprecationWarning
+        assert "'main' has been renamed 'module'" in str(seen[0].message)
+    finally:
+        sys.modules.pop(target.__name__, None)
+
+
+def test_default_path_emits_security_warning():
+    with warnings.catch_warnings(record=True) as seen:
+        warnings.simplefilter("always")
+        try:
+            dill.load_module()
+        except Exception:
+            pass
+    assert any(item.category is dill.session.SecurityWarning for item in seen)
