+# Source comparisons are restricted to reachable production responsibilities,
+# not diff size, identifier spellings, comments, test changes or a helper layout.
+class _ExecutableBody(ast.NodeTransformer):
+    def __init__(self, definition, production_names):
+        bindings = [arg.arg for arg in ast.walk(definition.args) if isinstance(arg, ast.arg)]
+        bindings += [node.id for node in ast.walk(definition) if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store)]
+        self.locals = {name: '_local_%d' % index for index, name in enumerate(dict.fromkeys(bindings))}
+        self.production_names = production_names
+
+    def visit_Name(self, node):
+        name = self.locals.get(node.id, '_production_callable' if node.id in self.production_names else node.id)
+        return ast.copy_location(ast.Name(id=name, ctx=node.ctx), node)
+
+    def visit_Expr(self, node):
+        return None if isinstance(node.value, ast.Constant) else self.generic_visit(node)
+
+    def visit_Pass(self, node):
+        return None
+
