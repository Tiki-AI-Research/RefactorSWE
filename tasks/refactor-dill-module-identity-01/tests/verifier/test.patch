+#!/usr/bin/env python
+"""Independent F2P leaves for session persistence."""
+
+import io
+import sys
+import tempfile
+import types
+import warnings
+from pathlib import Path
+
+import dill
+from dill import session
+
+
+def _module(name, imported=False):
+    module = types.ModuleType(name)
+    module.saved = [1, 2, 3]
+    if imported:
+        sys.modules[name] = module
+    return module
+
+
+def _payload(module, **kwargs):
+    stream = io.BytesIO()
+    dill.dump_module(stream, module=module, **kwargs)
+    return stream.getvalue()
+
+
+def _asdict(payload, source=None, **kwargs):
+    """Run asdict while making an unexpected exception an assertion failure."""
+    try:
+        if source is None:
+            return dill.load_module_asdict(io.BytesIO(payload), **kwargs)
+        return dill.load_module_asdict(source, **kwargs)
+    except BaseException as error:
+        assert False, "load_module_asdict raised %s: %s" % (type(error).__name__, error)
+
+
+def test_asdict_clean_runtime_state():
+    """An imported session loads into a clean independent dictionary."""
+    name = "f2p_clean_state"
+    module = _module(name, imported=True)
+    payload = _payload(module)
+    module.extra = "current"
+    try:
+        state = _asdict(payload, update=False)
+    finally:
+        sys.modules.pop(name, None)
+    assert state["__name__"] == name and state["saved"] == [1, 2, 3] and "extra" not in state
+
+
+def test_asdict_update_merges_runtime_prior_state():
+    """update=True includes state from the selected runtime module."""
+    name = "f2p_update_state"
+    module = _module(name)
+    payload = _payload(module)
+    module.extra = object()
+    key = "__runtime__." + name
+    sys.modules[key] = module
+    try:
+        state = _asdict(payload, update=True)
+    finally:
+        sys.modules.pop(key, None)
+    assert state["extra"] is module.extra
+
+
+def test_asdict_does_not_mutate_runtime_source():
+    """An isolated load leaves the caller's module namespace unchanged."""
+    name = "f2p_source_isolation"
+    module = _module(name, imported=True)
+    payload = _payload(module)
+    module.current = object()
+    before = dict(module.__dict__)
+    _asdict(payload)
+    assert module.__dict__ == before
+
+
+def test_asdict_self_reference_rebinds_to_copy():
+    """A self reference in the restored dictionary points at that copy."""
+    module = _module("f2p_self_reference", imported=True)
+    module.selfref = module
+    state = _asdict(_payload(module))
+    assert state["selfref"].__dict__ is state
+
+
+def test_asdict_namespace_reference_rebinds_to_copy():
+    """A saved module namespace reference points at the returned dictionary."""
+    module = _module("f2p_namespace_reference", imported=True)
+    module.namespace = module.__dict__
+    state = _asdict(_payload(module))
+    assert state["namespace"] is state
+
+
+def test_asdict_records_stream_source():
+    """The result records the caller's readable stream source."""
+    module = _module("f2p_stream_source", imported=True)
+    stream = io.BytesIO()
+    dill.dump_module(stream, module=module)
+    stream.seek(0)
+    state = _asdict(None, source=stream)
+    assert state["__session__"].startswith("<_io.BytesIO object at ")
+
+
+def test_asdict_imported_module_reference_identity():
+    """A referenced module is restored as the existing sys.modules object."""
+    module = _module("f2p_ref_module", imported=True)
+    module.calendar = __import__("calendar")
+    state = _asdict(_payload(module, refimported=True))
+    assert state["calendar"] is sys.modules["calendar"]
+
+
+def test_asdict_imported_alias_reference_identity():
+    """A recognized imported alias restores its source attribute identity."""
+    from calendar import Calendar
+    module = _module("f2p_ref_alias", imported=True)
+    module.Calendar = Calendar
+    state = _asdict(_payload(module, refimported=True))
+    assert state["Calendar"] is sys.modules["calendar"].Calendar
+
+
+def test_asdict_seekable_borrowed_stream_remains_open():
+    """A caller-owned readable stream remains open after asdict loading."""
+    module = _module("f2p_borrowed_asdict", imported=True)
+    stream = io.BytesIO(_payload(module))
+    _asdict(None, source=stream)
+    assert not stream.closed
+
+
+def test_asdict_runtime_failure_removes_registration():
+    """A failed runtime dictionary load removes its temporary registry entry."""
+    name = "f2p_failed_asdict"
+    module = _module(name, imported=True)
+    module.bad = type("Bad", (), {"__reduce__": lambda self: (int, ("bad",))})()
+    key = "__runtime__." + name
+    payload = _payload(module)
+    try:
+        try:
+            dill.load_module_asdict(io.BytesIO(payload))
+        except BaseException as error:
+            caught = error
+        else:
+            caught = None
+        present = key in sys.modules
+    finally:
+        sys.modules.pop(key, None)
+    assert isinstance(caught, ValueError) and not present
+
+
+def test_asdict_close_failure_keeps_close_error():
+    """An owned reader close error remains the observable exception."""
+    name = "f2p_asdict_close"
+    payload = _payload(_module(name))
+    key = "__runtime__." + name
+
+    class Reader(io.BytesIO):
+        def close(self):
+            super().close()
+            raise OSError("close failed")
+
+    reader = Reader(payload)
+    original = session._safe_open_for_reading
+    try:
+        session._safe_open_for_reading = lambda path: reader
+        try:
+            dill.load_module_asdict("owned-session")
+        except BaseException as error:
+            caught = error
+        else:
+            caught = None
+        replacement = sys.modules.get(key)
+    finally:
+        session._safe_open_for_reading = original
+        sys.modules.pop(key, None)
+        try:
+            io.BytesIO.close(reader)
+        except Exception:
+            pass
+    assert isinstance(caught, OSError)
+    # The runtime asdict replacement is cleaned by load_module before the
+    # outer reader close; the close exception itself is the observable oracle.
+
+
+def test_asdict_pathlike_source_roundtrip():
+    """A path-like source loads into an isolated runtime dictionary."""
+    name = "f2p_pathlike_asdict"
+    with tempfile.TemporaryDirectory() as directory:
+        path = Path(directory) / "session.pkl"
+        dill.dump_module(path, module=_module(name, imported=True))
+        state = _asdict(None, source=path)
+        sys.modules.pop(name, None)
+    assert state["__name__"] == name and state["saved"] == [1, 2, 3]
+
+
+def test_asdict_restores_refimported_object_after_cleanup():
+    """Reference restoration retains an imported object's identity."""
+    import html.entities
+    module = _module("f2p_ref_object", imported=True)
+    module.html5 = html.entities.html5
+    state = _asdict(_payload(module, refimported=True))
+    assert state["html5"] is html.entities.html5
+
+
+def test_asdict_rejects_module_keyword_before_path_open():
+    """The forbidden module keyword is rejected before opening a source path."""
+    called = []
+    original = session._safe_open_for_reading
+    session._safe_open_for_reading = lambda path: called.append(path)
+    try:
+        try:
+            dill.load_module_asdict("unused", module=types.ModuleType("x"))
+        except BaseException as error:
+            caught = error
+        else:
+            caught = None
+    finally:
+        session._safe_open_for_reading = original
+    assert isinstance(caught, TypeError) and not called
+
+
+def test_load_runtime_name_decodes_and_cleans_registration():
+    """load_module accepts the explicit runtime name form and cleans it."""
+    name = "f2p_load_runtime_name"
+    module = _module(name)
+    payload = _payload(module)
+    key = "__runtime__." + name
+    restored = dill.load_module(io.BytesIO(payload), module=key)
+    assert restored.__name__ == name and key not in sys.modules
+
+
+def test_load_rejects_runtime_saved_state_for_imported_target():
+    """An imported target cannot receive a runtime saved module."""
+    name = "f2p_kind_boundary"
+    payload = _payload(_module(name))
+    target = _module(name, imported=True)
+    try:
+        try:
+            dill.load_module(io.BytesIO(payload), module=target)
+        except ValueError as error:
+            caught = error
+        else:
+            caught = None
+    finally:
+        sys.modules.pop(name, None)
+    assert isinstance(caught, ValueError)
+
+
+def test_load_owned_reader_close_error_is_observable():
+    """An internally owned reader close failure remains the public exception."""
+    name = "f2p_load_close_error"
+    payload = _payload(_module(name))
+
+    class Reader(io.BytesIO):
+        def close(self):
+            super().close()
+            raise OSError("close failed")
+
+    reader = Reader(payload)
+    original = session._safe_open_for_reading
+    try:
+        session._safe_open_for_reading = lambda path: reader
+        try:
+            dill.load_module("owned-session")
+        except BaseException as error:
+            caught = error
+        else:
+            caught = None
+    finally:
+        session._safe_open_for_reading = original
+        sys.modules.pop("__runtime__." + name, None)
+        try:
+            io.BytesIO.close(reader)
+        except Exception:
+            pass
+    assert isinstance(caught, OSError)
+
+
+def test_general_unpickle_uses_runtime_registration_key():
+    """General dill.loads resolves the runtime key emitted by session dumps."""
+    name = "f2p_general_runtime_key"
+    payload = _payload(_module(name))
+    target = _module(name)
+    key = "__runtime__." + name
+    sys.modules[key] = target
+    try:
+        restored = dill.loads(payload)
+    finally:
+        sys.modules.pop(key, None)
+    assert restored is target
+
+
+def test_legacy_session_entry_points_preserve_return_contract():
+    """dump_session and load_session keep their None return contract."""
+    target = _module("f2p_legacy_contract")
+    stream = io.BytesIO()
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", PendingDeprecationWarning)
+        dumped = dill.dump_session(stream, main=target)
+        stream.seek(0)
+        loaded = dill.load_session(stream)
+    assert dumped is None and loaded is None and target.saved == [1, 2, 3]
