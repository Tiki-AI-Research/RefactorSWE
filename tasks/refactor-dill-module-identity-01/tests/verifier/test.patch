+def _source_inventory(root):
+    result = {}
+    for relative in ('dill/session.py', 'dill/_dill.py'):
+        tree = ast.parse((root / relative).read_text())
+        for node in tree.body:
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                result[node.name] = node
+            elif isinstance(node, ast.Assign) and isinstance(node.value, ast.Name) and node.value.id in result:
+                for target in node.targets:
+                    if isinstance(target, ast.Name):
+                        result[target.id] = result[node.value.id]
+            elif isinstance(node, ast.ClassDef):
+                for method in node.body:
+                    if isinstance(method, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                        result[node.name + '.' + method.name] = method
+    return result
+
+
+def _reachable_fingerprints(inventory, root_name):
+    pending, seen, result = [root_name], set(), set()
+    while pending:
+        name = pending.pop()
+        if name in seen or name not in inventory:
+            continue
+        seen.add(name)
+        definition = inventory[name]
+        # Parse a copy because normalization must not change call graph inputs.
+        copied = ast.parse(ast.unparse(definition)).body[0]
+        copied = _ExecutableBody(copied, {key.split('.')[0] for key in inventory}).visit(copied)
+        # The official task runtime is Python 3.10; preparation may use 3.12.
+        # Empty PEP 695 metadata must not count as a production change.
+        for node in ast.walk(copied):
+            if 'type_params' in node._fields:
+                node._fields = tuple(field for field in node._fields if field != 'type_params')
+        body = ast.dump(ast.Module(body=copied.body, type_ignores=[]), include_attributes=False)
+        transparent = (len(copied.body) == 1 and isinstance(copied.body[0], (ast.Return, ast.Expr))
+                       and isinstance(copied.body[0].value, ast.Call))
+        if not transparent:
+            result.add(hashlib.sha256(body.encode()).hexdigest())
+        references = {node.id for node in ast.walk(definition) if isinstance(node, ast.Name)}
+        pending.extend(references.intersection(inventory))
+        # Resolve methods conservatively without prescribing class names or
+        # requiring a particular state representation.
+        attributes = {node.attr for node in ast.walk(definition) if isinstance(node, ast.Attribute)}
+        for candidate in inventory:
+            if '.' in candidate and (candidate.split('.')[0] in references or candidate.rsplit('.', 1)[1] in attributes):
+                pending.append(candidate)
+    return sorted(result)
+
