+def _reader_failure_contract(stream_class, entrypoint, closes):
+    name = 'qc_failed_reader_' + entrypoint + '_' + stream_class.__name__
+    with _imported(name) as module:
+        module.failure = _ReaderFailure()
+        stream = stream_class(_payload(module))
+        _reader_failure_events.clear()
+        try:
+            operation = dill.load_module if entrypoint == 'load' else dill.load_module_asdict
+            error = _caught(lambda: operation(stream))
+            assert _reader_failure_events == ['load'], 'failure must occur in actual loading'
+            assert isinstance(error, ValueError) and str(error) == 'borrowed reader load failed'
+            assert not stream.closed, 'do not close a borrowed source while the failure traceback retains its adapter'
+            # The baseline buffers incomplete readable streams without taking
+            # explicit ownership. Their adapter is retained by the exception
+            # traceback and closes the raw source only when that trace is freed.
+            error.__traceback__ = None
+            gc.collect()
+            assert stream.closed is closes, 'preserve reader lifecycle after releasing the failure traceback'
+            if closes:
+                assert stream.close_calls == 1, 'buffered reader must close its source once'
+            else:
+                assert stream.events == [], 'borrowed peek/seek reader must not be closed'
+        finally:
+            _reader_failure_events.clear()
+
+
+def test_load_borrowed_peek_reader_failure_remains_open():
+    _reader_failure_contract(_PeekStream, 'load', False)
