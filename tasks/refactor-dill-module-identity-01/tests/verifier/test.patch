+
+def _run_one(selector):
+    path, name = selector.split('::', 1)
+    module = Path(path).stem
+    code = (
+        "import sys, traceback; sys.path.insert(0, 'dill/tests'); "
+        "\ntry:\n"
+        f"    import {module} as test_module\n"
+        "except BaseException:\n"
+        "    traceback.print_exc(); raise SystemExit(20)\n"
+        "try:\n"
+        f"    test_module.{name}()\n"
+        "except ImportError:\n"
+        "    traceback.print_exc(); raise SystemExit(20)\n"
+        "except BaseException as error:\n"
+        "    try:\n"
+        "        if isinstance(error, AssertionError): raise\n"
+        "        raise AssertionError('Unexpected test-body exception: %s: %s' % "
+        "(type(error).__name__, error)) from error\n"
+        "    except AssertionError:\n"
+        "        traceback.print_exc(); raise SystemExit(10)\n"
+    )
+    try:
+        result = subprocess.run([sys.executable, '-B', '-c', code], cwd=str(ROOT),
+                                text=True, capture_output=True, timeout=30)
+    except subprocess.TimeoutExpired as error:
+        return 'error', 'TimeoutExpired', 'process', str(error)
+    output = (result.stdout or '') + (result.stderr or '')
+    if result.returncode == 0:
+        return 'pass', '', 'test', output
+    if result.returncode == 10:
+        return 'failure', 'AssertionError', 'test', output
+    if result.returncode == 20:
+        return 'error', 'CollectionError', 'collection', output
+    return 'error', 'ProcessCrash', 'process', 'runner exit error %s\n%s' % (result.returncode, output)
+
+def main(report, selectors=SELECTORS):
+    records = [(selector, *_run_one(selector)) for selector in selectors]
+    failures = sum(record[1] == 'failure' for record in records)
+    errors = sum(record[1] == 'error' for record in records)
+    body = ['<?xml version="1.0" encoding="UTF-8"?>',
+            '<testsuite name="session-contract" tests="%d" failures="%d" errors="%d">' %
+            (len(records), failures, errors)]
+    for selector, status, outcome_type, phase, output in records:
+        classname, leaf = selector.split('::', 1)
+        body.append('<testcase classname="%s" name="%s">' %
+                    (html.escape(classname, quote=True), html.escape(leaf, quote=True)))
+        if status != 'pass':
+            body.append('<%s type="%s" phase="%s">%s</%s>' %
+                        (status, outcome_type, phase, html.escape(output), status))
+        body.append('</testcase>')
+    body.append('</testsuite>')
+    Path(report).write_text('\n'.join(body) + '\n', encoding='utf-8')
+    return 1 if failures or errors else 0
+
+if __name__ == '__main__':
+    if len(sys.argv) != 3 or sys.argv[1] != '--junit':
+        raise SystemExit('usage: f2p_runner.py --junit REPORT')
+    raise SystemExit(main(sys.argv[2]))
