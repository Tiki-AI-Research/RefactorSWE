+    def prepare(self, unpickler, file, module):
+        if not self.isolated:
+            self.saved_name = _identify_module(file, module)
+        main = module
+        if main is None:
+            main = self.main if self.isolated else self.saved_name
+        if isinstance(main, str):
+            main_name, is_runtime = _decode_module_name(main)
+            main = ModuleType(main_name) if is_runtime else _import_module(main)
+        if main is not None:
+            if not isinstance(main, ModuleType):
+                raise TypeError("%r is not a module" % main)
+            unpickler._main = main
+        else:
+            main = unpickler._main
+
+        # An isolated copy has the saved kind even before it is registered.
+        # Caller-selected targets retain their kind before any binding changes.
+        is_main_imported = self.is_main_imported if self.isolated and main is self.main \
+            else _is_imported_module(main)
+        if self.saved_name is not None:
+            pickle_main, is_runtime_mod = _decode_module_name(self.saved_name)
+            error_msg = "can't update{} module{} %r with the saved state of{} module{} %r"
+            if is_runtime_mod and is_main_imported:
+                raise ValueError(
+                    error_msg.format(" imported", "", "", "-type object")
+                    % (main.__name__, pickle_main)
+                )
+            if not is_runtime_mod and not is_main_imported:
+                raise ValueError(
+                    error_msg.format("", "-type object", " imported", "")
+                    % (pickle_main, main.__name__)
+                )
+            if main.__name__ != pickle_main:
+                raise ValueError(error_msg.format("", "", "", "") % (main.__name__, pickle_main))
+
+        if self.isolated:
+            unpickler._main = self.main
+            self.binding_name = self.saved_name
+            sys.modules[self.binding_name] = self.main
+        else:
+            self.main = main
+            self.is_main_imported = is_main_imported
+            if not is_main_imported:
+                self.runtime_name = _encode_module_name(main.__name__, is_runtime=True)
+                sys.modules[self.runtime_name] = main
+
+    def load(self, unpickler):
+        # _import_module resolves dotted imports through their parent. Bind
+        # that attribute for the duration of loading, just like sys.modules,
+        # without replacing the reducer function when it is saved as data.
+        parent = None
+        missing = _MISSING
+        namespace = None
+        child_name = None
+        had_child = None
+        old_child = None
+        parent_name = None
+        old_parent = missing
+        if self.isolated and self.is_main_imported and '.' in self.saved_name:
+            parent_name, _, child_name = self.saved_name.rpartition('.')
+            old_parent = sys.modules.get(parent_name, missing)
+            parent = old_parent
+            if parent is missing or parent is None:
+                parent = ModuleType(parent_name)
+                sys.modules[parent_name] = parent
+            namespace = vars(parent)
+            had_child = child_name in namespace
+            old_child = namespace.get(child_name)
+            namespace[child_name] = self.main
+        self._parent_binding = (parent, namespace if parent is not None else None,
+                                child_name if parent is not None else None,
+                                had_child if parent is not None else None,
+                                old_child if parent is not None else None,
+                                parent_name if parent is not None else None,
+                                old_parent)
+        return unpickler.load()
+
+    def restore_parent(self):
+        binding = getattr(self, '_parent_binding', None)
+        if binding is None:
+            return
+        parent, namespace, child_name, had_child, old_child, parent_name, old_parent = binding
+        if parent is not None:
+            if had_child:
+                namespace[child_name] = old_child
+            else:
+                namespace.pop(child_name, None)
+            if old_parent is _MISSING:
+                sys.modules.pop(parent_name, None)
+            elif old_parent is None:
+                sys.modules[parent_name] = None
+        self._parent_binding = None
+
+    def remove_runtime(self):
+        if self.runtime_name is not None:
+            sys.modules.pop(self.runtime_name, None)
+
+    def restore_binding(self):
+        if self.binding_name is not None:
+            if self.old_main is None:
+                sys.modules.pop(self.binding_name, None)
+            else:
+                sys.modules[self.binding_name] = self.old_main
+
+def _load_module(session_file, module, kwds, state):
+    try:
+        file = session_file.peekable()
+        #FIXME: dill.settings are disabled
+        unpickler = Unpickler(file, **kwds)
+        unpickler._session = True
+        state.prepare(unpickler, file, module)
+        loaded = state.load(unpickler)
+    except BaseException:
+        session_file.close()
+        state.restore_parent()
+        state.remove_runtime()
+        raise
+    else:
+        session_file.close()
+        state.remove_runtime()
+    try:
+        assert loaded is state.main
+        _restore_modules(unpickler, state.main)
+    finally:
+        # Keep a dotted imported target visible through reference restoration;
+        # restore its package attribute only after the target is complete.
+        state.restore_parent()
+    return state.main
