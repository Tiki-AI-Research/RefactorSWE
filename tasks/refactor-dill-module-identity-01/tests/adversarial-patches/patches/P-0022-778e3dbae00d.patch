+class _SessionUnpicklerState:
+    """Keep saved identity, target kind and binding ownership per load."""
+    def __init__(self):
+        self.saved_name = None
+        self.main = None
+        self.isolated = False
+        self.runtime_name = None
+        self.binding_name = None
