+    def isolate(self, file, update):
+        self.saved_name = _identify_module(file)
+        module_name, is_runtime = _decode_module_name(self.saved_name)
+        self.isolated = True
+        self.is_main_imported = not is_runtime
+        self.old_main = sys.modules.get(self.saved_name)
