+            ('isleap', 'calendar', 'isleap'), ('day_name', 'calendar', 'day_name'),
+            ('Dict', 'collections', 'UserDict'), ('AsyncCM', 'typing', 'AsyncContextManager')):
+        assert state[alias] is getattr(sys.modules[source], attribute)
+    assert state['unsupported_alias'] is not sys.modules['calendar'].month_name
+    assert list(state['unsupported_alias']) == list(sys.modules['calendar'].month_name)
+    assert state['selfref'].__dict__ is state
+    assert state['dictref'] is state
+    assert state['local'].__globals__ is state
+    assert state['local']() is sys.modules['calendar'].day_name
+    assert not any(name.startswith('__dill_imported') for name in state)
