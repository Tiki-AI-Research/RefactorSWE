+def test_load_lifecycle():
+    """Close precedes direct cleanup, but follows isolated reference repair."""
+    for isolated in (False, True):
+        loader = dill.load_module_asdict if isolated else dill.load_module
+        for imported in (False, True):
+            if imported and not isolated:
+                continue
+            target = module('session_lifecycle')
+            key = target.__name__ if imported else '__runtime__.' + target.__name__
+            with patch.dict(sys.modules):
+                if imported:
+                    sys.modules[key] = target
+                data = payload(target)
+                for had_old in (False, True):
+                    old = module('old_binding')
+                    for fail_load in (False, True):
+                        for fail_close in (False, True):
+                            for delete_during_load in (False, True):
+                                if had_old:
+                                    sys.modules[key] = old
+                                else:
+                                    sys.modules.pop(key, None)
+                                events = []
+                                load_error = RuntimeError('load failed')
+                                close_error = OSError('close failed') if fail_close else None
+                                stream = EventStream(data, events, close_error)
+                                bound = []
+                                original_load = session.Unpickler.load
+
+                                def load(unpickler):
+                                    events.append('load')
+                                    bound.append(sys.modules[key])
+                                    if delete_during_load:
+                                        del sys.modules[key]
+                                    if fail_load:
+                                        raise load_error
+                                    # Deletion may be performed by any reducer after
+                                    # the main module has already been constructed.
+                                    if delete_during_load:
+                                        sys.modules[key] = bound[-1]
+                                    result = original_load(unpickler)
+                                    if delete_during_load:
+                                        del sys.modules[key]
+                                    return result
+
+                                def restore(unpickler, main):
+                                    events.append('restore')
+                                    assert main is bound[0]
+                                    assert stream.closed is (not isolated)
+                                    assert (key in sys.modules) is (isolated and not delete_during_load)
+
+                                with patch.object(session, '_safe_open_for_reading', return_value=stream), \
+                                        patch.object(session.Unpickler, 'load', load), \
+                                        patch.object(session, '_restore_modules', restore):
+                                    if fail_close or fail_load:
+                                        with raises(OSError if fail_close else RuntimeError) as caught:
+                                            loader('owned.pkl')
+                                        assert caught.exception is (close_error or load_error)
+                                        if fail_close and fail_load:
+                                            assert caught.exception.__context__ is load_error
+                                    else:
+                                        state = loader('owned.pkl')
+                                        assert (state['value'] if isolated else state.value) == 42
+                                assert stream.closed and events.count('close') == 1
+                                assert events.index('load') < events.index('close')
+                                expect_restore = not fail_load and (isolated or not fail_close)
+                                assert ('restore' in events) is expect_restore
+                                if expect_restore:
+                                    assert (events.index('restore') < events.index('close')) is isolated
+                                if fail_close:
+                                    assert sys.modules.get(key) is (None if delete_during_load else bound[0])
+                                elif isolated and had_old:
+                                    assert sys.modules[key] is old
+                                else:
+                                    assert key not in sys.modules
+                                sys.modules.pop(key, None)
+
