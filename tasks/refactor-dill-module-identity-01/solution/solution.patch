+        key = '__runtime__.' + runtime.__name__
+        with raises(KeyError) as caught:
+            dill.load_module_asdict(BytesIO(runtime_data), update=True)
+        assert caught.exception.args == (key,) and key not in sys.modules
+        # None bindings retain their previous absent-state meaning.
+        with patch.dict(sys.modules, {key: None}):
+            dill.load_module_asdict(BytesIO(runtime_data))
+            assert key not in sys.modules
+        # Existing runtime state is selected only through its encoded key.
+        old = module(runtime.__name__)
+        old.value = 0
+        old.prior_only = []
+        with patch.dict(sys.modules, {key: old}):
+            state = dill.load_module_asdict(BytesIO(runtime_data), update=True)
+            assert state['value'] == 42 and state['prior_only'] is old.prior_only
+            assert old.value == 0 and sys.modules[key] is old
+
+        path = directory / 'source.pkl'
+        path.write_bytes(runtime_data)
+        for source in (str(path), path, BytesIO(runtime_data)):
+            state = dill.load_module_asdict(source)
+            assert state['__session__'] == str(source)
+        with patch.object(session, 'SESSION_TEMPFILE', str(path)):
+            with warnings.catch_warnings(record=True) as caught:
+                warnings.simplefilter('always')
+                state = dill.load_module_asdict()
+            assert state['__session__'] == str(path)
+            assert len(caught) == 1 and caught[0].category is session.SecurityWarning
+
+
+def test_filesystem_and_warnings():
+    target = module()
+    data = payload(target)
+    with temporary_directory() as directory:
+        real = directory / 'real.pkl'
+        link = directory / 'link.pkl'
+        missing = directory / 'missing.pkl'
+        real.write_bytes(data)
+        for destination in (real, missing):
+            link.symlink_to(destination.resolve())
+            try:
+                for function in (dill.dump_module, dill.load_module, dill.load_module_asdict):
+                    kwargs = {'module': target} if function is dill.dump_module else {}
+                    with raises(OSError):
+                        function(link, **kwargs)
+                    assert real.read_bytes() == data
+                    assert not missing.exists()
+            finally:
+                link.unlink()
+        created = directory / 'created.pkl'
+        dill.dump_module(created, module=target)
+        if os.name == 'posix':
+            assert stat.S_IMODE(created.stat().st_mode) == 0o600
+        created.write_bytes(data + b'extra' * 1000)
+        dill.dump_module(created, module=target)
+        assert created.read_bytes() == data
+        for loader in (dill.load_module, dill.load_module_asdict):
+            with raises(FileNotFoundError):
+                loader(missing)
+        # Atomically enforced refusal after lstat succeeds, for all entrypoints.
+        if hasattr(os, 'O_NOFOLLOW'):
+            for function in (dill.dump_module, dill.load_module, dill.load_module_asdict):
+                created.write_bytes(data)
+                original_lstat = os.lstat
+                swapped = []
+
+                def racing_lstat(path, *args, **kwargs):
+                    result = original_lstat(path, *args, **kwargs)
+                    if Path(path) == created and not swapped:
+                        created.unlink()
+                        created.symlink_to(real.resolve())
+                        swapped.append(True)
+                    return result
+
+                with patch.object(os, 'lstat', racing_lstat):
+                    with raises(OSError):
+                        function(created, **({'module': target} if function is dill.dump_module else {}))
+                assert swapped and real.read_bytes() == data
+                created.unlink()
+        for function in (dill.dump_module, dill.load_module, dill.load_module_asdict):
+            kwargs = {'module': target} if function is dill.dump_module else {}
+            opener_name = '_safe_open_for_writing' if function is dill.dump_module else '_safe_open_for_reading'
+            with patch.object(session, 'SESSION_TEMPFILE', str(real)):
+                # Explicit default paths and borrowed streams never warn.
+                for source in (str(real), BytesIO(data)):
+                    with warnings.catch_warnings(record=True) as caught:
+                        warnings.simplefilter('always')
+                        function(source, **kwargs)
+                    assert caught == []
+                with warnings.catch_warnings(record=True) as caught:
+                    warnings.simplefilter('always')
+                    caller_line = sys._getframe().f_lineno + 1
+                    function(**kwargs)
+                assert len(caught) == 1
+                warning = caught[0]
+                assert warning.category is session.SecurityWarning
+                assert str(warning.message) == session._DEFAULT_PATH_WARNING
+                assert warning.filename == __file__ and warning.lineno == caller_line
+                failure = OSError('open failed')
+                with warnings.catch_warnings(record=True) as caught:
+                    warnings.simplefilter('always')
+
+                    def fail_open(path):
+                        assert len(caught) == 1  # warning is observable before open
+                        raise failure
+
+                    with patch.object(session, opener_name, fail_open):
+                        with raises(OSError) as error:
+                            caller_line = sys._getframe().f_lineno + 1
+                            function(**kwargs)
+                    assert error.exception is failure
+                assert len(caught) == 1 and caught[0].category is session.SecurityWarning
+                assert str(caught[0].message) == session._DEFAULT_PATH_WARNING
+                assert caught[0].filename == __file__ and caught[0].lineno == caller_line
+
+
+def test_save_load_public_contract():
+    assert list(inspect.signature(dill.dump_module).parameters) == ['filename', 'module', 'refimported', 'kwds']
+    assert list(inspect.signature(dill.load_module).parameters) == ['filename', 'module', 'kwds']
+    assert list(inspect.signature(dill.load_module_asdict).parameters) == ['filename', 'update', 'kwds']
+    for function in (dill.dump_module, dill.load_module, dill.load_module_asdict):
+        signature = inspect.signature(function)
+        assert signature.parameters['filename'].default is None
+        if function is not dill.load_module_asdict:
+            assert signature.parameters['module'].default is None
+        else:
+            assert signature.parameters['update'].default is False
+    assert inspect.signature(dill.dump_module).parameters['refimported'].default is False
+
+    with temporary_directory() as directory, patch.dict(sys.modules):
+        imported = module('session_named')
+        sys.modules[imported.__name__] = imported
+        for name in ('session_runtime', 'package.runtime', '__runtime__', '__runtime__.nested.name'):
+            runtime = module(name)
+            for source_module in (imported, imported.__name__, runtime):
+                target = imported if isinstance(source_module, str) else source_module
+                for destination in (directory / 'contract.pkl', BytesIO()):
+                    assert dill.dump_module(destination, module=source_module) is None
+                    data = destination.getvalue() if isinstance(destination, BytesIO) else destination.read_bytes()
+                    encoded = name if target is imported else '__runtime__.' + name
+                    for selected in (None, target, target.__name__ if target is imported else encoded):
+                        result = dill.load_module(BytesIO(data), module=selected)
+                        if selected is target:
+                            assert result is None
+                        else:
+                            assert result.value == 42 and result.__name__ == target.__name__
+                            if target is imported:
+                                assert result is imported
+                        if target is runtime:
+                            assert '__runtime__.' + name not in sys.modules
+                    if target is runtime and name == 'session_runtime':
+                        with raises(ModuleNotFoundError):
+                            dill.load_module(BytesIO(data), module=name)
+        target = module('session_settings')
+        target.selfref = target
+        target.dictref = vars(target)
+        exec('def local(): return value', vars(target))
+        from calendar import day_name
+        target.day_name = day_name
+        original_settings = dill.settings.copy()
+        for protocol in (2, pickle.HIGHEST_PROTOCOL):
+            for refimported in (False, True):
+                captured = []
+                original_dump = session.Pickler.dump
+
+                def dump(pickler, obj):
+                    captured.append((pickler.proto, pickler._byref, pickler._recurse, pickler.fast))
+                    return original_dump(pickler, obj)
+
+                with patch.dict(dill.settings, protocol=protocol, byref=True, recurse=True):
+                    with patch.object(session.Pickler, 'dump', dump), \
+                            patch.object(session, 'Pickler', wraps=session.Pickler) as pickler_type:
+                        stream = BytesIO()
+                        dill.dump_module(stream, module=target, refimported=refimported, recurse=True, fmode=dill.CONTENTS_FMODE)
+                        assert pickler_type.call_args.args == (stream, protocol)
+                        assert pickler_type.call_args.kwargs == {'recurse': True, 'fmode': dill.CONTENTS_FMODE}
+                    assert captured == [(protocol, False, False, 0)]
+                    assert stream.getvalue()[:2] == b'\x80' + bytes([protocol])
+                    for loader in (dill.load_module, dill.load_module_asdict):
+                        restored = loader(BytesIO(stream.getvalue()))
+                        state = restored if isinstance(restored, dict) else vars(restored)
+                        assert state['selfref'].__dict__ is state and state['dictref'] is state
+                        assert state['local'].__globals__ is state and state['local']() == 42
+                        assert (state['day_name'] is day_name) is refimported
+                assert dill.settings == original_settings
+        # A duplicate protocol remains a constructor error after opening.
+        stream = EventStream()
+        with raises(TypeError):
+            dill.dump_module(stream, module=target, protocol=2)
+        assert not stream.closed
+
+
+if __name__ == '__main__':
+    if len(sys.argv) == 3 and sys.argv[1] == '--references':
+        for loader in (dill.load_module, dill.load_module_asdict):
+            restored = loader(sys.argv[2])
+            check_references(restored if isinstance(restored, dict) else vars(restored))
+    else:
+        for name, test in list(globals().items()):
+            if name.startswith('test_'):
+                test()
