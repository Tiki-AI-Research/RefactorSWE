+    target = module('session_references')
+    target.calendar = calendar
+    target.url = urllib
+    target.sax = sax
+    target.dom = xml.dom.minidom
+    target.Calendar = target.Alias = calendar.Calendar
+    target.isleap = calendar.isleap
+    target.Dict = collections.UserDict
+    target.AsyncCM = typing.AsyncContextManager
+    target.day_name = calendar.day_name
+    target.selfref = target
+    target.dictref = vars(target)
+    exec('def local(): return day_name', vars(target))
+    # Name lookup recognizes this list, but arbitrary list aliases must remain
+    # by value. The source is importable in the subprocess as well.
+    target.unsupported_alias = calendar.month_name
+    before = vars(target).copy()
+    data = payload(target, refimported=True)
