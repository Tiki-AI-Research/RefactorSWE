+def module(name='session_contract_runtime'):
+    result = ModuleType(name)
+    result.value = 42
+    return result
+
+
+def payload(target, **kwds):
+    stream = BytesIO()
+    assert dill.dump_module(stream, module=target, **kwds) is None
+    assert not stream.closed
+    return stream.getvalue()
+
+
+class EventStream(BytesIO):
+    def __init__(self, data=b'', events=None, close_error=None):
+        super().__init__(data)
+        self.events = [] if events is None else events
+        self.close_error = close_error
+
+    def read(self, n=-1):
+        self.events.append('read')
+        return super().read(n)
+
+    def write(self, data):
+        self.events.append('write')
+        return super().write(data)
+
+    def tell(self):
+        self.events.append('tell')
+        return super().tell()
+
+    def seek(self, *args):
+        self.events.append('seek')
+        return super().seek(*args)
+
+    def flush(self):
+        self.events.append('flush')
+        return super().flush()
+
+    def close(self):
+        self.events.append('close')
+        super().close()
+        if self.close_error is not None:
+            raise self.close_error
+
+
+class PeekStream(EventStream):
+    def peek(self, n):
+        self.events.append('peek')
+        position = BytesIO.tell(self)
+        return self.getvalue()[position:position+n]
+
+
+class UnseekableStream(EventStream):
+    def tell(self):
+        self.events.append('tell')
+        raise OSError('not seekable')
+
+
+class BufferableStream:
+    """Accepted duck-typed raw stream lacking tell/seek and peek."""
+    def __init__(self, data):
+        self.inner = BytesIO(data)
+        self.events = []
+
+    @property
+    def closed(self):
+        return self.inner.closed
+
+    def readable(self):
+        return True
+
+    def read(self, n=-1):
+        self.events.append('read')
+        return self.inner.read(n)
+
+    def readinto(self, buffer):
+        self.events.append('readinto')
+        return self.inner.readinto(buffer)
+
+    def close(self):
+        self.events.append('close')
+        self.inner.close()
+
+
+def test_import_function_data():
+    """Reducer functions used as ordinary data retain identity and semantics."""
+    for name in ('session_helper', 'session_helper.child', 'unloaded_parent.child'):
+        target = module(name)
+        target.helper = dill._dill._import_module
+        target.helpers = [target.helper, {'again': target.helper}]
+        parent = ModuleType(name.partition('.')[0])
+        parent.child = target
+        bindings = {name: target}
+        if name == 'session_helper.child':
+            bindings[parent.__name__] = parent
+        with patch.dict(sys.modules, bindings):
+            data = payload(target)
+            target.value = 0
+            before = target.__dict__.copy()
+            loaders = (dill.load_module_asdict,) if name == 'unloaded_parent.child' \
+                else (dill.load_module_asdict, dill.load_module)
+            for loader in loaders:
+                restored = loader(BytesIO(data))
+                state = restored if isinstance(restored, dict) else vars(restored)
+                assert state['helper'] is dill._dill._import_module
+                assert state['helpers'][0] is state['helpers'][1]['again'] is state['helper']
+                if name == 'unloaded_parent.child':
+                    with raises(ModuleNotFoundError):
+                        state['helper'](name)
+                else:
+                    assert state['helper'](name) is target
+                if loader is dill.load_module_asdict:
+                    assert target.__dict__ == before
+                assert sys.modules[name] is target
+                if '.' in name:
+                    assert parent.child is target
+            if name == 'unloaded_parent.child':
+                assert 'unloaded_parent' not in sys.modules
