+def test_runtime_module_identity():
+    from types import ModuleType
+    from dill.session import _identify_module, _make_peekable
+    name = '__runtime__.package.child'
+    saved_name = '__runtime__.' + name
+    runtime = ModuleType(name)
+    runtime.__file__ = None  # exercise the generic reducer's state-saving branch
+    runtime.x = 42
+    runtime.selfref = runtime
+    exec('def local(): return x', runtime.__dict__)
+    stream = BytesIO()
+    dill.dump_module(stream, module=runtime)
+    assert _identify_module(_make_peekable(BytesIO(stream.getvalue()))) == saved_name
+
+    restored = dill.load_module(BytesIO(stream.getvalue()), module=saved_name)
+    assert restored.__name__ == name
+    assert restored.x == 42 and restored.selfref is restored
+    state = dill.load_module_asdict(BytesIO(stream.getvalue()))
+    assert state['__name__'] == name and state['x'] == 42
+    assert state['selfref'].__dict__ is state
+    assert state['local'].__globals__ is state
+    assert state['local']() == 42
+    assert saved_name not in sys.modules
+
+    payload = dill.dumps(runtime)
+    assert _identify_module(_make_peekable(BytesIO(payload))) == saved_name
+    target = ModuleType(name)
+    sys.modules[saved_name] = target
+    try:
+        assert dill.loads(payload) is target
+        assert target.__name__ == name and target.x == 42
+        assert target.selfref is target
+    finally:
+        del sys.modules[saved_name]
