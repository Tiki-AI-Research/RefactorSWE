+def test_borrowed_streams():
+    target = module()
+    data = payload(target)
+    for loader in (dill.load_module, dill.load_module_asdict):
+        for stream_type in (EventStream, PeekStream, BufferableStream):
+            for broken in (False, True):
+                stream = stream_type(b'not a pickle' if broken else data)
+                if broken:
+                    with raises(dill.UnpicklingError):
+                        loader(stream)
+                else:
+                    loader(stream)
+                gc.collect()  # BufferedReader retains its established ownership.
+                assert stream.closed is (stream_type is BufferableStream)
+                assert ('close' in stream.events) is (stream_type is BufferableStream)
+                if stream_type is PeekStream:
+                    assert stream.events[0] == 'peek'
+                    assert 'tell' not in stream.events and 'seek' not in stream.events
+                elif stream_type is EventStream:
+                    assert stream.events[:5] == ['flush', 'tell', 'seek', 'read', 'seek']
+                stream.close()
+    # An explicit target enables the existing no-peek fallback.
+    for broken in (False, True):
+        stream = UnseekableStream(data[:-1] if broken else data)
+        if broken:
+            with raises(dill.UnpicklingError):
+                dill.load_module(stream, module=target)
+        else:
+            assert dill.load_module(stream, module=target) is None
+        assert not stream.closed and 'close' not in stream.events
+        assert '__runtime__.' + target.__name__ not in sys.modules
+        stream.close()
+    stream = UnseekableStream(data)
+    with raises(dill.UnpicklingError) as caught:
+        dill.load_module(stream)
+    assert isinstance(caught.exception.__cause__, NotImplementedError)
+    assert not stream.closed
+    stream.close()
+    for broken in (False, True):
+        stream = EventStream()
+        with patch.object(session.Pickler, 'dump', side_effect=dill.PicklingError('bad')) if broken \
+                else patch.object(session, 'Pickler', wraps=session.Pickler):
+            if broken:
+                with raises(dill.PicklingError):
+                    dill.dump_module(stream, module=target)
+            else:
+                dill.dump_module(stream, module=target)
+        assert not stream.closed and 'close' not in stream.events
+        stream.close()
