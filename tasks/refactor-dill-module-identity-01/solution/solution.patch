+def test_dump_lifecycle():
+    target = module()
+    for fail_dump in (False, True):
+        for fail_close in (False, True):
+            events = []
+            dump_error = dill.PicklingError('dump failed')
+            close_error = OSError('close failed') if fail_close else None
+            stream = EventStream(events=events, close_error=close_error)
+            original_dump = session.Pickler.dump
+
+            def dump(pickler, obj):
+                events.append('dump')
+                if fail_dump:
+                    raise dump_error
+                return original_dump(pickler, obj)
+
+            with patch.object(session, '_safe_open_for_writing', return_value=stream), \
+                    patch.object(session.Pickler, 'dump', dump):
+                if fail_dump or fail_close:
+                    with raises(OSError if fail_close else dill.PicklingError) as caught:
+                        dill.dump_module('owned.pkl', module=target)
+                    assert caught.exception is (close_error or dump_error)
+                    if fail_dump and fail_close:
+                        assert caught.exception.__context__ is dump_error
+                else:
+                    assert dill.dump_module('owned.pkl', module=target) is None
+            assert events[0] == 'dump' and events[-1] == 'close'
+            assert stream.closed and events.count('close') == 1
