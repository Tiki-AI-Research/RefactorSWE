+        (dill.dump_module, {'module': target, 'refimported': True, 'byref': True}, "both 'refimported' and 'byref'"),
+        (dill.load_module, {'module': target, 'main': target}, "both 'module' and 'main'"),
+        (dill.load_module, {'module': False, 'main': target}, "both 'module' and 'main'"),
+    ]
