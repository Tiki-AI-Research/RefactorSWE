diff --git a/__tests__/p2p/typescript-compat.mjs b/__tests__/p2p/typescript-compat.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1e2b99d2f380207875c7eb2c3aa0fa8b1f762c5e
--- /dev/null
+++ b/__tests__/p2p/typescript-compat.mjs
@@ -0,0 +1,121 @@
+// Shared Node module-customization helpers used by the asynchronous loader
+// hooks of the supplemental harness and by the synchronous hooks of the
+// original-test engine.
+//
+// Two rewrites are required to execute the production TypeScript sources in a
+// replay image that only ships the Node.js runtime (no node_modules, no
+// network):
+//   1. the repository imports its own modules with a `.js` extension while the
+//      files on disk are `.ts`, so relative `./x.js` specifiers are redirected
+//      to `./x.ts` when only the TypeScript file exists;
+//   2. Node's syntax-only TypeScript transform keeps plain named imports
+//      verbatim, so a module that imports an interface with `import {X}` fails
+//      to link. The load hook appends a runtime placeholder export for every
+//      type-only declaration that has no runtime counterpart, which keeps such
+//      imports linkable while leaving the production source untouched.
+/* global URL, Buffer */
+import {existsSync} from 'node:fs';
+import {fileURLToPath} from 'node:url';
+
+// Returns the `.ts` URL for a relative `./x.js` specifier when the matching
+// JavaScript file does not exist, or null when no rewrite is required.
+export function resolveTypeScriptSpecifier(specifier, parentURL) {
+  const isRelative = specifier.startsWith('./') || specifier.startsWith('../');
+  if (!isRelative || !specifier.endsWith('.js') || !parentURL) {
+    return null;
+  }
+  const javascriptUrl = new URL(specifier, parentURL);
+  const typescriptUrl = new URL(
+    `${specifier.slice(0, -'.js'.length)}.ts`,
+    parentURL
+  );
+  if (
+    existsSync(fileURLToPath(typescriptUrl)) &&
+    !existsSync(fileURLToPath(javascriptUrl))
+  ) {
+    return typescriptUrl.href;
+  }
+  return null;
+}
+
+function collectRuntimeExports(source) {
+  const names = new Set();
+  const declaration = new RegExp(
+    '(?:^|[\\n;])\\s*export\\s+(?:declare\\s+)?(?:async\\s+)?(?:const|let|var|function|class|enum|namespace)\\s+([A-Za-z_$][\\w$]*)',
+    'g'
+  );
+  for (const match of source.matchAll(declaration)) {
+    names.add(match[1]);
+  }
+  const exportList = new RegExp(
+    '(?:^|[\\n;])\\s*export\\s*\\{([^}]*)\\}(?!\\s*from)',
+    'g'
+  );
+  for (const match of source.matchAll(exportList)) {
+    for (const entry of match[1].split(',')) {
+      const specifier = entry.trim();
+      if (!specifier || specifier.startsWith('type ')) {
+        continue;
+      }
+      const alias = /\bas\s+([A-Za-z_$][\w$]*)$/.exec(specifier);
+      names.add(alias ? alias[1] : specifier);
+    }
+  }
+  const exportFrom = new RegExp(
+    '(?:^|[\\n;])\\s*export\\s*\\{([^}]*)\\}\\s*from\\b',
+    'g'
+  );
+  for (const match of source.matchAll(exportFrom)) {
+    for (const entry of match[1].split(',')) {
+      const specifier = entry.trim();
+      if (!specifier || specifier.startsWith('type ')) {
+        continue;
+      }
+      const alias = /\bas\s+([A-Za-z_$][\w$]*)$/.exec(specifier);
+      names.add(alias ? alias[1] : specifier);
+    }
+  }
+  return names;
+}
+
+function collectTypeExports(source) {
+  const names = new Set();
+  const patterns = [
+    /(?:^|[\n;])\s*export\s+(?:declare\s+)?interface\s+([A-Za-z_$][\w$]*)/g,
+    /(?:^|[\n;])\s*export\s+(?:declare\s+)?type\s+([A-Za-z_$][\w$]*)\s*[=<]/g,
+    /(?:^|[\n;])\s*export\s+declare\s+(?:const|let|var|function|class|enum|namespace)\s+([A-Za-z_$][\w$]*)/g,
+    /(?:^|[\n;])\s*export\s+type\s*\{([^}]*)\}/g,
+    /(?:^|[\n;])\s*export\s*\{([^}]*\btype\s+[A-Za-z_$][\w$]*[^}]*)\}/g
+  ];
+  for (const pattern of patterns) {
+    for (const match of source.matchAll(pattern)) {
+      const body = match[1];
+      const candidates =
+        body.includes(',') || body.includes(' as ') ? body.split(',') : [body];
+      for (const candidate of candidates) {
+        const specifier = candidate.trim().replace(/^type\s+/, '');
+        if (!specifier) {
+          continue;
+        }
+        const alias = /\bas\s+([A-Za-z_$][\w$]*)$/.exec(specifier);
+        names.add(alias ? alias[1] : specifier.trim());
+      }
+    }
+  }
+  return names;
+}
+
+export function patchTypeOnlyImports(source) {
+  const runtimeExports = collectRuntimeExports(source);
+  const typeExports = collectTypeExports(source);
+  const missing = [...typeExports].filter(
+    name => /^[A-Za-z_$][\w$]*$/.test(name) && !runtimeExports.has(name)
+  );
+  if (!missing.length) {
+    return source;
+  }
+  const placeholders = missing
+    .map(name => `export const ${name} = undefined;`)
+    .join('\n');
+  return `${source}\n// P2P loader placeholder for type-only exports.\n${placeholders}\n`;
+}
diff --git a/__tests__/p2p/main-cache-p2p.test.mjs b/__tests__/p2p/main-cache-p2p.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7bff665aea4accabcf74204927088102db3fc491
--- /dev/null
+++ b/__tests__/p2p/main-cache-p2p.test.mjs
@@ -0,0 +1,105 @@
+// Direct main-entry regression tests: installation is outside this task's
+// scope, but the cache feature gate, restore call and catch are real code.
+import assert from 'node:assert/strict';
+import cp from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {syncBuiltinESMExports} from 'node:module';
+import {test} from './harness.mjs';
+import * as core from './stubs/actions-core.mjs';
+import * as cache from './stubs/actions-cache.mjs';
+import * as exec from './stubs/actions-exec.mjs';
+import * as glob from './stubs/actions-glob.mjs';
+import * as io from './stubs/actions-io.mjs';
+
+const {run} = await import('../../src/main.js');
+
+async function runMain({enabled, available, restoreError = null}) {
+  core.__reset();
+  cache.__reset();
+  exec.__reset();
+  glob.__reset();
+  io.__reset();
+  core.__setBooleanInput('cache', enabled);
+  core.__setInput('cache-dependency-path', 'explicit/go.sum');
+  cache.__setFeatureAvailable(available);
+  cache.__setRestoreImpl(async () => {
+    if (restoreError) throw new Error(restoreError);
+    return '';
+  });
+  glob.__setHashFilesImpl(async () => 'main-cache-hash');
+  exec.__setExecImpl(async command => {
+    assert.ok(['go env GOMODCACHE', 'go env GOCACHE'].includes(command));
+    return {exitCode: 0, stdout: `/cache/${command.endsWith('GOMODCACHE') ? 'mod' : 'build'}\n`, stderr: ''};
+  });
+  io.__setWhichImpl(async tool => {
+    assert.equal(tool, 'go');
+    return 'go';
+  });
+
+  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), 'setup-go-main-p2p-'));
+  const environment = {
+    RUNNER_OS: 'Linux', ImageOS: 'ubuntu-22.04',
+    GITHUB_WORKSPACE: workspace, GOTOOLCHAIN: undefined
+  };
+  const saved = Object.fromEntries(Object.keys(environment).map(key => [key, process.env[key]]));
+  const realExecSync = cp.execSync;
+  cp.execSync = command => {
+    if (command === 'go env GOPATH') return Buffer.from(`${workspace}\n`);
+    if (command === 'go version') return Buffer.from('go version go1.21.13 linux/amd64\n');
+    if (command === 'go env') return Buffer.from('GOCACHE="/cache/build"\n');
+    throw new Error(`unexpected process command in a cache wiring test: ${command}`);
+  };
+  syncBuiltinESMExports();
+  try {
+    for (const [key, value] of Object.entries(environment)) {
+      if (value === undefined) delete process.env[key];
+      else process.env[key] = value;
+    }
+    await run();
+    assert.equal(core.__calls('setFailed').length, 0, 'cache handling must not fail the workflow');
+    assert.ok(core.__calls('setOutput').some(call =>
+      call.args[0] === 'go-version' && call.args[1] === '1.21.13'),
+    'main must finish its normal version output after cache handling');
+    assert.equal(core.__calls('endGroup').length, 1,
+      'main must finish its normal go env output after cache handling');
+  } finally {
+    cp.execSync = realExecSync;
+    syncBuiltinESMExports();
+    for (const [key, value] of Object.entries(saved)) {
+      if (value === undefined) delete process.env[key];
+      else process.env[key] = value;
+    }
+    fs.rmSync(workspace, {recursive: true, force: true});
+  }
+}
+
+test('main skips restore when the cache input is disabled', async () => {
+  await runMain({enabled: false, available: true});
+  assert.equal(cache.__calls('restoreCache').length, 0);
+  assert.equal(exec.__calls('getExecOutput').length, 0);
+});
+
+test('main skips restore when caching is enabled but the feature is unavailable', async () => {
+  await runMain({enabled: true, available: false});
+  assert.equal(cache.__calls('restoreCache').length, 0);
+  assert.equal(exec.__calls('getExecOutput').length, 0);
+});
+
+test('main restores only when caching is enabled and the feature is available', async () => {
+  await runMain({enabled: true, available: true});
+  const calls = cache.__calls('restoreCache');
+  assert.equal(calls.length, 1);
+  assert.deepEqual(calls[0].args, [
+    ['/cache/mod', '/cache/build'],
+    `setup-go-Linux-${process.arch}-ubuntu-22.04-go-1.21.13-main-cache-hash`
+  ]);
+  assert.deepEqual(glob.__calls('hashFiles')[0].args, ['explicit/go.sum']);
+});
+
+test('main warns on a restore failure and completes the workflow outputs', async () => {
+  await runMain({enabled: true, available: true, restoreError: 'cache service unavailable'});
+  assert.equal(cache.__calls('restoreCache').length, 1);
+  assert.ok(core.__messages('warning').includes('Restore cache failed: cache service unavailable'));
+});
