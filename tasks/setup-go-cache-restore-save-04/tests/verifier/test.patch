+// P2P runner for the cache consolidation task.
+//
+// Usage (the pipeline substitutes the placeholders):
+//   node --experimental-transform-types --no-warnings __tests__/p2p/run-p2p.mjs \
+//     --report {report} --select {p2p_select} --config {config}
+//
+// Two engines feed one regular JUnit report:
+//   * jest-engine.mjs executes the Baseline original test files restored
+//     through `restoration_paths` with the dependency-free Jest-compatible
+//     runtime in this directory, so the report carries the actual
+//     collected/executed assertion result of every `original_inventory`
+//     selector even though the replay image ships no node_modules;
+//   * the dependency-free harness in this directory executes the supplemental
+//     P2P nodes through the local module hooks (see loader-hooks.mjs).
+//
+// The runner itself only uses the Node.js runtime, files inside this
+// repository and the dependencies already present in the image: no network, no
+// package installation.
+/* global process, console, URL, setTimeout, clearTimeout */
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {spawnSync} from 'node:child_process';
+import {register} from 'node:module';
+import {fileURLToPath} from 'node:url';
+
+import {TEST_FILES} from './manifest.mjs';
+import {ORIGINAL_TEST_FILES} from './original-inventory.mjs';
+import {
+  errorResult,
+  recordUncaught,
+  registeredNodes,
+  runNode,
+  setCurrentFile,
+  writeJUnit
+} from './harness.mjs';
+
+const DEFAULT_NODE_TIMEOUT_MS = 10000;
+const DEFAULT_ORIGINAL_TIMEOUT_MS = 60000;
+const IMPORT_TIMEOUT_MS = 15000;
+const PLACEHOLDER = /\{[a-zA-Z0-9_]+\}/;
+
+function parseArguments(argv) {
+  const options = {report: null, select: null, config: null};
+  const names = {report: 'report', select: 'select', config: 'config'};
+  for (let index = 0; index < argv.length; index += 1) {
+    const argument = argv[index];
+    const withEquals = /^--(report|select|config)=(.*)$/.exec(argument);
+    if (withEquals) {
+      options[names[withEquals[1]]] = withEquals[2];
+      continue;
+    }
+    const name = argument.startsWith('--') ? argument.slice(2) : null;
+    if (name && Object.prototype.hasOwnProperty.call(names, name)) {
+      options[names[name]] = argv[index + 1] ?? null;
+      index += 1;
+    }
+  }
+  return options;
+}
+
+function resolveReportPath(value) {
+  if (!value || PLACEHOLDER.test(value)) {
+    return path.join(process.cwd(), 'p2p-report.xml');
+  }
+  return path.isAbsolute(value) ? value : path.resolve(process.cwd(), value);
+}
+
+function resolveTemporaryDirectory(reportPath) {
+  const candidates = [
+    process.env.TMPDIR,
+    os.tmpdir(),
+    path.dirname(reportPath)
+  ];
+  for (const candidate of candidates) {
+    if (!candidate) {
+      continue;
+    }
+    try {
+      fs.accessSync(candidate, fs.constants.W_OK);
+      return candidate;
+    } catch {
+      // try the next candidate
+    }
+  }
+  return path.dirname(reportPath);
+}
+
+function readJsonFile(filePath) {
+  if (!filePath || PLACEHOLDER.test(filePath)) {
+    return null;
+  }
+  try {
+    const resolved = path.isAbsolute(filePath)
+      ? filePath
+      : path.resolve(process.cwd(), filePath);
+    if (!fs.existsSync(resolved) || !fs.statSync(resolved).isFile()) {
+      return null;
+    }
+    return JSON.parse(fs.readFileSync(resolved, 'utf8'));
+  } catch {
+    return null;
+  }
+}
+
+function collectSelectorRows(value, rows = []) {
+  if (Array.isArray(value)) {
+    for (const item of value) {
+      collectSelectorRows(item, rows);
+    }
+    return rows;
+  }
+  if (value && typeof value === 'object') {
+    if (typeof value.selector === 'string' && value.selector.includes('::')) {
+      rows.push(value);
+    }
+    for (const item of Object.values(value)) {
+      collectSelectorRows(item, rows);
+    }
+  }
+  return rows;
+}
+
+function collectStringArrays(value, key, matches = []) {
+  if (Array.isArray(value)) {
+    for (const item of value) {
+      collectStringArrays(item, key, matches);
+    }
+    return matches;
+  }
+  if (value && typeof value === 'object') {
+    for (const [entryKey, item] of Object.entries(value)) {
+      if (entryKey === key && Array.isArray(item)) {
+        matches.push(item);
+      }
+      collectStringArrays(item, key, matches);
+    }
+  }
+  return matches;
+}
+
+// The materialized {config} is the plan declaration; when it carries the
+// original inventory it is the source of truth for the restored original test
+// files. The static manifest keeps the same leaves available when the
+// placeholder is not substituted (for example during local runs).
+function originalFilesFromConfig(config) {
+  if (!config) {
+    return null;
+  }
+  const restorationPaths = new Set(
+    collectStringArrays(config, 'restoration_paths')
+      .flat()
+      .filter(entry => typeof entry === 'string')
+  );
+  const rows = collectSelectorRows(config).filter(row =>
+    restorationPaths.has(row.selector.split('::')[0])
+  );
+  if (!rows.length) {
+    return null;
+  }
+  const files = new Map();
+  for (const row of rows) {
+    const [filePath, leaf] = row.selector.split('::');
+    if (!filePath || !leaf) {
+      continue;
+    }
+    if (!files.has(filePath)) {
+      files.set(filePath, []);
+    }
+    if (!files.get(filePath).includes(leaf)) {
+      files.get(filePath).push(leaf);
+    }
+  }
+  if (!files.size) {
+    return null;
+  }
+  const declaredOrder = [...restorationPaths];
+  const ordered = [...files.keys()].sort((left, right) => {
+    const leftIndex = declaredOrder.indexOf(left);
+    const rightIndex = declaredOrder.indexOf(right);
+    if (leftIndex === -1 || rightIndex === -1) {
+      return left.localeCompare(right);
+    }
+    return leftIndex - rightIndex;
+  });
+  return ordered.map(filePath => ({path: filePath, nodes: files.get(filePath)}));
+}
+
+// The declared plan is the source of truth; the static inventory keeps every
+// collected Baseline node in the run even when the materialized config only
+// carries part of the declaration. Files and leaves are deduplicated, keeping
+// the declared order first and the manifest order for the remaining nodes.
+function mergeOriginalFiles(configured, declared) {
+  const files = new Map();
+  const addFile = (filePath, nodes) => {
+    if (!files.has(filePath)) {
+      files.set(filePath, []);
+    }
+    const leaves = files.get(filePath);
+    for (const leaf of nodes) {
+      if (!leaves.includes(leaf)) {
+        leaves.push(leaf);
+      }
+    }
+  };
+  for (const file of configured ?? []) {
+    addFile(file.path, file.nodes);
+  }
+  for (const file of declared) {
+    addFile(file.path, file.nodes);
+  }
+  return [...files.entries()].map(([filePath, nodes]) => ({
+    path: filePath,
+    nodes
+  }));
+}
+
+function selectorsFromText(text) {
+  const trimmed = text.trim();
+  if (!trimmed) {
+    return [];
+  }
+  if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
+    try {
+      return collectSelectorRows(JSON.parse(trimmed)).map(row => row.selector);
+    } catch {
+      // fall through to line based parsing
+    }
+  }
+  return trimmed
+    .split(/\r?\n/)
+    .map(line => line.trim())
+    .filter(line => line && !line.startsWith('#'))
+    .map(line => line.replace(/\s+#.*$/, '').trim())
+    .filter(line => line.includes('::'));
+}
+
+function readSelection(selectPath) {
+  if (!selectPath || PLACEHOLDER.test(selectPath)) {
+    return {selectors: [], source: null};
+  }
+  const resolved = path.isAbsolute(selectPath)
+    ? selectPath
+    : path.resolve(process.cwd(), selectPath);
+  if (!fs.existsSync(resolved) || !fs.statSync(resolved).isFile()) {
+    return {selectors: [], source: null};
+  }
+  return {
+    selectors: selectorsFromText(fs.readFileSync(resolved, 'utf8')),
+    source: resolved
+  };
+}
+
+// Executes one restored Baseline original test file through the
+// dependency-free Jest-compatible engine in this directory. The engine writes
+// one structured assertion result per exact leaf; a missing leaf, a crashed
+// engine or a timeout is surfaced as a failed node instead of being dropped
+// from the report.
+function runOriginalFile(
+  repoRoot,
+  scriptDirectory,
+  file,
+  temporaryDirectory,
+  timeoutMs
+) {
+  const enginePath = path.join(scriptDirectory, 'jest-engine.mjs');
+  const nodeTimeoutMs = Number(
+    process.env.P2P_NODE_TIMEOUT_MS ?? DEFAULT_NODE_TIMEOUT_MS
+  );
+  const resultsFile = path.join(
+    temporaryDirectory,
+    `setup-go-p2p-original-${process.pid}-${Date.now()}-${path.basename(file.path)}.json`
+  );
+  let payload = null;
+  let failureReason = null;
+  let log = '';
+
+  try {
+    const completed = spawnSync(
+      process.execPath,
+      [
+        '--experimental-transform-types',
+        '--no-warnings',
+        enginePath,
+        '--file',
+        file.path,
+        '--out',
+        resultsFile,
+        '--timeout',
+        String(nodeTimeoutMs)
+      ],
+      {
+        cwd: repoRoot,
+        env: {...process.env},
+        encoding: 'utf8',
+        timeout: timeoutMs,
+        maxBuffer: 32 * 1024 * 1024
+      }
+    );
+    log = `${completed.stdout ?? ''}${completed.stderr ?? ''}`.trim();
+    if (completed.error) {
+      failureReason = completed.error;
+    } else if (completed.status !== 0) {
+      failureReason = new Error(
+        `the original-test engine exited with code ${completed.status} for ${file.path}`
+      );
+    }
+  } catch (error) {
+    failureReason = error;
+  }
+
+  try {
+    if (fs.existsSync(resultsFile)) {
+      payload = JSON.parse(fs.readFileSync(resultsFile, 'utf8'));
+    }
+  } catch (error) {
+    failureReason = failureReason ?? error;
+  } finally {
+    try {
+      if (fs.existsSync(resultsFile)) {
+        fs.unlinkSync(resultsFile);
+      }
+    } catch {
+      // leaving the temporary file behind is harmless
+    }
+  }
+
+  const observed = new Map(
+    (payload?.results ?? [])
+      .filter(result => typeof result.name === 'string')
+      .map(result => [result.name, result])
+  );
+  const collectionError = payload?.collectionErrors?.[0];
+  const results = [];
+  for (const leaf of file.nodes) {
+    const observedResult = observed.get(leaf);
+    if (observedResult) {
+      results.push({
+        file: file.path,
+        name: leaf,
+        status: observedResult.status,
+        message: observedResult.message ?? '',
+        details: observedResult.details ?? '',
+        type: observedResult.type ?? '',
+        durationMs: observedResult.durationMs ?? 0
+      });
+      continue;
+    }
+    const reason =
+      failureReason ??
+      (collectionError
+        ? new Error(
+            `the original test file ${file.path} failed to load: ${collectionError.message}`
+          )
+        : new Error(
+            `the original-test engine did not observe the node ${file.path}::${leaf}`
+          ));
+    results.push(errorResult(file.path, leaf, reason));
+  }
+
+  const unexpected = [...observed.keys()].filter(
+    name => !file.nodes.includes(name)
+  );
+  if (unexpected.length) {
+    log = `${log}\n[p2p] engine reported unexpected nodes for ${file.path}: ${unexpected.join(', ')}`.trim();
+  }
+
+  return {
+    results,
+    infrastructureError: failureReason,
+    log
+  };
+}
+
+function runOriginalTests(repoRoot, scriptDirectory, originalFiles, reportPath) {
+  const temporaryDirectory = resolveTemporaryDirectory(reportPath);
+  const timeoutMs = Number(
+    process.env.P2P_ORIGINAL_TIMEOUT_MS ?? DEFAULT_ORIGINAL_TIMEOUT_MS
+  );
+  const results = [];
+  const logs = [];
+  let infrastructureError = null;
+
+  for (const file of originalFiles) {
+    const run = runOriginalFile(
+      repoRoot,
+      scriptDirectory,
+      file,
+      temporaryDirectory,
+      timeoutMs
+    );
+    results.push(...run.results);
+    if (run.log) {
+      logs.push(run.log);
+    }
+    if (run.infrastructureError) {
+      infrastructureError = infrastructureError ?? run.infrastructureError;
+    }
+  }
+
+  return {
+    results,
+    infrastructureError,
+    log: logs.join('\n')
+  };
+}
+
+async function loadSupplementalNodes(scriptDirectory) {
+  const errors = new Map();
+  const originalExit = process.exit;
+  // The post-step module runs itself on import. A regression can make that
+  // module-level call terminate the process before any node is collected, so
+  // exits are absorbed during the import phase and reported through the
+  // affected nodes instead of killing the runner.
+  process.exit = () => {};
+  try {
+    for (const file of TEST_FILES) {
+      setCurrentFile(file.path);
+      try {
+        await withImportTimeout(
+          import(new URL(`./${path.basename(file.path)}`, `file://${scriptDirectory}/`)),
+          file.path
+        );
+      } catch (error) {
+        errors.set(file.path, error);
+      }
+    }
+  } finally {
+    process.exit = originalExit;
+  }
+  return errors;
+}
+
+async function withImportTimeout(importPromise, file) {
+  let timer = null;
+  try {
+    return await Promise.race([
+      importPromise,
+      new Promise((_resolve, reject) => {
+        timer = setTimeout(() => {
+          reject(new Error(`import of ${file} timed out`));
+        }, IMPORT_TIMEOUT_MS);
+      })
+    ]);
+  } finally {
+    if (timer) {
+      clearTimeout(timer);
+    }
+  }
+}
+
+function expectedSupplementalNodes(importErrors) {
+  const nodes = [];
+  for (const file of TEST_FILES) {
+    const registered = registeredNodes().get(file.path) ?? [];
+    const byName = new Map(registered.map(node => [node.name, node]));
+    for (const name of file.nodes) {
+      const node = byName.get(name);
+      if (node && !importErrors.has(file.path)) {
+        nodes.push({file: file.path, name, fn: node.fn});
+      } else {
+        nodes.push({
+          file: file.path,
+          name,
+          fn: null,
+          importError:
+            importErrors.get(file.path) ??
+            new Error(`node is not registered by ${file.path}`)
+        });
+      }
+    }
+  }
+  return nodes;
+}
+
+function normalizeSelector(selector) {
+  const separator = selector.indexOf('::');
+  if (separator === -1) {
+    return {path: selector.replace(/\\/g, '/'), leaf: ''};
+  }
+  let selectorPath = selector.slice(0, separator).replace(/\\/g, '/');
+  if (selectorPath.startsWith('./')) {
+    selectorPath = selectorPath.slice(2);
+  }
+  return {path: selectorPath, leaf: selector.slice(separator + 2)};
+}
+
+async function main() {
+  const scriptDirectory = path.dirname(fileURLToPath(import.meta.url));
+  const repoRoot = path.resolve(scriptDirectory, '..', '..');
+  const options = parseArguments(process.argv.slice(2));
+  const reportPath = resolveReportPath(options.report);
+  const nodeTimeoutMs = Number(
+    process.env.P2P_NODE_TIMEOUT_MS ?? DEFAULT_NODE_TIMEOUT_MS
+  );
+
+  const config = readJsonFile(options.config);
+  const originalFiles = mergeOriginalFiles(
+    originalFilesFromConfig(config),
+    ORIGINAL_TEST_FILES
+  );
+  const selection = readSelection(options.select);
+
+  const originalRun = runOriginalTests(
+    repoRoot,
+    scriptDirectory,
+    originalFiles,
+    reportPath
+  );
+  if (originalRun.log) {
+    console.log(originalRun.log);
+  }
+
+  register('./loader-hooks.mjs', import.meta.url);
+  const importErrors = await loadSupplementalNodes(scriptDirectory);
+  const supplementalNodes = expectedSupplementalNodes(importErrors);
+
+  const results = [...originalRun.results];
+  for (const node of supplementalNodes) {
+    if (!node.fn) {
+      results.push(errorResult(node.file, node.name, node.importError));
+      continue;
+    }
+    results.push(await runNode(node, nodeTimeoutMs));
+  }
+
+  const declaredSelectors = new Set([
+    ...originalFiles.flatMap(file =>
+      file.nodes.map(leaf => `${file.path}::${leaf}`)
+    ),
+    ...TEST_FILES.flatMap(file => file.nodes.map(leaf => `${file.path}::${leaf}`))
+  ]);
+  for (const selector of selection.selectors) {
+    const normalized = normalizeSelector(selector);
+    const declared = [...declaredSelectors].some(candidate => {
+      const candidateNormalized = normalizeSelector(candidate);
+      return (
+        candidateNormalized.leaf === normalized.leaf &&
+        (candidateNormalized.path === normalized.path ||
+          normalized.path.endsWith(`/${candidateNormalized.path}`))
+      );
+    });
+    if (!declared) {
+      results.push(
+        errorResult(
+          normalized.path,
+          normalized.leaf || selector,
+          new Error(
+            `selected P2P node is not declared by this runner: ${selector}`
+          )
+        )
+      );
+    }
+  }
+
+  writeJUnit(reportPath, results);
+
+  const failed = results.filter(result => result.status !== 'passed');
+  const selectionLabel = selection.source
+    ? `${selection.selectors.length} selected from ${selection.source}`
+    : `all ${declaredSelectors.size} declared nodes`;
+  console.log(
+    `[p2p] ran ${results.length} node(s) (${selectionLabel}); ${results.length - failed.length} passed, ${failed.length} failed`
+  );
+  for (const result of failed) {
+    console.log(`[p2p] FAIL ${result.file}::${result.name}: ${result.message}`);
+  }
+  console.log(`[p2p] JUnit report written to ${reportPath}`);
+
+  if (originalRun.infrastructureError) {
+    console.error(
+      `[p2p] original-test engine unavailable: ${originalRun.infrastructureError.message}`
+    );
+    process.exitCode = 1;
+  }
+}
+
+process.on('uncaughtException', error => {
+  recordUncaught(error);
+});
+process.on('unhandledRejection', error => {
+  recordUncaught(error instanceof Error ? error : new Error(String(error)));
+});
+
+try {
+  await main();
+} catch (error) {
+  // The report is the only evidence the pipeline can consume, so a runner
+  // failure is surfaced through a non-zero exit code instead of a silent exit.
+  console.error(
+    `[p2p] runner failed before writing the report: ${error?.stack ?? error}`
+  );
+  process.exitCode = 1;
+}
diff --git a/__tests__/p2p/stubs/actions-cache.mjs b/__tests__/p2p/stubs/actions-cache.mjs
