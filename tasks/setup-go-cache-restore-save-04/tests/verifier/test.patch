+
+test('restore hashes the existing default dependency file inside the workspace', async () => {
+  const workspace = makeDirectory();
+  const dependencyPath = path.join(workspace, 'go.mod');
+  fs.writeFileSync(dependencyPath, 'module example.test/cache\n');
