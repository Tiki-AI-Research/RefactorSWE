@@ -0,0 +1,50 @@
+// Dependency-free stand-in for @actions/cache used by the P2P runner.
+import {nextSeq} from './call-log.mjs';
+
+const state = {
+  restoreImpl: async () => '',
+  saveImpl: async () => 0,
+  featureAvailable: true,
+  calls: []
+};
+
+function record(name, args) {
+  state.calls.push({name, args, seq: nextSeq()});
+}
+
+export function __reset() {
+  state.restoreImpl = async () => '';
+  state.saveImpl = async () => 0;
+  state.featureAvailable = true;
+  state.calls.length = 0;
+}
+
+export function __setRestoreImpl(fn) {
+  state.restoreImpl = fn;
+}
+
+export function __setSaveImpl(fn) {
+  state.saveImpl = fn;
+}
+
+export function __setFeatureAvailable(value) {
+  state.featureAvailable = value;
+}
+
+export function __calls(name) {
+  return state.calls.filter(call => call.name === name);
+}
+
+export async function restoreCache(paths, key) {
+  record('restoreCache', [paths, key]);
+  return await state.restoreImpl(paths, key);
+}
+
+export async function saveCache(paths, key) {
+  record('saveCache', [paths, key]);
+  return await state.saveImpl(paths, key);
+}
+
+export function isFeatureAvailable() {
+  return state.featureAvailable;
+}
diff --git a/__tests__/p2p/stubs/actions-core.mjs b/__tests__/p2p/stubs/actions-core.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2cd1420ddeb5c9387982e6839111a20aa487e806
--- /dev/null
+++ b/__tests__/p2p/stubs/actions-core.mjs
@@ -0,0 +1,141 @@
+// Dependency-free stand-in for @actions/core used by the P2P runner. It records
+// every call so the P2P nodes can assert on the observable contract of the
+// production cache entry points without the real toolkit being installed.
+import {nextSeq} from './call-log.mjs';
+
+const state = {
+  booleans: new Map(),
+  inputs: new Map(),
+  states: new Map(),
+  calls: []
+};
+
+function record(name, args) {
+  state.calls.push({name, args, seq: nextSeq()});
+}
+
+export function __reset() {
+  state.booleans.clear();
+  state.inputs.clear();
+  state.states.clear();
+  state.calls.length = 0;
+}
+
+export function __setBooleanInput(name, value) {
+  state.booleans.set(name, value);
+}
+
+export function __setInput(name, value) {
+  state.inputs.set(name, value);
+}
+
+export function __setState(name, value) {
+  state.states.set(name, value);
+}
+
+export function __calls(name) {
+  return state.calls.filter(call => call.name === name);
+}
+
+export function __allCalls() {
+  return state.calls;
+}
+
+export function __messages(name) {
+  return state.calls
+    .filter(call => call.name === name)
+    .map(call => String(call.args[0]));
+}
+
+export function info(...args) {
+  record('info', args);
+}
+
+export function warning(...args) {
+  record('warning', args);
+}
+
+export function debug(...args) {
+  record('debug', args);
+}
+
+export function error(...args) {
+  record('error', args);
+}
+
+export function notice(...args) {
+  record('notice', args);
+}
+
+export function setFailed(...args) {
+  record('setFailed', args);
+}
+
+export function setOutput(...args) {
+  record('setOutput', args);
+}
+
+export function saveState(...args) {
+  record('saveState', args);
+}
+
+export function exportVariable(...args) {
+  record('exportVariable', args);
+}
+
+export function addPath(...args) {
+  record('addPath', args);
+}
+
+export function setSecret(...args) {
+  record('setSecret', args);
+}
+
+export function startGroup(...args) {
+  record('startGroup', args);
+}
+
+export function endGroup(...args) {
+  record('endGroup', args);
+}
+
+export function getMultilineInput(...args) {
+  record('getMultilineInput', args);
+  return [];
+}
+
+export function getState(name) {
+  record('getState', [name]);
+  return state.states.get(name) ?? '';
+}
+
+export function getInput(name) {
+  record('getInput', [name]);
+  return state.inputs.get(name) ?? '';
+}
+
+export function getBooleanInput(name) {
+  record('getBooleanInput', [name]);
+  return state.booleans.get(name) ?? false;
+}
