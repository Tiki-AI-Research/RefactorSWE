diff --git a/__tests__/f2p/typescript-compat.mjs b/__tests__/f2p/typescript-compat.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f160919c621b372d6a555b5c6aa9be742ad2e54b
--- /dev/null
+++ b/__tests__/f2p/typescript-compat.mjs
@@ -0,0 +1,119 @@
+// F2P-local copy of the dependency-free TypeScript module helpers.
+//
+// The replay image ships the Node.js runtime only (no node_modules, no
+// network), so the production TypeScript sources are executed through Node's
+// `--experimental-transform-types` transform. Two rewrites are required:
+//   1. the repository imports its own modules with a `.js` extension while the
+//      files on disk are `.ts`, so relative `./x.js` specifiers are redirected
+//      to `./x.ts` when only the TypeScript file exists;
+//   2. Node's syntax-only transform keeps plain named imports verbatim, so a
+//      module that imports an interface with `import {X}` fails to link. The
+//      load hook appends a runtime placeholder export for every type-only
+//      declaration that has no runtime counterpart, leaving production source
+//      untouched.
+/* global URL, Buffer */
+import {existsSync} from 'node:fs';
+import {fileURLToPath} from 'node:url';
+
+// Returns the `.ts` URL for a relative `./x.js` specifier when the matching
+// JavaScript file does not exist, or null when no rewrite is required.
+export function resolveTypeScriptSpecifier(specifier, parentURL) {
+  const isRelative = specifier.startsWith('./') || specifier.startsWith('../');
+  if (!isRelative || !specifier.endsWith('.js') || !parentURL) {
+    return null;
+  }
+  const javascriptUrl = new URL(specifier, parentURL);
+  const typescriptUrl = new URL(
+    `${specifier.slice(0, -'.js'.length)}.ts`,
+    parentURL
+  );
+  if (
+    existsSync(fileURLToPath(typescriptUrl)) &&
+    !existsSync(fileURLToPath(javascriptUrl))
+  ) {
+    return typescriptUrl.href;
+  }
+  return null;
+}
+
+function collectRuntimeExports(source) {
+  const names = new Set();
+  const declaration = new RegExp(
+    '(?:^|[\\n;])\\s*export\\s+(?:declare\\s+)?(?:async\\s+)?(?:const|let|var|function|class|enum|namespace)\\s+([A-Za-z_$][\\w$]*)',
+    'g'
+  );
+  for (const match of source.matchAll(declaration)) {
+    names.add(match[1]);
+  }
+  const exportList = new RegExp(
+    '(?:^|[\\n;])\\s*export\\s*\\{([^}]*)\\}(?!\\s*from)',
+    'g'
+  );
+  for (const match of source.matchAll(exportList)) {
+    for (const entry of match[1].split(',')) {
+      const specifier = entry.trim();
+      if (!specifier || specifier.startsWith('type ')) {
+        continue;
+      }
+      const alias = /\bas\s+([A-Za-z_$][\w$]*)$/.exec(specifier);
+      names.add(alias ? alias[1] : specifier);
+    }
+  }
+  const exportFrom = new RegExp(
+    '(?:^|[\\n;])\\s*export\\s*\\{([^}]*)\\}\\s*from\\b',
+    'g'
+  );
+  for (const match of source.matchAll(exportFrom)) {
+    for (const entry of match[1].split(',')) {
+      const specifier = entry.trim();
+      if (!specifier || specifier.startsWith('type ')) {
+        continue;
+      }
+      const alias = /\bas\s+([A-Za-z_$][\w$]*)$/.exec(specifier);
+      names.add(alias ? alias[1] : specifier);
+    }
+  }
+  return names;
+}
+
+function collectTypeExports(source) {
+  const names = new Set();
+  const patterns = [
+    /(?:^|[\n;])\s*export\s+(?:declare\s+)?interface\s+([A-Za-z_$][\w$]*)/g,
+    /(?:^|[\n;])\s*export\s+(?:declare\s+)?type\s+([A-Za-z_$][\w$]*)\s*[=<]/g,
+    /(?:^|[\n;])\s*export\s+declare\s+(?:const|let|var|function|class|enum|namespace)\s+([A-Za-z_$][\w$]*)/g,
+    /(?:^|[\n;])\s*export\s+type\s*\{([^}]*)\}/g,
+    /(?:^|[\n;])\s*export\s*\{([^}]*\btype\s+[A-Za-z_$][\w$]*[^}]*)\}/g
+  ];
+  for (const pattern of patterns) {
+    for (const match of source.matchAll(pattern)) {
+      const body = match[1];
+      const candidates =
+        body.includes(',') || body.includes(' as ') ? body.split(',') : [body];
+      for (const candidate of candidates) {
+        const specifier = candidate.trim().replace(/^type\s+/, '');
+        if (!specifier) {
+          continue;
+        }
+        const alias = /\bas\s+([A-Za-z_$][\w$]*)$/.exec(specifier);
+        names.add(alias ? alias[1] : specifier.trim());
+      }
+    }
+  }
+  return names;
+}
+
+export function patchTypeOnlyImports(source) {
+  const runtimeExports = collectRuntimeExports(source);
+  const typeExports = collectTypeExports(source);
+  const missing = [...typeExports].filter(
+    name => /^[A-Za-z_$][\w$]*$/.test(name) && !runtimeExports.has(name)
+  );
+  if (!missing.length) {
+    return source;
+  }
+  const placeholders = missing
+    .map(name => `export const ${name} = undefined;`)
+    .join('\n');
+  return `${source}\n// F2P loader placeholder for type-only exports.\n${placeholders}\n`;
+}
