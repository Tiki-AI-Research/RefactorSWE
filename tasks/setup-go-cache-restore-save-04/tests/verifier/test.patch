--- /dev/null
+++ b/__tests__/f2p/ownership.mjs
@@ -0,0 +1,94 @@
+// Runtime delegation-chain helpers for the F2P cache-context nodes.
+//
+// The consolidation obligations are structural: one cohesive cache context has
+// to own package manager resolution, cache folder discovery, on-disk existence
+// reporting, primary key derivation and the cross-step cache state, and both
+// consumers have to route those responsibilities through it. The public
+// entry-point behaviour is unchanged by the consolidation, so the F2P nodes
+// observe *who performs each responsibility* by capturing the call stack at
+// the toolkit boundary (the stubs in ./stubs) and reading the production
+// modules out of the delegation chain. No production module name is assumed:
+// the nodes only compare the modules that the recorded chains actually prove.
+/* global process, URL */
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+
+const MODULE_DIRECTORY = path.dirname(fileURLToPath(import.meta.url));
+
+export const REPO_ROOT = path.resolve(MODULE_DIRECTORY, '..', '..');
+
+export const RESTORE_ENTRY = 'src/cache-restore.ts';
+export const SAVE_ENTRY = 'src/cache-save.ts';
+
+const NON_PRODUCTION_SEGMENTS = [
+  '/__tests__/',
+  '/node_modules/',
+  '/dist/',
+  '/.git/'
+];
+
+const FRAME_LOCATION = /\(?((?:file:\/\/)?\/[^()\s]+?):(\d+):(\d+)\)?\s*$/;
+
+function framePath(line) {
+  const match = FRAME_LOCATION.exec(String(line).trim());
+  if (!match) {
+    return null;
+  }
+  const location = match[1];
+  if (location.startsWith('file://')) {
+    try {
+      return fileURLToPath(location);
+    } catch {
+      return null;
+    }
+  }
+  return location;
+}
+
+function toRepositoryPath(absolutePath) {
+  const relative = path.relative(REPO_ROOT, absolutePath);
+  if (!relative || relative.startsWith('..') || path.isAbsolute(relative)) {
+    return null;
+  }
+  return relative.split(path.sep).join('/');
+}
+
+// Ordered, de-duplicated list of production modules in a captured stack. Test
+// fixtures, stubs, node_modules and build output are ignored so only the
+// modules that own production responsibilities remain.
+export function productionChain(stack) {
+  const chain = [];
+  for (const line of String(stack ?? '').split('\n')) {
+    const absolute = framePath(line);
+    if (!absolute) {
+      continue;
+    }
+    const repositoryPath = toRepositoryPath(absolute);
+    if (!repositoryPath) {
+      continue;
+    }
+    const normalizedPath = `/${repositoryPath}`;
+    if (
+      NON_PRODUCTION_SEGMENTS.some(segment =>
+        normalizedPath.includes(segment)
+      )
+    ) {
+      continue;
+    }
+    if (!chain.includes(repositoryPath)) {
+      chain.push(repositoryPath);
+    }
+  }
+  return chain;
+}
+
+
+export function intersection(left, right) {
+  return left.filter(module => right.includes(module));
+}
+
+export function formatChains(chains) {
+  return Object.entries(chains)
+    .map(([label, chain]) => `${label}=[${chain.join(', ')}]`)
+    .join('; ');
+}
diff --git a/__tests__/f2p/run-f2p.mjs b/__tests__/f2p/run-f2p.mjs
