diff --git a/__tests__/p2p/harness.mjs b/__tests__/p2p/harness.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..15aff4624d1d4eee6676367349b71247d9ea814b
--- /dev/null
+++ b/__tests__/p2p/harness.mjs
@@ -0,0 +1,205 @@
+// Minimal dependency-free test harness for the supplemental P2P nodes.
+//
+// It provides just enough machinery to register exact-leaf test nodes, execute
+// them with a per-node timeout, and emit a regular JUnit report. Assertions are
+// the Node.js built-in `node:assert/strict` module, so no third-party test
+// framework is required in the replay image.
+/* global setTimeout, clearTimeout */
+import fs from 'node:fs';
+import path from 'node:path';
+
+const registry = new Map();
+let currentFile = null;
+let ignoreUncaught = false;
+let pendingUncaught = null;
+
+export function setCurrentFile(file) {
+  currentFile = file;
+}
+
+export function test(name, fn) {
+  if (!currentFile) {
+    throw new Error('setCurrentFile() must be called before test()');
+  }
+  if (!registry.has(currentFile)) {
+    registry.set(currentFile, []);
+  }
+  registry.get(currentFile).push({file: currentFile, name, fn});
+}
+
+export function registeredNodes() {
+  return registry;
+}
+
+export function setIgnoreUncaught(value) {
+  ignoreUncaught = value;
+}
+
+export function recordUncaught(error) {
+  if (ignoreUncaught) {
+    return;
+  }
+  pendingUncaught = error;
+}
+
+function describeError(error) {
+  if (error instanceof Error) {
+    return {
+      message: error.message,
+      details: error.stack ?? `${error.name}: ${error.message}`,
+      type: error.name || 'Error'
+    };
+  }
+  const message = typeof error === 'string' ? error : JSON.stringify(error);
+  return {message, details: message, type: 'Error'};
+}
+
+async function withTimeout(promise, timeoutMs, name) {
+  let timer = null;
+  try {
+    return await Promise.race([
+      promise,
+      new Promise((_resolve, reject) => {
+        timer = setTimeout(() => {
+          const error = new Error(`P2P node timed out after ${timeoutMs}ms: ${name}`);
+          error.name = 'HarnessTimeoutError';
+          reject(error);
+        }, timeoutMs);
+      })
+    ]);
+  } finally {
+    if (timer) {
+      clearTimeout(timer);
+    }
+  }
+}
+
+export async function runNode(node, timeoutMs) {
+  const startedAt = Date.now();
+  const result = {
+    file: node.file,
+    name: node.name,
+    status: 'passed',
+    message: '',
+    details: '',
+    type: '',
+    durationMs: 0
+  };
+
+  pendingUncaught = null;
+  try {
+    await withTimeout(
+      Promise.resolve().then(() => node.fn()),
+      timeoutMs,
+      node.name
+    );
+    if (pendingUncaught) {
+      const described = describeError(pendingUncaught);
+      result.status = 'failed';
+      result.message = `uncaught exception: ${described.message}`;
+      result.details = described.details;
+      result.type = described.type;
+    }
+  } catch (error) {
+    const described = describeError(error);
+    result.status = 'failed';
+    result.message = described.message;
+    result.details = described.details;
+    result.type = described.type;
+  } finally {
+    pendingUncaught = null;
+  }
+
+  result.durationMs = Date.now() - startedAt;
+  return result;
+}
+
+export function errorResult(file, name, error) {
+  const described = describeError(error);
+  return {
+    file,
+    name,
+    status: 'failed',
+    message: described.message,
+    details: described.details,
+    type: described.type,
+    durationMs: 0
+  };
+}
+
+function xmlEscape(value) {
+  return String(value)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function seconds(milliseconds) {
+  return (milliseconds / 1000).toFixed(3);
+}
+
+function testcaseXml(result) {
+  const attributes = [
+    `classname="${xmlEscape(result.file)}"`,
+    `name="${xmlEscape(result.name)}"`,
+    `file="${xmlEscape(result.file)}"`,
+    `time="${seconds(result.durationMs)}"`
+  ].join(' ');
+
+  if (result.status === 'passed') {
+    return `    <testcase ${attributes}/>`;
+  }
+
+  const tag = result.type === 'AssertionError' ? 'failure' : 'failure';
+  const failureAttributes = [
+    `message="${xmlEscape(result.message)}"`,
+    `type="${xmlEscape(result.type || 'Error')}"`
+  ].join(' ');
+  const details = xmlEscape(result.details || result.message);
+  return `    <testcase ${attributes}>\n      <${tag} ${failureAttributes}>${details}</${tag}>\n    </testcase>`;
+}
+
+export function writeJUnit(reportPath, results, name = 'setup-go-p2p') {
+  const byFile = new Map();
+  for (const result of results) {
+    if (!byFile.has(result.file)) {
+      byFile.set(result.file, []);
+    }
+    byFile.get(result.file).push(result);
+  }
+
+  const failures = results.filter(result => result.status !== 'passed').length;
+  const totalTime = results.reduce((sum, result) => sum + result.durationMs, 0);
+  const lines = [
+    '<?xml version="1.0" encoding="UTF-8"?>',
+    `<testsuites name="${xmlEscape(name)}" tests="${results.length}" failures="${failures}" errors="0" skipped="0" time="${seconds(totalTime)}">`
+  ];
+
+  for (const [file, fileResults] of byFile) {
+    const fileFailures = fileResults.filter(
+      result => result.status !== 'passed'
+    ).length;
+    const fileTime = fileResults.reduce(
+      (sum, result) => sum + result.durationMs,
+      0
+    );
+    lines.push(
+      `  <testsuite name="${xmlEscape(file)}" tests="${fileResults.length}" failures="${fileFailures}" errors="0" skipped="0" time="${seconds(fileTime)}">`
+    );
+    for (const result of fileResults) {
+      lines.push(testcaseXml(result));
+    }
+    lines.push('  </testsuite>');
+  }
+
+  lines.push('</testsuites>');
+  lines.push('');
+
+  const directory = path.dirname(reportPath);
+  if (directory && directory !== '.') {
+    fs.mkdirSync(directory, {recursive: true});
+  }
+  fs.writeFileSync(reportPath, lines.join('\n'), 'utf8');
+}
diff --git a/__tests__/p2p/jest-engine.mjs b/__tests__/p2p/jest-engine.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e7bbb8edf455d8aaea49fcbf4c8754e1ab0f7dcd
--- /dev/null
+++ b/__tests__/p2p/jest-engine.mjs
@@ -0,0 +1,227 @@
+// Dependency-free engine that executes one Baseline original test file with
+// the Jest-compatible runtime in jest-runtime.mjs.
+//
+// Usage:
+//   node --experimental-transform-types --no-warnings \
+//     __tests__/p2p/jest-engine.mjs --file <repo-relative test file> \
+//     --out <json result file> [--timeout <ms>]
+//
+// The engine registers synchronous in-process module hooks so that:
+//   * `@jest/globals` resolves to the local runtime;
+//   * every module registered through `jest.unstable_mockModule` (including
+//     the `@actions/*` packages, `fs` and repository modules) resolves to a
+//     generated module whose exports are the factory result;
+//   * the production `.ts` sources load through Node's TypeScript transform
+//     with the type-only export placeholders added by typescript-compat.mjs.
+//
+// It writes one JSON document with the per-node results and exits 0 whenever
+// the document was written; the runner maps the results into the JUnit report.
+/* global process, console, Buffer */
+import fs from 'node:fs';
+import path from 'node:path';
+import {registerHooks} from 'node:module';
+import {pathToFileURL} from 'node:url';
+
+import {
+  describeError,
+  hasMock,
+  mockKeyFor,
+  mockNamespace,
+  recordUncaught,
+  runCollectedTests
+} from './jest-runtime.mjs';
+import {
+  patchTypeOnlyImports,
+  resolveTypeScriptSpecifier
+} from './typescript-compat.mjs';
+
+const MOCK_SCHEME = 'p2p-mock:';
+const RUNTIME_URL = new URL('./jest-runtime.mjs', import.meta.url).href;
+const DEFAULT_NODE_TIMEOUT_MS = 10000;
+
+// The replay image ships no node_modules, so packages the original tests do
+// not mock explicitly are served by the dependency-free local stubs. The
+// original test files exercise the cache entry points with `@actions/*`
+// mocked, so these stubs are only reached by module loading, never by a
+// code path whose observable behaviour the tests assert.
+const ACTIONS_STUBS = new Map([
+  ['@actions/cache', new URL('./stubs/actions-cache.mjs', import.meta.url).href],
+  ['@actions/core', new URL('./stubs/actions-core.mjs', import.meta.url).href],
+  ['@actions/exec', new URL('./stubs/actions-exec.mjs', import.meta.url).href],
+  ['@actions/glob', new URL('./stubs/actions-glob.mjs', import.meta.url).href],
+  [
+    '@actions/http-client',
+    new URL('./stubs/actions-http-client.mjs', import.meta.url).href
+  ],
+  ['@actions/io', new URL('./stubs/actions-io.mjs', import.meta.url).href],
+  [
+    '@actions/tool-cache',
+    new URL('./stubs/actions-tool-cache.mjs', import.meta.url).href
+  ]
+]);
+
+function parseArguments(argv) {
+  const options = {file: null, out: null, timeout: null};
+  for (let index = 0; index < argv.length; index += 1) {
+    const argument = argv[index];
+    const withEquals = /^--(file|out|timeout)=(.*)$/.exec(argument);
+    if (withEquals) {
+      options[withEquals[1]] = withEquals[2];
+      continue;
+    }
+    const name = argument.startsWith('--') ? argument.slice(2) : null;
+    if (name && Object.prototype.hasOwnProperty.call(options, name)) {
+      options[name] = argv[index + 1] ?? null;
+      index += 1;
+    }
+  }
+  return options;
+}
+
+function mockModuleSource(key, namespace) {
+  const lines = [
+    `import {mockNamespace} from ${JSON.stringify(RUNTIME_URL)};`,
+    `const ns = mockNamespace(${JSON.stringify(key)});`
+  ];
+  let anonymous = 0;
+  for (const name of Object.keys(namespace)) {
+    if (name === 'default') {
+      continue;
+    }
+    if (/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(name)) {
+      lines.push(`export const ${name} = ns[${JSON.stringify(name)}];`);
+    } else {
+      anonymous += 1;
+      const local = `__p2pExport${anonymous}`;
+      lines.push(
+        `const ${local} = ns[${JSON.stringify(name)}];`,
+        `export {${local} as ${JSON.stringify(name)}};`
+      );
+    }
+  }
+  lines.push(
+    'export default ns.default !== undefined ? ns.default : ns;'
+  );
+  return lines.join('\n');
+}
+
+registerHooks({
+  resolve(specifier, context, nextResolve) {
+    if (specifier === '@jest/globals') {
+      return {url: RUNTIME_URL, shortCircuit: true};
+    }
+    const key = mockKeyFor(specifier, context.parentURL);
+    if (key !== null && hasMock(key)) {
+      return {
+        url: `${MOCK_SCHEME}${encodeURIComponent(key)}`,
+        shortCircuit: true
+      };
+    }
+    const stub = ACTIONS_STUBS.get(specifier);
+    if (stub) {
+      return {url: stub, shortCircuit: true};
+    }
+    const typescript = resolveTypeScriptSpecifier(specifier, context.parentURL);
+    if (typescript) {
+      return {url: typescript, shortCircuit: true};
+    }
+    return nextResolve(specifier, context);
+  },
+  load(url, context, nextLoad) {
+    if (url.startsWith(MOCK_SCHEME)) {
+      const key = decodeURIComponent(url.slice(MOCK_SCHEME.length));
+      const namespace = mockNamespace(key);
+      return {
+        format: 'module',
+        source: mockModuleSource(key, namespace),
+        shortCircuit: true
+      };
+    }
+    const result = nextLoad(url, context);
+    if (url.endsWith('.ts') && result && result.source !== undefined) {
+      const source =
+        typeof result.source === 'string'
+          ? result.source
+          : Buffer.from(result.source).toString('utf8');
+      const patched = patchTypeOnlyImports(source);
+      if (patched !== source) {
+        return {...result, source: patched};
+      }
+    }
+    return result;
+  }
+});
+
+process.on('uncaughtException', error => {
+  recordUncaught(error);
+});
+process.on('unhandledRejection', error => {
+  recordUncaught(error instanceof Error ? error : new Error(String(error)));
+});
+
+async function main() {
+  const options = parseArguments(process.argv.slice(2));
+  if (!options.file || !options.out) {
+    throw new Error('jest-engine requires --file <test file> and --out <json>');
+  }
+  const filePath = path.isAbsolute(options.file)
+    ? options.file
+    : path.resolve(process.cwd(), options.file);
+  const declaredPath = path
+    .relative(process.cwd(), filePath)
+    .split(path.sep)
+    .join('/');
+  const outPath = path.isAbsolute(options.out)
+    ? options.out
+    : path.resolve(process.cwd(), options.out);
+  const timeoutMs = Number(options.timeout ?? DEFAULT_NODE_TIMEOUT_MS);
+
+  globalThis.__P2P_JEST_TEST_FILE_URL__ = pathToFileURL(filePath).href;
+
+  const collectionErrors = [];
+  try {
+    await import(pathToFileURL(filePath).href);
+  } catch (error) {
+    collectionErrors.push(describeError(error));
+  }
+
+  const run = await runCollectedTests({file: declaredPath, timeoutMs});
+  for (const error of run.collectionErrors) {
+    collectionErrors.push(error.error ?? describeError(error));
+  }
+
+  fs.mkdirSync(path.dirname(outPath), {recursive: true});
+  fs.writeFileSync(
+    outPath,
+    JSON.stringify(
+      {
+        file: declaredPath,
+        timeoutMs,
+        collectionErrors,
+        results: run.results
+      },
+      null,
+      1
+    ),
+    'utf8'
+  );
+  const failed = run.results.filter(result => result.status !== 'passed');
+  console.log(
+    `[p2p-engine] ${declaredPath}: ${run.results.length} node(s), ${run.results.length - failed.length} passed, ${failed.length} failed`
+  );
+  for (const result of failed) {
+    console.log(`[p2p-engine] FAIL ${result.name}: ${result.message}`);
+  }
+  for (const error of collectionErrors) {
+    console.log(`[p2p-engine] collection error: ${error.message}`);
+  }
+}
+
+try {
+  await main();
+} catch (error) {
+  console.error(
+    `[p2p-engine] engine failed before writing results: ${error?.stack ?? error}`
+  );
+  process.exitCode = 1;
+}
diff --git a/__tests__/p2p/jest-runtime.mjs b/__tests__/p2p/jest-runtime.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4dcf93090e0cce29d499003f7222e2293908fbba
--- /dev/null
+++ b/__tests__/p2p/jest-runtime.mjs
@@ -0,0 +1,653 @@
+// Dependency-free Jest-compatible runtime used to execute the repository's
+// Baseline original test files in the replay image (which ships the Node.js
+// runtime but no node_modules and no network).
+//
+// The cache test files only use a small, well-defined subset of the Jest API:
+// describe/it/beforeEach/afterEach/afterAll, the jest.fn/jest.spyOn mock
+// helpers, jest.unstable_mockModule and the expect matchers
+// toBe/toEqual/toThrow/toBeTruthy/toBeFalsy/toHaveBeenCalled[With]. This module
+// implements exactly that subset with real assertions, so the original test
+// bodies execute and report genuine PASS/FAIL outcomes.
+//
+// The module is imported twice: once by the engine (direct import) and once by
+// the original test file through the `@jest/globals` specifier, which the
+// engine's resolve hook redirects here. Both imports share this single module
+// instance, so the suite registry and the module-mock registry are shared.
+/* global globalThis, setTimeout, clearTimeout */
+import {inspect} from 'node:util';
+
+export class AssertionError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'AssertionError';
+  }
+}
+
+function fail(message) {
+  throw new AssertionError(message);
+}
+
+function isObjectLike(value) {
+  return (
+    value !== null && (typeof value === 'object' || typeof value === 'function')
+  );
+}
+
+function isPromiseLike(value) {
+  return isObjectLike(value) && typeof value.then === 'function';
+}
+
+export function formatValue(value) {
+  if (typeof value === 'string') {
+    return JSON.stringify(value);
+  }
+  if (typeof value === 'function') {
+    return value.name ? `[Function: ${value.name}]` : '[Function]';
+  }
+  try {
+    return inspect(value, {depth: 4, breakLength: 100});
+  } catch {
+    return String(value);
+  }
+}
+
+export function deepEquals(left, right) {
+  if (Object.is(left, right)) {
+    return true;
+  }
+  if (!isObjectLike(left) || !isObjectLike(right)) {
+    return false;
+  }
+  if (Array.isArray(left) !== Array.isArray(right)) {
+    return false;
+  }
+  if (left instanceof Date || right instanceof Date) {
+    return (
+      left instanceof Date &&
+      right instanceof Date &&
+      left.getTime() === right.getTime()
+    );
+  }
+  if (left instanceof RegExp || right instanceof RegExp) {
+    return (
+      left instanceof RegExp && right instanceof RegExp && String(left) === String(right)
+    );
+  }
+  if (left instanceof Error || right instanceof Error) {
+    return (
+      left instanceof Error &&
+      right instanceof Error &&
+      left.name === right.name &&
+      left.message === right.message
+    );
+  }
+  const leftKeys = Object.keys(left).filter(key => left[key] !== undefined);
+  const rightKeys = Object.keys(right).filter(key => right[key] !== undefined);
+  if (leftKeys.length !== rightKeys.length) {
+    return false;
+  }
+  return leftKeys.every(
+    key =>
+      Object.prototype.hasOwnProperty.call(right, key) &&
+      deepEquals(left[key], right[key])
+  );
+}
+
+function thrownMatches(error, expected) {
+  if (expected === undefined) {
+    return true;
+  }
+  const message = error instanceof Error ? error.message : String(error);
+  if (typeof expected === 'string') {
+    return message.includes(expected);
+  }
+  if (expected instanceof RegExp) {
+    return expected.test(message);
+  }
+  if (typeof expected === 'function') {
+    return error instanceof expected;
+  }
+  if (expected instanceof Error) {
+    return (
+      error instanceof Error &&
+      error.name === expected.name &&
+      message.includes(expected.message)
+    );
+  }
+  if (isObjectLike(expected)) {
+    return Object.keys(expected).every(key =>
+      deepEquals(error?.[key], expected[key])
+    );
+  }
+  return false;
+}
+
+function requireMockFunction(value) {
+  if (!value || value._isMockFunction !== true) {
+    fail(`received value must be a mock function, but got ${formatValue(value)}`);
+  }
+  return value;
+}
+
+function makeMatchers(getActual, negated) {
+  const check = (pass, positive, negative) => {
+    const ok = negated ? !pass : pass;
+    if (!ok) {
+      fail(negated ? negative : positive);
+    }
+  };
+  return {
+    toBe(expected) {
+      const actual = getActual();
+      check(
+        Object.is(actual, expected),
+        `expected ${formatValue(actual)} to be ${formatValue(expected)}`,
+        `expected ${formatValue(actual)} not to be ${formatValue(expected)}`
+      );
+    },
+    toEqual(expected) {
+      const actual = getActual();
+      check(
+        deepEquals(actual, expected),
+        `expected ${formatValue(actual)} to equal ${formatValue(expected)}`,
+        `expected ${formatValue(actual)} not to equal ${formatValue(expected)}`
+      );
+    },
+    toBeTruthy() {
+      const actual = getActual();
+      check(
+        Boolean(actual),
+        `expected ${formatValue(actual)} to be truthy`,
+        `expected ${formatValue(actual)} to be falsy`
+      );
+    },
+    toBeFalsy() {
+      const actual = getActual();
+      check(
+        !actual,
+        `expected ${formatValue(actual)} to be falsy`,
+        `expected ${formatValue(actual)} to be truthy`
+      );
+    },
+    toThrow(expected) {
+      const actual = getActual();
+      if (typeof actual !== 'function') {
+        fail(
+          `received value must be a function, but got ${formatValue(actual)}`
+        );
+      }
+      let error = null;
+      let threw = false;
+      try {
+        actual();
+      } catch (caught) {
+        threw = true;
+        error = caught;
+      }
+      const pass = threw && thrownMatches(error, expected);
+      const description =
+        expected === undefined
+          ? 'to throw'
+          : `to throw an error matching ${formatValue(expected)}`;
+      check(
+        pass,
+        threw
+          ? `expected function not ${description}; it threw ${formatValue(error)}`
+          : `expected function ${description}, but it did not throw`,
+        `expected function not ${description}`
+      );
+    },
+    toHaveBeenCalled() {
+      const mock = requireMockFunction(getActual());
+      check(
+        mock.mock.calls.length > 0,
+        'expected mock function to have been called',
+        `expected mock ${mock._label ?? 'function'} not to have been called, calls: ${formatValue(mock.mock.calls.map(call => call.arguments))}`
+      );
+    },
+    toHaveBeenCalledTimes(count) {
+      const mock = requireMockFunction(getActual());
+      check(
+        mock.mock.calls.length === count,
+        `expected mock function to have been called ${count} times, but it was called ${mock.mock.calls.length} times`,
+        `expected mock function not to have been called ${count} times`
+      );
+    },
+    toHaveBeenCalledWith(...expectedArguments) {
+      const mock = requireMockFunction(getActual());
+      const pass = mock.mock.calls.some(call =>
+        deepEquals(call.arguments, expectedArguments)
+      );
+      check(
+        pass,
+        `expected mock function to have been called with ${formatValue(expectedArguments)}, calls: ${formatValue(mock.mock.calls.map(call => call.arguments))}`,
+        `expected mock function not to have been called with ${formatValue(expectedArguments)}`
+      );
+    }
+  };
+}
+
+function makeRejects(actual) {
+  const settled = (async () => {
+    const value = typeof actual === 'function' ? actual() : actual;
+    if (!isPromiseLike(value)) {
+      fail(
+        `expected ${formatValue(actual)} to be a promise or a function returning a promise`
+      );
+    }
+    return value;
+  })();
+  const rejection = () =>
+    settled.then(
+      resolved => {
+        fail(
+          `expected promise to reject, but it resolved with ${formatValue(resolved)}`
+        );
+      },
+      reason => reason
+    );
+  return {
+    async toThrow(expected) {
+      const reason = await rejection();
+      if (!thrownMatches(reason, expected)) {
+        fail(
+          `expected rejection ${formatValue(reason)} to match ${formatValue(expected)}`
+        );
+      }
+    },
+    async toBe(expected) {
+      const reason = await rejection();
+      if (!Object.is(reason, expected)) {
+        fail(
+          `expected rejection ${formatValue(reason)} to be ${formatValue(expected)}`
+        );
+      }
+    },
+    async toEqual(expected) {
+      const reason = await rejection();
+      if (!deepEquals(reason, expected)) {
+        fail(
+          `expected rejection ${formatValue(reason)} to equal ${formatValue(expected)}`
+        );
+      }
+    }
+  };
+}
+
+export function expect(actual) {
+  const matchers = makeMatchers(() => actual, false);
+  matchers.not = makeMatchers(() => actual, true);
+  // `.rejects` unwraps a promise (or calls a thunk); it must stay lazy so that
+  // expecting a mock function does not invoke the mock.
+  Object.defineProperty(matchers, 'rejects', {
+    configurable: true,
+    get() {
+      return makeRejects(actual);
+    }
+  });
+  return matchers;
+}
+
+// ---------------------------------------------------------------------------
+// Mock functions and spies
+// ---------------------------------------------------------------------------
+
+const allMocks = [];
+
+export function createMockFunction(implementation, name = 'jest.fn()') {
+  const state = {
+    calls: [],
+    instances: [],
+    results: [],
+    oneTime: [],
+    implementation
+  };
+  const mockFunction = function (...args) {
+    state.calls.push({arguments: args});
+    state.instances.push(this);
+    const current = state.oneTime.length
+      ? state.oneTime.shift()
+      : state.implementation;
+    let value;
+    try {
+      value = typeof current === 'function' ? current.apply(this, args) : undefined;
+    } catch (error) {
+      state.results.push({type: 'throw', value: error});
+      throw error;
+    }
+    state.results.push({type: 'return', value});
+    return value;
+  };
+  try {
+    Object.defineProperty(mockFunction, 'name', {value: name});
+  } catch {
+    // the name is cosmetic
+  }
+  mockFunction._isMockFunction = true;
+  mockFunction.mock = state;
+  mockFunction.mockImplementation = next => {
+    state.implementation = next;
+    return mockFunction;
+  };
+  mockFunction.mockImplementationOnce = next => {
+    state.oneTime.push(next);
+    return mockFunction;
+  };
+  mockFunction.mockReturnValue = value =>
+    mockFunction.mockImplementation(() => value);
+  mockFunction.mockReturnValueOnce = value =>
+    mockFunction.mockImplementationOnce(() => value);
+  mockFunction.mockClear = () => {
+    state.calls.length = 0;
+    state.instances.length = 0;
+    state.results.length = 0;
+    return mockFunction;
+  };
+  mockFunction.mockReset = () => {
+    mockFunction.mockClear();
+    state.oneTime.length = 0;
+    state.implementation = undefined;
+    return mockFunction;
+  };
+  mockFunction.mockRestore = () => {
+    if (mockFunction._restore) {
+      mockFunction._restore();
+    }
+    return mockFunction;
+  };
+  mockFunction._label = name;
+  allMocks.push(mockFunction);
+  return mockFunction;
+}
+
+function spyOn(object, key) {
+  const original = object[key];
+  const hadOwn = Object.prototype.hasOwnProperty.call(object, key);
+  const spy = createMockFunction(function (...args) {
+    return original.apply(this, args);
+  }, `spyOn(${String(key)})`);
+  spy._restore = () => {
+    if (hadOwn) {
+      object[key] = original;
+    } else {
+      delete object[key];
+    }
+  };
+  object[key] = spy;
+  return spy;
+}
+
+export const jest = {
+  fn(implementation) {
+    return createMockFunction(implementation, 'jest.fn()');
+  },
+  spyOn,
+  clearAllMocks() {
+    for (const mock of allMocks) {
+      mock.mockClear();
+    }
+  },
+  resetAllMocks() {
+    for (const mock of allMocks) {
+      mock.mockReset();
+      if (mock._restore) {
+        mock._restore();
+      }
+    }
+  },
+  restoreAllMocks() {
+    for (const mock of allMocks) {
+      if (mock._restore) {
+        mock._restore();
+      }
+    }
+  },
+  unstable_mockModule(specifier, factory) {
+    registerMock(specifier, factory);
+  },
+  mock(specifier, factory) {
+    registerMock(specifier, factory);
+  }
+};
+
+// ---------------------------------------------------------------------------
+// Module mock registry (used by the engine's resolve/load hooks)
+// ---------------------------------------------------------------------------
+
+const mockRegistry = new Map();
+
+export function mockKeyFor(specifier, parentURL) {
+  if (typeof specifier !== 'string' || !specifier) {
+    return null;
+  }
+  if (specifier.startsWith('node:')) {
+    return specifier.slice('node:'.length);
+  }
+  if (specifier.startsWith('./') || specifier.startsWith('../')) {
+    if (!parentURL) {
+      return null;
+    }
+    try {
+      return new URL(specifier, parentURL).href;
+    } catch {
+      return null;
+    }
+  }
+  return specifier;
+}
+
+export function registerMock(specifier, factory) {
+  if (typeof factory !== 'function') {
+    throw new Error(`jest.unstable_mockModule requires a factory for ${specifier}`);
+  }
+  const parentURL =
+    globalThis.__P2P_JEST_TEST_FILE_URL__ ?? import.meta.url;
+  const key = mockKeyFor(specifier, parentURL);
+  if (!key) {
+    throw new Error(`cannot resolve the module mock specifier ${specifier}`);
+  }
+  mockRegistry.set(key, {factory});
+}
+
+export function hasMock(key) {
+  return mockRegistry.has(key);
+}
+
+export function mockNamespace(key) {
+  const entry = mockRegistry.get(key);
+  if (!entry) {
+    throw new Error(`no module mock registered for ${key}`);
+  }
+  if (!entry.evaluated) {
+    const namespace = entry.factory();
+    entry.namespace = isObjectLike(namespace) ? namespace : {};
+    entry.evaluated = true;
+  }
+  return entry.namespace;
+}
+
+// ---------------------------------------------------------------------------
+// Suite collection and execution
+// ---------------------------------------------------------------------------
+
+function createSuite(name, parent) {
+  return {
+    name,
+    parent,
+    tests: [],
+    suites: [],
+    beforeEach: [],
+    afterEach: [],
+    beforeAll: [],
+    afterAll: []
+  };
+}
+
+const rootSuite = createSuite('', null);
+const collectionErrors = [];
+let currentSuite = rootSuite;
+
+export function describe(name, fn) {
+  const suite = createSuite(name, currentSuite);
+  currentSuite.suites.push(suite);
+  const previous = currentSuite;
+  currentSuite = suite;
+  try {
+    fn();
+  } catch (error) {
+    collectionErrors.push({name, error: describeError(error)});
+  } finally {
+    currentSuite = previous;
+  }
+}
+
+export function it(name, fn, timeout) {
+  currentSuite.tests.push({name, fn, timeout});
+}
+
+export const test = it;
+
+export function beforeEach(fn) {
+  currentSuite.beforeEach.push(fn);
+}
+
+export function afterEach(fn) {
+  currentSuite.afterEach.push(fn);
+}
+
+export function beforeAll(fn) {
+  currentSuite.beforeAll.push(fn);
+}
+
+export function afterAll(fn) {
+  currentSuite.afterAll.push(fn);
+}
+
+export function describeError(error) {
+  if (error instanceof Error) {
+    return {
+      message: error.message,
+      details: error.stack ?? `${error.name}: ${error.message}`,
+      type: error.name || 'Error'
+    };
+  }
+  const message = typeof error === 'string' ? error : JSON.stringify(error);
+  return {message, details: message, type: 'Error'};
+}
+
+let pendingUncaught = null;
+
+export function recordUncaught(error) {
+  pendingUncaught = error;
+}
+
+function takePendingUncaught() {
+  const error = pendingUncaught;
+  pendingUncaught = null;
+  return error;
+}
+
+async function withTimeout(promise, timeoutMs, name) {
+  let timer = null;
+  try {
+    return await Promise.race([
+      promise,
+      new Promise((_resolve, reject) => {
+        timer = setTimeout(() => {
+          const error = new Error(`test node timed out after ${timeoutMs}ms: ${name}`);
+          error.name = 'HarnessTimeoutError';
+          reject(error);
+        }, timeoutMs);
+      })
+    ]);
+  } finally {
+    if (timer) {
+      clearTimeout(timer);
+    }
+  }
+}
+
+function hookChain(suite, key) {
+  const chain = [];
+  let current = suite;
+  while (current) {
+    chain.push(...current[key]);
+    current = current.parent;
+  }
+  return chain;
+}
+
+async function runSuite(suite, results, timeoutMs) {
+  for (const hook of suite.beforeAll) {
+    try {
+      await withTimeout(Promise.resolve().then(() => hook()), timeoutMs, 'beforeAll');
+    } catch {
+      // a beforeAll failure is surfaced through the nodes that cannot run
+    }
+  }
+
+  for (const node of suite.tests) {
+    const startedAt = Date.now();
+    const result = {
+      name: node.name,
+      status: 'passed',
+      message: '',
+      details: '',
+      type: '',
+      durationMs: 0
+    };
+    const beforeHooks = hookChain(suite, 'beforeEach').reverse();
+    const afterHooks = hookChain(suite, 'afterEach');
+    try {
+      for (const hook of beforeHooks) {
+        await withTimeout(Promise.resolve().then(() => hook()), timeoutMs, 'beforeEach');
+      }
+      await withTimeout(
+        Promise.resolve().then(() => node.fn()),
+        node.timeout ?? timeoutMs,
+        node.name
+      );
+      const uncaught = takePendingUncaught();
+      if (uncaught) {
+        throw uncaught;
+      }
+    } catch (error) {
+      const described = describeError(error);
+      result.status = 'failed';
+      result.message = described.message;
+      result.details = described.details;
+      result.type = described.type;
+    } finally {
+      for (const hook of afterHooks) {
+        try {
+          await withTimeout(Promise.resolve().then(() => hook()), timeoutMs, 'afterEach');
+        } catch {
+          // afterEach failures do not change the recorded node outcome
+        }
+      }
+    }
+    result.durationMs = Date.now() - startedAt;
+    results.push(result);
+  }
+
+  for (const child of suite.suites) {
+    await runSuite(child, results, timeoutMs);
+  }
+
+  for (const hook of suite.afterAll) {
+    try {
+      await withTimeout(Promise.resolve().then(() => hook()), timeoutMs, 'afterAll');
+    } catch {
+      // afterAll failures do not change the recorded node outcomes
+    }
+  }
+}
+
+export async function runCollectedTests({file, timeoutMs = 10000} = {}) {
+  const results = [];
+  await runSuite(rootSuite, results, timeoutMs);
+  for (const result of results) {
+    result.file = file;
+  }
+  return {results, collectionErrors};
+}
diff --git a/__tests__/p2p/loader-hooks.mjs b/__tests__/p2p/loader-hooks.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..41007a6dcdd6edb5e2db6bcd9985ac4a02b4d559
--- /dev/null
+++ b/__tests__/p2p/loader-hooks.mjs
@@ -0,0 +1,78 @@
+// Node module customization hooks used by the supplemental P2P harness.
+//
+// Three rewrites are required to execute the production TypeScript sources in a
+// replay image that only ships the Node.js runtime (no node_modules, no
+// network):
+//   1. the repository imports its own modules with a `.js` extension while the
+//      files on disk are `.ts`, so relative `./x.js` specifiers are redirected
+//      to `./x.ts` when only the TypeScript file exists;
+//   2. `@actions/*` packages are redirected to dependency-free stubs so the
+//      observable contract of the cache entry points can be asserted without
+//      the real toolkit being installed;
+//   3. Node's syntax-only TypeScript transform keeps plain named imports
+//      verbatim, so a module that imports an interface with `import {X}` fails
+//      to link. The load hook appends a runtime placeholder export for every
+//      type-only declaration that has no runtime counterpart, which keeps such
+//      imports linkable while leaving the production source untouched.
+/* global URL, Buffer */
+import {
+  patchTypeOnlyImports,
+  resolveTypeScriptSpecifier
+} from './typescript-compat.mjs';
+
+const ACTIONS_STUBS = new Map([
+  ['@actions/cache', new URL('./stubs/actions-cache.mjs', import.meta.url).href],
+  ['@actions/core', new URL('./stubs/actions-core.mjs', import.meta.url).href],
+  ['@actions/exec', new URL('./stubs/actions-exec.mjs', import.meta.url).href],
+  ['@actions/glob', new URL('./stubs/actions-glob.mjs', import.meta.url).href],
+  [
+    '@actions/http-client',
+    new URL('./stubs/actions-http-client.mjs', import.meta.url).href
+  ],
+  ['@actions/io', new URL('./stubs/actions-io.mjs', import.meta.url).href],
+  [
+    '@actions/tool-cache',
+    new URL('./stubs/actions-tool-cache.mjs', import.meta.url).href
+  ]
+]);
+
+export async function resolve(specifier, context, nextResolve) {
+  // Only main's unrelated installation dependencies are fixtures. The main
+  // entry, cache feature helper and restore implementation remain production
+  // code, so these tests measure the actual cache wiring and error handling.
+  if (context.parentURL?.endsWith('/src/main.ts')) {
+    const fixture = specifier === './installer.js' ? 'main-installer.mjs'
+      : specifier === 'semver' ? 'main-semver.mjs' : null;
+    if (fixture) {
+      return {url: new URL(`./stubs/${fixture}`, import.meta.url).href,
+        shortCircuit: true};
+    }
+  }
+  const stub = ACTIONS_STUBS.get(specifier);
+  if (stub) {
+    return {url: stub, shortCircuit: true};
+  }
+
+  const typescript = resolveTypeScriptSpecifier(specifier, context.parentURL);
+  if (typescript) {
+    return {url: typescript, shortCircuit: true};
+  }
+
+  return nextResolve(specifier, context);
+}
+
+export async function load(url, context, nextLoad) {
+  const result = await nextLoad(url, context);
+  if (!url.endsWith('.ts')) {
+    return result;
+  }
+  const source =
+    typeof result.source === 'string'
+      ? result.source
+      : Buffer.from(result.source ?? '').toString('utf8');
+  const patched = patchTypeOnlyImports(source);
+  if (patched === source) {
+    return result;
+  }
+  return {...result, source: patched};
+}
