+  {
+    path: "__tests__/cache-utils.test.ts",
+    nodes: [
+      "should return trimmed stdout in case of successful exit code",
+      "should return error in case of unsuccessful exit code",
+      "should return package manager info in case of valid package manager name",
+      "should throw the error in case of invalid package manager name",
+      "should return path to the cache folders which specified package manager uses",
+      "should return path to the cache folder if one command return empty str",
+      "should throw if the both commands return empty str",
