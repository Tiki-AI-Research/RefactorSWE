+// Supplemental P2P regression nodes for the restore side of the cache context
+// consolidation. Every node drives the public restore entry point
+// (`restoreCache`) and asserts only user-visible contract facts that must stay
+// unchanged: discovery behaviour, primary key derivation, cross-step state
+// names, the cache-hit output and the existing error/log texts.
+/* global process */
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {syncBuiltinESMExports} from 'node:module';
+import os from 'node:os';
+import path from 'node:path';
+
+import {test} from './harness.mjs';
+import * as cache from './stubs/actions-cache.mjs';
+import * as core from './stubs/actions-core.mjs';
+import * as exec from './stubs/actions-exec.mjs';
+import * as glob from './stubs/actions-glob.mjs';
+
+const {restoreCache} = await import('../../src/cache-restore.js');
+
+const FILE_HASH = 'file_hash';
+const VERSION_SPEC = '1.13.1';
+const DEPENDENCY_FILE = 'go.sum';
+
+function resetStubs() {
+  core.__reset();
+  cache.__reset();
+  exec.__reset();
+  glob.__reset();
+  glob.__setHashFilesImpl(async () => FILE_HASH);
+  exec.__setExecImpl(async commandLine => {
+    if (commandLine === 'go env GOMODCACHE') {
+      return {exitCode: 0, stdout: '/gomodcache\n', stderr: ''};
+    }
+    if (commandLine === 'go env GOCACHE') {
+      return {exitCode: 0, stdout: '/gocache\n', stderr: ''};
+    }
+    throw new Error(`unexpected discovery command: ${commandLine}`);
+  });
+}
+
+function setDiscovery(map) {
+  exec.__setExecImpl(async commandLine => {
+    if (!Object.prototype.hasOwnProperty.call(map, commandLine)) {
+      throw new Error(`unexpected discovery command: ${commandLine}`);
+    }
+    return map[commandLine];
+  });
+}
+
+function stateWrites() {
+  return core.__calls('saveState').map(call => call.args);
+}
+
+function cacheHitOutputs() {
+  return core
+    .__calls('setOutput')
+    .map(call => call.args)
+    .filter(args => args[0] === 'cache-hit');
+}
+
+function infoMessages() {
+  return core.__messages('info');
+}
+
+function makeDirectory() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'setup-go-p2p-'));
+}
+
+async function withEnv(values, fn) {
+  const saved = {};
+  for (const [name, value] of Object.entries(values)) {
+    saved[name] = process.env[name];
+    if (value === undefined) {
+      delete process.env[name];
+    } else {
+      process.env[name] = value;
+    }
+  }
+  try {
+    return await fn();
+  } finally {
+    for (const [name, value] of Object.entries(saved)) {
+      if (value === undefined) {
+        delete process.env[name];
+      } else {
+        process.env[name] = value;
+      }
+    }
+  }
+}
+
+test('restore passes the unfiltered discovered cache folder paths to the cache service', async () => {
+  resetStubs();
+
+  const root = makeDirectory();
+  const paths = [path.join(root, 'module-cache'), path.join(root, 'build-cache')];
+  setDiscovery({
+    'go env GOMODCACHE': {exitCode: 0, stdout: `${paths[0]}\n`, stderr: ''},
+    'go env GOCACHE': {exitCode: 0, stdout: `${paths[1]}\n`, stderr: ''}
+  });
+  // Observe real filesystem operations without changing their results. Folder
+  // existence is relevant only to save, not to a restore into missing folders.
+  const probes = [];
+  const originals = [];
+  for (const [api, names] of [
+    [fs, ['existsSync', 'statSync', 'lstatSync', 'accessSync', 'stat', 'lstat', 'access']],
+    [fs.promises, ['stat', 'lstat', 'access']]
+  ]) {
+    for (const name of names) {
+      const original = api[name];
+      originals.push([api, name, original]);
+      api[name] = function (target, ...args) {
+        if (paths.includes(String(target))) probes.push([name, String(target)]);
+        return Reflect.apply(original, this, [target, ...args]);
+      };
+    }
+  }
+  syncBuiltinESMExports();
+  try {
+    await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
+
+    const restoreCalls = cache.__calls('restoreCache');
+    assert.equal(restoreCalls.length, 1);
+    assert.deepEqual(restoreCalls[0].args[0], paths);
+    assert.equal(restoreCalls[0].args[1].endsWith(`-${FILE_HASH}`), true);
+    assert.deepEqual(probes, [],
+      'restore must not locally probe discovered cache folders for existence');
+  } finally {
+    for (const [api, name, original] of originals) api[name] = original;
+    syncBuiltinESMExports();
+    fs.rmSync(root, {recursive: true, force: true});
+  }
+});
+
+test('restore discards a failed discovery command and keeps the successful cache folder path', async () => {
+  resetStubs();
+  setDiscovery({
+    'go env GOMODCACHE': {
+      exitCode: 1,
+      stdout: '',
+      stderr: 'go env GOMODCACHE failed'
+    },
+    'go env GOCACHE': {exitCode: 0, stdout: '/gocache\n', stderr: ''}
+  });
+
+  await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
+
+  const restoreCalls = cache.__calls('restoreCache');
+  assert.equal(restoreCalls.length, 1);
+  assert.deepEqual(restoreCalls[0].args[0], ['/gocache']);
+});
+
+test('restore throws Could not get cache folder paths when every discovery command fails', async () => {
+  resetStubs();
+  setDiscovery({
+    'go env GOMODCACHE': {exitCode: 1, stdout: '', stderr: 'failure one'},
+    'go env GOCACHE': {exitCode: 1, stdout: '', stderr: 'failure two'}
+  });
+
+  await assert.rejects(
+    () => restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE),
+    error =>
+      error instanceof Error && error.message === 'Could not get cache folder paths.'
+  );
+  assert.equal(cache.__calls('restoreCache').length, 0);
+});
+
+test('restore rejects an unknown package manager with the existing message', async () => {
+  resetStubs();
+
+  await assert.rejects(
+    () => restoreCache(VERSION_SPEC, 'pnpm'),
+    error =>
+      error instanceof Error &&
+      error.message ===
+        "It's not possible to use pnpm, please, check correctness of the package manager name spelling."
+  );
+  assert.equal(exec.__calls('getExecOutput').length, 0);
+  assert.equal(cache.__calls('restoreCache').length, 0);
+});
+
+test('restore throws when dependency hashing resolves nothing', async () => {
+  resetStubs();
+  glob.__setHashFilesImpl(async () => '');
+
+  await assert.rejects(
+    () => restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE),
+    error =>
+      error instanceof Error &&
+      error.message ===
+        'Some specified paths were not resolved, unable to cache dependencies.'
+  );
+  assert.equal(cache.__calls('restoreCache').length, 0);
+});
+
+test('restore reports the missing default dependency file with the workspace and supported pattern', async () => {
+  // An unset action input reaches restore as ''. Missing-file reporting must
+  // remain independent of the empty-hash error for both optional input forms.
+  for (const dependencyPath of [undefined, '']) {
+    resetStubs();
+    const workspace = makeDirectory();
+    glob.__setHashFilesImpl(async () => '');
+
+    await withEnv({GITHUB_WORKSPACE: workspace}, async () => {
+      await assert.rejects(
+        () => restoreCache(VERSION_SPEC, 'default', dependencyPath),
+        error =>
+          error instanceof Error &&
+          error.message ===
+            `Dependencies file is not found in ${workspace}. Supported file pattern: go.mod`
+      );
+    });
+  }
+});
+
+test('restore derives the primary key from platform, architecture, Linux ImageOS and hash in order', async () => {
+  resetStubs();
+
+  await withEnv({RUNNER_OS: 'Linux', ImageOS: 'ubuntu-22.04'}, async () => {
+    await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
