+// Dependency-free stand-in for @actions/cache used by the F2P harness. Each
+// recorded call keeps the stack captured inside the stub so the F2P nodes can
+// attribute the cache-service request to its caller.
+import {nextSeq} from './call-log.mjs';
+
+const state = {
+  restoreImpl: async () => '',
+  saveImpl: async () => 0,
+  featureAvailable: true,
+  calls: []
+};
+
+function record(name, args) {
+  state.calls.push({
+    name,
+    args,
+    seq: nextSeq(),
+    stack: new Error(`f2p:${name}`).stack ?? ''
+  });
+}
+
+export function __reset() {
+  state.restoreImpl = async () => '';
+  state.saveImpl = async () => 0;
+  state.featureAvailable = true;
+  state.calls.length = 0;
+}
+
+export function __setRestoreImpl(fn) {
+  state.restoreImpl = fn;
+}
+
+export function __setSaveImpl(fn) {
+  state.saveImpl = fn;
+}
+
+export function __setFeatureAvailable(value) {
+  state.featureAvailable = value;
+}
+
+export function __calls(name) {
+  return state.calls.filter(call => call.name === name);
+}
+
+export async function restoreCache(paths, key) {
+  record('restoreCache', [paths, key]);
+  return await state.restoreImpl(paths, key);
+}
+
+export async function saveCache(paths, key) {
+  record('saveCache', [paths, key]);
+  return await state.saveImpl(paths, key);
+}
