+// Declared F2P files and exact leaf selectors.
+//
+// The runner uses this manifest to import the F2P test files and to reject
+// selections that are not declared here; the plan declaration mirrors it.
+export const TEST_FILES = [
+  {
+    path: '__tests__/f2p/cache-context-restore-f2p.test.mjs',
+    nodes: [
+      'restore derives the primary key and writes CACHE_KEY through one shared module',
+      'restore writes the matched CACHE_RESULT through the same shared module as CACHE_KEY',
+      'restore obtains the discovered cache folder paths through the shared module that writes CACHE_KEY',
+      'restore rejects an unknown package manager through the shared module that writes CACHE_KEY',
+      'restore reports a missing dependency file through the shared module that derives the primary key',
+      'restore raises the empty dependency hash error through the shared module that derives the primary key',
+      'restore does not write the primary key inside the restore entry module',
+      'restore does not hash the dependency file inside the restore entry module'
+    ]
+  },
+  {
+    path: '__tests__/f2p/cache-context-save-f2p.test.mjs',
+    nodes: [
+      'save reads CACHE_KEY and CACHE_RESULT through one shared module',
+      'save reports on-disk folder existence through the shared module that reads CACHE_KEY',
+      'save obtains the discovered cache folder paths through the shared module that reads CACHE_KEY',
+      'save does not read the primary key state inside the save entry module',
+      'save does not perform the on-disk existence check inside the save entry module'
+    ]
+  },
+  {
+    path: '__tests__/f2p/cache-context-shared-f2p.test.mjs',
+    nodes: [
+      'restore and save reach the cross-step cache key through the same shared module',
+      'the primary key written by restore and read by save is owned by the same shared module',
+      'restore cache folder discovery and save existence reporting go through the same shared module',
+      'save cache folder discovery and restore primary key derivation go through the same shared module',
+      'the package manager rejection module and save cache state read are the same shared module'
+    ]
+  }
+];
+
+export const F2P_SELECTORS = TEST_FILES.flatMap(file =>
+  file.nodes.map(leaf => `${file.path}::${leaf}`)
+);
+
+export const FROZEN_P2P_RUNNER = '__tests__/p2p/run-p2p.mjs';
