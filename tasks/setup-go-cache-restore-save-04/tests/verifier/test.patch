+
+  // The Linux-only component is the ImageOS environment value followed by a
+  // dash; it is present on Linux and absent everywhere else.
+  const expectedKey = `setup-go-Linux-${process.arch}-ubuntu-22.04-go-${VERSION_SPEC}-${FILE_HASH}`;
+  const primaryKeyWrites = stateWrites().filter(args => args[0] === 'CACHE_KEY');
+  assert.equal(primaryKeyWrites.length, 1);
+  assert.equal(primaryKeyWrites[0][1], expectedKey);
+  assert.equal(cache.__calls('restoreCache')[0].args[1], expectedKey);
+});
+
+test('restore omits the ImageOS component on non-Linux runners', async () => {
+  resetStubs();
+
+  await withEnv({RUNNER_OS: 'Windows', ImageOS: 'win22'}, async () => {
+    await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
+  });
+
+  const expectedKey = `setup-go-Windows-${process.arch}-go-${VERSION_SPEC}-${FILE_HASH}`;
+  const primaryKeyWrites = stateWrites().filter(args => args[0] === 'CACHE_KEY');
+  assert.equal(primaryKeyWrites.length, 1);
+  assert.equal(primaryKeyWrites[0][1], expectedKey);
+});
+
+test('restore writes CACHE_KEY before requesting the restore', async () => {
+  resetStubs();
+
+  await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
+
+  const keyWrite = core
+    .__allCalls()
+    .find(call => call.name === 'saveState' && call.args[0] === 'CACHE_KEY');
