diff --git a/__tests__/f2p/cache-context-restore-f2p.test.mjs b/__tests__/f2p/cache-context-restore-f2p.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b4319cefd1a8b5c54d61594031b57e9ff1ec4427
--- /dev/null
+++ b/__tests__/f2p/cache-context-restore-f2p.test.mjs
@@ -0,0 +1,106 @@
+// F2P structural nodes for the restore consumer of the consolidated cache
+// context.
+//
+// The consolidation must not change what restore observes, so these nodes do
+// not re-assert the frozen behaviour (the P2P nodes own that). They assert
+// *who performs each responsibility* on the restore path: package manager
+// resolution, cache folder discovery, dependency-file hashing and the
+// cross-step cache state have to be delegated to one shared module that the
+// save flow consumes as well.
+import assert from 'node:assert/strict';
+
+import {test} from './harness.mjs';
+import {RESTORE_ENTRY, formatChains, intersection} from './ownership.mjs';
+import {
+  captureRestoreDiscovery,
+  captureRestoreEmptyHash,
+  captureRestoreHash,
+  captureRestoreKeyWrite,
+  captureRestoreMatchedWrite,
+  captureRestoreMissingDependencyFile,
+  captureRestorePackageManagerRejection
+} from './scenarios.mjs';
+
+test('restore derives the primary key and writes CACHE_KEY through one shared module', async () => {
+  const hash = await captureRestoreHash();
+  const keyWrite = await captureRestoreKeyWrite();
+
+  const shared = intersection(hash.nonEntry, keyWrite.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected the dependency-file hash and the CACHE_KEY write to be delegated to one shared module; observed ${formatChains({hash: hash.nonEntry, cacheKey: keyWrite.nonEntry})}`
+  );
+});
+
+test('restore writes the matched CACHE_RESULT through the same shared module as CACHE_KEY', async () => {
+  const matchedWrite = await captureRestoreMatchedWrite();
+  const keyWrite = await captureRestoreKeyWrite();
+
+  const shared = intersection(matchedWrite.nonEntry, keyWrite.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected the CACHE_RESULT and CACHE_KEY writes to be delegated to one shared module; observed ${formatChains({cacheResult: matchedWrite.nonEntry, cacheKey: keyWrite.nonEntry})}`
+  );
+});
+
+test('restore obtains the discovered cache folder paths through the shared module that writes CACHE_KEY', async () => {
+  const discovery = await captureRestoreDiscovery();
+  const keyWrite = await captureRestoreKeyWrite();
+
+  const shared = intersection(discovery.nonEntry, keyWrite.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected cache folder discovery and the CACHE_KEY write to be delegated to one shared module; observed ${formatChains({discovery: discovery.nonEntry, cacheKey: keyWrite.nonEntry})}`
+  );
+});
+
+test('restore rejects an unknown package manager through the shared module that writes CACHE_KEY', async () => {
+  const rejection = await captureRestorePackageManagerRejection();
+  const keyWrite = await captureRestoreKeyWrite();
+
+  const shared = intersection(rejection.nonEntry, keyWrite.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected package manager resolution and the CACHE_KEY write to be delegated to one shared module; observed ${formatChains({packageManager: rejection.nonEntry, cacheKey: keyWrite.nonEntry})}`
+  );
+});
+
+test('restore reports a missing dependency file through the shared module that derives the primary key', async () => {
+  const missingFile = await captureRestoreMissingDependencyFile();
+  const hash = await captureRestoreHash();
+
+  const shared = intersection(missingFile.nonEntry, hash.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected the dependency-file lookup failure and the dependency-file hash to be delegated to one shared module; observed ${formatChains({missingDependencyFile: missingFile.nonEntry, hash: hash.nonEntry})}`
+  );
+});
+
+test('restore raises the empty dependency hash error through the shared module that derives the primary key', async () => {
+  const emptyHash = await captureRestoreEmptyHash();
+  const hash = await captureRestoreHash();
+
+  const shared = intersection(emptyHash.nonEntry, hash.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected the empty-hash failure and the dependency-file hash to be delegated to one shared module; observed ${formatChains({emptyHash: emptyHash.nonEntry, hash: hash.nonEntry})}`
+  );
+});
+
+test('restore does not write the primary key inside the restore entry module', async () => {
+  const keyWrite = await captureRestoreKeyWrite();
+
+  assert.ok(
+    keyWrite.innermost !== null && keyWrite.innermost !== RESTORE_ENTRY,
+    `expected the CACHE_KEY write to be delegated away from ${RESTORE_ENTRY}; observed innermost=${keyWrite.innermost} chain=[${keyWrite.chain.join(', ')}]`
+  );
+});
+
+test('restore does not hash the dependency file inside the restore entry module', async () => {
+  const hash = await captureRestoreHash();
+
+  assert.ok(
+    hash.innermost !== null && hash.innermost !== RESTORE_ENTRY,
+    `expected the dependency-file hash to be delegated away from ${RESTORE_ENTRY}; observed innermost=${hash.innermost} chain=[${hash.chain.join(', ')}]`
+  );
+});
diff --git a/__tests__/f2p/cache-context-save-f2p.test.mjs b/__tests__/f2p/cache-context-save-f2p.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..be36197faa387c9904af9d3f2d22bf78198c0245
--- /dev/null
+++ b/__tests__/f2p/cache-context-save-f2p.test.mjs
@@ -0,0 +1,78 @@
+// F2P structural nodes for the save (post step) consumer of the consolidated
+// cache context.
+//
+// Save must keep its frozen observable behaviour (the P2P nodes own that) while
+// obtaining its cache folder paths, its on-disk existence information and its
+// cross-step cache state from the same shared module the restore flow uses.
+import assert from 'node:assert/strict';
+
+import {test} from './harness.mjs';
+import {SAVE_ENTRY, formatChains, intersection} from './ownership.mjs';
+import {
+  captureSaveDiscovery,
+  captureSaveExistence,
+  captureSaveKeyRead,
+  captureSaveMatchedRead,
+  captureSavePrimaryStateFailure
+} from './scenarios.mjs';
+
+test('save reads CACHE_KEY and CACHE_RESULT through one shared module', async () => {
+  const keyRead = await captureSaveKeyRead();
+  const matchedRead = await captureSaveMatchedRead();
+
+  const shared = intersection(keyRead.nonEntry, matchedRead.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected the CACHE_KEY and CACHE_RESULT reads to be delegated to one shared module; observed ${formatChains({cacheKey: keyRead.nonEntry, cacheResult: matchedRead.nonEntry})}`
+  );
+
+  for (const matchedStateFails of [false, true]) {
+    const failure = await captureSavePrimaryStateFailure(matchedStateFails);
+    assert.deepEqual(failure.warnings, ['cache identity unavailable'],
+      'save must report the primary-state failure, not a secondary metadata failure');
+    assert.deepEqual(failure.reads, ['CACHE_KEY'],
+      'a failed primary-state prerequisite must not request restore-match metadata');
+    assert.equal(failure.saves, 0);
+    assert.equal(failure.failures, 0, 'state retrieval errors must remain non-fatal');
+  }
+});
+
+test('save reports on-disk folder existence through the shared module that reads CACHE_KEY', async () => {
+  const existence = await captureSaveExistence();
+  const keyRead = await captureSaveKeyRead();
+
+  const shared = intersection(existence.nonEntry, keyRead.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected on-disk existence reporting and the CACHE_KEY read to be delegated to one shared module; observed ${formatChains({existence: existence.nonEntry, cacheKey: keyRead.nonEntry})}`
+  );
+});
+
+test('save obtains the discovered cache folder paths through the shared module that reads CACHE_KEY', async () => {
+  const discovery = await captureSaveDiscovery();
+  const keyRead = await captureSaveKeyRead();
+
+  const shared = intersection(discovery.nonEntry, keyRead.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected cache folder discovery and the CACHE_KEY read to be delegated to one shared module; observed ${formatChains({discovery: discovery.nonEntry, cacheKey: keyRead.nonEntry})}`
+  );
+});
+
+test('save does not read the primary key state inside the save entry module', async () => {
+  const keyRead = await captureSaveKeyRead();
+
+  assert.ok(
+    keyRead.innermost !== null && keyRead.innermost !== SAVE_ENTRY,
+    `expected the CACHE_KEY read to be delegated away from ${SAVE_ENTRY}; observed innermost=${keyRead.innermost} chain=[${keyRead.chain.join(', ')}]`
+  );
+});
+
+test('save does not perform the on-disk existence check inside the save entry module', async () => {
+  const existence = await captureSaveExistence();
+
+  assert.ok(
+    existence.innermost !== null && existence.innermost !== SAVE_ENTRY,
+    `expected on-disk existence reporting to be delegated away from ${SAVE_ENTRY}; observed innermost=${existence.innermost} chain=[${existence.chain.join(', ')}]`
+  );
+});
diff --git a/__tests__/f2p/cache-context-shared-f2p.test.mjs b/__tests__/f2p/cache-context-shared-f2p.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b855699c2055c90eec7fa5ead2ebf1d051e3d8dd
--- /dev/null
+++ b/__tests__/f2p/cache-context-shared-f2p.test.mjs
@@ -0,0 +1,91 @@
+// F2P structural nodes for the cross-consumer obligation of the consolidated
+// cache context.
+//
+// The consolidation is only real when restore and save consume the *same*
+// cohesive context instead of two parallel implementations. These nodes drive
+// both public entry points and require the responsibilities of both flows to
+// be owned by one shared module.
+import assert from 'node:assert/strict';
+
+import {test} from './harness.mjs';
+import {formatChains, intersection} from './ownership.mjs';
+import {
+  captureRestoreDiscovery,
+  captureRestoreHash,
+  captureRestoreKeyWrite,
+  captureRestorePackageManagerRejection,
+  captureSaveDiscovery,
+  captureSaveExistence,
+  captureSaveKeyRead,
+  RESTORED_KEY
+} from './scenarios.mjs';
+
+test('restore and save reach the cross-step cache key through the same shared module', async () => {
+  const saveKeyRead = await captureSaveKeyRead();
+  for (const restoredKey of ['', RESTORED_KEY]) {
+    const restoreHash = await captureRestoreHash(restoredKey);
+    const shared = intersection(restoreHash.nonEntry, saveKeyRead.nonEntry);
+    assert.ok(
+      shared.length > 0,
+      `expected restore primary key derivation and save cache state reading to be owned by one shared module; observed ${formatChains({restoreHash: restoreHash.nonEntry, saveCacheKey: saveKeyRead.nonEntry})}`
+    );
+    // The context owns metadata/state, not action reporting. Preserve the
+    // reports themselves while checking their owner on both a hit and a miss.
+    assert.equal(restoreHash.reporting.filter(item => item.name === 'debug').length, 1,
+      'restore must retain the existing primary-key diagnostic');
+    for (const report of restoreHash.reporting) {
+      assert.ok(report.innermost && !shared.includes(report.innermost),
+        `shared cache metadata/state access must not publish ${report.name} ${JSON.stringify(report.args)}; observed reporter=${report.innermost}, metadata/state owner=[${shared.join(', ')}]`);
+    }
+  }
+});
+
+test('the primary key written by restore and read by save is owned by the same shared module', async () => {
+  const restoreKeyWrite = await captureRestoreKeyWrite();
+  const saveKeyRead = await captureSaveKeyRead();
+
+  const shared = intersection(
+    restoreKeyWrite.nonEntry,
+    saveKeyRead.nonEntry
+  );
+  assert.ok(
+    shared.length > 0,
+    `expected the CACHE_KEY write of restore and the CACHE_KEY read of save to be owned by one shared module; observed ${formatChains({restoreCacheKey: restoreKeyWrite.nonEntry, saveCacheKey: saveKeyRead.nonEntry})}`
+  );
+});
+
+test('restore cache folder discovery and save existence reporting go through the same shared module', async () => {
+  const restoreDiscovery = await captureRestoreDiscovery();
+  const saveExistence = await captureSaveExistence();
+
+  const shared = intersection(
+    restoreDiscovery.nonEntry,
+    saveExistence.nonEntry
+  );
+  assert.ok(
+    shared.length > 0,
+    `expected restore cache folder discovery and save existence reporting to be owned by one shared module; observed ${formatChains({restoreDiscovery: restoreDiscovery.nonEntry, saveExistence: saveExistence.nonEntry})}`
+  );
+});
+
+test('save cache folder discovery and restore primary key derivation go through the same shared module', async () => {
+  const saveDiscovery = await captureSaveDiscovery();
+  const restoreHash = await captureRestoreHash();
+
+  const shared = intersection(saveDiscovery.nonEntry, restoreHash.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected save cache folder discovery and restore primary key derivation to be owned by one shared module; observed ${formatChains({saveDiscovery: saveDiscovery.nonEntry, restoreHash: restoreHash.nonEntry})}`
+  );
+});
+
+test('the package manager rejection module and save cache state read are the same shared module', async () => {
+  const rejection = await captureRestorePackageManagerRejection();
+  const saveKeyRead = await captureSaveKeyRead();
+
+  const shared = intersection(rejection.nonEntry, saveKeyRead.nonEntry);
+  assert.ok(
+    shared.length > 0,
+    `expected package manager resolution and the save cache state read to be owned by one shared module; observed ${formatChains({packageManager: rejection.nonEntry, saveCacheKey: saveKeyRead.nonEntry})}`
+  );
+});
diff --git a/__tests__/f2p/harness.mjs b/__tests__/f2p/harness.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..72ef1cba54ed668c089205682fe3b606db9975db
--- /dev/null
+++ b/__tests__/f2p/harness.mjs
@@ -0,0 +1,250 @@
+// Minimal dependency-free harness for the F2P nodes.
+//
+// It registers exact-leaf nodes, executes them with a per-node timeout and
+// emits a regular JUnit report. Assertions use the Node.js built-in
+// `node:assert/strict` module, so failures are tagged as AssertionError in the
+// report and no third-party test framework is required in the replay image.
+/* global setTimeout, clearTimeout */
+import fs from 'node:fs';
+import path from 'node:path';
+
+const registry = new Map();
+let currentFile = null;
+let ignoreUncaught = false;
+let pendingUncaught = null;
+
+export function setCurrentFile(file) {
+  currentFile = file;
+}
+
+export function test(name, fn) {
+  if (!currentFile) {
+    throw new Error('setCurrentFile() must be called before test()');
+  }
+  if (!registry.has(currentFile)) {
+    registry.set(currentFile, []);
+  }
+  registry.get(currentFile).push({file: currentFile, name, fn});
+}
+
+export function registeredNodes() {
+  return registry;
+}
+
+export function setIgnoreUncaught(value) {
+  ignoreUncaught = value;
+}
+
+export function recordUncaught(error) {
+  if (ignoreUncaught) {
+    return;
+  }
+  pendingUncaught = error;
+}
+
+function describeError(error) {
+  if (error instanceof Error) {
+    return {
+      message: error.message,
+      details: error.stack ?? `${error.name}: ${error.message}`,
+      type: error.name || 'Error'
+    };
+  }
+  const message = typeof error === 'string' ? error : JSON.stringify(error);
+  return {message, details: message, type: 'Error'};
+}
+
+async function withTimeout(promise, timeoutMs, name) {
+  let timer = null;
+  try {
+    return await Promise.race([
+      promise,
+      new Promise((_resolve, reject) => {
+        timer = setTimeout(() => {
+          const error = new Error(`F2P node timed out after ${timeoutMs}ms: ${name}`);
+          error.name = 'HarnessTimeoutError';
+          reject(error);
+        }, timeoutMs);
+      })
+    ]);
+  } finally {
+    if (timer) {
+      clearTimeout(timer);
+    }
+  }
+}
+
+export async function runNode(node, timeoutMs) {
+  const startedAt = Date.now();
+  const result = {
+    file: node.file,
+    name: node.name,
+    status: 'passed',
+    message: '',
+    details: '',
+    type: '',
+    durationMs: 0
+  };
+
+  pendingUncaught = null;
+  try {
+    await withTimeout(
+      Promise.resolve().then(() => node.fn()),
+      timeoutMs,
+      node.name
+    );
+    if (pendingUncaught) {
+      const described = describeError(pendingUncaught);
+      result.status = 'failed';
+      result.message = `uncaught exception: ${described.message}`;
+      result.details = described.details;
+      result.type = described.type;
+    }
+  } catch (error) {
+    const described = describeError(error);
+    result.status = 'failed';
+    result.message = described.message;
+    result.details = described.details;
+    result.type = described.type;
+  } finally {
+    pendingUncaught = null;
+  }
+
+  result.durationMs = Date.now() - startedAt;
+  return result;
+}
+
+export function errorResult(file, name, error) {
+  const described = describeError(error);
+  return {
+    file,
+    name,
+    status: 'failed',
+    message: described.message,
+    details: described.details,
+    type: described.type,
+    durationMs: 0
+  };
+}
+
+function xmlEscape(value) {
+  return String(value)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function xmlUnescape(value) {
+  return String(value)
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&apos;/g, "'")
+    .replace(/&amp;/g, '&');
+}
+
+function seconds(milliseconds) {
+  return (milliseconds / 1000).toFixed(3);
+}
+
+function testcaseXml(result) {
+  const attributes = [
+    `classname="${xmlEscape(result.file)}"`,
+    `name="${xmlEscape(result.name)}"`,
+    `file="${xmlEscape(result.file)}"`,
+    `time="${seconds(result.durationMs)}"`
+  ].join(' ');
+
+  if (result.status === 'passed') {
+    return `    <testcase ${attributes}/>`;
+  }
+
+  const failureAttributes = [
+    `message="${xmlEscape(result.message)}"`,
+    `type="${xmlEscape(result.type || 'Error')}"`
+  ].join(' ');
+  const details = xmlEscape(result.details || result.message);
+  return `    <testcase ${attributes}>\n      <failure ${failureAttributes}>${details}</failure>\n    </testcase>`;
+}
+
+export function writeJUnit(reportPath, results, name = 'setup-go-f2p') {
+  const byFile = new Map();
+  for (const result of results) {
+    if (!byFile.has(result.file)) {
+      byFile.set(result.file, []);
+    }
+    byFile.get(result.file).push(result);
+  }
+
+  const failures = results.filter(result => result.status !== 'passed').length;
+  const totalTime = results.reduce((sum, result) => sum + result.durationMs, 0);
+  const lines = [
+    '<?xml version="1.0" encoding="UTF-8"?>',
+    `<testsuites name="${xmlEscape(name)}" tests="${results.length}" failures="${failures}" errors="0" skipped="0" time="${seconds(totalTime)}">`
+  ];
+
+  for (const [file, fileResults] of byFile) {
+    const fileFailures = fileResults.filter(
+      result => result.status !== 'passed'
+    ).length;
+    const fileTime = fileResults.reduce(
+      (sum, result) => sum + result.durationMs,
+      0
+    );
+    lines.push(
+      `  <testsuite name="${xmlEscape(file)}" file="${xmlEscape(file)}" tests="${fileResults.length}" failures="${fileFailures}" errors="0" skipped="0" time="${seconds(fileTime)}">`
+    );
+    for (const result of fileResults) {
+      lines.push(testcaseXml(result));
+    }
+    lines.push('  </testsuite>');
+  }
+
+  lines.push('</testsuites>');
+  fs.mkdirSync(path.dirname(reportPath), {recursive: true});
+  fs.writeFileSync(reportPath, `${lines.join('\n')}\n`, 'utf8');
+}
+
+const TESTCASE = /<testcase\b([^>]*?)(?:\/>|>([\s\S]*?)<\/testcase>)/g;
+const ATTRIBUTE = /([A-Za-z_][\w.-]*)="([^"]*)"/g;
+const FAILURE = /<(failure|error)\b([^>]*?)(?:\/>|>([\s\S]*?)<\/\1>)/;
+
+function attributes(text) {
+  const values = {};
+  for (const match of String(text).matchAll(ATTRIBUTE)) {
+    values[match[1]] = xmlUnescape(match[2]);
+  }
+  return values;
+}
+
+// Parses a regular JUnit report produced by another runner (the frozen P2P
+// runner) into the same result rows this harness emits, so the aggregate
+// report can carry the frozen P2P and the F2P nodes in one file.
+export function parseJUnit(reportPath) {
+  const text = fs.readFileSync(reportPath, 'utf8');
+  const results = [];
+  for (const match of text.matchAll(TESTCASE)) {
+    const attrs = attributes(match[1]);
+    const body = match[2] ?? '';
+    const failure = FAILURE.exec(body);
+    const result = {
+      file: attrs.file ?? attrs.classname ?? 'unknown',
+      name: attrs.name ?? 'unknown',
+      status: failure ? 'failed' : 'passed',
+      message: '',
+      details: '',
+      type: '',
+      durationMs: Math.round(Number(attrs.time ?? 0) * 1000)
+    };
+    if (failure) {
+      const failureAttributes = attributes(failure[2]);
+      result.message = failureAttributes.message ?? '';
+      result.type = failureAttributes.type ?? 'Error';
+      result.details = xmlUnescape(failure[3] ?? '');
+    }
+    results.push(result);
+  }
+  return results;
+}
diff --git a/__tests__/f2p/loader-hooks.mjs b/__tests__/f2p/loader-hooks.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5299bd460186e7ccd53881f6d81ce9b15e19a243
--- /dev/null
+++ b/__tests__/f2p/loader-hooks.mjs
@@ -0,0 +1,61 @@
+// Node module customization hooks used by the F2P harness.
+//
+// The F2P nodes execute the production TypeScript sources in a replay image
+// that only ships the Node.js runtime (no node_modules, no network):
+//   1. `@actions/*` packages are redirected to the F2P stubs in ./stubs so the
+//      delegation chain of every cache responsibility can be observed;
+//   2. relative `./x.js` specifiers are redirected to `./x.ts` when only the
+//      TypeScript file exists;
+//   3. type-only imports get a runtime placeholder export so Node's
+//      syntax-only transform can link the modules.
+/* global URL, Buffer */
+import {
+  patchTypeOnlyImports,
+  resolveTypeScriptSpecifier
+} from './typescript-compat.mjs';
+
+const ACTIONS_STUBS = new Map([
+  ['@actions/cache', new URL('./stubs/actions-cache.mjs', import.meta.url).href],
+  ['@actions/core', new URL('./stubs/actions-core.mjs', import.meta.url).href],
+  ['@actions/exec', new URL('./stubs/actions-exec.mjs', import.meta.url).href],
+  ['@actions/glob', new URL('./stubs/actions-glob.mjs', import.meta.url).href],
+  [
+    '@actions/http-client',
+    new URL('./stubs/actions-http-client.mjs', import.meta.url).href
+  ],
+  ['@actions/io', new URL('./stubs/actions-io.mjs', import.meta.url).href],
+  [
+    '@actions/tool-cache',
+    new URL('./stubs/actions-tool-cache.mjs', import.meta.url).href
+  ]
+]);
+
+export async function resolve(specifier, context, nextResolve) {
+  const stub = ACTIONS_STUBS.get(specifier);
+  if (stub) {
+    return {url: stub, shortCircuit: true};
+  }
+
+  const typescript = resolveTypeScriptSpecifier(specifier, context.parentURL);
+  if (typescript) {
+    return {url: typescript, shortCircuit: true};
+  }
+
+  return nextResolve(specifier, context);
+}
+
+export async function load(url, context, nextLoad) {
+  const result = await nextLoad(url, context);
+  if (!url.endsWith('.ts')) {
+    return result;
+  }
+  const source =
+    typeof result.source === 'string'
+      ? result.source
+      : Buffer.from(result.source ?? '').toString('utf8');
+  const patched = patchTypeOnlyImports(source);
+  if (patched === source) {
+    return result;
+  }
+  return {...result, source: patched};
+}
diff --git a/__tests__/f2p/manifest.mjs b/__tests__/f2p/manifest.mjs
