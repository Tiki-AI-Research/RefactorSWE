+// Supplemental P2P regression nodes for the save (post step) side of the cache
+// context consolidation. Every node drives the public save entry point (`run`)
+// and asserts only user-visible contract facts that must stay unchanged: input
+// and state names, discovery behaviour, the complete unfiltered path list given
+// to the cache service, every early exit with its existing message, and the
+// early-exit flag semantics.
+/* global process */
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+import {test, setIgnoreUncaught} from './harness.mjs';
+import * as cache from './stubs/actions-cache.mjs';
+import * as core from './stubs/actions-core.mjs';
+import * as exec from './stubs/actions-exec.mjs';
+
+const {run} = await import('../../src/cache-save.js');
+
+const PRIMARY_KEY = 'setup-go-Linux-x64-ImageOS-ubuntu-22.04-go-1.13.1-file_hash';
+const MATCHED_KEY = 'setup-go-Linux-x64-ImageOS-ubuntu-22.04-go-1.13.0-other_hash';
+
+function resetStubs() {
+  core.__reset();
+  cache.__reset();
+  exec.__reset();
+}
+
+function makeDirectory() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'setup-go-p2p-'));
+}
+
+function missingPath() {
+  return path.join(makeDirectory(), 'missing-folder');
+}
+
+function setDiscovery(paths) {
+  const commands = ['go env GOMODCACHE', 'go env GOCACHE'];
+  exec.__setExecImpl(async commandLine => {
+    const index = commands.indexOf(commandLine);
+    if (index === -1) {
+      throw new Error(`unexpected discovery command: ${commandLine}`);
+    }
+    return {exitCode: 0, stdout: `${paths[index]}\n`, stderr: ''};
+  });
+}
+
+function setFailingDiscovery() {
+  exec.__setExecImpl(async commandLine => {
+    return {exitCode: 1, stdout: '', stderr: `${commandLine} failed`};
+  });
+}
+
+function enableCache() {
+  core.__setBooleanInput('cache', true);
+  core.__setState('CACHE_KEY', PRIMARY_KEY);
+  core.__setState('CACHE_RESULT', MATCHED_KEY);
+}
+
+function infoMessages() {
+  return core.__messages('info');
+}
+
+function warningMessages() {
+  return core.__messages('warning');
+}
+
+function allLogMessages() {
+  return [...core.__messages('warning'), ...core.__messages('info')];
+}
+
+async function withStubbedExit(fn) {
+  const originalExit = process.exit;
+  const codes = [];
+  process.exit = code => {
+    codes.push(code);
+  };
+  try {
+    await fn();
+  } finally {
+    process.exit = originalExit;
+  }
+  return codes;
+}
+
+test('save skips discovery and saving when the cache input is disabled', async () => {
+  resetStubs();
+  core.__setBooleanInput('cache', false);
+
+  await run();
+
+  assert.deepEqual(
+    core.__calls('getBooleanInput').map(call => call.args[0]),
+    ['cache']
+  );
+  assert.equal(exec.__calls('getExecOutput').length, 0);
+  assert.equal(cache.__calls('saveCache').length, 0);
+  assert.equal(warningMessages().length, 0);
+  assert.equal(core.__calls('setFailed').length, 0);
+});
+
+test('save warns and stops when every discovered cache folder is missing on disk', async () => {
+  resetStubs();
+  enableCache();
+  setDiscovery([missingPath(), missingPath()]);
+
+  await run();
+
+  assert.ok(warningMessages().includes('There are no cache folders on the disk'));
+  assert.equal(cache.__calls('saveCache').length, 0);
+  assert.equal(core.__calls('setFailed').length, 0);
+});
+
+test('save warns about a partially missing folder and still passes the complete path list to the cache service', async () => {
+  resetStubs();
+  enableCache();
+  const existing = makeDirectory();
+  const missing = missingPath();
+  setDiscovery([existing, missing]);
+
+  await run();
+
+  assert.ok(
+    allLogMessages().includes(
+      `[warning]Cache folder path is retrieved but doesn't exist on disk: ${missing}`
+    )
+  );
+  const saveCalls = cache.__calls('saveCache');
+  assert.equal(saveCalls.length, 1);
+  assert.deepEqual(saveCalls[0].args[0], [existing, missing]);
+  assert.equal(saveCalls[0].args[1], PRIMARY_KEY);
+  assert.ok(infoMessages().includes(`Cache saved with the key: ${PRIMARY_KEY}`));
+  assert.equal(core.__calls('setFailed').length, 0);
+});
+
+test('save stops without saving when the primary key state is missing', async () => {
+  resetStubs();
+  core.__setBooleanInput('cache', true);
+  core.__setState('CACHE_KEY', '');
+  core.__setState('CACHE_RESULT', MATCHED_KEY);
+  setDiscovery([makeDirectory(), makeDirectory()]);
+
+  await run();
+
+  assert.ok(
+    infoMessages().includes(
+      'Primary key was not generated. Please check the log messages above for more errors or information'
+    )
+  );
+  assert.equal(cache.__calls('saveCache').length, 0);
+  assert.equal(core.__calls('setFailed').length, 0);
+});
+
+test('save stops without saving when the primary key matches the restored key', async () => {
+  resetStubs();
+  core.__setBooleanInput('cache', true);
+  core.__setState('CACHE_KEY', PRIMARY_KEY);
+  core.__setState('CACHE_RESULT', PRIMARY_KEY);
+  setDiscovery([makeDirectory(), makeDirectory()]);
+
+  await run();
+
+  assert.ok(
+    infoMessages().includes(
+      `Cache hit occurred on the primary key ${PRIMARY_KEY}, not saving cache.`
+    )
+  );
+  assert.equal(cache.__calls('saveCache').length, 0);
+  assert.equal(core.__calls('setFailed').length, 0);
+});
+
+test('save treats a -1 cache id as a non-failure without reporting success', async () => {
+  resetStubs();
+  enableCache();
+  setDiscovery([makeDirectory(), makeDirectory()]);
+  cache.__setSaveImpl(async () => -1);
+
+  await run();
+
+  assert.ok(
+    core
+      .__messages('debug')
+      .includes(`Cache was not saved for the key: ${PRIMARY_KEY}`)
+  );
+  assert.equal(
+    infoMessages().includes(`Cache saved with the key: ${PRIMARY_KEY}`),
+    false
+  );
+  assert.equal(warningMessages().length, 0);
+  assert.equal(core.__calls('setFailed').length, 0);
+});
+
+test('save warns about a cache service failure and keeps the workflow successful', async () => {
+  resetStubs();
+  enableCache();
+  setDiscovery([makeDirectory(), makeDirectory()]);
+  cache.__setSaveImpl(async () => {
+    throw new Error('Unable to reach the service');
+  });
+
+  await run();
+
+  assert.ok(warningMessages().includes('Unable to reach the service'));
