+// nodes can prove which production module actually performs the responsibility
+// (the immediate caller frame) instead of inferring it from naming.
+import {nextSeq} from './call-log.mjs';
+
+const state = {
+  booleans: new Map(),
+  inputs: new Map(),
+  states: new Map(),
+  calls: [],
+  getStateImpl: null
+};
+
+function record(name, args) {
+  state.calls.push({
+    name,
+    args,
+    seq: nextSeq(),
+    stack: new Error(`f2p:${name}`).stack ?? ''
+  });
+}
+
+export function __reset() {
+  state.booleans.clear();
+  state.inputs.clear();
+  state.states.clear();
+  state.calls.length = 0;
+  state.getStateImpl = null;
+}
+
+export function __setBooleanInput(name, value) {
