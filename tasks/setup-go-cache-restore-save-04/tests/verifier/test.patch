+});
+
+test('restore resolves to undefined without a meaningful return value', async () => {
+  for (const restoredKey of ['', 'restored-key']) {
+    resetStubs();
+    cache.__setRestoreImpl(async () => restoredKey);
+    const result = await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
+    assert.equal(result, undefined,
+      `restore must resolve to undefined on a ${restoredKey ? 'hit' : 'miss'}`);
+  }
+});
+
+test('restore uses the provided dependency file path instead of the workspace default', async () => {
+  resetStubs();
+  const workspace = makeDirectory();
+  const dependencyPath = path.join(workspace, 'custom.sum');
