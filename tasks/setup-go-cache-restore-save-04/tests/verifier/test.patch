+  },
+  {
+    path: "__tests__/cache-restore.test.ts",
+    nodes: [
+      "should throw if dependency file path is not valid",
+      "should inform if cache hit is not occurred",
+      "should set output if cache hit is occurred",
+      "should throw if dependency file is not found in workspace",
+    ]
+  },
+  {
+    path: "__tests__/cache-save.test.ts",
+    nodes: [
+      "does not save cache when the cache input is false",
+      "does not save cache when there are no cache folders on the disk",
+      "does not save cache when the primary key was not generated",
+      "does not save cache when a cache hit occurred on the primary key",
+      "saves cache when the primary key differs from the matched key",
+      "save with -1 cacheId , should not fail workflow",
+      "saves with error from toolkit, should not fail workflow",
