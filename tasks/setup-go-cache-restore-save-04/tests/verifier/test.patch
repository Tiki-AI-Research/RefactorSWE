index 0000000000000000000000000000000000000000..f9a9a36aab0a75b0bef57ddbda8c86bd7fc6efdb
--- /dev/null
+++ b/__tests__/f2p/run-f2p.mjs
@@ -0,0 +1,420 @@
+// Aggregate F2P runner for the cache-context consolidation task.
+//
+// Usage (the pipeline substitutes the placeholders):
+//   node --experimental-transform-types --no-warnings __tests__/f2p/run-f2p.mjs \
+//     --report {report} --select {p2p_select} --config {config}
+//
+// The runner executes the frozen P2P selection through the frozen P2P runner
+// and the F2P nodes through the dependency-free F2P harness in this directory,
+// then writes one regular JUnit report that carries both sets of exact
+// selectors. It only uses the Node.js runtime, files inside this repository and
+// the dependencies already present in the image: no network, no installation.
+/* global process, console, URL */
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {spawnSync} from 'node:child_process';
+import {register} from 'node:module';
+import {fileURLToPath, pathToFileURL} from 'node:url';
+
+import {FROZEN_P2P_RUNNER, TEST_FILES} from './manifest.mjs';
+import {
+  errorResult,
+  parseJUnit,
+  recordUncaught,
+  registeredNodes,
+  runNode,
+  setCurrentFile,
+  writeJUnit
+} from './harness.mjs';
+
+const DEFAULT_NODE_TIMEOUT_MS = 10000;
+const DEFAULT_P2P_TIMEOUT_MS = 240000;
+const PLACEHOLDER = /\{[a-zA-Z0-9_]+\}/;
+
+function parseArguments(argv) {
+  const options = {report: null, select: null, config: null, selector: null};
+  const names = {
+    report: 'report',
+    select: 'select',
+    config: 'config',
+    selector: 'selector'
+  };
+  for (let index = 0; index < argv.length; index += 1) {
+    const argument = argv[index];
+    const withEquals = /^--(report|select|config|selector)=(.*)$/.exec(
+      argument
+    );
+    if (withEquals) {
+      options[names[withEquals[1]]] = withEquals[2];
+      continue;
+    }
+    const name = argument.startsWith('--') ? argument.slice(2) : null;
+    if (name && Object.prototype.hasOwnProperty.call(names, name)) {
+      options[names[name]] = argv[index + 1] ?? null;
+      index += 1;
+    }
+  }
+  return options;
+}
+
+function resolvePath(value, fallback) {
+  if (!value || PLACEHOLDER.test(value)) {
+    return fallback;
+  }
+  return path.isAbsolute(value) ? value : path.resolve(process.cwd(), value);
+}
+
+// Resolves a possibly relative placeholder value against the current working
+// directory first and the repository root second, matching how the frozen
+// runner resolves the materialized plan files.
+function resolveExistingPath(value, repoRoot) {
+  if (!value || PLACEHOLDER.test(value)) {
+    return null;
+  }
+  const candidates = path.isAbsolute(value)
+    ? [value]
+    : [path.resolve(process.cwd(), value), path.resolve(repoRoot, value)];
+  for (const resolved of candidates) {
+    try {
+      if (fs.existsSync(resolved) && fs.statSync(resolved).isFile()) {
+        return resolved;
+      }
+    } catch {
+      // try the next candidate
+    }
+  }
+  return null;
+}
+
+function readTextFile(filePath, repoRoot) {
+  if (!filePath || PLACEHOLDER.test(filePath)) {
+    return null;
+  }
+  const candidates = path.isAbsolute(filePath)
+    ? [filePath]
+    : [path.resolve(process.cwd(), filePath), path.resolve(repoRoot, filePath)];
+  for (const resolved of candidates) {
+    try {
+      if (fs.existsSync(resolved) && fs.statSync(resolved).isFile()) {
+        return fs.readFileSync(resolved, 'utf8');
+      }
+    } catch {
+      // try the next candidate
+    }
+  }
+  return null;
+}
+
+function selectorsFromText(text) {
+  const trimmed = String(text ?? '').trim();
+  if (!trimmed) {
+    return [];
+  }
+  if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
+    try {
+      return collectSelectors(JSON.parse(trimmed));
+    } catch {
+      // fall through to line based parsing
+    }
+  }
+  return trimmed
+    .split(/\r?\n/)
+    .map(line => line.trim())
+    .filter(line => line && !line.startsWith('#'))
+    .map(line => line.replace(/\s+#.*$/, '').trim())
+    .filter(line => line.includes('::'));
+}
+
+function collectSelectors(value, rows = []) {
+  if (Array.isArray(value)) {
+    for (const item of value) {
+      collectSelectors(item, rows);
+    }
+    return rows;
+  }
+  if (value && typeof value === 'object') {
+    if (typeof value.selector === 'string' && value.selector.includes('::')) {
+      rows.push(value.selector);
+    }
+    for (const item of Object.values(value)) {
+      collectSelectors(item, rows);
+    }
+  }
+  return rows;
+}
+
+// The frozen P2P runner declares its own supplemental and restored original
+// nodes; anything else has to stay out of its selection so the merged report
+// never gains a spurious "not declared" failure for an F2P selector.
+function frozenDeclaredSelectors(repoRoot) {
+  const declared = new Set();
+  try {
+    const manifestPath = path.join(
+      repoRoot,
+      '__tests__',
+      'p2p',
+      'manifest.mjs'
+    );
+    const text = fs.readFileSync(manifestPath, 'utf8');
+    for (const match of text.matchAll(/path:\s*['\"]([^'\"]+)['\"]/g)) {
+      declared.add(match[1]);
+    }
+    const inventoryPath = path.join(
+      repoRoot,
+      '__tests__',
+      'p2p',
+      'original-inventory.mjs'
+    );
+    const inventory = fs.readFileSync(inventoryPath, 'utf8');
+    for (const match of inventory.matchAll(/path:\s*['\"]([^'\"]+)['\"]/g)) {
+      declared.add(match[1]);
+    }
+  } catch {
+    // without the frozen manifests the selection is passed through unchanged
+    return null;
+  }
+  return declared;
+}
+
+function temporaryDirectory(reportPath) {
+  const candidates = [process.env.TMPDIR, os.tmpdir(), path.dirname(reportPath)];
+  for (const candidate of candidates) {
+    if (!candidate) {
+      continue;
+    }
+    try {
+      fs.accessSync(candidate, fs.constants.W_OK);
+      return candidate;
+    } catch {
+      // try the next candidate
+    }
+  }
+  return path.dirname(reportPath);
+}
+
+function runFrozenP2P(repoRoot, options, reportPath, declared) {
+  const runnerPath = path.join(repoRoot, FROZEN_P2P_RUNNER);
+  if (!fs.existsSync(runnerPath)) {
+    return {
+      results: [],
+      infrastructureError: new Error(
+        `frozen P2P runner is not available: ${FROZEN_P2P_RUNNER}`
+      )
+    };
+  }
+
+  const selectText = readTextFile(options.select, repoRoot);
+  const configText = readTextFile(options.config, repoRoot);
+  let selected = selectText !== null ? selectorsFromText(selectText) : [];
+  if (!selected.length && configText !== null) {
+    selected = selectorsFromText(configText);
+  }
+  if (options.selector) {
+    selected = selected.includes(options.selector) ? [options.selector] : [];
+  }
+  if (declared) {
+    selected = selected.filter(selector =>
+      declared.has(selector.split('::')[0])
+    );
+  }
+
+  const temporary = temporaryDirectory(reportPath);
+  const childReport = path.join(
+    temporary,
+    `setup-go-f2p-p2p-${process.pid}-${Date.now()}.xml`
+  );
+  const args = [
+    '--experimental-transform-types',
+    '--no-warnings',
+    FROZEN_P2P_RUNNER,
+    '--report',
+    childReport
+  ];
+
+  let selectFile = null;
+  if (selected.length) {
+    selectFile = path.join(
+      temporary,
+      `setup-go-f2p-select-${process.pid}-${Date.now()}.txt`
+    );
+    fs.writeFileSync(selectFile, `${selected.join('\n')}\n`, 'utf8');
+    args.push('--select', selectFile);
+  }
+  const resolvedConfig = resolveExistingPath(options.config, repoRoot);
+  if (resolvedConfig) {
+    args.push('--config', resolvedConfig);
+  }
+
+  const completed = spawnSync(process.execPath, args, {
+    cwd: repoRoot,
+    env: {...process.env},
+    encoding: 'utf8',
+    timeout: DEFAULT_P2P_TIMEOUT_MS,
+    maxBuffer: 64 * 1024 * 1024
+  });
+  const log = `${completed.stdout ?? ''}${completed.stderr ?? ''}`.trim();
+  if (log) {
+    console.log(log);
+  }
+
+  if (!fs.existsSync(childReport)) {
+    return {
+      results: [],
+      infrastructureError:
+        completed.error ??
+        new Error(
+          `the frozen P2P runner did not write a report (exit code ${completed.status})`
+        )
+    };
+  }
+
+  let results = parseJUnit(childReport);
+  try {
+    fs.unlinkSync(childReport);
+  } catch {
+    // leaving the temporary report behind is harmless
+  }
+  if (selectFile) {
+    try {
+      fs.unlinkSync(selectFile);
+    } catch {
+      // leaving the temporary selection behind is harmless
+    }
+  }
+  if (options.selector) {
+    results = results.filter(
+      result => `${result.file}::${result.name}` === options.selector
+    );
+  }
+  if (!results.length && !options.selector) {
+    return {
+      results,
+      infrastructureError: new Error(
+        'the frozen P2P runner wrote an empty report'
+      )
+    };
+  }
+  return {results, infrastructureError: null};
+}
+
+async function loadF2PNodes(repoRoot) {
+  register('./loader-hooks.mjs', import.meta.url);
+  const importErrors = new Map();
+  for (const file of TEST_FILES) {
+    setCurrentFile(file.path);
+    try {
+      await import(pathToFileURL(path.join(repoRoot, file.path)).href);
+    } catch (error) {
+      importErrors.set(file.path, error);
+    }
+  }
+  return importErrors;
+}
+
+function expectedF2PNodes(importErrors) {
+  const nodes = [];
+  for (const file of TEST_FILES) {
+    const registered = registeredNodes().get(file.path) ?? [];
+    const byName = new Map(registered.map(node => [node.name, node]));
+    for (const name of file.nodes) {
+      const node = byName.get(name);
+      if (node && !importErrors.has(file.path)) {
+        nodes.push({file: file.path, name, fn: node.fn});
+      } else {
+        nodes.push({
+          file: file.path,
+          name,
+          fn: null,
+          importError:
+            importErrors.get(file.path) ??
+            new Error(`node is not registered by ${file.path}`)
+        });
+      }
+    }
+  }
+  return nodes;
+}
+
+async function main() {
+  const scriptDirectory = path.dirname(fileURLToPath(import.meta.url));
+  const repoRoot = path.resolve(scriptDirectory, '..', '..');
+  const options = parseArguments(process.argv.slice(2));
+  const reportPath = resolvePath(
+    options.report,
+    path.join(process.cwd(), 'f2p-report.xml')
+  );
+  const nodeTimeoutMs = Number(
+    process.env.F2P_NODE_TIMEOUT_MS ?? DEFAULT_NODE_TIMEOUT_MS
+  );
+
+  const declared = frozenDeclaredSelectors(repoRoot);
+  const frozenRun = runFrozenP2P(repoRoot, options, reportPath, declared);
+
+  const importErrors = await loadF2PNodes(repoRoot);
+  const nodes = expectedF2PNodes(importErrors).filter(node => {
+    if (!options.selector) {
+      return true;
+    }
+    return `${node.file}::${node.name}` === options.selector;
+  });
+
+  const results = [...frozenRun.results];
+  for (const node of nodes) {
+    if (!node.fn) {
+      results.push(errorResult(node.file, node.name, node.importError));
+      continue;
+    }
+    results.push(await runNode(node, nodeTimeoutMs));
+  }
+
+  if (options.selector && !results.length) {
+    const [file, ...leaf] = options.selector.split('::');
+    results.push(
+      errorResult(
+        file,
+        leaf.join('::') || options.selector,
+        new Error(
+          `selected node is not declared by this runner: ${options.selector}`
+        )
+      )
+    );
+  }
+
+  writeJUnit(reportPath, results);
+
+  const failed = results.filter(result => result.status !== 'passed');
+  const selectionLabel = options.selector
+    ? `selector ${options.selector}`
+    : `all ${results.length} declared node(s)`;
+  console.log(
+    `[f2p] ran ${results.length} node(s) (${selectionLabel}); ${results.length - failed.length} passed, ${failed.length} failed`
+  );
+  for (const result of failed) {
+    console.log(`[f2p] FAIL ${result.file}::${result.name}: ${result.message}`);
+  }
+  console.log(`[f2p] JUnit report written to ${reportPath}`);
+
+  if (frozenRun.infrastructureError) {
+    console.error(
+      `[f2p] frozen P2P engine unavailable: ${frozenRun.infrastructureError.message}`
+    );
+    process.exitCode = 1;
+  }
+}
+
+process.on('uncaughtException', error => {
+  recordUncaught(error);
+});
+process.on('unhandledRejection', error => {
+  recordUncaught(error instanceof Error ? error : new Error(String(error)));
+});
+
+try {
+  await main();
+} catch (error) {
+  console.error(
+    `[f2p] runner failed before writing the report: ${error?.stack ?? error}`
+  );
+  process.exitCode = 1;
+}
diff --git a/__tests__/f2p/scenarios.mjs b/__tests__/f2p/scenarios.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..798d28f3a32482452047f54c56abe6000eb26585
--- /dev/null
+++ b/__tests__/f2p/scenarios.mjs
@@ -0,0 +1,298 @@
+// Reusable public-entry scenarios for the F2P cache-context nodes.
+//
+// Every scenario drives a frozen public entry point (`restoreCache` or the save
+// `run`) with the toolkit stubbed and returns the delegation chain recorded at
+// the responsibility boundary. The chain is what proves which production
+// module actually performed the responsibility; the entry points themselves
+// keep their frozen observable behaviour, so behaviour alone cannot show the
+// consolidation.
+/* global process */
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+import * as cache from './stubs/actions-cache.mjs';
+import * as core from './stubs/actions-core.mjs';
+import * as exec from './stubs/actions-exec.mjs';
+import * as glob from './stubs/actions-glob.mjs';
+import {
+  RESTORE_ENTRY,
+  SAVE_ENTRY,
+  productionChain
+} from './ownership.mjs';
+
+const {restoreCache} = await import('../../src/cache-restore.js');
+const {run} = await import('../../src/cache-save.js');
+
+export const VERSION_SPEC = '1.13.1';
+export const FILE_HASH = 'file_hash';
+export const DEPENDENCY_FILE = 'go.sum';
+export const RESTORED_KEY = 'setup-go-restored-key';
+export const PRIMARY_KEY =
+  'setup-go-Linux-x64-ubuntu-22.04-go-1.13.1-file_hash';
+export const MATCHED_KEY = 'setup-go-Linux-x64-ubuntu-22.04-go-1.13.0-other_hash';
+
+export function makeDirectory() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'setup-go-f2p-'));
+}
+
+function summary(stack, entry) {
+  const chain = productionChain(stack);
+  return {
+    chain,
+    nonEntry: chain.filter(module => module !== entry),
+    innermost: chain[0] ?? null
+  };
+}
+
+function emptySummary() {
+  return {chain: [], nonEntry: [], innermost: null};
+}
+
+function discoverySummary(entry, service, paths) {
+  const calls = exec.__calls('getExecOutput');
+  assert.deepEqual(
+    calls.map(call => call.args[0]).sort(),
+    ['go env GOCACHE', 'go env GOMODCACHE'],
+    'each flow must discover each configured cache folder exactly once'
+  );
+  const serviceCalls = cache.__calls(service);
+  assert.equal(serviceCalls.length, 1);
+  assert.deepEqual(serviceCalls[0].args[0], paths,
+    'the cache service must consume the complete discovered paths');
+  assert.ok(calls.every(call => call.seq < serviceCalls[0].seq));
+
+  // Every discovery boundary must share an owner. A correct first stack must
+  // not hide a second independent discovery implementation.
+  const observations = calls.map(call => summary(call.stack, entry));
+  return {
+    chain: [...new Set(observations.flatMap(item => item.chain))],
+    nonEntry: observations.reduce(
+      (shared, item) => shared.filter(module => item.nonEntry.includes(module)),
+      observations[0].nonEntry
+    ),
+    innermost: observations[0].innermost
+  };
+}
+
+export function resetStubs({
+  hash = FILE_HASH,
+  discovery = ['/gomodcache', '/gocache']
+} = {}) {
+  core.__reset();
+  cache.__reset();
+  exec.__reset();
+  glob.__reset();
+  glob.__setHashFilesImpl(async () => hash);
+  const commands = ['go env GOMODCACHE', 'go env GOCACHE'];
+  exec.__setExecImpl(async commandLine => {
+    const index = commands.indexOf(commandLine);
+    if (index === -1) {
+      return {
+        exitCode: 1,
+        stdout: '',
+        stderr: `unexpected discovery command: ${commandLine}`
+      };
+    }
+    return {exitCode: 0, stdout: `${discovery[index]}\n`, stderr: ''};
+  });
+}
+
+async function withEnvironment(values, fn) {
+  const saved = {};
+  for (const [name, value] of Object.entries(values)) {
+    saved[name] = process.env[name];
+    if (value === undefined) {
+      delete process.env[name];
+    } else {
+      process.env[name] = value;
+    }
+  }
+  try {
+    return await fn();
+  } finally {
+    for (const [name, value] of Object.entries(saved)) {
+      if (value === undefined) {
+        delete process.env[name];
+      } else {
+        process.env[name] = value;
+      }
+    }
+  }
+}
+
+async function captureRejection(fn) {
+  try {
+    await fn();
+  } catch (error) {
+    return error instanceof Error ? error : new Error(String(error));
+  }
+  return null;
+}
+
+// ---- restore consumer -----------------------------------------------------
+
+export async function captureRestoreDiscovery() {
+  resetStubs();
+  await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
+  return discoverySummary(RESTORE_ENTRY, 'restoreCache', ['/gomodcache', '/gocache']);
+}
+
+export async function captureRestoreHash(restoredKey = '') {
+  resetStubs();
+  cache.__setRestoreImpl(async () => restoredKey);
+  await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
+  const call = glob.__calls('hashFiles').at(-1);
+  const primaryKey = core.__calls('saveState').find(
+    item => item.args[0] === 'CACHE_KEY'
+  )?.args[1];
+  // Identify action reporting at the toolkit boundary, not by any production
+  // class, method, property or module name. Keep the real event and its caller.
+  const reporting = core.__allCalls().filter(item =>
+    item.name === 'debug' && item.args[0] === `primary key is ${primaryKey}`
+  ).map(item => ({
+    name: item.name, args: item.args,
+    ...summary(item.stack, RESTORE_ENTRY)
+  }));
+  return {
+    ...(call ? summary(call.stack, RESTORE_ENTRY) : emptySummary()),
+    reporting
+  };
+}
+
+export async function captureRestoreKeyWrite() {
+  resetStubs();
+  await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
+  const call = core
+    .__calls('saveState')
+    .find(entry => entry.args[0] === 'CACHE_KEY');
+  return call ? summary(call.stack, RESTORE_ENTRY) : emptySummary();
+}
+
+export async function captureRestoreMatchedWrite() {
+  resetStubs();
+  cache.__setRestoreImpl(async () => RESTORED_KEY);
+  await restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE);
+  const call = core
+    .__calls('saveState')
+    .find(entry => entry.args[0] === 'CACHE_RESULT');
+  return call ? summary(call.stack, RESTORE_ENTRY) : emptySummary();
+}
+
+export async function captureRestorePackageManagerRejection() {
+  resetStubs();
+  const error = await captureRejection(() =>
+    restoreCache(VERSION_SPEC, 'unknown-package-manager', DEPENDENCY_FILE)
+  );
+  return error ? summary(error.stack, RESTORE_ENTRY) : emptySummary();
+}
+
+export async function captureRestoreMissingDependencyFile() {
+  resetStubs();
+  const workspace = makeDirectory();
+  const error = await withEnvironment({GITHUB_WORKSPACE: workspace}, () =>
+    captureRejection(() => restoreCache(VERSION_SPEC, 'default'))
+  );
+  return error ? summary(error.stack, RESTORE_ENTRY) : emptySummary();
+}
+
+export async function captureRestoreEmptyHash() {
+  resetStubs({hash: ''});
+  const error = await captureRejection(() =>
+    restoreCache(VERSION_SPEC, 'default', DEPENDENCY_FILE)
+  );
+  return error ? summary(error.stack, RESTORE_ENTRY) : emptySummary();
+}
+
+// ---- save consumer --------------------------------------------------------
+
+function prepareSave({discovery}) {
+  resetStubs({discovery});
+  core.__setBooleanInput('cache', true);
+  core.__setState('CACHE_KEY', PRIMARY_KEY);
+  core.__setState('CACHE_RESULT', MATCHED_KEY);
+  cache.__setSaveImpl(async () => 0);
+}
+
+async function runSave() {
+  const originalExit = process.exit;
+  process.exit = () => {};
+  try {
+    await run(false);
+  } finally {
+    process.exit = originalExit;
+  }
+}
+
+export async function captureSaveDiscovery() {
+  const discovery = [makeDirectory(), makeDirectory()];
+  prepareSave({discovery});
+  await runSave();
+  return discoverySummary(SAVE_ENTRY, 'saveCache', discovery);
+}
+
+export async function captureSaveKeyRead() {
+  const discovery = [makeDirectory(), makeDirectory()];
+  prepareSave({discovery});
+  await runSave();
+  const call = core
+    .__calls('getState')
+    .find(entry => entry.args[0] === 'CACHE_KEY');
+  return call ? summary(call.stack, SAVE_ENTRY) : emptySummary();
+}
+
+export async function captureSaveMatchedRead() {
+  const discovery = [makeDirectory(), makeDirectory()];
+  prepareSave({discovery});
+  await runSave();
+  const call = core
+    .__calls('getState')
+    .find(entry => entry.args[0] === 'CACHE_RESULT');
+  return call ? summary(call.stack, SAVE_ENTRY) : emptySummary();
+}
+
+export async function captureSaveExistence() {
+  const discovery = [makeDirectory(), makeDirectory()];
+  prepareSave({discovery});
+  const realExistsSync = fs.existsSync;
+  const observed = [];
+  fs.existsSync = function existsSync(target, ...rest) {
+    observed.push({
+      target: String(target),
+      stack: new Error('f2p:existsSync').stack ?? ''
+    });
+    return realExistsSync.call(this, target, ...rest);
+  };
+  try {
+    await runSave();
+  } finally {
+    fs.existsSync = realExistsSync;
+  }
+  const call = observed.find(entry => discovery.includes(entry.target));
+  return call ? summary(call.stack, SAVE_ENTRY) : emptySummary();
+}
+
+// A primary-state failure is a failed prerequisite, not an invitation to read
+// restore-match metadata. Exercise the real save entry with either one or both
+// state sources unavailable; a secondary error must not mask the primary one.
+export async function captureSavePrimaryStateFailure(matchedStateFails = false) {
+  const discovery = [makeDirectory(), makeDirectory()];
+  prepareSave({discovery});
+  core.__setGetStateImpl(name => {
+    if (name === 'CACHE_KEY') {
+      throw new Error('cache identity unavailable');
+    }
+    if (name === 'CACHE_RESULT' && matchedStateFails) {
+      throw new Error('restore match unavailable');
+    }
+    return MATCHED_KEY;
+  });
+  await runSave();
+  return {
+    reads: core.__calls('getState').map(call => call.args[0]),
+    warnings: core.__messages('warning'),
+    saves: cache.__calls('saveCache').length,
+    failures: core.__calls('setFailed').length
+  };
+}
