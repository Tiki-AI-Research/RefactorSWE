+import fs from 'fs';
+import path from 'path';
+import * as glob from '@actions/glob';
+import * as core from '@actions/core';
+import {State} from './constants.js';
+import {PackageManagerInfo} from './package-managers.js';
+import {getCacheDirectoryPath, getPackageManagerInfo} from './cache-utils.js';
+
+export class CacheContext {
+  private _packageManagerInfo: PackageManagerInfo;
+  private _cachePaths: string[];
+
+  constructor(packageManagerInfo: PackageManagerInfo, cachePaths: string[]) {
+    this._packageManagerInfo = packageManagerInfo;
+    this._cachePaths = cachePaths;
+  }
+
+  static async create(packageManager = 'default'): Promise<CacheContext> {
+    const packageManagerInfo = await getPackageManagerInfo(packageManager);
+    const cachePaths = await getCacheDirectoryPath(packageManagerInfo);
+    return new CacheContext(packageManagerInfo, cachePaths);
+  }
+
+  get packageManagerInfo(): PackageManagerInfo {
+    return this._packageManagerInfo;
+  }
+
+  get cachePaths(): string[] {
+    return this._cachePaths;
+  }
+
+  getNonExistingPaths(): string[] {
+    return this._cachePaths.filter(cachePath => !fs.existsSync(cachePath));
+  }
+
+  async derivePrimaryKey(
+    versionSpec: string,
+    cacheDependencyPath?: string
+  ): Promise<string> {
+    const dependencyFilePath = cacheDependencyPath
+      ? cacheDependencyPath
+      : this.findDependencyFile();
+    const fileHash = await glob.hashFiles(dependencyFilePath);
+
+    if (!fileHash) {
+      throw new Error(
+        'Some specified paths were not resolved, unable to cache dependencies.'
+      );
+    }
+
+    return this.computePrimaryKey(versionSpec, fileHash);
+  }
+
+  private findDependencyFile(): string {
+    const dependencyFile = this._packageManagerInfo.dependencyFilePattern;
+    const workspace = process.env.GITHUB_WORKSPACE!;
+    const rootContent = fs.readdirSync(workspace);
+
+    const goModFileExists = rootContent.includes(dependencyFile);
+    if (!goModFileExists) {
+      throw new Error(
+        `Dependencies file is not found in ${workspace}. Supported file pattern: ${dependencyFile}`
+      );
+    }
+
+    return path.join(workspace, dependencyFile);
+  }
+
+  computePrimaryKey(versionSpec: string, fileHash: string): string {
+    const platform = process.env.RUNNER_OS;
+    const arch = process.arch;
+    const linuxVersion =
+      process.env.RUNNER_OS === 'Linux' ? `${process.env.ImageOS}-` : '';
+    return `setup-go-${platform}-${arch}-${linuxVersion}go-${versionSpec}-${fileHash}`;
+  }
+
+  getPrimaryKey(): string {
+    return core.getState(State.CachePrimaryKey);
+  }
+
+  getMatchedKey(): string {
+    return core.getState(State.CacheMatchedKey);
+  }
+
+  savePrimaryKey(primaryKey: string): void {
+    core.saveState(State.CachePrimaryKey, primaryKey);
+  }
+
+  saveMatchedKey(matchedKey: string): void {
+    core.saveState(State.CacheMatchedKey, matchedKey);
+  }
+}
