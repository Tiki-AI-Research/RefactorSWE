+    def test_param_accessors_world_owner_first_env_global(self):
+        """EnvPlot._world_param is owner-first; EnvPlot._env_param is always global."""
+        from types import SimpleNamespace
+
+        from irsim.config import env_param, world_param
+        from irsim.config.world_param import WorldParam
+        from irsim.world.world import World
+
+        wp = WorldParam()
+        world = World(world_param_instance=wp)
+        plot = EnvPlot(world)
+
+        try:
+            # World with _wp returns world._wp
+            assert plot._world_param is world._wp
+            assert plot._world_param is wp
+
+            # Even if world has an _env, EnvPlot._env_param remains the global module
+            world._env = SimpleNamespace(_env_param=SimpleNamespace())
+            assert plot._env_param is env_param
+
+            # If world has no _wp, EnvPlot._world_param falls back to the global module
+            plot.world = SimpleNamespace()
+            assert plot._world_param is world_param
+        finally:
+            plot.close()
+
 
