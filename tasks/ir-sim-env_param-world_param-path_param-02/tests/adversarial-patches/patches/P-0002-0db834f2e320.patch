index 0000000000000000000000000000000000000000..0c23488e0bd591433642b14241d74b4ae4ac3e03
--- /dev/null
+++ b/irsim/config/param_storage.py
@@ -0,0 +1,129 @@
+"""Shared parameter storage and proxy abstraction for IR-SIM configuration modules."""
+
+from __future__ import annotations
+
+import importlib
+from dataclasses import fields
+from types import ModuleType
+from typing import Any, Generic, TypeVar
+
+T = TypeVar("T")
+
+
+class ParamStorage(Generic[T]):
+    """Centralized parameter storage, binding, and indexing engine."""
+
+    def __init__(
+        self,
+        module: ModuleType,
+        param_cls: type[T],
+        module_name: str,
+    ) -> None:
+        self.module = module
+        self.param_cls = param_cls
+        self.module_name = module_name
+        self.param_fields = frozenset(f.name for f in fields(param_cls))
+
+        initial_instance = param_cls()
+        self.module._instances = [initial_instance]
+        self.module._current = initial_instance
+
+    @property
+    def instances(self) -> list[T]:
+        return self.module._instances
+
+    @instances.setter
+    def instances(self, val: list[T]) -> None:
+        self.module._instances = val
+
+    @property
+    def current(self) -> T:
+        return self.module._current
+
+    @current.setter
+    def current(self, val: T) -> None:
+        self.module._current = val
+
+    def bind(self, instance: T) -> None:
+        """Bind instance to default index 0 and update current alias."""
+        insts = self.instances
+        if insts:
+            insts[0] = instance
+        else:
+            insts.append(instance)
+        self.current = instance
+
+    def get_item(self, index: int) -> T:
+        """Get instance at index using list semantics (negative resolves from tail)."""
+        return self.instances[index]
+
+    def set_item(self, index: int, instance: T) -> None:
+        """Assign instance at non-negative index, extending storage if needed."""
+        if index < 0:
+            raise IndexError(f"{self.module_name} index must be non-negative")
+        insts = self.instances
+        if index >= len(insts):
+            insts.extend(self.param_cls() for _ in range(index - len(insts) + 1))
+        insts[index] = instance
+        if index == 0:
+            self.current = instance
+
+    def install_as_module(self) -> None:
+        """Install ParamModule on the underlying module."""
+        self.module._storage = self
+        self.module.__class__ = ParamModule
+
+
+class ParamModule(ModuleType):
+    """Module proxy routing parameter attributes and indexing to a ParamStorage."""
+
+    _storage: ParamStorage
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._storage.current, name)
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        storage = getattr(self, "_storage", None)
+        if storage is not None and name in storage.param_fields:
+            setattr(storage.current, name, value)
+        else:
+            super().__setattr__(name, value)
+
+    def __getitem__(self, index: int) -> Any:
+        return self._storage.get_item(index)
+
+    def __setitem__(self, index: int, instance: Any) -> None:
+        self._storage.set_item(index, instance)
+
+
+class PathManagerProxy:
+    """Attribute proxy forwarding reads and writes to the bound PathManager."""
+
+    def __init__(self, storage: ParamStorage) -> None:
+        self._storage = storage
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._storage.current, name)
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        if name == "_storage":
+            super().__setattr__(name, value)
+        else:
+            setattr(self._storage.current, name, value)
+
+
+def resolve_param(
+    owner: Any,
+    attr_name: str,
+    module_name: str,
+    *,
+    missing_ok: bool = False,
+) -> Any:
+    """Resolve a parameter instance preferring an owner, falling back to the global module."""
+    if owner is not None:
+        if missing_ok:
+            if hasattr(owner, attr_name):
+                return getattr(owner, attr_name)
+        else:
+            return getattr(owner, attr_name)
+    return importlib.import_module(f"irsim.config.{module_name}")
