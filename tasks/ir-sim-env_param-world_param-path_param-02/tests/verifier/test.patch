+++ b/tests/f2p_runner.py
@@ -0,0 +1,156 @@
+"""Aggregate execution shim for the frozen P2P and F2P selectors.
+
+The replay image provides the project's locked dependencies either in a
+repository-local ``.venv`` or in the warm ``uv`` package cache.  This shim
+resolves the first interpreter that can import pytest together with the
+project modules exercised by the selectors, runs every selector passed on the
+command line with pytest and writes the JUnit report required by the plan
+command.  It only uses files already present in the repository and the image.
+"""
+
+from __future__ import annotations
+
+import glob
+import os
+import shutil
+import subprocess
+import sys
+
+IMPORT_CHECK = (
+    "import pytest, irsim; "
+    "from irsim.config import env_param, path_param, world_param; "
+    "from irsim.env.env_plot import EnvPlot; "
+    "from irsim.gui.keyboard_control import KeyboardControl; "
+    "from irsim.world.object_base import ObjectBase; "
+    "from irsim.world.sensors.lidar2d import Lidar2D; "
+    "from irsim.world.world import World"
+)
+
+CACHE_ROOTS = (
+    "/root/.cache/uv",
+    "/home/agent/.cache/uv",
+    "/workspace/.uv-cache",
+)
+
+
+def repo_root() -> str:
+    """Return the repository root that contains this shim's tests directory."""
+    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def cached_site_dirs() -> str:
+    """Return a PYTHONPATH for the unpacked packages of the image's uv cache."""
+    roots = []
+    env_cache = os.environ.get("UV_CACHE_DIR")
+    if env_cache:
+        roots.append(env_cache)
+    roots.extend(CACHE_ROOTS)
+    roots.append(os.path.join(os.path.expanduser("~"), ".cache", "uv"))
+
+    entries = []
+    for root in dict.fromkeys(roots):
+        pattern = os.path.join(root, "archive-v0", "*")
+        for path in sorted(glob.glob(pattern)):
+            if os.path.isdir(path):
+                entries.append(path)
+    return os.pathsep.join(entries)
+
+
+def interpreter_candidates(root: str) -> list[str]:
+    """Return existing interpreter paths to probe, most specific first."""
+    candidates = []
+    for variable in ("F2P_PYTHON", "P2P_PYTHON"):
+        env_python = os.environ.get(variable)
+        if env_python:
+            candidates.append(env_python)
+    candidates.extend(
+        [
+            os.path.join(root, ".venv", "bin", "python"),
+            os.path.join(os.path.dirname(root), ".venv", "bin", "python"),
+            "/workspace/repo/.venv/bin/python",
+            sys.executable,
+        ]
+    )
+    for name in ("python3", "python"):
+        found = shutil.which(name)
+        if found:
+            candidates.append(found)
+    return [path for path in dict.fromkeys(candidates) if path and os.path.exists(path)]
+
+
+def resolve_interpreter(root: str) -> tuple[str | None, dict[str, str] | None]:
+    """Probe interpreters and return the first one that can run the tests."""
+    cache_path = cached_site_dirs()
+    for use_cache in (False, True):
+        if use_cache and not cache_path:
+            continue
+        for candidate in interpreter_candidates(root):
+            env = dict(os.environ)
+            if use_cache:
+                existing = env.get("PYTHONPATH")
+                env["PYTHONPATH"] = cache_path + (
+                    os.pathsep + existing if existing else ""
+                )
+            try:
+                probe = subprocess.run(
+                    [candidate, "-c", IMPORT_CHECK],
+                    cwd=root,
+                    env=env,
+                    capture_output=True,
+                    timeout=60,
+                )
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if probe.returncode == 0:
+                return candidate, env
+    return None, None
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) < 3:
+        sys.stderr.write(
+            "usage: python tests/f2p_runner.py <junit-report-path> "
+            "<selector> [selector ...]\n"
+        )
+        return 2
+
+    report = os.path.abspath(argv[1])
+    selectors = argv[2:]
+    root = repo_root()
+    report_dir = os.path.dirname(report)
+    if report_dir:
+        os.makedirs(report_dir, exist_ok=True)
+
+    interpreter, env = resolve_interpreter(root)
+    if interpreter is None:
+        sys.stderr.write(
+            "f2p_runner: no interpreter with pytest and project dependencies "
+            "found; probed .venv, PATH pythons, and the image uv cache\n"
+        )
+        return 2
+
+    sys.stdout.write(f"f2p_runner: interpreter={interpreter}\n")
+    env = dict(env)
+    env["PYTHONPATH"] = os.path.join(root, "tests") + os.pathsep + root + os.pathsep + env.get("PYTHONPATH", "")
+    command = [
+        interpreter,
+        "-m",
+        "pytest",
+        "-p", "codingrl_failure_origin",
+        *selectors,
+        f"--junitxml={report}",
+        "-p",
+        "no:cacheprovider",
+        "-o",
+        "addopts=",
+        "-q",
+    ]
+    display_runner = shutil.which("xvfb-run")
+    if display_runner is None:
+        sys.stderr.write("f2p_runner: xvfb-run is required for keyboard regression tests\n")
+        return 2
+    return subprocess.call([display_runner, "-a", *command], cwd=root, env=env)
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
