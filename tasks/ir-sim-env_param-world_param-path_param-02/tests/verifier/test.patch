+def _consumer_probe(consumer, accessor, branch):
+    from irsim.config import env_param, world_param
+    from irsim.env.env_plot import EnvPlot
+
+    fallback = env_param if accessor == "_env_param" else world_param
+    owner = _RecordingOwner(
+        _env_param=SimpleNamespace(marker="env"),
+        _world_param=SimpleNamespace(marker="world"),
+        _wp=SimpleNamespace(marker="plot"),
+    )
+    if consumer == "plot":
+        instance = object.__new__(EnvPlot)
+        instance.world = owner if branch == "owner" else SimpleNamespace()
+        expected = owner._param_instances["_wp"] if branch == "owner" else fallback
+    else:
+        owned = {
+            "object": _owned_object_with,
+            "world": _owned_world_with,
+            "sensor": _owned_sensor_with,
+            "keyboard": _owned_keyboard_with,
+        }
+        unowned = {
+            "object": _unowned_object,
+            "world": _unowned_world,
+            "sensor": _unowned_sensor,
+            "keyboard": _unowned_keyboard,
+        }
+        instance = owned[consumer](owner) if branch == "owner" else unowned[consumer]()
+        expected = owner._param_instances[accessor] if branch == "owner" else fallback
+    lookup_stacks = owner._param_stacks[
+        "_wp" if consumer == "plot" else accessor
+    ] if branch == "owner" else []
+    return lambda: getattr(instance, accessor), expected, lookup_stacks
+
