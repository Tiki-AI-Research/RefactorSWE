+@contextlib.contextmanager
+def _preserved_parameter_state():
+    """Save and restore ``_instances``/``_current`` of the parameter modules."""
+    from irsim.config import env_param, path_param, world_param
+
+    modules = (env_param, world_param, path_param)
+    snapshot = [(list(module._instances), module._current) for module in modules]
+    try:
+        yield modules
+    finally:
+        for module, (instances, current) in zip(modules, snapshot):
+            module._instances[:] = instances
+            module._current = current
