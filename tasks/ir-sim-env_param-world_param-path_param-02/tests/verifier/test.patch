+"""F2P probes for the shared parameter-store extraction.
+
+The frozen P2P contract tests pin the observable behaviour of the three
+module-level parameter proxies and their consumers; they pass on the
+pre-refactor baseline by construction.  The probes below pin the *structure*
+the refactor has to introduce, which the baseline does not provide:
+
+* ``env_param``/``world_param``/``path_param`` must be served by one shared
+  parameter-store abstraction instead of three copies of the same proxy code.
+* the duplicated owner-first / global-fallback accessor bodies in objects,
+  worlds, sensors, keyboard and plotting helpers must resolve through one shared
+  implementation. The plotting helper's environment-parameter accessor stays
+  global-only.
+
+Every probe compares live runtime objects (classes, code objects, module
+homes) that the refactor has to unify.  No helper name, private attribute or
+file placement is pinned, so any extraction that converges on one shared
+abstraction satisfies them.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import inspect
+import os
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+_PARAM_MODULE_FILES = (
+    "irsim/config/env_param.py",
+    "irsim/config/world_param.py",
+    "irsim/config/path_param.py",
+)
+
+
+def _project_root() -> str:
+    """Return the repository root that contains this test file."""
+    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def _is_project_source(filename: str) -> bool:
+    """Return True for source files that belong to the project under test."""
+    if not filename or filename.startswith("<"):
+        return False
+    root = _project_root()
+    filename = os.path.abspath(filename)
+    if not filename.startswith(root + os.sep):
+        return False
+    parts = os.path.relpath(filename, root).split(os.sep)
+    return (
+        parts[0] != "tests"
+        and not any(part.startswith(".") for part in parts)
+        and "site-packages" not in parts
+    )
+
+
+def _executed_project_code(call) -> set:
+    """Return the project code objects executed while ``call`` runs."""
+    executed = []
+
+    def _profiler(frame, event, arg):
+        if event == "call" and _is_project_source(frame.f_code.co_filename):
+            executed.append(frame.f_code)
+
+    previous = sys.getprofile()
+    sys.setprofile(_profiler)
+    try:
+        call()
+    finally:
+        sys.setprofile(previous)
+    return set(executed)
+
+
+def _executed_project_files(call) -> set:
+    """Return the absolute source files executed while ``call`` runs."""
+    return {os.path.abspath(code.co_filename) for code in _executed_project_code(call)}
+
+
+def _shared_store_file() -> str:
+    """Return the source file of the class serving the env/world modules."""
+    from irsim.config import env_param
+
+    proxy_class = type(env_param)
+    module = sys.modules.get(getattr(proxy_class, "__module__", ""))
+    filename = getattr(module, "__file__", None)
+    if filename:
+        return os.path.abspath(filename)
+    try:
+        return os.path.abspath(inspect.getfile(proxy_class))
+    except TypeError:
+        return ""
+
+
+def _outside_parameter_module_files(code_objects) -> set:
+    """Return the code objects not defined in the three parameter modules."""
+    parameter_files = _parameter_module_files()
+    return {
+        code
+        for code in code_objects
+        if os.path.abspath(code.co_filename) not in parameter_files
+    }
+
+
+def _parameter_module_files() -> set:
+    """Return the absolute source paths of the three parameter modules."""
+    root = _project_root()
+    return {
+        os.path.join(root, *relative.split("/")) for relative in _PARAM_MODULE_FILES
+    }
+
+
+def _shared_route_code(env_call, world_call, env_input, world_input):
+    """Return shared route code that receives each operation's input."""
+    def carrying_codes(call, expected):
+        records, _ = _project_call_records(call)
+        return _outside_parameter_module_files({
+            code for code, frame, _result in records
+            if any(type(value) is type(expected) and value == expected
+                   for value in frame.f_locals.values())
+        })
+
+    return carrying_codes(env_call, env_input) & carrying_codes(world_call, world_input)
+
+
+_UNSET = object()
+
+
+def _project_call_records(call):
+    """Return ``(code, frame, result)`` records for project calls in ``call``.
+
+    ``result`` is the value the call returned, which lets a probe tie a shared
+    implementation to the value it produced instead of merely observing that
+    some project file ran.
+    """
+    records = []
+
+    def _profiler(frame, event, arg):
+        if event == "call" and _is_project_source(frame.f_code.co_filename):
+            records.append([frame.f_code, frame, _UNSET])
+        elif event == "return":
+            for record in reversed(records):
+                if record[1] is frame and record[2] is _UNSET:
+                    record[2] = arg
+                    break
+
+    previous = sys.getprofile()
+    sys.setprofile(_profiler)
+    try:
+        result = call()
+    finally:
+        sys.setprofile(previous)
+    return records, result
+
+
+def _carrier_codes(records, value, excluded_files):
+    """Return project code objects outside ``excluded_files`` returning ``value``."""
+    return {
+        code
+        for code, _frame, result in records
+        if result is value
+        and _is_project_source(code.co_filename)
+        and os.path.abspath(code.co_filename) not in excluded_files
+    }
+
+
+def _resolution_carriers(records, value):
+    """Code returning the resolved value; ownership is established separately.
+
+    File placement and incidental local variables do not prove responsibility.
+    Read-stack intersection below binds carriers to an actual owner lookup.
+    """
+    return {
+        code for code, _frame, result in records
+        if result is value and _is_project_source(code.co_filename)
+    }
+
+
+def _state_snapshot(module):
+    """Return ``(instances, current)`` of a parameter module as an immutable copy."""
+    return (tuple(module._instances), module._current)
+
+
+def _state_records(call, module):
+    """Return ``(records, result)`` with module-state snapshots around each call.
+
+    Each record is ``(code, frame, entry_state, exit_state, return_value)``.
+    The entry/exit snapshots make a state change performed *inside* a code
+    object's own frame observable, which is what ties a shared implementation
+    to the responsibility it carries instead of only proving that it ran.
+    """
+    records = []
+
+    def _profiler(frame, event, arg):
+        if not _is_project_source(frame.f_code.co_filename):
+            return
+        if event == "call":
+            records.append([frame.f_code, frame, _state_snapshot(module), _UNSET, _UNSET])
+        elif event == "return":
+            for record in reversed(records):
+                if record[1] is frame and record[3] is _UNSET:
+                    record[3] = _state_snapshot(module)
+                    record[4] = arg
+                    break
+
+    previous = sys.getprofile()
+    sys.setprofile(_profiler)
+    try:
+        result = call()
+    finally:
+        sys.setprofile(previous)
+    return records, result
+
+
+def _state_transition_codes(records, predicate):
+    """Return code objects whose own frame performs the transition.
+
+    A record qualifies when ``predicate`` is false at its frame's entry and
+    true at its exit.  A qualifying frame that merely spans a transition a
+    nested parameter-module frame performs is dropped, so a shared wrapper
+    around the module's own inline update is not credited with the change.
+    """
+    changed = [
+        record
+        for record in records
+        if not predicate(record[2]) and predicate(record[3])
+    ]
+    parameter_frames = [
+        frame
+        for code, frame, _entry, _exit, _result in changed
+        if _in_parameter_module(code)
+    ]
+    return {
+        code
+        for code, frame, _entry, _exit, _result in changed
+        if not any(_frame_contains(frame, other) for other in parameter_frames)
+    }
+
+
+def _in_parameter_module(code) -> bool:
+    """Return True when ``code`` is defined in one of the parameter modules."""
+    return os.path.abspath(code.co_filename) in _parameter_module_files()
+
+
+def _frame_contains(outer, inner) -> bool:
+    """Return True when ``inner`` is ``outer`` or runs inside ``outer``."""
+    frame = inner
+    while frame is not None:
+        if frame is outer:
+            return True
+        frame = frame.f_back
+    return False
+
+
+def _bound_state(state, instance) -> bool:
+    """Return True when ``state`` shows ``instance`` at index 0 and as current."""
+    instances, current = state
+    return bool(instances) and instances[0] is instance and current is instance
+
+
+def _stored_state(state, index, instance) -> bool:
+    """Return True when ``state`` shows ``instance`` stored at ``index``."""
+    instances, current = state
+    if index == 0:
+        return bool(instances) and instances[0] is instance and current is instance
+    return len(instances) > index and instances[index] is instance
+
+
+def _read_index(module, index):
+    """Read ``index`` through the module's public indexed-read entry point."""
+    from irsim.config import path_param
+
+    if module is path_param:
+        return module.__getitem__(index)
+    return module[index]
+
+
+def _assign_index(module, index, instance) -> None:
+    """Assign ``index`` through the module's public indexed-write entry point."""
+    from irsim.config import path_param
+
+    if module is path_param:
+        module.__setitem__(index, instance)
+    else:
+        module[index] = instance
+
+
+def _stack_code_objects(frame):
+    """Return the project code objects on ``frame``'s call stack."""
+    codes = set()
+    while frame is not None:
+        if _is_project_source(frame.f_code.co_filename):
+            codes.add(frame.f_code)
+        frame = frame.f_back
+    return codes
+
+
+class _RecordingOwner:
+    """Owner stand-in that records the call stacks resolving its parameters."""
+
+    def __init__(self, **instances):
+        object.__setattr__(self, "_param_instances", dict(instances))
+        object.__setattr__(self, "_param_stacks", {name: [] for name in instances})
+
+    def _resolve(self, name):
+        self._param_stacks[name].append(_stack_code_objects(sys._getframe(1)))
+        return self._param_instances[name]
+
+    @property
+    def _env_param(self):
+        return self._resolve("_env_param")
+
+    @property
+    def _world_param(self):
+        return self._resolve("_world_param")
+
+    @property
+    def _wp(self):
+        return self._resolve("_wp")
+
