+@pytest.mark.parametrize("branch", ["owner", "global"])
+@pytest.mark.parametrize("consumer,accessor", _CONSUMER_ACCESSORS, ids=[
+    "object_env", "object_world", "world_env", "sensor_env",
+    "keyboard_env", "keyboard_world", "plot_world",
+])
+def test_one_consumer_branch_uses_shared_resolution(consumer, accessor, branch):
+    """One accessor branch resolves through the same code as another consumer."""
+    def observed_codes(kind, name, mode, *, required):
+        call, expected, stacks = _consumer_probe(kind, name, mode)
+        try:
+            records, result = _project_call_records(call)
+            if result is not expected:
+                if required:
+                    assert result is expected, (kind, name, mode)
+                return set()
+            codes = _resolution_carriers(records, expected)
+            if mode == "global":
+                owner_call, owner_expected, stacks = _consumer_probe(kind, name, "owner")
+                owner_records, owner_result = _project_call_records(owner_call)
+                if owner_result is not owner_expected:
+                    if required:
+                        assert owner_result is owner_expected, (kind, name, "owner")
+                    return set()
+                codes &= _resolution_carriers(owner_records, owner_expected)
+            # Thin availability adaptation may happen before the resolver;
+            # at least one real parameter read must execute inside it.
+            return codes & set().union(*stacks)
+        except Exception:
+            if required:
+                raise
+            # A different consumer's bug must fail its own scored node, not
+            # make every otherwise correct consumer fail through a fixed anchor.
+            return set()
+
+    own_codes = observed_codes(consumer, accessor, branch, required=True)
+    assert own_codes, f"{consumer}.{accessor} {branch} must resolve its owner in shared code"
+    alternatives = [
+        observed_codes(other, name, branch, required=False)
+        for other, name in _CONSUMER_ACCESSORS
+        if name == accessor and other != consumer
+    ]
+    assert any(own_codes & other_codes for other_codes in alternatives), (
+        f"{consumer}.{accessor} {branch} must share resolution with another consumer"
+    )
