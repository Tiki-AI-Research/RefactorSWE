index 0000000000000000000000000000000000000000..905ac1f473eefe7c8e12df752fbc8c19d42878fb
--- /dev/null
+++ b/tests/test_param_proxy_contract.py
@@ -0,0 +1,665 @@
+"""Supplemental P2P contract tests for the shared parameter-proxy refactor.
+
+Every assertion in this module already holds for the baseline implementation of
+``irsim.config.env_param``, ``irsim.config.world_param`` and
+``irsim.config.path_param`` and for the consumers that resolve parameters
+owner-first with a global fallback.  The tests pin the observable routing,
+indexing, isolation and fallback behavior that extracting one shared parameter
+store must keep unchanged.
+"""
+
+import os
+import platform
+import subprocess
+import sys
+from dataclasses import fields, is_dataclass
+from types import ModuleType
+
+import numpy as np
+import pytest
+
+import irsim
+from irsim.config import env_param, path_param, world_param
+from irsim.config.env_param import EnvParam
+from irsim.config.path_param import PathManager
+from irsim.config.world_param import WorldParam
+from irsim.env.env_plot import EnvPlot
+from irsim.gui.keyboard_control import KeyboardControl
+from irsim.world.object_base import ObjectBase
+from irsim.world.sensors.lidar2d import Lidar2D
+from irsim.world.world import World
+
+ENV_FIELDS = [
+    "objects",
+    "logger",
+    "GeometryTree",
+    "platform_name",
+    "id_iter",
+    "env_id",
+    "rng",
+]
+WORLD_FIELDS = [
+    "time",
+    "step_mode",
+    "control_mode",
+    "collision_mode",
+    "step_time",
+    "count",
+]
+PATH_FIELDS = ["root_path", "ani_buffer_path", "ani_path", "fig_path"]
+
+
+class _SilentLogger:
+    """Logger stub that swallows every call used by the consumers."""
+
+    def __getattr__(self, _name):
+        return lambda *_args, **_kwargs: None
+
+
+class _FakeEnv:
+    def __init__(self, env_param_instance, world_param_instance):
+        self._env_param = env_param_instance
+        self._world_param = world_param_instance
+
+
+class _FakeParent:
+    """Object-like sensor parent exposing the owning environment."""
+
+    def __init__(self, env):
+        self._env = env
+
+
+class _FakeWorld:
+    """Minimal world for the plotting helper."""
+
+    def __init__(self, *, with_world_param, with_env):
+        self.plot_parse = {}
+        self.grid_map = None
+        self.fog_map = None
+        self.x_range = (0.0, 10.0)
+        self.y_range = (0.0, 10.0)
+        if with_world_param:
+            self._wp = WorldParam(count=7)
+        if with_env:
+            self._env = _FakeEnv(EnvParam(), WorldParam())
+
+
+@pytest.fixture(autouse=True)
+def _isolate_param_modules():
+    """Restore the three parameter modules after each supplemental test."""
+    snapshot = [
+        (
+            module,
+            module._instances,
+            list(module._instances),
+            module._current,
+            [dict(instance.__dict__) for instance in module._instances],
+        )
+        for module in (env_param, world_param, path_param)
+    ]
+    yield
+    for module, original_list, instances, current, states in snapshot:
+        module._instances = original_list
+        original_list[:] = instances
+        for instance, state in zip(instances, states, strict=True):
+            instance.__dict__.clear()
+            instance.__dict__.update(state)
+        module._current = current
+
+
+@pytest.fixture
+def _two_environments(tmp_path):
+    environments = []
+    try:
+        for environment_name in ("contract-a", "contract-b"):
+            config_path = tmp_path / f"{environment_name}.yaml"
+            config_path.write_text(
+                "world:\n  step_time: 0.1\n"
+                "robot: []\nobstacle: []\n"
+            )
+            environments.append(
+                irsim.make(str(config_path), headless=True, log_level="ERROR")
+            )
+        yield tuple(environments)
+    finally:
+        for environment in environments:
+            environment.close(ending_time=0)
+
+
+def test_environments_expose_their_own_path_parameter_instance(_two_environments):
+    first, second = _two_environments
+    assert first.path_param is first._path_manager
+    assert second.path_param is second._path_manager
+    assert first.path_param is not second.path_param
+
+
+def test_environment_step_rebinds_all_three_parameter_modules(_two_environments):
+    first, second = _two_environments
+    first.step()
+    assert env_param._current is first._env_param
+    assert world_param._current is first._world_param
+    assert path_param._current is first._path_manager
+    second.step()
+    assert env_param._current is second._env_param
+    assert world_param._current is second._world_param
+    assert path_param._current is second._path_manager
+
+
+def test_alternating_environment_steps_preserve_parameter_count_and_time(
+    _two_environments,
+):
+    expected_counts = [0, 0]
+    for active_index in (0, 1, 0):
+        _two_environments[active_index].step()
+        expected_counts[active_index] += 1
+        for environment_index, environment in enumerate(_two_environments):
+            expected_count = expected_counts[environment_index]
+            assert environment._world_param.count == expected_count
+            assert environment._world_param.time == pytest.approx(
+                round(expected_count * environment.step_time, 2)
+            )
+
+
+def test_param_modules_expose_public_dataclasses_with_unchanged_fields():
+    for module in (env_param, world_param, path_param):
+        assert issubclass(type(module), ModuleType)
+        assert sys.modules[module.__name__] is module
+        assert callable(module.bind)
+    assert sys.modules["irsim.config.path_param"] is path_param
+    assert callable(path_param.__getitem__)
+    assert callable(path_param.__setitem__)
+    assert is_dataclass(EnvParam)
+    assert is_dataclass(WorldParam)
+    assert is_dataclass(PathManager)
+    assert [field.name for field in fields(EnvParam)] == ENV_FIELDS
+    assert [field.name for field in fields(WorldParam)] == WORLD_FIELDS
+    assert [field.name for field in fields(PathManager)] == PATH_FIELDS
+    assert env_param.EnvParam is EnvParam
+    assert world_param.WorldParam is WorldParam
+    assert path_param.PathManager is PathManager
+
+
+def test_param_dataclass_defaults_and_constructors_unchanged():
+    env = EnvParam()
+    assert env.objects == []
+    assert env.logger is None
+    assert env.GeometryTree is None
+    assert env.platform_name == platform.system()
+    assert env.env_id is None
+    assert env.rng is None
+    assert next(env.id_iter) == 0
+
+    assert WorldParam() == WorldParam(
+        time=0.0,
+        step_mode="internal",
+        control_mode="auto",
+        collision_mode="stop",
+        step_time=0.1,
+        count=0,
+    )
+
+    path = PathManager()
+    assert path.root_path == os.path.dirname(irsim.__file__)
+    assert path.ani_buffer_path == sys.path[0] + "/animation_buffer"
+    assert path.ani_path == sys.path[0] + "/animation"
+    assert path.fig_path == sys.path[0] + "/figure"
+
+
+def test_env_param_module_attribute_routing_follows_bind():
+    bound = EnvParam()
+    bound.logger = "bound-logger"
+    assert env_param.bind(bound) is None
+    assert env_param._instances[0] is bound
+    assert env_param._current is bound
+    assert env_param.logger == "bound-logger"
+
+    env_param.logger = "rewritten"
+    assert bound.logger == "rewritten"
+    assert env_param.logger == "rewritten"
+
+    current = EnvParam(logger="assigned-current")
+    env_param._current = current
+    assert env_param.logger == "assigned-current"
+    env_param.logger = "assigned-current-written"
+    assert current.logger == "assigned-current-written"
+    assert bound.logger == "rewritten"
+    assert env_param._instances[0] is bound
+
+
+def test_world_param_module_attribute_routing_follows_bind():
+    bound = WorldParam(count=4)
+    assert world_param.bind(bound) is None
+    assert world_param._instances[0] is bound
+    assert world_param._current is bound
+    assert world_param.count == 4
+
+    world_param.step_time = 0.25
+    assert bound.step_time == 0.25
+    assert world_param.step_time == 0.25
+
+    current = WorldParam(count=37)
+    world_param._current = current
+    assert world_param.count == 37
+    world_param.count = 38
+    assert current.count == 38
+    assert bound.count == 4
+    assert world_param._instances[0] is bound
+
+
+def test_non_parameter_module_attributes_stay_on_the_module():
+    for module, bound in ((env_param, EnvParam()), (world_param, WorldParam())):
+        module.bind(bound)
+        for probe in ("_p2p_bookkeeping_probe", "contract_bookkeeping"):
+            try:
+                setattr(module, probe, "module-value")
+                assert vars(module).get(probe) == "module-value"
+                assert getattr(module, probe) == "module-value"
+                assert not hasattr(bound, probe)
+            finally:
+                vars(module).pop(probe, None)
+
+
+def test_existing_module_names_take_precedence_over_instance_attributes():
+    probe = "contract_module_shadow"
+    for module, bound in ((env_param, EnvParam()), (world_param, WorldParam())):
+        setattr(bound, probe, "instance-value")
+        module.bind(bound)
+        vars(module)[probe] = "module-value"
+        try:
+            assert getattr(module, probe) == "module-value"
+        finally:
+            vars(module).pop(probe, None)
+
+
+def test_missing_module_names_fall_back_to_non_field_instance_attributes():
+    probe = "contract_instance_only"
+    for module, bound in ((env_param, EnvParam()), (world_param, WorldParam())):
+        assert probe not in vars(module)
+        setattr(bound, probe, "instance-value")
+        module.bind(bound)
+        assert getattr(module, probe) == "instance-value"
+        delattr(bound, probe)
+        with pytest.raises(AttributeError):
+            getattr(module, probe)
+
+
+def test_module_reads_and_writes_before_bind_use_default_instance_at_index_zero():
+    env_default = EnvParam()
+    env_default.logger = "default-logger"
+    env_param._instances[:] = [env_default]
+    env_param._current = env_default
+
+    world_default = WorldParam(count=1)
+    world_param._instances[:] = [world_default]
+    world_param._current = world_default
+
+    assert env_param.logger == "default-logger"
+    env_param.logger = "written-before-bind"
+    assert env_default.logger == "written-before-bind"
+
+    assert world_param.count == 1
+    world_param.count = 6
+    assert world_default.count == 6
+    assert world_param._instances[0] is world_default
+
+    fresh_check = """
+import sys
+import traceback
+from irsim.config import env_param, path_param, world_param
+try:
+    env_param._instances[0].logger = 'fresh-env-default'
+    world_param._instances[0].count = 83
+    path_param._instances[0].fig_path = '/fresh-path-default'
+    assert env_param.logger == 'fresh-env-default'
+    assert world_param.count == 83
+    assert path_param.path_manager.fig_path == '/fresh-path-default'
+    env_param.logger = 'fresh-env-written'
+    world_param.count = 84
+    path_param.path_manager.fig_path = '/fresh-path-written'
+    assert env_param._instances[0].logger == 'fresh-env-written'
+    assert world_param._instances[0].count == 84
+    assert path_param._instances[0].fig_path == '/fresh-path-written'
+except AssertionError:
+    traceback.print_exc()
+    print("IRSIM_FRESH_ASSERTION_FAILURE", file=sys.stderr)
+    raise SystemExit(86)
+"""
+    probe = subprocess.run(
+        [sys.executable, "-c", fresh_check],
+        capture_output=True,
+        text=True,
+        timeout=120,
+    )
+    if probe.returncode == 86 and probe.stderr.endswith("\nIRSIM_FRESH_ASSERTION_FAILURE\n"):
+        raise AssertionError(probe.stderr)
+    if probe.returncode:
+        raise RuntimeError(
+            f"fresh parameter check execution error (exit {probe.returncode})"
+            f"\nstdout:\n{probe.stdout}\nstderr:\n{probe.stderr}"
+        )
+
+
+def test_bind_on_empty_storage_appends_index_zero_and_routes_reads():
+    env_param._instances.clear()
+    env_bound = EnvParam()
