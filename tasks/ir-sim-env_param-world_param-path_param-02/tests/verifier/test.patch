+"""Record candidate-source exceptions during frozen pytest fixture execution."""
+import json
+from pathlib import Path
+import pytest
+
+_ALLOWED = (AttributeError, TypeError, ValueError, KeyError, IndexError, AssertionError)
+_ROOT = Path(__file__).resolve().parents[1]
+
+@pytest.hookimpl(hookwrapper=True)
+def pytest_runtest_makereport(item, call):
+    outcome = yield
+    report = outcome.get_result()
+    if call.when not in ("setup", "teardown") or call.excinfo is None:
+        return
+    if not isinstance(call.excinfo.value, _ALLOWED):
+        return
+    try:
+        origin = Path(str(call.excinfo.traceback[-1].path)).resolve().relative_to(_ROOT)
+    except (ValueError, IndexError):
+        return
+    if not origin.parts or origin.parts[0] != "irsim" or origin.suffix != ".py":
+        return
+    record = {"producer": "codingrl-pytest-candidate-origin/v1", "phase": call.when,
+              "exception": type(call.excinfo.value).__name__, "path": origin.as_posix()}
+    prop = ("codingrl.candidate_origin", json.dumps(record, sort_keys=True))
+    item.user_properties.append(prop)
+    report.user_properties.append(prop)
