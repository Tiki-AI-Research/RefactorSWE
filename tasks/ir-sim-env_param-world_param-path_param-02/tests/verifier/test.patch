+def _recording_param_type(base, field_name):
+    """Return a ``base`` subclass recording the stack that writes ``field_name``."""
+
+    class _Recording(base):
+        def __init__(self, *args, **kwargs):
+            object.__setattr__(self, "writer_stacks", [])
+            super().__init__(*args, **kwargs)
+            self.writer_stacks.clear()
+
+    def _getter(self):
+        return self._written_value
+
+    def _setter(self, value):
+        self.writer_stacks.append(_stack_code_objects(sys._getframe(1)))
+        object.__setattr__(self, "_written_value", value)
+
+    setattr(_Recording, field_name, property(_getter, _setter))
+    return _Recording
+
