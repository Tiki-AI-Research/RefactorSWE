+"""Route A public behavior checks, salvaged from the original F2P inventory.
+
+Boolean string meanings are independent of letter case. Silent success with
+missing external imports is never legal. These tests use real configuration
+files, real imports, the public lint entry point and output.
+"""
+
+import ast
+import inspect
+from pathlib import Path
+import re
+
+import pytest
+
+import importlinter
+from importlinter import configuration
+from importlinter.application import use_cases
+from importlinter.application.user_options import UserOptions
+from importlinter.contracts.forbidden import ForbiddenContract
+from importlinter.application.use_cases import lint_imports
+
+
+@pytest.fixture(autouse=True)
+def _default_configuration():
+    configuration.configure()
+    yield
+    configuration.configure()
+
+
+def _package(directory, name, modules):
+    package = directory / name
+    package.mkdir()
+    (package / "__init__.py").write_text("")
+    for filename, source in modules.items():
+        (package / filename).write_text(source)
+
+
+def _ini(directory, roots, source, forbidden):
+    config = directory / "setup.cfg"
+    root_option = (
+        f"root_package = {roots[0]}\n" if len(roots) == 1
+        else "root_packages =\n" + "".join(f"    {root}\n" for root in roots)
+    )
+    config.write_text(
+        "[importlinter]\n" + root_option + "include_external_packages = TRUE\n\n"
+        "[importlinter:contract:one]\nname = External forbidden contract\n"
+        f"type = forbidden\nsource_modules = {source}\nforbidden_modules = {forbidden}\n"
+    )
+    return config
+
+
+def _lint(config):
+    try:
+        return lint_imports(
+            config_filename=str(config), cache_dir=None, no_logo=True,
+            is_debug_mode=True,
+        ), False
+    except ValueError as error:
+        # Preserve Lean v2's existing option-error channel without prescribing wording.
+        assert "include_external_packages" in str(error)
+        return False, True
+
+
+def test_ini_imported_external_at_root_is_not_accepted(tmp_path, monkeypatch):
+    """F05: INI singular root imports the forbidden dependency in __init__.py."""
+    _package(tmp_path, "f2p_owner_ini_external", {"__init__.py": "import routeadependency\n"})
+    (tmp_path / "routeadependency.py").write_text("")
+    config = _ini(tmp_path, ["f2p_owner_ini_external"], "f2p_owner_ini_external", "routeadependency")
+    monkeypatch.syspath_prepend(str(tmp_path))
+
+    result, _ = _lint(config)
+
+    assert result is False, "an imported forbidden external dependency was accepted"
+
+
+def test_external_consumers_agree_when_forbidden_external_is_not_imported(
+    tmp_path, monkeypatch, capsys
+):
+    """F09: a kept contract must have analyzed the separately imported external."""
+    _package(tmp_path, "f2p_agree_external", {"core.py": "import routeadependency\n"})
+    (tmp_path / "routeadependency.py").write_text("")
+    config = _ini(tmp_path, ["f2p_agree_external"], "f2p_agree_external.core", "unusedexternal")
+    monkeypatch.syspath_prepend(str(tmp_path))
+
+    result, rejected = _lint(config)
+    output = capsys.readouterr().out
+
+    if not rejected:
+        assert result is True
+        assert re.search(r"Analyzed \d+ files, 1 dependencies\.", output), (
+            "the external contract accepted TRUE while the public report omitted the external edge"
+        )
+
+
+def test_mixed_case_external_packages_option_rejects_imported_external_forbidden_module(
+    tmp_path, monkeypatch
+):
+    """F10: the original submodule-to-external forbidden import scenario."""
+    _package(tmp_path, "f2p_external_import_consumer", {"core.py": "import routeadependency\n"})
+    (tmp_path / "routeadependency.py").write_text("")
+    config = _ini(
+        tmp_path, ["f2p_external_import_consumer"],
+        "f2p_external_import_consumer.core", "routeadependency",
+    )
+    monkeypatch.syspath_prepend(str(tmp_path))
+
+    result, _ = _lint(config)
+
+    assert result is False, "an imported forbidden external dependency was accepted"
+
+
+def test_toml_imported_external_is_not_accepted(tmp_path, monkeypatch):
+    """F11: TOML string TRUE follows the same public contract as INI."""
+    _package(tmp_path, "f2p_owner_toml_external", {"core.py": "from routeadependency import item\n"})
+    (tmp_path / "routeadependency.py").write_text("item = 1\n")
+    config = tmp_path / "pyproject.toml"
+    config.write_text(
+        '[tool.importlinter]\nroot_package = "f2p_owner_toml_external"\n'
+        'include_external_packages = "TRUE"\n\n'
+        '[[tool.importlinter.contracts]]\nname = "External forbidden contract"\n'
+        'type = "forbidden"\nsource_modules = ["f2p_owner_toml_external.core"]\n'
+        'forbidden_modules = ["routeadependency"]\n'
+    )
+    monkeypatch.syspath_prepend(str(tmp_path))
+
+    result, _ = _lint(config)
+
+    assert result is False, "a TOML-configured forbidden external dependency was accepted"
+
+
+def test_second_root_indirect_external_import_is_not_accepted(tmp_path, monkeypatch):
+    """N01: plural roots; only the second root reaches the external, indirectly."""
+    _package(tmp_path, "f2p_first_root", {})
+    _package(tmp_path, "f2p_second_root", {
+        "core.py": "from f2p_second_root import bridge\n",
+        "bridge.py": "import routeadependency\n",
+    })
+    (tmp_path / "routeadependency.py").write_text("")
+    config = _ini(
+        tmp_path, ["f2p_first_root", "f2p_second_root"],
+        "f2p_second_root.core", "routeadependency",
+    )
+    monkeypatch.syspath_prepend(str(tmp_path))
+
+    result, _ = _lint(config)
+
+    assert result is False, "the second root's indirect forbidden external import was accepted"
+
+
+# F-CORE: inspect semantic ownership without requiring a particular class or layout.
+_OPTION_KEYS = {
+    "root_packages", "include_external_packages", "exclude_type_checking_imports", "show_timings"
+}
+_BOOLEAN_KEYS = _OPTION_KEYS - {"root_packages"}
+
+
+def _option_keys(node):
+    keys = {
+        item.value for item in ast.walk(node)
+        if isinstance(item, ast.Constant) and isinstance(item.value, str)
+        and item.value in _OPTION_KEYS | {"root_package"}
+    }
+    keys |= {item.target.id for item in ast.walk(node)
+             if isinstance(item, ast.AnnAssign) and isinstance(item.target, ast.Name)
+             and item.target.id in _OPTION_KEYS}
+    if "root_package" in keys:
+        keys.add("root_packages")
+    return keys
+
+
+def _annotation_names(node):
+    annotations = []
+    for item in ast.walk(node):
+        if isinstance(item, ast.AnnAssign):
+            annotations.append(item.annotation)
+        elif isinstance(item, (ast.FunctionDef, ast.AsyncFunctionDef)) and item.returns:
+            annotations.append(item.returns)
+    annotations = [ast.parse(annotation.value, mode="eval")
+                   if isinstance(annotation, ast.Constant) and isinstance(annotation.value, str)
+                   else annotation for annotation in annotations]
+    return {
+        child.id for annotation in annotations for child in ast.walk(annotation)
+        if isinstance(child, ast.Name)
+    }
+
+
+def _typed_owner_candidates(trees):
+    # Properties, annotated fields and typed factory functions are all supported.
+    # In particular, a dataclass may use different attribute names from raw keys.
+    classes = [node for tree in trees for node in ast.walk(tree) if isinstance(node, ast.ClassDef)]
+    functions = [node for tree in trees for node in ast.walk(tree) if isinstance(node, ast.FunctionDef)]
+    candidates = []
+    for cls in classes:
+        annotations = _annotation_names(cls)
+        if "bool" not in annotations or not annotations.intersection({"list", "List", "tuple", "Sequence"}):
+            continue
+        keys = _option_keys(cls)
+        for function in functions:
+            creates_owner = any(
+                isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == cls.name
+                for node in ast.walk(function)
+            )
+            if creates_owner:
+                keys |= _option_keys(function)
+        if _OPTION_KEYS <= keys:
+            candidates.append(cls)
+    return candidates
+
+
+def test_typed_owner_represents_all_four_session_options():
+    package_directory = Path(importlinter.__file__).parent
+    trees = [ast.parse(path.read_text()) for path in package_directory.rglob("*.py")]
+    assert _typed_owner_candidates(trees), (
+        "session options need a typed semantic owner for roots, externals, type checking and timings"
+    )
+
+
+def test_consumers_delegate_root_reading_and_boolean_interpretation():
+    # Loading/normalizing raw roots is allowed. Passing them straight from raw
+    # storage to graph construction bypasses the semantic owner.
+    application_tree = ast.parse(inspect.getsource(use_cases))
+    forbidden_tree = ast.parse(inspect.getsource(ForbiddenContract))
+    package_directory = Path(importlinter.__file__).parent
+    source_trees = [application_tree, forbidden_tree] + [
+        ast.parse(path.read_text()) for path in package_directory.rglob("*.py")
+    ]
+    owners = _typed_owner_candidates(source_trees)
+    owner_routines = {id(routine) for owner in owners
+                      for routine in ast.walk(owner) if isinstance(routine, ast.FunctionDef)}
+    typed_dictionary_owner = any(
+        any(isinstance(base, ast.Name) and base.id == "TypedDict" for base in owner.bases)
+        for owner in owners
+    )
+    for tree in (application_tree, forbidden_tree):
+        for routine in ast.walk(tree):
+            if not isinstance(routine, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                continue
+            returns_owner = bool(_annotation_names(routine).intersection({owner.name for owner in owners}))
+            if id(routine) in owner_routines or (returns_owner and _OPTION_KEYS <= _option_keys(routine)):
+                continue
+            raw_boolean_reads = []
+            for node in ast.walk(routine):
+                if isinstance(node, ast.Subscript) and isinstance(node.slice, ast.Constant):
+                    if node.slice.value in _BOOLEAN_KEYS:
+                        raw_boolean_reads.append(node)
+                elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+                    if node.func.attr == "get" and node.args and isinstance(node.args[0], ast.Constant):
+                        if node.args[0].value in _BOOLEAN_KEYS:
+                            raw_boolean_reads.append(node)
+            compares_raw_boolean = any(
+                isinstance(node, ast.Compare)
+                and any(isinstance(value, ast.Constant) and value.value in {"True", "true", "False", "false"}
+                        for value in ast.walk(node))
+                for node in ast.walk(routine)
+            )
+            assert not (raw_boolean_reads and compares_raw_boolean), (
+                f"{routine.name} keeps a private raw session-option comparison"
+            )
+            if tree is application_tree and not typed_dictionary_owner:
+                for node in ast.walk(routine):
+                    if isinstance(node, ast.keyword) and node.arg == "root_package_names":
+                        assert not any(
+                            isinstance(value, ast.Subscript) and isinstance(value.slice, ast.Constant)
+                            and value.slice.value == "root_packages"
+                            for value in ast.walk(node.value)
+                        ), "graph root consumer bypasses semantic ownership"
+
+
+def test_external_consumers_agree_on_the_actual_typed_session(tmp_path, monkeypatch):
+    # Case changes preserve the boolean meaning for both real consumers.
+    for index, raw_value in enumerate(("TRUE", "tRuE", "FALSE", "fAlSe")):
+        directory = tmp_path / str(index)
+        directory.mkdir()
+        with monkeypatch.context() as context:
+            _assert_external_consumers_agree(directory, context, raw_value)
+
+
+def _assert_external_consumers_agree(tmp_path, monkeypatch, raw_value):
+    _package(tmp_path, "f2p_actual_session", {"core.py": "import actual_dependency\n"})
+    (tmp_path / "actual_dependency.py").write_text("")
+    filename = _ini(tmp_path, ["f2p_actual_session"], "f2p_actual_session.core", "unused_external")
+    filename.write_text(filename.read_text().replace(
+        "include_external_packages = TRUE", f"include_external_packages = {raw_value}"
+    ))
+    monkeypatch.syspath_prepend(str(tmp_path))
+    builder = configuration.settings.GRAPH_BUILDER
+    original_build = builder.build
+    original_check = ForbiddenContract.check
+    builds, checks = [], []
+
+    def record_build(*args, **kwargs):
+        graph = original_build(*args, **kwargs)
+        builds.append((kwargs, graph))
+        return graph
+
+    def record_check(self, graph, verbose):
+        checks.append((self.session_options, graph))
+        return original_check(self, graph, verbose)
+
+    monkeypatch.setattr(builder, "build", record_build)
+    monkeypatch.setattr(ForbiddenContract, "check", record_check)
+    error = None
+    result = None
+    try:
+        result = lint_imports(
+            config_filename=str(filename), cache_dir=None, no_logo=True, is_debug_mode=True
+        )
+    except ValueError as caught:
+        error = caught
+    assert len(builds) == len(checks) == 1, "both real consumers must be reached"
+    arguments, graph = builds[0]
+    assert checks[0][1].modules == graph.modules
+    included = arguments["include_external_packages"]
+    assert type(included) is bool
+    assert included is (raw_value.lower() == "true"), (
+        "changing only letter case must preserve the session boolean meaning"
+    )
+    if included:
+        assert "actual_dependency" in graph.modules
+        assert error is None, "Forbidden rejected externals that graph building included"
+        assert result is True
+    else:
+        assert "actual_dependency" not in graph.modules
+        assert isinstance(error, ValueError), "Forbidden accepted externals omitted by graph building"
+        assert "include_external_packages" in str(error)
+
+
+def test_reader_supplied_session_mapping_is_not_rewritten_in_place():
+    # The typed owner is responsible for normalising a single root_package into
+    # root_packages. That normalisation must produce the session the application
+    # works with, not rewrite the mapping a user-option reader handed back: an
+    # integrator-supplied reader keeps owning the values it returned.
+    class _FixedReader:
+        def __init__(self, user_options):
+            self._user_options = user_options
+
+        def read_options(self, config_filename=None):
+            return self._user_options
+
+    reader_mapping = {"root_package": "f2p_reader_owned_root"}
+    reader_options = UserOptions(
+        session_options=reader_mapping, contracts_options=[]
+    )
+    configuration.settings.configure(
+        USER_OPTION_READERS={"fixed": _FixedReader(reader_options)}
+    )
+
+    normalised = use_cases.read_user_options()
+
+    assert reader_mapping == {"root_package": "f2p_reader_owned_root"}, (
+        "normalising session options must not rewrite the reader-supplied mapping"
+    )
+    session_options = normalised.session_options
+    assert session_options["root_packages"] == ["f2p_reader_owned_root"], (
+        "the normalised session must still expose the root packages by their shared key"
+    )
+    assert "root_package" not in session_options
