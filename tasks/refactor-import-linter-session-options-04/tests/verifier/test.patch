+def test_show_timings_session_option_does_not_affect_output(tmp_path, monkeypatch):
+    config_with_option = _write_config(
+        tmp_path,
+        "setup.cfg",
+        """
+        [importlinter]
+        root_package = testpackage
+        show_timings = True
+
+        [importlinter:contract:one]
+        name = Kept contract
+        type = forbidden
+        source_modules = testpackage.high.blue.one
+        forbidden_modules = testpackage.low
+        """,
+    )
+    config_without_option = _write_config(
+        tmp_path,
+        "no-option.cfg",
+        """
+        [importlinter]
+        root_package = testpackage
+
+        [importlinter:contract:one]
+        name = Kept contract
+        type = forbidden
+        source_modules = testpackage.high.blue.one
+        forbidden_modules = testpackage.low
+        """,
+    )
+    monkeypatch.chdir(TESTPACKAGE_DIRECTORY)
+
+    with console.capture() as capture:
+        result = cli.lint_imports(config_filename=config_with_option, no_logo=True, no_cache=True)
+    output_with_option = capture.get()
+
+    with console.capture() as capture:
+        result_without_option = cli.lint_imports(
+            config_filename=config_without_option, no_logo=True, no_cache=True
+        )
+    output_without_option = capture.get()
+
+    with console.capture() as capture:
+        result_with_flag = cli.lint_imports(
+            config_filename=config_with_option, no_logo=True, no_cache=True, show_timings=True
+        )
+    output_with_flag = capture.get()
+
+    assert result == cli.EXIT_STATUS_SUCCESS
+    assert result_without_option == cli.EXIT_STATUS_SUCCESS
+    assert result_with_flag == cli.EXIT_STATUS_SUCCESS
+    # Timings are driven by the public flag, not by the session option.
+    assert "Building graph took" not in output_with_option
+    assert output_with_option == output_without_option
+    assert "Building graph took" in output_with_flag
+
