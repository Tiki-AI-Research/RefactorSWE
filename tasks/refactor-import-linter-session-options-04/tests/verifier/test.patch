+@pytest.mark.parametrize("raw_value", ("True", "true"))
+def test_enabled_spellings_include_externals_for_graph_and_forbidden_contract(
+    tmp_path, monkeypatch, raw_value
+):
+    # The graph builder must include the external package, otherwise the forbidden contract
+    # would reject the configuration for containing external forbidden modules: both consumers
+    # must derive the same boolean for the same raw value.
+    config_filename = _write_config(
+        tmp_path,
+        "setup.cfg",
+        f"""
+        [importlinter]
+        root_package = testpackage
+        include_external_packages = {raw_value}
+
+        [importlinter:contract:one]
+        name = External kept contract
+        type = forbidden
+        source_modules = testpackage.high.blue
+        forbidden_modules = sqlalchemy
+        """,
+    )
+    monkeypatch.chdir(TESTPACKAGE_DIRECTORY)
+
+    result = cli.lint_imports(config_filename=config_filename, no_cache=True)
+
+    assert result == cli.EXIT_STATUS_SUCCESS
+
+    # Integrators may supply text wrappers directly through the public constructor.
+    # Preserve the existing interpretation of their string representation.
+    graph = ImportGraph()
+    graph.add_module("wrapped_text_owner")
+    graph.add_module("wrapped_text_dependency", is_squashed=True)
+    graph.add_import(
+        importer="wrapped_text_owner", imported="wrapped_text_dependency",
+        line_number=1, line_contents="import wrapped_text_dependency",
+    )
+    contract = ForbiddenContract(
+        name="Wrapped text external option",
+        session_options={
+            "root_packages": ["wrapped_text_owner"],
+            "include_external_packages": UserString(raw_value),
+        },
+        contract_options={
+            "source_modules": ["wrapped_text_owner"],
+            "forbidden_modules": ["wrapped_text_dependency"],
+        },
+    )
+    try:
+        check = contract.check(graph=graph, verbose=False)
+    except ValueError as error:
+        assert False, f"an enabled textual session value was rejected: {error}"
+    assert check.kept is False
+    assert check.metadata["invalid_chains"]
+
