@@ -0,0 +1,602 @@
+"""
+Supplemental pass-to-pass (P2P) regression tests for session option handling.
+
+Every test in this module describes behaviour that the baseline already exhibits and
+that must survive giving session-level options a single typed, semantic owner:
+
+* the public configuration API keeps returning a plain dictionary of raw string values,
+* the public lint entry point keeps its parameters, defaults and result,
+* session options keep reaching graph building and contracts with the same interpretation,
+* session options that do not drive behaviour keep not driving behaviour.
+
+These tests are deliberately written against public entry points only, so that any
+correct internal representation of the session options satisfies them.
+"""
+
+import contextlib
+from collections import UserString
+import inspect
+from pathlib import Path
+from textwrap import dedent
+
+import pytest
+from grimp import ImportGraph
+
+from importlinter import api, cli, configuration
+from importlinter.application.output import console
+from importlinter.application.sentinels import NotSupplied
+from importlinter.application.use_cases import lint_imports
+from importlinter.contracts.forbidden import ForbiddenContract
+from importlinter.domain.contract import Contract, ContractCheck
+
+TESTPACKAGE_DIRECTORY = Path(__file__).resolve().parents[1] / "assets" / "testpackage"
+
+
+@pytest.fixture(autouse=True)
+def _restore_default_configuration():
+    # The default readers, file system, timer and graph builder, as configured by
+    # importlinter.configuration.configure().
+    configuration.configure()
+
+
+class RecordingGraphBuilder:
+    """
+    Graph builder that records the arguments it was called with instead of building a graph.
+    """
+
+    def __init__(self) -> None:
+        self.build_arguments = None
+
+    def build(
+        self,
+        root_package_names,
+        cache_dir,
+        include_external_packages=False,
+        exclude_type_checking_imports=False,
+    ) -> ImportGraph:
+        self.build_arguments = {
+            "root_package_names": root_package_names,
+            "cache_dir": cache_dir,
+            "include_external_packages": include_external_packages,
+            "exclude_type_checking_imports": exclude_type_checking_imports,
+        }
+        return ImportGraph()
+
+
+@contextlib.contextmanager
+def _recording_graph_builder():
+    """
+    Temporarily install a graph builder that records the arguments it is called with.
+
+    The previously configured builder is restored afterwards through the public
+    configuration API, so that no global configuration leaks into other tests.
+    """
+    builder = RecordingGraphBuilder()
+    previous_builder = configuration.settings.GRAPH_BUILDER
+    configuration.settings.configure(GRAPH_BUILDER=builder)
+    try:
+        yield builder
+    finally:
+        configuration.settings.configure(GRAPH_BUILDER=previous_builder)
+
+
+RECORDED_SESSION_OPTIONS: list[dict] = []
+RECORDED_CONSTRUCTION_ROOTS: list[list[str]] = []
+
+
+class SessionOptionsRecordingContract(Contract):
+    """
+    Custom contract type, as supplied by an integrator, that reads session options by key.
+    """
+
+    def validate(self) -> None:
+        # Contract.__init__ invokes this public hook before construction completes.
+        # Custom types may read roots here, before check() is ever reached.
+        assert type(self.session_options["root_packages"]) is list
+        assert "root_package" not in self.session_options
+        RECORDED_CONSTRUCTION_ROOTS.append(list(self.session_options["root_packages"]))
+
+    def check(self, graph: ImportGraph, verbose: bool) -> ContractCheck:
+        assert type(self.session_options["root_packages"]) is list
+        RECORDED_SESSION_OPTIONS.append(
+            {
+                "root_packages": self.session_options["root_packages"],
+                "has_legacy_root_package": "root_package" in self.session_options,
+            }
+        )
+        return ContractCheck(kept=True)
+
+    def render_broken_contract(self, check: ContractCheck) -> None:
+        raise NotImplementedError
+
+
+class SessionStateContract(Contract):
+    """Custom contracts exchange metadata through their session mapping."""
+
+    def check(self, graph: ImportGraph, verbose: bool) -> ContractCheck:
+        if self.name == "Publish session state":
+            self.session_options["contract_state"] = "pending"
+            self.session_options["contract_state"] = "ready"
+            del self.session_options["contract_temporary"]
+        else:
+            assert self.session_options["contract_state"] == "ready"
+            assert "contract_temporary" not in self.session_options
+        return ContractCheck(kept=True)
+
+    def render_broken_contract(self, check: ContractCheck) -> None:
+        raise NotImplementedError
+
+
+def _write_config(directory: Path, filename: str, contents: str) -> str:
+    config_filename = directory / filename
+    config_filename.write_text(dedent(contents))
+    return str(config_filename)
+
+
+# The public configuration API
+# ----------------------------
+
+
+def test_read_configuration_returns_plain_dict_of_raw_values(tmp_path):
+    config_filename = _write_config(
+        tmp_path,
+        "pyproject.toml",
+        """
+        [tool.importlinter]
+        root_package = "testpackage"
+        include_external_packages = true
+        exclude_type_checking_imports = false
+
+        [[tool.importlinter.contracts]]
+        name = "Contract one"
+        type = "forbidden"
+        source_modules = ["testpackage.high.blue"]
+        forbidden_modules = ["testpackage.high.green"]
+        """,
+    )
+
+    result = api.read_configuration(config_filename)
+
+    assert type(result) is dict
+    assert set(result.keys()) == {"session_options", "contracts_options"}
+    session_options = result["session_options"]
+    # The typed representation must not be exposed, and no value may be converted to a boolean.
+    assert type(session_options) is dict
+    assert session_options == {
+        "root_packages": ["testpackage"],
+        "include_external_packages": "True",
+        "exclude_type_checking_imports": "False",
+    }
+    assert result["contracts_options"] == [
+        {
+            "name": "Contract one",
+            "type": "forbidden",
+            "source_modules": ["testpackage.high.blue"],
+            "forbidden_modules": ["testpackage.high.green"],
+        }
+    ]
+
+
+def test_read_configuration_keeps_ini_values_as_strings(tmp_path):
+    config_filename = _write_config(
+        tmp_path,
+        "setup.cfg",
+        """
+        [importlinter]
+        root_package = testpackage
+        include_external_packages = True
+        """,
+    )
+
+    result = api.read_configuration(config_filename)
+
+    assert type(result["session_options"]) is dict
+    assert result["session_options"] == {
+        "root_packages": ["testpackage"],
+        "include_external_packages": "True",
+    }
+
+
+def test_read_configuration_raises_file_not_found_for_missing_file(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        api.read_configuration(str(tmp_path / "no-such-configuration-file.ini"))
+
+    # A file with a session section but no root declaration is invalid, rather
+    # than a successfully loaded configuration or a missing configuration file.
+    for filename, contents in (
+        ("missing-roots.ini", "[importlinter]\ninclude_external_packages = true\n"),
+        ("missing-roots.toml", "[tool.importlinter]\ninclude_external_packages = true\n"),
+    ):
+        config_filename = _write_config(tmp_path, filename, contents)
+        with pytest.raises(KeyError):
+            api.read_configuration(config_filename)
+
+
+# The public lint entry point
+# ---------------------------
+
+
+def test_lint_imports_public_signature_is_unchanged():
+    parameters = inspect.signature(lint_imports).parameters
+
+    assert list(parameters) == [
+        "config_filename",
+        "limit_to_contracts",
+        "cache_dir",
+        "is_debug_mode",
+        "show_timings",
+        "no_logo",
+        "verbose",
+    ]
+    for parameter in parameters.values():
+        assert parameter.kind is inspect.Parameter.POSITIONAL_OR_KEYWORD, (
+            f"{parameter.name} must remain callable by position and by keyword"
+        )
+    assert parameters["config_filename"].default is None
+    assert parameters["limit_to_contracts"].default == ()
+    assert parameters["cache_dir"].default is NotSupplied
+    assert parameters["is_debug_mode"].default is False
+    assert parameters["show_timings"].default is False
+    assert parameters["no_logo"].default is False
+    assert parameters["verbose"].default is False
+
+
+def test_public_api_exposes_read_configuration_and_no_lint_imports_alias():
+    assert callable(api.read_configuration)
+    assert not hasattr(api, "lint_imports")
+
+
+# Session options reaching graph building and contracts
+# ----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "raw_value, expected",
+    (
+        ("True", True),
+        ("true", True),
