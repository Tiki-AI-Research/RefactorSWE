 from typing import Any
+from collections.abc import Mapping
 
 
 class InvalidUserOptions(Exception):
     pass
+
+
+def _is_truthy(value: Any) -> bool:
+    return str(value).lower() == "true"
+
+
+class SessionOptions(dict[str, Any]):
+    """
+    Typed owner for session-level options, preserving raw values as a mapping.
+    """
+
+    def __init__(self, raw_options: Mapping[str, Any] | None = None) -> None:
+        super().__init__(raw_options or {})
+
+    def normalize_root_packages(self) -> None:
+        """
+        Normalize root_package -> root_packages in-place.
+        """
+        if "root_packages" not in self:
+            if "root_package" in self:
+                self["root_packages"] = [self["root_package"]]
+        if "root_package" in self:
+            del self["root_package"]
+
+    @property
+    def root_packages(self) -> list[str]:
+        if "root_packages" in self:
+            return self["root_packages"]
+        if "root_package" in self:
+            return [self["root_package"]]
+        raise KeyError("root_packages")
+
+    @property
+    def include_external_packages(self) -> bool | None:
+        if "include_external_packages" not in self:
+            return None
+        return _is_truthy(self["include_external_packages"])
+
+    @property
+    def exclude_type_checking_imports(self) -> bool:
+        if "exclude_type_checking_imports" not in self:
+            return False
+        return _is_truthy(self["exclude_type_checking_imports"])
+
+    @property
+    def show_timings(self) -> bool:
+        if "show_timings" not in self:
+            return False
+        return _is_truthy(self["show_timings"])
 
 
 class UserOptions:
