+def test_session_options_missing_defaults():
+    options = SessionOptions({"root_packages": ["pkg"]})
+    assert options.include_external_packages is None
+    assert options.exclude_type_checking_imports is False
+    assert options.show_timings is False
+
+
+def test_session_options_root_packages_resolution_and_normalization():
+    # Singular fallback
+    single = SessionOptions({"root_package": "pkg_a"})
+    assert single.root_packages == ["pkg_a"]
+    single.normalize_root_packages()
+    assert single["root_packages"] == ["pkg_a"]
+    assert "root_package" not in single
+
+    # Plural takes precedence
+    both = SessionOptions({"root_packages": ["pkg_b"], "root_package": "pkg_legacy"})
+    assert both.root_packages == ["pkg_b"]
+    both.normalize_root_packages()
+    assert both["root_packages"] == ["pkg_b"]
+    assert "root_package" not in both
+
+    # Empty raises KeyError on property
+    empty = SessionOptions({})
+    with pytest.raises(KeyError):
+        _ = empty.root_packages
+
+
