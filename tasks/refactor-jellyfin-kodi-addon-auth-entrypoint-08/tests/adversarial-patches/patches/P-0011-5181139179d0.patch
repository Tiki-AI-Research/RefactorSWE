diff --git a/jellyfin_kodi/jellyfin/configuration.py b/jellyfin_kodi/jellyfin/configuration.py
index 1b80cd9d1f5774e87e9966574e06690809d633a9..19b7370134726b2ad21d7829812023b752010976 100644
--- a/jellyfin_kodi/jellyfin/configuration.py
+++ b/jellyfin_kodi/jellyfin/configuration.py
@@ -19,6 +19,53 @@ DEFAULT_HTTP_TIMEOUT = 30
 
 class Config(object):
 
+    _credentials_cache = None
+
+    @classmethod
+    def reset_credentials_cache(cls):
+        cls._credentials_cache = None
+
+    @classmethod
+    def _load_credentials(cls):
+        if cls._credentials_cache is not None:
+            success, result = cls._credentials_cache
+            if success:
+                return result
+            raise result
+
+        try:
+            from ..database import read_credentials
+
+            credentials = read_credentials()
+            cls._credentials_cache = (True, credentials)
+            return credentials
+        except Exception as e:
+            cls._credentials_cache = (False, e)
+            raise
+
+    @classmethod
+    def get_credentials(cls):
+        return cls._load_credentials()
+
+    @classmethod
+    def get_server(cls):
+        credentials = cls._load_credentials()
+        return credentials["Servers"][0]
+
+    get_first_server = get_server
+
+    def inject(self, target=None):
+        cfg = target or self
+        if not isinstance(cfg, Config):
+            raise TypeError("Config instance required for inject")
+        server = self.get_server()
+        cfg.data["auth.server"] = server.get("address")
+        cfg.data["auth.server-name"] = server.get("Name")
+        cfg.data["auth.user_id"] = server.get("UserId")
+        cfg.data["auth.token"] = server.get("AccessToken")
+
+    inject_credentials = inject
+
     def __init__(self):
 
         LOG.debug("Configuration initializing...")
