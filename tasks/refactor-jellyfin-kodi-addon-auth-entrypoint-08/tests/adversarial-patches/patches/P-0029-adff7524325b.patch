+    assert database.get_credentials()["Servers"][0]["address"] == "http://v1:8096"
+
+    _write_data(tmp_path, {"Servers": [{"address": "http://v2:8096"}]})
+    assert database.get_credentials()["Servers"][0]["address"] == "http://v2:8096"
