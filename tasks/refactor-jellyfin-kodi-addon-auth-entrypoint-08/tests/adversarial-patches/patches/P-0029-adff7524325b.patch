+def test_get_credentials_semantics(tmp_path):
+    # Missing file returns {"Servers": []}
+    assert database.get_credentials() == {"Servers": []}
+
+    # ManualAddress / LocalAddress migration
+    _write_data(
+        tmp_path,
+        {
+            "Servers": [
+                {
+                    "Name": "S1",
+                    "ManualAddress": "http://manual:8096",
+                    "LocalAddress": "http://local:8096",
+                    "RemoteAddress": "http://remote:8096",
+                    "LastConnectionMode": "Manual",
+                }
+            ]
+        },
+    )
+    res = database.get_credentials()
+    srv = res["Servers"][0]
+    assert srv["address"] == "http://manual:8096"
+    assert "ManualAddress" not in srv
+    assert "LocalAddress" not in srv
+    assert "RemoteAddress" not in srv
+    assert "LastConnectionMode" not in srv
+
+    # LocalAddress only
+    _write_data(tmp_path, {"Servers": [{"LocalAddress": "http://local-only:8096"}]})
+    res = database.get_credentials()
+    assert res["Servers"][0]["address"] == "http://local-only:8096"
+
+    # Bad JSON propagates
+    _write_data(tmp_path, "not a valid json {")
+    with pytest.raises(json.JSONDecodeError):
+        database.get_credentials()
+
+    # Null root propagates AttributeError
+    _write_data(tmp_path, "null")
+    with pytest.raises(AttributeError):
+        database.get_credentials()
+
+    # Non-list Servers passes through
+    _write_data(tmp_path, {"Servers": "non-list-string"})
+    res = database.get_credentials()
+    assert res["Servers"] == "non-list-string"
+
