+_old_argv = list(sys.argv)
+sys.argv = ["plugin://plugin.video.jellyfin/", "1", ""]
+try:
+    from jellyfin_kodi.entrypoint import default as default_mod
+finally:
+    sys.argv = _old_argv
+
+
+@pytest.fixture(autouse=True)
+def reset_credentials_cache(monkeypatch, tmp_path):
+    Config.reset_credentials_cache()
+    monkeypatch.setattr(database, "ADDON_DATA", str(tmp_path))
+    yield
+    Config.reset_credentials_cache()
+
+
+def _write_data(tmp_path, data):
+    path = tmp_path / "data.json"
+    if isinstance(data, str):
+        path.write_text(data, encoding="utf-8")
+    else:
+        path.write_text(json.dumps(data), encoding="utf-8")
+    return path
+
+
+def test_config_inject_values(tmp_path):
+    server = {
+        "address": "http://192.168.1.100:8096",
+        "Name": "HomeServer",
+        "UserId": "user-uuid-1",
+        "AccessToken": "token-xyz",
+    }
+    _write_data(tmp_path, {"Servers": [server, {"address": "http://other:8096"}]})
+
+    cfg = Config()
+    cfg.inject()
+
+    assert cfg.data["auth.server"] == "http://192.168.1.100:8096"
+    assert cfg.data["auth.server-name"] == "HomeServer"
+    assert cfg.data["auth.user_id"] == "user-uuid-1"
+    assert cfg.data["auth.token"] == "token-xyz"
+
+
+def test_config_inject_partial_fields(tmp_path):
+    _write_data(tmp_path, {"Servers": [{"address": "http://server:8096"}]})
+
+    cfg = Config()
+    cfg.inject()
+
+    assert cfg.data["auth.server"] == "http://server:8096"
+    assert cfg.data["auth.server-name"] is None
+    assert cfg.data["auth.user_id"] is None
+    assert cfg.data["auth.token"] is None
+
+
+def test_config_read_once_and_cached(monkeypatch, tmp_path):
+    _write_data(tmp_path, {"Servers": [{"address": "http://srv:8096", "Name": "S"}]})
+    original_read = database.read_credentials
+    read_spy = MagicMock(side_effect=original_read)
+    monkeypatch.setattr(database, "read_credentials", read_spy)
+
+    cfg1 = Config()
+    cfg1.inject()
+    cfg2 = Config()
+    cfg2.inject()
+    srv = Config.get_server()
+    creds = Config.get_credentials()
+
+    assert read_spy.call_count == 1
+    assert cfg1.data["auth.server"] == cfg2.data["auth.server"] == "http://srv:8096"
+    assert srv["address"] == "http://srv:8096"
+    assert creds["Servers"][0]["Name"] == "S"
+
+
+@pytest.mark.parametrize("payload", [{"Servers": []}, {}])
+def test_config_empty_servers_cached_failure(monkeypatch, tmp_path, payload):
