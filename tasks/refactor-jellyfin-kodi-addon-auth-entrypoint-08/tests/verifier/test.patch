+# -*- coding: utf-8 -*-
+"""P2P regression coverage for the stored addon connection data refactor.
+
+The addon stores its connection data (server address, server name, signed-in
+user id, access token and per-server path replacements) in one data file that
+used to be read by four independent call sites.  The refactor moves that read
+into the communication layer, so the tests here pin down the behaviour that
+must survive it: which values reach ``api_client.config.data``, how an
+unconfigured addon is reported, which failure the context entry point keeps
+propagating, and which path replacements the item helper applies.
+
+Every scenario runs in a fresh interpreter.  The refactor is allowed to load
+the stored connection data once and reuse it for the rest of a run, so
+scenarios that use different stored data must not share a process.  The child
+process resolves both the ``translate_path`` route and the ``database.ADDON_DATA``
+route to the scenario's temporary addon data directory, which keeps the
+scenarios independent of where the loader lives.
+"""
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+WARNING = "Addon appears to not be configured yet"
+RESULT_PREFIX = "P2P_RESULT "
+
+SERVER = {
+    "Id": "server-1",
+    "address": "http://jellyfin.example:8096",
+    "Name": "Jellyfin",
+    "UserId": "user-1",
+    "AccessToken": "token-1",
+    "paths": {"/media/remote": "/media/local"},
+}
+
+SECOND_SERVER = {
+    "Id": "server-2",
+    "address": "http://second.example:8096",
+    "Name": "Second",
+    "UserId": "user-2",
+    "AccessToken": "token-2",
+    "paths": {"/other/remote": "/other/local"},
+}
+
+SERVER_WITHOUT_PATHS = {
+    "Id": "server-1",
+    "address": "http://jellyfin.example:8096",
+    "Name": "Jellyfin",
+    "UserId": "user-1",
+    "AccessToken": "token-1",
+}
+
+SERVER_WITHOUT_OPTIONAL_FIELDS = {
+    "Id": "server-1",
+    "address": "http://only-address.example:8096",
+}
+
+LEGACY_SERVER = {
+    "Id": "server-1",
+    "RemoteAddress": "http://remote.example:8096",
+    "ManualAddress": "http://manual.example:8096",
+    "LocalAddress": "http://local.example:8096",
+    "LastConnectionMode": "Manual",
+    "Name": "Jellyfin",
+    "UserId": "user-1",
+    "AccessToken": "token-1",
+}
+
+MOVIE = {"Type": "Movie", "Name": "Movie", "Path": "/media/remote/movie.mkv"}
+
+DRIVER_SOURCE = r'''# -*- coding: utf-8 -*-
+"""Execute one stored connection data scenario in a fresh interpreter."""
+
+import json
+import logging
+import os
+import sys
+
+DATA_DIR = os.environ["P2P_DATA_DIR"]
+SCENARIO = os.environ["P2P_SCENARIO"]
+
+sys.path.insert(0, os.environ["P2P_REPO_ROOT"])
+
+import xbmcvfs  # noqa: E402
+
+_ADDON_DATA_PREFIX = "special://profile/addon_data/plugin.video.jellyfin"
+_real_translate_path = xbmcvfs.translatePath
+
+
+def _translate_path(path):
+    if path.startswith(_ADDON_DATA_PREFIX):
+        return DATA_DIR + path[len(_ADDON_DATA_PREFIX):]
+
+    return _real_translate_path(path)
+
+
+xbmcvfs.translatePath = _translate_path
+os.chdir(DATA_DIR)
+
+WARNING_TEXT = "Addon appears to not be configured yet"
+WARNINGS = []
+
+
+class _WarningCapture(logging.Handler):
+    def emit(self, record):
+        try:
+            message = record.getMessage()
+        except Exception:
+            return
+
+        if WARNING_TEXT in message:
+            WARNINGS.append(message)
+
+
+logging.getLogger().addHandler(_WarningCapture())
+logging.getLogger("JELLYFIN").setLevel(logging.DEBUG)
+
+
+def _client():
+    from jellyfin_kodi.jellyfin import Jellyfin
+
+    Jellyfin().construct()
+
+    return Jellyfin(None).get_client()
+
+
+def _list_item():
+    class VideoInfoTag(object):
+        def getDbId(self):
+            return None
+
+        def getMediaType(self):
+            return None
+
+    class ListItem(object):
+        def getVideoInfoTag(self):
+            return VideoInfoTag()
+
+        def getProperty(self, name):
+            return {"jellyfinid": "item-1"}.get(name)
+
+    return ListItem()
+
+
+def _error_name(error):
+    return None if error is None else type(error).__name__
+
+
+def _emit(payload):
+    payload = dict(payload)
+    payload["warnings"] = list(WARNINGS)
+    sys.stdout.write("P2P_RESULT " + json.dumps(payload) + "\n")
+    sys.stdout.flush()
+
+
+def actions_configured():
+    from jellyfin_kodi.objects.actions import Actions
+
+    client = _client()
+    actions = Actions(None, None)
+
+    _emit({"data": dict(client.jellyfin.config.data), "server": actions.server})
+
+
+def actions_unconfigured():
+    from jellyfin_kodi.objects.actions import Actions
+
+    client = _client()
+    client.jellyfin.config.data["auth.server"] = "http://preexisting.example"
+
+    error = None
+    server = None
+
+    try:
+        server = Actions(None, None).server
+    except BaseException as exc:
+        error = exc
+
+    _emit(
+        {
+            "data": dict(client.jellyfin.config.data),
+            "server": server,
+            "error": _error_name(error),
+        }
+    )
+
+
+def events_configured():
+    sys.argv = ["plugin://plugin.video.jellyfin/", "1", ""]
+
+    from jellyfin_kodi.entrypoint.default import Events
+
+    client = _client()
+
+    error = None
+
+    try:
+        Events()
+    except BaseException as exc:
+        error = exc
+
+    _emit({"data": dict(client.jellyfin.config.data), "error": _error_name(error)})
+
+
+def context_configured():
+    sys.listitem = _list_item()
+
+    from jellyfin_kodi.entrypoint.context import Context
+
+    client = _client()
+    client.jellyfin.get_item = lambda item_id: None
+
+    error = None
+
+    try:
+        Context()
+    except BaseException as exc:
+        error = exc
+
+    _emit(
+        {
+            "data": dict(client.jellyfin.config.data),
+            "error": _error_name(error),
+            "error_is_oserror": isinstance(error, OSError),
+        }
+    )
+
+
+def api_configured():
+    from jellyfin_kodi.helper.api import API
+
+    api = API(dict(MOVIE))
+
+    _emit(
+        {
+            "path_data": api.path_data,
+            "file_path": api.get_file_path(),
+            "unmatched": api.get_file_path("/other/place/movie.mkv"),
+        }
+    )
+
+
+def api_server_argument():
+    from jellyfin_kodi.helper.api import API
+
+    api = API(dict(MOVIE), "http://artwork.example")
+
+    _emit(
+        {
+            "server": api.server,
+            "file_path": api.get_file_path(),
+            "artwork": api.get_artwork("item-1", "Primary"),
+        }
+    )
+
+
+def api_unconfigured():
+    from jellyfin_kodi.helper.api import API
+
+    error = None
+
+    try:
+        API(dict(MOVIE))
+    except BaseException as exc:
+        error = exc
+
+    _emit({"error": _error_name(error)})
+
+
+def stored_accessor():
+    from jellyfin_kodi import database
+
+    error = None
+    credentials = None
+
+    try:
+        credentials = database.get_credentials()
+    except BaseException as exc:
+        error = exc
+
+    _emit({"credentials": credentials, "error": _error_name(error)})
+
+
+def stored_accessor_round_trip():
+    from jellyfin_kodi import database
+
+    database.get_credentials()
+
+    database.save_credentials(
+        {
+            "Servers": [
+                {
+                    "Id": "server-2",
+                    "address": "http://saved.example:8096",
+                    "Name": "Saved",
+                    "UserId": "user-2",
+                    "AccessToken": "token-2",
+                    "paths": {"/saved/remote": "/saved/local"},
+                }
+            ]
+        }
+    )
+
+    _emit({"credentials": database.get_credentials()})
+
+
+
+def actions_server_id():
+    from jellyfin_kodi.jellyfin import Jellyfin
+    from jellyfin_kodi.objects.actions import Actions
+
+    Jellyfin().construct()
+    Jellyfin("server-1").construct()
+
+    default_client = Jellyfin(None).get_client()
+    server_client = Jellyfin("server-1").get_client()
+
+    actions = Actions("server-1", None)
+
+    _emit(
+        {
+            "server": actions.server,
+            "server_data": dict(server_client.jellyfin.config.data),
+            "default_data": dict(default_client.jellyfin.config.data),
+        }
+    )
+
+
+def stored_accessor_legacy_migration():
+    from jellyfin_kodi import database
+
+    _emit({"credentials": database.get_credentials()})
+
+
+def stored_accessor_logging_consumer():
+    from jellyfin_kodi.helper import loghandler
+
+    handler = loghandler.LogHandler()
+
+    _emit(
+        {
+            "servers": handler.sensitive["Server"],
+            "tokens": handler.sensitive["Token"],
+        }
+    )
+
+
+def stored_accessor_path_replacements_consumer():
+    import jellyfin_kodi.helper.utils as utils
+
+    utils.dialog = lambda *args, **kwargs: -1
+    utils.path_replacements()
+
+    from jellyfin_kodi import database
+
+    _emit({"credentials": database.get_credentials()})
+
+MOVIE = {"Type": "Movie", "Name": "Movie", "Path": "/media/remote/movie.mkv"}
+
+SCENARIOS = {
+    "actions_configured": actions_configured,
+    "actions_unconfigured": actions_unconfigured,
+    "events_configured": events_configured,
+    "context_configured": context_configured,
+    "api_configured": api_configured,
+    "api_server_argument": api_server_argument,
+    "api_unconfigured": api_unconfigured,
+    "stored_accessor": stored_accessor,
+    "stored_accessor_round_trip": stored_accessor_round_trip,
+    "actions_server_id": actions_server_id,
+    "stored_accessor_legacy_migration": stored_accessor_legacy_migration,
+    "stored_accessor_logging_consumer": stored_accessor_logging_consumer,
+    "stored_accessor_path_replacements_consumer": stored_accessor_path_replacements_consumer,
+}
+
+SCENARIOS[SCENARIO]()
+'''
+
+
+def run_scenario(tmp_path, scenario, servers=None, data_file="file", payload=None,
+                 driver_source=None):
+    """Run one scenario in a fresh interpreter and return its reported values."""
+
+    data_dir = tmp_path / "addon_data"
+    data_dir.mkdir()
+
+    if data_file == "file":
+        stored = (
+            payload
+            if payload is not None
+            else {"Servers": [SERVER] if servers is None else servers}
+        )
+        (data_dir / "data.json").write_text(json.dumps(stored))
+    elif data_file == "directory":
+        (data_dir / "data.json").mkdir()
+
+    driver = tmp_path / "scenario_driver.py"
+    driver.write_text(DRIVER_SOURCE if driver_source is None else driver_source)
+
+    env = dict(os.environ)
+    env["P2P_REPO_ROOT"] = str(REPO_ROOT)
+    env["P2P_DATA_DIR"] = str(data_dir)
+    env["P2P_SCENARIO"] = scenario
+    env["PYTHONPATH"] = str(REPO_ROOT) + os.pathsep + env.get("PYTHONPATH", "")
+
+    completed = subprocess.run(
+        [sys.executable, str(driver)],
+        cwd=str(data_dir),
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=120,
+    )
+
+    stdout = completed.stdout.decode("utf-8", "replace")
+    stderr = completed.stderr.decode("utf-8", "replace")
+
+    results = [
+        line[len(RESULT_PREFIX):]
+        for line in stdout.splitlines()
+        if line.startswith(RESULT_PREFIX)
+    ]
+
+    assert results, "scenario {!r} produced no result\nstdout:\n{}\nstderr:\n{}".format(
+        scenario, stdout, stderr
+    )
+
+    return json.loads(results[-1])
+
+
+def auth_values(payload):
+    data = payload["data"]
+
+    return {
+        key: data.get(key)
+        for key in ("auth.server", "auth.server-name", "auth.user_id", "auth.token")
+    }
+
+
+def assert_warned(payload):
+    assert any(
+        message.startswith(WARNING) for message in payload["warnings"]
+    ), "expected the stored-data warning, got {!r}".format(payload["warnings"])
+
+
+def test_actions_without_client_injects_first_server_auth(tmp_path):
+    payload = run_scenario(
+        tmp_path, "actions_configured", servers=[SERVER, SECOND_SERVER]
+    )
+
+    assert auth_values(payload) == {
+        "auth.server": SERVER["address"],
+        "auth.server-name": SERVER["Name"],
+        "auth.user_id": SERVER["UserId"],
+        "auth.token": SERVER["AccessToken"],
+    }
+    assert payload["server"] == SERVER["address"]
+
+
+def test_actions_ignores_second_stored_server(tmp_path):
+    payload = run_scenario(
+        tmp_path, "actions_configured", servers=[SERVER, SECOND_SERVER]
+    )
+
+    data = payload["data"]
+
+    assert data["auth.server"] == SERVER["address"]
+    assert data["auth.server-name"] == SERVER["Name"]
+    assert data["auth.user_id"] == SERVER["UserId"]
+    assert data["auth.token"] == SERVER["AccessToken"]
+    assert SECOND_SERVER["address"] not in data.values()
+
+
+def test_actions_sets_none_for_absent_auth_fields(tmp_path):
+    payload = run_scenario(
+        tmp_path, "actions_configured", servers=[SERVER_WITHOUT_OPTIONAL_FIELDS]
+    )
+
+    data = payload["data"]
+
+    assert data["auth.server"] == SERVER_WITHOUT_OPTIONAL_FIELDS["address"]
+    assert "auth.server-name" in data and data["auth.server-name"] is None
+    assert "auth.user_id" in data and data["auth.user_id"] is None
+    assert "auth.token" in data and data["auth.token"] is None
+    assert payload["server"] == SERVER_WITHOUT_OPTIONAL_FIELDS["address"]
+
+
+def test_actions_without_client_warns_and_continues_when_unconfigured(tmp_path):
+    payload = run_scenario(tmp_path, "actions_unconfigured", data_file="missing")
+
+    assert payload["error"] is None
+    assert payload["server"] == "http://preexisting.example"
+    assert_warned(payload)
+
+
+def test_playback_entry_point_injects_first_server_auth(tmp_path):
+    payload = run_scenario(
+        tmp_path, "events_configured", servers=[SERVER, SECOND_SERVER]
+    )
+
+    assert payload["error"] is None
+    assert auth_values(payload) == {
+        "auth.server": SERVER["address"],
+        "auth.server-name": SERVER["Name"],
+        "auth.user_id": SERVER["UserId"],
+        "auth.token": SERVER["AccessToken"],
+    }
+
+
+def test_playback_entry_point_warns_and_continues_when_unconfigured(tmp_path):
+    payload = run_scenario(tmp_path, "events_configured", data_file="missing")
+
+    assert payload["error"] is None
+    assert_warned(payload)
+
+
+def test_context_entry_point_injects_first_server_auth(tmp_path):
+    payload = run_scenario(
+        tmp_path, "context_configured", servers=[SERVER, SECOND_SERVER]
+    )
+
+    assert payload["error"] is None
+    assert auth_values(payload) == {
+        "auth.server": SERVER["address"],
+        "auth.server-name": SERVER["Name"],
+        "auth.user_id": SERVER["UserId"],
+        "auth.token": SERVER["AccessToken"],
+    }
+
+
+def test_context_entry_point_propagates_unopenable_stored_data(tmp_path):
+    payload = run_scenario(tmp_path, "context_configured", data_file="missing")
+
+    assert payload["error"] is not None, "the context entry point swallowed the failure"
+    assert payload["error_is_oserror"] is True, payload["error"]
+    assert payload["warnings"] == [], "the failure was downgraded to a warning"
+
+    for name, contents, expected_error in (
+        ("invalid_encoding", b"\xff", "UnicodeDecodeError"),
+        ("invalid_json", b"{", "JSONDecodeError"),
+        (
+            "integer_limit",
+            b'{"Servers": [], "large_integer": ' + b"9" * 5000 + b"}",
+            "ValueError",
+        ),
+    ):
+        directory = tmp_path / name
+        directory.mkdir()
+        source = DRIVER_SOURCE.replace(
+            "    try:\n        Context()",
+            "    sys.set_int_max_str_digits(4300)\n"
+            "    with open(os.path.join(DATA_DIR, 'data.json'), 'wb') as stored:\n"
+            "        stored.write({!r})\n".format(contents)
+            + "    try:\n        Context()",
+        )
+        payload = run_scenario(
+            directory, "context_configured", driver_source=source
+        )
+
+        assert payload["error"] == expected_error, payload
+        assert payload["warnings"] == [], (
+            "the stored-data decoding/parsing failure was downgraded to a warning"
+        )
+
+
+def test_context_entry_point_warns_and_continues_without_stored_servers(tmp_path):
