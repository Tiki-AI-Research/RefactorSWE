+import ast
+from pathlib import Path
+
+from tests import test_p2p_connection_data_regression as regression
+
+
+AUTH_KEYS = ("auth.server", "auth.server-name", "auth.user_id", "auth.token")
+SOURCE_KEYS = ("address", "Name", "UserId", "AccessToken")
+EXPECTED_AUTH = dict(zip(AUTH_KEYS, (regression.SERVER[key] for key in SOURCE_KEYS)))
+DEFAULT_AUTH = dict.fromkeys(AUTH_KEYS, "default-stale")
+
+CONTRACT_DRIVER = r"""
+AUTH_KEYS = ("auth.server", "auth.server-name", "auth.user_id", "auth.token")
+
+
+def _contract_clients():
+    from jellyfin_kodi.jellyfin import Jellyfin
+
+    Jellyfin().construct()
+    Jellyfin("requested").construct()
+    default = Jellyfin(None).get_client()
+    requested = Jellyfin("requested").get_client()
+    default.jellyfin.config.data.update(dict.fromkeys(AUTH_KEYS, "default-stale"))
+    requested.jellyfin.config.data.update(dict.fromkeys(AUTH_KEYS, "requested-stale"))
+    return default, requested
+
+
+def _auth_snapshot(client):
+    return {key: client.config.data.get(key) for key in AUTH_KEYS}
+
+
+def _request_contract(entry):
+    default, requested = _contract_clients()
+    requests = []
+    errors = []
+
+    def observe(client, item_id):
+        requests.append({"auth": _auth_snapshot(client),
+                         "requested_client": client is requested.jellyfin,
+                         "item_id": item_id})
+        return dict(MOVIE) if entry == "events" else None
+
+    requested.jellyfin.get_item = lambda item_id: observe(requested.jellyfin, item_id)
+    default.jellyfin.get_item = lambda item_id: observe(default.jellyfin, item_id)
+
+    if entry == "events":
+        sys.argv = ["plugin://plugin.video.jellyfin/", "1",
+                    "?mode=play&id=item-1&server=requested"]
+        import jellyfin_kodi.entrypoint.default as entrypoint
+
+        class PlaybackSink:
+            def __init__(self, server_id=None, api_client=None):
+                self.api_client = api_client
+
+            def play(self, *args, **kwargs):
+                return None
+
+        entrypoint.Actions = PlaybackSink
+        construct = entrypoint.Events
+    else:
+        sys.listitem = _list_item()
+        sys.listitem.getProperty = lambda name: {
+            "jellyfinid": "item-1", "jellyfinserver": "requested"
+        }.get(name)
+        from jellyfin_kodi.entrypoint.context import Context
+        construct = Context
+
+    count = 2 if SCENARIO.endswith("cached") else 1
+    for attempt in range(count):
+        default.jellyfin.config.data.update(dict.fromkeys(AUTH_KEYS, "default-stale"))
+        requested.jellyfin.config.data.update(dict.fromkeys(AUTH_KEYS, "requested-stale"))
+        try:
+            construct()
+            errors.append(None)
+        except BaseException as error:
+            errors.append(_error_name(error))
+
+    _emit({"requests": requests, "errors": errors,
+           "default_data": _auth_snapshot(default.jellyfin),
+           "requested_data": _auth_snapshot(requested.jellyfin),
+           "separate_clients": default.jellyfin is not requested.jellyfin})
+
+
+def _actions_contract():
+    default, requested = _contract_clients()
+    default.jellyfin.config.data["auth.server"] = None
+    requested.jellyfin.config.data["auth.server"] = None
+    from jellyfin_kodi.objects.actions import Actions
+
+    server_id = None if SCENARIO == "actions_safe_default" else "requested"
+    target = default if server_id is None else requested
+    error = None
+    server = None
+    identity = False
+    try:
+        actions = Actions() if server_id is None else Actions(server_id)
+        server = actions.server
+        identity = actions.api_client is target.jellyfin
+    except BaseException as failure:
+        error = _error_name(failure)
+    _emit({"error": error, "server": server, "target_identity": identity,
+           "data": _auth_snapshot(target.jellyfin)})
+
+
+def _api_default_contract():
+    from jellyfin_kodi.helper.api import API
+
+    item_paths = []
+    item_path_errors = []
+    paths = []
+    construction_errors = []
+    path_errors = []
+    for attempt in range(3):
+        try:
+            api = API(dict(MOVIE))
+            construction_errors.append(None)
+        except BaseException as error:
+            construction_errors.append(_error_name(error))
+            continue
+        try:
+            item_paths.append(api.get_file_path())
+            item_path_errors.append(None)
+        except BaseException as error:
+            item_paths.append(None)
+            item_path_errors.append(_error_name(error))
+        try:
+            paths.append(api.get_file_path("/other/movie.mkv"))
+            path_errors.append(None)
+        except BaseException as error:
+            paths.append(None)
+            path_errors.append(_error_name(error))
+    _emit({"item_paths": item_paths, "item_path_errors": item_path_errors,
+           "paths": paths, "construction_errors": construction_errors,
+           "path_errors": path_errors})
+
+
+def _substring_contract():
+    from jellyfin_kodi.helper.api import API
+
+    api = API(dict(MOVIE))
+    _emit({"mapped": api.get_file_path("/archive/media/remote/movie.mkv"),
+           "unmatched": api.get_file_path("/archive/other/movie.mkv")})
+
+
+def _api_unconfigured_contract():
+    from jellyfin_kodi.helper.api import API
+
+    disk_calls = []
+    data_file = os.path.abspath(os.path.join(DATA_DIR, "data.json"))
+
+    def is_stored_file(path):
+        return (isinstance(path, (str, bytes, os.PathLike))
+                and os.path.abspath(os.fsdecode(path)) == data_file)
+
+    def observe_open(event, args):
+        if event == "open" and is_stored_file(args[0]):
+            disk_calls.append(event)
+
+    def observe_metadata(original):
+        def observed(path, *args, **kwargs):
+            if is_stored_file(path):
+                disk_calls.append("metadata")
+            return original(path, *args, **kwargs)
+        return observed
+
+    sys.addaudithook(observe_open)
+    os.stat = observe_metadata(os.stat)
+    os.lstat = observe_metadata(os.lstat)
+    construction_errors = []
+    servers = []
+    after_first = 0
+    shapes = (None, None, "http://artwork.example", None)
+    for attempt, server in enumerate(shapes):
+        try:
+            api = API(dict(MOVIE)) if server is None else API(dict(MOVIE), server)
+            construction_errors.append(None)
+            servers.append(api.server)
+        except BaseException as error:
+            construction_errors.append(_error_name(error))
+            servers.append(None)
+        if attempt == 0:
+            after_first = len(disk_calls)
+    _emit({"construction_errors": construction_errors, "servers": servers,
+           "extra_disk_calls": len(disk_calls) - after_first})
+
+
+def _actions_explicit_contract():
+    from jellyfin_kodi.jellyfin import Jellyfin
+    from jellyfin_kodi.objects.actions import Actions
+
+    _contract_clients()
+    Jellyfin("explicit").construct()
+    api_client = Jellyfin("explicit").get_client().jellyfin
+    api_client.config.data["auth.server"] = "http://explicit.example:8096"
+    results = []
+    for server_id in (None, "requested"):
+        error = None
+        identity = False
+        server = None
+        try:
+            actions = (Actions(api_client=api_client) if server_id is None
+                       else Actions(server_id, api_client))
+            identity = actions.api_client is api_client
+            server = actions.server
+        except BaseException as failure:
+            error = _error_name(failure)
+        results.append({"error": error, "identity": identity, "server": server})
+    _emit({"actions": results})
+
+
+def _path_preprocessing_contract():
+    from jellyfin_kodi.helper.api import API
+
+    path_cases = {
+        "path_dvd": [({"Path": "/disc", "Container": "dvd"}, None)],
+        "path_protocol": [({"Path": "SMB://host/share/Movie.mkv"}, None),
+                          ({"Path": "SMB://other/share/Movie.mkv"}, None)],
+        "path_empty": [({}, None), ({"Path": ""}, None),
+                       ({"Path": "/disc", "Container": "dvd"}, "")],
+        "path_unc": [({"Path": r"\\host\share\movie.mkv"}, None)],
+        "path_separators": [({"Path": r"C:\\dir/sub\\movie.mkv"}, None),
+                            ({"Path": r"C:\dir\\sub/movie.mkv"}, None)],
+        "path_bluray": [({"Path": "/disc", "Container": "bluray"}, None)],
+    }
+    paths = []
+    errors = []
+    for server in (None, "http://artwork.example"):
+        for fields, path in path_cases[SCENARIO]:
+            item = {"Type": "Movie", "Name": "Movie"}
+            item.update(fields)
+            try:
+                helper = API(item) if server is None else API(item, server)
+                paths.append(helper.get_file_path(path))
+                errors.append(None)
+            except BaseException as failure:
+                paths.append(None)
+                errors.append(_error_name(failure))
+    _emit({"paths": paths, "errors": errors})
+
+
+SCENARIOS.update({
+    "events_contract": lambda: _request_contract("events"),
+    "events_contract_cached": lambda: _request_contract("events"),
+    "context_contract": lambda: _request_contract("context"),
+    "context_contract_cached": lambda: _request_contract("context"),
+    "actions_safe_default": _actions_contract,
+    "actions_requested": _actions_contract,
+    "api_default_contract": _api_default_contract,
+    "api_unconfigured_contract": _api_unconfigured_contract,
+    "substring_contract": _substring_contract,
+    "actions_explicit_contract": _actions_explicit_contract,
+    "path_dvd": _path_preprocessing_contract,
+    "path_protocol": _path_preprocessing_contract,
+    "path_empty": _path_preprocessing_contract,
+    "path_unc": _path_preprocessing_contract,
+    "path_separators": _path_preprocessing_contract,
+    "path_bluray": _path_preprocessing_contract,
+})
+"""
+
+
+def run_contract(tmp_path, scenario, **kwargs):
+    marker = "SCENARIOS[SCENARIO]()"
+    assert regression.DRIVER_SOURCE.count(marker) == 1
+    driver = regression.DRIVER_SOURCE.replace(marker, CONTRACT_DRIVER + "\n" + marker)
+    return regression.run_scenario(tmp_path, scenario, driver_source=driver, **kwargs)
+
+
+def own_nodes(function):
+    pending = list(function.body)
+    while pending:
+        node = pending.pop()
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+            continue
+        yield node
+        pending.extend(ast.iter_child_nodes(node))
+
+
+def production_functions():
+    root = Path(__file__).resolve().parents[1]
+    for path in sorted((root / "jellyfin_kodi").rglob("*.py")):
+        tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+        for function in ast.walk(tree):
+            if isinstance(function, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                yield str(path.relative_to(root)), function, list(own_nodes(function))
+
+
+def test_stored_loading_and_normalization_have_one_owner():
+    readers = []
+    normalizers = []
+    for path, function, nodes in production_functions():
+        strings = {node.value for node in nodes
+                   if isinstance(node, ast.Constant) and isinstance(node.value, str)}
+        calls = [node for node in nodes if isinstance(node, ast.Call)]
+        if any(value == "data.json" or value.endswith("/data.json") for value in strings):
+            if any(isinstance(call.func, ast.Attribute)
+                   and call.func.attr in {"load", "loads"} for call in calls):
+                readers.append((path, function.name))
+        for node in nodes:
+            if not isinstance(node, ast.Assign) or not isinstance(node.value, ast.Call):
+                continue
+            value = node.value
+            if not (isinstance(value.func, ast.Attribute) and value.func.attr == "get"
+                    and value.args and isinstance(value.args[0], ast.Constant)
+                    and value.args[0].value == "Servers"):
+                continue
+            if any(isinstance(target, ast.Subscript)
+                   and isinstance(target.slice, ast.Constant)
+                   and target.slice.value == "Servers" for target in node.targets):
+                normalizers.append((path, function.name))
+    assert len(set(readers)) <= 1, "duplicate stored-file readers: {!r}".format(readers)
+    assert len(set(normalizers)) <= 1, "duplicate Servers normalization: {!r}".format(normalizers)
+
+
+def test_stored_auth_injection_has_one_owner():
+    owners = []
+    for path, function, nodes in production_functions():
+        strings = {node.value for node in nodes
+                   if isinstance(node, ast.Constant) and isinstance(node.value, str)}
+        supplied = {argument.arg for argument in function.args.args
+                    if argument.arg not in {"self", "cls"}}
+        for node in nodes:
+            if isinstance(node, ast.Assign) and isinstance(node.value, ast.Name):
+                if node.value.id in supplied:
+                    supplied.update(target.id for target in node.targets
+                                    if isinstance(target, ast.Name))
+        records = set()
+        for node in nodes:
+            if isinstance(node, ast.Subscript) and isinstance(node.slice, ast.Constant):
+                if node.slice.value in SOURCE_KEYS and isinstance(node.value, ast.Name):
+                    records.add(node.value.id)
+            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+                if (node.args and isinstance(node.args[0], ast.Constant)
+                        and node.args[0].value in SOURCE_KEYS
+                        and isinstance(node.func.value, ast.Name)):
+                    records.add(node.func.value.id)
+        if (set(AUTH_KEYS).issubset(strings) and set(SOURCE_KEYS).issubset(strings)
+                and records - supplied):
+            owners.append((path, function.name))
+    assert len(set(owners)) <= 1, "duplicate stored-auth mapping responsibilities: {!r}".format(owners)
+
