+# -*- coding: utf-8 -*-
+"""F2P coverage for the single stored-connection-data load.
+
+The refactor moves the addon data read out of the four call sites and into the
+communication layer, so the stored file must be loaded once and reused instead
+of being read again by every item helper instance or every entry-point
+invocation.  The behaviour the addon exposes for configured and unconfigured
+data is already pinned by the P2P suite; the observable delta owned here is the
+disk-read side effect and the loaded state it leaves behind.
+
+Every scenario runs in a fresh interpreter: the load may be cached for the rest
+of a run, so scenarios must not share a process.  Each child installs an audit
+hook that counts *read* opens of the addon data file, which makes the number of
+stored-data reads observable without pinning where the loader lives.  Both the
+``special://profile/addon_data`` route and the ``database.ADDON_DATA`` route
+resolve to the scenario's temporary addon data directory.
+
+The logging handler reads the stored data through the stored-credential
+accessor when it is first imported.  That read belongs to the logging consumer
+and is therefore done before the counter is reset, so the counted region only
+contains the reads caused by the consumer under test.
+"""
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+WARNING = "Addon appears to not be configured yet"
+RESULT_PREFIX = "F2P_RESULT "
+
+SERVER = {
+    "Id": "server-1",
+    "address": "http://jellyfin.example:8096",
+    "Name": "Jellyfin",
+    "UserId": "user-1",
+    "AccessToken": "token-1",
+    "paths": {"/media/remote": "/media/local"},
+}
+
+MOVIE = {"Type": "Movie", "Name": "Movie", "Path": "/media/remote/movie.mkv"}
+
+AUTH_KEYS = ("auth.server", "auth.server-name", "auth.user_id", "auth.token")
+
+EXPECTED_AUTH = {
+    "auth.server": SERVER["address"],
+    "auth.server-name": SERVER["Name"],
+    "auth.user_id": SERVER["UserId"],
+    "auth.token": SERVER["AccessToken"],
+}
+
+DRIVER_SOURCE = r'''# -*- coding: utf-8 -*-
+"""Execute one stored-data-load scenario in a fresh interpreter."""
+
+import json
+import logging
+import os
+import sys
+
+DATA_DIR = os.environ["F2P_DATA_DIR"]
+SCENARIO = os.environ["F2P_SCENARIO"]
+DATA_FILE = os.path.join(DATA_DIR, "data.json")
+
+sys.path.insert(0, os.environ["F2P_REPO_ROOT"])
+
+import xbmcvfs  # noqa: E402
+
+_ADDON_DATA_PREFIX = "special://profile/addon_data/plugin.video.jellyfin"
+_real_translate_path = xbmcvfs.translatePath
+
+
+def _translate_path(path):
+    if path.startswith(_ADDON_DATA_PREFIX):
+        return DATA_DIR + path[len(_ADDON_DATA_PREFIX):]
+
+    return _real_translate_path(path)
+
+
+xbmcvfs.translatePath = _translate_path
+os.chdir(DATA_DIR)
+
+_ABSOLUTE_DATA_FILE = os.path.abspath(DATA_FILE)
+READ_OPENS = []
+IMPORT_OPENS = []
+
+
+def _count_read_open(event, args):
+    """Count read opens of the stored addon data file."""
+
+    if event != "open":
+        return
+
+    try:
+        path = args[0]
+        mode = args[1]
+        flags = args[2] if len(args) > 2 else None
+    except (IndexError, TypeError):
+        return
+
+    if isinstance(path, int):
+        return
+
+    try:
+        if os.path.abspath(str(path)) != _ABSOLUTE_DATA_FILE:
+            return
+    except (TypeError, ValueError):
+        return
+
+    if isinstance(mode, str):
+        if any(flag in mode for flag in "wax+"):
+            return
+    elif isinstance(flags, int):
+        if flags & (
+            os.O_WRONLY | os.O_RDWR | os.O_APPEND | os.O_CREAT | os.O_TRUNC
+        ):
+            return
+
+    READ_OPENS.append(str(path))
+
+
+sys.addaudithook(_count_read_open)
+
+MOVIE = {"Type": "Movie", "Name": "Movie", "Path": "/media/remote/movie.mkv"}
+
+WARNING_TEXT = "Addon appears to not be configured yet"
+WARNINGS = []
+
+
+class _WarningCapture(logging.Handler):
+    def emit(self, record):
+        try:
+            message = record.getMessage()
+        except Exception:
+            return
+
+        if WARNING_TEXT in message:
+            WARNINGS.append(message)
+
+
+logging.getLogger().addHandler(_WarningCapture())
+logging.getLogger("JELLYFIN").setLevel(logging.DEBUG)
+
+
+def _load_modules():
+    """Import the modules a scenario uses, including the logging handler."""
+
+    import jellyfin_kodi.helper.loghandler  # noqa: F401
+    from jellyfin_kodi.jellyfin import Jellyfin  # noqa: F401
+    from jellyfin_kodi.entrypoint import default  # noqa: F401
+    from jellyfin_kodi.entrypoint.context import Context  # noqa: F401
+    from jellyfin_kodi.objects.actions import Actions  # noqa: F401
+    from jellyfin_kodi.helper.api import API  # noqa: F401
+
+
+def _begin():
+    """Start the counted region after the consumer-independent reads."""
+
+    global IMPORT_OPENS
+
+    _load_modules()
+    data_contents = os.environ.get("F2P_DATA_CONTENTS")
+    if data_contents is not None:
+        with open(DATA_FILE, "w") as outfile:
+            outfile.write(data_contents)
+    IMPORT_OPENS = list(READ_OPENS)
+    del READ_OPENS[:]
+
+
+def _client():
+    from jellyfin_kodi.jellyfin import Jellyfin
+
+    Jellyfin().construct()
+
+    return Jellyfin(None).get_client()
+
+
+def _list_item():
+    class VideoInfoTag(object):
+        def getDbId(self):
+            return None
+
+        def getMediaType(self):
+            return None
+
+    class ListItem(object):
+        def getVideoInfoTag(self):
+            return VideoInfoTag()
+
+        def getProperty(self, name):
+            return {"jellyfinid": "item-1"}.get(name)
+
+    return ListItem()
+
+
+def _error_name(error):
+    return None if error is None else type(error).__name__
+
+
+def _call(func):
+    """Run one site call and report its result or the raised error name."""
+
+    try:
+        return func(), None
+    except BaseException as error:
+        return None, _error_name(error)
+
+
+def _path_data(helper):
+    return getattr(helper, "path_data", None)
+
+
+def _emit(payload):
+    payload = dict(payload)
+    payload["warnings"] = list(WARNINGS)
+    payload["import_opens"] = len(IMPORT_OPENS)
+    payload["opens"] = len(READ_OPENS)
+    sys.stdout.write("F2P_RESULT " + json.dumps(payload) + "\n")
+    sys.stdout.flush()
+
+
+def _swap_stored_data():
+    """Rewrite the stored file as invalid data without changing its identity."""
+
+    stat = os.stat(DATA_FILE)
+
+    with open(DATA_FILE, "wb") as outfile:
+        outfile.write(b"!" * stat.st_size)
+
+    os.utime(DATA_FILE, ns=(stat.st_atime_ns, stat.st_mtime_ns))
+
+    after = os.stat(DATA_FILE)
+
+    return {
+        "identity_preserved": (
+            after.st_mtime_ns == stat.st_mtime_ns and after.st_size == stat.st_size
+        ),
+        "size": after.st_size,
+    }
+
+
+def helper_three():
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    _client()
+
+    helpers = [API(dict(MOVIE)) for _ in range(3)]
+
+    _emit({"path_data": [_path_data(helper) for helper in helpers]})
+
+
+def helper_shapes():
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    _client()
+
+    plain = API(dict(MOVIE))
+    with_server = API(dict(MOVIE), "http://artwork.example")
+    again = API(dict(MOVIE), "http://artwork.example")
+
+    _emit(
+        {
+            "path_data": [
+                _path_data(plain),
+                _path_data(with_server),
+                _path_data(again),
+            ],
+            "server": with_server.server,
+            "artwork": with_server.get_artwork("item-1", "Primary"),
+        }
+    )
+
+
+def helper_delta():
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    _client()
+
+    first = API(dict(MOVIE))
+    opens_after_first = len(READ_OPENS)
+    rest = [API(dict(MOVIE)) for _ in range(3)]
+
+    _emit(
+        {
+            "opens_after_first": opens_after_first,
+            "extra_opens": len(READ_OPENS) - opens_after_first,
+            "path_data": [_path_data(first)]
+            + [_path_data(helper) for helper in rest],
+        }
+    )
+
+
+def playback_twice():
+    sys.argv = ["plugin://plugin.video.jellyfin/", "1", "?mode=settings"]
+
+    from jellyfin_kodi.entrypoint import default as default_module
+
+    _begin()
+
+    client = _client()
+    client.jellyfin.config.data["app.session"] = "session-1"
+    client.jellyfin.post_session = lambda *args, **kwargs: None
+
+    errors = []
+    _, error = _call(default_module.Events)
+    errors.append(error)
+
+    default_module.QUERY_STRING = "?mode=playlist&id=item-1"
+    _, error = _call(default_module.Events)
+    errors.append(error)
+
+    _emit({"data": dict(client.jellyfin.config.data), "errors": errors})
+
+
+def actions_twice():
+    from jellyfin_kodi.objects.actions import Actions
+
+    _begin()
+    client = _client()
+
+    errors = []
+    servers = []
+
+    for _ in range(2):
+        actions, error = _call(lambda: Actions(None, None))
+        errors.append(error)
+        servers.append(None if actions is None else actions.server)
+
+    _emit(
+        {
+            "servers": servers,
+            "errors": errors,
+            "data": dict(client.jellyfin.config.data),
+        }
+    )
+
+
+def context_twice():
+    sys.listitem = _list_item()
+
+    from jellyfin_kodi.entrypoint.context import Context
+
+    _begin()
+    client = _client()
+    client.jellyfin.get_item = lambda item_id: None
+
+    errors = []
+
+    for transcode in (False, True):
+        _, error = _call(lambda: Context(transcode))
+        errors.append(error)
+
+    _emit({"data": dict(client.jellyfin.config.data), "errors": errors})
+
+
+def all_sites():
+    sys.argv = ["plugin://plugin.video.jellyfin/", "1", "?mode=settings"]
+    sys.listitem = _list_item()
+
+    from jellyfin_kodi.entrypoint import default as default_module
+    from jellyfin_kodi.entrypoint.context import Context
+    from jellyfin_kodi.objects.actions import Actions
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    client = _client()
+    client.jellyfin.get_item = lambda item_id: None
+
+    errors = []
+
+    for site in (
+        default_module.Events,
+        Context,
+        lambda: Actions(None, None),
+        lambda: API(dict(MOVIE)),
+    ):
+        _, error = _call(site)
+        errors.append(error)
+
+    actions = Actions(None, None)
+    helper = API(dict(MOVIE))
+
+    _emit(
+        {
+            "data": dict(client.jellyfin.config.data),
+            "errors": errors,
+            "server": actions.server,
+            "path_data": _path_data(helper),
+        }
+    )
+
+
+def helper_after_playback():
+    sys.argv = ["plugin://plugin.video.jellyfin/", "1", "?mode=settings"]
+
+    from jellyfin_kodi.entrypoint import default as default_module
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    client = _client()
+
+    default_module.Events()
+    opens_after_playback = len(READ_OPENS)
+
+    helpers = [API(dict(MOVIE)) for _ in range(3)]
+
+    _emit(
+        {
+            "opens_after_playback": opens_after_playback,
+            "extra_opens": len(READ_OPENS) - opens_after_playback,
+            "path_data": [_path_data(helper) for helper in helpers],
+            "data": dict(client.jellyfin.config.data),
+        }
+    )
+
+
+def playback_after_helper():
+    sys.argv = ["plugin://plugin.video.jellyfin/", "1", "?mode=settings"]
+
+    from jellyfin_kodi.entrypoint import default as default_module
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    client = _client()
+
+    helper = API(dict(MOVIE))
+    opens_after_helper = len(READ_OPENS)
+
+    default_module.Events()
+
+    _emit(
+        {
+            "opens_after_helper": opens_after_helper,
+            "extra_opens": len(READ_OPENS) - opens_after_helper,
+            "path_data": _path_data(helper),
+            "data": dict(client.jellyfin.config.data),
+        }
+    )
+
+
+def swap_helper():
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    _client()
+
+    loaded = API(dict(MOVIE))
+    swap = _swap_stored_data()
+    helpers = [API(dict(MOVIE)) for _ in range(3)]
+
+    _emit(
+        {
+            "swap": swap,
+            "loaded_path_data": _path_data(loaded),
+            "path_data": [_path_data(helper) for helper in helpers],
+        }
+    )
+
+
+def swap_playback():
+    sys.argv = ["plugin://plugin.video.jellyfin/", "1", "?mode=settings"]
+
+    from jellyfin_kodi.entrypoint import default as default_module
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    client = _client()
+
+    API(dict(MOVIE))
+    swap = _swap_stored_data()
+
+    _, error = _call(default_module.Events)
+
+    _emit(
+        {
+            "swap": swap,
+            "error": error,
+            "data": dict(client.jellyfin.config.data),
+        }
+    )
+
+
+def swap_actions():
+    from jellyfin_kodi.objects.actions import Actions
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    client = _client()
+
+    API(dict(MOVIE))
+    swap = _swap_stored_data()
+
+    actions, error = _call(lambda: Actions(None, None))
+
+    _emit(
+        {
+            "swap": swap,
+            "error": error,
+            "server": None if actions is None else actions.server,
+            "data": dict(client.jellyfin.config.data),
+        }
+    )
+
+
+def swap_context():
+    sys.listitem = _list_item()
+
+    from jellyfin_kodi.entrypoint.context import Context
+    from jellyfin_kodi.helper.api import API
+
+    _begin()
+    client = _client()
+    client.jellyfin.get_item = lambda item_id: None
+
+    API(dict(MOVIE))
+    swap = _swap_stored_data()
+
+    _, error = _call(Context)
+
+    _emit(
+        {
+            "swap": swap,
+            "error": error,
+            "data": dict(client.jellyfin.config.data),
+        }
+    )
+
+
+SCENARIOS = {
+    "helper_three": helper_three,
+    "helper_shapes": helper_shapes,
+    "helper_delta": helper_delta,
+    "playback_twice": playback_twice,
+    "actions_twice": actions_twice,
+    "context_twice": context_twice,
+    "all_sites": all_sites,
+    "helper_after_playback": helper_after_playback,
+    "playback_after_helper": playback_after_helper,
+    "swap_helper": swap_helper,
+    "swap_playback": swap_playback,
+    "swap_actions": swap_actions,
+    "swap_context": swap_context,
+}
+
+SCENARIOS[SCENARIO]()
+'''
+
+
+def run_scenario(tmp_path, scenario, data_contents=None):
+    """Run one scenario in a fresh interpreter and return its reported values."""
+
+    data_dir = tmp_path / "addon_data"
+    data_dir.mkdir()
+
+    (data_dir / "data.json").write_text(json.dumps({"Servers": [SERVER]}))
+
+    driver = tmp_path / "f2p_scenario_driver.py"
+    driver.write_text(DRIVER_SOURCE)
+
+    env = dict(os.environ)
+    env["F2P_REPO_ROOT"] = str(REPO_ROOT)
+    env["F2P_DATA_DIR"] = str(data_dir)
+    env["F2P_SCENARIO"] = scenario
+    if data_contents is not None:
+        env["F2P_DATA_CONTENTS"] = data_contents
+    env["PYTHONPATH"] = str(REPO_ROOT) + os.pathsep + env.get("PYTHONPATH", "")
+
+    completed = subprocess.run(
+        [sys.executable, str(driver)],
+        cwd=str(data_dir),
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=120,
+    )
+
+    stdout = completed.stdout.decode("utf-8", "replace")
+    stderr = completed.stderr.decode("utf-8", "replace")
+
+    results = [
+        line[len(RESULT_PREFIX):]
+        for line in stdout.splitlines()
+        if line.startswith(RESULT_PREFIX)
+    ]
+
+    assert results, "scenario {!r} produced no result\nstdout:\n{}\nstderr:\n{}".format(
+        scenario, stdout, stderr
+    )
+
+    return json.loads(results[-1])
+
+
+def auth_values(payload):
+    data = payload["data"]
+
+    return {key: data.get(key) for key in AUTH_KEYS}
+
+
+def assert_swap_preserved(payload):
+    assert payload["swap"]["identity_preserved"] is True, (
+        "the stored data file identity changed, so the scenario premise is "
+        "broken: {!r}".format(payload["swap"])
+    )
+
+
+def test_item_helper_reads_stored_data_once_for_three_instances(tmp_path):
+    payload = run_scenario(tmp_path, "helper_three")
+
+    assert payload["opens"] <= 1
+    assert payload["path_data"] == [SERVER["paths"]] * 3
+
+
+def test_item_helper_reads_stored_data_once_for_both_construction_shapes(tmp_path):
+    payload = run_scenario(tmp_path, "helper_shapes")
+
+    assert payload["opens"] <= 1
+    assert payload["path_data"] == [SERVER["paths"]] * 3
+    assert payload["server"] == "http://artwork.example"
+    assert payload["artwork"] == (
+        "http://artwork.example/Items/item-1/Images/Primary/0?Format=original"
+    )
+
+
+def test_item_helper_adds_no_stored_data_read_after_first_instance(tmp_path):
+    cases = (("configured", None), ("unreadable_json", "{invalid"))
+    for name, data_contents in cases:
+        directory = tmp_path / name
+        directory.mkdir()
+        payload = run_scenario(directory, "helper_delta", data_contents=data_contents)
+
+        assert payload["extra_opens"] == 0
+        if data_contents is None:
+            assert payload["path_data"] == [SERVER["paths"]] * 4
+
+
+def test_playback_entry_point_reads_stored_data_once_across_modes(tmp_path):
+    payload = run_scenario(tmp_path, "playback_twice")
+
+    assert payload["opens"] <= 1
+    assert payload["errors"] == [None, None]
+    assert auth_values(payload) == EXPECTED_AUTH
+
+
+def test_playback_actions_read_stored_data_once_across_constructions(tmp_path):
+    payload = run_scenario(tmp_path, "actions_twice")
+
+    assert payload["opens"] <= 1
+    assert payload["errors"] == [None, None]
+    assert payload["servers"] == [SERVER["address"], SERVER["address"]]
+    assert auth_values(payload) == EXPECTED_AUTH
+
+
+def test_context_entry_point_reads_stored_data_once_across_modes(tmp_path):
+    payload = run_scenario(tmp_path, "context_twice")
+
+    assert payload["opens"] <= 1
+    assert payload["errors"] == [None, None]
+    assert auth_values(payload) == EXPECTED_AUTH
+
+
+def test_all_four_consumers_share_one_stored_data_read(tmp_path):
+    payload = run_scenario(tmp_path, "all_sites")
+
+    assert payload["opens"] <= 1
+    assert payload["errors"] == [None, None, None, None]
+    assert auth_values(payload) == EXPECTED_AUTH
+    assert payload["server"] == SERVER["address"]
+    assert payload["path_data"] == SERVER["paths"]
+
+
+def test_item_helper_adds_no_stored_data_read_after_playback_entry_point(tmp_path):
+    payload = run_scenario(tmp_path, "helper_after_playback")
+
+    assert payload["extra_opens"] == 0
+    assert payload["path_data"] == [SERVER["paths"]] * 3
+    assert auth_values(payload) == EXPECTED_AUTH
+
+
+def test_playback_entry_point_adds_no_stored_data_read_after_item_helper(tmp_path):
+    payload = run_scenario(tmp_path, "playback_after_helper")
+
+    assert payload["extra_opens"] == 0
+    assert payload["path_data"] == SERVER["paths"]
+    assert auth_values(payload) == EXPECTED_AUTH
+
+
+def test_item_helper_paths_survive_stored_data_change_after_load(tmp_path):
+    payload = run_scenario(tmp_path, "swap_helper")
+
+    assert_swap_preserved(payload)
+    assert payload["loaded_path_data"] == SERVER["paths"]
+    assert payload["path_data"] == [SERVER["paths"]] * 3
+    assert payload["warnings"] == []
+
+
+def test_playback_entry_point_injects_loaded_values_after_stored_data_change(tmp_path):
+    payload = run_scenario(tmp_path, "swap_playback")
+
+    assert_swap_preserved(payload)
+    assert payload["error"] is None
+    assert auth_values(payload) == EXPECTED_AUTH
+    assert payload["warnings"] == []
+
+
+def test_playback_actions_inject_loaded_values_after_stored_data_change(tmp_path):
+    payload = run_scenario(tmp_path, "swap_actions")
+
+    assert_swap_preserved(payload)
+    assert payload["error"] is None
+    assert payload["server"] == SERVER["address"]
+    assert auth_values(payload) == EXPECTED_AUTH
+    assert payload["warnings"] == []
+
+
+def test_context_entry_point_injects_loaded_values_after_stored_data_change(tmp_path):
+    payload = run_scenario(tmp_path, "swap_context")
+
+    assert_swap_preserved(payload)
+    assert payload["error"] is None
+    assert auth_values(payload) == EXPECTED_AUTH
+    assert payload["warnings"] == []
