+// The accepted JSON-API probe status MUST NOT change the chosen implementation:
+// 200 and 401 select the same type, which differs from the legacy challenge
+// type.
+func TestF2PImplementationChoiceIsIndependentOfAcceptedJSONProbeStatus(t *testing.T) {
+	env := f2pInstall(t, "BitComet")
+
+	env.setMode("json")
+	env.setJSONProbeStatus(http.StatusOK)
+	okClient := env.detect(t)
+
+	env.setJSONProbeStatus(http.StatusUnauthorized)
+	unauthorizedClient := env.detect(t)
+
+	env.setMode("legacy")
+	legacyClient := env.detect(t)
+
+	if reflect.TypeOf(okClient) != reflect.TypeOf(unauthorizedClient) {
+		t.Fatalf("accepted JSON-API probe status changed the implementation type: 200 -> %v, 401 -> %v", reflect.TypeOf(okClient), reflect.TypeOf(unauthorizedClient))
+	}
+	if reflect.TypeOf(okClient) == reflect.TypeOf(legacyClient) {
+		t.Fatalf("the JSON-API family and the legacy panel family share implementation type %v", reflect.TypeOf(okClient))
+	}
+}
