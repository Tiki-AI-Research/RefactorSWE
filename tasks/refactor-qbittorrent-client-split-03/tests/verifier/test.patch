+// p2pInstallClientServer points the global client configuration at a local
+// httptest server and restores every touched global afterwards.
+func p2pInstallClientServer(t *testing.T, clientType string, handler http.HandlerFunc) *p2pRequestLog {
+	t.Helper()
+
+	requestLog := &p2pRequestLog{}
+	oldConfig := *config
+	oldHTTPClient := httpClient
+	oldHTTPClientExternal := httpClientExternal
+	oldClient := currentClient
+	oldClientType := currentClientType
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body []byte
+		if r.Body != nil {
+			body, _ = io.ReadAll(r.Body)
+			_ = r.Body.Close()
+			r.Body = io.NopCloser(bytes.NewReader(body))
+		}
+		requestLog.append(r, body)
+		handler(w, r)
+	}))
+
+	httpClient = *server.Client()
+	httpClientExternal = *server.Client()
+
+	testConfig := oldConfig
+	testConfig.ClientType = clientType
+	testConfig.ClientURL = server.URL
+	testConfig.UseBasicAuth = false
+	testConfig.UseShadowBan = false
+	testConfig.FetchFailedThreshold = 0
+	testConfig.ExecCommand_FetchFailed = ""
+	config = &testConfig
+	currentClient = nil
+	currentClientType = ""
+
+	t.Cleanup(func() {
+		server.Close()
+		restored := oldConfig
+		config = &restored
+		httpClient = oldHTTPClient
+		httpClientExternal = oldHTTPClientExternal
+		currentClient = oldClient
+		currentClientType = oldClientType
+	})
+
+	return requestLog
+}
