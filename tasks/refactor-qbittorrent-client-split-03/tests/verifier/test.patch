+// A JSON-API instance MUST keep the JSON-API family when its own Detect() is
+// re-run against a legacy-only panel: the family is bound to the
+// implementation, not to mutable public state.
+func TestF2PJSONInstanceKeepsFamilyAfterLegacyRedetection(t *testing.T) {
+	env := f2pInstall(t, "BitComet")
+	env.setMode("json")
+	jsonClient := env.detect(t)
+
+	env.setMode("legacy")
+	_ = jsonClient.Detect()
+
+	before := len(env.log.snapshot())
+	_, _ = jsonClient.FetchTorrents()
+	issued := env.log.snapshot()[before:]
+
+	for _, record := range issued {
+		if record.Path == "/panel/task_list" {
+			t.Fatalf("JSON-API implementation %v switched to the legacy panel listing after re-detection: %s", reflect.TypeOf(jsonClient), f2pRequests(issued))
+		}
+	}
+	if !env.log.hasRequest("/api_v2/task_list/get", "state_group=ACTIVE") {
+		t.Fatalf("JSON-API implementation %v stopped listing through /api_v2/task_list/get?state_group=ACTIVE after re-detection (requests: %s)", reflect.TypeOf(jsonClient), f2pRequests(issued))
+	}
+}
