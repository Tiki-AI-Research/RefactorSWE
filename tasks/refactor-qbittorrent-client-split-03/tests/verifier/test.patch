+type p2pRequestRecord struct {
+	Method string
+	Path   string
+	Query  string
+	Body   []byte
+}
+
+type p2pRequestLog struct {
+	mutex   sync.Mutex
+	records []p2pRequestRecord
+}
+
+func (requestLog *p2pRequestLog) append(r *http.Request, body []byte) {
+	requestLog.mutex.Lock()
+	defer requestLog.mutex.Unlock()
+	requestLog.records = append(requestLog.records, p2pRequestRecord{
+		Method: r.Method,
+		Path:   r.URL.Path,
+		Query:  r.URL.RawQuery,
+		Body:   append([]byte(nil), body...),
+	})
+}
+
+func (requestLog *p2pRequestLog) snapshot() []p2pRequestRecord {
+	requestLog.mutex.Lock()
+	defer requestLog.mutex.Unlock()
+	result := make([]p2pRequestRecord, len(requestLog.records))
+	copy(result, requestLog.records)
+	return result
+}
+
+func (requestLog *p2pRequestLog) countPath(path string) int {
+	count := 0
+	for _, record := range requestLog.snapshot() {
+		if record.Path == path {
+			count++
+		}
+	}
+	return count
+}
+
+func (requestLog *p2pRequestLog) hasPathPrefix(prefix string) bool {
+	for _, record := range requestLog.snapshot() {
+		if strings.HasPrefix(record.Path, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+func (requestLog *p2pRequestLog) hasRequest(path string, query string) bool {
+	for _, record := range requestLog.snapshot() {
+		if record.Path == path && record.Query == query {
+			return true
+		}
+	}
+	return false
+}
+
+func (requestLog *p2pRequestLog) postRecords(path string) []p2pRequestRecord {
+	var result []p2pRequestRecord
+	for _, record := range requestLog.snapshot() {
+		if record.Path == path && record.Method == http.MethodPost {
+			result = append(result, record)
+		}
+	}
+	return result
+}
