+#!/usr/bin/env python3
+"""Summary JUnit report producer for the qBittorrent-ClientBlocker Go package.
+
+The runner is invoked from the repository root by the verifier command:
+
+    python3 tests/f2p_runner.py --report <junit.xml> \
+        --config <config.json> [--select <p2p_select.txt> ...]
+
+It reads the frozen P2P and F2P exact leaf selectors from the ``p2p`` and
+``f2p`` arrays of the pipeline supplied config and, when supplied, the frozen
+P2P selection file, executes exactly those leaves with ``go test -json`` and
+converts the native test events into a conventional JUnit XML report. The
+selection is never replaced by a test file, a broad pattern or the P2P
+original inventory. The runner never installs or downloads anything: only the
+repository and the frozen image toolchain are used.
+"""
+
+import argparse
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+PACKAGE_DIR = REPO_ROOT
+
+SELECTOR_PATTERN = re.compile(r"(?:([A-Za-z0-9_./\\-]+\.go)::)?\b(Test[A-Za-z0-9_]+)\b")
+CONFIG_KEYS = ("p2p", "f2p")
+INTERNAL_TIMEOUT_SECONDS = 480
+GO_TEST_TIMEOUT_SECONDS = 300
+
+
+def find_go_binary():
+    found = shutil.which("go")
+    if found:
+        return found
+    for candidate in (
+        "/usr/local/go/bin/go",
+        "/usr/lib/go/bin/go",
+        "/opt/envpipe/runtime/bin/go",
+        "/usr/local/bin/go",
+    ):
+        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    return "go"
+
+
+def collect_selectors(text):
+    """Extract exact ``file.go::TestLeaf`` entries from a declaration text."""
+    result = []
+    for match in SELECTOR_PATTERN.finditer(text):
+        result.append((match.group(1) or "", match.group(2)))
+    return result
+
+
+def collect_config_selectors(document):
+    """Collect the selectors declared under the ``p2p`` and ``f2p`` keys."""
+    result = {"p2p": [], "f2p": []}
+
+    def collect(key, value):
+        if isinstance(value, list):
+            for item in value:
+                if isinstance(item, str):
+                    result[key].extend(collect_selectors(item))
+                elif isinstance(item, dict):
+                    for field in ("selector", "test", "id"):
+                        if isinstance(item.get(field), str):
+                            result[key].extend(collect_selectors(item[field]))
+                            break
+        elif isinstance(value, dict):
+            for field in ("tests", "selectors", "test", "selector"):
+                if field in value:
+                    collect(key, value[field])
+
+    def visit(node):
+        if isinstance(node, dict):
+            kind = str(node.get("kind", "")).upper()
+            if kind in ("P2P", "F2P") and "tests" in node:
+                collect(kind.lower(), node["tests"])
+                return
+            for key, value in node.items():
+                if key in CONFIG_KEYS:
+                    collect(key, value)
+                    continue
+                visit(value)
+        elif isinstance(node, list):
+            for item in node:
+                visit(item)
+
+    visit(document)
+    return result
+
+
+def load_config(paths):
+    """Read the frozen P2P/F2P selection arrays from the supplied config."""
+    for path in paths:
+        if not path or path.startswith("{"):
+            continue
+        try:
+            if not os.path.isfile(path):
+                continue
+            with open(path, "r", encoding="utf-8", errors="replace") as handle:
+                document = json.load(handle)
+        except (OSError, ValueError):
+            continue
+        return collect_config_selectors(document)
+    return {"p2p": [], "f2p": []}
+
+
+def load_select_files(paths):
+    selection = []
+    for path in paths:
+        if not path or path.startswith("{"):
+            continue
+        try:
+            if not os.path.isfile(path):
+                continue
+            with open(path, "r", encoding="utf-8", errors="replace") as handle:
+                text = handle.read()
+        except OSError:
+            continue
+        selection.extend(collect_selectors(text))
+    return selection
+
+
+def merge_selection(p2p_entries, f2p_entries):
+    """Deduplicate by Go test leaf, keeping the declared file path and suite."""
+    merged = []
+    index_by_leaf = {}
+    for suite, entries in (("p2p", p2p_entries), ("f2p", f2p_entries)):
+        for file_path, leaf in entries:
+            existing = index_by_leaf.get(leaf)
+            if existing is None:
+                index_by_leaf[leaf] = len(merged)
+                merged.append({"suite": suite, "file": file_path, "leaf": leaf})
+                continue
+            if file_path and not merged[existing]["file"]:
+                merged[existing]["file"] = file_path
+            if suite == "f2p":
+                merged[existing]["suite"] = "f2p"
+    return merged
+
+
+def prepare_environment():
+    env = dict(os.environ)
+    env.setdefault("GO111MODULE", "on")
+    env["GOPROXY"] = "off"
+    if not env.get("HOME"):
+        env["HOME"] = os.environ.get("TMPDIR") or "/tmp"
+    exec_dir = os.environ.get("VERIFIER_EXEC_DIR", "").strip()
+    if exec_dir:
+        try:
+            gocache = os.path.join(exec_dir, "gocache")
+            gotmp = os.path.join(exec_dir, "gotmp")
+            os.makedirs(gocache, exist_ok=True)
+            os.makedirs(gotmp, exist_ok=True)
+            env["GOCACHE"] = gocache
+            env["GOTMPDIR"] = gotmp
+            env["TMPDIR"] = gotmp
+        except OSError:
+            pass
+    if not env.get("GOMODCACHE"):
+        default_cache = os.path.join(os.path.expanduser("~"), "go", "pkg", "mod")
+        if os.path.isdir(default_cache):
+            env["GOMODCACHE"] = default_cache
+    if not os.path.isdir(env.get("GOMODCACHE", "")) and os.path.isdir("/root/go/pkg/mod"):
+        env["GOMODCACHE"] = "/root/go/pkg/mod"
+    return env
+
+
+def run_go_test(leaves, env):
+    run_pattern = "^(?:" + "|".join(sorted(leaves)) + ")$"
+    command = [
+        find_go_binary(),
+        "test",
+        "-count=1",
+        "-vet=off",
+        "-json",
+        "-timeout",
+        "%ds" % GO_TEST_TIMEOUT_SECONDS,
+        "-run",
+        run_pattern,
+        ".",
+    ]
+    started = time.time()
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=PACKAGE_DIR,
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+            timeout=INTERNAL_TIMEOUT_SECONDS,
+        )
+        return completed.stdout, completed.returncode, time.time() - started, False
+    except subprocess.TimeoutExpired as timeout_error:
+        output = timeout_error.stdout or ""
+        if isinstance(output, bytes):
+            output = output.decode("utf-8", "replace")
+        return output, -1, time.time() - started, True
+    except OSError as os_error:
+        return "runner error: %s" % os_error, -1, time.time() - started, False
+
+
+def parse_go_test_events(output):
+    results = {}
+    outputs = {}
+    saw_test_event = False
+    for line in output.splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if not isinstance(event, dict):
+            continue
+        action = event.get("Action")
+        test_name = event.get("Test")
+        if not test_name:
+            continue
+        saw_test_event = True
+        leaf = test_name.split("/")[0]
+        if action == "output":
+            outputs.setdefault(leaf, []).append(event.get("Output", ""))
+        elif action == "run" and "/" not in test_name:
+            results[leaf] = "running"
+        elif action in ("pass", "fail", "skip") and "/" not in test_name:
+            # Only the completed parent event establishes the selected outcome.
+            results[leaf] = action
+    return results, outputs, saw_test_event
+
+
+def execution_error_attributes(output):
+    """Type operational failures without treating Go crashes as assertions."""
+    if re.search(r"(?m)^panic: test timed out after ", output):
+        return {"type": "TimeoutError", "message": "go test timeout"}
+    if re.search(r"(?m)^(panic:|fatal error:|signal:|runtime:)", output):
+        return {"type": "ProcessCrash", "message": "go test process crash"}
+    if re.search(r"module lookup disabled|missing go.sum entry|no required module provides package", output):
+        return {"type": "SetupError", "phase": "setup", "message": "go test dependency setup error"}
+    if "[build failed]" in output:
+        return {"type": "CompileError", "phase": "compile", "message": "go test compile error"}
+    if output.startswith("runner error:"):
+        return {"type": "ExecutionError", "message": "go test execution error"}
+    if "runner internal timeout after" in output:
+        return {"type": "TimeoutError", "message": "go test timeout"}
+    return {"type": "GoExecutionError", "message": "go test could not execute the node"}
+
+
+def build_report(selection, results, outputs, build_failed, build_output, duration):
+    failures = 0
+    errors = 0
+    skipped = 0
+    suites = {}
+    for entry in selection:
+        outcome = results.get(entry["leaf"])
+        if outcome == "pass":
+            status = "pass"
+        elif outcome == "fail":
+            text = "".join(outputs.get(entry["leaf"], []))
+            crashed = re.search(r"(?m)^(panic:|fatal error:|signal:|runtime:)", text)
+            status = "error" if crashed else "fail"
+        elif outcome in ("running", "error"):
+            status = "error"
+        elif outcome == "skip":
+            status = "skip"
+        else:
+            status = "error" if build_failed else "notrun"
+        if status == "fail":
+            failures += 1
+        elif status == "error":
+            errors += 1
+        elif status in ("skip", "notrun"):
+            skipped += 1
+        suites.setdefault(entry["suite"], []).append((entry, status))
+
+    testsuites = ET.Element(
+        "testsuites",
+        {
+            "name": "verifier",
+            "tests": str(len(selection)),
+            "failures": str(failures),
+            "errors": str(errors),
+            "skipped": str(skipped),
+            "time": "%.3f" % duration,
+        },
+    )
+    timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+    for suite_name in ("p2p", "f2p"):
+        entries = suites.get(suite_name)
+        if not entries:
+            continue
+        suite_failures = sum(1 for _, status in entries if status == "fail")
+        suite_errors = sum(1 for _, status in entries if status == "error")
+        suite_skipped = sum(1 for _, status in entries if status in ("skip", "notrun"))
+        testsuite = ET.SubElement(
+            testsuites,
+            "testsuite",
+            {
+                "name": suite_name,
+                "tests": str(len(entries)),
+                "failures": str(suite_failures),
+                "errors": str(suite_errors),
+                "skipped": str(suite_skipped),
+                "time": "%.3f" % duration,
+                "timestamp": timestamp,
+            },
+        )
+        for entry, status in entries:
+            leaf = entry["leaf"]
+            testcase = ET.SubElement(
+                testsuite,
+                "testcase",
+                {
+                    "classname": entry["file"] or suite_name,
+                    "name": leaf,
+                    "time": "%.3f" % (0.0 if status == "notrun" else 0.001),
+                },
+            )
+            text = "".join(outputs.get(leaf, [])).strip()
+            if status == "fail":
+                failure = ET.SubElement(testcase, "failure", {"type": "AssertionError", "message": "test failed"})
+                failure.text = text or "test failed"
+            elif status == "error":
+                error = ET.SubElement(
+                    testcase, "error", execution_error_attributes(text or build_output)
+                )
+                error.text = (build_output or text or "go test build/exec failure").strip()[:20000]
+            elif status == "skip":
+                skipped_node = ET.SubElement(testcase, "skipped", {"message": "SKIPPED"})
+                skipped_node.text = text
+            elif status == "notrun":
+                skipped_node = ET.SubElement(
+                    testcase, "skipped", {"message": "NOT_RUN: node was not collected by go test"}
+                )
+                skipped_node.text = text
+            if text and status == "pass":
+                system_out = ET.SubElement(testcase, "system-out")
+                system_out.text = text
+    return testsuites
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Verifier P2P+F2P JUnit runner")
+    parser.add_argument("--report", required=True)
+    parser.add_argument("--config", action="append", default=[])
+    parser.add_argument("--select", action="append", default=[])
+    arguments = parser.parse_args()
+
+    config_selection = load_config(list(arguments.config))
+    select_selection = load_select_files(list(arguments.select))
+
+    p2p_entries = list(config_selection["p2p"]) + list(select_selection)
+    f2p_entries = list(config_selection["f2p"])
+    selection = merge_selection(p2p_entries, f2p_entries)
+
+    report_path = os.path.abspath(arguments.report)
+    report_dir = os.path.dirname(report_path)
+    if report_dir:
+        os.makedirs(report_dir, exist_ok=True)
+
+    if not selection:
+        report = build_report([], {}, {}, False, "", 0.0)
+        ET.ElementTree(report).write(report_path, encoding="UTF-8", xml_declaration=True)
+        sys.stderr.write(
+            "f2p_runner: no P2P/F2P selectors were declared by --config/--select, report=%s\n"
+            % report_path
+        )
+        return 0
+
+    leaves = [entry["leaf"] for entry in selection]
+    env = prepare_environment()
+    output, returncode, duration, timed_out = run_go_test(leaves, env)
+    results, outputs, saw_test_event = parse_go_test_events(output)
+    build_failed = (not saw_test_event) and (returncode != 0 or timed_out)
+
+    if timed_out:
+        for leaf in leaves:
+            results.setdefault(leaf, "error")
+            outputs.setdefault(leaf, []).append(
+                "runner internal timeout after %ss\n" % INTERNAL_TIMEOUT_SECONDS
+            )
+
+    report = build_report(selection, results, outputs, build_failed, output, duration)
+    ET.ElementTree(report).write(report_path, encoding="UTF-8", xml_declaration=True)
+
+    passed = sum(1 for leaf in leaves if results.get(leaf) == "pass")
+    sys.stderr.write(
+        "f2p_runner: %d/%d nodes passed, go test exit=%s, report=%s\n"
+        % (passed, len(selection), returncode, report_path)
+    )
+    return int(returncode != 0 or passed != len(selection))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
