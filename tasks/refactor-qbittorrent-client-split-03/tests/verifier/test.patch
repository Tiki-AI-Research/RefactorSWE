+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+            timeout=INTERNAL_TIMEOUT_SECONDS,
+        )
+        return completed.stdout, completed.returncode, time.time() - started, False
+    except subprocess.TimeoutExpired as timeout_error:
+        output = timeout_error.stdout or ""
+        if isinstance(output, bytes):
+            output = output.decode("utf-8", "replace")
+        return output, -1, time.time() - started, True
+    except OSError as os_error:
+        return "runner error: %s" % os_error, -1, time.time() - started, False
+
+
+def parse_go_test_events(output):
+    results = {}
+    outputs = {}
+    saw_test_event = False
+    for line in output.splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if not isinstance(event, dict):
+            continue
+        action = event.get("Action")
+        test_name = event.get("Test")
+        if not test_name:
+            continue
+        saw_test_event = True
+        leaf = test_name.split("/")[0]
+        if action == "output":
+            outputs.setdefault(leaf, []).append(event.get("Output", ""))
+        elif action == "run" and "/" not in test_name:
+            results[leaf] = "running"
+        elif action in ("pass", "fail", "skip") and "/" not in test_name:
+            # Only the completed parent event establishes the selected outcome.
+            results[leaf] = action
+    return results, outputs, saw_test_event
+
+
+def execution_error_attributes(output):
+    """Type operational failures without treating Go crashes as assertions."""
+    if re.search(r"(?m)^panic: test timed out after ", output):
+        return {"type": "TimeoutError", "message": "go test timeout"}
+    if re.search(r"(?m)^(panic:|fatal error:|signal:|runtime:)", output):
+        return {"type": "ProcessCrash", "message": "go test process crash"}
+    if re.search(r"module lookup disabled|missing go.sum entry|no required module provides package", output):
+        return {"type": "SetupError", "phase": "setup", "message": "go test dependency setup error"}
+    if "[build failed]" in output:
+        return {"type": "CompileError", "phase": "compile", "message": "go test compile error"}
+    if output.startswith("runner error:"):
+        return {"type": "ExecutionError", "message": "go test execution error"}
+    if "runner internal timeout after" in output:
+        return {"type": "TimeoutError", "message": "go test timeout"}
+    return {"type": "GoExecutionError", "message": "go test could not execute the node"}
+
+
+def build_report(selection, results, outputs, build_failed, build_output, duration):
+    failures = 0
+    errors = 0
+    skipped = 0
+    testcases = []
+    for file_path, leaf in selection:
+        outcome = results.get(leaf)
+        if outcome == "pass":
+            status = "pass"
+        elif outcome == "fail":
+            text = "".join(outputs.get(leaf, []))
+            crashed = re.search(r"(?m)^(panic:|fatal error:|signal:|runtime:)", text)
+            status = "error" if crashed else "fail"
+        elif outcome in ("running", "error"):
+            status = "error"
+        elif outcome == "skip":
+            status = "skip"
+        else:
+            status = "error" if build_failed else "notrun"
+        if status == "fail":
+            failures += 1
+        elif status == "error":
+            errors += 1
+        elif status in ("skip", "notrun"):
+            skipped += 1
+        testcases.append((file_path, leaf, status, outputs.get(leaf, [])))
+
+    testsuites = ET.Element(
+        "testsuites",
+        {
+            "name": "p2p",
+            "tests": str(len(testcases)),
+            "failures": str(failures),
+            "errors": str(errors),
+            "skipped": str(skipped),
+            "time": "%.3f" % duration,
+        },
+    )
+    testsuite = ET.SubElement(
+        testsuites,
+        "testsuite",
+        {
+            "name": "p2p",
+            "tests": str(len(testcases)),
+            "failures": str(failures),
+            "errors": str(errors),
+            "skipped": str(skipped),
+            "time": "%.3f" % duration,
+            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        },
+    )
+    for file_path, leaf, status, leaf_output in testcases:
+        testcase = ET.SubElement(
+            testsuite,
+            "testcase",
+            {
+                "classname": file_path or "p2p",
+                "name": leaf,
+                "time": "%.3f" % (0.0 if status == "notrun" else 0.001),
+            },
+        )
+        text = "".join(leaf_output).strip()
+        if status == "fail":
+            failure = ET.SubElement(testcase, "failure", {"type": "AssertionError", "message": "test failed"})
+            failure.text = text or "test failed"
+        elif status == "error":
+            error = ET.SubElement(
+                testcase, "error", execution_error_attributes(text or build_output)
+            )
+            error.text = (build_output or text or "go test build/exec failure").strip()[:20000]
+        elif status == "skip":
+            skipped_node = ET.SubElement(testcase, "skipped", {"message": "SKIPPED"})
+            skipped_node.text = text
+        elif status == "notrun":
+            skipped_node = ET.SubElement(
+                testcase, "skipped", {"message": "NOT_RUN: node was not collected by go test"}
+            )
+            skipped_node.text = text
+        if text and status == "pass":
+            system_out = ET.SubElement(testcase, "system-out")
+            system_out.text = text
+    return testsuites
+
+
+def main():
+    parser = argparse.ArgumentParser(description="P2P JUnit runner")
+    parser.add_argument("--report", required=True)
+    parser.add_argument("--select", action="append", default=[])
+    parser.add_argument("--config", action="append", default=[])
+    arguments = parser.parse_args()
+
+    selection = load_selection(list(arguments.select) + list(arguments.config))
+    if selection:
+        selection = [(normalize_file(file_path), leaf) for file_path, leaf in selection]
+        selected_leaves = set(leaf for _, leaf in selection)
+        # The execution report must always cover the restored Baseline nodes
+        # declared in original_inventory, so keep them in the run even when a
+        # narrower selection file is supplied.
+        for leaf in ORIGINAL_LEAVES:
+            if leaf not in selected_leaves:
+                selection.append(("client_test.go", leaf))
+                selected_leaves.add(leaf)
+    else:
+        selection = list(DECLARED_SELECTION)
+
+    leaves = [leaf for _, leaf in selection]
+    env = prepare_environment()
+    output, returncode, duration, timed_out = run_go_test(leaves, env)
+    results, outputs, saw_test_event = parse_go_test_events(output)
+    build_failed = (not saw_test_event) and (returncode != 0 or timed_out)
+
+    if timed_out:
+        for leaf in leaves:
+            results.setdefault(leaf, "error")
+            outputs.setdefault(leaf, []).append("runner internal timeout after %ss\n" % INTERNAL_TIMEOUT_SECONDS)
+
+    report = build_report(selection, results, outputs, build_failed, output, duration)
+    report_path = os.path.abspath(arguments.report)
+    report_dir = os.path.dirname(report_path)
+    if report_dir:
+        os.makedirs(report_dir, exist_ok=True)
+    ET.ElementTree(report).write(report_path, encoding="UTF-8", xml_declaration=True)
+
+    passed = sum(1 for _, leaf in selection if results.get(leaf) == "pass")
+    sys.stderr.write(
+        "p2p_runner: %d/%d nodes passed, go test exit=%s, report=%s\n"
+        % (passed, len(selection), returncode, report_path)
+    )
+    return int(returncode != 0 or passed != len(selection))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
