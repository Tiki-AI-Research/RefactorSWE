+// f2pExportedFieldNames lists the exported fields of a value type, including
+// the fields promoted through embedded structs.
+func f2pExportedFieldNames(valueType reflect.Type, visited map[reflect.Type]bool) []string {
+	for valueType.Kind() == reflect.Ptr {
+		valueType = valueType.Elem()
+	}
+	if visited[valueType] {
+		return nil
+	}
+	visited[valueType] = true
+	if valueType.Kind() != reflect.Struct {
+		return nil
+	}
+
+	var names []string
+	for index := 0; index < valueType.NumField(); index++ {
+		field := valueType.Field(index)
+		if field.Anonymous {
+			names = append(names, f2pExportedFieldNames(field.Type, visited)...)
+			continue
+		}
+		if field.PkgPath == "" {
+			names = append(names, field.Name+" "+field.Type.String())
+		}
+	}
+	sort.Strings(names)
+	return names
+}
+
+func f2pExportedMethodNames(valueType reflect.Type) []string {
+	var names []string
+	for index := 0; index < valueType.NumMethod(); index++ {
+		method := valueType.Method(index)
+		if method.PkgPath == "" {
+			names = append(names, method.Name)
+		}
+	}
+	sort.Strings(names)
+	return names
+}
+
+func f2pClientInterfaceMethodNames() []string {
+	interfaceType := reflect.TypeOf((*Client)(nil)).Elem()
+	names := make([]string, 0, interfaceType.NumMethod())
+	for index := 0; index < interfaceType.NumMethod(); index++ {
+		names = append(names, interfaceType.Method(index).Name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+// f2pZeroValue builds the zero value of the detected implementation type
+// through reflection so no internal type name is referenced.
+func f2pZeroValue(t *testing.T, instance Client) Client {
+	t.Helper()
+
+	instanceType := reflect.TypeOf(instance)
+	if instanceType == nil {
+		t.Fatal("detected client instance has no dynamic type")
+	}
+	var zero reflect.Value
+	if instanceType.Kind() == reflect.Ptr {
+		zero = reflect.New(instanceType.Elem())
+	} else {
+		zero = reflect.Zero(instanceType)
+	}
+	zeroClient, ok := zero.Interface().(Client)
+	if !ok {
+		t.Fatalf("zero value of %v does not satisfy the Client interface", instanceType)
+	}
+	return zeroClient
+}
+
+func f2pRequests(records []f2pRequestRecord) string {
+	parts := make([]string, 0, len(records))
+	for _, record := range records {
+		parts = append(parts, record.Method+" "+record.Path+"?"+record.Query)
+	}
+	return strings.Join(parts, ", ")
+}
