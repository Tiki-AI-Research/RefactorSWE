+func TestP2PJSONAPISubmitBlockPeerGroupsByInfoHash(t *testing.T) {
+	requestLog := p2pInstallClientServer(t, "BitComet", func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/api_v2/task_list/get":
+			p2pWriteJSONTaskList(w)
+		case "/api/task/peers/ban_ip":
+			_, _ = w.Write([]byte(`{"result":"success"}`))
+		default:
+			http.NotFound(w, r)
+		}
+	})
+
+	p2pDetectJSONFamily(t)
+
+	accepted := SubmitBlockPeer(map[string]BlockPeerInfoStruct{
+		"192.0.2.1": {InfoHash: "hash-a", Port: map[int]bool{6881: true}},
+		"192.0.2.2": {InfoHash: "hash-a", Port: map[int]bool{51413: true}},
+		"192.0.2.3": {InfoHash: "hash-b", Port: map[int]bool{6881: true}},
+	})
+	if !accepted {
+		t.Fatal("block submission reported failure although every ban request was accepted")
+	}
+
+	payloads := p2pDecodeBanPayloads(t, requestLog)
+	if len(payloads) != 2 {
+		t.Fatalf("ban payloads=%#v, want one request per info-hash", payloads)
+	}
+
+	byTask := make(map[string]p2pBanPayload, len(payloads))
