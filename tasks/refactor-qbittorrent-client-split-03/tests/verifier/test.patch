+// The JSON-API implementation MUST expose exactly the frozen Client interface
+// methods: no per-operation version helpers may stay public.
+func TestF2PJSONImplementationExportedMethodSetMatchesClientInterface(t *testing.T) {
+	env := f2pInstall(t, "BitComet")
