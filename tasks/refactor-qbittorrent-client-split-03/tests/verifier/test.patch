+// Detection MUST return two distinct implementations: the JSON-API family and
+// the legacy panel family may not share one type that carries the version code.
+func TestF2PDetectionReturnsDistinctImplementationTypesPerFamily(t *testing.T) {
+	env := f2pInstall(t, "BitComet")
+
+	env.setMode("json")
+	jsonClient := env.detect(t)
+
+	env.setMode("legacy")
+	legacyClient := env.detect(t)
+
+	jsonType := reflect.TypeOf(jsonClient)
+	legacyType := reflect.TypeOf(legacyClient)
+	if jsonType == legacyType {
+		t.Fatalf("the JSON-API and legacy panel families share implementation type %v; the split requires two distinct implementations", jsonType)
+	}
+}
