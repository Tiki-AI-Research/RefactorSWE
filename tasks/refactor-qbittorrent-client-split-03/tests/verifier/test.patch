+package main
+
+// F2P (fail-to-pass) coverage for the BitComet protocol-family split.
+//
+// Every leaf in this file fails on the frozen Baseline, where one BCClient type
+// carries the exported integer version code and branches per operation, and
+// passes once the version code is replaced by two distinct implementations
+// chosen by detection. The leaves only use the frozen public surface
+// (DetectClient, the Client interface, the dispatch entry points and the shared
+// models) plus reflection over the detected implementation values and a scan of
+// the package's declared types, so internal helper names, response structures
+// and the new implementation types stay free to be renamed, moved, merged or
+// split.
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const f2pJSONTaskListBody = `{"movie_list":[{"task_id":"task-a","type":"BT","total_size":1000,"leechers_count":3},{"task_id":"task-http","type":"HTTP","total_size":2000,"leechers_count":1}]}`
+
+const f2pLegacyTaskListHTML = `<table><tbody><tr><th>head</th></tr><tr><td>BT</td><td><a href="/panel/task_detail?id=42">task</a></td><td>running</td><td></td><td>1 MB</td><td></td><td></td><td>2 KB/s</td></tr></tbody></table>`
+
+type f2pRequestRecord struct {
+	Method string
+	Path   string
+	Query  string
+}
+
+type f2pRequestLog struct {
+	mutex   sync.Mutex
+	records []f2pRequestRecord
+}
+
+func (log *f2pRequestLog) append(request *http.Request) {
+	log.mutex.Lock()
+	defer log.mutex.Unlock()
+	log.records = append(log.records, f2pRequestRecord{
+		Method: request.Method,
+		Path:   request.URL.Path,
+		Query:  request.URL.RawQuery,
+	})
+}
+
+func (log *f2pRequestLog) snapshot() []f2pRequestRecord {
+	log.mutex.Lock()
+	defer log.mutex.Unlock()
+	result := make([]f2pRequestRecord, len(log.records))
+	copy(result, log.records)
+	return result
+}
+
+func (log *f2pRequestLog) hasRequest(path string, query string) bool {
+	for _, record := range log.snapshot() {
+		if record.Path == path && record.Query == query {
+			return true
+		}
+	}
+	return false
+}
+
+func (log *f2pRequestLog) postRecords(path string) []f2pRequestRecord {
+	var result []f2pRequestRecord
+	for _, record := range log.snapshot() {
+		if record.Path == path && record.Method == http.MethodPost {
+			result = append(result, record)
+		}
+	}
+	return result
+}
+
+// f2pEnvironment points the global client configuration at one local server
+// whose probe answers are switched per scenario.
+type f2pEnvironment struct {
+	server     *httptest.Server
+	log        *f2pRequestLog
+	mutex      sync.Mutex
+	mode       string
+	jsonStatus int
+}
+
+func (env *f2pEnvironment) handle(w http.ResponseWriter, r *http.Request) {
+	env.log.append(r)
+	env.mutex.Lock()
+	mode := env.mode
+	jsonStatus := env.jsonStatus
+	env.mutex.Unlock()
+
+	switch r.URL.Path {
+	case "/api_v2/task_list/get":
+		if mode != "json" {
+			http.NotFound(w, r)
+			return
+		}
+		if r.URL.Query().Get("state_group") == "ACTIVE" {
+			_, _ = w.Write([]byte(f2pJSONTaskListBody))
+			return
+		}
+		if jsonStatus == http.StatusUnauthorized {
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		_, _ = w.Write([]byte(f2pJSONTaskListBody))
+	case "/api/task/peers/get":
+		_, _ = w.Write([]byte(`{"peers_connected":[]}`))
+	case "/api/task/peers/ban_ip":
+		_, _ = w.Write([]byte(`{"result":"success"}`))
+	case "/panel/":
+		if mode != "legacy" {
+			http.NotFound(w, r)
+			return
+		}
+		w.Header().Set("WWW-Authenticate", `Basic realm="BitComet"`)
+		w.WriteHeader(http.StatusUnauthorized)
+	case "/panel/task_list":
+		if mode != "legacy" {
+			http.NotFound(w, r)
+			return
+		}
+		_, _ = w.Write([]byte(f2pLegacyTaskListHTML))
+	default:
+		http.NotFound(w, r)
+	}
+}
