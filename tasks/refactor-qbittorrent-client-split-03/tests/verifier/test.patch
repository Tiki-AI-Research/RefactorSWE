+		t.Fatalf("detected client=%v type=%q, want qBittorrent", currentClient, currentClientType)
+	}
+	if currentClient.GetClientType() != "qBittorrent" {
+		t.Fatalf("GetClientType()=%q, want qBittorrent", currentClient.GetClientType())
+	}
+}
+
+// Automatic detection MUST keep selecting Transmission when its probe matches.
+func TestP2PConfiguredTransmissionStillSelected(t *testing.T) {
+	p2pInstallClientServer(t, "", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodPost && r.URL.Path == "/" {
+			_, _ = w.Write([]byte(`{"result":"success"}`))
+			return
+		}
+		http.NotFound(w, r)
+	})
+
+	if !DetectClient() {
+		t.Fatal("Transmission detection failed")
+	}
+	if currentClient == nil || currentClientType != "Transmission" {
+		t.Fatalf("detected client=%v type=%q, want Transmission", currentClient, currentClientType)
+	}
+	if currentClient.GetClientType() != "Transmission" {
+		t.Fatalf("GetClientType()=%q, want Transmission", currentClient.GetClientType())
+	}
+}
