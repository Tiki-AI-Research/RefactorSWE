+		if payload.BanTime != "ban_ip_forever" {
+			t.Fatalf("ban_time=%q, want ban_ip_forever", payload.BanTime)
+		}
+		if _, exists := byTask[payload.TaskID]; exists {
+			t.Fatalf("info-hash %q was submitted twice", payload.TaskID)
+		}
+		byTask[payload.TaskID] = payload
+	}
+	payloadA, existsA := byTask["hash-a"]
+	if !existsA {
+		t.Fatalf("ban payloads=%#v, want a hash-a request", payloads)
+	}
+	if got := p2pSorted(payloadA.IPList); len(got) != 2 || got[0] != "192.0.2.1" || got[1] != "192.0.2.2" {
+		t.Fatalf("hash-a ip_list=%v, want the two grouped addresses", payloadA.IPList)
+	}
+	payloadB, existsB := byTask["hash-b"]
+	if !existsB {
+		t.Fatalf("ban payloads=%#v, want a hash-b request", payloads)
+	}
+	if got := p2pSorted(payloadB.IPList); len(got) != 1 || got[0] != "192.0.2.3" {
+		t.Fatalf("hash-b ip_list=%v, want the single address", payloadB.IPList)
+	}
+}
