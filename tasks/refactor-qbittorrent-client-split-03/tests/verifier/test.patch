+func f2pInstall(t *testing.T, clientType string) *f2pEnvironment {
+	t.Helper()
+
+	env := &f2pEnvironment{log: &f2pRequestLog{}, mode: "none", jsonStatus: http.StatusOK}
+	env.server = httptest.NewServer(http.HandlerFunc(env.handle))
+
+	oldConfig := *config
+	oldHTTPClient := httpClient
+	oldHTTPClientExternal := httpClientExternal
+	oldClient := currentClient
+	oldClientType := currentClientType
+
+	httpClient = *env.server.Client()
+	httpClientExternal = *env.server.Client()
+
+	testConfig := oldConfig
+	testConfig.ClientType = clientType
+	testConfig.ClientURL = env.server.URL
+	testConfig.UseBasicAuth = false
+	testConfig.UseShadowBan = false
+	testConfig.FetchFailedThreshold = 0
+	testConfig.ExecCommand_FetchFailed = ""
+	config = &testConfig
+	currentClient = nil
+	currentClientType = ""
+
+	t.Cleanup(func() {
+		env.server.Close()
+		restored := oldConfig
+		config = &restored
+		httpClient = oldHTTPClient
+		httpClientExternal = oldHTTPClientExternal
+		currentClient = oldClient
+		currentClientType = oldClientType
+	})
+
+	return env
+}
+
+func (env *f2pEnvironment) setMode(mode string) {
+	env.mutex.Lock()
+	env.mode = mode
+	env.mutex.Unlock()
+}
+
+func (env *f2pEnvironment) setJSONProbeStatus(status int) {
+	env.mutex.Lock()
+	env.jsonStatus = status
+	env.mutex.Unlock()
+}
+
+func (env *f2pEnvironment) modeName() string {
+	env.mutex.Lock()
+	defer env.mutex.Unlock()
+	return env.mode
+}
+
+// f2pDetect runs the frozen dispatch detection for the current probe setup and
+// returns the detected implementation through the Client interface.
+func (env *f2pEnvironment) detect(t *testing.T) Client {
+	t.Helper()
+
+	if !DetectClient() {
+		t.Fatalf("DetectClient() reported failure for the %q probe setup", env.modeName())
+	}
+	if currentClient == nil {
+		t.Fatal("DetectClient() reported success without a client instance")
+	}
+	if currentClientType != "BitComet" {
+		t.Fatalf("detected client type=%q, want BitComet", currentClientType)
+	}
+	return currentClient
+}
