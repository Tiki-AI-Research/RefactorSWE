+func f2pParsePackage(t *testing.T) []*ast.File {
+	t.Helper()
+
+	entries, err := os.ReadDir(".")
+	if err != nil {
+		t.Fatalf("cannot list the package directory: %v", err)
+	}
+	fileSet := token.NewFileSet()
+	var files []*ast.File
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+		parsed, err := parser.ParseFile(fileSet, filepath.Join(".", name), nil, 0)
+		if err != nil {
+			t.Fatalf("cannot parse package source %s: %v", name, err)
+		}
+		files = append(files, parsed)
+	}
+	return files
+}
+
+func f2pStructTypes(t *testing.T) map[string]*ast.StructType {
+	t.Helper()
+
+	result := make(map[string]*ast.StructType)
+	for _, file := range f2pParsePackage(t) {
+		for _, decl := range file.Decls {
+			genDecl, ok := decl.(*ast.GenDecl)
+			if !ok || genDecl.Tok != token.TYPE {
+				continue
+			}
+			for _, spec := range genDecl.Specs {
+				typeSpec, ok := spec.(*ast.TypeSpec)
+				if !ok {
+					continue
+				}
+				if structType, ok := typeSpec.Type.(*ast.StructType); ok {
+					result[typeSpec.Name.Name] = structType
+				}
+			}
+		}
+	}
+	return result
+}
+
+func f2pDetectDeclaringTypes(t *testing.T) map[string]bool {
+	t.Helper()
+
+	found := make(map[string]bool)
+	for _, file := range f2pParsePackage(t) {
+		for _, decl := range file.Decls {
+			funcDecl, ok := decl.(*ast.FuncDecl)
+			if !ok || funcDecl.Recv == nil || funcDecl.Name.Name != "Detect" {
+				continue
+			}
+			if funcDecl.Type.Params != nil && len(funcDecl.Type.Params.List) != 0 {
+				continue
+			}
+			if funcDecl.Type.Results == nil || len(funcDecl.Type.Results.List) != 1 {
+				continue
+			}
+			if ident, ok := funcDecl.Type.Results.List[0].Type.(*ast.Ident); !ok || ident.Name != "bool" {
+				continue
+			}
+			receiverType := funcDecl.Recv.List[0].Type
+			if star, ok := receiverType.(*ast.StarExpr); ok {
+				receiverType = star.X
+			}
+			if ident, ok := receiverType.(*ast.Ident); ok {
+				found[ident.Name] = true
+			}
+		}
+	}
+	return found
+}
+
+func f2pExportedIntegerFields(structTypes map[string]*ast.StructType, typeName string, integerNames map[string]bool, visited map[string]bool) []string {
+	if visited[typeName] {
+		return nil
+	}
+	visited[typeName] = true
+	structType, ok := structTypes[typeName]
+	if !ok {
+		return nil
+	}
+
+	var result []string
+	for _, field := range structType.Fields.List {
+		for _, name := range field.Names {
+			if !ast.IsExported(name.Name) {
+				continue
+			}
+			fieldType := field.Type
+			if star, ok := fieldType.(*ast.StarExpr); ok {
+				fieldType = star.X
+			}
+			if ident, ok := fieldType.(*ast.Ident); ok && integerNames[ident.Name] {
+				result = append(result, name.Name)
+			}
+		}
+	}
+	for _, field := range structType.Fields.List {
+		if len(field.Names) != 0 {
+			continue
+		}
+		fieldType := field.Type
+		if star, ok := fieldType.(*ast.StarExpr); ok {
+			fieldType = star.X
+		}
+		if ident, ok := fieldType.(*ast.Ident); ok {
+			result = append(result, f2pExportedIntegerFields(structTypes, ident.Name, integerNames, visited)...)
+		}
+	}
+	return result
+}
