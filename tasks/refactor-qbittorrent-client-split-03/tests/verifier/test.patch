+    ("client_BitComet_p2p_test.go", "TestP2PJSONAPIFetchTorrentPeersConvertsProgress"),
+    ("client_BitComet_p2p_test.go", "TestP2PJSONAPILoginSucceedsOnPanelEndpoint"),
