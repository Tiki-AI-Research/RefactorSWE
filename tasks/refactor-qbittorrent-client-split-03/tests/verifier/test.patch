+// No client-family type declared in the package sources may declare exported
+// integer state: the integer version code may not survive as public state on
+// the type that implements the frozen Detect() client method.
+func TestF2PNoClientFamilyTypeDeclaresExportedIntegerState(t *testing.T) {
+	structTypes := f2pStructTypes(t)
+	detectTypes := f2pDetectDeclaringTypes(t)
+	if len(detectTypes) == 0 {
+		// A layout that promotes Detect() from another package declares no
+		// client-family type in this package, so there is no declared public
+		// state to bind here.
+		t.Log("no declared type in this package implements Detect() bool directly; nothing to bind")
+		return
+	}
+
+	integerNames := map[string]bool{
+		"int": true, "int8": true, "int16": true, "int32": true, "int64": true,
+		"uint": true, "uint8": true, "uint16": true, "uint32": true, "uint64": true,
+		"uintptr": true, "byte": true, "rune": true,
+	}
+
+	var offenders []string
+	for typeName := range detectTypes {
+		for _, fieldName := range f2pExportedIntegerFields(structTypes, typeName, integerNames, map[string]bool{}) {
+			offenders = append(offenders, typeName+"."+fieldName)
+		}
+	}
+	sort.Strings(offenders)
+	if len(offenders) != 0 {
+		t.Fatalf("client-family types still declare exported integer state %v; the integer version code must not survive as public state", offenders)
+	}
+}
