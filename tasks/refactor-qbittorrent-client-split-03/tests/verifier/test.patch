+// The untouched default state MUST NOT silently mean the legacy family: the
+// zero value of the JSON-API implementation keeps listing through the JSON API.
+// A zero value that refuses the operation (a panic) is not exempt from the
+// positive observable: it still has to issue the JSON-API listing request.
+func TestF2PJSONImplementationZeroValueStaysInJSONFamily(t *testing.T) {
+	env := f2pInstall(t, "BitComet")
+	env.setMode("json")
+	jsonClient := env.detect(t)
+	zeroClient := f2pZeroValue(t, jsonClient)
+
+	before := len(env.log.snapshot())
+	var panicValue interface{}
+	func() {
+		defer func() { panicValue = recover() }()
+		_, _ = zeroClient.FetchTorrents()
+	}()
+	if panicValue != nil {
+		t.Logf("zero value of %v panicked in FetchTorrents(): %v", reflect.TypeOf(jsonClient), panicValue)
+	}
+	issued := env.log.snapshot()[before:]
+
+	legacyReads := 0
+	jsonListings := 0
+	for _, record := range issued {
+		if record.Path == "/panel/task_list" {
+			legacyReads++
+		}
+		if record.Path == "/api_v2/task_list/get" && record.Query == "state_group=ACTIVE" {
+			jsonListings++
+		}
+	}
+	if legacyReads != 0 {
+		t.Fatalf("zero value of %v read the legacy panel task table; the untouched default state must not silently mean the legacy family", reflect.TypeOf(jsonClient))
+	}
+	if jsonListings == 0 {
+		t.Fatalf("zero value of %v did not list torrents through /api_v2/task_list/get?state_group=ACTIVE (requests: %s)", reflect.TypeOf(jsonClient), f2pRequests(issued))
+	}
+}
