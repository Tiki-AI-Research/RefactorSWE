diff --git a/client_BitComet_Legacy.go b/client_BitComet_Legacy.go
new file mode 100644
index 0000000..186a54f
--- /dev/null
+++ b/client_BitComet_Legacy.go
@@ -0,0 +1,85 @@
+package main
+
+import (
+	"strconv"
+	"strings"
+)
+
+// BCLegacyClient implements the HTML panel client for BitComet 1.x.
+type BCLegacyClient struct{}
+
+var _ Client = (*BCLegacyClient)(nil)
+
+func (c *BCLegacyClient) GetClientType() string {
+	return "BitComet"
+}
+
+func (c *BCLegacyClient) ConfigPath() string {
+	return ""
+}
+
+func (c *BCLegacyClient) SetURL() bool {
+	return false
+}
+
+func (c *BCLegacyClient) Login() bool {
+	return BC_Login()
+}
+
+// FetchTorrents lists active torrents.
+func (c *BCLegacyClient) FetchTorrents() ([]*Torrent, error) {
+	torrents := BC_FetchTorrents()
+	if torrents == nil {
+		return nil, nil
+	}
+	var result []*Torrent
+	for id, t := range *torrents {
+		result = append(result, &Torrent{
+			Hash:       strconv.Itoa(id),
+			TotalSize:  t.TotalSize,
+			Tracker:    "Unsupported",
+			LeechCount: 233,
+		})
+	}
+	return result, nil
+}
+
+// FetchTorrentPeers returns the peers for a specific torrent.
+func (c *BCLegacyClient) FetchTorrentPeers(torrent *Torrent) ([]*Peer, error) {
+	peers := BC_FetchTorrentPeers(torrent.Hash)
+	if peers == nil {
+		return nil, nil
+	}
+	var result []*Peer
+	for _, p := range *peers {
+		result = append(result, &Peer{
+			IP:         p.IP,
+			Port:       p.Port,
+			Client:     p.Client,
+			DlSpeed:    p.DlSpeed,
+			UpSpeed:    p.UpSpeed,
+			Progress:   p.Progress,
+			Downloaded: p.Downloaded,
+			Uploaded:   p.Uploaded,
+			ID:         "", // BitComet does not provide a PeerID.
+		})
+	}
+	return result, nil
+}
+
+func (c *BCLegacyClient) SubmitBlockPeer(blockPeerMap map[string]BlockPeerInfoStruct) bool {
+	return false // BitComet 1.x does not support banning through the WebUI.
+}
+
+func (c *BCLegacyClient) SubmitShadowBanPeer(blockPeerMap map[string]BlockPeerInfoStruct) bool {
+	return false // Unsupported.
+}
+
+func (c *BCLegacyClient) Detect() bool {
+	apiResponseStatusCode, apiResponseHeaders, _ := Fetch(configSnapshot().ClientURL+"/panel/", false, false, false, nil)
+	if apiResponseStatusCode == 401 && strings.Contains(apiResponseHeaders.Get("WWW-Authenticate"), "BitComet") {
+		Log("DetectClient", "BitComet (Version 1 - HTML) Detected", true)
+		return true
+	}
+	return false
+}
diff --git a/client_BitComet_V2.go b/client_BitComet_V2.go
new file mode 100644
index 0000000..09ca4d2
--- /dev/null
+++ b/client_BitComet_V2.go
@@ -0,0 +1,169 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+)
+
+// BCV2Client implements the JSON API client for BitComet v2.09 and later.
+type BCV2Client struct{}
+
+var _ Client = (*BCV2Client)(nil)
+
+func (c *BCV2Client) GetClientType() string {
+	return "BitComet"
+}
+
+func (c *BCV2Client) ConfigPath() string {
+	return ""
+}
+
+func (c *BCV2Client) SetURL() bool {
+	return false
+}
+
+func (c *BCV2Client) Login() bool {
+	return BC_Login()
+}
+
+// FetchTorrents lists active torrents.
+func (c *BCV2Client) FetchTorrents() ([]*Torrent, error) {
+	_, _, responseBody := Fetch(configSnapshot().ClientURL+"/api_v2/task_list/get?state_group=ACTIVE", true, true, false, nil)
+	if responseBody == nil {
+		return nil, nil
+	}
+
+	var resp BC_v2_TaskListResponse
+	if err := json.Unmarshal(responseBody, &resp); err != nil {
+		Log("FetchTorrents_v2", GetLangText("Error-Parse"), true, err.Error())
+		return nil, err
+	}
+
+	var result []*Torrent
+	for _, t := range resp.TaskList {
+		if strings.ToUpper(t.Type) != "BT" {
+			continue
+		}
+		result = append(result, &Torrent{
+			Hash:       t.TaskID,
+			TotalSize:  t.Size,
+			Tracker:    "BitComet-v2",
+			LeechCount: int64(t.LeechCount),
+		})
+	}
+	return result, nil
+}
+
+// FetchTorrentPeers returns the peers for a specific torrent.
+func (c *BCV2Client) FetchTorrentPeers(torrent *Torrent) ([]*Peer, error) {
+	_, _, responseBody := Fetch(configSnapshot().ClientURL+"/api/task/peers/get?task_id="+torrent.Hash+"&groups=peers_connected", true, true, false, nil)
+	if responseBody == nil {
+		return nil, nil
+	}
+
+	var resp BC_v2_PeerListResponse
+	if err := json.Unmarshal(responseBody, &resp); err != nil {
+		Log("FetchTorrentPeers_v2", GetLangText("Error-Parse"), true, err.Error())
+		return nil, err
+	}
+
+	var result []*Peer
+	for _, p := range resp.PeerList {
+		result = append(result, &Peer{
+			IP:         p.IP,
+			Port:       p.Port,
+			Client:     p.Client,
+			DlSpeed:    p.DlSpeed,
+			UpSpeed:    p.UpSpeed,
+			Progress:   p.Progress / 100.0, // The API normally returns a value between 0 and 100.
+			Downloaded: p.Downloaded,
+			Uploaded:   p.Uploaded,
+		})
+	}
+	return result, nil
+}
+
+// SubmitBlockPeer submits the ban list.
+func (c *BCV2Client) SubmitBlockPeer(blockPeerMap map[string]BlockPeerInfoStruct) bool {
+	// Group IP addresses by torrent as required by ban_ip.
+	taskIPs := make(map[string][]string)
+	for peerIP, peerInfo := range blockPeerMap {
+		if peerInfo.InfoHash != "" {
+			taskIPs[peerInfo.InfoHash] = append(taskIPs[peerInfo.InfoHash], peerIP)
+		}
+	}
+
+	if len(taskIPs) == 0 {
+		return true
+	}
+
+	allSuccess := true
+	for taskID, ips := range taskIPs {
+		params := BC_v2_BanParams{
+			TaskID:  taskID,
+			BanTime: "ban_ip_forever",
+			IPList:  ips,
+		}
+		postData, _ := json.Marshal(params)
+		code, _, _ := Submit(configSnapshot().ClientURL+"/api/task/peers/ban_ip", postData, true, true, &Tr_jsonHeader)
+		if code != 200 {
+			allSuccess = false
+		}
+	}
+	return allSuccess
+}
+
+func (c *BCV2Client) SubmitShadowBanPeer(blockPeerMap map[string]BlockPeerInfoStruct) bool {
+	return false // Unsupported.
+}
+
+func (c *BCV2Client) Detect() bool {
+	apiResponseStatusCode, _, _ := Fetch(configSnapshot().ClientURL+"/api_v2/task_list/get", false, false, false, nil)
+	if apiResponseStatusCode == 200 || apiResponseStatusCode == 401 {
+		Log("DetectClient", "BitComet (Version 2 - JSON API) Detected", true)
+		return true
+	}
+	return false
+}
+
+// Structures for the BitComet v2 JSON API.
+type BC_v2_BanParams struct {
+	TaskID  string   `json:"task_id"`
+	BanTime string   `json:"ban_time"`
+	IPList  []string `json:"ip_list"`
+}
+
+type BC_v2_CommonResponse struct {
+	Result string `json:"result"`
+}
+
+type BC_v2_TaskListResponse struct {
+	TaskList []BC_v2_Task `json:"movie_list"` // The API returns movie_list.
+}
+
+type BC_v2_Task struct {
+	TaskID     string `json:"task_id"`
+	Type       string `json:"type"`
+	Size       int64  `json:"total_size"`
+	UpSpeed    int64  `json:"upload_speed"`
+	Status     string `json:"state"`
+	InfoHash   string `json:"info_hash"`
+	Name       string `json:"name"`
+	Progress   int    `json:"progress"`
+	LeechCount int    `json:"leechers_count"`
+}
+
+type BC_v2_PeerListResponse struct {
+	PeerList []BC_v2_Peer `json:"peers_connected"`
+}
+
+type BC_v2_Peer struct {
+	IP         string  `json:"address"`
+	Port       int     `json:"remoteport"`
+	Client     string  `json:"clienttype"`
+	Progress   float64 `json:"progress"`
+	DlSpeed    int64   `json:"downrate"`
+	UpSpeed    int64   `json:"uprate"`
+	Downloaded int64   `json:"downsize"`
+	Uploaded   int64   `json:"upsize"`
+}
