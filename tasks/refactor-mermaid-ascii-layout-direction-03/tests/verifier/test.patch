+// TestCoordinateGrowthAnsweredByCarrier pins REQ-STRUCT-002 for coordinate
+// growth: the grid coordinate for a level and cross position must be built by
+// an axis-dependent carrier method whose result is consumed by the layout
+// code (for example as the coordinate handed to reserveSpotInGrid).
+func TestCoordinateGrowthAnsweredByCarrier(t *testing.T) {
+	g, roles, byTarget := carrierRolesFor(t)
+	sites := answeredSites(g, roles, byTarget, isPlacementRole, func(site roleCallSiteEvidence) bool {
+		return g.resultFlowsIntoCallArgumentOrReturn(site.site)
+	})
+	if len(sites) == 0 {
+		t.Errorf("no axis-dependent carrier method turning a (level, position) pair into a gridCoord hands its result to a return statement or a layout call; role methods: %v", roleLabels(roles))
+	}
+}
+
+// TestLevelAndPositionExtractionAnsweredByCarrier pins REQ-STRUCT-002 for the
+// growth decisions that read an existing coordinate: the flow level (or the
+// cross position) of a node coordinate must be asked from an axis-dependent
+// carrier method instead of being read as a raw field.
+func TestLevelAndPositionExtractionAnsweredByCarrier(t *testing.T) {
+	g, roles, byTarget := carrierRolesFor(t)
+	sites := answeredSites(g, roles, byTarget, isExtractionRole, func(site roleCallSiteEvidence) bool {
+		return g.resultFlowsIntoCallArgumentOrReturn(site.site)
+	})
+	if len(sites) == 0 {
+		t.Errorf("no axis-dependent carrier method extracting a level/position integer from a gridCoord hands its result to a return statement or a layout call; role methods: %v", roleLabels(roles))
+	}
+}
+
+// TestParallelEdgeDirectionsAnsweredByCarrier pins REQ-STRUCT-002 for
+// repeated edges: the parallel start and end directions must be chosen by an
+// axis-dependent carrier method that the routing code calls and whose result
+// it consumes.
+func TestParallelEdgeDirectionsAnsweredByCarrier(t *testing.T) {
+	g, roles, byTarget := carrierRolesFor(t)
+	sites := answeredSites(g, roles, byTarget, isParallelRole, func(site roleCallSiteEvidence) bool {
+		if !g.resultFlowsIntoCallArgumentOrReturn(site.site) {
+			return false
+		}
+		return true
+	})
+	if len(sites) == 0 {
+		t.Errorf("no axis-dependent carrier method answering the parallel directions of repeated edges feeds a routing function that returns those directions; role methods: %v", roleLabels(roles))
+	}
+}
+
+// TestBooleanLayoutGatesAnsweredByCarrier pins REQ-STRUCT-002 for the boolean
+// layout gates: the subgraph-root separation branch and the fan-out early
+// return must consume axis-dependent carrier results. The two decisions may
+// share a carrier method; method identity is not a public contract.
+func TestBooleanLayoutGatesAnsweredByCarrier(t *testing.T) {
+	g, roles, byTarget := carrierRolesFor(t)
+	branches := map[string]string{}
+	earlyReturns := map[string]string{}
+	for _, site := range answeredSites(g, roles, byTarget, isBoolRole, func(site roleCallSiteEvidence) bool {
+		return site.condition
+	}) {
+		if site.early {
+			earlyReturns[site.location] = site.method.label()
+		} else {
+			branches[site.location] = site.method.label()
+		}
+	}
+	if len(branches) == 0 {
+		t.Errorf("no axis-dependent carrier result decides the subgraph-root layout branch; role methods: %v", roleLabels(roles))
+	}
+	if len(earlyReturns) == 0 && !carrierOwnsFanoutAction(t) {
+		t.Errorf("no axis-dependent carrier result or active carrier-owned action controls fan-out; role methods: %v", roleLabels(roles))
+	}
+}
+
+// TestFanoutEarlyReturnGateAnsweredByCarrier pins REQ-STRUCT-002 for the
+// fan-out layout gate: the only layout phase that is skipped by an early
+// return on the axis (the fan-out handling) must take that decision from an
+// axis-dependent carrier method instead of comparing the direction itself.
+func TestFanoutEarlyReturnGateAnsweredByCarrier(t *testing.T) {
+	g, roles, byTarget := carrierRolesFor(t)
+	sites := answeredSites(g, roles, byTarget, isBoolRole, func(site roleCallSiteEvidence) bool {
+		return site.condition && site.early
+	})
+	if len(sites) == 0 && !carrierOwnsFanoutAction(t) {
+		t.Errorf("no axis-dependent carrier boolean or active carrier-owned action controls the fan-out layout phase; role methods: %v", roleLabels(roles))
+	}
+}
+
+// TestCarrierRoleMethodsEngagedAndAxisDependent pins REQ-STRUCT-001 and
+// REQ-STRUCT-002 from the abstraction side: actual axis-dependent carrier
+// behavior must be reachable from layout code. The separate family checks
+// establish coverage; unused extra private helpers are not a requirement.
+func TestCarrierRoleMethodsEngagedAndAxisDependent(t *testing.T) {
+
+	g, roles, byTarget := carrierRolesFor(t)
+	engaged, _ := g.engagementOf(roles, byTarget)
+	for _, method := range roles {
+		if engaged[method.label()] && g.axisDependent(method, byTarget, map[string]bool{}).ok {
+			return
+		}
+	}
+	t.Errorf("no axis-dependent carrier behavior is engaged by the layout pipeline")
+
+}
+
+func roleLabels(roles []carrierRoleMethod) []string {
+	var out []string
+	for _, role := range roles {
+		out = append(out, role.label())
+	}
+	sort.Strings(out)
+	if len(out) == 0 {
+		return []string{"none"}
+	}
+	return out
+}
diff --git a/test/f2p/doc.go b/test/f2p/doc.go
new file mode 100644
index 0000000000000000000000000000000000000000..bb9eba2bbb07457f01f61fbb25950f5e55b67139
--- /dev/null
+++ b/test/f2p/doc.go
@@ -0,0 +1,14 @@
+// Package f2p holds the fail-to-pass structural tests for the graph
+// layout-direction refactor.
+//
+// The tests reflectively discover the stored axis state of graph.Properties,
+// type-check the non-test sources of pkg/graph with go/types and follow where
+// the carrier results are consumed. They verify that the Mermaid declaration
+// is translated once in the Parse reachable cone and that every
+// direction-dependent decision family (self-reference and route directions,
+// grid stepping and coordinate growth, parallel edge routing, the boolean
+// layout gates and the fan-out early return) is answered by an axis-dependent
+// carrier method that Draw-reachable layout code calls. The mechanism itself
+// stays open: a value type, a struct or an interface with per-axis
+// implementations all satisfy the checks.
+package f2p
diff --git a/test/f2p/f2prunner/main.go b/test/f2p/f2prunner/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..d866cc4df4c126d87fb14aae08b463059cc9f490
--- /dev/null
+++ b/test/f2p/f2prunner/main.go
@@ -0,0 +1,539 @@
+// Command f2prunner executes the fail-to-pass structural selectors of the
+// graph layout-direction plan and writes a regular JUnit report.
+//
+// It is invoked from the repository root by test/f2p/run_f2p.sh and only uses
+// the Go toolchain that ships with the frozen environment image. When the
+// canonical plan configuration is available (flag, environment variable or
+// repository-root config.json) the exact selector set is read from its p2p and
+// f2p arrays so the final scoring set is never re-derived from test files or
+// broad patterns. Every selector is executed with the real `go test` runner:
+// selectors whose test no longer compiles or is no longer collected are
+// reported as errors instead of silently disappearing from the report.
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+// fallbackSelectors is the exact fail-to-pass selection of this plan. It is
+// used when no canonical configuration is available (for example while the
+// plan is still being developed); the frozen selection is the configuration
+// read from {config} at grading time.
+var fallbackSelectors = []string{
+	"test/f2p/direction_structure_test.go::TestStoredAxisStateIsCarrierTyped",
+	"test/f2p/direction_structure_test.go::TestCarrierTypeFlowsIntoLayoutState",
+	"test/f2p/direction_structure_test.go::TestTokenVocabularyConfinedToDeclarationMapping",
+	"test/f2p/direction_structure_test.go::TestAxisStateReadsGoThroughCarrierMethods",
+	"test/f2p/direction_structure_test.go::TestSelfReferenceDirectionsAnsweredByCarrier",
+	"test/f2p/direction_structure_test.go::TestRouteSelectionAnsweredByCarrier",
+	"test/f2p/direction_structure_test.go::TestGridSteppingAnsweredByCarrier",
+	"test/f2p/direction_structure_test.go::TestCoordinateGrowthAnsweredByCarrier",
+	"test/f2p/direction_structure_test.go::TestLevelAndPositionExtractionAnsweredByCarrier",
+	"test/f2p/direction_structure_test.go::TestParallelEdgeDirectionsAnsweredByCarrier",
+	"test/f2p/direction_structure_test.go::TestBooleanLayoutGatesAnsweredByCarrier",
+	"test/f2p/direction_structure_test.go::TestFanoutEarlyReturnGateAnsweredByCarrier",
+	"test/f2p/direction_structure_test.go::TestCarrierRoleMethodsEngagedAndAxisDependent",
+}
+
+var selectorPattern = regexp.MustCompile(`^[A-Za-z0-9_./-]+\.go::[A-Za-z_][A-Za-z0-9_]*$`)
+var leafPattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+type selector struct {
+	raw    string
+	path   string
+	leaf   string
+	pkgDir string
+}
+
+func parseSelector(raw string) (selector, error) {
+	index := strings.LastIndex(raw, "::")
+	if index <= 0 || index+2 >= len(raw) {
+		return selector{}, fmt.Errorf("selector %q is not a path::leaf selector", raw)
+	}
+	path := raw[:index]
+	leaf := raw[index+2:]
+	if !leafPattern.MatchString(leaf) {
+		return selector{}, fmt.Errorf("selector %q: leaf %q is not a plain test function name", raw, leaf)
+	}
+	pkgDir := path
+	if strings.HasSuffix(path, ".go") {
+		pkgDir = filepath.Dir(path)
+	}
+	if pkgDir == "" || pkgDir == "." || pkgDir == "/" {
+		return selector{}, fmt.Errorf("selector %q: cannot derive a package from %q", raw, path)
+	}
+	return selector{raw: raw, path: path, leaf: leaf, pkgDir: pkgDir}, nil
+}
+
+type testEvent struct {
+	Action  string  `json:"Action"`
+	Package string  `json:"Package"`
+	Test    string  `json:"Test"`
+	Elapsed float64 `json:"Elapsed"`
+	Output  string  `json:"Output"`
+}
+
+type testResult struct {
+	status   string
+	elapsed  float64
+	output   string
+	missing  string
+	observed bool
+}
+
+func findRepoRoot(start string) (string, error) {
+	current, err := filepath.Abs(start)
+	if err != nil {
+		return "", err
+	}
+	for {
+		if _, statErr := os.Stat(filepath.Join(current, "go.mod")); statErr == nil {
+			return current, nil
+		}
+		parent := filepath.Dir(current)
+		if parent == current {
+			return "", fmt.Errorf("cannot find go.mod above %s", start)
+		}
+		current = parent
+	}
+}
+
+// collectSelectors walks arbitrary plan JSON and returns every exact
+// path::leaf selector it contains, preserving document order and dropping
+// duplicates. Reading the configuration keeps the frozen p2p and f2p arrays
+// authoritative instead of re-deriving the selection from test files.
+func collectSelectors(value interface{}, out *[]string, seen map[string]bool) {
+	switch typed := value.(type) {
+	case string:
+		if selectorPattern.MatchString(typed) && !seen[typed] {
+			seen[typed] = true
+			*out = append(*out, typed)
+		}
+	case []interface{}:
+		for _, item := range typed {
+			collectSelectors(item, out, seen)
+		}
+	case map[string]interface{}:
+		keys := make([]string, 0, len(typed))
+		for key := range typed {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			collectSelectors(typed[key], out, seen)
+		}
+	}
+}
+
+func selectorsFromConfigFile(path string) []string {
+	if strings.TrimSpace(path) == "" {
+		return nil
+	}
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	var document interface{}
+	if err := json.Unmarshal(payload, &document); err != nil {
+		return nil
+	}
+	if selectors := selectorsFromPlanArrays(document); len(selectors) > 0 {
+		return selectors
+	}
+	var out []string
+	collectSelectors(document, &out, map[string]bool{})
+	return out
+}
+
+// selectorsFromPlanArrays reads the frozen selection from the canonical plan
+// configuration: the top-level p2p and f2p selector arrays (or, when those are
+// absent, the tests arrays of the gates). Inventory lists that some plan
+// shapes carry are deliberately not part of the scoring selection and are only
+// reachable through the generic fallback walk when no plan array exists at all.
+func selectorsFromPlanArrays(document interface{}) []string {
+	root, ok := document.(map[string]interface{})
+	if !ok {
+		return nil
+	}
+	var out []string
+	seen := map[string]bool{}
+	add := func(value interface{}) {
+		raw, ok := value.(string)
+		if !ok || !selectorPattern.MatchString(raw) || seen[raw] {
+			return
+		}
+		seen[raw] = true
+		out = append(out, raw)
+	}
+	for _, key := range []string{"p2p", "f2p"} {
+		list, ok := root[key].([]interface{})
+		if !ok {
+			continue
+		}
+		for _, item := range list {
+			add(item)
+		}
+	}
+	if len(out) > 0 {
+		return out
+	}
+	gates, ok := root["gates"].([]interface{})
+	if !ok {
+		return nil
+	}
+	for _, gate := range gates {
+		entry, ok := gate.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		tests, ok := entry["tests"].([]interface{})
+		if !ok {
+			continue
+		}
+		for _, item := range tests {
+			add(item)
+		}
+	}
+	return out
+}
+
+func discoverConfig(root string) []string {
+	candidates := []string{}
+	for _, key := range []string{"VERIFIER_CONFIG", "VERIFIER_CONFIG_PATH", "VERIFIER_PLAN", "CONFIG_JSON", "GRADER_CONFIG"} {
+		if value := strings.TrimSpace(os.Getenv(key)); value != "" {
+			candidates = append(candidates, value)
+		}
+	}
+	for _, relative := range []string{"config.json", "../config.json", "../../config.json"} {
+		candidates = append(candidates, filepath.Join(root, relative))
+	}
+	for _, candidate := range candidates {
+		if selectors := selectorsFromConfigFile(candidate); len(selectors) > 0 {
+			return selectors
+		}
+	}
+	return nil
+}
+
+// loadSelectors returns the exact selector set to execute. The canonical
+// configuration (when available) contributes its frozen p2p and f2p arrays and
+// is used verbatim, so the report covers exactly the frozen pass-to-pass plus
+// fail-to-pass selection. Without a configuration the declared fail-to-pass
+// selection of this plan is executed so the runner stays usable while the plan
+// is still being developed.
+func loadSelectors(root, configPath string) ([]string, string) {
+	configured := selectorsFromConfigFile(configPath)
+	source := configPath
+	if len(configured) == 0 && configPath == "" {
+		configured = discoverConfig(root)
+		if len(configured) > 0 {
+			source = "discovered"
+		}
+	}
+	if len(configured) == 0 {
+		return fallbackSelectors, "builtin"
+	}
+	return configured, source
+}
+
+func runSelectorGroup(root, pkgDir string, group []selector, timeout time.Duration) map[string]*testResult {
+	results := make(map[string]*testResult, len(group))
+	for _, item := range group {
+		results[item.leaf] = &testResult{status: "missing"}
+	}
+	names := make([]string, 0, len(group))
+	for _, item := range group {
+		names = append(names, regexp.QuoteMeta(item.leaf))
+	}
+	args := []string{
+		"test",
+		"-count=1",
+		"-json",
+		"-timeout", timeout.String(),
+		"-run", "^(" + strings.Join(names, "|") + ")$",
+		"./" + pkgDir,
+	}
+	command := exec.Command("go", args...)
+	command.Dir = root
+	command.Env = append(os.Environ(), "GOPROXY=off")
+
+	var stdout, stderr bytes.Buffer
+	command.Stdout = &stdout
+	command.Stderr = &stderr
+	runErr := command.Run()
+
+	pkgOutput := &strings.Builder{}
+	decoder := json.NewDecoder(bytes.NewReader(stdout.Bytes()))
+	for {
+		var event testEvent
+		if err := decoder.Decode(&event); err != nil {
+			break
+		}
+		if event.Test == "" {
+			if event.Output != "" {
+				pkgOutput.WriteString(event.Output)
+			}
+			continue
+		}
+		for _, item := range group {
+			if event.Test != item.leaf && !strings.HasPrefix(event.Test, item.leaf+"/") {
+				continue
+			}
+			result := results[item.leaf]
+			switch event.Action {
+			case "output":
+				result.output += event.Output
+			case "pass":
+				if event.Test == item.leaf {
+					result.status = "pass"
+					result.elapsed = event.Elapsed
+				}
+			case "fail":
+				if event.Test == item.leaf {
+					result.status = "fail"
+					result.elapsed = event.Elapsed
+				}
+			case "skip":
+				if event.Test == item.leaf {
+					result.status = "skip"
+					result.elapsed = event.Elapsed
+				}
+			}
+			break
+		}
+	}
+	detail := strings.TrimSpace(pkgOutput.String())
+	if detail == "" {
+		detail = strings.TrimSpace(stderr.String())
+	}
+	if runErr != nil {
+		for _, item := range group {
+			if results[item.leaf].status == "missing" {
+				results[item.leaf].missing = fmt.Sprintf("go test ./%s did not collect or complete %s: %v\n%s", pkgDir, item.leaf, runErr, detail)
+			}
+		}
+	}
+	return results
+}
+
+type junitProperty struct {
+	Name  string `xml:"name,attr"`
+	Value string `xml:"value,attr"`
+}
+
+type junitProperties struct {
+	Items []junitProperty `xml:"property"`
+}
+
+type junitFailure struct {
+	Message string `xml:"message,attr"`
+	Text    string `xml:",chardata"`
+}
+
+type junitError struct {
+	Message string `xml:"message,attr"`
+	Text    string `xml:",chardata"`
+}
+
+type junitSkipped struct {
+	Message string `xml:"message,attr,omitempty"`
+}
+
+type junitTestCase struct {
+	Name       string           `xml:"name,attr"`
+	Classname  string           `xml:"classname,attr"`
+	File       string           `xml:"file,attr"`
+	Time       float64          `xml:"time,attr"`
+	Properties *junitProperties `xml:"properties,omitempty"`
+	Failure    *junitFailure    `xml:"failure,omitempty"`
+	Error      *junitError      `xml:"error,omitempty"`
+	Skipped    *junitSkipped    `xml:"skipped,omitempty"`
+}
+
+type junitTestSuite struct {
+	XMLName  xml.Name        `xml:"testsuite"`
+	Name     string          `xml:"name,attr"`
+	Package  string          `xml:"package,attr,omitempty"`
+	Tests    int             `xml:"tests,attr"`
+	Failures int             `xml:"failures,attr"`
+	Errors   int             `xml:"errors,attr"`
+	Skipped  int             `xml:"skipped,attr"`
+	Time     float64         `xml:"time,attr"`
+	Cases    []junitTestCase `xml:"testcase"`
+}
+
+type junitTestSuites struct {
+	XMLName  xml.Name         `xml:"testsuites"`
+	Name     string           `xml:"name,attr"`
+	Tests    int              `xml:"tests,attr"`
+	Failures int              `xml:"failures,attr"`
+	Errors   int              `xml:"errors,attr"`
+	Skipped  int              `xml:"skipped,attr"`
+	Time     float64          `xml:"time,attr"`
+	Suites   []junitTestSuite `xml:"testsuite"`
+}
+
+func main() {
+	reportPath := flag.String("report", "", "path of the JUnit report to write")
+	configPath := flag.String("config", "", "path of the canonical plan configuration with the p2p and f2p selector arrays")
+	perPackageTimeout := flag.Duration("package-timeout", 90*time.Second, "timeout passed to each go test invocation")
+	flag.Parse()
+
+	if strings.TrimSpace(*reportPath) == "" {
+		fmt.Fprintln(os.Stderr, "f2prunner: -report is required")
+		os.Exit(2)
+	}
+
+	workingDir, err := os.Getwd()
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "f2prunner: %v\n", err)
+		os.Exit(2)
+	}
+	root, err := findRepoRoot(workingDir)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "f2prunner: %v\n", err)
+		os.Exit(2)
+	}
+
+	rawSelectors, source := loadSelectors(root, *configPath)
+	var selectors []selector
+	seen := map[string]bool{}
+	for _, raw := range rawSelectors {
+		if seen[raw] {
+			continue
+		}
+		seen[raw] = true
+		item, parseErr := parseSelector(raw)
+		if parseErr != nil {
+			fmt.Fprintf(os.Stderr, "f2prunner: %v\n", parseErr)
+			os.Exit(2)
+		}
+		selectors = append(selectors, item)
+	}
+	if len(selectors) == 0 {
+		fmt.Fprintln(os.Stderr, "f2prunner: no selectors to execute")
+		os.Exit(2)
+	}
+	fmt.Fprintf(os.Stderr, "f2prunner: executing %d selectors (source: %s)\n", len(selectors), source)
+
+	groups := map[string][]selector{}
+	var groupOrder []string
+	for _, item := range selectors {
+		if _, ok := groups[item.pkgDir]; !ok {
+			groupOrder = append(groupOrder, item.pkgDir)
+		}
+		groups[item.pkgDir] = append(groups[item.pkgDir], item)
+	}
+
+	allResults := map[string]*testResult{}
+	started := time.Now()
+	for _, pkgDir := range groupOrder {
+		groupResults := runSelectorGroup(root, pkgDir, groups[pkgDir], *perPackageTimeout)
+		for leaf, result := range groupResults {
+			allResults[pkgDir+"::"+leaf] = result
+		}
+	}
+
+	suiteByPath := map[string]*junitTestSuite{}
+	var suiteOrder []string
+	for _, item := range selectors {
+		if _, seen := suiteByPath[item.path]; !seen {
+			suiteByPath[item.path] = &junitTestSuite{Name: item.path, Package: item.pkgDir}
+			suiteOrder = append(suiteOrder, item.path)
+		}
+	}
+	for _, item := range selectors {
+		result := allResults[item.pkgDir+"::"+item.leaf]
+		if result == nil {
+			result = &testResult{status: "missing", missing: "selector was not executed"}
+		}
+		suite := suiteByPath[item.path]
+		testCase := junitTestCase{
+			Name:      item.leaf,
+			Classname: item.path,
+			File:      item.path,
+			Time:      result.elapsed,
+			Properties: &junitProperties{Items: []junitProperty{
+				{Name: "selector", Value: item.raw},
+			}},
+		}
+		switch result.status {
+		case "pass":
+		case "skip":
+			testCase.Skipped = &junitSkipped{}
+			suite.Skipped++
+		case "fail":
+			testCase.Failure = &junitFailure{
+				Message: fmt.Sprintf("%s failed", item.raw),
+				Text:    strings.TrimSpace(result.output),
+			}
+			suite.Failures++
+		default:
+			message := result.missing
+			if message == "" {
+				message = fmt.Sprintf("%s was not collected by go test", item.raw)
+			}
+			testCase.Error = &junitError{Message: message, Text: strings.TrimSpace(result.output)}
+			suite.Errors++
+		}
+		suite.Cases = append(suite.Cases, testCase)
+		suite.Tests++
+		suite.Time += result.elapsed
+	}
+
+	report := junitTestSuites{Name: "f2p"}
+	totalTime := time.Since(started).Seconds()
+	for _, path := range suiteOrder {
+		suite := suiteByPath[path]
+		report.Suites = append(report.Suites, *suite)
+		report.Tests += suite.Tests
+		report.Failures += suite.Failures
+		report.Errors += suite.Errors
+		report.Skipped += suite.Skipped
+	}
+	report.Time = totalTime
+
+	payload, err := xml.MarshalIndent(report, "", "  ")
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "f2prunner: cannot encode JUnit report: %v\n", err)
+		os.Exit(2)
+	}
+	payload = append([]byte(xml.Header), payload...)
+	payload = append(payload, '\n')
+	if dir := filepath.Dir(*reportPath); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			fmt.Fprintf(os.Stderr, "f2prunner: cannot create report directory: %v\n", err)
+			os.Exit(2)
+		}
+	}
+	if err := os.WriteFile(*reportPath, payload, 0o644); err != nil {
+		fmt.Fprintf(os.Stderr, "f2prunner: cannot write report: %v\n", err)
+		os.Exit(2)
+	}
+
+	exitCode := 0
+	for _, item := range selectors {
+		result := allResults[item.pkgDir+"::"+item.leaf]
+		status := "missing"
+		if result != nil {
+			status = result.status
+		}
+		fmt.Printf("%-7s %s\n", strings.ToUpper(status), item.raw)
+		if status != "pass" {
+			exitCode = 1
+		}
+	}
+	fmt.Printf("f2prunner: %d selectors, %d failures, %d errors, report %s\n", report.Tests, report.Failures, report.Errors, *reportPath)
+	os.Exit(exitCode)
+}
diff --git a/test/f2p/harness_test.go b/test/f2p/harness_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0ebe17535943993e91e0fc175c48e9ba76494474
--- /dev/null
+++ b/test/f2p/harness_test.go
@@ -0,0 +1,63 @@
+package f2p
+
+// Shared low-level helpers for the structural fail-to-pass checks: the
+// Mermaid direction vocabulary, the token-literal detector and the repository
+// root lookup used by the go/types loader. The heavier analysis machinery
+// lives in abstraction_harness_test.go.
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+// directionTokens are the five Mermaid direction declarations the graph
+// layout pipeline accepts. Only the single declaration-to-axis mapping point
+// (the Parse reachable cone) may interpret them.
+var directionTokens = map[string]bool{
+	"LR": true,
+	"RL": true,
+	"TD": true,
+	"TB": true,
+	"BT": true,
+}
+
+func repositoryRoot() (string, error) {
+	dir, err := os.Getwd()
+	if err != nil {
+		return "", err
+	}
+	for {
+		if info, statErr := os.Stat(filepath.Join(dir, "go.mod")); statErr == nil && !info.IsDir() {
+			return dir, nil
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "", fmt.Errorf("go.mod not found above %s", dir)
+		}
+		dir = parent
+	}
+}
+
+// tokenLiteral reports whether the expression is a string literal equal to
+// one of the direction tokens. The comparison is case-insensitive on purpose:
+// a lower-cased comparison still interprets the direction string.
+func tokenLiteral(expr ast.Expr) (string, bool) {
+	lit, ok := expr.(*ast.BasicLit)
+	if !ok || lit.Kind != token.STRING {
+		return "", false
+	}
+	value, err := strconv.Unquote(lit.Value)
+	if err != nil {
+		return "", false
+	}
+	value = strings.ToUpper(value)
+	if !directionTokens[value] {
+		return "", false
+	}
+	return value, true
+}
diff --git a/test/f2p/run_f2p.sh b/test/f2p/run_f2p.sh
new file mode 100755
index 0000000000000000000000000000000000000000..9d587c64f9e005edf6bb8826dd0928d4a1b03596
--- /dev/null
+++ b/test/f2p/run_f2p.sh
@@ -0,0 +1,52 @@
+#!/usr/bin/env bash
+# Runs the fail-to-pass structural selection of the graph layout-direction plan
+# and writes a regular JUnit report at the path given as the first argument.
+#
+# The runner only uses repository files and tools from the frozen environment
+# image: no installs, downloads or registry access happen here. Build artefacts
+# are executed, so the runner is declared with require_exec=true and uses the
+# controlled VERIFIER_EXEC_DIR for the Go build work directory when it is
+# provided; temporary report data stays in TMPDIR.
+set -euo pipefail
+
+report="${1:-}"
+if [ -z "$report" ]; then
+  echo "usage: run_f2p.sh <junit-report-path>" >&2
+  exit 2
+fi
+
+script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+repo_root="$(cd "$script_dir/../.." && pwd)"
+
+case "$report" in
+  /*) ;;
+  *) report="$PWD/$report" ;;
+esac
+
+if [ -n "${VERIFIER_EXEC_DIR:-}" ] && [ -d "${VERIFIER_EXEC_DIR}" ]; then
+  gotmp="${VERIFIER_EXEC_DIR}/go-build-work"
+  if mkdir -p "$gotmp" 2>/dev/null; then
+    export GOTMPDIR="$gotmp"
+  fi
+fi
+
+# The environment may mount TMPDIR noexec; the compiled runner and test
+# binaries must still be executable. Fall back to a work directory inside the
+# repository copy, which is writable and executable, when no controlled
+# execution directory was provided.
+f2p_exec_tmp=""
+if [ -z "${GOTMPDIR:-}" ]; then
+  gotmp="$(mktemp -d "${repo_root}/.f2p-exec.XXXXXX" 2>/dev/null || true)"
+  if [ -n "$gotmp" ]; then
+    export GOTMPDIR="$gotmp"
+    f2p_exec_tmp="$gotmp"
+  fi
+fi
+
+cd "$repo_root"
+status=0
+go run ./test/f2p/f2prunner -report "$report" || status=$?
+if [ -n "$f2p_exec_tmp" ]; then
+  rm -rf "$f2p_exec_tmp"
+fi
+exit "$status"
diff --git a/test/p2p/direction_regression_test.go b/test/p2p/direction_regression_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..fdd8a44680d296286bd598e9b72cd26ded0a1742
--- /dev/null
+++ b/test/p2p/direction_regression_test.go
@@ -0,0 +1,637 @@
+package p2p
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/AlexanderGrooff/mermaid-ascii/pkg/diagram"
+	"github.com/AlexanderGrooff/mermaid-ascii/pkg/graph"
+	"github.com/AlexanderGrooff/mermaid-ascii/pkg/render"
+)
+
+// trailingSpaceMarker makes trailing spaces of golden outputs visible in the
+// source, matching the convention the repository test cases use.
+const trailingSpaceMarker = "␠"
+
+func decodeGolden(golden string) string {
+	return strings.ReplaceAll(golden, trailingSpaceMarker, " ")
+}
+
+func parseP2PGraph(t *testing.T, input string) *graph.Properties {
+	t.Helper()
+	properties, err := graph.Parse(input, "cli")
+	if err != nil {
+		t.Fatalf("graph.Parse(%q) error = %v", input, err)
+	}
+	if properties == nil {
+		t.Fatalf("graph.Parse(%q) returned no properties", input)
+	}
+	return properties
+}
+
+func renderP2PASCII(t *testing.T, input string) string {
+	t.Helper()
+	properties := parseP2PGraph(t, input)
+	properties.Apply(diagram.NewTestConfig(true, "cli"))
+	return graph.Draw(properties)
+}
+
+func assertP2PRender(t *testing.T, input, want string) {
+	t.Helper()
+	if got := renderP2PASCII(t, input); got != want {
+		t.Fatalf("rendered output changed for %q\nexpected:\n%q\nactual:\n%q", input, want, got)
+	}
+}
+
+func p2pLineContaining(output, needle string) int {
+	for index, line := range strings.Split(output, "\n") {
+		if strings.Contains(line, needle) {
+			return index
+		}
+	}
+	return -1
+}
+
+// TestP2PRenderedOutputParityPerAxis pins byte-for-byte rendering of one
+// bidirectional pair on each axis.
+func TestP2PRenderedOutputParityPerAxis(t *testing.T) {
+	assertP2PRender(t, "graph LR\nA --> B\nB --> A", decodeGolden(`+---+     +---+
+|   |     |   |
+| A |---->| B |
+|   |     |   |
++---+     +---+
+  ^         |␠␠
+  +---------+␠␠`))
+	assertP2PRender(t, "graph TD\nA --> B\nB --> A", decodeGolden(`+---+␠␠
+|   |␠␠
+| A |<+
+|   | |
++---+ |
+  |   |
+  |   |
+  |   |
+  |   |
+  v   |
++---+ |
+|   | |
+| B |-+
+|   |␠␠
++---+␠␠`))
+}
+
+// TestP2PDirectionDeclarationAxisMapping pins the declaration-to-axis mapping:
+// LR and RL share the horizontal axis without reversal, TD/TB/BT and a
+// direction-less declaration share the vertical axis without reversal, and the
+// declaration stays case-sensitive.
+func TestP2PDirectionDeclarationAxisMapping(t *testing.T) {
+	horizontal := renderP2PASCII(t, "graph LR\nA --> B")
+	vertical := renderP2PASCII(t, "graph TD\nA --> B")
+
+	for _, declaration := range []string{"graph LR", "flowchart LR", "graph RL", "flowchart RL"} {
+		if got := renderP2PASCII(t, declaration+"\nA --> B"); got != horizontal {
+			t.Errorf("%q must render on the horizontal axis without reversal\n%s", declaration, got)
+		}
+	}
+	for _, declaration := range []string{"graph TD", "flowchart TD", "graph TB", "graph BT", "flowchart BT", "graph", "flowchart"} {
+		if got := renderP2PASCII(t, declaration+"\nA --> B"); got != vertical {
+			t.Errorf("%q must render on the vertical axis without reversal\n%s", declaration, got)
+		}
+	}
+	if horizontal == vertical {
+		t.Fatal("the two axes must keep different layouts for the same edge")
+	}
+	for _, declaration := range []string{"graph lr", "graph Td", "GRAPH LR", "Flowchart LR", "graph tB"} {
+		if _, err := graph.Parse(declaration+"\nA --> B", "cli"); err == nil {
+			t.Errorf("graph.Parse(%q) must keep rejecting the case-mismatched declaration", declaration)
+		}
+	}
+}
+
+// TestP2PDirectionParseErrorCompatibility pins the exact parse errors of the
+// declaration grammar, including the supported-direction list.
+func TestP2PDirectionParseErrorCompatibility(t *testing.T) {
+	cases := []struct {
+		name  string
+		input string
+		want  string
+	}{
+		{
+			name:  "unknown direction",
+			input: "graph SIDEWAYS\nA --> B",
+			want:  "unsupported graph direction 'SIDEWAYS'. Supported directions: TD, TB, BT, LR, RL",
+		},
+		{
+			name:  "lowercase direction",
+			input: "graph td\nA --> B",
+			want:  "unsupported graph direction 'td'. Supported directions: TD, TB, BT, LR, RL",
+		},
+		{
+			name:  "extra tokens after direction",
+			input: "graph TD foo\nA --> B",
+			want:  `unexpected tokens after graph direction: "foo"`,
+		},
+		{
+			name:  "uppercase graph keyword",
+			input: "GRAPH TD\nA --> B",
+			want:  "unsupported graph type 'GRAPH TD'. Supported types: 'graph' or 'flowchart' with an optional direction (TD, TB, BT, LR, RL)",
+		},
+		{
+			name:  "unknown diagram type",
+			input: "sequenceDiagram\nA->>B: x",
+			want:  "unsupported graph type 'sequenceDiagram'. Supported types: 'graph' or 'flowchart' with an optional direction (TD, TB, BT, LR, RL)",
+		},
+		{
+			name:  "empty input",
+			input: "",
+			want:  "missing graph definition",
+		},
+	}
+	for _, testCase := range cases {
+		t.Run(testCase.name, func(t *testing.T) {
+			_, err := graph.Parse(testCase.input, "cli")
+			if err == nil {
+				t.Fatalf("graph.Parse(%q) must keep returning an error", testCase.input)
+			}
+			if err.Error() != testCase.want {
+				t.Fatalf("graph.Parse(%q) error = %q, want %q", testCase.input, err.Error(), testCase.want)
+			}
+		})
+	}
+	if _, err := graph.Parse("graph\nA --> B", "cli"); err != nil {
+		t.Fatalf("a declaration without a direction must keep parsing, got %v", err)
+	}
+}
+
+// TestP2PSelfReferencePerAxis pins the per-axis self-reference loop geometry.
+func TestP2PSelfReferencePerAxis(t *testing.T) {
+	assertP2PRender(t, "graph LR\nA --> A", decodeGolden(`+---+␠␠
+|   |␠␠
+| A |-+
+|   | |
++---+ |
+  ^   |
+  +---+`))
+	assertP2PRender(t, "graph TD\nA --> A", decodeGolden(`+---+␠␠
+|   |␠␠
+| A |<+
+|   | |
++---+ |
+  |   |
+  +---+`))
+}
+
+// TestP2PBackwardsEdgePerAxis pins the routing of an edge that flows against
+// the axis of growth (C --> A in a three-node cycle).
+func TestP2PBackwardsEdgePerAxis(t *testing.T) {
+	assertP2PRender(t, "graph LR\nA --> B\nB --> C\nC --> A", decodeGolden(`+---+     +---+     +---+
+|   |     |   |     |   |
+| A |---->| B |---->| C |
+|   |     |   |     |   |
++---+     +---+     +---+
+  ^                   |␠␠
+  +-------------------+␠␠`))
+	assertP2PRender(t, "graph TD\nA --> B\nB --> C\nC --> A", decodeGolden(`+---+␠␠
+|   |␠␠
+| A |<+
+|   | |
++---+ |
+  |   |
+  |   |
+  |   |
+  |   |
+  v   |
++---+ |
+|   | |
+| B | |
+|   | |
++---+ |
+  |   |
+  |   |
+  |   |
+  |   |
+  v   |
++---+ |
+|   | |
+| C |-+
+|   |␠␠
++---+␠␠`))
+}
+
+// TestP2PRepeatedEdgeParallelRoutingPerAxis pins the parallel routing of two
+// edges that connect the same pair of nodes on each axis.
+func TestP2PRepeatedEdgeParallelRoutingPerAxis(t *testing.T) {
+	assertP2PRender(t, "graph LR\nA -->|one| B\nA -->|two| B", decodeGolden(`+---+      +---+
+|   |      |   |
+| A |-one->| B |
+|   |      |   |
++---+      +---+
+  |          ^␠␠
+  +---two----+␠␠`))
+	assertP2PRender(t, "graph TD\nA -->|one| B\nA -->|two| B", decodeGolden(`+------+␠␠␠␠␠␠
+|      |␠␠␠␠␠␠
+|  A   |---+␠␠
+|      |   |␠␠
++------+   |␠␠
+    |      |␠␠
+    |      |␠␠
+   one    two␠
+    |      |␠␠
+    v      |␠␠
++------+   |␠␠
+|      |   |␠␠
+|  B   |<--+␠␠
+|      |␠␠␠␠␠␠
++------+␠␠␠␠␠␠`))
+}
+
+// TestP2PFanoutAxisGating pins that fan-out branch labels are aligned only for
+// vertical layouts that have no subgraphs.
+func TestP2PFanoutAxisGating(t *testing.T) {
+	vertical := renderP2PASCII(t, "flowchart TB\nA -->|alpha| B\nA -->|beta| C")
+	alphaRow := p2pLineContaining(vertical, "alpha")
+	betaRow := p2pLineContaining(vertical, "beta")
+	if alphaRow < 0 || betaRow < 0 {
+		t.Fatalf("vertical fan-out output lost a branch label\n%s", vertical)
+	}
+	if alphaRow != betaRow {
+		t.Fatalf("vertical fan-out without subgraphs must keep aligned branch labels\n%s", vertical)
+	}
+
+	horizontal := renderP2PASCII(t, "graph LR\nA -->|alpha| B\nA -->|beta| C")
+	if left, right := p2pLineContaining(horizontal, "alpha"), p2pLineContaining(horizontal, "beta"); left < 0 || right < 0 {
+		t.Fatalf("horizontal fan-out output lost a branch label\n%s", horizontal)
+	} else if left == right {
+		t.Fatalf("horizontal layouts must not use the vertical fan-out alignment\n%s", horizontal)
+	}
+
+	withSubgraph := renderP2PASCII(t, "flowchart TB\nA -->|alpha| B\nA -->|beta| C\nsubgraph s\nD --> E\nend")
+	if left, right := p2pLineContaining(withSubgraph, "alpha"), p2pLineContaining(withSubgraph, "beta"); left < 0 || right < 0 {
+		t.Fatalf("subgraph fan-out output lost a branch label\n%s", withSubgraph)
+	} else if left == right {
+		t.Fatalf("fan-out alignment must be disabled when the vertical layout has subgraphs\n%s", withSubgraph)
+	}
+	// An isolated subgraph introduces no other edge that could mask the
+	// no-subgraphs guard by making fan-out ineligible for another reason.
+	t.Run("isolated_subgraph_guard", func(t *testing.T) {
+		assertP2PRender(t, "graph TD\nA -->|alpha| B\nA -->|beta| C\nsubgraph s\nZ\nend", decodeGolden(`               +-------+
+               |   s   |
+               |       |
+               |       |
++--------+     | +---+ |
+|        |     | |   | |
+|   A    |---+ | | Z | |
+|        |   | | |   | |
++--------+ beta| +---+ |
+     |       | |       |
+     |       | +-------+
+   alpha     +-----+␠␠␠␠
+     |             |␠␠␠␠
+     v             v␠␠␠␠
++--------+       +---+␠␠
+|        |       |   |␠␠
+|   B    |       | C |␠␠
+|        |       |   |␠␠
++--------+       +---+␠␠`))
+	})
+
+}
+
+// TestP2PDeterministicOutputAndOrdering pins that repeated renders are
+// identical and that node ordering follows the declaration.
+func TestP2PDeterministicOutputAndOrdering(t *testing.T) {
+	inputs := []string{
+		"graph LR\nA --> B\nC --> D\nB --> C",
+		"graph TD\nA --> B\nA --> C\nB --> D\nC --> D",
+		"flowchart TB\nA -->|alpha| B\nA -->|beta| C",
+	}
+	for _, input := range inputs {
+		first := renderP2PASCII(t, input)
+		for run := 0; run < 2; run++ {
+			if got := renderP2PASCII(t, input); got != first {
+				t.Fatalf("layout must stay deterministic for %q\nfirst:\n%s\nnext:\n%s", input, first, got)
+			}
+		}
+	}
+
+	ordered := renderP2PASCII(t, "graph LR\nA --> B\nC --> D\nB --> C")
+	positions := []int{
+		strings.Index(ordered, "| A |"),
+		strings.Index(ordered, "| B |"),
+		strings.Index(ordered, "| C |"),
+		strings.Index(ordered, "| D |"),
+	}
+	for index, position := range positions {
+		if position < 0 {
+			t.Fatalf("output lost node %q\n%s", string(rune('A'+index)), ordered)
+		}
+		if index > 0 && positions[index-1] >= position {
+			t.Fatalf("node ordering must follow the declaration order\n%s", ordered)
+		}
+	}
+}
+
+// TestP2PInvalidDeclarationErrorsWithoutPanic pins the remaining invalid
+// declarations and that they return errors instead of panicking.
+func TestP2PInvalidDeclarationErrorsWithoutPanic(t *testing.T) {
+	cases := []struct {
+		input string
+		want  string
+	}{
+		{"GRAPH TD\nA --> B", "unsupported graph type 'GRAPH TD'. Supported types: 'graph' or 'flowchart' with an optional direction (TD, TB, BT, LR, RL)"},
+		{"sequenceDiagram\nA->>B: x", "unsupported graph type 'sequenceDiagram'. Supported types: 'graph' or 'flowchart' with an optional direction (TD, TB, BT, LR, RL)"},
+		{"graph TD foo\nA --> B", `unexpected tokens after graph direction: "foo"`},
+		{"graph TD foo bar\nA --> B", `unexpected tokens after graph direction: "foo bar"`},
+		{"graph SIDEWAYS\nA --> B", "unsupported graph direction 'SIDEWAYS'. Supported directions: TD, TB, BT, LR, RL"},
+		{"", "missing graph definition"},
+	}
+	for _, testCase := range cases {
+		_, err := graph.Parse(testCase.input, "cli")
+		if err == nil {
+			t.Fatalf("graph.Parse(%q) must keep returning an error instead of panicking", testCase.input)
+		}
+		if err.Error() != testCase.want {
+			t.Fatalf("graph.Parse(%q) error = %q, want %q", testCase.input, err.Error(), testCase.want)
+		}
+	}
+	if _, err := graph.Parse("graph\nA --> B", "cli"); err != nil {
+		t.Fatalf("a declaration without a direction must keep parsing, got %v", err)
+	}
+	if _, err := graph.Parse("flowchart\nA --> B", "cli"); err != nil {
+		t.Fatalf("a direction-less flowchart must keep parsing, got %v", err)
+	}
+}
+
+// TestP2PConfigDirectionValidation pins the configuration contract of
+// Config.GraphDirection: exactly "LR" and "TD" are valid and the rejection
+// error names the GraphDirection field.
+func TestP2PConfigDirectionValidation(t *testing.T) {
+	defaults := diagram.DefaultConfig()
+	if defaults.GraphDirection != "LR" {
+		t.Fatalf("DefaultConfig().GraphDirection = %q, want %q", defaults.GraphDirection, "LR")
+	}
+	if err := defaults.Validate(); err != nil {
+		t.Fatalf("DefaultConfig().Validate() error = %v", err)
+	}
+	for _, direction := range []string{"LR", "TD"} {
+		config := diagram.DefaultConfig()
+		config.GraphDirection = direction
+		if err := config.Validate(); err != nil {
+			t.Fatalf("Validate() rejected %q: %v", direction, err)
+		}
+	}
+	for _, direction := range []string{"", "RL", "TB", "BT", "lr", "td", "LR ", "LR\n"} {
+		config := diagram.DefaultConfig()
+		config.GraphDirection = direction
+		err := config.Validate()
+		if err == nil {
+			t.Fatalf("Validate() accepted GraphDirection %q", direction)
+		}
+		var configErr *diagram.ConfigError
+		if !errors.As(err, &configErr) {
+			t.Fatalf("Validate() error for %q is %T, want *diagram.ConfigError", direction, err)
+		}
+		if configErr.Field != "GraphDirection" {
+			t.Fatalf("ConfigError.Field = %q, want %q", configErr.Field, "GraphDirection")
+		}
+		want := fmt.Sprintf("invalid config: GraphDirection = %v (must be \"LR\" or \"TD\")", direction)
+		if err.Error() != want {
+			t.Fatalf("Validate() error = %q, want %q", err.Error(), want)
+		}
+	}
+	if _, err := diagram.NewConfig(false, "RL", "cli"); err == nil {
+		t.Fatal("NewConfig must keep rejecting an unsupported graph direction")
+	}
+}
+
+// TestP2PConstructorSignaturesAndDefaults pins the constructor parameter lists
+// and the existing "LR" defaults.
+func TestP2PConstructorSignaturesAndDefaults(t *testing.T) {
+	config, err := diagram.NewConfig(false, "TD", "cli")
+	if err != nil {
+		t.Fatalf("NewConfig(false, \"TD\", \"cli\") error = %v", err)
+	}
+	if config.UseAscii || config.GraphDirection != "TD" || config.StyleType != "cli" {
+		t.Fatalf("NewConfig values = %+v", config)
+	}
+	if config.BoxBorderPadding != 1 || config.PaddingBetweenX != 5 || config.PaddingBetweenY != 5 {
+		t.Fatalf("NewConfig defaults = %+v", config)
+	}
+
+	cliConfig, err := diagram.NewCLIConfig(true, false, true, 2, 4, 6, "TD")
+	if err != nil {
+		t.Fatalf("NewCLIConfig(...) error = %v", err)
+	}
+	if !cliConfig.UseAscii || cliConfig.ShowCoords || !cliConfig.Verbose || cliConfig.GraphDirection != "TD" || cliConfig.StyleType != "cli" {
+		t.Fatalf("NewCLIConfig values = %+v", cliConfig)
+	}
+
+	webConfig, err := diagram.NewWebConfig(true, 3, 7, 9)
+	if err != nil {
+		t.Fatalf("NewWebConfig(...) error = %v", err)
+	}
+	if !webConfig.UseAscii || webConfig.GraphDirection != "LR" || webConfig.StyleType != "html" {
+		t.Fatalf("NewWebConfig values = %+v", webConfig)
+	}
+	if webConfig.BoxBorderPadding != 3 || webConfig.PaddingBetweenX != 7 || webConfig.PaddingBetweenY != 9 {
+		t.Fatalf("NewWebConfig padding = %+v", webConfig)
+	}
+
+	testConfig := diagram.NewTestConfig(true, "html")
+	if !testConfig.UseAscii || testConfig.GraphDirection != "LR" || testConfig.StyleType != "html" {
+		t.Fatalf("NewTestConfig values = %+v", testConfig)
+	}
+}
+
+// TestP2PParseApplyDrawEntryPoints pins Parse, Apply and Draw as the supported
+// parse, configure and render entry points.
+func TestP2PParseApplyDrawEntryPoints(t *testing.T) {
+	// Parse supplies usable defaults even when Apply is never called.
+	for _, tc := range []struct{ input, want string }{
+		{input: "graph LR\nA --> B", want: decodeGolden(`┌───┐     ┌───┐
+│   │     │   │
+│ A ├────►│ B │
+│   │     │   │
+└───┘     └───┘`)},
+		{input: "graph TD\nA --> B", want: decodeGolden(`┌───┐
+│   │
+│ A │
+│   │
+└─┬─┘
+  │␠␠
+  │␠␠
+  │␠␠
+  │␠␠
+  ▼␠␠
+┌───┐
+│   │
+│ B │
+│   │
+└───┘`)},
+	} {
+		t.Run("direct_parse_"+strings.Split(tc.input, "\n")[0], func(t *testing.T) {
+			if got := graph.Draw(parseP2PGraph(t, tc.input)); got != tc.want {
+				t.Fatalf("Draw(Parse(...)) changed its default output\nexpected:\n%q\nactual:\n%q", tc.want, got)
+			}
+		})
+	}
+
+	properties := parseP2PGraph(t, "graph LR\nA --> B")
+	properties.Apply(diagram.NewTestConfig(true, "cli"))
+	rendered := graph.Draw(properties)
+	for _, want := range []string{"| A |", "| B |", "---->"} {
+		if !strings.Contains(rendered, want) {
+			t.Fatalf("Draw(Apply(Parse(...))) lost %q\n%s", want, rendered)
+		}
+	}
+
+	overlay := diagram.NewTestConfig(true, "cli")
+	overlay.ShowCoords = true
+	properties.Apply(overlay)
+	if graph.Draw(properties) == rendered {
+		t.Fatal("Apply must keep applying the configuration to the parsed graph")
+	}
+}
+
+// TestP2PRenderDiagramWidthStatusContract pins the render entry points and the
+// width-status results.
+func TestP2PRenderDiagramWidthStatusContract(t *testing.T) {
+	plain, err := render.RenderDiagram("graph LR\nA --> B", diagram.NewTestConfig(true, "cli"))
+	if err != nil {
+		t.Fatalf("RenderDiagram error = %v", err)
+	}
+	withStatus, status, err := render.RenderDiagramWithStatus("graph LR\nA --> B", diagram.NewTestConfig(true, "cli"))
+	if err != nil {
+		t.Fatalf("RenderDiagramWithStatus error = %v", err)
+	}
+	if plain != withStatus {
+		t.Fatalf("RenderDiagram and RenderDiagramWithStatus disagree\n%q\n%q", plain, withStatus)
+	}
+	if status.Requested || status.Compacted {
+		t.Fatalf("width fitting must stay disabled without MaxWidth: %+v", status)
+	}
+
+	wide := diagram.NewTestConfig(true, "cli")
+	wide.MaxWidth = 1000
+	_, wideStatus, err := render.RenderDiagramWithStatus("graph LR\nA --> B", wide)
+	if err != nil {
+		t.Fatalf("RenderDiagramWithStatus error = %v", err)
+	}
+	if !wideStatus.Requested || wideStatus.Limit != 1000 || !wideStatus.Met {
+		t.Fatalf("width status = %+v, want a met 1000-column limit", wideStatus)
+	}
+	if wideStatus.Width <= 0 || wideStatus.Width > 1000 {
+		t.Fatalf("width status width = %d, want 0 < width <= 1000", wideStatus.Width)
+	}
+	if wideStatus.Compacted {
+		t.Fatalf("width status = %+v, want no compacting for a met limit", wideStatus)
+	}
+}
+
+// TestP2PLayoutAxisFromDeclaration pins that the axis comes from the Mermaid
+// declaration and that rendering does not honor Config.GraphDirection.
+func TestP2PLayoutAxisFromDeclaration(t *testing.T) {
+	renderWithDirection := func(declaration, direction string) string {
+		config := &diagram.Config{
+			UseAscii:         true,
+			BoxBorderPadding: 1,
+			PaddingBetweenX:  5,
+			PaddingBetweenY:  5,
+			GraphDirection:   direction,
+			StyleType:        "cli",
+		}
+		properties := parseP2PGraph(t, declaration)
+		properties.Apply(config)
+		return graph.Draw(properties)
+	}
+
+	horizontal := renderWithDirection("graph LR\nA --> B", "LR")
+	if got := renderWithDirection("graph LR\nA --> B", "TD"); got != horizontal {
+		t.Fatalf("Config.GraphDirection must not override a horizontal declaration\n%s", got)
+	}
+	vertical := renderWithDirection("graph TD\nA --> B", "TD")
+	if got := renderWithDirection("graph TD\nA --> B", "LR"); got != vertical {
+		t.Fatalf("Config.GraphDirection must not override a vertical declaration\n%s", got)
+	}
+	if horizontal == vertical {
+		t.Fatal("the declared axes must keep different layouts")
+	}
+
+	config := diagram.NewTestConfig(true, "cli")
+	config.GraphDirection = "TD"
+	fromRender, err := render.RenderDiagram("graph LR\nA --> B", config)
+	if err != nil {
+		t.Fatalf("RenderDiagram error = %v", err)
+	}
+	if fromRender != horizontal {
+		t.Fatalf("RenderDiagram must keep using the declared axis\n%s", fromRender)
+	}
+}
+
+// TestP2PPublicSurfaceObservableBehaviorPreserved pins defaults, rendered
+// output and error behavior through the public entry points.
+func TestP2PPublicSurfaceObservableBehaviorPreserved(t *testing.T) {
+	defaults := diagram.DefaultConfig()
+	if defaults.GraphDirection != "LR" || defaults.StyleType != "cli" || defaults.UseAscii {
+		t.Fatalf("DefaultConfig defaults changed: %+v", defaults)
+	}
+
+	fromDefaults, err := render.RenderDiagram("graph LR\nA --> B", defaults)
+	if err != nil {
+		t.Fatalf("RenderDiagram with defaults error = %v", err)
+	}
+	fromNil, err := render.RenderDiagram("graph LR\nA --> B", nil)
+	if err != nil {
+		t.Fatalf("RenderDiagram with a nil config error = %v", err)
+	}
+	if fromDefaults != fromNil {
+		t.Fatalf("a nil config must keep defaulting to DefaultConfig\n%q\n%q", fromDefaults, fromNil)
+	}
+	for _, node := range []string{"A", "B"} {
+		if !strings.Contains(fromDefaults, node) {
+			t.Fatalf("default rendering lost node %q\n%s", node, fromDefaults)
+		}
+	}
+	if !strings.Contains(fromDefaults, "─") || !strings.Contains(fromDefaults, "│") {
+		t.Fatalf("default rendering must keep using Unicode box drawing\n%s", fromDefaults)
+	}
+
+	if _, err := render.RenderDiagram("graph SIDEWAYS\nA --> B", defaults); err == nil || !strings.Contains(err.Error(), "unsupported graph direction") {
+		t.Fatalf("RenderDiagram error = %v, want the unsupported graph direction error", err)
+	}
+}
+
+// TestP2PPublicSurfaceContractStable pins the public signatures and the public
+// configuration error contract, including the exact public field type.
+func TestP2PPublicSurfaceContractStable(t *testing.T) {
+	field, ok := reflect.TypeOf(diagram.Config{}).FieldByName("GraphDirection")
+	if !ok || field.Type != reflect.TypeOf("") {
+		t.Fatalf("Config.GraphDirection must remain exactly string; field = %v, present = %v", field, ok)
+	}
+
+	var _ func(bool, string, string) (*diagram.Config, error) = diagram.NewConfig
+	var _ func(bool, bool, bool, int, int, int, string) (*diagram.Config, error) = diagram.NewCLIConfig
+	var _ func(bool, int, int, int) (*diagram.Config, error) = diagram.NewWebConfig
+	var _ func(bool, string) *diagram.Config = diagram.NewTestConfig
+	var _ func() *diagram.Config = diagram.DefaultConfig
+	var _ func(string, string) (*graph.Properties, error) = graph.Parse
+	var _ func(*graph.Properties) string = graph.Draw
+	var _ func(*graph.Properties, *diagram.Config) = (*graph.Properties).Apply
+	var _ func(string, *diagram.Config) (string, error) = render.RenderDiagram
+	var _ func(string, *diagram.Config) (string, render.WidthStatus, error) = render.RenderDiagramWithStatus
+
+	config := &diagram.Config{GraphDirection: "LR", StyleType: "cli", SequenceSelfMessageWidth: 4}
+	if err := config.Validate(); err != nil {
+		t.Fatalf("a public Config literal with GraphDirection = \"LR\" must validate: %v", err)
+	}
+	config.GraphDirection = "RL"
+	var configErr *diagram.ConfigError
+	if err := config.Validate(); !errors.As(err, &configErr) {
+		t.Fatalf("Validate() error = %v, want *diagram.ConfigError", err)
+	}
+	if got := configErr.Error(); got != `invalid config: GraphDirection = RL (must be "LR" or "TD")` {
+		t.Fatalf("ConfigError.Error() = %q", got)
+	}
+}
