+package f2p
+
+// The fail-to-pass checks in this file pin REQ-STRUCT-001, REQ-STRUCT-002 and
+// REQ-STRUCT-003 of the graph layout-direction refactor. They do not look for
+// a particular mechanism: the harness discovers the stored axis state at
+// runtime, type-checks pkg/graph with go/types, resolves the calls into the
+// axis carrier and follows where the carrier results are consumed. Each test
+// therefore asserts a concrete obligation:
+//
+//   - the stored axis state is a package-declared carrier instead of a raw
+//     direction string and normalizes LR/RL, TD/TB/BT and the default to the
+//     same axis value;
+//   - the Mermaid declaration vocabulary lives only in the Parse reachable
+//     mapping cone;
+//   - layout code never inspects the stored axis state except as the receiver
+//     of a carrier method;
+//   - every direction-dependent decision family (self-reference, route
+//     selection, grid stepping, coordinate growth, level/position extraction,
+//     parallel edge routing, boolean layout gates and the fan-out early
+//     return) is answered by an axis-dependent carrier method called from
+//     Draw-reachable layout code whose result is consumed there;
+//   - carrier role methods are not unused stubs.
+
+import (
+	"fmt"
+	"go/types"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+)
+
+func describeCarrierStates(states []observedDirectionState) string {
+	var parts []string
+	for _, state := range states {
+		parts = append(parts, fmt.Sprintf("Properties.%s (%s)", state.field, state.typ))
+	}
+	if len(parts) == 0 {
+		return "none"
+	}
+	return strings.Join(parts, ", ")
+}
+
+// carrierRolesFor loads the reflectively discovered carrier family together
+// with its type-checked role methods and the call target index used to follow
+// delegation between carrier methods.
+func carrierRolesFor(t *testing.T) (*graphPackage, []carrierRoleMethod, map[*types.Func]carrierRoleMethod) {
+	t.Helper()
+	names := carrierTypeNames(t)
+	g := loadGraphPackage(t)
+	methods, byTarget := g.carrierMethodIndex(names)
+	return g, carrierRoleMethods(methods), byTarget
+}
+
+// answeredSites keeps reachable layout and internal carrier call sites of carrier methods
+// matching the family whose outcome is axis-dependent and where the result is
+// used the way the family requires (returned/handed on, fed to the recursive
+// placement search, or deciding a layout condition).
+func answeredSites(g *graphPackage, roles []carrierRoleMethod, byTarget map[*types.Func]carrierRoleMethod, match func(*types.Signature) bool, used func(roleCallSiteEvidence) bool) []roleCallSiteEvidence {
+	var out []roleCallSiteEvidence
+	for _, evidence := range g.directCallEvidence(roles) {
+		if !match(evidence.method.sig) || !used(evidence) {
+			continue
+		}
+		if !g.axisDependent(evidence.method, byTarget, map[string]bool{}).ok {
+			continue
+		}
+		out = append(out, evidence)
+	}
+	return out
+}
+
+func describeAnsweredSites(sites []roleCallSiteEvidence) string {
+	if len(sites) == 0 {
+		return "none"
+	}
+	var parts []string
+	for _, site := range sites {
+		parts = append(parts, fmt.Sprintf("%s (%s)", site.method.label(), site.location))
+	}
+	return strings.Join(parts, "; ")
+}
+
+func allRoleEvidence(g *graphPackage, roles []carrierRoleMethod, byTarget map[*types.Func]carrierRoleMethod) (stubs, unengaged []string, engagedCount int) {
+	engaged, _ := g.engagementOf(roles, byTarget)
+	for _, method := range roles {
+		if !g.axisDependent(method, byTarget, map[string]bool{}).ok {
+			stubs = append(stubs, method.label())
+		}
+		if !engaged[method.label()] {
+			unengaged = append(unengaged, method.label())
+			continue
+		}
+		engagedCount++
+	}
+	sort.Strings(stubs)
+	sort.Strings(unengaged)
+	return stubs, unengaged, engagedCount
+}
+
+// TestStoredAxisStateIsCarrierTyped pins REQ-STRUCT-001: the parsed
+// declaration must be stored as a package-declared layout-direction carrier
+// instead of the previous raw direction string. The check parses the same
+// graph with the LR and the TD declaration and compares every top-level
+// field of the returned Properties, so no field name is assumed.
+func TestStoredAxisStateIsCarrierTyped(t *testing.T) {
+	states := axisStateFields(t)
+	var carriers, rawStrings []string
+	for _, state := range states {
+		if isPackageDeclaredType(state.typ) {
+			carriers = append(carriers, state.field)
+			continue
+		}
+		if underlyingKind(state.typ) == reflect.String {
+			rawStrings = append(rawStrings, fmt.Sprintf("%s (%s)", state.field, state.typ))
+		}
+	}
+	if len(carriers) == 0 {
+		t.Errorf("no field of graph.Properties that differs between the LR and the TD declaration is stored as a package-declared layout-direction carrier; differing fields: %s", describeCarrierStates(states))
+	}
+	if len(rawStrings) > 0 {
+		t.Errorf("the stored layout axis is still a raw string field: %s", strings.Join(rawStrings, ", "))
+	}
+}
+
+// TestCarrierTypeFlowsIntoLayoutState pins REQ-STRUCT-001 for the layout
+// side: every package struct field that shares its name with the axis state
+// discovered on Properties must be typed with the same package-declared
+// carrier, so the layout pipeline keeps working on the abstraction instead of
+// a second raw copy of the axis.
+func TestCarrierTypeFlowsIntoLayoutState(t *testing.T) {
+	states := axisStateFields(t)
+	g := loadGraphPackage(t)
+	carriers := map[string]bool{}
+	for _, name := range carrierTypeNames(t) {
+		carriers[name] = true
+	}
+	var offenders []string
+	checked := 0
+	for _, state := range states {
+		for _, field := range g.structFieldsNamed(state.field) {
+			checked++
+			if carriers[typeNameOf(field.typ)] {
+				continue
+			}
+			offenders = append(offenders, fmt.Sprintf("%s.%s is %s", field.structName, field.field, field.typ))
+		}
+	}
+	if checked == 0 {
+		t.Errorf("no package struct type declares a field named like the discovered axis state %s", describeCarrierStates(states))
+	}
+	if len(offenders) > 0 {
+		t.Errorf("the layout state keeps a non-carrier copy of the axis state: %s", strings.Join(offenders, ", "))
+	}
+}
+
+// TestTokenVocabularyConfinedToDeclarationMapping pins REQ-STRUCT-003: the
+// exact direction tokens may only occur inside Parse and the package-level
+// tables it references (the single mapping point). Any occurrence in the
+// layout code, in a helper or in another file is a second place that
+// reinterprets direction strings.
+func TestTokenVocabularyConfinedToDeclarationMapping(t *testing.T) {
+	g := loadGraphPackage(t)
+	offenders := g.tokenOccurrencesOutsideParseCone()
+	if len(offenders) > 0 {
+		var parts []string
+		for i, occurrence := range offenders {
+			if i == 12 {
+				parts = append(parts, fmt.Sprintf("... and %d more", len(offenders)-i))
+				break
+			}
+			parts = append(parts, occurrence.String())
+		}
+		t.Errorf("direction tokens are reinterpreted outside the Parse mapping cone (%d occurrences): %s", len(offenders), strings.Join(parts, "; "))
+	}
+}
+
+// TestAxisStateReadsGoThroughCarrierMethods pins REQ-STRUCT-001 for the
+// consumers: outside the declaration mapping cone every read of the stored
+// axis state must be the receiver of a carrier method call or a direct
+// carrier-to-carrier transfer. Comparisons, arithmetic or bare boolean reads
+// of the state mean the layout code still inspects the raw axis value itself.
+func TestAxisStateReadsGoThroughCarrierMethods(t *testing.T) {
+	g := loadGraphPackage(t)
+	fields := directionStateFieldNames(t)
+	if len(fields) == 0 {
+		t.Errorf("no stored field of graph.Properties differs between the LR and the TD declaration, so no layout axis is stored")
+	}
+	allowed := map[string]bool{"call-receiver": true, "state-transfer": true, "assignment-target": true, "nil-check": true}
+	cone := g.parseCone()
+	var offenders []string
+	for _, read := range g.stateReads(fields) {
+		if allowed[read.context] {
+			continue
+		}
+		if read.decl != nil && cone[read.decl] {
+			continue
+		}
+		offenders = append(offenders, fmt.Sprintf("%s:%d reads %s as %s", read.file, read.line, read.field, read.context))
+	}
+	if len(offenders) > 0 {
+		var parts []string
+		for i, offender := range offenders {
+			if i == 12 {
+				parts = append(parts, fmt.Sprintf("... and %d more", len(offenders)-i))
+				break
+			}
+			parts = append(parts, offender)
+		}
+		t.Errorf("layout code inspects the stored axis state directly instead of asking the carrier: %s", strings.Join(parts, "; "))
+	}
+}
+
+// TestSelfReferenceDirectionsAnsweredByCarrier pins REQ-STRUCT-002 for
+// self-referencing edges: the four start and end directions for a node that
+// links to itself must come from an axis-dependent carrier method that the
+// layout pipeline calls and whose result it consumes.
+func TestSelfReferenceDirectionsAnsweredByCarrier(t *testing.T) {
+	g, roles, byTarget := carrierRolesFor(t)
+	sites := answeredSites(g, roles, byTarget, isSelfReferenceRole, func(site roleCallSiteEvidence) bool {
+		return g.resultFlowsIntoCallArgumentOrReturn(site.site)
