@@ -0,0 +1,417 @@
+// Command p2prunner executes the frozen pass-to-pass selectors of the graph
+// layout-direction plan and writes a regular JUnit report.
+//
+// It is invoked from the repository root by test/p2p/run_p2p.sh and only uses
+// the Go toolchain that ships with the frozen environment image. Every
+// selector is executed with the real `go test` runner: selectors whose test no
+// longer compiles or is no longer collected are reported as errors instead of
+// silently disappearing from the report.
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// inventorySelectors lists every original baseline test collected for the
+// direction refactor. They are executed so that the report covers the frozen
+// original_inventory entries as well as the selected pass-to-pass nodes.
+var inventorySelectors = []string{
+	"pkg/graph/graph_test.go::TestASCII",
+	"pkg/graph/graph_test.go::TestExtendedChars",
+	"pkg/graph/graph_test.go::TestMultibyte",
+	"pkg/graph/graph_test.go::TestGraphUseAsciiConfig",
+	"pkg/graph/label_test.go::TestNewGraphLabel",
+	"pkg/graph/render_graph_test.go::TestRenderGraphHandlesLongChainWithoutPanic",
+	"pkg/graph/render_graph_test.go::TestRenderGraphKeepsDisplayWidthForWideNodeLabels",
+	"pkg/graph/render_graph_test.go::TestRenderGraphHandlesUnicodeClusterNodeLabels",
+	"pkg/graph/render_graph_test.go::TestRenderGraphKeepsDisplayWidthForWideSubgraphTitles",
+	"pkg/graph/render_graph_test.go::TestRenderGraphKeepsExplicitTargetLabelAfterBareReference",
+	"pkg/graph/render_graph_test.go::TestRenderGraphKeepsStandaloneSubgraphLabelWhenReferencedLater",
+	"pkg/graph/render_graph_test.go::TestRenderGraphSupportsLiteralNewlineInNodeLabel",
+	"pkg/graph/render_graph_test.go::TestRenderGraphSeparatesDuplicateEdgeLabels",
+	"pkg/graph/render_graph_test.go::TestRenderGraphSeparatesBidirectionalEdgeLabelsLR",
+	"pkg/graph/render_graph_test.go::TestRenderGraphSeparatesBidirectionalEdgeLabelsTD",
+	"pkg/graph/render_graph_test.go::TestRenderGraphAlignsFanoutLabels",
+	"pkg/render/frontmatter_test.go::TestRenderWithFrontmatter",
+	"pkg/render/frontmatter_test.go::TestRenderTitleAboveDiagram",
+	"pkg/render/integration_test.go::TestSequenceDiagramIntegration",
+	"pkg/render/integration_test.go::TestSequenceDiagramIntegration_ASCII",
+	"pkg/render/integration_test.go::TestSequenceDiagramIntegration_ErrorHandling",
+	"pkg/render/integration_test.go::TestDiagramFactoryIntegration",
+	"pkg/render/integration_test.go::TestRenderConfig_Defaults",
+	"pkg/render/max_width_test.go::TestGraphMaxWidthGolden",
+	"pkg/render/max_width_test.go::TestMaxWidthHandlesUnicodeClusterLabels",
+	"pkg/render/max_width_test.go::TestMaxWidthPreservesGraphContentAndDoesNotAffectSequence",
+	"pkg/diagram/config_test.go::TestConfigMaxWidthValidation",
+	"pkg/diagram/frontmatter_test.go::TestStripFrontmatter",
+	"pkg/diagram/testutil/testutil_test.go::TestReadTestCaseDecodesExpectedSpaceMarkers",
+	"cmd/root_test.go::TestResolveMaxWidth",
+}
+
+// supplementalSelectors lists the pass-to-pass tests added by the plan.
+var supplementalSelectors = []string{
+	"test/p2p/direction_regression_test.go::TestP2PRenderedOutputParityPerAxis",
+	"test/p2p/direction_regression_test.go::TestP2PDirectionDeclarationAxisMapping",
+	"test/p2p/direction_regression_test.go::TestP2PDirectionParseErrorCompatibility",
+	"test/p2p/direction_regression_test.go::TestP2PSelfReferencePerAxis",
+	"test/p2p/direction_regression_test.go::TestP2PBackwardsEdgePerAxis",
+	"test/p2p/direction_regression_test.go::TestP2PRepeatedEdgeParallelRoutingPerAxis",
+	"test/p2p/direction_regression_test.go::TestP2PFanoutAxisGating",
+	"test/p2p/direction_regression_test.go::TestP2PDeterministicOutputAndOrdering",
+	"test/p2p/direction_regression_test.go::TestP2PInvalidDeclarationErrorsWithoutPanic",
+	"test/p2p/direction_regression_test.go::TestP2PConfigDirectionValidation",
+	"test/p2p/direction_regression_test.go::TestP2PConstructorSignaturesAndDefaults",
+	"test/p2p/direction_regression_test.go::TestP2PParseApplyDrawEntryPoints",
+	"test/p2p/direction_regression_test.go::TestP2PRenderDiagramWidthStatusContract",
+	"test/p2p/direction_regression_test.go::TestP2PLayoutAxisFromDeclaration",
+	"test/p2p/direction_regression_test.go::TestP2PPublicSurfaceObservableBehaviorPreserved",
+	"test/p2p/direction_regression_test.go::TestP2PPublicSurfaceContractStable",
+}
+
+type selector struct {
+	raw    string
+	path   string
+	leaf   string
+	pkgDir string
+}
+
+var leafPattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+func parseSelector(raw string) (selector, error) {
+	index := strings.LastIndex(raw, "::")
+	if index <= 0 || index+2 >= len(raw) {
+		return selector{}, fmt.Errorf("selector %q is not a path::leaf selector", raw)
+	}
+	path := raw[:index]
+	leaf := raw[index+2:]
+	if !leafPattern.MatchString(leaf) {
+		return selector{}, fmt.Errorf("selector %q: leaf %q is not a plain test function name", raw, leaf)
+	}
+	pkgDir := path
+	if strings.HasSuffix(path, ".go") {
+		pkgDir = filepath.Dir(path)
+	}
+	if pkgDir == "" || pkgDir == "." || pkgDir == "/" {
+		return selector{}, fmt.Errorf("selector %q: cannot derive a package from %q", raw, path)
+	}
+	return selector{raw: raw, path: path, leaf: leaf, pkgDir: pkgDir}, nil
+}
+
+type testEvent struct {
+	Action  string  `json:"Action"`
+	Package string  `json:"Package"`
+	Test    string  `json:"Test"`
+	Elapsed float64 `json:"Elapsed"`
+	Output  string  `json:"Output"`
+}
+
+type testResult struct {
+	status   string
+	elapsed  float64
+	output   string
+	missing  string
+	observed bool
+}
+
+func findRepoRoot(start string) (string, error) {
+	current, err := filepath.Abs(start)
+	if err != nil {
+		return "", err
+	}
+	for {
+		if _, statErr := os.Stat(filepath.Join(current, "go.mod")); statErr == nil {
+			return current, nil
+		}
+		parent := filepath.Dir(current)
+		if parent == current {
+			return "", fmt.Errorf("cannot find go.mod above %s", start)
+		}
+		current = parent
+	}
+}
+
+func runSelectorGroup(root, pkgDir string, group []selector, timeout time.Duration) map[string]*testResult {
+	results := make(map[string]*testResult, len(group))
+	for _, item := range group {
+		results[item.leaf] = &testResult{status: "missing"}
+	}
+
+	names := make([]string, 0, len(group))
+	for _, item := range group {
+		names = append(names, regexp.QuoteMeta(item.leaf))
+	}
+	args := []string{
+		"test",
+		"-count=1",
+		"-json",
+		"-timeout", timeout.String(),
+		"-run", "^(" + strings.Join(names, "|") + ")$",
+		"./" + pkgDir,
+	}
+	command := exec.Command("go", args...)
+	command.Dir = root
+	command.Env = append(os.Environ(), "GOPROXY=off")
+
+	var stdout, stderr bytes.Buffer
+	command.Stdout = &stdout
+	command.Stderr = &stderr
+	runErr := command.Run()
+
+	pkgOutput := &strings.Builder{}
+	decoder := json.NewDecoder(bytes.NewReader(stdout.Bytes()))
+	for {
+		var event testEvent
+		if err := decoder.Decode(&event); err != nil {
+			break
+		}
+		if event.Test == "" {
+			if event.Output != "" {
+				pkgOutput.WriteString(event.Output)
+			}
+			continue
+		}
+		for _, item := range group {
+			if event.Test != item.leaf && !strings.HasPrefix(event.Test, item.leaf+"/") {
+				continue
+			}
+			result := results[item.leaf]
+			switch event.Action {
+			case "output":
+				result.output += event.Output
+			case "pass":
+				if event.Test == item.leaf {
+					result.status = "pass"
+					result.elapsed = event.Elapsed
+				}
+			case "fail":
+				if event.Test == item.leaf {
+					result.status = "fail"
+					result.elapsed = event.Elapsed
+				}
+			case "skip":
+				if event.Test == item.leaf {
+					result.status = "skip"
+					result.elapsed = event.Elapsed
+				}
+			}
+			break
+		}
+	}
+
+	detail := strings.TrimSpace(pkgOutput.String())
+	if detail == "" {
+		detail = strings.TrimSpace(stderr.String())
+	}
+	if runErr != nil {
+		for _, item := range group {
+			if results[item.leaf].status == "missing" {
+				results[item.leaf].missing = fmt.Sprintf("go test ./%s did not collect or complete %s: %v\n%s", pkgDir, item.leaf, runErr, detail)
+			}
+		}
+	}
+	return results
+}
+
+type junitProperty struct {
+	Name  string `xml:"name,attr"`
+	Value string `xml:"value,attr"`
+}
+
+type junitProperties struct {
+	Items []junitProperty `xml:"property"`
+}
+
+type junitFailure struct {
+	Message string `xml:"message,attr"`
+	Text    string `xml:",chardata"`
+}
+
+type junitError struct {
+	Message string `xml:"message,attr"`
+	Text    string `xml:",chardata"`
+}
+
+type junitSkipped struct{}
+
+type junitTestCase struct {
+	Name       string           `xml:"name,attr"`
+	Classname  string           `xml:"classname,attr"`
+	File       string           `xml:"file,attr,omitempty"`
+	Time       float64          `xml:"time,attr"`
+	Properties *junitProperties `xml:"properties,omitempty"`
+	Failure    *junitFailure    `xml:"failure,omitempty"`
+	Error      *junitError      `xml:"error,omitempty"`
+	Skipped    *junitSkipped    `xml:"skipped,omitempty"`
+}
+
+type junitTestSuite struct {
+	XMLName  xml.Name        `xml:"testsuite"`
+	Name     string          `xml:"name,attr"`
+	Package  string          `xml:"package,attr,omitempty"`
+	Tests    int             `xml:"tests,attr"`
+	Failures int             `xml:"failures,attr"`
+	Errors   int             `xml:"errors,attr"`
+	Skipped  int             `xml:"skipped,attr"`
+	Time     float64         `xml:"time,attr"`
+	Cases    []junitTestCase `xml:"testcase"`
+}
+
+type junitTestSuites struct {
+	XMLName  xml.Name         `xml:"testsuites"`
+	Name     string           `xml:"name,attr"`
+	Tests    int              `xml:"tests,attr"`
+	Failures int              `xml:"failures,attr"`
+	Errors   int              `xml:"errors,attr"`
+	Skipped  int              `xml:"skipped,attr"`
+	Time     float64          `xml:"time,attr"`
+	Suites   []junitTestSuite `xml:"testsuite"`
+}
+
+func main() {
+	reportPath := flag.String("report", "", "path of the JUnit report to write")
+	perPackageTimeout := flag.Duration("package-timeout", 90*time.Second, "timeout passed to each go test invocation")
+	flag.Parse()
+
+	if strings.TrimSpace(*reportPath) == "" {
+		fmt.Fprintln(os.Stderr, "p2prunner: -report is required")
+		os.Exit(2)
+	}
+
+	workingDir, err := os.Getwd()
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "p2prunner: %v\n", err)
+		os.Exit(2)
+	}
+	root, err := findRepoRoot(workingDir)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "p2prunner: %v\n", err)
+		os.Exit(2)
+	}
+
+	var selectors []selector
+	for _, raw := range append(append([]string{}, inventorySelectors...), supplementalSelectors...) {
+		item, parseErr := parseSelector(raw)
+		if parseErr != nil {
+			fmt.Fprintf(os.Stderr, "p2prunner: %v\n", parseErr)
+			os.Exit(2)
+		}
+		selectors = append(selectors, item)
+	}
+
+	groups := map[string][]selector{}
+	var groupOrder []string
+	for _, item := range selectors {
+		if _, seen := groups[item.pkgDir]; !seen {
+			groupOrder = append(groupOrder, item.pkgDir)
+		}
+		groups[item.pkgDir] = append(groups[item.pkgDir], item)
+	}
+
+	allResults := map[string]*testResult{}
+	started := time.Now()
+	for _, pkgDir := range groupOrder {
+		groupResults := runSelectorGroup(root, pkgDir, groups[pkgDir], *perPackageTimeout)
+		for leaf, result := range groupResults {
+			allResults[pkgDir+"::"+leaf] = result
+		}
+	}
+
+	suiteByPath := map[string]*junitTestSuite{}
+	var suiteOrder []string
+	for _, item := range selectors {
+		result := allResults[item.pkgDir+"::"+item.leaf]
+		if result == nil {
+			result = &testResult{status: "missing", missing: "selector was not executed"}
+		}
+		suite, seen := suiteByPath[item.path]
+		if !seen {
+			suite = &junitTestSuite{Name: item.path, Package: item.pkgDir}
+			suiteByPath[item.path] = suite
+			suiteOrder = append(suiteOrder, item.path)
+		}
+		testCase := junitTestCase{
+			Name:      item.leaf,
+			Classname: item.path,
+			File:      item.path,
+			Time:      result.elapsed,
+			Properties: &junitProperties{Items: []junitProperty{
+				{Name: "selector", Value: item.raw},
+			}},
+		}
+		switch result.status {
+		case "pass":
+		case "skip":
+			testCase.Skipped = &junitSkipped{}
+			suite.Skipped++
+		case "fail":
+			message := fmt.Sprintf("%s failed", item.raw)
+			testCase.Failure = &junitFailure{Message: message, Text: strings.TrimSpace(result.output)}
+			suite.Failures++
+		default:
+			message := result.missing
+			if message == "" {
+				message = fmt.Sprintf("%s was not collected by go test", item.raw)
+			}
+			testCase.Error = &junitError{Message: message, Text: strings.TrimSpace(result.output)}
+			suite.Errors++
+		}
+		suite.Cases = append(suite.Cases, testCase)
+		suite.Tests++
+		suite.Time += result.elapsed
+	}
+
+	report := junitTestSuites{Name: "p2p"}
+	totalTime := time.Since(started).Seconds()
+	for _, path := range suiteOrder {
+		suite := suiteByPath[path]
+		report.Suites = append(report.Suites, *suite)
+		report.Tests += suite.Tests
+		report.Failures += suite.Failures
+		report.Errors += suite.Errors
+		report.Skipped += suite.Skipped
+	}
+	report.Time = totalTime
+
+	payload, err := xml.MarshalIndent(report, "", "  ")
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "p2prunner: cannot encode JUnit report: %v\n", err)
+		os.Exit(2)
+	}
+	payload = append([]byte(xml.Header), payload...)
+	payload = append(payload, '\n')
+	if dir := filepath.Dir(*reportPath); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			fmt.Fprintf(os.Stderr, "p2prunner: cannot create report directory: %v\n", err)
+			os.Exit(2)
+		}
+	}
+	if err := os.WriteFile(*reportPath, payload, 0o644); err != nil {
+		fmt.Fprintf(os.Stderr, "p2prunner: cannot write report: %v\n", err)
+		os.Exit(2)
+	}
+
+	exitCode := 0
+	for _, item := range selectors {
+		result := allResults[item.pkgDir+"::"+item.leaf]
+		status := "missing"
+		if result != nil {
+			status = result.status
+		}
+		fmt.Printf("%-5s %s\n", strings.ToUpper(status), item.raw)
+		if status != "pass" {
+			exitCode = 1
+		}
+	}
+	fmt.Printf("p2prunner: %d selectors, %d failures, %d errors, report %s\n", report.Tests, report.Failures, report.Errors, *reportPath)
+	os.Exit(exitCode)
+}
diff --git a/test/p2p/run_p2p.sh b/test/p2p/run_p2p.sh
new file mode 100644
index 0000000000000000000000000000000000000000..dcd6ef8fd283a4257a93cc76d726e4689ed0f78c
--- /dev/null
+++ b/test/p2p/run_p2p.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# Runs the frozen pass-to-pass selection of the graph layout-direction plan and
+# writes a regular JUnit report at the path given as the first argument.
+#
+# The runner only uses repository files and tools from the frozen environment
+# image: no installs, downloads or registry access happen here.
+set -euo pipefail
+
+report="${1:-}"
+if [ -z "$report" ]; then
+  echo "usage: run_p2p.sh <junit-report-path>" >&2
+  exit 2
+fi
+
+script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+repo_root="$(cd "$script_dir/../.." && pwd)"
+
+case "$report" in
+  /*) ;;
+  *) report="$PWD/$report" ;;
+esac
+
+cd "$repo_root"
+exec go run ./test/p2p/p2prunner -report "$report"
