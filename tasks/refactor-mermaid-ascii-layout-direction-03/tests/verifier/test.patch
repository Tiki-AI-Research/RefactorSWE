+package f2p
+
+// This harness supplies the evidence machinery for the layout-direction
+// abstraction checks. It works on two levels:
+//
+//  1. Runtime observation: Parse the same graph with different Mermaid
+//     direction declarations and reflectively locate the stored direction
+//     state. This identifies the state and its declared type without any
+//     naming heuristic.
+//  2. Type-checked static analysis: load the non-test sources of pkg/graph
+//     with go/types, resolve every call to a concrete declaration, build the
+//     call graph and follow value flow through local assignments. That lets
+//     the checks state which method computes a decision and where its result
+//     is consumed, instead of only asserting that some literal is absent.
+//
+// The supported analysis includes a value type, a
+// struct or an interface with per-axis implementations all satisfy the
+// checks when source value flow can establish that the stored state has methods that
+// answer the axis-dependent questions and the layout code consumes them.
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/importer"
+	"go/parser"
+	"go/token"
+	"go/types"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/AlexanderGrooff/mermaid-ascii/pkg/graph"
+)
+
+// ---------------------------------------------------------------------------
+// runtime observation of the stored direction state
+// ---------------------------------------------------------------------------
+
+var directionProbeInputs = []struct {
+	label   string
+	mermaid string
+}{
+	{"LR", "graph LR\nA --> B"},
+	{"RL", "graph RL\nA --> B"},
+	{"TD", "graph TD\nA --> B"},
+	{"TB", "graph TB\nA --> B"},
+	{"BT", "graph BT\nA --> B"},
+	{"default", "graph\nA --> B"},
+}
+
+type observedDirectionState struct {
+	field string
+	typ   reflect.Type
+}
+
+var (
+	directionStateOnce sync.Once
+	directionStates    []observedDirectionState
+	directionStateRepr map[string]map[string]string
+	directionStateErr  error
+)
+
+func graphPackagePath() string {
+	return reflect.TypeOf(graph.Properties{}).PkgPath()
+}
+
+func isPackageDeclaredType(t reflect.Type) bool {
+	for t != nil && t.Kind() == reflect.Pointer {
+		t = t.Elem()
+	}
+	return t != nil && t.Name() != "" && t.PkgPath() == graphPackagePath()
+}
+
+func underlyingKind(t reflect.Type) reflect.Kind {
+	for t != nil && t.Kind() == reflect.Pointer {
+		t = t.Elem()
+	}
+	if t == nil {
+		return reflect.Invalid
+	}
+	return t.Kind()
+}
+
+// observeDirectionState parses the probe inputs and reports the Properties
+// fields whose stored value differs between the horizontal and the vertical
+// axis, together with the rendered value of every probe for every such field.
+func observeDirectionState(t *testing.T) ([]observedDirectionState, map[string]map[string]string) {
+	t.Helper()
+	directionStateOnce.Do(func() {
+		directionStateRepr = map[string]map[string]string{}
+		type fieldType struct {
+			typ reflect.Type
+		}
+		fieldTypes := map[string]fieldType{}
+		for _, probe := range directionProbeInputs {
+			props, err := graph.Parse(probe.mermaid, "cli")
+			if err != nil {
+				directionStateErr = fmt.Errorf("Parse(%q) failed: %v", probe.mermaid, err)
+				return
+			}
+			value := reflect.ValueOf(props).Elem()
+			reprs := map[string]string{}
+			for i := 0; i < value.NumField(); i++ {
+				field := value.Type().Field(i)
+				reprs[field.Name] = valueRepr(value.Field(i), 0)
+				if _, ok := fieldTypes[field.Name]; !ok {
+					fieldTypes[field.Name] = fieldType{typ: field.Type}
+				}
+			}
+			directionStateRepr[probe.label] = reprs
+		}
+		horizontal := directionStateRepr["LR"]
+		vertical := directionStateRepr["TD"]
+		for _, field := range sortedKeys(horizontal) {
+			if horizontal[field] == vertical[field] {
+				continue
+			}
+			directionStates = append(directionStates, observedDirectionState{field: field, typ: fieldTypes[field].typ})
+		}
+	})
+	if directionStateErr != nil {
+		t.Fatalf("cannot observe the stored direction state: %v", directionStateErr)
+	}
+	if len(directionStates) == 0 {
+		t.Fatalf("no field of graph.Properties stores a value that differs between the LR and the TD declaration")
+	}
+	return directionStates, directionStateRepr
+}
+
+// isTokenRepr reports whether a rendered field value is exactly one of the
+// Mermaid direction tokens as a quoted string.
+func isTokenRepr(repr string) bool {
+	if len(repr) < 2 || !strings.HasPrefix(repr, `"`) || !strings.HasSuffix(repr, `"`) {
+		return false
+	}
+	return directionTokens[strings.ToUpper(strings.Trim(repr, `"`))]
+}
+
+// axisStateFields keeps the differing fields that really carry the layout
+// axis: a package-declared carrier type, or (for the unfixed baseline) a
+// field whose value is a raw direction-token string. Fields whose rendered
+// value differs for unrelated reasons (for example map iteration order in the
+// parsed data structures) are ignored.
+func axisStateFields(t *testing.T) []observedDirectionState {
+	t.Helper()
+	states, reprs := observeDirectionState(t)
+	var out []observedDirectionState
+	for _, state := range states {
+		if isPackageDeclaredType(state.typ) {
+			out = append(out, state)
+			continue
+		}
+		if isTokenRepr(reprs["LR"][state.field]) || isTokenRepr(reprs["TD"][state.field]) {
+			out = append(out, state)
+		}
+	}
+	return out
+}
+
+// directionStateFieldNames returns the names of the storage fields that carry
+// the layout axis.
+func directionStateFieldNames(t *testing.T) map[string]bool {
+	names := map[string]bool{}
+	for _, state := range axisStateFields(t) {
+		names[state.field] = true
+	}
+	return names
+}
+
+// carrierTypeNames returns the package-declared type names of the stored
+// direction state. Interface-typed state also contributes the dynamic
+// implementation types observed for both axes.
+func carrierTypeNames(t *testing.T) []string {
+	states, reprs := observeDirectionState(t)
+	names := map[string]bool{}
+	for _, state := range states {
+		if isPackageDeclaredType(state.typ) {
+			names[baseReflectName(state.typ)] = true
+		}
+		if state.typ.Kind() != reflect.Interface {
+			continue
+		}
+		for _, label := range []string{"LR", "RL", "TD", "TB", "BT", "default"} {
+			props, err := graph.Parse(probeMermaid(label), "cli")
+			if err != nil {
+				continue
+			}
+			value := reflect.ValueOf(props).Elem().FieldByName(state.field)
+			if value.Kind() != reflect.Interface || value.IsNil() {
+				continue
+			}
+			if dynamic := value.Elem().Type(); isPackageDeclaredType(dynamic) {
+				names[baseReflectName(dynamic)] = true
+			}
+		}
+		_ = reprs
+	}
+	out := make([]string, 0, len(names))
+	for name := range names {
+		out = append(out, name)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func probeMermaid(label string) string {
+	for _, probe := range directionProbeInputs {
+		if probe.label == label {
+			return probe.mermaid
+		}
+	}
+	return directionProbeInputs[0].mermaid
+}
+
+func sortedKeys(m map[string]string) []string {
+	out := make([]string, 0, len(m))
+	for key := range m {
+		out = append(out, key)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// valueRepr renders a reflect.Value without ever calling Interface(), which
+// would panic for unexported fields such as the ones this harness inspects.
+func valueRepr(v reflect.Value, depth int) string {
+	if !v.IsValid() {
+		return "<invalid>"
+	}
+	if depth > 4 {
+		return v.Type().String() + "{...}"
+	}
+	switch v.Kind() {
+	case reflect.Interface:
+		if v.IsNil() {
+			return v.Type().String() + "(nil)"
+		}
+		return v.Type().String() + "(" + valueRepr(v.Elem(), depth+1) + ")"
+	case reflect.Pointer:
+		if v.IsNil() {
+			return v.Type().String() + "(nil)"
+		}
+		return v.Type().String() + "(" + valueRepr(v.Elem(), depth+1) + ")"
+	case reflect.Struct:
+		if v.Type().NumField() == 0 {
+			return v.Type().String() + "{}"
+		}
+		var parts []string
+		for i := 0; i < v.Type().NumField(); i++ {
+			field := v.Type().Field(i)
+			parts = append(parts, field.Name+":"+valueRepr(v.Field(i), depth+1))
+		}
+		return v.Type().String() + "{" + strings.Join(parts, ",") + "}"
+	case reflect.Bool:
+		return strconv.FormatBool(v.Bool())
+	case reflect.String:
+		return strconv.Quote(v.String())
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return strconv.FormatInt(v.Int(), 10)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return strconv.FormatUint(v.Uint(), 10)
+	case reflect.Float32, reflect.Float64:
+		return strconv.FormatFloat(v.Float(), 'g', -1, 64)
+	case reflect.Slice, reflect.Array:
+		if v.Kind() == reflect.Slice && v.IsNil() {
+			return v.Type().String() + "(nil)"
+		}
+		var parts []string
+		for i := 0; i < v.Len() && i < 8; i++ {
+			parts = append(parts, valueRepr(v.Index(i), depth+1))
+		}
+		return v.Type().String() + "[" + strings.Join(parts, ",") + "]"
+	case reflect.Map:
+		if v.IsNil() {
+			return v.Type().String() + "(nil)"
+		}
+		keys := v.MapKeys()
+		var parts []string
+		for i, key := range keys {
+			if i >= 8 {
+				break
+			}
+			parts = append(parts, valueRepr(key, depth+1)+":"+valueRepr(v.MapIndex(key), depth+1))
+		}
+		sort.Strings(parts)
+		return v.Type().String() + "{" + strings.Join(parts, ",") + "}"
+	default:
+		return v.Type().String()
+	}
+}
+
+// ---------------------------------------------------------------------------
+// type-checked static analysis of pkg/graph
+// ---------------------------------------------------------------------------
+
+type analysisCall struct {
+	caller     *ast.FuncDecl
+	call       *ast.CallExpr
+	callee     *types.Func
+	calleeDecl *ast.FuncDecl
+}
+
+type graphPackage struct {
+	fset         *token.FileSet
+	pkg          *types.Package
+	info         *types.Info
+	files        []*ast.File
+	fileOf       map[*ast.File]string
+	decls        []*ast.FuncDecl
+	declOfFunc   map[*types.Func]*ast.FuncDecl
+	funcOfDecl   map[*ast.FuncDecl]*types.Func
+	callsByDecl  map[*ast.FuncDecl][]analysisCall
+	allCalls     []analysisCall
+	parents      map[ast.Node]ast.Node
+	namedTypes   map[string]*types.Named
+	structFields map[string]map[string]types.Type
+	loaded       bool
+}
+
+var (
+	graphPackageOnce sync.Once
+	graphPackageVal  *graphPackage
+	graphPackageErr  error
+)
+
+func loadGraphPackage(t *testing.T) *graphPackage {
+	t.Helper()
+	graphPackageOnce.Do(func() {
+		graphPackageVal, graphPackageErr = buildGraphPackage()
+	})
+	if graphPackageErr != nil {
+		panic(fmt.Sprintf("source analysis infrastructure error: %v", graphPackageErr))
+	}
+	return graphPackageVal
+}
+
+func buildGraphPackage() (*graphPackage, error) {
+	root, err := repositoryRoot()
+	if err != nil {
+		return nil, err
+	}
+	dir := filepath.Join(root, "pkg", "graph")
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, err
+	}
+	g := &graphPackage{
+		fset:         token.NewFileSet(),
+		fileOf:       map[*ast.File]string{},
+		declOfFunc:   map[*types.Func]*ast.FuncDecl{},
+		funcOfDecl:   map[*ast.FuncDecl]*types.Func{},
+		callsByDecl:  map[*ast.FuncDecl][]analysisCall{},
+		parents:      map[ast.Node]ast.Node{},
+		namedTypes:   map[string]*types.Named{},
+		structFields: map[string]map[string]types.Type{},
+	}
+	var names []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		abs := filepath.Join(dir, name)
+		parsed, parseErr := parser.ParseFile(g.fset, abs, nil, parser.ParseComments|parser.AllErrors)
+		if parseErr != nil {
+			return nil, fmt.Errorf("parse %s: %w", abs, parseErr)
+		}
+		g.files = append(g.files, parsed)
+		g.fileOf[parsed] = "pkg/graph/" + name
+	}
+	g.info = &types.Info{
+		Types:      map[ast.Expr]types.TypeAndValue{},
+		Defs:       map[*ast.Ident]types.Object{},
+		Uses:       map[*ast.Ident]types.Object{},
+		Selections: map[*ast.SelectorExpr]*types.Selection{},
+		Scopes:     map[ast.Node]*types.Scope{},
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "go", "list", "-mod=readonly", "-export", "-deps", "-json", ".")
+	cmd.Dir = dir
+	data, err := cmd.Output()
+	if err != nil {
+		return nil, fmt.Errorf("go list export data: %w", err)
+	}
+	exports := map[string]string{}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	for {
+		var row struct{ ImportPath, Export string }
+		err = dec.Decode(&row)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return nil, err
+		}
+		exports[row.ImportPath] = row.Export
+	}
+	imp := importer.ForCompiler(g.fset, "gc", func(path string) (io.ReadCloser, error) {
+		if exports[path] == "" {
+			return nil, fmt.Errorf("missing compiler export for %s", path)
+		}
+		return os.Open(exports[path])
+	})
+	conf := types.Config{Importer: imp}
+	pkg, err := conf.Check("github.com/AlexanderGrooff/mermaid-ascii/pkg/graph", g.fset, g.files, g.info)
+	if err != nil {
+		return nil, fmt.Errorf("source type check: %w", err)
+	}
+	g.pkg = pkg
+
+	for _, file := range g.files {
+		ast.Inspect(file, func(node ast.Node) bool {
+			if node != nil && node != file {
+				// parent map is filled by the explicit walk below
+			}
+			return true
+		})
+		for _, decl := range file.Decls {
+			if fn, ok := decl.(*ast.FuncDecl); ok {
+				g.decls = append(g.decls, fn)
+			}
+		}
+		g.buildParents(file)
+	}
+	for _, scope := range []*types.Scope{g.pkg.Scope()} {
+		for _, name := range scope.Names() {
+			obj := scope.Lookup(name)
+			named, ok := obj.Type().(*types.Named)
+			if !ok {
+				continue
+			}
+			g.namedTypes[name] = named
+			if structType, ok := named.Underlying().(*types.Struct); ok {
+				fields := map[string]types.Type{}
+				for i := 0; i < structType.NumFields(); i++ {
+					fields[structType.Field(i).Name()] = structType.Field(i).Type()
+				}
+				g.structFields[name] = fields
+			}
+		}
+	}
+	for _, decl := range g.decls {
+		if obj, ok := g.info.Defs[decl.Name].(*types.Func); ok {
+			g.funcOfDecl[decl] = obj
+			g.declOfFunc[obj] = decl
+		}
+	}
+	for _, decl := range g.decls {
+		g.collectCalls(decl)
+	}
+	return g, nil
+}
+
+func (g *graphPackage) buildParents(root ast.Node) {
+	var stack []ast.Node
+	ast.Inspect(root, func(node ast.Node) bool {
+		if node == nil {
+			if len(stack) > 0 {
+				stack = stack[:len(stack)-1]
+			}
+			return true
+		}
+		if len(stack) > 0 {
+			g.parents[node] = stack[len(stack)-1]
+		}
+		stack = append(stack, node)
+		return true
+	})
+}
+
+func (g *graphPackage) collectCalls(decl *ast.FuncDecl) {
+	if decl.Body == nil {
+		return
+	}
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		switch typed := node.(type) {
+		case *ast.FuncLit:
+			// Attribute calls inside closures to the enclosing declaration.
+			return true
+		case *ast.CallExpr:
+			callee := g.resolveCallee(typed)
+			call := analysisCall{caller: decl, call: typed, callee: callee}
+			if callee != nil {
+				call.calleeDecl = g.declOfFunc[callee]
+			}
+			g.callsByDecl[decl] = append(g.callsByDecl[decl], call)
+			g.allCalls = append(g.allCalls, call)
+		}
+		return true
+	})
+}
+
+func (g *graphPackage) resolveCallee(call *ast.CallExpr) *types.Func {
+	switch fun := call.Fun.(type) {
+	case *ast.Ident:
+		if obj, ok := g.info.Uses[fun].(*types.Func); ok {
+			return obj
+		}
+	case *ast.SelectorExpr:
+		if selection, ok := g.info.Selections[fun]; ok {
+			if obj, ok := selection.Obj().(*types.Func); ok {
+				return obj
+			}
+		}
+		if obj, ok := g.info.Uses[fun.Sel].(*types.Func); ok {
+			return obj
+		}
+	}
+	return nil
+}
+
+func (g *graphPackage) fileOfNode(node ast.Node) string {
+	for node != nil {
+		if file, ok := node.(*ast.File); ok {
+			return g.fileOf[file]
+		}
+		node = g.parents[node]
+	}
+	return "<unknown>"
+}
+
+func (g *graphPackage) declsNamed(name string) []*ast.FuncDecl {
+	var out []*ast.FuncDecl
+	for _, decl := range g.decls {
+		if decl.Name.Name == name {
+			out = append(out, decl)
+		}
+	}
+	return out
+}
+
+func (g *graphPackage) reachableFrom(roots []*ast.FuncDecl) map[*ast.FuncDecl]bool {
+	seen := map[*ast.FuncDecl]bool{}
+	var queue []*ast.FuncDecl
+	for _, root := range roots {
+		if root != nil && !seen[root] {
+			seen[root] = true
+			queue = append(queue, root)
+		}
+	}
+	for len(queue) > 0 {
+		decl := queue[0]
+		queue = queue[1:]
+		for _, call := range g.callsByDecl[decl] {
+			if call.calleeDecl != nil && !seen[call.calleeDecl] {
+				seen[call.calleeDecl] = true
+				queue = append(queue, call.calleeDecl)
+			}
+		}
+	}
+	return seen
+}
+
+// parseCone is the declaration-parsing cone: Parse and every function it can
+// reach. It is where the Mermaid declaration vocabulary is allowed to live.
+func (g *graphPackage) parseCone() map[*ast.FuncDecl]bool {
+	return g.reachableFrom(g.declsNamed("Parse"))
+}
+
+// layoutCone is the rendering cone: Draw and every function it can reach.
+func (g *graphPackage) layoutCone() map[*ast.FuncDecl]bool {
+	return g.reachableFrom(g.declsNamed("Draw"))
+}
+
+// ---------------------------------------------------------------------------
+// token vocabulary occurrences
+// ---------------------------------------------------------------------------
+
+type tokenOccurrence struct {
+	file string
+	line int
+	tok  string
+	decl *ast.FuncDecl
+	spec *ast.ValueSpec
+}
+
+func (o tokenOccurrence) String() string {
+	where := "package scope"
+	if o.decl != nil {
+		where = "func " + o.decl.Name.Name
+	}
+	return fmt.Sprintf("%s:%d (%q in %s)", o.file, o.line, o.tok, where)
+}
+
+// tokenOccurrencesOutsideParseCone returns every occurrence of an exact
+// Mermaid direction token (literal or string constant reference) that is not
+// inside the declaration-parsing cone and not inside a package-level
+// var/const initializer that the parsing cone references. Those occurrences
+// are the places where a component other than the single mapping point
+// reinterprets direction strings.
+func (g *graphPackage) tokenOccurrencesOutsideParseCone() []tokenOccurrence {
+	cone := g.parseCone()
+	allowedObjects := g.parseConeReferencedObjects(cone)
+	var out []tokenOccurrence
+	record := func(node ast.Node, tok string) {
+		pos := g.fset.Position(node.Pos())
+		occ := tokenOccurrence{file: g.fileOfNode(node), line: pos.Line, tok: tok}
+		switch enclosing := g.enclosingFunc(node); {
+		case enclosing != nil:
+			occ.decl = enclosing
+			if cone[enclosing] || g.tokenIsRepresentation(node, enclosing) {
+				return
+			}
+		default:
+			spec := g.enclosingValueSpec(node)
+			occ.spec = spec
+			if spec != nil && allowedObjects[g.specObject(spec)] {
+				return
+			}
+		}
+		out = append(out, occ)
+	}
+	for _, file := range g.files {
+		var currentSpec *ast.ValueSpec
+		ast.Inspect(file, func(node ast.Node) bool {
+			switch typed := node.(type) {
+			case *ast.GenDecl:
+				if typed.Tok != token.VAR && typed.Tok != token.CONST {
+					return true
+				}
+				for _, spec := range typed.Specs {
+					valueSpec, ok := spec.(*ast.ValueSpec)
+					if !ok {
+						continue
+					}
+					currentSpec = valueSpec
+					for _, value := range valueSpec.Values {
+						collectTokenLiterals(value, record)
+					}
+					for _, value := range valueSpec.Values {
+						collectTokenConstantRefs(g, value, record)
+					}
+					currentSpec = nil
+				}
+				return true
+			case *ast.FuncDecl:
+				if typed.Body == nil {
+					return true
+				}
+				ast.Inspect(typed.Body, func(inner ast.Node) bool {
+					if lit, ok := inner.(*ast.BasicLit); ok {
+						if tok, ok := tokenLiteral(lit); ok {
+							record(lit, tok)
+						}
+						return true
+					}
+					if ident, ok := inner.(*ast.Ident); ok {
+						if tok, ok := g.tokenConstantValue(ident); ok {
+							record(ident, tok)
+						}
+						return true
+					}
+					if expr, ok := inner.(ast.Expr); ok {
+						if tok, ok := g.tokenConstantExpr(expr); ok {
+							record(expr, tok)
+						}
+					}
+					return true
+				})
+				return false
+			}
+			_ = currentSpec
+			return true
+		})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].file != out[j].file {
+			return out[i].file < out[j].file
+		}
+		return out[i].line < out[j].line
+	})
+	return out
+}
+
+func collectTokenLiterals(node ast.Node, record func(ast.Node, string)) {
+	ast.Inspect(node, func(inner ast.Node) bool {
+		if lit, ok := inner.(*ast.BasicLit); ok {
+			if tok, ok := tokenLiteral(lit); ok {
+				record(lit, tok)
+			}
+		}
+		return true
+	})
+}
+
+func collectTokenConstantRefs(g *graphPackage, node ast.Node, record func(ast.Node, string)) {
+	ast.Inspect(node, func(inner ast.Node) bool {
+		if ident, ok := inner.(*ast.Ident); ok {
+			if tok, ok := g.tokenConstantValue(ident); ok {
+				record(ident, tok)
+			}
+		}
+		return true
+	})
+}
+
+func (g *graphPackage) tokenConstantValue(ident *ast.Ident) (string, bool) {
+	obj, ok := g.info.Uses[ident].(*types.Const)
+	if !ok {
+		return "", false
+	}
+	value := strings.ToUpper(strings.Trim(obj.Val().String(), `"`))
+	if directionTokens[value] {
+		return value, true
+	}
+	return "", false
+}
+
+// tokenConstantExpr evaluates any constant string expression (including
+// concatenations such as "L"+"R") and reports it when the folded value is a
+// direction token, so the vocabulary check cannot be evaded by splitting the
+// literal.
+func (g *graphPackage) tokenConstantExpr(expr ast.Expr) (string, bool) {
+	tv, ok := g.info.Types[expr]
+	if !ok || tv.Value == nil {
+		return "", false
+	}
+	if basic, ok := tv.Type.Underlying().(*types.Basic); !ok || basic.Info()&types.IsString == 0 {
+		return "", false
+	}
+	value := strings.ToUpper(strings.Trim(tv.Value.String(), `"`))
+	if directionTokens[value] {
+		return value, true
+	}
+	return "", false
+}
+
+func (g *graphPackage) enclosingFunc(node ast.Node) *ast.FuncDecl {
+	for current := node; current != nil; current = g.parents[current] {
+		if decl, ok := current.(*ast.FuncDecl); ok {
+			return decl
+		}
+	}
+	return nil
+}
+
+func (g *graphPackage) enclosingValueSpec(node ast.Node) *ast.ValueSpec {
+	for current := node; current != nil; current = g.parents[current] {
+		if spec, ok := current.(*ast.ValueSpec); ok {
+			return spec
+		}
+	}
+	return nil
+}
+
+func (g *graphPackage) specObject(spec *ast.ValueSpec) types.Object {
+	for _, name := range spec.Names {
+		if obj := g.info.Defs[name]; obj != nil {
+			return obj
+		}
+	}
+	return nil
+}
+
+// parseConeReferencedObjects returns package-level objects referenced from
+// the parsing cone, transitively through initializers. A declaration mapping
+// implemented as a package-level lookup table stays inside the mapping point.
+func (g *graphPackage) parseConeReferencedObjects(cone map[*ast.FuncDecl]bool) map[types.Object]bool {
+	allowed := map[types.Object]bool{}
+	var pending []ast.Node
+	for decl := range cone {
+		if decl.Body != nil {
+			pending = append(pending, decl.Body)
+		}
+	}
+	visit := func(node ast.Node) {
+		ast.Inspect(node, func(inner ast.Node) bool {
+			ident, ok := inner.(*ast.Ident)
+			if !ok {
+				return true
+			}
+			obj := g.info.Uses[ident]
+			if obj == nil || obj.Pkg() != g.pkg || obj.Parent() != g.pkg.Scope() {
+				return true
+			}
+			if !allowed[obj] {
+				allowed[obj] = true
+				pending = append(pending, g.nodeOfObject(obj))
+			}
+			return true
+		})
+	}
+	for len(pending) > 0 {
+		node := pending[0]
+		pending = pending[1:]
+		if node != nil {
+			visit(node)
+		}
+	}
+	return allowed
+}
+
+func (g *graphPackage) nodeOfObject(obj types.Object) ast.Node {
+	pos := obj.Pos()
+	for _, file := range g.files {
+		if file.Pos() <= pos && pos < file.End() {
+			var found ast.Node
+			ast.Inspect(file, func(node ast.Node) bool {
+				if found != nil || node == nil {
+					return false
+				}
+				if node.Pos() == pos {
+					found = node
+					return false
+				}
+				return true
+			})
+			if spec, ok := found.(*ast.ValueSpec); ok {
+				return spec
+			}
+			return g.specOfObject(file, obj)
+		}
+	}
+	return nil
+}
+
+func (g *graphPackage) specOfObject(file *ast.File, obj types.Object) ast.Node {
+	var out ast.Node
+	ast.Inspect(file, func(node ast.Node) bool {
+		if out != nil {
+			return false
+		}
+		spec, ok := node.(*ast.ValueSpec)
+		if !ok {
+			return true
+		}
+		for _, name := range spec.Names {
+			if g.info.Defs[name] == obj {
+				out = spec
+				return false
+			}
+		}
+		return true
+	})
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// carrier family and role discovery
+// ---------------------------------------------------------------------------
+
+type carrierRoleMethod struct {
+	carrierType string
+	name        string
+	target      *types.Func
+	sig         *types.Signature
+	implDecls   []*ast.FuncDecl
+	implTypes   []string
+}
+
+func (g *graphPackage) carrierInterfaces(names []string) map[string]*types.Interface {
+	out := map[string]*types.Interface{}
+	for _, name := range names {
+		named, ok := g.namedTypes[name]
+		if !ok {
+			continue
+		}
+		if iface, ok := named.Underlying().(*types.Interface); ok {
+			out[name] = iface
+		}
+	}
+	return out
+}
+
+func (g *graphPackage) typesImplementing(iface *types.Interface) []string {
+	var out []string
+	for name, named := range g.namedTypes {
+		if _, isIface := named.Underlying().(*types.Interface); isIface {
+			continue
+		}
+		if types.Implements(named, iface) || types.Implements(types.NewPointer(named), iface) {
+			out = append(out, name)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// methodsOfType lists methods declared on T or *T (T never being an
+// interface), resolving each to its declaration.
+func (g *graphPackage) methodsOfType(name string) []carrierRoleMethod {
+	named, ok := g.namedTypes[name]
+	if !ok {
+		return nil
+	}
+	if _, isIface := named.Underlying().(*types.Interface); isIface {
+		return nil
+	}
+	var out []carrierRoleMethod
+	seen := map[string]bool{}
+	for _, recvType := range []types.Type{named, types.NewPointer(named)} {
+		set := types.NewMethodSet(recvType)
+		for i := 0; i < set.Len(); i++ {
+			selection := set.At(i)
+			fn, ok := selection.Obj().(*types.Func)
+			if !ok || seen[fn.Name()] {
+				continue
+			}
+			seen[fn.Name()] = true
+			sig, _ := fn.Type().(*types.Signature)
+			out = append(out, carrierRoleMethod{
+				carrierType: name,
+				name:        fn.Name(),
+				target:      fn,
+				sig:         sig,
+				implDecls:   []*ast.FuncDecl{g.declOfFunc[fn]},
+				implTypes:   []string{name},
+			})
+		}
+	}
+	return out
+}
+
+// carrierMethods returns every method reachable through the carrier family.
+// For an interface carrier the call target is the interface method, while the
+// per-axis implementations contribute their bodies for outcome comparison.
+// carrierMethodIndex lists the methods of the carrier family together with a
+// lookup by the resolved call target. Interface carriers contribute their
+// interface methods; concrete types that merely implement such an interface
+// are used for outcome comparison but do not become separate carriers (calls
+// in the layout code dispatch through the interface).
+func (g *graphPackage) carrierMethodIndex(carrierNames []string) ([]carrierRoleMethod, map[*types.Func]carrierRoleMethod) {
+	interfaces := g.carrierInterfaces(carrierNames)
+	implementedBy := map[string]bool{}
+	for _, iface := range interfaces {
+		for _, impl := range g.typesImplementing(iface) {
+			implementedBy[impl] = true
+		}
+	}
+	var out []carrierRoleMethod
+	aliases := map[*types.Func]*types.Func{}
+	for _, name := range carrierNames {
+		if iface, isIface := interfaces[name]; isIface {
+			impls := g.typesImplementing(iface)
+			for i := 0; i < iface.NumMethods(); i++ {
+				fn := iface.Method(i)
+				sig, _ := fn.Type().(*types.Signature)
+				method := carrierRoleMethod{carrierType: name, name: fn.Name(), target: fn, sig: sig}
+				for _, impl := range impls {
+					if implMethod, decl := g.methodDeclOf(impl, fn.Name()); implMethod != nil {
+						method.implDecls = append(method.implDecls, decl)
+						method.implTypes = append(method.implTypes, impl)
+						if implMethod != fn {
+							aliases[implMethod] = fn
+						}
+					}
+				}
+				out = append(out, method)
+			}
+			continue
+		}
+		if implementedBy[name] {
+			continue
+		}
+		out = append(out, g.methodsOfType(name)...)
+	}
+	byTarget := map[*types.Func]carrierRoleMethod{}
+	for _, method := range out {
+		if method.target != nil {
+			byTarget[method.target] = method
+		}
+	}
+	for alias, target := range aliases {
+		if method, ok := byTarget[target]; ok {
+			byTarget[alias] = method
+		}
+	}
+	return out, byTarget
+}
+
+func (g *graphPackage) methodDeclOf(typeName, methodName string) (*types.Func, *ast.FuncDecl) {
+	named, ok := g.namedTypes[typeName]
+	if !ok {
+		return nil, nil
+	}
+	for _, recvType := range []types.Type{named, types.NewPointer(named)} {
+		set := types.NewMethodSet(recvType)
+		for i := 0; i < set.Len(); i++ {
+			fn, ok := set.At(i).Obj().(*types.Func)
+			if ok && fn.Name() == methodName {
+				return fn, g.declOfFunc[fn]
+			}
+		}
+	}
+	return nil, nil
+}
+
+func (m carrierRoleMethod) label() string {
+	return m.carrierType + "." + m.name
+}
+
+// selectRoles returns the carrier methods matching the predicate.
+func selectRoles(methods []carrierRoleMethod, predicate func(*types.Signature) bool) []carrierRoleMethod {
+	var out []carrierRoleMethod
+	for _, method := range methods {
+		if method.sig != nil && predicate(method.sig) {
+			out = append(out, method)
+		}
+	}
+	return out
+}
+
+func typeNameOf(t types.Type) string {
+	for {
+		ptr, ok := t.(*types.Pointer)
+		if !ok {
+			break
+		}
+		t = ptr.Elem()
+	}
+	if named, ok := t.(*types.Named); ok {
+		return named.Obj().Name()
+	}
+	return t.String()
+}
+
+func isNamedType(t types.Type, name string) bool {
+	for {
+		ptr, ok := t.(*types.Pointer)
+		if !ok {
+			break
+		}
+		t = ptr.Elem()
+	}
+	named, ok := t.(*types.Named)
+	return ok && named.Obj().Name() == name
+}
+
+func isDirectionType(t types.Type) bool { return isNamedType(t, "direction") }
+func isGridCoordType(t types.Type) bool { return isNamedType(t, "gridCoord") }
+
+func isIntType(t types.Type) bool {
+	basic, ok := t.Underlying().(*types.Basic)
+	return ok && basic.Info()&types.IsInteger != 0
+}
+
+func isBoolType(t types.Type) bool {
+	basic, ok := t.Underlying().(*types.Basic)
+	return ok && basic.Kind() == types.Bool
+}
+
+func resultTypes(sig *types.Signature) []types.Type {
+	var out []types.Type
+	for i := 0; i < sig.Results().Len(); i++ {
+		out = append(out, sig.Results().At(i).Type())
+	}
+	return out
+}
+
+func paramTypes(sig *types.Signature) []types.Type {
+	var out []types.Type
+	for i := 0; i < sig.Params().Len(); i++ {
+		out = append(out, sig.Params().At(i).Type())
+	}
+	return out
+}
+
+func sigReturnsFourDirections(sig *types.Signature) bool {
+
+	count := 0
+	for _, result := range resultTypes(sig) {
+		count += directionLeafCount(result)
+	}
+	return count == 4
+
+}
+
+func sigSelfReference(sig *types.Signature) bool {
+	return sigReturnsFourDirections(sig) && sig.Params().Len() == 0
+}
+
+func sigRouteSelection(sig *types.Signature) bool {
+	return sigReturnsFourDirections(sig) && sig.Params().Len() > 0
+}
+
+func sigGridStep(sig *types.Signature) bool {
+	params := paramTypes(sig)
+	results := resultTypes(sig)
+	return len(params) >= 1 && isGridCoordType(params[0]) &&
+		len(results) == 1 && isGridCoordType(results[0])
+}
+
+func sigPlacement(sig *types.Signature) bool {
+	params := paramTypes(sig)
+	results := resultTypes(sig)
+	if len(params) != 2 || !isIntType(params[0]) || !isIntType(params[1]) {
+		return false
+	}
+	return len(results) == 1 && isGridCoordType(results[0])
+}
+
+func sigAxisExtraction(sig *types.Signature) bool {
+	params := paramTypes(sig)
+	results := resultTypes(sig)
+	return len(params) == 1 && isGridCoordType(params[0]) &&
+		len(results) == 1 && isIntType(results[0])
+}
+
+func sigBoolDecision(sig *types.Signature) bool {
+	results := resultTypes(sig)
+	return len(results) == 1 && isBoolType(results[0])
+}
+
+// directionLeafCount counts how many layout `direction` values a type
+// carries: a single direction is 1, a [2]direction pair is 2 and a slice of
+// pairs keeps its element count. It lets an interface that hands out its
+// parallel routing options as a slice of direction pairs satisfy the parallel
+// routing role just like one that returns the two directions separately.
+func directionLeafCount(t types.Type) int {
+
+	var count func(types.Type, map[types.Type]bool) int
+	count = func(t types.Type, seen map[types.Type]bool) int {
+		if isDirectionType(t) {
+			return 1
+		}
+		if seen[t] {
+			return 0
+		}
+		seen[t] = true
+		defer delete(seen, t)
+		switch v := t.Underlying().(type) {
+		case *types.Pointer:
+			return count(v.Elem(), seen)
+		case *types.Array:
+			return int(v.Len()) * count(v.Elem(), seen)
+		case *types.Slice:
+			return count(v.Elem(), seen)
+		case *types.Struct:
+			n := 0
+			for i := 0; i < v.NumFields(); i++ {
+				n += count(v.Field(i).Type(), seen)
+			}
+			return n
+		}
+		return 0
+	}
+	return count(t, map[types.Type]bool{})
+
+}
+
+func sigParallelRouting(sig *types.Signature) bool {
+
+	if results := resultTypes(sig); len(results) == 1 {
+		if list, ok := results[0].Underlying().(*types.Slice); ok && isDirectionType(list.Elem()) {
+			return true
+		}
+	}
+	count := 0
+	for _, result := range resultTypes(sig) {
+		count += directionLeafCount(result)
+	}
+	return count == 2
+
+}
+
+// ---------------------------------------------------------------------------
+// axis dependence and outcome fingerprints
+// ---------------------------------------------------------------------------
+
+// outcomeFingerprints canonicalises the values returned by a method body.
+// Per-axis implementations that return different direction or coordinate
+// values therefore get different fingerprints, while two methods that ignore
+// the axis shape cannot fake them.
+func (g *graphPackage) outcomeFingerprints(decl *ast.FuncDecl) []string {
+	if decl == nil || decl.Body == nil {
+		return nil
+	}
+	defs := g.localDefinitions(decl)
+	seen := map[string]bool{}
+	var out []string
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if _, isLit := node.(*ast.FuncLit); isLit {
+			return false
+		}
+		ret, ok := node.(*ast.ReturnStmt)
+		if !ok {
+			return true
+		}
+		var parts []string
+		for _, result := range ret.Results {
+			parts = append(parts, g.canonicalExpr(result, defs, 0))
+		}
+		fingerprint := strings.Join(parts, ",")
+		if fingerprint != "" && !seen[fingerprint] {
+			seen[fingerprint] = true
+			out = append(out, fingerprint)
+		}
+		return true
+	})
+	sort.Strings(out)
+	return out
+}
+
+// localDefinitions maps every local variable of the declaration to all
+// expressions ever assigned to it, in source order. Keeping every assignment
+// (instead of only the last) matters for the layout code, where a requested
+// coordinate is refined by a second assignment before it is consumed.
+func (g *graphPackage) localDefinitions(decl *ast.FuncDecl) map[types.Object][]ast.Expr {
+	defs := map[types.Object][]ast.Expr{}
+	if decl.Body == nil {
+		return defs
+	}
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if _, isLit := node.(*ast.FuncLit); isLit {
+			return false
+		}
+		switch typed := node.(type) {
+		case *ast.AssignStmt:
+			for i, lhs := range typed.Lhs {
+				ident, ok := lhs.(*ast.Ident)
+				if !ok {
+					continue
+				}
+				obj, ok := g.info.Defs[ident].(*types.Var)
+				if !ok {
+					obj, _ = g.info.Uses[ident].(*types.Var)
+				}
+				if obj == nil {
+					continue
+				}
+				if i < len(typed.Rhs) {
+					defs[obj] = append(defs[obj], typed.Rhs[i])
+				} else if len(typed.Rhs) == 1 {
+					defs[obj] = append(defs[obj], typed.Rhs[0])
+				}
+			}
+		case *ast.ValueSpec:
+			for i, name := range typed.Names {
+				obj, ok := g.info.Defs[name].(*types.Var)
+				if !ok {
+					continue
+				}
+				if i < len(typed.Values) {
+					defs[obj] = append(defs[obj], typed.Values[i])
+				}
+			}
+		}
+		return true
+	})
+	return defs
+}
+
+func (g *graphPackage) canonicalExpr(expr ast.Expr, defs map[types.Object][]ast.Expr, depth int) string {
+	if expr == nil || depth > 6 {
+		return "?"
+	}
+	switch typed := expr.(type) {
+	case *ast.ParenExpr:
+		return g.canonicalExpr(typed.X, defs, depth+1)
+	case *ast.Ident:
+		obj := g.info.Uses[typed]
+		if obj == nil {
+			obj = g.info.Defs[typed]
+		}
+		switch resolved := obj.(type) {
+		case *types.Const:
+			return "const:" + resolved.Val().ExactString()
+		case *types.Var:
+			if resolved.Pkg() == g.pkg && resolved.Parent() == g.pkg.Scope() {
+				return "pkg:" + resolved.Name()
+			}
+			if assignments := defs[resolved]; len(assignments) > 0 {
+				return g.canonicalExpr(assignments[len(assignments)-1], defs, depth+1)
+			}
+			return "var:" + resolved.Name()
+		case *types.Nil:
+			return "nil"
+		default:
+			return "id:" + typed.Name
+		}
+	case *ast.SelectorExpr:
+		return g.canonicalExpr(typed.X, defs, depth+1) + "." + typed.Sel.Name
+	case *ast.BasicLit:
+		return typed.Value
+	case *ast.UnaryExpr:
+		return typed.Op.String() + g.canonicalExpr(typed.X, defs, depth+1)
+	case *ast.BinaryExpr:
+		return "(" + g.canonicalExpr(typed.X, defs, depth+1) + typed.Op.String() + g.canonicalExpr(typed.Y, defs, depth+1) + ")"
+	case *ast.CallExpr:
+		var args []string
+		for _, arg := range typed.Args {
+			args = append(args, g.canonicalExpr(arg, defs, depth+1))
+		}
+		return "call(" + g.canonicalExpr(typed.Fun, defs, depth+1) + "[" + strings.Join(args, ";") + "])"
+	case *ast.CompositeLit:
+		var elements []string
+		for _, element := range typed.Elts {
+			elements = append(elements, g.canonicalExpr(element, defs, depth+1))
+		}
+		return "lit{" + strings.Join(elements, ";") + "}"
+	case *ast.KeyValueExpr:
+		return g.canonicalExpr(typed.Key, defs, depth+1) + ":" + g.canonicalExpr(typed.Value, defs, depth+1)
+	case *ast.IndexExpr:
+		return g.canonicalExpr(typed.X, defs, depth+1) + "[" + g.canonicalExpr(typed.Index, defs, depth+1) + "]"
+	case *ast.TypeAssertExpr:
+		return "assert(" + g.canonicalExpr(typed.X, defs, depth+1) + ")"
+	default:
+		return fmt.Sprintf("<%T>", expr)
+	}
+}
+
+// branchOnAxis reports whether the method body branches on its receiver, i.e.
+// whether the returned outcome is selected by the axis value itself.
+func (g *graphPackage) branchOnAxis(decl *ast.FuncDecl) bool {
+	if decl == nil || decl.Body == nil || decl.Recv == nil || len(decl.Recv.List) == 0 {
+		return false
+	}
+	names := map[string]bool{}
+	for _, name := range decl.Recv.List[0].Names {
+		names[name.Name] = true
+	}
+	if len(names) == 0 {
+		return false
+	}
+	found := false
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if found {
+			return false
+		}
+		switch typed := node.(type) {
+		case *ast.IfStmt:
+			if g.exprReadsAxis(typed.Cond, names) {
+				found = true
+			}
+		case *ast.CaseClause:
+			for _, condition := range typed.List {
+				if g.exprReadsAxis(condition, names) {
+					found = true
+				}
+			}
+		case *ast.SwitchStmt:
+			if typed.Tag != nil && g.exprReadsAxis(typed.Tag, names) {
+				found = true
+			}
+		}
+		return true
+	})
+	return found
+}
+
+func (g *graphPackage) exprReadsAxis(expr ast.Expr, recvNames map[string]bool) bool {
+	found := false
+	ast.Inspect(expr, func(node ast.Node) bool {
+		if found {
+			return false
+		}
+		switch typed := node.(type) {
+		case *ast.Ident:
+			if recvNames[typed.Name] {
+				found = true
+			}
+		case *ast.SelectorExpr:
+			if ident, ok := typed.X.(*ast.Ident); ok && recvNames[ident.Name] {
+				found = true
+			}
+		case *ast.CallExpr:
+			if selector, ok := typed.Fun.(*ast.SelectorExpr); ok {
+				if ident, ok := selector.X.(*ast.Ident); ok && recvNames[ident.Name] {
+					found = true
+				}
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// returnsReadReceiver reports whether any returned expression reads the
+// receiver, which is how a boolean value type expresses an axis comparison
+// without an if/switch (return d == layoutHorizontal).
+func (g *graphPackage) returnsReadReceiver(decl *ast.FuncDecl) bool {
+	if decl == nil || decl.Body == nil || decl.Recv == nil || len(decl.Recv.List) == 0 {
+		return false
+	}
+	names := map[string]bool{}
+	for _, name := range decl.Recv.List[0].Names {
+		names[name.Name] = true
+	}
+	if len(names) == 0 {
+		return false
+	}
+	found := false
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if found {
+			return false
+		}
+		if _, isLit := node.(*ast.FuncLit); isLit {
+			return false
+		}
+		ret, ok := node.(*ast.ReturnStmt)
+		if !ok {
+			return true
+		}
+		for _, result := range ret.Results {
+			if g.exprReadsAxis(result, names) {
+				found = true
+				return false
+			}
+		}
+		return true
+	})
+	return found
+}
+
+type roleEvidence struct {
+	match     carrierRoleMethod
+	distinct  int
+	fingerSet []string
+	reason    string
+	ok        bool
+}
+
+// axisDependent decides whether the matched carrier method makes its outcome
+// depend on the axis:
+//
+//   - an interface family must show at least two implementations with
+//     different outcomes;
+//   - a single carrier type must select between at least two outcomes when it
+//     branches on the receiver, produce a boolean from a receiver comparison,
+//     or return a value that is computed by calling other axis-dependent
+//     carrier methods.
+//
+// The delegation case is what allows a value type to implement a derived
+// decision (nextSpot) purely in terms of level/coord/position without any
+// literal of its own.
+func (g *graphPackage) axisDependent(method carrierRoleMethod, byTarget map[*types.Func]carrierRoleMethod, visiting map[string]bool) roleEvidence {
+	evidence := roleEvidence{match: method}
+	key := method.label()
+	if visiting[key] {
+		evidence.reason = "recursive carrier delegation"
+		return evidence
+	}
+	visiting[key] = true
+	defer delete(visiting, key)
+
+	var fingerprints [][]string
+	for _, decl := range method.implDecls {
+		fingerprints = append(fingerprints, g.outcomeFingerprints(decl))
+	}
+	if len(method.implTypes) >= 2 {
+		distinct := map[string]bool{}
+		for _, fp := range fingerprints {
+			distinct[strings.Join(fp, "|")] = true
+		}
+		evidence.distinct = len(distinct)
+		for value := range distinct {
+			evidence.fingerSet = append(evidence.fingerSet, value)
+		}
+		sort.Strings(evidence.fingerSet)
+		if evidence.distinct < 2 {
+			evidence.reason = "the per-axis implementations return the same outcome"
+			return evidence
+		}
+		evidence.ok = true
+		return evidence
+	}
+	if len(method.implDecls) != 1 || method.implDecls[0] == nil {
+		evidence.reason = "the carrier declares no implementation for this method"
+		return evidence
+	}
+	decl := method.implDecls[0]
+	unique := map[string]bool{}
+	for _, fp := range fingerprints[0] {
+		unique[fp] = true
+	}
+	evidence.distinct = len(unique)
+	for value := range unique {
+		evidence.fingerSet = append(evidence.fingerSet, value)
+	}
+	sort.Strings(evidence.fingerSet)
+	readsReceiver := g.returnsReadReceiver(decl)
+	if g.receiverTableLookup(decl) || g.returnsVaryingCarrierField(decl, method.carrierType) {
+		evidence.ok = true
+		evidence.reason = "result uses varying carrier data"
+		return evidence
+	}
+	if evidence.distinct >= 2 && (g.branchOnAxis(decl) || readsReceiver) {
+		evidence.ok = true
+		return evidence
+	}
+	if evidence.distinct >= 1 && g.returnsBool(decl) && readsReceiver {
+		evidence.ok = true
+		return evidence
+	}
+	for _, callee := range g.calledCarrierMethods(decl, byTarget) {
+		if callee.label() == key {
+			continue
+		}
+		if nested := g.axisDependent(callee, byTarget, visiting); nested.ok {
+			evidence.ok = true
+			evidence.reason = "delegates to " + callee.label()
+			return evidence
+		}
+	}
+	evidence.reason = "the method does not select distinct outcomes in a branch on the axis"
+	return evidence
+}
+
+func (g *graphPackage) returnsBool(decl *ast.FuncDecl) bool {
+	obj, ok := g.funcOfDecl[decl]
+	if !ok || obj == nil {
+		return false
+	}
+	sig, ok := obj.Type().(*types.Signature)
+	if !ok {
+		return false
+	}
+	results := resultTypes(sig)
+	return len(results) == 1 && isBoolType(results[0])
+}
+
+// calledCarrierMethods returns the carrier methods invoked by the body of the
+// declaration, resolving interface dispatch and value receivers alike.
+func (g *graphPackage) calledCarrierMethods(decl *ast.FuncDecl, byTarget map[*types.Func]carrierRoleMethod) []carrierRoleMethod {
+	if decl == nil || decl.Body == nil || len(byTarget) == 0 {
+		return nil
+	}
+	var out []carrierRoleMethod
+	seen := map[*types.Func]bool{}
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		callee := g.resolveCallee(call)
+		if callee == nil || seen[callee] {
+			return true
+		}
+		if method, ok := byTarget[callee]; ok {
+			seen[callee] = true
+			out = append(out, method)
+		}
+		return true
+	})
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// call sites and value flow
+// ---------------------------------------------------------------------------
+
+type roleCallSite struct {
+	method carrierRoleMethod
+	site   analysisCall
+}
+
+func (g *graphPackage) callSitesOf(method carrierRoleMethod) []roleCallSite {
+	var out []roleCallSite
+	for _, call := range g.allCalls {
+		if call.callee == nil || method.target == nil {
+			continue
+		}
+		if call.callee != method.target {
+			continue
+		}
+		out = append(out, roleCallSite{method: method, site: call})
+	}
+	return out
+}
+
+func (g *graphPackage) flowsFrom(decl *ast.FuncDecl, expr ast.Expr, target *ast.CallExpr, depth int) bool {
+	if expr == nil || target == nil || depth > 6 {
+		return false
+	}
+	if expr == ast.Expr(target) {
+		return true
+	}
+	defs := g.localDefinitions(decl)
+	switch typed := expr.(type) {
+	case *ast.ParenExpr:
+		return g.flowsFrom(decl, typed.X, target, depth+1)
+	case *ast.Ident:
+		obj := g.info.Uses[typed]
+		if obj == nil {
+			obj = g.info.Defs[typed]
+		}
+		for _, def := range defs[obj] {
+			if g.flowsFrom(decl, def, target, depth+1) {
+				return true
+			}
+		}
+	case *ast.SelectorExpr:
+		return g.flowsFrom(decl, typed.X, target, depth+1)
+	case *ast.UnaryExpr:
+		return g.flowsFrom(decl, typed.X, target, depth+1)
+	case *ast.StarExpr:
+		return g.flowsFrom(decl, typed.X, target, depth+1)
+	case *ast.IndexExpr:
+		return g.flowsFrom(decl, typed.X, target, depth+1) || g.flowsFrom(decl, typed.Index, target, depth+1)
+	case *ast.SliceExpr:
+		return g.flowsFrom(decl, typed.X, target, depth+1)
+	case *ast.BinaryExpr:
+		return g.flowsFrom(decl, typed.X, target, depth+1) || g.flowsFrom(decl, typed.Y, target, depth+1)
+	case *ast.CompositeLit:
+		for _, element := range typed.Elts {
+			if g.flowsFrom(decl, element, target, depth+1) {
+				return true
+			}
+		}
+	case *ast.CallExpr:
+		if selector, ok := typed.Fun.(*ast.SelectorExpr); ok {
+			if callee := g.resolveCallee(typed); callee != nil {
+				if body := g.declOfFunc[callee]; body != nil && g.returnsReadReceiver(body) && g.flowsFrom(decl, selector.X, target, depth+1) {
+					return true
+				}
+			}
+		}
+		for _, arg := range typed.Args {
+			if g.flowsFrom(decl, arg, target, depth+1) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// flowsIntoArgumentOfCallTo reports whether the result of the role call flows
+// (through local variables and simple wrappers) into an argument of a call
+// whose callee signature satisfies the predicate.
+// flowsIntoRecursiveArgument reports whether the role call's result reaches an
+// argument of a recursive call to the enclosing function, which is how the
+// next-slot search re-enters the grid placement step.
+func (g *graphPackage) flowsIntoRecursiveArgument(site roleCallSite) bool {
+	decl := site.site.caller
+	if decl.Body == nil {
+		return false
+	}
+	found := false
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if found {
+			return false
+		}
+		call, ok := node.(*ast.CallExpr)
+		if !ok || call == site.site.call {
+			return true
+		}
+		if callee := g.resolveCallee(call); callee == nil || g.declOfFunc[callee] != decl {
+			return true
+		}
+		for _, arg := range call.Args {
+			if g.flowsFrom(decl, arg, site.site.call, 0) {
+				found = true
+				return false
+			}
+		}
+		return true
+	})
+	return found
+}
+
+func (g *graphPackage) callSiteLocation(site roleCallSite) string {
+	pos := g.fset.Position(site.site.call.Pos())
+	return fmt.Sprintf("%s:%d in %s", g.fileOfNode(site.site.call), pos.Line, site.site.caller.Name.Name)
+}
+
+// consumerInLayoutCone reports whether the role call happens in a function
+// reachable from the public Draw entry point.
+func (g *graphPackage) consumerInLayoutCone(site roleCallSite) bool {
+	return g.layoutCone()[site.site.caller]
+}
+
+// resultConsumed reports whether the result of the role call is used by the
+// enclosing layout function: returned, passed on as a call argument, used as
+// an index/slice expression, or used in a control-flow expression. A bare
+// statement call or an assignment that is never read again is not enough.
+func (g *graphPackage) resultConsumed(site roleCallSite) bool {
+	decl := site.site.caller
+	if decl.Body == nil {
+		return false
+	}
+	consume := func(expr ast.Expr) bool {
+		return expr != nil && g.flowsFrom(decl, expr, site.site.call, 0)
+	}
+	found := false
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if found {
+			return false
+		}
+		if _, isLit := node.(*ast.FuncLit); isLit {
+			return false
+		}
+		switch typed := node.(type) {
+		case *ast.ReturnStmt:
+			for _, result := range typed.Results {
+				if consume(result) {
+					found = true
+					return false
+				}
+			}
+		case *ast.CallExpr:
+			if typed == site.site.call {
+				return true
+			}
+			for _, arg := range typed.Args {
+				if consume(arg) {
+					found = true
+					return false
+				}
+			}
+		case *ast.IfStmt:
+			if consume(typed.Cond) {
+				found = true
+				return false
+			}
+		case *ast.SwitchStmt:
+			if consume(typed.Tag) {
+				found = true
+				return false
+			}
+			for _, stmt := range typed.Body.List {
+				if clause, ok := stmt.(*ast.CaseClause); ok {
+					for _, expr := range clause.List {
+						if consume(expr) {
+							found = true
+							return false
+						}
+					}
+				}
+			}
+		case *ast.ForStmt:
+			if consume(typed.Cond) {
+				found = true
+				return false
+			}
+		case *ast.RangeStmt:
+			if consume(typed.X) {
+				found = true
+				return false
+			}
+		case *ast.IndexExpr:
+			if consume(typed.X) || consume(typed.Index) {
+				found = true
+				return false
+			}
+		case *ast.SliceExpr:
+			if consume(typed.X) {
+				found = true
+				return false
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// resultFlowsIntoCondition reports whether the role call's result reaches the
+// condition of an if, for or switch in the enclosing function. That is how a
+// boolean axis gate decides which layout branch runs.
+// resultFlowsIntoCallArgumentOrReturn reports whether the role call result
+// reaches a return statement or an argument of another call in the enclosing
+// layout function. That is where a decided direction or coordinate is handed
+// to the rest of the pipeline, as opposed to a result that is merely used in
+// an unrelated expression.
+func (g *graphPackage) resultFlowsIntoCallArgumentOrReturn(site roleCallSite) bool {
+	decl := site.site.caller
+	if decl.Body == nil {
+		return false
+	}
+	found := false
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if found {
+			return false
+		}
+		if _, isLit := node.(*ast.FuncLit); isLit {
+			return false
+		}
+		switch typed := node.(type) {
+		case *ast.ReturnStmt:
+			for _, result := range typed.Results {
+				if g.flowsFrom(decl, result, site.site.call, 0) {
+					found = true
+					return false
+				}
+			}
+		case *ast.CallExpr:
+			if typed == site.site.call {
+				return true
+			}
+			for _, arg := range typed.Args {
+				if g.flowsFrom(decl, arg, site.site.call, 0) {
+					found = true
+					return false
+				}
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// callerSignature returns the signature of the function that contains the
+// call site, so a decision can be tied to the function that produces it.
+func (g *graphPackage) callerSignature(site roleCallSite) *types.Signature {
+	obj, ok := g.funcOfDecl[site.site.caller]
+	if !ok || obj == nil {
+		return nil
+	}
+	sig, _ := obj.Type().(*types.Signature)
+	return sig
+}
+
+func (g *graphPackage) resultFlowsIntoCondition(site roleCallSite) bool {
+	decl := site.site.caller
+	if decl.Body == nil {
+		return false
+	}
+	consume := func(expr ast.Expr) bool {
+		return expr != nil && g.flowsFrom(decl, expr, site.site.call, 0)
+	}
+	found := false
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if found {
+			return false
+		}
+		if _, isLit := node.(*ast.FuncLit); isLit {
+			return false
+		}
+		switch typed := node.(type) {
+		case *ast.IfStmt:
+			if consume(typed.Cond) {
+				found = true
+			}
+		case *ast.ForStmt:
+			if consume(typed.Cond) {
+				found = true
+			}
+		case *ast.SwitchStmt:
+			if consume(typed.Tag) {
+				found = true
+			}
+		case *ast.CaseClause:
+			for _, expr := range typed.List {
+				if consume(expr) {
+					found = true
+					return false
+				}
+			}
+		}
+		return !found
+	})
+	return found
+}
+
+// earlyReturnGuard reports whether the role call's result decides a guard
+// whose entire body is a return statement, i.e. an early return that keeps a
+// whole layout phase from running (the fan-out gate).
+func (g *graphPackage) earlyReturnGuard(site roleCallSite) bool {
+	decl := site.site.caller
+	if decl.Body == nil {
+		return false
+	}
+	consume := func(expr ast.Expr) bool {
+		return expr != nil && g.flowsFrom(decl, expr, site.site.call, 0)
+	}
+	found := false
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if found {
+			return false
+		}
+		if _, isLit := node.(*ast.FuncLit); isLit {
+			return false
+		}
+		stmt, ok := node.(*ast.IfStmt)
+		if !ok || !consume(stmt.Cond) {
+			return true
+		}
+		if stmt.Else != nil || stmt.Body == nil {
+			return true
+		}
+		if len(stmt.Body.List) != 1 {
+			return true
+		}
+		if _, isReturn := stmt.Body.List[0].(*ast.ReturnStmt); isReturn {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
+
+// carrierRoleMethods returns every carrier method matching at least one
+// decision-role signature.
+func carrierRoleMethods(methods []carrierRoleMethod) []carrierRoleMethod {
+	var out []carrierRoleMethod
+	for _, method := range methods {
+		if method.sig == nil {
+			continue
+		}
+		if isSelfReferenceRole(method.sig) || isRouteRole(method.sig) || isGridStepRole(method.sig) ||
+			isPlacementRole(method.sig) || isExtractionRole(method.sig) || isParallelRole(method.sig) ||
+			isBoolRole(method.sig) {
+			out = append(out, method)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].label() < out[j].label() })
+	return out
+}
+
+func isSelfReferenceRole(sig *types.Signature) bool { return sigSelfReference(sig) }
+func isRouteRole(sig *types.Signature) bool         { return sigRouteSelection(sig) }
+func isGridStepRole(sig *types.Signature) bool      { return sigGridStep(sig) }
+func isPlacementRole(sig *types.Signature) bool     { return sigPlacement(sig) }
+func isExtractionRole(sig *types.Signature) bool    { return sigAxisExtraction(sig) }
+func isParallelRole(sig *types.Signature) bool      { return sigParallelRouting(sig) }
+func isBoolRole(sig *types.Signature) bool          { return sigBoolDecision(sig) }
+
+// carrierDecls indexes the declarations that belong to the carrier family, so
+// call sites inside the carrier itself can be told apart from call sites in
+// the layout code that consumes the abstraction.
+func carrierDecls(methods []carrierRoleMethod) map[*ast.FuncDecl]bool {
+	out := map[*ast.FuncDecl]bool{}
+	for _, method := range methods {
+		for _, decl := range method.implDecls {
+			if decl != nil {
+				out[decl] = true
+			}
+		}
+	}
+	return out
+}
+
+// roleCallSiteEvidence describes how a carrier method is reached from layout
+// code and how its result is used there.
+type roleCallSiteEvidence struct {
+	method    carrierRoleMethod
+	site      roleCallSite
+	location  string
+	consumed  bool
+	condition bool
+	early     bool
+}
+
+// directCallEvidence collects the call sites of the role methods that happen
+// in functions reachable from Draw but outside the carrier family itself.
+func (g *graphPackage) directCallEvidence(methods []carrierRoleMethod) []roleCallSiteEvidence {
+
+	layout := g.layoutCone()
+	byTarget := map[*types.Func]carrierRoleMethod{}
+	for _, m := range methods {
+		if m.target != nil {
+			byTarget[m.target] = m
+		}
+	}
+	engaged, _ := g.engagementOf(methods, byTarget)
+	for _, m := range methods {
+		if engaged[m.label()] {
+			for _, decl := range m.implDecls {
+				layout[decl] = true
+			}
+		}
+	}
+	var out []roleCallSiteEvidence
+	for _, method := range methods {
+		for _, site := range g.callSitesOf(method) {
+			caller := site.site.caller
+			if caller == nil || !layout[caller] {
+				continue
+			}
+			out = append(out, roleCallSiteEvidence{
+				method:    method,
+				site:      site,
+				location:  g.callSiteLocation(site),
+				consumed:  g.resultConsumed(site),
+				condition: g.resultFlowsIntoCondition(site),
+				early:     g.earlyReturnGuard(site),
+			})
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].location < out[j].location })
+	return out
+}
+
+// engagementOf reports which role methods are reachable from a layout-code
+// call site, either directly or through other carrier methods. A role method
+// that only exists as a stub without such a path is not engaged.
+func (g *graphPackage) engagementOf(methods []carrierRoleMethod, byTarget map[*types.Func]carrierRoleMethod) (engaged map[string]bool, direct map[string]bool) {
+	carrier := carrierDecls(methods)
+	layout := g.layoutCone()
+	engaged = map[string]bool{}
+	direct = map[string]bool{}
+	var queue []carrierRoleMethod
+	for _, method := range methods {
+		for _, site := range g.callSitesOf(method) {
+			caller := site.site.caller
+			if caller == nil || !layout[caller] || carrier[caller] {
+				continue
+			}
+			if !engaged[method.label()] {
+				engaged[method.label()] = true
+				direct[method.label()] = true
+				queue = append(queue, method)
+			}
+			break
+		}
+	}
+	for len(queue) > 0 {
+		current := queue[0]
+		queue = queue[1:]
+		for _, decl := range current.implDecls {
+			for _, callee := range g.calledCarrierMethods(decl, byTarget) {
+				if !engaged[callee.label()] {
+					engaged[callee.label()] = true
+					queue = append(queue, callee)
+				}
+			}
+		}
+	}
+	return engaged, direct
+}
+
+// ---------------------------------------------------------------------------
+// state field reads
+// ---------------------------------------------------------------------------
+
+type stateRead struct {
+	file    string
+	line    int
+	field   string
+	context string
+	decl    *ast.FuncDecl
+}
+
+func (g *graphPackage) stateReads(fields map[string]bool) []stateRead {
+	var out []stateRead
+	for _, decl := range g.decls {
+		if decl.Body == nil {
+			continue
+		}
+		ast.Inspect(decl.Body, func(node ast.Node) bool {
+			selector, ok := node.(*ast.SelectorExpr)
+			if !ok || !fields[selector.Sel.Name] {
+				return true
+			}
+			if !g.selectorIsStateField(selector) {
+				return true
+			}
+			pos := g.fset.Position(selector.Pos())
+			out = append(out, stateRead{
+				file:    g.fileOfNode(selector),
+				line:    pos.Line,
+				field:   selector.Sel.Name,
+				context: g.classifyReadContext(selector),
+				decl:    g.enclosingFunc(selector),
+			})
+			return true
+		})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].file != out[j].file {
+			return out[i].file < out[j].file
+		}
+		return out[i].line < out[j].line
+	})
+	return out
+}
+
+func (g *graphPackage) selectorIsStateField(selector *ast.SelectorExpr) bool {
+	typ := g.info.Types[selector.X].Type
+	if typ == nil {
+		return false
+	}
+	for {
+		if pointer, ok := typ.(*types.Pointer); ok {
+			typ = pointer.Elem()
+			continue
+		}
+		break
+	}
+	named, ok := typ.(*types.Named)
+	if !ok {
+		return false
+	}
+	fields, ok := g.structFields[named.Obj().Name()]
+	if !ok {
+		return false
+	}
+	_, ok = fields[selector.Sel.Name]
+	return ok
+}
+
+// structFieldDecl records a struct field of a package-declared type.
+type structFieldDecl struct {
+	structName string
+	field      string
+	typ        types.Type
+}
+
+// structFieldsNamed lists every package struct type that declares a field
+// with the given name. It is used to verify that the carrier type the parse
+// side stores is also the type the layout side keeps, instead of a second
+// raw copy of the axis.
+func (g *graphPackage) structFieldsNamed(name string) []structFieldDecl {
+	var out []structFieldDecl
+	var names []string
+	for structName := range g.structFields {
+		names = append(names, structName)
+	}
+	sort.Strings(names)
+	for _, structName := range names {
+		typ, ok := g.structFields[structName][name]
+		if !ok {
+			continue
+		}
+		out = append(out, structFieldDecl{structName: structName, field: name, typ: typ})
+	}
+	return out
+}
+
+func (g *graphPackage) classifyReadContext(selector *ast.SelectorExpr) string {
+	parent := g.parents[selector]
+	if parent == nil {
+		return "other"
+	}
+	if call, ok := parent.(*ast.CallExpr); ok {
+		if call.Fun == ast.Expr(selector) {
+			return "call-receiver"
+		}
+		return "call-argument"
+	}
+	if outer, ok := parent.(*ast.SelectorExpr); ok && ast.Expr(outer.X) == ast.Expr(selector) {
+		if grand := g.parents[outer]; grand != nil {
+			if call, ok := grand.(*ast.CallExpr); ok && call.Fun == ast.Expr(outer) {
+				return "call-receiver"
+			}
+		}
+		return "other"
+	}
+	switch typed := parent.(type) {
+	case *ast.AssignStmt:
+		for _, lhs := range typed.Lhs {
+			if ast.Expr(lhs) == ast.Expr(selector) {
+				return "assignment-target"
+			}
+		}
+		for _, rhs := range typed.Rhs {
+			if ast.Expr(rhs) == ast.Expr(selector) {
+				return "state-transfer"
+			}
+		}
+	case *ast.ValueSpec:
+		for _, value := range typed.Values {
+			if ast.Expr(value) == ast.Expr(selector) {
+				return "state-transfer"
+			}
+		}
+	case *ast.BinaryExpr:
+		if ident, ok := typed.X.(*ast.Ident); ok && isActualNil(g, ident) {
+			return "nil-check"
+		}
+		if ident, ok := typed.Y.(*ast.Ident); ok && isActualNil(g, ident) {
+			return "nil-check"
+		}
+	}
+	return "other"
+}
+
+func baseReflectName(t reflect.Type) string {
+	for t != nil && t.Kind() == reflect.Pointer {
+		t = t.Elem()
+	}
+	if t == nil {
+		return ""
+	}
+	return t.Name()
+}
+
+func isActualNil(g *graphPackage, ident *ast.Ident) bool {
+	_, ok := g.info.ObjectOf(ident).(*types.Nil)
+	return ok
+}
+
+// A table lookup may carry axis behavior without an if/switch in the method.
+func (g *graphPackage) receiverTableLookup(decl *ast.FuncDecl) bool {
+	if decl == nil || decl.Recv == nil {
+		return false
+	}
+	names := map[string]bool{}
+	for _, f := range decl.Recv.List {
+		for _, n := range f.Names {
+			names[n.Name] = true
+		}
+	}
+	defs := g.localDefinitions(decl)
+	var distinctTable func(ast.Expr, int) bool
+	distinctTable = func(e ast.Expr, depth int) bool {
+		if depth > 12 {
+			return false
+		}
+		switch x := e.(type) {
+		case *ast.ParenExpr:
+			return distinctTable(x.X, depth+1)
+		case *ast.Ident:
+			obj := g.info.ObjectOf(x)
+			if obj == nil {
+				return false
+			}
+			if vs, ok := g.nodeOfObject(obj).(*ast.ValueSpec); ok {
+				for i, n := range vs.Names {
+					if g.info.ObjectOf(n) == obj && i < len(vs.Values) {
+						return distinctTable(vs.Values[i], depth+1)
+					}
+				}
+			}
+		case *ast.CompositeLit:
+			switch g.info.TypeOf(x).Underlying().(type) {
+			case *types.Array, *types.Slice, *types.Map:
+			default:
+				return false
+			}
+			values := map[string]bool{}
+			for _, v := range x.Elts {
+				if kv, ok := v.(*ast.KeyValueExpr); ok {
+					v = kv.Value
+				}
+				values[g.canonicalExpr(v, defs, 0)] = true
+			}
+			return len(values) >= 2
+		}
+		return false
+	}
+	var readsLookup func(ast.Expr, int) bool
+	readsLookup = func(e ast.Expr, depth int) bool {
+		if e == nil || depth > 12 {
+			return false
+		}
+		found := false
+		ast.Inspect(e, func(n ast.Node) bool {
+			if found {
+				return false
+			}
+			if index, ok := n.(*ast.IndexExpr); ok && g.exprReadsAxis(index.Index, names) && distinctTable(index.X, 0) {
+				found = true
+				return false
+			}
+			if id, ok := n.(*ast.Ident); ok {
+				for _, rhs := range defs[g.info.ObjectOf(id)] {
+					if readsLookup(rhs, depth+1) {
+						found = true
+						break
+					}
+				}
+			}
+			return true
+		})
+		return found
+	}
+	found := false
+	ast.Inspect(decl.Body, func(n ast.Node) bool {
+		if ret, ok := n.(*ast.ReturnStmt); ok {
+			for _, e := range ret.Results {
+				found = found || readsLookup(e, 0)
+			}
+		}
+		return !found
+	})
+	return found
+}
+func (g *graphPackage) tokenIsRepresentation(node ast.Node, decl *ast.FuncDecl) bool {
+	if decl.Recv == nil {
+		return false
+	}
+	object := g.funcOfDecl[decl]
+	if object == nil {
+		return false
+	}
+	sig, ok := object.Type().(*types.Signature)
+	if !ok || sig.Results().Len() != 1 {
+		return false
+	}
+	basic, ok := sig.Results().At(0).Type().Underlying().(*types.Basic)
+	if !ok || basic.Kind() != types.String {
+		return false
+	}
+	for i := 0; i < sig.Params().Len(); i++ {
+		if b, ok := sig.Params().At(i).Type().Underlying().(*types.Basic); ok && b.Kind() == types.String {
+			return false
+		}
+	}
+	for current := node; current != nil && current != decl; current = g.parents[current] {
+		if _, ok := current.(*ast.ReturnStmt); ok {
+			return true
+		}
+		switch current.(type) {
+		case *ast.IfStmt, *ast.SwitchStmt, *ast.CaseClause:
+			return false
+		}
+	}
+	return false
+}
+
+// Runtime parsing identifies which private carrier fields differ across axes;
+// source value flow establishes that those fields contribute to method results.
+func (g *graphPackage) returnsVaryingCarrierField(decl *ast.FuncDecl, carrier string) bool {
+	if decl == nil || decl.Recv == nil {
+		return false
+	}
+	observations := map[string]map[string]string{}
+	for _, axis := range []string{"LR", "TD"} {
+		properties, err := graph.Parse(probeMermaid(axis), "cli")
+		if err != nil {
+			return false
+		}
+		fields := reflect.ValueOf(properties).Elem()
+		for i := 0; i < fields.NumField(); i++ {
+			value := fields.Field(i)
+			for value.IsValid() && (value.Kind() == reflect.Pointer || value.Kind() == reflect.Interface) {
+				if value.IsNil() {
+					value = reflect.Value{}
+					break
+				}
+				value = value.Elem()
+			}
+			if !value.IsValid() || value.Kind() != reflect.Struct || value.Type().Name() != carrier || value.Type().PkgPath() != graphPackagePath() {
+				continue
+			}
+			for j := 0; j < value.NumField(); j++ {
+				name := value.Type().Field(j).Name
+				if observations[name] == nil {
+					observations[name] = map[string]string{}
+				}
+				observations[name][axis] = valueRepr(value.Field(j), 0)
+			}
+		}
+	}
+	varying := map[string]bool{}
+	for name, values := range observations {
+		lr, lok := values["LR"]
+		td, tok := values["TD"]
+		if lok && tok && lr != td {
+			varying[name] = true
+		}
+	}
+	recv := map[string]bool{}
+	for _, field := range decl.Recv.List {
+		for _, name := range field.Names {
+			recv[name.Name] = true
+		}
+	}
+	defs := g.localDefinitions(decl)
+	var uses func(ast.Expr, int) bool
+	uses = func(e ast.Expr, depth int) bool {
+		if e == nil || depth > 12 {
+			return false
+		}
+		found := false
+		ast.Inspect(e, func(n ast.Node) bool {
+			if found {
+				return false
+			}
+			if selector, ok := n.(*ast.SelectorExpr); ok {
+				if id, ok := selector.X.(*ast.Ident); ok && recv[id.Name] && varying[selector.Sel.Name] {
+					found = true
+					return false
+				}
+			}
+			if id, ok := n.(*ast.Ident); ok {
+				for _, rhs := range defs[g.info.ObjectOf(id)] {
+					if uses(rhs, depth+1) {
+						found = true
+						break
+					}
+				}
+			}
+			return true
+		})
+		return found
+	}
+	found := false
+	ast.Inspect(decl.Body, func(n ast.Node) bool {
+		if ret, ok := n.(*ast.ReturnStmt); ok {
+			for _, e := range ret.Results {
+				found = found || uses(e, 0)
+			}
+		}
+		return !found
+	})
+	return found
+}
+
+// A carrier may own and execute the fan-out phase, instead of handing a
+// boolean back to a graph method. No specific method name is required.
+func carrierOwnsFanoutAction(t *testing.T) bool {
+	g := loadGraphPackage(t)
+	methods, _ := g.carrierMethodIndex(carrierTypeNames(t))
+	layout := g.layoutCone()
+	for _, method := range methods {
+		if method.sig.Results().Len() != 0 {
+			continue
+		}
+		active := false
+		for _, site := range g.callSitesOf(method) {
+			if layout[site.site.caller] {
+				active = true
+			}
+		}
+		if !active {
+			continue
+		}
+		for _, decl := range method.implDecls {
+			if decl == nil || !g.branchOnAxis(decl) {
+				continue
+			}
+			writesFanout := false
+			ast.Inspect(decl.Body, func(n ast.Node) bool {
+				if assignment, ok := n.(*ast.AssignStmt); ok {
+					for _, lhs := range assignment.Lhs {
+						if field, ok := lhs.(*ast.SelectorExpr); ok && field.Sel.Name == "fanout" {
+							writesFanout = true
+						}
+					}
+				}
+				return true
+			})
+			if writesFanout {
+				return true
+			}
+		}
+	}
+	return false
+}
