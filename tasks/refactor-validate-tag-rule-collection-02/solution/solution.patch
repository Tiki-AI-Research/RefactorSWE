+++ b/struct_rules_test.go
@@ -0,0 +1,213 @@
+package validate
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/gookit/goutil/x/assert"
+)
+
+// (a) []*int / [N]*string element output name expansion:
+// Under CheckSubOnParentMarked=true (default), fields without validate tag are skipped from descent,
+// so element output names (Nums.0, Names.0) are NOT expanded.
+// Under CheckSubOnParentMarked=false, non-struct container elements with json tag are expanded.
+type structWithPtrSlice struct {
+	Sub  *cacheUserSub `validate:""`
+	Nums []*int        `json:"nums"`
+}
+
+type structWithPtrArray struct {
+	Names [2]*string `json:"names"`
+}
+
+func TestRuleCollect_ptrContainerOutputNames(t *testing.T) {
+	n1, n2 := 1, 2
+	s := structWithPtrSlice{
+		Sub:  &cacheUserSub{City: "NYC", Zip: "10001"},
+		Nums: []*int{&n1, &n2},
+	}
+	d, err := FromStruct(&s)
+	assert.NoErr(t, err)
+	v := d.Create()
+	// Default: CheckSubOnParentMarked=true, Nums has no validate tag -> no element expansion
+	assert.Eq(t, "", v.trans.fieldMap["Nums.0"])
+
+	str1, str2 := "a", "b"
+	arr := structWithPtrArray{Names: [2]*string{&str1, &str2}}
+	d2, err2 := FromStruct(&arr)
+	assert.NoErr(t, err2)
+	v2 := d2.Create()
+	// Default: Names has no validate tag -> no element expansion
+	assert.Eq(t, "", v2.trans.fieldMap["Names.0"])
+
+	// When CheckSubOnParentMarked=false, descent gate is disabled -> elements expanded
+	defer func() {
+		ResetOption()
+		ResetTypeCache()
+	}()
+	Config(func(o *GlobalOption) {
+		o.CheckSubOnParentMarked = false
+	})
+	ResetTypeCache()
+
+	d3, err3 := FromStruct(&s)
+	assert.NoErr(t, err3)
+	v3 := d3.Create()
+	assert.Eq(t, "nums.0", v3.trans.fieldMap["Nums.0"])
+	assert.Eq(t, "nums.1", v3.trans.fieldMap["Nums.1"])
+
+	d4, err4 := FromStruct(&arr)
+	assert.NoErr(t, err4)
+	v4 := d4.Create()
+	assert.Eq(t, "names.0", v4.trans.fieldMap["Names.0"])
+	assert.Eq(t, "names.1", v4.trans.fieldMap["Names.1"])
+}
+
+// (b) static vs dynamic ValidateTag/FilterTag override behavior
+type customTagStaticUser struct {
+	Name string `my_val:"required|minLen:3" my_flt:"trim"`
+}
+
+type customTagDynamicUser struct {
+	Name string        `my_val:"required|minLen:3" my_flt:"trim"`
+	Sub  *cacheUserSub `validate:""`
+}
+
+func TestRuleCollect_instanceTagOverride(t *testing.T) {
+	// Static struct: uses cached rule template built with gOpt.ValidateTag ("validate"),
+	// so instance-level ValidateTag override does NOT change static template rules.
+	uStatic := &customTagStaticUser{Name: "  ab  "}
+	dStatic, err := FromStruct(uStatic)
+	assert.NoErr(t, err)
+	dStatic.ValidateTag = "my_val"
+	dStatic.FilterTag = "my_flt"
+	vStatic := dStatic.Create()
+	assert.True(t, vStatic.Validate())
+	assert.False(t, vStatic.Errors.HasField("Name"))
+
+	// Dynamic struct: per-value tag walk respects d.ValidateTag / d.FilterTag.
+	uDynamic := &customTagDynamicUser{Name: "  ab  ", Sub: &cacheUserSub{City: "NYC"}}
+	dDynamic, err2 := FromStruct(uDynamic)
+	assert.NoErr(t, err2)
+	dDynamic.ValidateTag = "my_val"
+	dDynamic.FilterTag = "my_flt"
+	vDynamic := dDynamic.Create()
+	// minLen:3 should fail since trimmed "ab" has length 2
+	ok := vDynamic.Validate()
+	assert.False(t, ok)
+	assert.True(t, vDynamic.Errors.HasField("Name"))
+}
+
+// (c) ptr-to-slice / ptr-to-map of struct static classification
+type ptrContainerStatic struct {
+	PS   *[]cacheUserSub          `validate:"" json:"ps"`
+	PM   *map[string]cacheUserSub `validate:"" json:"pm"`
+	Name string                   `validate:"required"`
+}
+
+func TestRuleCollect_ptrContainerStaticClassification(t *testing.T) {
+	defer ResetTypeCache()
+	// Must be classified as STATIC, identical to baseline computeIsStatic
+	assert.True(t, getTypeMeta(reflect.TypeOf(ptrContainerStatic{})).isStatic)
+
+	// Public observable behavior: validation passes when Name is set,
+	// and PS/PM elements are not collected into the static template
+	ps := []cacheUserSub{{}}
+	pm := map[string]cacheUserSub{"k": {}}
+	obj := &ptrContainerStatic{
+		PS:   &ps,
+		PM:   &pm,
+		Name: "valid",
+	}
+	v := Struct(obj)
+	assert.True(t, v.Validate())
+	assert.Empty(t, v.Errors)
+}
+
+// (d) blank identifier field '_' must not be treated as unexported
+func TestRuleCollect_blankField(t *testing.T) {
+	// Construct struct{ _ int `validate:"required" json:"blank"`; Name string `validate:"required"` }
+	// via reflect.StructOf to avoid go vet static AST warning about unexported field having json tag.
+	st := reflect.StructOf([]reflect.StructField{
+		{
+			Name:    "_",
+			PkgPath: "github.com/gookit/validate/v2",
+			Type:    reflect.TypeOf(0),
+			Tag:     `validate:"required" json:"blank"`,
+		},
+		{
+			Name: "Name",
+			Type: reflect.TypeOf(""),
+			Tag:  `validate:"required"`,
+		},
+	})
+	s := reflect.New(st).Interface()
+	v := Struct(s)
+	assert.False(t, v.Validate())
+	assert.True(t, v.Errors.HasField("blank"))
+	assert.Eq(t, "blank", v.Trans().FieldMap()["_"])
+}
+
+// (e) ValidatePrivateFields config window between FromStruct and Create
+type privConfigStatic struct {
+	Name string `validate:"required"`
+	age  int    `validate:"required|min:10"`
+}
+
+type privConfigDynamic struct {
+	Name string        `validate:"required"`
+	Sub  *cacheUserSub `validate:""`
+	age  int           `validate:"required|min:10"`
+}
+
+func TestRuleCollect_privateFieldsConfigWindow_static(t *testing.T) {
+	defer func() {
+		ResetOption()
+		ResetTypeCache()
+	}()
+
+	ResetOption()
+	ResetTypeCache()
+
+	u := &privConfigStatic{Name: "tom", age: 5}
+	d, err := FromStruct(u)
+	assert.NoErr(t, err)
+
+	// Switch option AFTER FromStruct, BEFORE Create
+	Config(func(o *GlobalOption) {
+		o.ValidatePrivateFields = true
+	})
+
+	v := d.Create()
+	ok := v.Validate()
+	assert.False(t, ok)
+	assert.True(t, v.Errors.HasField("age"))
+}
+
+func TestRuleCollect_privateFieldsConfigWindow_dynamic(t *testing.T) {
+	defer func() {
+		ResetOption()
+		ResetTypeCache()
+	}()
+
+	ResetOption()
+	ResetTypeCache()
+
+	u := &privConfigDynamic{
+		Name: "tom",
+		Sub:  &cacheUserSub{City: "NYC", Zip: "10001"},
+		age:  5,
+	}
+	d, err := FromStruct(u)
+	assert.NoErr(t, err)
+
+	// Switch option AFTER FromStruct, BEFORE Create
+	Config(func(o *GlobalOption) {
+		o.ValidatePrivateFields = true
+	})
+
+	v := d.Create()
