-// Remove type multiple pointer
+// Remove type multiple pointer.
+//
+// A self-referential named pointer type (eg: `type P *P`) never reaches a
+// non-pointer element; such a chain is returned as-is (still a Ptr kind)
+// instead of looping forever, so type metadata building for a struct that
+// merely declares such a field terminates.
 func removeTypePtr(t reflect.Type) reflect.Type {
+	var seen map[reflect.Type]struct{}
 	for t.Kind() == reflect.Ptr {
-		t = t.Elem()
+		next := t.Elem()
+		if next.Kind() != reflect.Ptr {
+			return next
+		}
+		if seen == nil {
+			seen = make(map[reflect.Type]struct{}, 2)
+		}
+		if _, ok := seen[t]; ok {
+			return t
+		}
+		seen[t] = struct{}{}
+		t = next
 	}
 	return t
 }
