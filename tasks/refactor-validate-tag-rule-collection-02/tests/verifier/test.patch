+// ---------------------------------------------------------------------------
+// REQ-BEH-T3:C1 / C6: exported struct data source contract and public errors
+// ---------------------------------------------------------------------------
+
+func TestP2PStructDataContractAndPublicErrors(t *testing.T) {
+	var _ validate.DataFace = (*validate.StructData)(nil)
+
+	src := &p2pFlat{Name: "ab"}
+	d, err := validate.FromStruct(src)
+	if err != nil {
+		t.Fatalf("FromStruct(valid struct) returned error: %v", err)
+	}
+	if d.Src() != any(src) {
+		t.Fatalf("StructData.Src() must return the bound source, got %#v", d.Src())
+	}
+	if d.Type() == 0 {
+		t.Fatalf("StructData.Type() must be a non-zero source discriminator")
+	}
+	other, err := validate.FromStruct(&p2pInner{})
+	if err != nil {
+		t.Fatalf("FromStruct(second struct) returned error: %v", err)
+	}
+	if d.Type() != other.Type() {
+		t.Fatalf("StructData.Type() must be stable for struct sources: %d != %d", d.Type(), other.Type())
+	}
+	if mapV := validate.FromMap(map[string]any{"x": 1}); mapV.Type() == d.Type() {
+		t.Fatalf("struct and map sources must keep distinct Type() values")
+	}
+
+	if val, ok := d.Get("Name"); !ok || val != "ab" {
+		t.Fatalf("Get(Name) = (%v, %v), want (ab, true)", val, ok)
+	}
+	if _, ok := d.Get("Missing"); ok {
+		t.Fatalf("Get(Missing) must report not-exist")
+	}
+	if val, exist, zero := d.TryGet("Age"); !exist || !zero || val != 0 {
+		t.Fatalf("TryGet(Age) = (%v, %v, %v), want (0, true, true)", val, exist, zero)
+	}
+	if _, err := d.Set("Missing", 1); !errors.Is(err, validate.ErrNoField) {
+		t.Fatalf("Set on unknown field must return ErrNoField, got %v", err)
