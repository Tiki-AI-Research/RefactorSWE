+// Collection of a nil pointer inside a struct container panics in the
+// baseline. Preserve that public boundary without depending on a collector
+// helper name or a particular evaluation order in its implementation.
+func p2pAssertNilElementCollectionPanic(t *testing.T, source any) {
+	t.Helper()
+	defer func() {
+		got := recover()
+		if got == nil {
+			t.Fatal("nil container element collection must retain its panic")
+		}
+		failure, ok := got.(*reflect.ValueError)
+		if !ok || failure.Method != "reflect.Value.Type" || failure.Kind != reflect.Invalid {
+			t.Fatalf("unexpected nil element panic: %T %v", got, got)
+		}
+	}()
+	validate.Struct(source)
+}
+
+func TestP2PNilSliceElementCollectionPanic(t *testing.T) {
+	p2pAssertNilElementCollectionPanic(t, &struct {
+		Force *p2pInner
+		Items []*int `validate:""`
+	}{Items: []*int{nil}})
+	p2pAssertNilElementCollectionPanic(t, &struct {
+		Force *p2pInner
+		Items []*time.Time `validate:""`
+	}{Items: []*time.Time{nil}})
+	source := &struct {
+		Items []*p2pInner `validate:"required"`
+	}{Items: []*p2pInner{nil}}
+	p2pAssertNilElementCollectionPanic(t, source)
+}
+
+func TestP2PNilArrayElementCollectionPanic(t *testing.T) {
+	p2pAssertNilElementCollectionPanic(t, &struct {
+		Items [1]*int `validate:""`
+	}{})
+	source := &struct {
+		Items [1]*p2pInner `validate:"required"`
+	}{}
+	p2pAssertNilElementCollectionPanic(t, source)
+}
+
+func TestP2PNilMapElementCollectionPanic(t *testing.T) {
+	p2pAssertNilElementCollectionPanic(t, &struct {
+		Force *p2pInner
+		Items map[string]*int `validate:""`
+	}{Items: map[string]*int{"key": nil}})
+	func() {
+		defer func() {
+			got := recover()
+			if got != "reflect.Value.MapIndex: value of type string is not assignable to type *string" {
+				t.Fatalf("pointer-key map must preserve baseline panic, got %T: %v", got, got)
+			}
+		}()
+		key := "key"
+		validate.Struct(&struct {
+			Force *p2pInner
+			Items map[*string]int `validate:""`
+		}{Items: map[*string]int{&key: 3}})
+	}()
+	source := &struct {
+		Items map[string]*p2pInner `validate:"required"`
+	}{Items: map[string]*p2pInner{"key": nil}}
+	p2pAssertNilElementCollectionPanic(t, source)
+}
