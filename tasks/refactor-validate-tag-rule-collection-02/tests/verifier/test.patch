+func TestP2PRuleCollectionEquivalence(t *testing.T) {
+	v := validate.Struct(&p2pRules{})
+	v.StopOnError = false
+	if v.Validate() {
+		t.Fatalf("empty struct must fail required rules")
+	}
+	got := p2pErrPairs(v.Errors)
+	for _, want := range []string{
+		"nm.required=custom name required",
+		"age.required=age is required to not be empty",
+		"Addr.required=Addr is required to not be empty",
+		"Items.required=Items is required to not be empty",
+	} {
+		if !strings.Contains(strings.Join(got, ";"), want) {
+			t.Fatalf("missing collected error %q in %v", want, got)
+		}
+	}
+	if _, ok := v.Errors["Opt"]; ok {
+		t.Fatalf("optional field must not be validated when empty, got %v", p2pErrPairs(v.Errors))
+	}
+	if got := v.Trans().FieldMap()["Name"]; got != "nm" {
+		t.Fatalf("field output name = %q, want nm", got)
+	}
+	if got := v.Trans().LabelMap()["Name"]; got != "Name Label" {
+		t.Fatalf("label = %q, want Name Label", got)
+	}
+
+	// filter rules must still be collected and applied to the source.
+	filtered := &p2pRules{
+		Name:  "  AbC  ",
+		Age:   3,
+		Addr:  p2pInner{City: "c", Zip: "123"},
+		Items: []p2pInner{{City: "c", Zip: "123"}},
+	}
+	fv := validate.Struct(filtered)
+	if !fv.Validate() {
+		t.Fatalf("filtered name must validate, errors: %v", p2pErrPairs(fv.Errors))
+	}
+	if filtered.Name != "abc" {
+		t.Fatalf("filter rule not applied to source: %q", filtered.Name)
+	}
+
+	// element rules of a dynamic (slice-of-struct) type are collected per value.
+	items := &p2pRules{Name: "abc", Age: 3, Addr: p2pInner{City: "c", Zip: "123"}, Items: []p2pInner{{City: "c"}}}
+	iv := validate.Struct(items)
+	if iv.Validate() {
+		t.Fatalf("slice element Zip=empty must fail")
+	}
+	if _, ok := iv.Errors["Items.0.Zip"]["required"]; !ok {
+		t.Fatalf("per-value element rules missing, errors: %v", p2pErrPairs(iv.Errors))
+	}
+
+	// rule order is preserved: the first failing rule of a field wins with
+	// StopOnError (default true).
+	ordered := validate.Struct(&p2pRules{Name: "ab"})
+	if ordered.Validate() {
+		t.Fatalf("2-char name must fail min_len")
+	}
+	if _, ok := ordered.Errors["nm"]["min_len"]; !ok {
+		t.Fatalf("expected min_len failure for a non-empty short name, got %v", p2pErrPairs(ordered.Errors))
+	}
+
+	type p2pOrderMin struct {
+		V int `validate:"min:5|max:1"`
+	}
+	type p2pOrderMax struct {
+		V int `validate:"max:1|min:5"`
+	}
+	type p2pOptionalRule struct {
+		NonEmpty string `validate:"optional|min_len:4"`
+		Empty    string `validate:"optional|min_len:4"`
+	}
+
+	minFirst := validate.Struct(&p2pOrderMin{V: 3})
+	if minFirst.Validate() {
+		t.Fatalf("order scenario must fail")
+	}
+	if _, ok := minFirst.Errors["V"]["min"]; !ok {
+		t.Fatalf("tag rule order changed (want the first rule min), got %v", p2pErrPairs(minFirst.Errors))
+	}
+	maxFirst := validate.Struct(&p2pOrderMax{V: 3})
+	if maxFirst.Validate() {
+		t.Fatalf("order scenario must fail")
+	}
+	if _, ok := maxFirst.Errors["V"]["max"]; !ok {
+		t.Fatalf("tag rule order changed (want the first rule max), got %v", p2pErrPairs(maxFirst.Errors))
+	}
+	opt := validate.Struct(&p2pOptionalRule{NonEmpty: "ab"})
+	opt.StopOnError = false
+	if opt.Validate() {
+		t.Fatalf("optional non-empty short value must fail")
+	}
+	if _, ok := opt.Errors["NonEmpty"]["min_len"]; !ok {
+		t.Fatalf("optional rule must still validate a non-empty value, got %v", p2pErrPairs(opt.Errors))
+	}
+	if _, ok := opt.Errors["Empty"]; ok {
+		t.Fatalf("optional empty value must be skipped, got %v", p2pErrPairs(opt.Errors))
+	}
+}
