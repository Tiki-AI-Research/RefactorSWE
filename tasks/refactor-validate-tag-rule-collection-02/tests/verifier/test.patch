+// anchoredVariants expands a possibly relative argument into the same relative
+// path anchored at the working directory and its ancestors, so a pipeline path
+// relative to the workspace root still resolves when the command runs from the
+// repository root.
+func anchoredVariants(v string) []string {
+	if filepath.IsAbs(v) {
+		return []string{v}
+	}
+	seen := map[string]bool{filepath.Clean(v): true}
+	out := []string{v}
+	dir, err := os.Getwd()
+	if err != nil {
+		return out
+	}
+	for i := 0; i < 4; i++ {
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			break
+		}
+		dir = parent
+		cand := filepath.Join(dir, v)
+		if !seen[cand] {
+			seen[cand] = true
+			out = append(out, cand)
+		}
+	}
+	return out
+}
+
+// envSelectionValues collects P2P selection values passed through the
+// environment by the pipeline.
+func envSelectionValues() []string {
+	var out []string
+	seen := map[string]bool{}
+	add := func(v string) {
+		v = strings.TrimSpace(v)
+		if v != "" && !seen[v] {
+			seen[v] = true
+			out = append(out, v)
+		}
+	}
+	for _, name := range []string{
+		"P2P_SELECT", "P2P_SELECT_FILE", "P2P_SELECTORS", "P2P_SELECTOR",
+		"VERIFIER_P2P_SELECT", "VERIFIER_SELECT", "VERIFIER_SELECT_FILE",
+		"P2P_CONFIG", "P2P_CONFIG_FILE", "VERIFIER_CONFIG", "VERIFIER_CONFIG_FILE",
+	} {
+		add(os.Getenv(name))
+	}
+	for _, kv := range os.Environ() {
+		name, value, ok := strings.Cut(kv, "=")
+		if !ok {
+			continue
+		}
+		upper := strings.ToUpper(name)
+		if !strings.Contains(upper, "SELECT") && !strings.Contains(upper, "P2P") && !strings.Contains(upper, "VERIFIER") {
+			continue
+		}
+		if strings.Contains(value, "::") {
+			add(value)
+		}
+	}
+	return out
+}
+
+// conventionalSelectionPaths lists the pipeline asset locations that may carry
+// the frozen P2P selection: the repository root and its ancestors, the report
+// directory and its ancestors, the package root, the home directory and the
+// replay workspace roots.
+func conventionalSelectionPaths(root, reportPath string) []string {
+	var dirs []string
+	addDir := func(d string) {
+		if d == "" {
+			return
+		}
+		abs, err := filepath.Abs(d)
+		if err != nil {
+			abs = d
+		}
+		abs = filepath.Clean(abs)
+		for _, x := range dirs {
+			if x == abs {
+				return
+			}
+		}
+		dirs = append(dirs, abs)
+	}
+
+	base := root
+	if base == "" {
+		base = "."
+	}
+	for i := 0; i < 5; i++ {
+		addDir(base)
+		parent := filepath.Dir(base)
+		if parent == base {
+			break
+		}
+		base = parent
+	}
+	if reportPath != "" {
+		dir := filepath.Dir(reportPath)
+		for i := 0; i < 3; i++ {
+			addDir(dir)
+			parent := filepath.Dir(dir)
+			if parent == dir {
+				break
+			}
+			dir = parent
+		}
+	}
+	if cwd, err := os.Getwd(); err == nil {
+		addDir(cwd)
+	}
+	if home, err := os.UserHomeDir(); err == nil {
+		addDir(home)
+	}
+	addDir(os.TempDir())
+	for _, d := range []string{"/tests", "/workspace", "/workspace/repo", "/workspace/verifier"} {
+		addDir(d)
+	}
+
+	var out []string
+	for _, dir := range dirs {
+		out = append(out,
+			filepath.Join(dir, "p2p_select.txt"),
+			filepath.Join(dir, "p2p_select"),
+			filepath.Join(dir, "p2p-select.txt"),
+			filepath.Join(dir, "config.json"),
+			filepath.Join(dir, "verifier", "p2p_select.txt"),
+			filepath.Join(dir, "verifier", "p2p_select"),
+		)
+	}
+	return out
+}
+
+// pipelineP2PSelection reads the frozen P2P selection from the
+// pipeline-materialised assets, if any are reachable.
+func pipelineP2PSelection(root, reportPath string) []selector {
+	for _, value := range envSelectionValues() {
+		if sels, ok := loadPathOrText(value); ok && len(sels) > 0 {
+			return sels
+		}
+	}
+	for _, path := range conventionalSelectionPaths(root, reportPath) {
+		if sels, ok := readSelectorFile(path); ok && len(sels) > 0 {
+			return sels
+		}
+	}
+	return nil
+}
+
+// findRepoRoot locates the module root from the working directory, the running
+// executable or the report path, so the runner also works when it is invoked
+// from outside the repository root.
+func findRepoRoot(start, reportPath string) string {
+	candidates := []string{start}
+	if exe, err := os.Executable(); err == nil {
+		candidates = append(candidates, filepath.Dir(exe))
+	}
+	if reportPath != "" {
+		candidates = append(candidates, filepath.Dir(reportPath))
+	}
+
+	fallback := ""
+	for _, candidate := range candidates {
+		dir, err := filepath.Abs(candidate)
+		if err != nil {
+			continue
+		}
+		if fallback == "" {
+			fallback = dir
+		}
+		for i := 0; i < 6; i++ {
+			if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+				return dir
+			}
+			parent := filepath.Dir(dir)
+			if parent == dir {
+				break
+			}
+			dir = parent
+		}
+	}
+	return fallback
+}
+
+func packagePattern(selPath string) string {
+	dir := filepath.Dir(selPath)
+	if dir == "." || dir == "" {
+		return "."
+	}
+	return "./" + filepath.ToSlash(dir)
+}
+
+type testEvent struct {
+	Action  string  `json:"Action"`
+	Package string  `json:"Package"`
+	Test    string  `json:"Test"`
+	Elapsed float64 `json:"Elapsed"`
+	Output  string  `json:"Output"`
+}
+
+func testChildEnv() []string {
+	env := append(os.Environ(), "GOPROXY=off")
+	if dir := strings.TrimSpace(os.Getenv("VERIFIER_EXEC_DIR")); dir != "" {
+		if err := os.MkdirAll(dir, 0o755); err == nil {
+			env = append(env, "GOTMPDIR="+dir)
+		}
+	}
+	return env
+}
+
+func runPackage(root string, pkg string, sels []selector, timeout time.Duration) map[string]*nodeResult {
+	results := make(map[string]*nodeResult, len(sels))
+	for _, sel := range sels {
+		results[sel.leaf] = &nodeResult{sel: sel, status: "error", message: "test did not run", errorType: "ReportError"}
+	}
+	var pattern string
+	if len(sels) == 1 {
+		// Go splits -run at slashes. Quote and anchor each segment so literal
+		// stars, brackets, dots and punctuation never select another subtest.
+		segments := strings.Split(sels[0].leaf, "/")
+		for i, segment := range segments {
+			segments[i] = "^" + regexp.QuoteMeta(segment) + "$"
+		}
+		pattern = strings.Join(segments, "/")
+	} else {
+		// The package summary records only declared leaves, without scoring parents.
+		seen := map[string]bool{}
+		var tops []string
+		for _, sel := range sels {
+			top := strings.Split(sel.leaf, "/")[0]
+			if !seen[top] {
+				seen[top] = true
+				tops = append(tops, regexp.QuoteMeta(top))
+			}
+		}
+		sort.Strings(tops)
+		pattern = "^(" + strings.Join(tops, "|") + ")$"
+	}
+	cmd := exec.Command("go", "test", "-json", "-count=1", "-timeout", timeout.String(), "-run", pattern, pkg)
+	cmd.Dir, cmd.Env = root, testChildEnv()
+	// The verifier can supply immutable, hash-bound build artifacts. Each
+	// selected leaf still gets a fresh process with the exact same regexp,
+	// count, timeout and package working directory as go test.
+	if prepared := os.Getenv("VERIFIER_PREPARATION_DIR"); prepared != "" {
+		binary := filepath.Join(prepared, strings.ReplaceAll(pkg, "/", "_")+".test")
+		cmd = exec.Command("go", "tool", "test2json", "-t", "-p", pkg, binary,
+			"-test.v=test2json", "-test.count=1", "-test.timeout="+timeout.String(), "-test.run="+pattern)
+		cmd.Dir = filepath.Join(root, strings.TrimPrefix(pkg, "./"))
+		cmd.Env = testChildEnv()
+	}
+
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		for _, res := range results {
+			res.message = "cannot start go test: " + err.Error()
+		}
+		return results
+	}
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		for _, res := range results {
+			res.message = "cannot start go test: " + err.Error()
+		}
+		return results
+	}
+	var packageOutput strings.Builder
+	ancestorOutput := map[string]string{}
+	failedAncestors := map[string]bool{}
+	scanner := bufio.NewScanner(stdout)
+	scanner.Buffer(make([]byte, 0, 64*1024), 8*1024*1024)
+	for scanner.Scan() {
+		var ev testEvent
+		if err := json.Unmarshal(scanner.Bytes(), &ev); err != nil {
+			packageOutput.Write(scanner.Bytes())
+			packageOutput.WriteByte('\n')
+			continue
+		}
+		if ev.Test == "" {
+			packageOutput.WriteString(ev.Output)
+			continue
+		}
+		ancestorOutput[ev.Test] += ev.Output
+		if ev.Action == "fail" {
+			failedAncestors[ev.Test] = true
+		}
+		res, ok := results[ev.Test]
+		if !ok {
+			continue
+		}
+		res.output.WriteString(ev.Output)
+		switch ev.Action {
+		case "pass":
+			res.status, res.elapsed = "pass", ev.Elapsed
+		case "fail":
+			res.status, res.elapsed, res.message = "fail", ev.Elapsed, "test assertion failed"
+		case "skip":
+			res.status, res.elapsed, res.message = "skip", ev.Elapsed, "test skipped"
+		}
+	}
+	scanErr, waitErr := scanner.Err(), cmd.Wait()
+	buildOutput := packageOutput.String() + stderr.String()
+	if scanErr != nil {
+		buildOutput += "\nreport error: " + scanErr.Error()
+	}
+	for _, res := range results {
+		if res.status != "error" {
+			continue
+		}
+		// Preserve an actual assertion in an ancestor that prevents the leaf from starting.
+		parts := strings.Split(res.sel.leaf, "/")
+		for i := 1; i < len(parts); i++ {
+			ancestor := strings.Join(parts[:i], "/")
+			if failedAncestors[ancestor] {
+				res.status, res.message = "fail", "owning test assertion failed before selected subtest"
+				res.output.WriteString(ancestorOutput[ancestor])
+				break
+			}
+		}
+		if res.status != "error" {
+			continue
+		}
+		if strings.Contains(buildOutput, "[build failed]") {
+			res.errorType, res.phase = "CompileError", "compile"
+		} else if strings.Contains(buildOutput, "test timed out") {
+			res.errorType = "Timeout"
+		}
+		if waitErr != nil {
+			res.message = "go test did not complete: " + waitErr.Error()
+		}
+		res.output.WriteString(buildOutput)
+	}
+	return results
+}
+
+type xmlFailure struct {
+	Message string `xml:"message,attr"`
+	Type    string `xml:"type,attr,omitempty"`
+	Phase   string `xml:"phase,attr,omitempty"`
+	Body    string `xml:",chardata"`
+}
+
+type xmlTestCase struct {
+	Classname string      `xml:"classname,attr"`
+	Name      string      `xml:"name,attr"`
+	File      string      `xml:"file,attr"`
+	Selector  string      `xml:"selector,attr"`
+	Time      string      `xml:"time,attr"`
+	Failure   *xmlFailure `xml:"failure,omitempty"`
+	Error     *xmlFailure `xml:"error,omitempty"`
+	Skipped   *xmlFailure `xml:"skipped,omitempty"`
+}
+
+type xmlSuite struct {
+	Name      string        `xml:"name,attr"`
+	Tests     int           `xml:"tests,attr"`
+	Failures  int           `xml:"failures,attr"`
+	Errors    int           `xml:"errors,attr"`
+	Skipped   int           `xml:"skipped,attr"`
+	Time      string        `xml:"time,attr"`
+	TestCases []xmlTestCase `xml:"testcase"`
+}
+
+type xmlSuites struct {
+	XMLName  xml.Name   `xml:"testsuites"`
+	Name     string     `xml:"name,attr"`
+	Tests    int        `xml:"tests,attr"`
+	Failures int        `xml:"failures,attr"`
+	Errors   int        `xml:"errors,attr"`
+	Skipped  int        `xml:"skipped,attr"`
+	Time     string     `xml:"time,attr"`
+	Suites   []xmlSuite `xml:"testsuite"`
+}
+
+func main() {
+	selectValue := flag.String("select", "", "selection file path or inline selector text")
+	nodeValue := flag.String("node", "", "single exact path::leaf selector to run alone")
+	reportPath := flag.String("report", "", "path of the JUnit report to write ({report})")
+	rootFlag := flag.String("root", ".", "repository root that contains go.mod")
+	timeout := flag.Duration("timeout", 240*time.Second, "per-package go test timeout")
+	flag.Parse()
+
+	if *reportPath == "" {
+		fmt.Fprintln(os.Stderr, "f2p_runner: -report is required")
+		os.Exit(2)
+	}
+
+	root := findRepoRoot(*rootFlag, *reportPath)
+
+	var sels []selector
+	if strings.TrimSpace(*nodeValue) != "" {
+		sels = parseSelectors([]byte(*nodeValue))
+		if len(sels) == 0 {
+			fmt.Fprintf(os.Stderr, "f2p_runner: -node carries no `path::leaf` selector: %q\n", *nodeValue)
+			os.Exit(2)
+		}
+	} else {
+		var explicit []selector
+		if strings.TrimSpace(*selectValue) != "" {
+			if loaded, ok := loadPathOrText(*selectValue); ok {
+				explicit = loaded
+			} else {
+				fmt.Fprintf(os.Stderr, "f2p_runner: -select carries no readable selection or selector text (%q); using the declared selector sets\n", *selectValue)
+			}
+		}
+		// Summary run: the exact F2P selectors declared by this plan plus the
+		// exact selectors of the frozen P2P plan, and nothing else.
+		sels = unionSelectors(
+			explicit,
+			pipelineP2PSelection(root, *reportPath),
+			selectorsFromList(declaredF2PSelectors),
+			selectorsFromList(declaredP2PSelectors),
+		)
+	}
+
+	byPkg := map[string][]selector{}
+	for _, sel := range sels {
+		pkg := packagePattern(sel.path)
+		byPkg[pkg] = append(byPkg[pkg], sel)
+	}
+	pkgs := make([]string, 0, len(byPkg))
+	for pkg := range byPkg {
+		pkgs = append(pkgs, pkg)
+	}
+	sort.Strings(pkgs)
+
+	suites := xmlSuites{Name: "f2p"}
+	start := time.Now()
+	for _, pkg := range pkgs {
+		res := runPackage(root, pkg, byPkg[pkg], *timeout)
+		leaves := make([]string, 0, len(res))
+		for leaf := range res {
+			leaves = append(leaves, leaf)
+		}
+		sort.Strings(leaves)
+
+		suite := xmlSuite{Name: pkg}
+		var suiteTime float64
+		for _, leaf := range leaves {
+			node := res[leaf]
+			tc := xmlTestCase{
+				Classname: node.sel.path,
+				Name:      node.sel.leaf,
+				File:      node.sel.path,
+				Selector:  node.sel.String(),
+				Time:      fmt.Sprintf("%.3f", node.elapsed),
+			}
+			body := node.output.String()
+			switch node.status {
+			case "pass":
+			case "fail":
+				tc.Failure = &xmlFailure{Message: node.message, Type: "AssertionFailure", Body: body}
+				suite.Failures++
+			case "skip":
+				tc.Skipped = &xmlFailure{Message: node.message, Body: body}
+				suite.Skipped++
+			default:
+				tc.Error = &xmlFailure{Message: node.message, Type: node.errorType, Phase: node.phase, Body: body}
+				suite.Errors++
+			}
+			suiteTime += node.elapsed
+			suite.TestCases = append(suite.TestCases, tc)
+		}
+		suite.Tests = len(suite.TestCases)
+		suite.Time = fmt.Sprintf("%.3f", suiteTime)
+		suites.Suites = append(suites.Suites, suite)
+		suites.Tests += suite.Tests
+		suites.Failures += suite.Failures
+		suites.Errors += suite.Errors
+		suites.Skipped += suite.Skipped
+	}
+	suites.Time = fmt.Sprintf("%.3f", time.Since(start).Seconds())
+
+	bs, err := xml.MarshalIndent(suites, "", "  ")
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "f2p_runner: cannot encode JUnit report: %v\n", err)
+		os.Exit(2)
+	}
+	out := append([]byte(xml.Header), bs...)
+	out = append(out, '\n')
+	if dir := filepath.Dir(*reportPath); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			fmt.Fprintf(os.Stderr, "f2p_runner: cannot create report dir: %v\n", err)
+			os.Exit(2)
+		}
+	}
+	if err := os.WriteFile(*reportPath, out, 0o644); err != nil {
+		fmt.Fprintf(os.Stderr, "f2p_runner: cannot write report: %v\n", err)
+		os.Exit(2)
+	}
+	fmt.Fprintf(os.Stderr, "f2p_runner: wrote %s (tests=%d failures=%d errors=%d skipped=%d)\n",
+		*reportPath, suites.Tests, suites.Failures, suites.Errors, suites.Skipped)
+	if suites.Failures > 0 || suites.Errors > 0 || suites.Skipped > 0 {
+		os.Exit(1)
+	}
+}
