+func TestP2PPooledReuseIsolationAndFactoryEquivalence(t *testing.T) {
+	f := validate.NewFactory()
+
+	a := f.Struct(&p2pFlat{Name: "x"})
+	if a.Validate() {
+		t.Fatalf("expected failure for short name")
+	}
+	wantA := strings.Join(p2pErrPairs(a.Errors), ";")
+	a.Release()
+
+	b := f.Struct(&p2pNested{Name: "n", Addr: p2pInner{City: "c", Zip: "123"}})
+	if !b.Validate() {
+		t.Fatalf("second pooled validation leaked state, errors: %v", p2pErrPairs(b.Errors))
+	}
+	b.Release()
+
+	c := f.Struct(&p2pFlat{Name: "x"})
+	if c.Validate() {
+		t.Fatalf("expected failure for short name after reuse")
+	}
+	if got := strings.Join(p2pErrPairs(c.Errors), ";"); got != wantA {
+		t.Fatalf("pooled reuse changed the result: %q != %q", got, wantA)
+	}
+	c.Release()
+
+	// pooled result must equal the non-pooled path.
+	data := &p2pFlat{Name: "abc", Age: 3}
+	nonPooled := validate.Struct(&p2pFlat{Name: "abc", Age: 3})
+	pooled := f.Struct(data)
+	if nonPooled.Validate() != pooled.Validate() {
+		t.Fatalf("pooled and non-pooled validation disagree")
+	}
+	if got, want := strings.Join(p2pErrPairs(pooled.Errors), ";"), strings.Join(p2pErrPairs(nonPooled.Errors), ";"); got != want {
+		t.Fatalf("pooled errors %q != non-pooled %q", got, want)
+	}
+	pooled.Release()
+
+	// Check()/ValidateR() equivalence on a fresh type.
+	res := validate.Check(&p2pInner{City: "c", Zip: "123"})
+	if !res.IsOK() {
+		t.Fatalf("Check() must pass for a valid struct, errors: %v", p2pErrPairs(res.Errors))
+	}
+	bad := validate.Check(&p2pInner{City: "c"})
+	if bad.IsOK() {
+		t.Fatalf("Check() must fail for a missing Zip")
+	}
+	if _, ok := bad.Errors["Zip"]["required"]; !ok {
+		t.Fatalf("Check() errors missing Zip.required: %v", p2pErrPairs(bad.Errors))
+	}
+}
