+func TestP2PEntryPointsAndCreationError(t *testing.T) {
+	data := &p2pFlat{Name: "x"}
+	v1 := validate.Struct(data)
+	v2 := validate.New(&p2pFlat{Name: "x"})
+	if v1.Validate() != v2.Validate() {
+		t.Fatalf("Struct and New(struct) disagree on the same data")
+	}
+	if got := p2pErrPairs(v1.Errors); strings.Join(got, ";") != "user_name.min_len=User Name min length is 3" {
+		t.Fatalf("Struct errors = %v, want the tag-driven min_len message", got)
+	}
+	emptyFlat := validate.Struct(&p2pFlat{})
+	if emptyFlat.Validate() {
+		t.Fatalf("empty Name must fail required")
+	}
+	if got := emptyFlat.Errors["user_name"]["required"]; got != "user name required" {
+		t.Fatalf("custom required message = %q, want %q", got, "user name required")
+	}
+
+	d, err := validate.FromStruct(&p2pFlat{Name: "x"})
+	if err != nil {
+		t.Fatalf("FromStruct returned error: %v", err)
+	}
+	v3 := d.Create()
+	if v3.Validate() != v1.Validate() {
+		t.Fatalf("StructData.Create disagrees with Struct()")
+	}
+	if got, want := p2pErrPairs(v3.Errors), p2pErrPairs(v1.Errors); strings.Join(got, ";") != strings.Join(want, ";") {
+		t.Fatalf("StructData.Create errors = %v, want %v", got, want)
+	}
+
+	// NewValidation wraps the data source; manual rules must observe the same
+	// struct values through the data source.
+	d2, err := validate.FromStruct(&p2pFlat{Name: "x"})
+	if err != nil {
+		t.Fatalf("FromStruct returned error: %v", err)
+	}
+	v4 := validate.NewValidation(d2).StringRule("Name", "required|min_len:3")
+	if v4.Validate() != v1.Validate() {
+		t.Fatalf("NewValidation + manual rule disagrees with Struct()")
+	}
+	if _, ok := v4.Errors["Name"]["min_len"]; !ok {
+		t.Fatalf("NewValidation must read struct values through the data source, errors: %v", p2pErrPairs(v4.Errors))
+	}
+
+	boom := errors.New("creation failed")
+	for name, v := range map[string]*validate.Validation{
+		"Create":     d.Create(boom),
+		"Validation": d.Validation(boom),
+	} {
+		if v.Validate() {
+			t.Fatalf("%s(err) must keep the creation failure", name)
+		}
+		if got := v.Errors.One(); got != "creation failed" {
+			t.Fatalf("%s(err) error text = %q, want %q", name, got, "creation failed")
+		}
+	}
+
+	// the non-nil creation error must win over tag-driven rules, unchanged.
+	empty, err := validate.FromStruct(&p2pFlat{})
+	if err != nil {
+		t.Fatalf("FromStruct returned error: %v", err)
+	}
+	ve := empty.Create(boom)
+	if ve.Validate() {
+		t.Fatalf("creation error must short-circuit tag rules")
+	}
+	if got := p2pErrPairs(ve.Errors); strings.Join(got, ";") != "creation failed" && len(got) != 1 {
+		t.Fatalf("creation error must be the only reported error, got %v", got)
+	}
+}
