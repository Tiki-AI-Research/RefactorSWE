+func TestP2PStaticTemplatePerInstanceIsolation(t *testing.T) {
+	valid := func() *p2pConc {
+		return &p2pConc{Name: "ann", Age: 30, Addr: p2pInner{City: "c", Zip: "123"}}
+	}
+
+	// warm the shared static template
+	if v := validate.Struct(valid()); !v.Validate() {
+		t.Fatalf("warm-up validation must pass, errors: %v", p2pErrPairs(v.Errors))
+	}
+
+	v1 := validate.Struct(valid())
+	v1.StringRule("Extra", "required")
+	v1.FilterRule("Name", "upper")
+
+	// Mutate the existing cached filter rule through a test-only view so this
+	// test distinguishes per-instance filter ownership from merely appending a
+	// new rule. A shared cached pointer would make v2 observe this mutation.
+	rulesField := reflect.ValueOf(v1).Elem().FieldByName("filterRules")
+	if !rulesField.IsValid() || rulesField.Len() == 0 {
+		t.Fatalf("cached filter rule missing")
+	}
+	rules := reflect.NewAt(rulesField.Type(), unsafe.Pointer(rulesField.UnsafeAddr())).Elem()
+	firstRule := rules.Index(0).Elem()
+	filtersField := firstRule.FieldByName("filters")
+	filters := reflect.NewAt(filtersField.Type(), unsafe.Pointer(filtersField.UnsafeAddr())).Elem()
+	filters.Set(reflect.ValueOf([]string{"upper"}))
+	if v1.Validate() {
+		t.Fatalf("the mutated instance must observe its own added rule")
+	}
+	if _, ok := v1.Errors["Extra"]["required"]; !ok {
+		t.Fatalf("added per-instance rule missing, errors: %v", p2pErrPairs(v1.Errors))
+	}
+
+	u2 := &p2pConc{Name: "  ann  ", Age: 30, Addr: p2pInner{City: "c", Zip: "123"}}
+	v2 := validate.Struct(u2)
+	if !v2.Validate() {
+		t.Fatalf("a fresh instance must not inherit per-instance mutations, errors: %v", p2pErrPairs(v2.Errors))
+	}
+	if _, ok := v2.Errors["Extra"]; ok {
+		t.Fatalf("shared template leaked the added rule: %v", p2pErrPairs(v2.Errors))
+	}
+	if u2.Name != "ann" {
+		t.Fatalf("shared template leaked the existing filter mutation: got %q, want ann", u2.Name)
+	}
+
+	v3 := validate.Struct(&p2pConc{Name: "x"})
+	v3.StopOnError = false
+	if v3.Validate() {
+		t.Fatalf("a fresh instance must still reject invalid values")
+	}
+	if _, ok := v3.Errors["Name"]["min_len"]; !ok {
+		t.Fatalf("shared template lost its rules: %v", p2pErrPairs(v3.Errors))
+	}
+	if _, ok := v3.Errors["Extra"]; ok {
+		t.Fatalf("shared template leaked the added rule to a third instance: %v", p2pErrPairs(v3.Errors))
+	}
+}
