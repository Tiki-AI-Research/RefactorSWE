+package validate_test
+
+// F2P: StructData must retain source binding duties while tag-rule collection
+// belongs to the rule-engine side. Each test below checks one collection
+// boundary so each F2P node corresponds to one atomic responsibility.
+
+import "testing"
+
+func f2pAssertStructDataDoesNotCall(t *testing.T, apis map[string]bool, message string) {
+	t.Helper()
+	src := f2pLoadSource(t)
+	var offenders []string
+	methods := 0
+	for _, fn := range src.Funcs {
+		if fn.Recv != "StructData" {
+			continue
+		}
+		methods++
+		if hit := f2pIntersects(fn.Calls, apis); len(hit) > 0 {
+			offenders = append(offenders, fn.id()+" calls "+f2pJoin(hit))
+		}
+	}
+	if methods == 0 {
+		t.Fatal("no StructData methods found in the production package")
+	}
+	if len(offenders) > 0 {
+		t.Fatalf("%s: %v", message, offenders)
+	}
+}
+
+func TestF2PStructDataMethodsDoNotParseValidationRules(t *testing.T) {
+	f2pAssertStructDataDoesNotCall(t, map[string]bool{"StringRule": true},
+		"StructData still parses validation rules directly")
+}
+
+func TestF2PStructDataMethodsDoNotParseFilterRules(t *testing.T) {
+	f2pAssertStructDataDoesNotCall(t, map[string]bool{"FilterRule": true},
+		"StructData still parses filter rules directly")
+}
+
+func TestF2PStructDataMethodsDoNotReplayDefaultValues(t *testing.T) {
+	f2pAssertStructDataDoesNotCall(t, map[string]bool{"SetDefValue": true},
+		"StructData still replays default values directly")
+}
+
+func TestF2PStructDataMethodsDoNotReplayOptionalRules(t *testing.T) {
+	f2pAssertStructDataDoesNotCall(t, map[string]bool{"optional replay": true},
+		"StructData still replays optional rules directly")
+}
+
+func TestF2PStructDataMethodsDoNotCloneTemplateRules(t *testing.T) {
+	f2pAssertStructDataDoesNotCall(t, map[string]bool{"cloneRule": true},
+		"StructData still clones cached validation rules directly")
+}
+
+func TestF2PStructDataMethodsDoNotCloneTemplateFilterRules(t *testing.T) {
+	f2pAssertStructDataDoesNotCall(t, map[string]bool{"cloneFilterRule": true},
+		"StructData still clones cached filter rules directly")
+}
+
+func TestF2PStructDataMethodsDoNotCollectLabels(t *testing.T) {
+	f2pAssertStructDataDoesNotCall(t, map[string]bool{"addLabelName": true, "AddLabelMap": true},
+		"StructData still collects label translations directly")
+}
+
+func TestF2PStructDataMethodsDoNotCollectOutputNames(t *testing.T) {
+	f2pAssertStructDataDoesNotCall(t, map[string]bool{"AddFieldMap": true},
+		"StructData still collects output-name mappings directly")
+}
+
+func TestF2PStructDataMethodsDoNotCollectCustomMessages(t *testing.T) {
+	f2pAssertStructDataDoesNotCall(t, map[string]bool{"AddMessage": true, "AddMessages": true},
+		"StructData still collects custom messages directly")
+}
diff --git a/tests/f2p_rule_collection_component_test.go b/tests/f2p_rule_collection_component_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..be8ac30d588c5e63f7989fc8ce7946b01c8c3a5b
--- /dev/null
+++ b/tests/f2p_rule_collection_component_test.go
@@ -0,0 +1,170 @@
+package validate_test
+
+// F2P: each tag-derived collection responsibility must be implemented by a
+// rule-engine-side component reachable from StructData.Create.
+
+import (
+	"sort"
+	"testing"
+
+	"github.com/gookit/validate/v2"
+)
+
+func f2pAssertExternalCollector(t *testing.T, apis map[string]bool, description string) {
+	t.Helper()
+	src := f2pLoadSource(t)
+	create := src.method("StructData", "Create")
+	if create == nil {
+		t.Fatal("StructData.Create is missing from the production package")
+	}
+
+	var owners []string
+	for fn := range src.reachable(create) {
+		if fn.Recv == "StructData" {
+			continue
+		}
+		if len(f2pIntersects(fn.Calls, apis)) == 0 {
+			continue
+		}
+		if !f2pReadsStructTags(fn) && !f2pConsumesScanMetadata(src, fn) &&
+			!f2pHasExternalTagReaderCaller(src, fn) && !f2pHasExternalTagReaderCallee(src, fn) {
+			continue
+		}
+		owners = append(owners, fn.id())
+	}
+	sort.Strings(owners)
+	if len(owners) == 0 {
+		t.Fatalf("%s: no external collector is reachable from StructData.Create", description)
+	}
+}
+
+func TestF2PExternalComponentOwnsValidationRuleParsing(t *testing.T) {
+	f2pAssertExternalCollector(t, map[string]bool{"StringRule": true},
+		"validation-rule parsing remains on the data source")
+	// A syntactic call to StringRule is insufficient: the reachable collector
+	// must install a tag-derived rule for an ordinary validation input.
+	v := validate.Struct(&struct {
+		Name string `validate:"required"`
+	}{})
+	if v.Validate() {
+		t.Fatal("the external collector did not install the required tag rule")
+	}
+	if _, ok := v.Errors["Name"]["required"]; !ok {
+		t.Fatalf("the required tag rule was not reported: %v", v.Errors)
+	}
+}
+
+func TestF2PExternalComponentOwnsFilterRuleParsing(t *testing.T) {
+	f2pAssertExternalCollector(t, map[string]bool{"FilterRule": true},
+		"filter-rule parsing remains on the data source")
+}
+
+func TestF2PExternalComponentOwnsLabelCollection(t *testing.T) {
+	f2pAssertExternalCollector(t, map[string]bool{"addLabelName": true, "AddLabelMap": true},
+		"label collection remains on the data source")
+}
+
+func TestF2PExternalComponentOwnsOutputNameCollection(t *testing.T) {
+	f2pAssertExternalCollector(t, map[string]bool{"AddFieldMap": true},
+		"output-name collection remains on the data source")
+}
+
+func TestF2PExternalComponentOwnsCustomMessageCollection(t *testing.T) {
+	f2pAssertExternalCollector(t, map[string]bool{"AddMessage": true, "AddMessages": true},
+		"custom-message collection remains on the data source")
+}
+
+func TestF2PCreatePathDelegatesToExternalCollector(t *testing.T) {
+	src := f2pLoadSource(t)
+	create := src.method("StructData", "Create")
+	if create == nil {
+		t.Fatal("StructData.Create is missing from the production package")
+	}
+
+	var external []string
+	for fn := range src.reachable(create) {
+		if fn.Recv == "StructData" {
+			continue
+		}
+		if hit := f2pIntersects(fn.Calls, f2pAllTagAPIs()); len(hit) > 0 && src.collectionContext(fn) {
+			external = append(external, fn.id()+" calls "+f2pJoin(hit))
+		}
+	}
+	if len(external) == 0 {
+		t.Fatal("StructData.Create does not delegate tag collection to an external component")
+	}
+}
+
+// Default replay and optional replay are independent responsibilities. The
+// component may implement them in different functions.
+func f2pAssertTemplateResponsibilityIsExternal(t *testing.T, api string) {
+	t.Helper()
+	src := f2pLoadSource(t)
+	create := src.method("StructData", "Create")
+	if create == nil {
+		t.Fatal("StructData.Create is missing from the production package")
+	}
+	var owners, onDataSource []string
+	for fn := range src.reachable(create) {
+		owns := fn.Calls[api]
+		if api == "optional replay" {
+			owns = src.ownsOptionalReplay(fn)
+		}
+		if !owns {
+			continue
+		}
+		owners = append(owners, fn.id())
+		if fn.Recv == "StructData" {
+			onDataSource = append(onDataSource, fn.id())
+		}
+	}
+	if len(owners) == 0 {
+		t.Fatalf("no reachable component owns template responsibility %s", api)
+	}
+	if len(onDataSource) > 0 {
+		t.Fatalf("template responsibility %s is still owned by StructData: %v", api, onDataSource)
+	}
+}
+
+func TestF2PStaticDefaultReplayPathIsExternal(t *testing.T) {
+	f2pAssertTemplateResponsibilityIsExternal(t, "SetDefValue")
+}
+
+func TestF2PStaticOptionalReplayPathIsExternal(t *testing.T) {
+	f2pAssertTemplateResponsibilityIsExternal(t, "optional replay")
+}
+
+func f2pAssertDynamicPathIsExternal(t *testing.T, api string) {
+	t.Helper()
+	src := f2pLoadSource(t)
+	create := src.method("StructData", "Create")
+	if create == nil {
+		t.Fatal("StructData.Create is missing from the production package")
+	}
+
+	reached := src.reachable(create)
+	var parsers, onDataSource []string
+	for fn := range reached {
+		isParser := fn.Calls[api]
+		if isParser {
+			parsers = append(parsers, fn.id())
+			if fn.Recv == "StructData" {
+				onDataSource = append(onDataSource, fn.id())
+			}
+		}
+	}
+	if len(parsers) == 0 {
+		t.Fatal("the create path does not reach an external dynamic tag parser")
+	}
+	if len(onDataSource) > 0 {
+		t.Fatalf("dynamic rule parsing is still performed by StructData methods: %v", onDataSource)
+	}
+}
+
+func TestF2PDynamicValidationRulePathIsExternal(t *testing.T) {
+	f2pAssertDynamicPathIsExternal(t, "StringRule")
+}
+
+func TestF2PDynamicFilterRulePathIsExternal(t *testing.T) {
+	f2pAssertDynamicPathIsExternal(t, "FilterRule")
+}
