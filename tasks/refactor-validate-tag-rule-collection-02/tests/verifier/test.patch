+// selectorsFromList parses selectors out of an explicit list of strings.
+func selectorsFromList(items []string) []selector {
+	seen := map[string]bool{}
+	var out []selector
+	for _, item := range items {
+		for _, match := range selectorRe.FindAllStringSubmatch(item, -1) {
+			sel := selector{path: strings.TrimPrefix(filepath.ToSlash(match[1]), "./"), leaf: match[2]}
+			if seen[sel.String()] {
+				continue
+			}
+			seen[sel.String()] = true
+			out = append(out, sel)
+		}
+	}
+	return out
+}
+
+// unionSelectors merges selector lists, preserving first-seen order.
+func unionSelectors(lists ...[]selector) []selector {
+	seen := map[string]bool{}
+	var out []selector
+	for _, list := range lists {
+		for _, sel := range list {
+			if seen[sel.String()] {
+				continue
+			}
+			seen[sel.String()] = true
+			out = append(out, sel)
+		}
+	}
+	return out
+}
+
+// p2pSelectorsFromJSON reads the frozen P2P rows of a pipeline plan document.
+// It only accepts a document that carries a top-level p2p/p2p_select list, so
+// an unrelated JSON asset can never widen the selection.
+func p2pSelectorsFromJSON(raw []byte) ([]selector, bool) {
+	var doc any
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		return nil, false
+	}
+	obj, ok := doc.(map[string]any)
+	if !ok {
+		return nil, false
+	}
+	seen := map[string]bool{}
+	var out []selector
+	add := func(path, leaf string) {
+		path = filepath.ToSlash(strings.TrimSpace(path))
+		leaf = strings.TrimSpace(leaf)
+		if i := strings.Index(leaf, "::"); i >= 0 {
+			if p := strings.TrimSpace(leaf[:i]); p != "" {
+				path, leaf = filepath.ToSlash(p), strings.TrimSpace(leaf[i+2:])
+			}
+		}
+		if !strings.HasSuffix(path, ".go") || leaf == "" {
+			return
+		}
+		sel := selector{path: path, leaf: leaf}
+		if seen[sel.String()] {
+			return
+		}
+		seen[sel.String()] = true
+		out = append(out, sel)
+	}
+	for _, key := range []string{"p2p", "p2p_select"} {
+		items, ok := obj[key].([]any)
+		if !ok {
+			continue
+		}
+		for _, item := range items {
+			switch entry := item.(type) {
+			case string:
+				for _, sel := range parseSelectors([]byte(entry)) {
+					add(sel.path, sel.leaf)
+				}
+			case map[string]any:
+				path, _ := entry["path"].(string)
+				if path == "" {
+					if path, _ = entry["test"].(string); path == "" {
+						path, _ = entry["selector"].(string)
+					}
+				}
+				leaf, _ := entry["leaf"].(string)
+				if leaf == "" {
+					leaf, _ = entry["selector"].(string)
+				}
+				if path != "" && leaf != "" {
+					add(path, leaf)
+				}
+			}
+		}
+		return out, true
+	}
+	return nil, false
+}
+
+// readSelectorFile reads one candidate selection asset. Plain selector text is
+// only accepted from the pipeline's p2p select assets; a JSON document is only
+// accepted when it carries the top-level p2p/p2p_select list.
+func readSelectorFile(path string) ([]selector, bool) {
+	bs, err := os.ReadFile(path)
+	if err != nil {
+		return nil, false
+	}
+	base := strings.ToLower(filepath.Base(path))
+	if strings.HasPrefix(base, "p2p_select") || strings.HasPrefix(base, "p2p-select") {
+		if sels := parseSelectors(bs); len(sels) > 0 {
+			return sels, true
+		}
+	}
+	if sels, ok := p2pSelectorsFromJSON(bs); ok && len(sels) > 0 {
+		return sels, true
+	}
+	return nil, false
+}
