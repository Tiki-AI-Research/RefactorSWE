+package validate_test
+
+// F2P: the duplicated struct-type traversal must collapse into one
+// authoritative scan (REQ-STRUCT-002) whose field metadata drives the rule
+// collection (REQ-STRUCT-001 / REQ-STRUCT-003). Metadata consumption and
+// duplicate field enumeration are independently scored.
+
+import (
+	"go/ast"
+	"testing"
+
+	"github.com/gookit/validate/v2"
+)
+
+func TestF2PTagCollectorsDoNotEnumerateStructFields(t *testing.T) {
+	src := f2pLoadSource(t)
+	checked := 0
+	var offenders []string
+	for _, fn := range src.directCallers(f2pRuleAPIs) {
+		checked++
+		if f2pEnumeratesTypeFields(fn) {
+			offenders = append(offenders, fn.id())
+		}
+	}
+	if checked == 0 {
+		t.Fatal("no struct-tag rule collector found in the production package")
+	}
+	if len(offenders) > 0 {
+		t.Fatalf("tag collectors still enumerate struct-type fields themselves: %v", offenders)
+	}
+}
+
+// Independent scans must collapse to one authority. A cooperating pair of
+// setup/walk helpers remains one scan and is allowed.
+func TestF2PSingleAuthoritativeFieldEnumeration(t *testing.T) {
+	src := f2pLoadSource(t)
+	groups := src.enumerationComponents()
+	if len(groups) != 1 {
+		var authorities [][]string
+		for _, group := range groups {
+			authorities = append(authorities, f2pFuncNames(group))
+		}
+		t.Fatalf("expected one authoritative struct-field scan, found %d independent scans: %v", len(groups), authorities)
+	}
+}
+
+// TestF2PClassificationNotSourcedFromSecondScan asserts that the static/dynamic
+// classification stored on the cached type metadata is not produced by a call
+// chain that enumerates struct fields. Every assignment or composite-literal
+// initialization of a value-carrying metadata field is inspected, so wrapping
+// the second enumeration in a helper, negating its result or initializing the
+// field inside a composite literal cannot hide it. The classification must
+// come out of the same authoritative scan that builds the metadata.
+func TestF2PClassificationNotSourcedFromSecondScan(t *testing.T) {
+	src := f2pLoadSource(t)
+
+	var offenders []string
+	checked := 0
+	for _, fn := range src.Funcs {
+		locals := src.localRefs(fn)
+		ast.Inspect(fn.Decl.Body, func(node ast.Node) bool {
+			switch st := node.(type) {
+			case *ast.AssignStmt:
+				for i, lhs := range st.Lhs {
+					if i >= len(st.Rhs) {
+						continue
+					}
+					sel, ok := lhs.(*ast.SelectorExpr)
+					if !ok || !src.isClassificationTarget(fn, sel, locals) {
+						continue
+					}
+					checked++
+					if callee, ok := src.exprReachesEnumerator(st.Rhs[i]); ok {
+						offenders = append(offenders, fn.id()+" sets "+sel.Sel.Name+" from "+callee)
+					}
+				}
+			case *ast.CompositeLit:
+				ref := f2pTypeRefOf(st.Type)
+				for _, elt := range st.Elts {
+					kv, ok := elt.(*ast.KeyValueExpr)
+					if !ok {
+						continue
+					}
+					key, ok := kv.Key.(*ast.Ident)
+					if !ok || !src.isClassificationField(ref.Base, key.Name) {
+						continue
+					}
+					checked++
+					if callee, ok := src.exprReachesEnumerator(kv.Value); ok {
+						offenders = append(offenders, fn.id()+" initializes "+key.Name+" from "+callee)
+					}
+				}
+			}
+			return true
+		})
+	}
+
+	if checked == 0 {
+		t.Fatal("no static/dynamic classification assignment on the cached type metadata was found; the classification must be produced by the authoritative type scan")
+	}
+	if len(offenders) > 0 {
+		t.Fatalf("the static/dynamic classification is sourced from a struct-field enumeration instead of the authoritative scan: %v", offenders)
+	}
+}
+
+// Each template responsibility must remain reachable independently; a
+// collector may split replay among helpers without changing the contract.
+func f2pAssertTemplateResponsibilityIsReached(t *testing.T, api string) {
+	t.Helper()
+	src := f2pLoadSource(t)
+	create := src.method("StructData", "Create")
+	if create == nil {
+		t.Fatal("StructData.Create is missing from the production package")
+	}
+	reached := src.reachable(create)
+	for _, fn := range src.Funcs {
+		owns := fn.Calls[api]
+		if api == "optional replay" {
+			owns = src.ownsOptionalReplay(fn)
+		}
+		if !owns {
+			continue
+		}
+		if fn.Recv != "StructData" && reached[fn] && src.collectionContext(fn) {
+			return
+		}
+	}
+	t.Fatalf("no external component for template responsibility %s is reachable from StructData.Create", api)
+}
+
+func TestF2PExternalStaticDefaultReplayIsReached(t *testing.T) {
+	f2pAssertTemplateResponsibilityIsReached(t, "SetDefValue")
+}
+
+func TestF2PExternalStaticOptionalReplayIsReached(t *testing.T) {
+	f2pAssertTemplateResponsibilityIsReached(t, "optional replay")
+}
+
+// Configuration invalidates collection templates even when the public data
+// source was bound before Config. This checks only the observable cascade
+// policy; it does not inspect metadata, cache names or collector structure.
+func TestF2PReusedSourceInvalidatesTemplateAfterCascadeConfig(t *testing.T) {
+	validate.ResetOption()
+	validate.ResetTypeCache()
+	defer func() {
+		validate.ResetOption()
+		validate.ResetTypeCache()
+	}()
+	type child struct {
+		Name string `validate:"required"`
+	}
+	type source struct {
+		Child child
+	}
+	d, err := validate.FromStruct(&source{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Warm this type's template under the default marked-parent policy.
+	if v := d.Create(); !v.Validate() {
+		t.Fatalf("unmarked child must initially be skipped: %v", v.Errors)
+	}
+	validate.Config(func(opt *validate.GlobalOption) {
+		opt.CheckSubOnParentMarked = false
+	})
+	// Keep the same source, type and values; only the public option changed.
+	v := d.Create()
+	if v.Validate() {
+		t.Fatal("reused source ignored CheckSubOnParentMarked=false after template warmup")
+	}
+	if _, ok := v.Errors["Child.Name"]["required"]; !ok {
+		t.Fatalf("missing Child.Name.required after enabling cascade: %v", v.Errors)
+	}
+}
diff --git a/tests/f2p_source_model_test.go b/tests/f2p_source_model_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..221d4e4494eda36bb9ac74b295ba5219d618e319
--- /dev/null
+++ b/tests/f2p_source_model_test.go
@@ -0,0 +1,1305 @@
+package validate_test
+
+// Source-model helpers for the F2P structural checks.
+//
+// The frozen task is an internal refactor: observable validation results must
+// not change, so the fail-to-pass acceptance surface is the responsibility
+// boundary and the data flow of the production source itself. These helpers
+// parse the module's root package (the package that owns StructData, Validation
+// and the struct-tag rule collection) with go/parser and expose a small call
+// graph plus the declared type model. Every F2P test below makes exactly one
+// structural assertion over that model, so a Baseline that still keeps the rule
+// collection and the duplicated struct-type traversal on the data source fails
+// the assertion while a refactored implementation passes it.
+//
+// The helpers deliberately link a claimed relation with evidence: a function
+// "parses struct tags into rules" only when it both calls a rule API and either
+// reads struct tags itself or consumes the field metadata produced by the
+// authoritative type scan; a "classification assignment" is only accepted when
+// its right-hand side does not reach any function that enumerates reflect.Type
+// fields.
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// f2pRuleAPIs are the rule-engine entry points that turn tag text into
+// validation/filter rules.
+var f2pRuleAPIs = map[string]bool{
+	"StringRule": true,
+	"FilterRule": true,
+}
+
+// f2pTemplateAPIs are the rule-engine entry points used when a cached static
+// rule template is replayed into a concrete Validation (defaults, optionals
+// and the per-instance clones of template rules).
+var f2pTemplateAPIs = map[string]bool{
+	"SetDefValue":     true,
+	"optional replay": true,
+	"cloneRule":       true,
+	"cloneFilterRule": true,
+}
+
+// f2pTranslationAPIs are the rule-engine entry points that collect labels,
+// output names and custom messages from struct tags.
+var f2pTranslationAPIs = map[string]bool{
+	"addLabelName": true,
+	"AddLabelMap":  true,
+	"AddFieldMap":  true,
+	"AddMessage":   true,
+	"AddMessages":  true,
+}
+
+// f2pTypeRef is a normalized reference to a declared type: Base is the named
+// type after unwrapping pointers, arrays, slices and map values, and List
+// reports whether a container was unwrapped on the way.
+type f2pTypeRef struct {
+	Base string
+	List bool
+}
+
+// f2pTypeInfo describes one type declared in the root package.
+type f2pTypeInfo struct {
+	Name     string
+	IsStruct bool
+	Fields   map[string]f2pTypeRef
+	Order    []string
+}
+
+type f2pFuncInfo struct {
+	Recv     string
+	RecvName string
+	Name     string
+	Decl     *ast.FuncDecl
+	Calls    map[string]bool
+	// PkgCalls records calls whose base is an imported package (reflect.New,
+	// strings.SplitN, ...). They are not internal call-graph edges.
+	PkgCalls map[string]bool
+	// Params maps a named parameter to its normalized type reference.
+	Params map[string]f2pTypeRef
+	// Results lists the normalized result type references.
+	Results []f2pTypeRef
+}
+
+func (f *f2pFuncInfo) id() string {
+	if f.Recv == "" {
+		return f.Name
+	}
+	return f.Recv + "." + f.Name
+}
+
+type f2pSource struct {
+	Funcs  []*f2pFuncInfo
+	ByName map[string][]*f2pFuncInfo
+	Files  []*ast.File
+	Types  map[string]*f2pTypeInfo
+	Vars   map[string]f2pTypeRef
+
+	metaTypes map[string]bool
+}
+
+// f2pLoadSource parses every non-test Go file of the module root package. The
+// root package is found relative to this test file, so the model always
+// describes the sources that were actually compiled into the package under
+// test.
+func f2pLoadSource(t *testing.T) *f2pSource {
+	t.Helper()
+
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("F2P source model: cannot locate the test source file")
+	}
+	root := filepath.Dir(filepath.Dir(file))
+
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		t.Fatalf("F2P source model: cannot read module root %s: %v", root, err)
+	}
+
+	src := &f2pSource{
+		ByName: map[string][]*f2pFuncInfo{},
+		Types:  map[string]*f2pTypeInfo{},
+		Vars:   map[string]f2pTypeRef{},
+	}
+	fset := token.NewFileSet()
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+
+		parsed, err := parser.ParseFile(fset, filepath.Join(root, name), nil, 0)
+		if err != nil {
+			t.Fatalf("F2P source model: cannot parse %s: %v", name, err)
+		}
+		src.Files = append(src.Files, parsed)
+
+		packages := f2pImportNames(parsed)
+		for _, decl := range parsed.Decls {
+			switch d := decl.(type) {
+			case *ast.FuncDecl:
+				if d.Body == nil {
+					continue
+				}
+				fn := &f2pFuncInfo{
+					Recv:     f2pReceiver(d),
+					RecvName: f2pReceiverName(d),
+					Name:     d.Name.Name,
+					Decl:     d,
+					Calls:    map[string]bool{},
+					PkgCalls: map[string]bool{},
+					Params:   f2pParamRefs(d.Type),
+					Results:  f2pResultRefs(d.Type),
+				}
+				ast.Inspect(d.Body, func(node ast.Node) bool {
+					call, ok := node.(*ast.CallExpr)
+					if !ok {
+						return true
+					}
+					fun := f2pResolveCallable(call.Fun, f2pCallableAliases(fn.Decl.Body, call.Pos()))
+					if sel, ok := fun.(*ast.SelectorExpr); ok {
+						if base, ok := sel.X.(*ast.Ident); ok && packages[base.Name] {
+							fn.PkgCalls[sel.Sel.Name] = true
+							return true
+						}
+					}
+					if callee := f2pCalleeName(fun); callee != "" {
+						fn.Calls[callee] = true
+					}
+					return true
+				})
+				src.Funcs = append(src.Funcs, fn)
+				src.ByName[fn.Name] = append(src.ByName[fn.Name], fn)
+
+			case *ast.GenDecl:
+				for _, spec := range d.Specs {
+					switch s := spec.(type) {
+					case *ast.TypeSpec:
+						ti := &f2pTypeInfo{Name: s.Name.Name, Fields: map[string]f2pTypeRef{}}
+						if st, ok := s.Type.(*ast.StructType); ok && st.Fields != nil {
+							ti.IsStruct = true
+							for _, field := range st.Fields.List {
+								ref := f2pTypeRefOf(field.Type)
+								for _, fname := range field.Names {
+									ti.Fields[fname.Name] = ref
+									ti.Order = append(ti.Order, fname.Name)
+								}
+							}
+						}
+						src.Types[ti.Name] = ti
+					case *ast.ValueSpec:
+						if d.Tok != token.VAR {
+							continue
+						}
+						ref := f2pTypeRefOf(s.Type)
+						if ref.Base == "" {
+							continue
+						}
+						for _, vname := range s.Names {
+							src.Vars[vname.Name] = ref
+						}
+					}
+				}
+			}
+		}
+	}
+
+	if len(src.Funcs) == 0 {
+		t.Fatalf("F2P source model: no production functions parsed under %s", root)
+	}
+	src.markOptionalReplay()
+	return src
+}
+
+// f2pImportNames returns the local names under which the file's imports are
+// referenced (the explicit alias, or the last path segment by default).
+func f2pImportNames(file *ast.File) map[string]bool {
+	names := map[string]bool{}
+	for _, spec := range file.Imports {
+		path := strings.Trim(spec.Path.Value, `"`)
+		name := path
+		if idx := strings.LastIndex(path, "/"); idx >= 0 {
+			name = path[idx+1:]
+		}
+		if spec.Name != nil {
+			name = spec.Name.Name
+		}
+		if name != "" && name != "_" && name != "." {
+			names[name] = true
+		}
+	}
+	return names
+}
+
+func f2pReceiver(fd *ast.FuncDecl) string {
+	if fd.Recv == nil || len(fd.Recv.List) == 0 {
+		return ""
+	}
+	switch typ := fd.Recv.List[0].Type.(type) {
+	case *ast.StarExpr:
+		if ident, ok := typ.X.(*ast.Ident); ok {
+			return ident.Name
+		}
+	case *ast.Ident:
+		return typ.Name
+	}
+	return "?"
+}
+
+func f2pReceiverName(fd *ast.FuncDecl) string {
+	if fd.Recv == nil || len(fd.Recv.List) == 0 {
+		return ""
+	}
+	if len(fd.Recv.List[0].Names) > 0 {
+		return fd.Recv.List[0].Names[0].Name
+	}
+	return ""
+}
+
+func f2pCalleeName(fun ast.Expr) string {
+	switch expr := fun.(type) {
+	case *ast.Ident:
+		return expr.Name
+	case *ast.SelectorExpr:
+		return expr.Sel.Name
+	case *ast.IndexExpr:
+		return f2pCalleeName(expr.X)
+	case *ast.IndexListExpr:
+		return f2pCalleeName(expr.X)
+	}
+	return ""
+}
+
+// Resolve invoked method/function values, including aliases and parentheses.
+// Object identity keeps an unrelated local with the same name from becoming
+// an edge. Resolve bindings as of the call site, capturing an alias when it
+// is assigned; later reassignment must not hide an earlier invocation. Merely
+// storing a method value does not constitute a field scan.
+func f2pCallableAliases(body *ast.BlockStmt, before token.Pos) map[*ast.Object]ast.Expr {
+	aliases := map[*ast.Object]ast.Expr{}
+	bind := func(lhs ast.Expr, rhs ast.Expr) {
+		if name, ok := lhs.(*ast.Ident); ok && name.Obj != nil {
+			aliases[name.Obj] = f2pResolveCallable(rhs, aliases)
+		}
+	}
+	ast.Inspect(body, func(node ast.Node) bool {
+		if node != nil && node.Pos() >= before {
+			return false
+		}
+		switch st := node.(type) {
+		case *ast.AssignStmt:
+			for i, lhs := range st.Lhs {
+				if i < len(st.Rhs) {
+					bind(lhs, st.Rhs[i])
+				}
+			}
+		case *ast.ValueSpec:
+			for i, name := range st.Names {
+				if i < len(st.Values) {
+					bind(name, st.Values[i])
+				}
+			}
+		}
+		return true
+	})
+	return aliases
+}
+
+func f2pResolveCallable(expr ast.Expr, aliases map[*ast.Object]ast.Expr) ast.Expr {
+	seen := map[*ast.Object]bool{}
+	for {
+		switch e := expr.(type) {
+		case *ast.ParenExpr:
+			expr = e.X
+		case *ast.Ident:
+			next, ok := aliases[e.Obj]
+			if !ok || seen[e.Obj] {
+				return expr
+			}
+			seen[e.Obj] = true
+			expr = next
+		default:
+			return expr
+		}
+	}
+}
+
+// Discover optional state through the public Rule.SetOptional contract, then
+// mark writes to the Validation maps populated when that flag is read. No
+// private helper or storage field name is part of the acceptance condition.
+func (s *f2pSource) markOptionalReplay() {
+	flagFields := map[string]bool{}
+	setter := s.method("Rule", "SetOptional")
+	if setter == nil {
+		return
+	}
+	ast.Inspect(setter.Decl.Body, func(node ast.Node) bool {
+		if st, ok := node.(*ast.AssignStmt); ok {
+			for _, lhs := range st.Lhs {
+				if sel, ok := lhs.(*ast.SelectorExpr); ok {
+					if ref, ok := s.exprTypeRef(setter, sel.X, s.localRefs(setter)); ok && ref.Base == "Rule" {
+						flagFields[sel.Sel.Name] = true
+					}
+				}
+			}
+		}
+		return true
+	})
+	stateFields := map[string]bool{}
+	writes := func(fn *f2pFuncInfo, node ast.Node, indexedOnly bool) []string {
+		var fields []string
+		locals := s.localRefs(fn)
+		ast.Inspect(node, func(n ast.Node) bool {
+			if st, ok := n.(*ast.AssignStmt); ok {
+				for _, lhs := range st.Lhs {
+					if index, ok := lhs.(*ast.IndexExpr); ok {
+						lhs = index.X
+					} else if indexedOnly {
+						continue
+					}
+					if sel, ok := lhs.(*ast.SelectorExpr); ok {
+						if ref, ok := s.exprTypeRef(fn, sel.X, locals); ok && ref.Base == "Validation" {
+							fields = append(fields, sel.Sel.Name)
+						}
+					}
+				}
+			}
+			return true
+		})
+		return fields
+	}
+	for _, fn := range s.Funcs {
+		locals := s.localRefs(fn)
+		ast.Inspect(fn.Decl.Body, func(node ast.Node) bool {
+			if st, ok := node.(*ast.IfStmt); ok {
+				readsFlag := false
+				ast.Inspect(st.Cond, func(n ast.Node) bool {
+					if sel, ok := n.(*ast.SelectorExpr); ok && flagFields[sel.Sel.Name] {
+						if ref, ok := s.exprTypeRef(fn, sel.X, locals); ok && ref.Base == "Rule" {
+							readsFlag = true
+						}
+					}
+					return true
+				})
+				if readsFlag {
+					for _, field := range writes(fn, st.Body, true) {
+						stateFields[field] = true
+					}
+				}
+			}
+			return true
+		})
+	}
+	for _, fn := range s.Funcs {
+		for _, field := range writes(fn, fn.Decl.Body, false) {
+			if stateFields[field] {
+				fn.Calls["optional replay"] = true
+			}
+		}
+	}
+}
+
+// A tag collection owner may replay optional state directly or delegate to
+// rule-engine helpers. The tag/metadata context distinguishes collection from
+// ordinary state reset and allocation.
+func (s *f2pSource) ownsOptionalReplay(fn *f2pFuncInfo) bool {
+	if !s.collectionContext(fn) {
+		return false
+	}
+	// A data-source coordinator delegates collection to the rule engine.
+	// Downstream writes belong to that collector, not to the coordinator.
+	if fn.Recv == "StructData" {
+		return fn.Calls["optional replay"]
+	}
+	pending := []*f2pFuncInfo{fn}
+	seen := map[*f2pFuncInfo]bool{}
+	for len(pending) > 0 {
+		callee := pending[0]
+		pending = pending[1:]
+		if seen[callee] || (callee != fn && callee.Recv == "StructData") {
+			continue
+		}
+		seen[callee] = true
+		if callee.Calls["optional replay"] {
+			return true
+		}
+		pending = append(pending, s.calledFunctions(callee)...)
+	}
+	return false
+}
+
+func (s *f2pSource) collectionContext(fn *f2pFuncInfo) bool {
+	return f2pReadsStructTags(fn) || f2pConsumesScanMetadata(s, fn) ||
+		f2pHasExternalTagReaderCaller(s, fn) || f2pHasExternalTagReaderCallee(s, fn)
+}
+
+func f2pIntersects(calls map[string]bool, apis map[string]bool) []string {
+	var hit []string
+	for name := range apis {
+		if calls[name] {
+			hit = append(hit, name)
+		}
+	}
+	sort.Strings(hit)
+	return hit
+}
+
+func f2pAllTagAPIs() map[string]bool {
+	all := map[string]bool{}
+	for name := range f2pRuleAPIs {
+		all[name] = true
+	}
+	for name := range f2pTemplateAPIs {
+		all[name] = true
+	}
+	for name := range f2pTranslationAPIs {
+		all[name] = true
+	}
+	return all
+}
+
+// callTargets resolves local functions and methods by their declared receiver
+// type. Imported APIs and calls on unrelated receivers do not create edges.
+func (s *f2pSource) callTargets(fn *f2pFuncInfo, call *ast.CallExpr, locals map[string]f2pTypeRef) []*f2pFuncInfo {
+	resolved := f2pResolveCallable(call.Fun, f2pCallableAliases(fn.Decl.Body, call.Pos()))
+	name := f2pCalleeName(resolved)
+	var receiver string
+	switch fun := resolved.(type) {
+	case *ast.Ident:
+		// An enclosing local closure has no separate production declaration.
+	case *ast.SelectorExpr:
+		ref, ok := s.exprTypeRef(fn, fun.X, locals)
+		if !ok {
+			return nil
+		}
+		receiver = ref.Base
+	default:
+		return nil
+	}
+	var targets []*f2pFuncInfo
+	for _, target := range s.ByName[name] {
+		if target.Recv == receiver {
+			targets = append(targets, target)
+		}
+	}
+	return targets
+}
+
+func (s *f2pSource) calledFunctions(fn *f2pFuncInfo) []*f2pFuncInfo {
+	locals := s.localRefs(fn)
+	var targets []*f2pFuncInfo
+	ast.Inspect(fn.Decl.Body, func(node ast.Node) bool {
+		if call, ok := node.(*ast.CallExpr); ok {
+			targets = append(targets, s.callTargets(fn, call, locals)...)
+		}
+		return true
+	})
+	return targets
+}
+
+// reachable returns the receiver-resolved package call graph. Local closures
+// remain part of the enclosing function's body.
+func (s *f2pSource) reachable(start *f2pFuncInfo) map[*f2pFuncInfo]bool {
+	seen := map[*f2pFuncInfo]bool{start: true}
+	queue := []*f2pFuncInfo{start}
+	for len(queue) > 0 {
+		fn := queue[0]
+		queue = queue[1:]
+		for _, callee := range s.calledFunctions(fn) {
+			if !seen[callee] {
+				seen[callee] = true
+				queue = append(queue, callee)
+			}
+		}
+	}
+	return seen
+}
+
+func (s *f2pSource) method(recv, name string) *f2pFuncInfo {
+	for _, fn := range s.Funcs {
+		if fn.Recv == recv && fn.Name == name {
+			return fn
+		}
+	}
+	return nil
+}
+
+func (s *f2pSource) directCallers(apis map[string]bool) []*f2pFuncInfo {
+	var out []*f2pFuncInfo
+	for _, fn := range s.Funcs {
+		if len(f2pIntersects(fn.Calls, apis)) > 0 {
+			out = append(out, fn)
+		}
+	}
+	return out
+}
+
+// f2pEnumeratesTypeFields reports whether fn enumerates the fields of a
+// reflect.Type itself (NumField/VisibleFields), regardless of how the count is
+// stored. Such a function decides which fields exist; only the single
+// authoritative scan may do that.
+func f2pEnumeratesTypeFields(fn *f2pFuncInfo) bool {
+	if fn.Calls["NumField"] || fn.Calls["VisibleFields"] {
+		return true
+	}
+	// A package-qualified reflect.NumField cannot occur (NumField is a method),
+	// but keep the check robust if the call shape ever changes.
+	return fn.PkgCalls["NumField"] || fn.PkgCalls["VisibleFields"]
+}
+
+// enumerationComponents groups cooperating field-enumeration functions by
+// their resolved calls. A traversal may split its setup and iteration between
+// helpers; only disconnected scans are independent authorities.
+func (s *f2pSource) enumerationComponents() [][]*f2pFuncInfo {
+	var scans []*f2pFuncInfo
+	for _, fn := range s.Funcs {
+		if f2pEnumeratesTypeFields(fn) {
+			scans = append(scans, fn)
+		}
+	}
+	parent := make([]int, len(scans))
+	for i := range parent {
+		parent[i] = i
+	}
+	var find func(int) int
+	find = func(i int) int {
+		if parent[i] != i {
+			parent[i] = find(parent[i])
+		}
+		return parent[i]
+	}
+	for i, fn := range scans {
+		reached := s.reachable(fn)
+		for j, other := range scans {
+			if reached[other] {
+				parent[find(j)] = find(i)
+			}
+		}
+	}
+	groups := map[int][]*f2pFuncInfo{}
+	for i, fn := range scans {
+		groups[find(i)] = append(groups[find(i)], fn)
+	}
+	var result [][]*f2pFuncInfo
+	for _, group := range groups {
+		result = append(result, group)
+	}
+	return result
+}
+
+// f2pTypeRefOf normalizes a type expression: pointers are unwrapped, and
+// arrays, slices and map values set List.
+func f2pTypeRefOf(expr ast.Expr) f2pTypeRef {
+	switch typ := expr.(type) {
+	case *ast.ParenExpr:
+		return f2pTypeRefOf(typ.X)
+	case *ast.StarExpr:
+		return f2pTypeRefOf(typ.X)
+	case *ast.ArrayType:
+		ref := f2pTypeRefOf(typ.Elt)
+		ref.List = true
+		return ref
+	case *ast.Ellipsis:
+		ref := f2pTypeRefOf(typ.Elt)
+		ref.List = true
+		return ref
+	case *ast.MapType:
+		ref := f2pTypeRefOf(typ.Value)
+		ref.List = true
+		return ref
+	case *ast.Ident:
+		return f2pTypeRef{Base: typ.Name}
+	case *ast.SelectorExpr:
+		return f2pTypeRef{Base: typ.Sel.Name}
+	case *ast.IndexExpr:
+		ref := f2pTypeRefOf(typ.X)
+		ref.List = true
+		return ref
+	case *ast.IndexListExpr:
+		ref := f2pTypeRefOf(typ.X)
+		ref.List = true
+		return ref
+	}
+	return f2pTypeRef{}
+}
+
+func f2pParamRefs(ftype *ast.FuncType) map[string]f2pTypeRef {
+	out := map[string]f2pTypeRef{}
+	if ftype == nil || ftype.Params == nil {
+		return out
+	}
+	for _, field := range ftype.Params.List {
+		ref := f2pTypeRefOf(field.Type)
+		for _, name := range field.Names {
+			out[name.Name] = ref
+		}
+	}
+	return out
+}
+
+func f2pResultRefs(ftype *ast.FuncType) []f2pTypeRef {
+	var out []f2pTypeRef
+	if ftype == nil || ftype.Results == nil {
+		return out
+	}
+	for _, field := range ftype.Results.List {
+		ref := f2pTypeRefOf(field.Type)
+		count := len(field.Names)
+		if count == 0 {
+			count = 1
+		}
+		for i := 0; i < count; i++ {
+			out = append(out, ref)
+		}
+	}
+	return out
+}
+
+// callsEnumerator reports whether fn directly calls a function that enumerates
+// reflect.Type fields.
+func (s *f2pSource) callsEnumerator(fn *f2pFuncInfo) bool {
+	for name := range fn.Calls {
+		for _, callee := range s.ByName[name] {
+			if f2pEnumeratesTypeFields(callee) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// metadataTypes returns the declared struct types that carry the authoritative
+// type scan's results. They are identified structurally: the result (or
+// receiver) types of functions that enumerate reflect.Type fields, the result
+// and the struct types that
+// hold such records in a list field. No field or type name is assumed.
+func (s *f2pSource) metadataTypes() map[string]bool {
+	if s.metaTypes != nil {
+		return s.metaTypes
+	}
+	set := map[string]bool{}
+	add := func(ref f2pTypeRef) {
+		if ti := s.Types[ref.Base]; ti != nil && ti.IsStruct {
+			set[ref.Base] = true
+		}
+	}
+	for _, fn := range s.Funcs {
+		if !f2pEnumeratesTypeFields(fn) {
+			continue
+		}
+		// Collection coordinators can return Validation or rule templates. They
+		// are not field metadata simply because they call a scanner. Seed only
+		// values returned by the actual scan; a scanning receiver must carry a
+		// reflection descriptor, and the public data source remains a source.
+		if fn.Recv != "" && fn.Recv != "StructData" {
+			if ti := s.Types[fn.Recv]; ti != nil {
+				for _, field := range ti.Fields {
+					if field.Base == "Type" || field.Base == "StructField" || field.Base == "StructTag" {
+						add(f2pTypeRef{Base: fn.Recv})
+						break
+					}
+				}
+			}
+		}
+		for _, ref := range fn.Results {
+			add(ref)
+		}
+	}
+	// A scanner can cache raw standard-library descriptors. A consumer may
+	// build richer records from that shared list without doing another scan.
+	for _, fn := range s.Funcs {
+		usesRawAuthority := false
+		for callee := range s.reachable(fn) {
+			if s.returnsReflectFieldList(callee) && s.isSoleEnumerationAuthority(callee) {
+				usesRawAuthority = true
+			}
+		}
+		if !usesRawAuthority {
+			continue
+		}
+		ast.Inspect(fn.Decl.Body, func(node ast.Node) bool {
+			lit, ok := node.(*ast.CompositeLit)
+			if !ok {
+				return true
+			}
+			ref := f2pTypeRefOf(lit.Type)
+			ti := s.Types[ref.Base]
+			if ti == nil || !ti.IsStruct {
+				return true
+			}
+			hasType, hasTag, hasRecords := false, false, false
+			for _, field := range ti.Fields {
+				hasType = hasType || field.Base == "Type"
+				hasTag = hasTag || field.Base == "StructTag"
+				if child := s.Types[field.Base]; field.List && child != nil && child.IsStruct {
+					hasRecords = true
+				}
+			}
+			if hasType && (hasTag || hasRecords) {
+				add(ref)
+			}
+			return true
+		})
+	}
+	for changed := true; changed; {
+		changed = false
+		for name := range set {
+			ti := s.Types[name]
+			if ti == nil {
+				continue
+			}
+			for _, fname := range ti.Order {
+				ref := ti.Fields[fname]
+				if !ref.List {
+					continue
+				}
+				if el := s.Types[ref.Base]; el != nil && el.IsStruct && !set[ref.Base] {
+					set[ref.Base] = true
+					changed = true
+				}
+			}
+		}
+		for name, ti := range s.Types {
+			if ti == nil || !ti.IsStruct || set[name] {
+				continue
+			}
+			for _, fname := range ti.Order {
+				ref := ti.Fields[fname]
+				if ref.List && set[ref.Base] {
+					set[name] = true
+					changed = true
+					break
+				}
+			}
+		}
+	}
+	s.metaTypes = set
+	return set
+}
+
+// isMetadataRef reports whether ref denotes a metadata record or a list of
+// metadata records produced by the authoritative scan.
+func (s *f2pSource) isMetadataRef(ref f2pTypeRef) bool {
+	ti := s.Types[ref.Base]
+	return ti != nil && ti.IsStruct && s.metadataTypes()[ref.Base]
+}
+
+// localRefs infers the normalized types of local variables declared by :=,
+// var and range statements inside fn.
+func (s *f2pSource) localRefs(fn *f2pFuncInfo) map[string]f2pTypeRef {
+	out := map[string]f2pTypeRef{}
+	for pass := 0; pass < 3; pass++ {
+		ast.Inspect(fn.Decl.Body, func(node ast.Node) bool {
+			switch st := node.(type) {
+			case *ast.AssignStmt:
+				if st.Tok != token.DEFINE {
+					return true
+				}
+				for i, lhs := range st.Lhs {
+					if i >= len(st.Rhs) {
+						break
+					}
+					ident, ok := lhs.(*ast.Ident)
+					if !ok {
+						continue
+					}
+					if _, seen := out[ident.Name]; seen {
+						continue
+					}
+					if ref, ok := s.exprTypeRef(fn, st.Rhs[i], out); ok {
+						out[ident.Name] = ref
+					}
+				}
+			case *ast.DeclStmt:
+				gen, ok := st.Decl.(*ast.GenDecl)
+				if !ok || gen.Tok != token.VAR {
+					return true
+				}
+				for _, spec := range gen.Specs {
+					vs, ok := spec.(*ast.ValueSpec)
+					if !ok {
+						continue
+					}
+					for i, name := range vs.Names {
+						if i >= len(vs.Values) {
+							continue
+						}
+						if _, seen := out[name.Name]; seen {
+							continue
+						}
+						if ref, ok := s.exprTypeRef(fn, vs.Values[i], out); ok {
+							out[name.Name] = ref
+						}
+					}
+				}
+			case *ast.RangeStmt:
+				ref, ok := s.exprTypeRef(fn, st.X, out)
+				if !ok || !ref.List {
+					return true
+				}
+				ref.List = false
+				for _, target := range []ast.Expr{st.Key, st.Value} {
+					ident, ok := target.(*ast.Ident)
+					if !ok || ident.Name == "_" {
+						continue
+					}
+					if _, seen := out[ident.Name]; !seen {
+						out[ident.Name] = ref
+					}
+				}
+			}
+			return true
+		})
+	}
+	return out
+}
+
+// exprTypeRef resolves the normalized type of a value expression inside fn.
+// locals carries the already-inferred local variable types.
+func (s *f2pSource) exprTypeRef(fn *f2pFuncInfo, expr ast.Expr, locals map[string]f2pTypeRef) (f2pTypeRef, bool) {
+	switch e := expr.(type) {
+	case *ast.ParenExpr:
+		return s.exprTypeRef(fn, e.X, locals)
+	case *ast.StarExpr:
+		return s.exprTypeRef(fn, e.X, locals)
+	case *ast.UnaryExpr:
+		return s.exprTypeRef(fn, e.X, locals)
+	case *ast.IndexExpr:
+		ref, ok := s.exprTypeRef(fn, e.X, locals)
+		if !ok {
+			return ref, false
+		}
+		ref.List = false
+		return ref, true
+	case *ast.CallExpr:
+		for _, callee := range s.callTargets(fn, e, locals) {
+			for _, ref := range callee.Results {
+				if ref.Base != "" {
+					return ref, true
+				}
+			}
+		}
+		return f2pTypeRef{}, false
+	case *ast.CompositeLit:
+		ref := f2pTypeRefOf(e.Type)
+		return ref, ref.Base != ""
+	case *ast.Ident:
+		if fn != nil {
+			if ref, ok := fn.Params[e.Name]; ok {
+				return ref, true
+			}
+			if ref, ok := locals[e.Name]; ok {
+				return ref, true
+			}
+			if fn.RecvName != "" && fn.RecvName == e.Name && fn.Recv != "" {
+				return f2pTypeRef{Base: fn.Recv}, true
+			}
+		}
+		if ref, ok := s.Vars[e.Name]; ok {
+			return ref, true
+		}
+		return f2pTypeRef{}, false
+	case *ast.SelectorExpr:
+		base, ok := s.exprTypeRef(fn, e.X, locals)
+		if !ok {
+			return f2pTypeRef{}, false
+		}
+		ti := s.Types[base.Base]
+		if ti == nil || !ti.IsStruct {
+			return f2pTypeRef{}, false
+		}
+		ref, ok := ti.Fields[e.Sel.Name]
+		if !ok {
+			return f2pTypeRef{}, false
+		}
+		return ref, true
+	}
+	return f2pTypeRef{}, false
+}
+
+// exprIsMetadataFieldList reports whether expr evaluates to a list of metadata
+// records produced by the authoritative scan.
+func (s *f2pSource) exprIsMetadataFieldList(fn *f2pFuncInfo, expr ast.Expr) bool {
+	ref, ok := s.exprTypeRef(fn, expr, s.localRefs(fn))
+	return ok && ref.List && s.isMetadataRef(ref)
+}
+
+// f2pReadsStructTags reports whether fn reads struct tags itself, i.e. calls
+// `X.Tag.Get(...)` or `X.Tag.Lookup(...)`.
+func f2pReadsStructTags(fn *f2pFuncInfo) bool {
+	found := false
+	ast.Inspect(fn.Decl.Body, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		sel, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok || (sel.Sel.Name != "Get" && sel.Sel.Name != "Lookup") {
+			return true
+		}
+		if tagSel, ok := sel.X.(*ast.SelectorExpr); ok && tagSel.Sel.Name == "Tag" {
+			found = true
+		}
+		return true
+	})
+	return found
+}
+
+// f2pHasExternalTagReaderCaller accepts a small parsing helper when the
+// caller that supplies its tag-derived arguments is itself an external
+// collector.  A helper such as loadMessagesFromTag only receives already
+// decoded tag text, so requiring every leaf helper to call reflect.StructTag
+// directly would reject an equivalent decomposition.  StructData callers are
+// deliberately excluded: a data-source method delegating to a helper still
+// leaves the collection responsibility on the data source.
+func f2pHasExternalTagReaderCaller(s *f2pSource, target *f2pFuncInfo) bool {
+	for _, caller := range s.Funcs {
+		if caller == target || caller.Recv == "StructData" {
+			continue
+		}
+		if !f2pReadsStructTags(caller) && !f2pConsumesScanMetadata(s, caller) {
+			continue
+		}
+		for _, callee := range s.calledFunctions(caller) {
+			if callee == target {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// f2pHasExternalTagReaderCallee accepts a collection coordinator that commits
+// metadata assembled by its tag-reading descendants. For example, the walk
+// may fill an output-name map and its caller may submit that map. Tag reads and
+// API calls need not occur in one function. Traversal stops at StructData so data-source-owned collection cannot count as
+// an external component by merely calling a public engine API. Receivers on
+// the rule-engine side are allowed when their bodies consume tag metadata.
+func f2pHasExternalTagReaderCallee(s *f2pSource, start *f2pFuncInfo) bool {
+	pending := []*f2pFuncInfo{start}
+	seen := map[*f2pFuncInfo]bool{}
+	for len(pending) > 0 {
+		fn := pending[0]
+		pending = pending[1:]
+		if seen[fn] || fn.Recv == "StructData" {
+			continue
+		}
+		seen[fn] = true
+		if f2pReadsStructTags(fn) || f2pConsumesScanMetadata(s, fn) {
+			return true
+		}
+		pending = append(pending, s.calledFunctions(fn)...)
+	}
+	return false
+}
+
+// callSitePassesMetadata reports whether some call site in the package passes a
+// metadata record or metadata field list into the target function.
+func (s *f2pSource) callSitePassesMetadata(target *f2pFuncInfo) bool {
+	for _, caller := range s.Funcs {
+		if caller == target {
+			continue
+		}
+		locals := s.localRefs(caller)
+		found := false
+		ast.Inspect(caller.Decl.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok || f2pCalleeName(call.Fun) != target.Name {
+				return true
+			}
+			for _, arg := range call.Args {
+				if ref, ok := s.exprTypeRef(caller, arg, locals); ok && s.isMetadataRef(ref) {
+					found = true
+				}
+			}
+			return true
+		})
+		if found {
+			return true
+		}
+	}
+	return false
+}
+
+// f2pConsumesScanMetadata reports whether fn obtains its field list from the
+// authoritative type scan instead of re-deriving it: it ranges over (or takes
+// len of) a metadata field list, calls a function that returns the scan
+// metadata, or receives that metadata through a parameter at a call site that
+// passes it.
+func f2pConsumesScanMetadata(s *f2pSource, fn *f2pFuncInfo) bool {
+	locals := s.localRefs(fn)
+	found := false
+	ast.Inspect(fn.Decl.Body, func(node ast.Node) bool {
+		switch st := node.(type) {
+		case *ast.RangeStmt:
+			if ref, ok := s.exprTypeRef(fn, st.X, locals); ok && ref.List && s.isMetadataRef(ref) {
+				found = true
+			}
+		case *ast.ForStmt:
+			if st.Cond == nil {
+				return true
+			}
+			ast.Inspect(st.Cond, func(cond ast.Node) bool {
+				call, ok := cond.(*ast.CallExpr)
+				if !ok || f2pCalleeName(call.Fun) != "len" || len(call.Args) != 1 {
+					return true
+				}
+				if ref, ok := s.exprTypeRef(fn, call.Args[0], locals); ok && ref.List && s.isMetadataRef(ref) {
+					found = true
+				}
+				return true
+			})
+		}
+		return true
+	})
+	if found {
+		return true
+	}
+
+	for name := range fn.Calls {
+		for _, callee := range s.ByName[name] {
+			for _, ref := range callee.Results {
+				if s.isMetadataRef(ref) {
+					return true
+				}
+			}
+		}
+	}
+
+	for name, ref := range fn.Params {
+		if s.isMetadataRef(ref) && f2pUsesIdent(fn, name) && s.callSitePassesMetadata(fn) {
+			return true
+		}
+	}
+	return false
+}
+
+// f2pUsesIdent reports whether the named identifier is referenced anywhere in
+// fn's body. A metadata-typed parameter that is never read cannot be the
+// collector's source of fields, so an unused parameter must not count as
+// consuming the authoritative scan.
+func f2pUsesIdent(fn *f2pFuncInfo, name string) bool {
+	used := false
+	ast.Inspect(fn.Decl.Body, func(node ast.Node) bool {
+		if ident, ok := node.(*ast.Ident); ok && ident.Name == name {
+			used = true
+		}
+		return true
+	})
+	return used
+}
+
+// exprReachesEnumerator reports whether the expression tree of expr is
+// evaluated by a call chain that enumerates reflect.Type fields. The search
+// follows the package call graph but stops at the metadata accessors that
+// return the authoritative scan's records: delegating to the authoritative
+// scan is exactly what the classification must do, while a call chain that
+// walks reflect.Type itself (possibly through wrappers) is reported.
+func (s *f2pSource) exprReachesEnumerator(expr ast.Expr) (string, bool) {
+	var queue []*f2pFuncInfo
+	ast.Inspect(expr, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		queue = append(queue, s.ByName[f2pCalleeName(call.Fun)]...)
+		return true
+	})
+
+	seen := map[*f2pFuncInfo]bool{}
+	for len(queue) > 0 {
+		fn := queue[0]
+		queue = queue[1:]
+		if fn == nil || seen[fn] {
+			continue
+		}
+		seen[fn] = true
+		// Reading the sole shared scanner's descriptor array is consumption
+		// of the authority, not an independent classification scan. Resolve
+		// the standard-library import, rather than accepting a type's spelling.
+		if s.returnsReflectFieldList(fn) && s.isSoleEnumerationAuthority(fn) {
+			continue
+		}
+		if f2pEnumeratesTypeFields(fn) {
+			return fn.id(), true
+		}
+		if s.returnsMetadata(fn) {
+			continue
+		}
+		for name := range fn.Calls {
+			queue = append(queue, s.ByName[name]...)
+		}
+	}
+	return "", false
+}
+
+func (s *f2pSource) isSoleEnumerationAuthority(fn *f2pFuncInfo) bool {
+	groups := s.enumerationComponents()
+	if len(groups) != 1 {
+		return false
+	}
+	for _, member := range groups[0] {
+		if member == fn {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *f2pSource) returnsReflectFieldList(fn *f2pFuncInfo) bool {
+	if fn.Decl.Type.Results == nil {
+		return false
+	}
+	for _, file := range s.Files {
+		if fn.Decl.Pos() < file.Pos() || fn.Decl.End() > file.End() {
+			continue
+		}
+		for _, imp := range file.Imports {
+			if imp.Path.Value != `"reflect"` {
+				continue
+			}
+			alias := "reflect"
+			if imp.Name != nil {
+				alias = imp.Name.Name
+			}
+			for _, field := range fn.Decl.Type.Results.List {
+				arr, ok := field.Type.(*ast.ArrayType)
+				if !ok || arr.Len != nil {
+					continue
+				}
+				sel, ok := arr.Elt.(*ast.SelectorExpr)
+				if !ok || sel.Sel.Name != "StructField" {
+					continue
+				}
+				pkg, ok := sel.X.(*ast.Ident)
+				if ok && pkg.Name == alias {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// returnsMetadata reports whether fn returns an authoritative scan record or a
+// list of them, i.e. it is a metadata accessor rather than a second traversal.
+func (s *f2pSource) returnsMetadata(fn *f2pFuncInfo) bool {
+	for _, ref := range fn.Results {
+		if s.isMetadataRef(ref) {
+			return true
+		}
+	}
+	return false
+}
+
+// conditionReadFields returns the `type.field` pairs of metadata-record fields
+// that are read in a branch condition somewhere in the package. The mode
+// dispatch reads the static/dynamic classification this way, so this set
+// identifies the classification without assuming its field name or type.
+func (s *f2pSource) conditionReadFields() map[string]bool {
+	keys := map[string]bool{}
+	for _, fn := range s.Funcs {
+		locals := s.localRefs(fn)
+		check := func(expr ast.Expr) {
+			if expr == nil {
+				return
+			}
+			ast.Inspect(expr, func(node ast.Node) bool {
+				sel, ok := node.(*ast.SelectorExpr)
+				if !ok {
+					return true
+				}
+				base, ok := s.exprTypeRef(fn, sel.X, locals)
+				if !ok || !s.isMetadataRef(base) {
+					return true
+				}
+				ti := s.Types[base.Base]
+				if ti == nil {
+					return true
+				}
+				if _, ok := ti.Fields[sel.Sel.Name]; !ok {
+					return true
+				}
+				keys[base.Base+"."+sel.Sel.Name] = true
+				return true
+			})
+		}
+		ast.Inspect(fn.Decl.Body, func(node ast.Node) bool {
+			switch st := node.(type) {
+			case *ast.IfStmt:
+				check(st.Cond)
+			case *ast.ForStmt:
+				check(st.Cond)
+			case *ast.SwitchStmt:
+				check(st.Tag)
+			case *ast.CaseClause:
+				for _, expr := range st.List {
+					check(expr)
+				}
+			case *ast.TypeSwitchStmt:
+				if as, ok := st.Assign.(*ast.AssignStmt); ok {
+					for _, rhs := range as.Rhs {
+						check(rhs)
+					}
+				}
+			}
+			return true
+		})
+	}
+	return keys
+}
+
+// isClassificationField reports whether typeName.fieldName is the
+// static/dynamic classification of a metadata record. The classification is
+// identified structurally: a boolean metadata field, or a metadata field that
+// the mode dispatch reads in a branch condition. Cached derived state (rule
+// templates, nested records) is not a classification field.
+func (s *f2pSource) isClassificationField(typeName, fieldName string) bool {
+	ti := s.Types[typeName]
+	if ti == nil || !ti.IsStruct || !s.metadataTypes()[typeName] {
+		return false
+	}
+	ref, ok := ti.Fields[fieldName]
+	if !ok || s.isMetadataRef(ref) {
+		return false
+	}
+	if ref.Base == "bool" && !ref.List {
+		return true
+	}
+	return s.conditionReadFields()[typeName+"."+fieldName]
+}
+
+// isClassificationTarget resolves the selector base to a metadata record and
+// reports whether the selected field is its static/dynamic classification.
+func (s *f2pSource) isClassificationTarget(fn *f2pFuncInfo, sel *ast.SelectorExpr, locals map[string]f2pTypeRef) bool {
+	base, ok := s.exprTypeRef(fn, sel.X, locals)
+	if !ok {
+		return false
+	}
+	return s.isClassificationField(base.Base, sel.Sel.Name)
+}
+
+func f2pJoin(names []string) string {
+	return strings.Join(names, ",")
+}
+
+func f2pFuncNames(funcs []*f2pFuncInfo) []string {
+	names := make([]string, 0, len(funcs))
+	for _, fn := range funcs {
+		names = append(names, fn.id())
+	}
+	sort.Strings(names)
+	return names
+}
+
+func f2pContainsFunc(set map[*f2pFuncInfo]bool, fn *f2pFuncInfo) bool {
+	return fn != nil && set[fn]
+}
