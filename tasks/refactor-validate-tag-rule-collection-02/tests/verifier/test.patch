+package validate_test
+
+import (
+	"testing"
+
+	"github.com/gookit/validate/v2"
+)
+
+type cachePublicLeft struct {
+	Name string `validate:"required"`
+	B    *cachePublicRight
+}
+
+type cachePublicRight struct {
+	A *cachePublicLeft
+}
+
+type cachePublicNode struct {
+	Name string           `validate:"required"`
+	Next *cachePublicNode `validate:""`
+}
+
+func TestP2PRecursiveCachePublicBehavior(t *testing.T) {
+	mutual := validate.Struct(&cachePublicLeft{})
+	if mutual.Validate() {
+		t.Fatal("mutually recursive type must validate its required Name")
+	}
+	if _, ok := mutual.Errors["Name"]["required"]; !ok {
+		t.Fatalf("expected Name.required, got %v", mutual.Errors)
+	}
+
+	self := validate.Struct(&cachePublicNode{Name: "present"})
+	if self.Validate() {
+		t.Fatal("nil recursive child must preserve the required child-name rule")
+	}
+	if _, ok := self.Errors["Next.Name"]["required"]; !ok {
+		t.Fatalf("expected Next.Name.required, got %v", self.Errors)
+	}
+}
