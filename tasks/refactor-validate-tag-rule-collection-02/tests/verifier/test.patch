+func TestP2PRuleCollectionDeterministicAcrossInstances(t *testing.T) {
+	var wantValid string
+	var wantInvalid string
+	for i := 0; i < 25; i++ {
+		ok := validate.Struct(&p2pConc{Name: "ann", Age: 30, Addr: p2pInner{City: "c", Zip: "123"}})
+		if !ok.Validate() {
+			t.Fatalf("iteration %d: valid value rejected: %v", i, p2pErrPairs(ok.Errors))
+		}
+		if got := strings.Join(p2pErrPairs(ok.Errors), ";"); got != wantValid {
+			t.Fatalf("iteration %d: valid error set changed: %q != %q", i, got, wantValid)
+		}
+
+		bad := validate.Struct(&p2pConc{Name: "x"})
+		bad.StopOnError = false
+		if bad.Validate() {
+			t.Fatalf("iteration %d: invalid value accepted", i)
+		}
+		got := strings.Join(p2pErrPairs(bad.Errors), ";")
+		if i == 0 {
+			wantInvalid = got
+		} else if got != wantInvalid {
+			t.Fatalf("iteration %d: rule collection is not deterministic: %q != %q", i, got, wantInvalid)
+		}
+	}
+
+	// a dynamic type must keep collecting element rules per value.
+	empty := validate.Struct(&p2pConcSlice{})
+	empty.StopOnError = false
+	if empty.Validate() {
+		t.Fatalf("empty slice must fail required")
+	}
+	if _, ok := empty.Errors["Items"]["required"]; !ok {
+		t.Fatalf("dynamic type lost the required rule: %v", p2pErrPairs(empty.Errors))
+	}
+	withItems := validate.Struct(&p2pConcSlice{Items: []p2pInner{{City: "c"}}})
+	withItems.StopOnError = false
+	if withItems.Validate() {
+		t.Fatalf("slice element without Zip must fail")
+	}
+	if _, ok := withItems.Errors["Items.0.Zip"]["required"]; !ok {
+		t.Fatalf("dynamic type lost per-value element rules: %v", p2pErrPairs(withItems.Errors))
+	}
+}
