+// A separate test process keeps an incorrectly eager scanner from wedging
+// global metadata locks in the rest of the suite. A normal-pointer control
+// must complete before the frozen recursive boundary is evaluated.
+func p2pSkippedFieldChild(mode string) {
+	result := struct {
+		Valid  bool   `json:"valid"`
+		Errors int    `json:"errors"`
+		Panic  string `json:"panic"`
+	}{}
+	defer func() {
+		if p := recover(); p != nil {
+			result.Panic = fmt.Sprintf("%T: %v", p, p)
+		}
+		b, _ := json.Marshal(result)
+		fmt.Println("P2P_SKIPPED_FIELD_RESULT " + string(b))
+	}()
+	validate.ResetOption()
+	validate.ResetTypeCache()
+	var source any
+	if mode == "normal" {
+		type child struct {
+			Name    string `validate:"required"`
+			Skipped map[string]*int
+			hidden  *int
+		}
+		source = &struct {
+			Items []child `validate:""`
+		}{Items: []child{{Name: "valid"}}}
+	} else {
+		type child struct {
+			Name    string `validate:"required"`
+			Skipped map[string]p2pRecursivePointer
+			hidden  p2pRecursivePointer
+		}
+		source = &struct {
+			Items []child `validate:""`
+		}{Items: []child{{Name: "valid"}}}
+	}
+	v := validate.Struct(source)
+	result.Valid = v.Validate()
+	result.Errors = len(v.Errors)
+}
+
+func p2pAssertSkippedRecursiveField(t *testing.T) {
+	t.Helper()
+	executable, err := os.Executable()
+	if err != nil {
+		t.Skipf("INCONCLUSIVE: cannot locate test binary: %v", err)
+	}
+	for _, mode := range []string{"normal", "recursive"} {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		cmd := exec.CommandContext(ctx, executable, "-test.run=^TestP2PStaticDynamicClassificationAndCycles$")
+		cmd.Env = append(os.Environ(), "P2P_SKIPPED_FIELD_CHILD="+mode)
+		output, runErr := cmd.CombinedOutput()
+		timedOut := ctx.Err() == context.DeadlineExceeded
+		cancel()
+		if timedOut {
+			if mode == "normal" {
+				t.Skip("INCONCLUSIVE: normal-pointer control timed out")
+			}
+			t.Fatal("unmarked recursive pointer map must be skipped and terminate; normal-pointer control completed")
+		}
+		if runErr != nil {
+			t.Skipf("INCONCLUSIVE: child process failed: %v; %s", runErr, output)
+		}
+		found := false
+		for _, line := range strings.Split(string(output), "\n") {
+			const prefix = "P2P_SKIPPED_FIELD_RESULT "
+			if !strings.HasPrefix(line, prefix) {
+				continue
+			}
+			var result struct {
+				Valid  *bool   `json:"valid"`
+				Errors *int    `json:"errors"`
+				Panic  *string `json:"panic"`
+			}
+			if err := json.Unmarshal([]byte(strings.TrimPrefix(line, prefix)), &result); err != nil || result.Valid == nil || result.Errors == nil || result.Panic == nil {
+				t.Skipf("INCONCLUSIVE: malformed child result: %s", line)
+			}
+			found = true
+			if !*result.Valid || *result.Errors != 0 || *result.Panic != "" {
+				t.Fatalf("skipped field %s changed outcome: %s", mode, line)
+			}
+		}
+		if !found {
+			t.Skipf("INCONCLUSIVE: child returned no structured result: %s", output)
+		}
+	}
+}
+
+func TestP2PStaticDynamicClassificationAndCycles(t *testing.T) {
+	if mode := os.Getenv("P2P_SKIPPED_FIELD_CHILD"); mode != "" {
+		p2pSkippedFieldChild(mode)
+		return
+	}
+	p2pAssertSkippedRecursiveField(t)
+	// nil ptr-to-struct: the sub rules must not be collected.
+	nilSub := validate.Struct(&p2pPtr{Name: "n"})
+	if nilSub.Validate() {
+		t.Fatalf("nil Sub with required must fail on Sub itself")
+	}
+	if _, ok := nilSub.Errors["Sub.City"]; ok {
+		t.Fatalf("nil ptr-to-struct must not collect sub-field rules, got %v", p2pErrPairs(nilSub.Errors))
+	}
+
+	// non-nil ptr-to-struct: sub rules must be collected from the concrete value.
+	setSub := validate.Struct(&p2pPtr{Name: "n", Sub: &p2pInner{City: "c"}})
+	if setSub.Validate() {
+		t.Fatalf("Sub.Zip=empty must fail")
+	}
+	if _, ok := setSub.Errors["Sub.Zip"]["required"]; !ok {
+		t.Fatalf("non-nil ptr-to-struct must collect sub rules, got %v", p2pErrPairs(setSub.Errors))
+	}
+
+	// slice-of-struct: per-value element rules.
+	sl := validate.Struct(&p2pSlice{Items: []p2pInner{{City: "c"}}})
+	if sl.Validate() {
+		t.Fatalf("slice element must fail required Zip")
+	}
+	if _, ok := sl.Errors["Items.0.Zip"]["required"]; !ok {
+		t.Fatalf("slice-of-struct element rules missing, got %v", p2pErrPairs(sl.Errors))
+	}
+
+	// map-of-struct: per-value element rules, key path preserved.
+	mp := validate.Struct(&p2pMap{Items: map[string]p2pInner{"k": {City: "c"}}})
+	if mp.Validate() {
+		t.Fatalf("map element must fail required Zip")
+	}
+	if _, ok := mp.Errors["Items.k.Zip"]["required"]; !ok {
+		t.Fatalf("map-of-struct element rules missing, got %v", p2pErrPairs(mp.Errors))
+	}
+
+	// time.Time is a leaf: no traversal into its internals, but its own rule runs.
+	tl := validate.Struct(&p2pTimeLeaf{})
+	if tl.Validate() {
+		t.Fatalf("required fields must fail")
+	}
+	for field := range tl.Errors {
+		if strings.Contains(field, ".") {
+			t.Fatalf("time.Time must stay a leaf, unexpected nested error %q", field)
+		}
+	}
+
+	// self-recursive type must terminate and collect rules down the value chain.
+	deep := &p2pNode{Name: "n", Next: &p2pNode{Next: &p2pNode{}}}
+	rv := validate.Struct(deep)
+	rv.StopOnError = false
+	if rv.Validate() {
+		t.Fatalf("recursive chain with empty names must fail")
+	}
+	if _, ok := rv.Errors["Next.Next.Name"]["required"]; !ok {
+		t.Fatalf("recursive value chain rules missing, got %v", p2pErrPairs(rv.Errors))
+	}
+
+	// self-recursive slice type must terminate as well.
+	leaf := p2pKids{}
+	mid := p2pKids{Kids: []p2pKids{leaf}}
+	kids := validate.Struct(&p2pKids{Name: "n", Kids: []p2pKids{mid}})
+	kids.StopOnError = false
+	if kids.Validate() {
+		t.Fatalf("recursive slice elements with empty names must fail")
+	}
+	if _, ok := kids.Errors["Kids.0.Kids.0.Name"]["required"]; !ok {
+		t.Fatalf("recursive slice rules missing, got %v", p2pErrPairs(kids.Errors))
+	}
+}
