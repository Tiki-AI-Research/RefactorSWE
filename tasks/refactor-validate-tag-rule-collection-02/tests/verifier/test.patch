+// ---------------------------------------------------------------------------
+// REQ-INTEGRITY-001 / REQ-INTEGRITY-003: no removed public API, no new
+// third-party dependency and no new public configuration flag.
+// ---------------------------------------------------------------------------
+
+func TestP2PPublicSurfaceAndDependencyFreeze(t *testing.T) {
+	// GlobalOption exported flags are frozen.
+	wantFlags := []string{
+		"FilterTag", "ValidateTag", "FieldTag", "LabelTag", "MessageTag",
+		"DefaultTag", "StopOnError", "SkipOnEmpty", "UpdateSource",
+		"CheckDefault", "ErrShowValue", "CheckZero", "ErrKeyFmt",
+		"CheckSubOnParentMarked", "ValidatePrivateFields", "RestoreRequestBody",
+	}
+	rt := reflect.TypeOf(validate.GlobalOption{})
+	gotFlags := make([]string, 0, rt.NumField())
+	for i := 0; i < rt.NumField(); i++ {
+		if f := rt.Field(i); f.PkgPath == "" {
+			gotFlags = append(gotFlags, f.Name)
+		}
+	}
+	sort.Strings(gotFlags)
+	sorted := append([]string(nil), wantFlags...)
+	sort.Strings(sorted)
+	if strings.Join(gotFlags, ",") != strings.Join(sorted, ",") {
+		t.Fatalf("GlobalOption exported flags changed:\n got %v\nwant %v", gotFlags, sorted)
+	}
+
+	// go.mod must not gain third-party modules.
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatalf("cannot locate the test source file")
+	}
+	gomod := filepath.Join(filepath.Dir(filepath.Dir(file)), "go.mod")
+	bs, err := os.ReadFile(gomod)
+	if err != nil {
+		t.Fatalf("cannot read go.mod: %v", err)
+	}
+	allowed := map[string]bool{
+		"github.com/gookit/filter": true,
+		"github.com/gookit/goutil": true,
+		"golang.org/x/sync":        true,
+		"golang.org/x/sys":         true,
+		"golang.org/x/term":        true,
+		"golang.org/x/text":        true,
+	}
+	var extra []string
+	for _, line := range strings.Split(string(bs), "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "module ") || strings.HasPrefix(line, "go ") ||
+			strings.HasPrefix(line, "require (") || line == ")" || strings.HasPrefix(line, "//") {
+			continue
+		}
+		fields := strings.Fields(line)
+		if len(fields) < 2 || strings.HasPrefix(fields[0], "(") {
+			continue
+		}
+		if strings.HasPrefix(line, "require ") {
+			fields = fields[1:]
+			if len(fields) < 2 {
+				continue
+			}
+		}
+		mod := fields[0]
+		if strings.Contains(mod, "/") && !allowed[mod] {
+			extra = append(extra, mod)
+		}
+	}
+	if len(extra) > 0 {
+		t.Fatalf("go.mod gained third-party dependencies: %v", extra)
+	}
+	if !strings.Contains(string(bs), "module github.com/gookit/validate/v2") {
+		t.Fatalf("the module path must stay github.com/gookit/validate/v2")
+	}
+}
