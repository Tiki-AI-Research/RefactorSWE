+// Command f2p_runner runs the declared F2P test leaves of this repository and
+// writes a JUnit XML report.
+//
+// It is intentionally self-contained: only the Go standard library and the
+// already-installed `go` toolchain are used, every child process runs with
+// GOPROXY=off, and nothing is ever installed or downloaded. When the pipeline
+// provides VERIFIER_EXEC_DIR the `go test` build work directory is relocated
+// there via GOTMPDIR, because the verifier's temporary directory may be mounted
+// noexec.
+//
+// Selection: the runner accepts `-select` (a readable selection file or inline
+// selector text) or `-node` (one exact `path::leaf` selector).
+//
+// `-node` executes exactly that one selector, which is what the per-node runs
+// of the frozen P2P and the F2P nodes use.
+//
+// Without `-node` the runner is the summary runner: it executes the exact
+// selector set of the frozen P2P plan together with the exact selector set
+// declared by the F2P plan. The F2P set is declared in this file and is also
+// taken from `-select`; the frozen P2P set is read from the
+// pipeline-materialised selection assets (`p2p_select.txt`, `config.json`, the
+// selection environment) when they are present, and otherwise from the
+// selector mirror declared in this file. Nothing else is ever added, so the
+// summary JUnit report always carries every declared node and no other node.
+//
+// Report: one JUnit <testcase> per selector, classname = selector file path and
+// name = exact test leaf, so a node identity is exactly `path::leaf`. A node
+// that did not run (build failure, missing test, timeout) is reported as
+// <error>, never as a passing or skipped node.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+type selector struct {
+	path string
+	leaf string
+}
+
+func (s selector) String() string { return s.path + "::" + s.leaf }
+
+type nodeResult struct {
+	sel       selector
+	status    string // pass | fail | skip | error
+	elapsed   float64
+	output    strings.Builder
+	message   string
+	errorType string
+	phase     string
+}
+
+var selectorRe = regexp.MustCompile(`(?m)^([A-Za-z0-9_][A-Za-z0-9_./-]*\.go)::([^\r\n]+)$`)
+
+func parseSelectors(raw []byte) []selector {
+	seen := map[string]bool{}
+	var out []selector
+	for _, match := range selectorRe.FindAllStringSubmatch(string(raw), -1) {
+		path := strings.TrimPrefix(filepath.ToSlash(match[1]), "./")
+		key := path + "::" + match[2]
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, selector{path: path, leaf: match[2]})
+	}
+	return out
+}
+
+func loadPathOrText(value string) ([]selector, bool) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return nil, false
+	}
+	if bs, err := os.ReadFile(value); err == nil {
+		if sels := parseSelectors(bs); len(sels) > 0 {
+			return sels, true
+		}
+	}
+	if sels := parseSelectors([]byte(value)); len(sels) > 0 {
+		return sels, true
+	}
+	return nil, false
+}
