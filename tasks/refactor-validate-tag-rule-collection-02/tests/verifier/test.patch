+// parseSelectors extracts every `path::leaf` token from the selection input.
+func parseSelectors(raw []byte) []selector {
+	seen := map[string]bool{}
+	var out []selector
+	for _, m := range selectorRe.FindAllStringSubmatch(string(raw), -1) {
+		sel := selector{path: filepath.ToSlash(m[1]), leaf: m[2]}
+		if seen[sel.String()] {
+			continue
+		}
+		seen[sel.String()] = true
+		out = append(out, sel)
+	}
+	return out
+}
+
+// selectorsFromList parses selectors out of an explicit list of strings.
+func selectorsFromList(items []string) []selector {
+	seen := map[string]bool{}
+	var out []selector
+	for _, item := range items {
+		for _, m := range selectorRe.FindAllStringSubmatch(item, -1) {
+			sel := selector{path: filepath.ToSlash(m[1]), leaf: m[2]}
+			if seen[sel.String()] {
+				continue
+			}
+			seen[sel.String()] = true
+			out = append(out, sel)
+		}
+	}
+	return out
+}
+
+// selectorsFromJSON extracts selectors from a JSON document that does not carry
+// plain `path::leaf` text, e.g. {"p2p":[{"selector":"a_test.go::TestA"}]} or
+// {"selectors":[{"path":"a_test.go","leaf":"TestA"}]}. Documents that carry a
+// top-level p2p/p2p_select list are read from that list only, so that any
+// inventory or coverage section of a plan document cannot widen the selection.
+func selectorsFromJSON(raw []byte) []selector {
+	var doc any
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		return nil
+	}
+	seen := map[string]bool{}
+	var out []selector
+	add := func(path, leaf string) {
+		path = filepath.ToSlash(strings.TrimSpace(path))
+		leaf = strings.TrimSpace(leaf)
+		if i := strings.Index(leaf, "::"); i >= 0 {
+			if p := strings.TrimSpace(leaf[:i]); p != "" {
+				path, leaf = filepath.ToSlash(p), strings.TrimSpace(leaf[i+2:])
+			}
+		}
+		if !strings.HasSuffix(path, ".go") || !leafRe.MatchString(leaf) {
+			return
+		}
+		sel := selector{path: path, leaf: leaf}
+		if seen[sel.String()] {
+			return
+		}
+		seen[sel.String()] = true
+		out = append(out, sel)
+	}
+	addText := func(v string) {
+		for _, m := range selectorRe.FindAllStringSubmatch(v, -1) {
+			add(m[1], m[2])
+		}
+	}
+
+	if obj, ok := doc.(map[string]any); ok {
+		for _, key := range []string{"p2p", "p2p_select", "selectors", "nodes", "tests"} {
+			items, ok := obj[key].([]any)
+			if !ok {
+				continue
+			}
+			found := selectorsFromItems(items, add)
+			if found {
+				return out
+			}
+		}
+	}
+
+	var walk func(v any)
+	walk = func(v any) {
+		switch t := v.(type) {
+		case string:
+			addText(t)
+		case []any:
+			for _, item := range t {
+				walk(item)
+			}
+		case map[string]any:
+			keys := make([]string, 0, len(t))
+			for k := range t {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var pathVal, leafVal string
+			for _, k := range keys {
+				s, ok := t[k].(string)
+				if !ok {
+					continue
+				}
+				switch strings.ToLower(k) {
+				case "path", "file", "filepath", "filename", "classname", "class":
+					if pathVal == "" {
+						pathVal = s
+					}
+				case "leaf", "test", "name", "selector", "id", "testname", "test_name":
+					if leafVal == "" {
+						leafVal = s
+					}
+				}
+			}
+			if pathVal != "" && leafVal != "" {
+				add(pathVal, leafVal)
+			}
+			for _, k := range keys {
+				walk(t[k])
+			}
+		}
+	}
+	walk(doc)
+	return out
+}
+
+// selectorsFromItems reads a JSON list whose entries are selector strings or
+// objects carrying path/leaf fields. It reports whether the list itself was
+// understood, so callers can avoid widening the selection through a fallback.
+func selectorsFromItems(items []any, add func(path, leaf string)) bool {
+	understood := false
+	for _, item := range items {
+		switch t := item.(type) {
+		case string:
+			if sels := parseSelectors([]byte(t)); len(sels) > 0 {
+				for _, s := range sels {
+					add(s.path, s.leaf)
+				}
+				understood = true
+			}
+		case map[string]any:
+			keys := make([]string, 0, len(t))
+			for k := range t {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var pathVal, leafVal string
+			for _, k := range keys {
+				s, ok := t[k].(string)
+				if !ok {
+					continue
+				}
+				switch strings.ToLower(k) {
+				case "path", "file", "filepath", "filename", "classname", "class":
+					if pathVal == "" {
+						pathVal = s
+					}
+				case "leaf", "test", "name", "selector", "id", "testname", "test_name":
+					if leafVal == "" {
+						leafVal = s
+					}
+				}
+			}
+			if pathVal != "" && leafVal != "" {
+				add(pathVal, leafVal)
+				understood = true
+			}
+		}
+	}
+	return understood
+}
+
+// readSelectorFile reads one candidate file. It reports whether the file exists
+// (readable) and yields at least one selector.
+func readSelectorFile(path string) ([]selector, bool) {
+	bs, err := os.ReadFile(path)
+	if err != nil {
+		return nil, false
+	}
+	if sels := parseSelectors(bs); len(sels) > 0 {
+		return sels, true
+	}
+	if sels := selectorsFromJSON(bs); len(sels) > 0 {
+		return sels, true
+	}
+	return nil, false
+}
+
+// anchoredVariants expands a possibly relative argument into the same relative
+// path anchored at the working directory and its ancestors, so a pipeline path
+// that is relative to the workspace root still resolves when the command runs
+// from the repository root.
+func anchoredVariants(v string) []string {
+	if filepath.IsAbs(v) {
+		return []string{v}
+	}
+	seen := map[string]bool{filepath.Clean(v): true}
+	out := []string{v}
+	dir, err := os.Getwd()
+	if err != nil {
+		return out
+	}
+	for i := 0; i < 4; i++ {
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			break
+		}
+		dir = parent
+		cand := filepath.Join(dir, v)
+		if !seen[cand] {
+			seen[cand] = true
+			out = append(out, cand)
+		}
+	}
+	return out
+}
+
+// loadPathOrText interprets one selection argument as a file path or, failing
+// that, as inline selector text.
+func loadPathOrText(v string) ([]selector, string, bool) {
+	v = strings.TrimSpace(v)
+	if v == "" {
+		return nil, "", false
+	}
+	for _, p := range anchoredVariants(v) {
+		if sels, ok := readSelectorFile(p); ok {
+			return sels, p, true
+		}
+	}
+	if sels := parseSelectors([]byte(v)); len(sels) > 0 {
+		return sels, "argument text", true
+	}
+	if sels := selectorsFromJSON([]byte(v)); len(sels) > 0 {
+		return sels, "argument text", true
+	}
+	return nil, "", false
+}
+
+// envSelectionValues collects selection values passed through the environment.
+func envSelectionValues() []string {
+	var out []string
+	seen := map[string]bool{}
+	add := func(v string) {
+		v = strings.TrimSpace(v)
+		if v != "" && !seen[v] {
+			seen[v] = true
+			out = append(out, v)
+		}
+	}
+	for _, name := range []string{
+		"P2P_SELECT", "P2P_SELECT_FILE", "P2P_SELECTORS", "P2P_SELECTOR",
+		"VERIFIER_P2P_SELECT", "VERIFIER_SELECT", "VERIFIER_SELECT_FILE",
+		"P2P_CONFIG", "P2P_CONFIG_FILE", "VERIFIER_CONFIG", "VERIFIER_CONFIG_FILE",
+	} {
+		add(os.Getenv(name))
+	}
+	for _, kv := range os.Environ() {
+		name, value, ok := strings.Cut(kv, "=")
+		if !ok {
+			continue
+		}
+		upper := strings.ToUpper(name)
+		if !strings.Contains(upper, "SELECT") && !strings.Contains(upper, "P2P") && !strings.Contains(upper, "VERIFIER") {
+			continue
+		}
+		if strings.Contains(value, "::") {
+			add(value)
+		}
+	}
+	return out
+}
+
+// conventionalPaths lists the pipeline asset locations that may carry the
+// selection: the repository root and its ancestors, the report directory and
+// its ancestors, the home directory and the replay workspace roots. Besides the
+// well-known asset names it also accepts any readable file whose name mentions
+// "select" in those directories.
+func conventionalPaths(root, reportPath string) []string {
+	var dirs []string
+	addDir := func(d string) {
+		if d == "" {
+			return
+		}
+		abs, err := filepath.Abs(d)
+		if err != nil {
+			abs = d
+		}
+		abs = filepath.Clean(abs)
+		for _, x := range dirs {
+			if x == abs {
+				return
+			}
+		}
+		dirs = append(dirs, abs)
+	}
+
+	base := root
+	if base == "" {
+		base = "."
+	}
+	for i := 0; i < 5; i++ {
+		addDir(base)
+		parent := filepath.Dir(base)
+		if parent == base {
+			break
+		}
+		base = parent
+	}
+	if reportPath != "" {
+		dir := filepath.Dir(reportPath)
+		for i := 0; i < 3; i++ {
+			addDir(dir)
+			parent := filepath.Dir(dir)
+			if parent == dir {
+				break
+			}
+			dir = parent
+		}
+	}
+	if home, err := os.UserHomeDir(); err == nil {
+		addDir(home)
+	}
+	addDir(os.TempDir())
+	for _, d := range []string{"/workspace", "/workspace/repo", "/workspace/verifier"} {
+		addDir(d)
+	}
+
+	selectNames := []string{"p2p_select.txt", "p2p_select", "p2p-select.txt", "p2p-select"}
+	otherNames := []string{"config.json", "p2p.json", "selectors.txt"}
+	var selectFiles, otherFiles []string
+	for _, d := range dirs {
+		for _, n := range selectNames {
+			selectFiles = append(selectFiles, filepath.Join(d, n))
+		}
+		for _, n := range otherNames {
+			otherFiles = append(otherFiles, filepath.Join(d, n))
+		}
+		for _, sub := range []string{d, filepath.Join(d, "verifier")} {
+			selectFiles = append(selectFiles, filepath.Join(sub, "p2p_select.txt"))
+			selectFiles = append(selectFiles, filepath.Join(sub, "p2p_select"))
+			entries, err := os.ReadDir(sub)
+			if err != nil {
+				continue
+			}
+			for _, e := range entries {
+				if e.IsDir() {
+					continue
+				}
+				if strings.Contains(strings.ToLower(e.Name()), "select") {
+					selectFiles = append(selectFiles, filepath.Join(sub, e.Name()))
+				}
+			}
+		}
+	}
+	// A real select file wins over a generic config file, wherever it lives.
+	return append(selectFiles, otherFiles...)
+}
+
+// resolveSelection resolves the node selection from the pipeline inputs and,
+// only when none of them exists, from the declared selector mirror.
+func resolveSelection(selectFlag, configFlag, reportPath, root string) ([]selector, string, error) {
+	var tried []string
+	for _, v := range []string{selectFlag, configFlag} {
+		if strings.TrimSpace(v) == "" {
+			continue
+		}
+		if sels, src, ok := loadPathOrText(v); ok {
+			return sels, src, nil
+		}
+		tried = append(tried, v)
+	}
+	for _, v := range envSelectionValues() {
+		if sels, src, ok := loadPathOrText(v); ok {
+			return sels, src, nil
+		}
+		tried = append(tried, v)
+	}
+	for _, p := range conventionalPaths(root, reportPath) {
+		if sels, ok := readSelectorFile(p); ok {
+			return sels, p, nil
+		}
+	}
+	if sels := selectorsFromList(declaredP2PSelectors); len(sels) > 0 {
+		fmt.Fprintf(os.Stderr,
+			"p2p_runner: notice: no pipeline selection asset available (%d argument(s) tried); using the declared P2P selector mirror (%d selectors)\n",
+			len(tried), len(sels))
+		return sels, "declared P2P selector mirror", nil
+	}
+	return nil, "", fmt.Errorf("no selection input found")
+}
+
+// normalizeSelectors rewrites selector paths into the repository-relative form
+// declared by the plan, so a selection asset that carries absolute or anchored
+// paths still produces the declared JUnit node identity.
+func normalizeSelectors(sels []selector, root string) []selector {
+	out := make([]selector, 0, len(sels))
+	for _, s := range sels {
+		p := strings.TrimPrefix(filepath.ToSlash(s.path), "./")
+		if filepath.IsAbs(p) {
+			if rel, err := filepath.Rel(root, p); err == nil && !strings.HasPrefix(rel, "..") {
+				p = filepath.ToSlash(rel)
+			}
+		}
+		if _, err := os.Stat(filepath.Join(root, filepath.FromSlash(p))); err != nil {
+			parts := strings.Split(p, "/")
+			for i := 1; i < len(parts) && i <= 4; i++ {
+				cand := strings.Join(parts[i:], "/")
+				if _, err := os.Stat(filepath.Join(root, filepath.FromSlash(cand))); err == nil {
+					p = cand
+					break
+				}
+			}
+		}
+		out = append(out, selector{path: p, leaf: s.leaf})
+	}
+	return out
+}
+
+// findRepoRoot walks up from root until it finds the module file, so the runner
+// also works when it is started from a subdirectory of the repository.
+func findRepoRoot(root string) string {
+	abs, err := filepath.Abs(root)
+	if err != nil {
+		return root
+	}
+	dir := abs
+	for i := 0; i < 6; i++ {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			break
+		}
+		dir = parent
+	}
+	return abs
+}
+
+func packagePattern(selPath string) string {
+	dir := filepath.Dir(selPath)
+	if dir == "." || dir == "" {
+		return "."
+	}
+	return "./" + filepath.ToSlash(dir)
+}
+
+type testEvent struct {
+	Action  string  `json:"Action"`
+	Package string  `json:"Package"`
+	Test    string  `json:"Test"`
+	Elapsed float64 `json:"Elapsed"`
+	Output  string  `json:"Output"`
+}
+
+// testChildEnv builds the environment of a `go test` child process. When the
+// pipeline provides VERIFIER_EXEC_DIR, the build work directory is relocated
+// there because that directory is the one guaranteed to be executable, while
+// the verifier's temporary directory may be mounted noexec.
+func testChildEnv() []string {
+	env := append(os.Environ(), "GOPROXY=off")
+	if dir := strings.TrimSpace(os.Getenv("VERIFIER_EXEC_DIR")); dir != "" {
+		if err := os.MkdirAll(dir, 0o755); err == nil {
+			env = append(env, "GOTMPDIR="+dir)
+		}
+	}
+	return env
+}
+
+// runPackage runs one package with a -run regexp covering the given leaves and
+// returns per-leaf results.
+func runPackage(root string, pkg string, sels []selector, timeout time.Duration) map[string]*nodeResult {
+	results := make(map[string]*nodeResult, len(sels))
+	for _, sel := range sels {
+		results[sel.leaf] = &nodeResult{sel: sel, status: "error", message: "test did not run", errorType: "ReportError"}
+	}
+	var pattern string
+	if len(sels) == 1 {
+		// Go splits -run at slashes. Quote and anchor each segment so literal
+		// stars, brackets, dots and punctuation never select another subtest.
+		segments := strings.Split(sels[0].leaf, "/")
+		for i, segment := range segments {
+			segments[i] = "^" + regexp.QuoteMeta(segment) + "$"
+		}
+		pattern = strings.Join(segments, "/")
+	} else {
+		// The package summary records only declared leaves, without scoring parents.
+		seen := map[string]bool{}
+		var tops []string
+		for _, sel := range sels {
+			top := strings.Split(sel.leaf, "/")[0]
+			if !seen[top] {
+				seen[top] = true
+				tops = append(tops, regexp.QuoteMeta(top))
+			}
+		}
+		sort.Strings(tops)
+		pattern = "^(" + strings.Join(tops, "|") + ")$"
+	}
+	cmd := exec.Command("go", "test", "-json", "-count=1", "-timeout", timeout.String(), "-run", pattern, pkg)
+	cmd.Dir, cmd.Env = root, testChildEnv()
+	// The verifier can supply immutable, hash-bound build artifacts. Each
+	// selected leaf still gets a fresh process with the exact same regexp,
+	// count, timeout and package working directory as go test.
+	if prepared := os.Getenv("VERIFIER_PREPARATION_DIR"); prepared != "" {
+		binary := filepath.Join(prepared, strings.ReplaceAll(pkg, "/", "_")+".test")
+		cmd = exec.Command("go", "tool", "test2json", "-t", "-p", pkg, binary,
+			"-test.v=test2json", "-test.count=1", "-test.timeout="+timeout.String(), "-test.run="+pattern)
+		cmd.Dir = filepath.Join(root, strings.TrimPrefix(pkg, "./"))
+		cmd.Env = testChildEnv()
+	}
+
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		for _, res := range results {
+			res.message = "cannot start go test: " + err.Error()
+		}
+		return results
+	}
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		for _, res := range results {
+			res.message = "cannot start go test: " + err.Error()
+		}
+		return results
+	}
+	var packageOutput strings.Builder
+	ancestorOutput := map[string]string{}
+	failedAncestors := map[string]bool{}
+	scanner := bufio.NewScanner(stdout)
+	scanner.Buffer(make([]byte, 0, 64*1024), 8*1024*1024)
+	for scanner.Scan() {
+		var ev testEvent
+		if err := json.Unmarshal(scanner.Bytes(), &ev); err != nil {
+			packageOutput.Write(scanner.Bytes())
+			packageOutput.WriteByte('\n')
+			continue
+		}
+		if ev.Test == "" {
+			packageOutput.WriteString(ev.Output)
+			continue
+		}
+		ancestorOutput[ev.Test] += ev.Output
+		if ev.Action == "fail" {
+			failedAncestors[ev.Test] = true
+		}
+		res, ok := results[ev.Test]
+		if !ok {
+			continue
+		}
+		res.output.WriteString(ev.Output)
+		switch ev.Action {
+		case "pass":
+			res.status, res.elapsed = "pass", ev.Elapsed
+		case "fail":
+			res.status, res.elapsed, res.message = "fail", ev.Elapsed, "test assertion failed"
+		case "skip":
+			res.status, res.elapsed, res.message = "skip", ev.Elapsed, "test skipped"
+		}
+	}
+	scanErr, waitErr := scanner.Err(), cmd.Wait()
+	buildOutput := packageOutput.String() + stderr.String()
+	if scanErr != nil {
+		buildOutput += "\nreport error: " + scanErr.Error()
+	}
+	for _, res := range results {
+		if res.status != "error" {
+			continue
+		}
+		// Preserve an actual assertion in an ancestor that prevents the leaf from starting.
+		parts := strings.Split(res.sel.leaf, "/")
+		for i := 1; i < len(parts); i++ {
+			ancestor := strings.Join(parts[:i], "/")
+			if failedAncestors[ancestor] {
+				res.status, res.message = "fail", "owning test assertion failed before selected subtest"
+				res.output.WriteString(ancestorOutput[ancestor])
+				break
+			}
+		}
+		if res.status != "error" {
+			continue
+		}
+		if strings.Contains(buildOutput, "[build failed]") {
+			res.errorType, res.phase = "CompileError", "compile"
+		} else if strings.Contains(buildOutput, "test timed out") {
+			res.errorType = "Timeout"
+		}
+		if waitErr != nil {
+			res.message = "go test did not complete: " + waitErr.Error()
+		}
+		res.output.WriteString(buildOutput)
+	}
+	return results
+}
+
+type xmlFailure struct {
+	Message string `xml:"message,attr"`
+	Type    string `xml:"type,attr,omitempty"`
+	Phase   string `xml:"phase,attr,omitempty"`
+	Body    string `xml:",chardata"`
+}
+
+type xmlTestCase struct {
+	Classname string      `xml:"classname,attr"`
+	Name      string      `xml:"name,attr"`
+	File      string      `xml:"file,attr"`
+	Selector  string      `xml:"selector,attr"`
+	Time      string      `xml:"time,attr"`
+	Failure   *xmlFailure `xml:"failure,omitempty"`
+	Error     *xmlFailure `xml:"error,omitempty"`
+	Skipped   *xmlFailure `xml:"skipped,omitempty"`
+}
+
+type xmlSuite struct {
+	Name      string        `xml:"name,attr"`
+	Tests     int           `xml:"tests,attr"`
+	Failures  int           `xml:"failures,attr"`
+	Errors    int           `xml:"errors,attr"`
+	Skipped   int           `xml:"skipped,attr"`
+	Time      string        `xml:"time,attr"`
+	TestCases []xmlTestCase `xml:"testcase"`
+}
+
+type xmlSuites struct {
+	XMLName  xml.Name   `xml:"testsuites"`
+	Name     string     `xml:"name,attr"`
+	Tests    int        `xml:"tests,attr"`
+	Failures int        `xml:"failures,attr"`
+	Errors   int        `xml:"errors,attr"`
+	Skipped  int        `xml:"skipped,attr"`
+	Time     string     `xml:"time,attr"`
+	Suites   []xmlSuite `xml:"testsuite"`
+}
+
+func main() {
+	selectPath := flag.String("select", "", "path of the p2p select file ({p2p_select}) or inline selector text")
+	configPath := flag.String("config", "", "optional path of a config file carrying selectors ({config}) or inline selector text")
+	nodePath := flag.String("node", "", "optional single exact `path::leaf` selector to run alone")
+	reportPath := flag.String("report", "", "path of the JUnit report to write ({report})")
+	root := flag.String("root", ".", "repository root that contains go.mod")
+	timeout := flag.Duration("timeout", 240*time.Second, "per-package go test timeout")
+	flag.Parse()
+
+	if *reportPath == "" {
+		fmt.Fprintln(os.Stderr, "p2p_runner: -report is required")
+		os.Exit(2)
+	}
+
+	repoRoot := findRepoRoot(*root)
+
+	var sels []selector
+	var source string
+	var err error
+	if strings.TrimSpace(*nodePath) != "" {
+		sels = selectorsFromList([]string{*nodePath})
+		if len(sels) == 0 {
+			fmt.Fprintf(os.Stderr, "p2p_runner: -node carries no `path::leaf` selector: %q\n", *nodePath)
+			os.Exit(2)
+		}
+		source = "-node argument"
+	} else {
+		sels, source, err = resolveSelection(*selectPath, *configPath, *reportPath, repoRoot)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "p2p_runner: %v\n", err)
+			os.Exit(2)
+		}
+	}
+	sels = normalizeSelectors(sels, repoRoot)
+	fmt.Fprintf(os.Stderr, "p2p_runner: %d selector(s) from %s\n", len(sels), source)
+
+	byPkg := map[string][]selector{}
+	for _, s := range sels {
+		pkg := packagePattern(s.path)
+		byPkg[pkg] = append(byPkg[pkg], s)
+	}
+	pkgs := make([]string, 0, len(byPkg))
+	for pkg := range byPkg {
+		pkgs = append(pkgs, pkg)
+	}
+	sort.Strings(pkgs)
+
+	suites := xmlSuites{Name: "p2p"}
+	start := time.Now()
+	for _, pkg := range pkgs {
+		res := runPackage(repoRoot, pkg, byPkg[pkg], *timeout)
+		leaves := make([]string, 0, len(res))
+		for leaf := range res {
+			leaves = append(leaves, leaf)
+		}
+		sort.Strings(leaves)
+
+		suite := xmlSuite{Name: pkg}
+		var suiteTime float64
+		for _, leaf := range leaves {
+			r := res[leaf]
+			tc := xmlTestCase{
+				Classname: r.sel.path,
+				Name:      r.sel.leaf,
+				File:      r.sel.path,
+				Selector:  r.sel.String(),
+				Time:      fmt.Sprintf("%.3f", r.elapsed),
+			}
+			body := r.output.String()
+			switch r.status {
+			case "pass":
+			case "fail":
+				tc.Failure = &xmlFailure{Message: r.message, Type: "AssertionFailure", Body: body}
+				suite.Failures++
+			case "skip":
+				tc.Skipped = &xmlFailure{Message: r.message, Body: body}
+				suite.Skipped++
+			default:
+				tc.Error = &xmlFailure{Message: r.message, Type: r.errorType, Phase: r.phase, Body: body}
+				suite.Errors++
+			}
+			suiteTime += r.elapsed
+			suite.TestCases = append(suite.TestCases, tc)
+		}
+		suite.Tests = len(suite.TestCases)
+		suite.Time = fmt.Sprintf("%.3f", suiteTime)
+		suites.Suites = append(suites.Suites, suite)
+		suites.Tests += suite.Tests
+		suites.Failures += suite.Failures
+		suites.Errors += suite.Errors
+		suites.Skipped += suite.Skipped
+	}
+	suites.Time = fmt.Sprintf("%.3f", time.Since(start).Seconds())
+
+	bs, err := xml.MarshalIndent(suites, "", "  ")
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "p2p_runner: cannot encode JUnit report: %v\n", err)
+		os.Exit(2)
+	}
+	out := append([]byte(xml.Header), bs...)
+	out = append(out, '\n')
+	if dir := filepath.Dir(*reportPath); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			fmt.Fprintf(os.Stderr, "p2p_runner: cannot create report dir: %v\n", err)
+			os.Exit(2)
+		}
+	}
+	if err := os.WriteFile(*reportPath, out, 0o644); err != nil {
+		fmt.Fprintf(os.Stderr, "p2p_runner: cannot write report: %v\n", err)
+		os.Exit(2)
+	}
+	fmt.Fprintf(os.Stderr, "p2p_runner: wrote %s (tests=%d failures=%d errors=%d skipped=%d)\n",
+		*reportPath, suites.Tests, suites.Failures, suites.Errors, suites.Skipped)
+	if suites.Failures > 0 || suites.Errors > 0 || suites.Skipped > 0 {
+		os.Exit(1)
+	}
+}
