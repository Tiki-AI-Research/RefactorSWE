+// ---------------------------------------------------------------------------
+// REQ-BEH-T3:B4 / REQ-STRUCT-003: static template sharing is concurrency-safe
+// and stays per-instance isolated.
+// ---------------------------------------------------------------------------
+
+type p2pConc struct {
+	Name string   `validate:"required|min_len:3" filter:"trim|lower"`
+	Age  int      `validate:"required|int|min:1|max:120"`
+	Addr p2pInner `validate:"required"`
+}
+
+type p2pConcSlice struct {
+	Items []p2pInner `validate:"required"`
+}
+
+func TestP2PStaticTemplateConcurrency(t *testing.T) {
+	const workers, iters = 8, 60
+
+	var wg sync.WaitGroup
+	fail := make(chan string, workers*iters)
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func(w int) {
+			defer wg.Done()
+			for i := 0; i < iters; i++ {
+				if (w+i)%2 == 0 {
+					u := &p2pConc{Name: "  Ann  ", Age: 30, Addr: p2pInner{City: "c", Zip: "123"}}
+					v := validate.Struct(u)
+					if !v.Validate() {
+						fail <- "valid value rejected: " + strings.Join(p2pErrPairs(v.Errors), ";")
+						continue
+					}
+					if u.Name != "ann" {
+						fail <- "filter not applied under concurrency: " + u.Name
+					}
+					continue
+				}
+
+				u := &p2pConc{Name: "x"}
+				v := validate.Struct(u)
+				v.StopOnError = false
+				if v.Validate() {
+					fail <- "invalid value accepted under concurrency"
+					continue
+				}
+				if _, ok := v.Errors["Name"]["min_len"]; !ok {
+					fail <- "missing Name.min_len under concurrency: " + strings.Join(p2pErrPairs(v.Errors), ";")
+				}
+				if _, ok := v.Errors["Age"]["required"]; !ok {
+					fail <- "missing Age.required under concurrency: " + strings.Join(p2pErrPairs(v.Errors), ";")
+				}
+				if _, ok := v.Errors["Addr.City"]["required"]; !ok {
+					fail <- "missing Addr.City.required under concurrency: " + strings.Join(p2pErrPairs(v.Errors), ";")
+				}
+			}
+		}(w)
+	}
+	wg.Wait()
+	close(fail)
+	for msg := range fail {
+		t.Error(msg)
+	}
+}
