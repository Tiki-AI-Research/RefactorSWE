+// ---------------------------------------------------------------------------
+
+func TestP2PUnrelatedSubsystemsSmoke(t *testing.T) {
+	// map source + programmatic rules
+	mv := validate.Map(map[string]any{"name": "inhere", "age": 20})
+	mv.StringRules(validate.MS{"name": "required|string:3", "age": "required|int|min:1"})
+	if !mv.Validate() {
+		t.Fatalf("map validation must pass, errors: %v", p2pErrPairs(mv.Errors))
+	}
+	badMap := validate.Map(map[string]any{"name": ""})
+	badMap.StringRule("name", "required")
+	if badMap.Validate() {
+		t.Fatalf("map validation must fail for empty required field")
+	}
+
+	// scenes (configured through WithScenes, the struct-scene config API)
+	type sc struct {
+		Name string `validate:"required"`
+		Age  int    `validate:"required|min:18"`
+	}
+	scenes := validate.SValues{"create": {"Name"}, "update": {"Age"}}
+	if v := validate.Struct(&sc{Name: "n"}).WithScenes(scenes).SetScene("create"); !v.Validate() {
+		t.Fatalf("create scene must ignore the update-only Age rule: %v", p2pErrPairs(v.Errors))
+	}
+	if v := validate.Struct(&sc{Name: "n"}).WithScenes(scenes).SetScene("update"); v.Validate() {
+		t.Fatalf("update scene must validate Age")
+	}
+
+	// result binding
+	type out struct {
+		Name string `json:"name"`
+		Age  int    `json:"age"`
+	}
+	res := validate.Map(map[string]any{"name": "tom", "age": 33})
+	res.StringRules(validate.MS{"name": "required|string", "age": "required|int"})
+	rr := res.ValidateR()
+	if rr.Fail() {
+		t.Fatalf("map validation must pass, errors: %v", p2pErrPairs(rr.Errors))
+	}
+	var bound out
+	if err := rr.BindSafeData(&bound); err != nil {
+		t.Fatalf("BindSafeData returned error: %v", err)
+	}
+	if bound.Name != "tom" || bound.Age != 33 {
+		t.Fatalf("result binding changed: %+v", bound)
+	}
+
+	// message rendering of a builtin validator stays intact
+	type msgT struct {
+		Name string `validate:"min_len:5"`
+	}
+	mv2 := validate.Struct(&msgT{Name: "ab"})
+	if mv2.Validate() {
+		t.Fatalf("min_len must fail")
+	}
+	if got := mv2.Errors["Name"]["min_len"]; got != "Name min length is 5" {
+		t.Fatalf("builtin message rendering changed: %q", got)
+	}
+}
