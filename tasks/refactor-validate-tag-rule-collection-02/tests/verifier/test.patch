+// Command p2p_runner runs the P2P-selected Go test nodes and writes a JUnit
+// XML report.
+//
+// It is intentionally self-contained: it uses only the Go standard library and
+// the `go` toolchain already present in the image, never touches the network
+// (GOPROXY=off for every child process) and never installs anything.
+//
+// Execution directory: the verifier's temporary directory may be mounted
+// noexec, so when the pipeline supplies VERIFIER_EXEC_DIR (declared through
+// require_exec) the runner relocates the `go test` build work directory there
+// via GOTMPDIR, keeping every executed build artifact inside the exec-allowed
+// directory.
+//
+// Selection input: the node selection is taken from the pipeline-materialised
+// selection assets only. The runner accepts
+//
+//   - the `-select` argument (the pipeline's p2p select file, {p2p_select}),
+//     either as a readable file path or as the selector text itself;
+//   - the `-config` argument (the pipeline's config file, {config}), with the
+//     same file-or-text handling;
+//   - the conventional `p2p_select.txt` / `config.json` asset locations below
+//     the repository root, its parents, the report directory and the replay
+//     workspace roots;
+//   - a `P2P_SELECT` / `VERIFIER_P2P_SELECT` style environment variable that
+//     carries the selection.
+//
+// Only when no such pipeline input exists does it fall back to the declared
+// selector mirror compiled into this file, which is exactly the selector set
+// declared by the frozen p2p plan, so that a real JUnit report is always
+// produced instead of a runner crash. It never accepts a selection list from
+// any other source.
+//
+// Report: one JUnit <testcase> per selector, classname = the selector's file
+// path and name = the exact test leaf, so the JUnit identity of a node is
+// exactly `path::leaf`. A node that did not run (compile failure, missing test,
+// timeout) is reported as <error>, never as a passing or skipped node.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+type selector struct {
+	path string
+	leaf string
+}
+
+func (s selector) String() string { return s.path + "::" + s.leaf }
+
+type nodeResult struct {
+	sel       selector
+	status    string // pass | fail | skip | error
+	elapsed   float64
+	output    strings.Builder
+	message   string
+	errorType string
+	phase     string
+}
+
+var selectorRe = regexp.MustCompile(`(?m)^([A-Za-z0-9_][A-Za-z0-9_./-]*\.go)::([^\r\n]+)$`)
+
+var leafRe = regexp.MustCompile(`^Test[^\r\n]+$`)
