+func p2pErrPairs(es validate.Errors) []string {
+	lines := make([]string, 0, len(es))
+	for field, msgs := range es {
+		keys := make([]string, 0, len(msgs))
+		for k := range msgs {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			lines = append(lines, fmt.Sprintf("%s.%s=%s", field, k, msgs[k]))
+		}
+	}
+	sort.Strings(lines)
+	return lines
+}
