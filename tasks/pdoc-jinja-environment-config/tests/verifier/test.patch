+    def render(self, kind):
+        if kind == "module":
+            result = pdoc.render.html_module(
+                self.modules["qc_alpha"], self.modules, mtime="1234.6"
+            )
+        elif kind == "index":
+            result = pdoc.render.html_index(self.modules)
+        elif kind == "error":
+            result = pdoc.render.html_error("boom<&>", details="detail<&>\nline2")
+        elif kind == "search":
+            result = pdoc.render.search_index(self.modules)
+        else:
+            raise AssertionError(kind)
+        assert isinstance(result, str)
+        return result.encode("utf8")
