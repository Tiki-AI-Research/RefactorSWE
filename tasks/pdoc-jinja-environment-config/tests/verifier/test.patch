+"""
+F2P tests: rendering configuration must be carried explicitly by each consumer.
+
+These nodes pin down the acceptance surfaces that change once rendering
+configuration is no longer read from shared, module-level mutable state:
+a web server instance renders with the configuration that was in effect when
+it was created, and later `pdoc.render.configure` calls must not alter what an
+already-created server serves. Every node here fails on the pre-refactor
+baseline and passes once each consumer receives its configuration explicitly.
+"""
+
+from __future__ import annotations
+
+import io
+from html.parser import HTMLParser
+from pathlib import Path
+import socket
+import threading
+from unittest.mock import patch
+import warnings
+
+import pytest
+
+from pdoc.__main__ import cli
+import pdoc.render
+from pdoc.web import DocHandler
+from pdoc.web import DocServer
+from test.test_p2p_render_contract import assert_no_shared_config_dependency
+
+here = Path(__file__).parent
+testdata = here / "testdata"
+
+GOOGLE_DOCSTRING_SOURCE = '''\
+"""F2P module rendered with a Google-style docstring."""
+
+
+def compute(x):
+    """Compute the value of x.
+
+    Args:
+        x: The input value.
+    """
+    return x
+'''
+
+UNDOCUMENTED_MEMBER_SOURCE = '''\
+"""F2P module that contains a member without a docstring."""
+
+
+def documented_function():
+    """Documented function."""
+
+
+def hidden_member():
+    pass
+'''
+
+
+@pytest.fixture(autouse=True)
+def restore_render_config():
+    """Start from, and restore, the default rendering configuration."""
+    pdoc.render.configure()
+    yield
+    pdoc.render.configure()
+
+
+def write_module(tmp_path: Path, name: str, source: str) -> Path:
+    path = tmp_path / f"{name}.py"
+    path.write_text(source, "utf8")
+    return path
+
+
+def make_server(specs: list[str]) -> DocServer:
+    return DocServer(("", 8080), specs=list(specs), bind_and_activate=False)
+
+
+class _ReadResponse(threading.Thread):
+    def __init__(self, sock: socket.socket):
+        super().__init__()
+        self.sock = sock
+        self.data = io.BytesIO()
+
+    def run(self) -> None:
+        while True:
+            chunk = self.sock.recv(65536)
+            if chunk:
+                self.data.write(chunk)
+            else:
+                return
+
+
+def request(server: DocServer, raw: bytes) -> tuple[list[str], bytes]:
+    client, handler_socket = socket.socketpair()
+    handler_socket.send(raw)
+    reader = _ReadResponse(handler_socket)
+    reader.start()
+    DocHandler(client, ("127.0.0.1", 54321), server)  # type: ignore[arg-type]
+    client.close()
+    reader.join()
+    head, _, body = reader.data.getvalue().partition(b"\r\n\r\n")
+    return head.decode("latin-1").splitlines(), body
+
+
+def strip_livereload(body: bytes) -> bytes:
+    """Remove the live-reload script that the web server injects into module pages."""
+    marker = body.find(b"/* Periodically check with the pdoc server")
+    if marker == -1:
+        return body
+    script_start = body.rfind(b"<script>", 0, marker)
+    script_end = body.find(b"</script>", marker) + len(b"</script>")
+    return body[:script_start] + body[script_end:]
+
+
+class _LogoLinkParser(HTMLParser):
+    """Collect links that directly contain rendered logo images."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.logo_hrefs: list[str] = []
+        self._anchor_href: str | None = None
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        attributes = dict(attrs)
+        if tag == "a":
+            self._anchor_href = attributes.get("href")
+        elif (
+            tag == "img"
+            and "logo" in attributes.get("class", "").split()
+            and self._anchor_href is not None
+        ):
+            self.logo_hrefs.append(self._anchor_href)
+
+    def handle_endtag(self, tag: str) -> None:
+        if tag == "a":
+            self._anchor_href = None
+
+
+def test_server_module_page_keeps_creation_logo():
+    """A server keeps rendering the logo it was created with."""
+    pdoc.render.configure(logo="F2P-CREATED-LOGO")
+    server = make_server(["dataclasses"])
+    pdoc.render.configure(logo="F2P-LATER-LOGO")
+
+    head, body = request(server, b"GET /dataclasses.html HTTP/1.1\r\n\r\n")
+
+    assert head[0] == "HTTP/1.0 200 OK"
+    assert b"F2P-CREATED-LOGO" in body
+    assert b"F2P-LATER-LOGO" not in body
+
+
+def test_server_module_page_keeps_creation_logo_link():
