+def test_web_search_index_excludes_failed_import_records(tmp_path, monkeypatch):
+    """REQ-BEH-T1:B4 - real failed imports warn and never become search records."""
+    valid = tmp_path / "p2p_search_valid.py"
+    broken = tmp_path / "p2p_search_broken.py"
+    valid.write_text(
+        '"""A searchable module."""\n\ndef visible():\n'
+        '    """A searchable function."""\n',
+        "utf8",
+    )
+    broken.write_text('raise RuntimeError("P2P real import failure")\n', "utf8")
+    monkeypatch.syspath_prepend(str(tmp_path))
+    server = make_server([str(valid), str(broken)])
+    try:
+        assert valid.stem in server.all_modules and broken.stem in server.all_modules
+        with pytest.warns(
+            UserWarning, match="Error importing 'p2p_search_broken'"
+        ) as caught:
+            first = server.render_search_index()
+        assert any("P2P real import failure" in str(w.message) for w in caught)
+
+        # Inspect the actual index embedded in the response, including the
+        # precompiled form when Node is available. A warning alone cannot prove
+        # that a placeholder for a failed module was excluded.
+        payload, _ = json.JSONDecoder().raw_decode(
+            first.split("const docs = ", 1)[1].lstrip()
+        )
+        records = (
+            payload if isinstance(payload, list)
+            else list(payload["documentStore"]["docs"].values())
+        )
+        module_names = {record["modulename"] for record in records}
+        full_names = {record["fullname"] for record in records}
+        assert valid.stem in module_names
+        assert f"{valid.stem}.visible" in full_names
+        assert broken.stem not in module_names
+        assert not any(
+            name == broken.stem or name.startswith(broken.stem + ".")
+            for name in full_names
+        )
+
+        with warnings.catch_warnings(record=True) as repeated:
+            warnings.simplefilter("always", UserWarning)
+            assert server.render_search_index() is first
+        assert not repeated
+    finally:
+        server.server_close()
+        sys.modules.pop(valid.stem, None)
+        sys.modules.pop(broken.stem, None)
+        pdoc.doc.Module.from_name.cache_clear()
