+    def http(self, kind):
+        from pdoc.web import DocHandler
+
+        paths = {
+            "mtime": "/qc_alpha.html?mtime=1",
+            "missing": "/qc_missing.html",
+            "broken": "/qc_broken.html",
+            "module": "/qc_alpha.html",
+            "index": "/",
+        }
+        # Run the real request routing and rendering with fixed external inputs.
+        handler = DocHandler.__new__(DocHandler)
+        handler.path = paths[kind]
+        handler.server = self.server
+        statuses, headers = [], []
+        handler.send_response = lambda code: statuses.append(code)
+        handler.send_header = lambda name, value: headers.append((name.lower(), value))
+        handler.end_headers = lambda: None
+        result = handler.handle_request()
+        assert isinstance(result, str)
+        return statuses, headers, result.encode("utf8")
