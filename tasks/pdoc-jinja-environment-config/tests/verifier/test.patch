+class _ReadResponse(threading.Thread):
+    def __init__(self, sock: socket.socket):
+        super().__init__()
+        self.sock = sock
+        self.data = io.BytesIO()
+
+    def run(self) -> None:
+        while True:
+            data = self.sock.recv(65536)
+            if data:
+                self.data.write(data)
+            else:
+                return
+
+
+def make_server(specs: list[str] | None = None) -> DocServer:
+    return DocServer(
+        ("", 8080),
+        specs=list(specs or DEFAULT_SPECS),
+        bind_and_activate=False,
+    )
+
+
+def request(server: DocServer, data: bytes) -> bytes:
+    a, b = socket.socketpair()
+    b.send(data)
+    reader = _ReadResponse(b)
+    reader.start()
+    # noinspection PyTypeChecker
+    DocHandler(a, ("127.0.0.1", 54321), server)  # type: ignore[arg-type]
+    a.close()
+    reader.join()
+    return reader.data.getvalue()
+
+
+def split_response(raw: bytes) -> tuple[list[str], bytes]:
+    head, _, body = raw.partition(b"\r\n\r\n")
+    return head.decode("latin-1").splitlines(), body
+
+
+def content_type(head: list[str]) -> str:
+    for line in head:
+        if line.lower().startswith("content-type:"):
+            return line.split(":", 1)[1].strip()
+    return ""
+
+
+class _RecordingHandler(DocHandler):
+    """Run the real request dispatcher without opening sockets or hiding errors."""
+
+    def __init__(self, server: DocServer, path: str):
+        self.server = server
+        self.path = path
+        self.events = []
+
+    def send_response(self, code, message=None):
+        self.events.append(("response", code))
+
+    def send_header(self, keyword, value):
+        self.events.append(("header", keyword.lower(), value))
+
+    def end_headers(self):
+        self.events.append(("end_headers",))
+
