+LIVERELOAD_MARKER = b"/* Periodically check with the pdoc server"
+
+
+def strip_livereload(body: bytes) -> bytes:
+    """Remove the live-reload snippet that the web server injects into module pages."""
+    marker = body.find(LIVERELOAD_MARKER)
+    if marker == -1:
+        return body
+    script_start = body.rfind(b"<script>", 0, marker)
+    script_end = body.find(b"</script>", marker) + len(b"</script>")
+    return body[:script_start] + body[script_end:]
+
