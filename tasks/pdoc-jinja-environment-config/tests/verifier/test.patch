+class SharedConfigPoison:
+    """A managed shared value may exist, but consumers must not depend on it."""
+
+    def used(self, *args, **kwargs):
+        raise AssertionError("rendering read managed configuration from shared env.globals")
+
+    __str__ = __repr__ = __bool__ = __iter__ = __getitem__ = used
+    __getattr__ = __eq__ = __len__ = __call__ = used
+
+
+class SharedConfigGuard(dict):
+    """Reject rendering-time writes to managed shared config, not user state."""
+
+    def __setitem__(self, key, value):
+        if key in FIXED_CONFIG:
+            raise AssertionError("rendering wrote managed configuration to shared env.globals")
+        super().__setitem__(key, value)
+
+    def __delitem__(self, key):
+        if key in FIXED_CONFIG:
+            raise AssertionError("rendering deleted shared managed configuration")
+        super().__delitem__(key)
+
+    def update(self, *args, **kwargs):
+        for key, value in dict(*args, **kwargs).items():
+            self[key] = value
+
+    def setdefault(self, key, value=None):
+        if key not in self:
+            self[key] = value
+        return self[key]
+
+    def pop(self, key, *default):
+        if key in self:
+            value = self[key]
+            del self[key]
+            return value
+        if default:
+            return default[0]
+        raise KeyError(key)
+
+    def clear(self):
+        for key in list(self):
+            del self[key]
+
+    def popitem(self):
+        key = next(reversed(self))
+        value = self[key]
+        del self[key]
+        return key, value
+
+    def __ior__(self, other):
+        self.update(other)
+        return self
+
+
+def assert_no_shared_config_dependency(tmp_path):
+    # Configure and capture the server before guarding: the public adapter is
+    # allowed to hold active config. Only the shared template state is poisoned;
+    # private carriers/environments, class names and field layouts are unrestricted.
+    with fixed_byte_inputs(tmp_path) as inputs:
+        env = pdoc.render.env
+        original = env.globals
+        saved = dict(original)
+        poisons = {key: SharedConfigPoison() for key in FIXED_CONFIG}
+        # Poison existing aliases too (including cached Template.globals).
+        original.update(poisons)
+        guard = SharedConfigGuard(original)
+        env.globals = guard
+        env.cache.clear()
+
+        def shared_state_unchanged():
+            assert env.globals is guard, "rendering replaced the shared globals mapping"
+            for key, poison in poisons.items():
+                assert original.get(key) is poison, "rendering wrote shared config through an alias"
+                assert guard.get(key) is poison, "rendering wrote shared config bypassing dict hooks"
+
+        try:
+            for kind in FROZEN_RENDER_BYTES:
+                assert inputs.render(kind) == FROZEN_RENDER_BYTES[kind]
+                shared_state_unchanged()
+            for kind in ("mtime", "missing", "broken"):
+                assert inputs.http(kind) == FROZEN_HTTP_BYTES[kind]
+                shared_state_unchanged()
+            assert inputs.http("module")[2] == FROZEN_SERVER_MODULE_BYTES
+            assert inputs.http("index")[2] == FROZEN_SERVER_INDEX_BYTES
+            shared_state_unchanged()
+        finally:
+            env.globals = original
+            original.clear()
+            original.update(saved)
+            env.cache.clear()
