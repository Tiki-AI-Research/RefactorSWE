+def test_server_module_page_keeps_creation_edit_url_map():
+    """A server keeps rendering the edit URLs it was created with."""
+    edit_url_map = {"dataclasses": "https://edit.example/f2p/"}
+    pdoc.render.configure(edit_url_map=edit_url_map)
+    server = make_server(["dataclasses"])
+    pdoc.render.configure(edit_url_map=None)
+
+    try:
+        with patch("pdoc.extract.module_mtime", return_value=1234.567):
+            raw = b"GET /dataclasses.html HTTP/1.1\r\n\r\n"
+            _, body = request(server, raw)
+            assert b'class="pdoc-button git-button"' in body
+            assert b"https://edit.example/f2p/" in body
+
+            # Callers may reuse their options mapping for configure(B).
+            # Server A must still retain the values in effect at its creation.
+            edit_url_map["dataclasses"] = "https://edit.example/later/"
+            pdoc.render.configure(edit_url_map=edit_url_map)
+            server_b = make_server(["dataclasses"])
+            try:
+                head_a, body_a = request(server, raw)
+                head_b, body_b = request(server_b, raw)
+                assert head_a[0] == head_b[0] == "HTTP/1.0 200 OK"
+                assert body_a == body
+                assert b"https://edit.example/later/" in body_b
+                assert b"https://edit.example/f2p/" not in body_b
+                assert body_b == pdoc.render.html_module(
+                    server_b.all_modules["dataclasses"],
+                    server_b.all_modules,
+                    mtime="1234.6",
+                ).encode("utf8")
+            finally:
+                server_b.server_close()
+    finally:
+        server.server_close()
+
