+def test_cli_web_server_keeps_configuration_from_cli_invocation():
+    """The web server started by the CLI keeps rendering the CLI's configuration."""
+    captured: list[DocServer] = []
+
+    class _RecordingServer(DocServer):
+        def __init__(self, addr, specs, **kwargs):
+            super().__init__(addr, specs, **kwargs)
+            captured.append(self)
+
+        def serve_forever(self):
+            raise KeyboardInterrupt
+
+    showwarning = warnings.showwarning
+    try:
+        with (
+            patch("pdoc.web.DocServer", _RecordingServer),
+            patch("pdoc.web.open_browser"),
+        ):
+            cli(["-n", "--footer-text", "F2P-CLI-FOOTER", "dataclasses"])
+    finally:
+        warnings.showwarning = showwarning
+
+    assert len(captured) == 1
+    server = captured[0]
+    try:
+        pdoc.render.configure(footer_text="F2P-CLI-LATER")
+        _, body = request(server, b"GET /dataclasses.html HTTP/1.1\r\n\r\n")
+        assert b"F2P-CLI-FOOTER" in body
+        assert b"F2P-CLI-LATER" not in body
+    finally:
+        server.server_close()
