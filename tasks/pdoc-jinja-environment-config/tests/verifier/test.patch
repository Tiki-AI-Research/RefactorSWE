+"""
+Supplemental P2P regression tests for the frozen rendering-configuration contract.
+
+These tests pin down behavior that already holds on the baseline implementation and
+must keep holding once rendering configuration is passed to consumers explicitly.
+They are additive: no baseline test file is modified.
+"""
+
+from __future__ import annotations
+
+import inspect
+from contextlib import contextmanager, ExitStack
+from pathlib import Path
+import tomllib
+import types
+from unittest.mock import patch
+
+import pytest
+
+import pdoc
+import pdoc.doc
+import pdoc.extract
+import pdoc.render
+
+here = Path(__file__).parent
+testdata = here / "testdata"
+
+CONFIGURE_DEFAULTS = {
+    "docformat": "restructuredtext",
+    "include_undocumented": True,
+    "edit_url_map": None,
+    "favicon": None,
+    "footer_text": "",
+    "logo": None,
+    "logo_link": None,
+    "math": False,
+    "mermaid": False,
+    "search": True,
+    "show_source": True,
+    "template_directory": None,
+}
+PUBLIC_RENDER_PARAMETERS = {
+    "html_module": ("module", "all_modules", "mtime"),
+    "html_index": ("all_modules",),
+    "html_error": ("error", "details"),
+    "search_index": ("all_modules",),
+    "repr_module": ("module",),
+}
+
+
+def assert_public_render_parameters(name: str) -> None:
+    """The documented rendering entry points retain exact public parameters."""
+    parameters = tuple(inspect.signature(getattr(pdoc.render, name)).parameters.values())
+    assert tuple(parameter.name for parameter in parameters) == PUBLIC_RENDER_PARAMETERS[name]
+    assert all(
+        parameter.kind is inspect.Parameter.POSITIONAL_OR_KEYWORD
+        for parameter in parameters
+    )
+
+
+@pytest.fixture(autouse=True)
+def restore_render_config():
+    """Restore the module-level rendering configuration after each test."""
+    yield
+    pdoc.render.env.globals.pop("p2p_marker_global", None)
+    pdoc.render.env.filters.pop("p2p_marker_filter", None)
+    pdoc.render.configure()
+
+
+def test_configure_signature_defaults():
+    """REQ-BEH-T1:C1 - configure keeps the frozen parameter names and defaults."""
+    signature = inspect.signature(pdoc.render.configure)
+    assert set(signature.parameters) == set(CONFIGURE_DEFAULTS)
+    for name, default in CONFIGURE_DEFAULTS.items():
+        assert signature.parameters[name].default == default
+
+
+def test_configure_is_keyword_only():
+    """REQ-BEH-T1:C1 - configure rejects positional configuration arguments."""
+    with pytest.raises(TypeError):
+        pdoc.render.configure("markdown")  # type: ignore[misc]
+
+
+def test_configure_returns_none():
+    """REQ-BEH-T1:C1 - configure keeps returning None."""
+    assert pdoc.render.configure() is None
+
