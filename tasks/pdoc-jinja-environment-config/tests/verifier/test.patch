+    created_url = "https://created.example/logo"
+    later_url = "https://later.example/logo"
+    pdoc.render.configure(logo="F2P-LOGO", logo_link=created_url)
+    server = make_server(["dataclasses"])
+    pdoc.render.configure(logo="F2P-LOGO", logo_link=later_url)
+
+    head, body = request(server, b"GET /dataclasses.html HTTP/1.1\r\n\r\n")
+
+    assert head[0] == "HTTP/1.0 200 OK"
+    parser = _LogoLinkParser()
+    parser.feed(body.decode("utf8"))
+    assert parser.logo_hrefs
+    assert set(parser.logo_hrefs) == {created_url}
+
