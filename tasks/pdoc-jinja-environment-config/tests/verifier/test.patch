+def test_imported_macro_keeps_server_creation_configuration(tmp_path, warm):
+    from test.test_p2p_render_contract import macro_inputs
+    with macro_inputs(tmp_path) as inputs:
+        inputs.configure("A")
+        server_a = inputs.server()
+        if warm:
+            assert inputs.request(server_a) == "A|FA|False;A|FA|False"
+        inputs.configure("B")
+        server_b = inputs.server()
+        assert inputs.request(server_a) == "A|FA|False;A|FA|False"
+        assert inputs.request(server_b) == "B|FB|True;B|FB|True"
+        assert inputs.direct() == "B|FB|True;B|FB|True"
