new file mode 100644
index 0000000000000000000000000000000000000000..bcc63874fe8758a1b08abb9d94ec68a849b41d5e
--- /dev/null
+++ b/test/test_render.py
@@ -0,0 +1,87 @@
+from __future__ import annotations
+
+from dataclasses import replace
+from pathlib import Path
+
+import pdoc
+import pdoc.doc
+import pdoc.extract
+import pdoc.render
+
+here = Path(__file__).parent
+
+
+def test_configure_does_not_write_env_globals():
+    config_keys = {
+        "docformat",
+        "include_undocumented",
+        "edit_url_map",
+        "favicon",
+        "footer_text",
+        "logo",
+        "logo_link",
+        "math",
+        "mermaid",
+        "search",
+        "show_source",
+    }
+    pdoc.render.configure(search=False, logo="custom_logo")
+    try:
+        assert not (config_keys & pdoc.render.env.globals.keys())
+        pdoc.render.env.globals["search"] = True
+        assert pdoc.render.search_index({}) == ""
+        pdoc.render.configure(search=True)
+        assert pdoc.render.search_index({}) != ""
+    finally:
+        pdoc.render.env.globals.pop("search", None)
+        pdoc.render.configure()
+
+
+def test_configure_preserves_env_and_user_extensions():
+    orig_env = pdoc.render.env
+    pdoc.render.configure(logo="test_logo")
+    assert pdoc.render.env is orig_env
+
+    pdoc.render.env.filters["custom_test_filter"] = lambda x: f"filtered_{x}"
+    pdoc.render.env.globals["custom_test_global"] = "custom_value"
+    try:
+        custom_tpl_dir = here.parent / "examples" / "custom-template"
+        pdoc.render.configure(template_directory=custom_tpl_dir)
+        assert pdoc.render.env is orig_env
+        assert "custom_test_filter" in pdoc.render.env.filters
+        assert pdoc.render.env.globals["custom_test_global"] == "custom_value"
+    finally:
+        pdoc.render.env.filters.pop("custom_test_filter", None)
+        pdoc.render.env.globals.pop("custom_test_global", None)
+        pdoc.render.configure()
+
+
+def test_explicit_config_overrides_current_config():
+    pdoc.render.configure(search=True)
+    try:
+        explicit_cfg = replace(pdoc.render._current_config, search=False)
+        assert pdoc.render._search_index({}, config=explicit_cfg) == ""
+        assert pdoc.render.search_index({}) != ""
+    finally:
+        pdoc.render.configure()
+
+
+def test_invalidate_caches_preserves_render_state():
+    orig_env = pdoc.render.env
+    pdoc.render.configure(search=False)
+    pdoc.render.env.globals["survives_cache_clear"] = "yes"
+    old_configure = pdoc.render.configure
+    old_to_html = pdoc.render_helpers.to_html
+    try:
+        pdoc.extract.invalidate_caches("pdoc.render")
+        assert pdoc.render.configure is old_configure
+
+        pdoc.extract.invalidate_caches("pdoc")
+        assert pdoc.render.configure is old_configure
+        assert pdoc.render_helpers.to_html is not old_to_html
+        assert pdoc.render.env is orig_env
+        assert pdoc.render.env.globals["survives_cache_clear"] == "yes"
+        assert pdoc.render.search_index({}) == ""
+    finally:
+        pdoc.render.env.globals.pop("survives_cache_clear", None)
+        pdoc.render.configure()
