+def add_wooey_script(
+    script_version=None,
+    script_path=None,
+    group=None,
+    script_name=None,
+    set_default_version=True,
+    ignore_bad_imports=None,
+):
+    from ..models import ScriptVersion
+
+    prep = prepare_script_registration(
+        script_version=script_version,
+        script_path=script_path,
+        group=group,
+        script_name=script_name,
+        ignore_bad_imports=ignore_bad_imports,
+    )
+
+    if prep["duplicate"]:
+        return {
+            "valid": False,
+            "errors": ScriptVersion.error_messages["duplicate_script"],
+            "script": prep["existing_version"],
+        }
+
+    parsed = parse_script_schema(
+        filename=prep["filename"],
+        local_path=prep["local_path"],
+        ignore_bad_imports=prep["ignore_bad_imports"],
+    )
+    if not parsed["valid"]:
+        return {
+            "valid": False,
+            "errors": parsed["error"],
+        }
+
+    wooey_script, script_version = save_script_version(
+        script_version=script_version,
+        script_name=prep["script_name"],
+        group=prep["group"],
+        script_schema=parsed["schema"],
+        local_file=prep["local_file"],
+        checksum=prep["checksum"],
+        set_default_version=set_default_version,
+        ignore_bad_imports=prep["ignore_bad_imports"],
+    )
+
+    sync_script_parameters(
+        wooey_script=wooey_script,
+        script_version=script_version,
+        script_schema=parsed["schema"],
+    )
 
