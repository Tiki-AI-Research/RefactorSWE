diff --git a/wooey/tests/f2p_runner.py b/wooey/tests/f2p_runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..94c65092de773597291bad6466cf52b286d5be2f
--- /dev/null
+++ b/wooey/tests/f2p_runner.py
@@ -0,0 +1,205 @@
+"""Aggregate runner for the frozen P2P + F2P exact selector selection.
+
+This module is a repository-internal support file declared in the verification
+plan's ``test_paths``.  It is invoked by the declared ``command`` and produces
+the JUnit ``{report}``:
+
+    python wooey/tests/f2p_runner.py --report <junit.xml> --config <config.json> \
+        [--selectors <file>] [paths...]
+
+The runner reads the frozen P2P and F2P *exact* selectors from the pipeline
+generated ``{config}`` document (its ``p2p`` and ``f2p`` arrays) and runs them
+through the real pytest producer.  It does not select tests by file, by broad
+pattern, or from the P2P collection inventory; the optional selector-file and
+positional arguments exist only so a single selector can be replayed in
+isolation during development.
+
+It relies only on files and tools that ship with the frozen environment image
+(Django + pytest).  It does not install anything, does not reach the network
+and leaves temporary data to the process ``TMPDIR`` through the standard
+library/pytest defaults.
+"""
+
+from __future__ import absolute_import
+
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO_ROOT = os.path.dirname(os.path.dirname(HERE))
+
+_SELECTOR_KEYS = ("selector", "selectors", "test", "tests", "node", "node_id")
+
+
+def _parse_args(argv):
+    report = None
+    config_path = None
+    selector_files = []
+    paths = []
+    index = 0
+    while index < len(argv):
+        arg = argv[index]
+        if arg == "--report":
+            index += 1
+            report = argv[index]
+        elif arg.startswith("--report="):
+            report = arg.split("=", 1)[1]
+        elif arg == "--config":
+            index += 1
+            config_path = argv[index]
+        elif arg.startswith("--config="):
+            config_path = arg.split("=", 1)[1]
+        elif arg in ("--selectors", "--selector-file"):
+            index += 1
+            selector_files.append(argv[index])
+        elif arg.startswith("--selectors="):
+            selector_files.append(arg.split("=", 1)[1])
+        elif arg.startswith("--"):
+            raise SystemExit("f2p_runner: unsupported option {!r}".format(arg))
+        else:
+            paths.append(arg)
+        index += 1
+    return report, config_path, selector_files, paths
+
+
+def _extract_selectors(value):
+    """Collect exact selectors from a config value of any nesting shape."""
+    found = []
+    if value is None:
+        return found
+    if isinstance(value, str):
+        return [value]
+    if isinstance(value, dict):
+        for key in _SELECTOR_KEYS:
+            if key in value:
+                found.extend(_extract_selectors(value[key]))
+        return found
+    if isinstance(value, (list, tuple)):
+        for item in value:
+            found.extend(_extract_selectors(item))
+        return found
+    return found
+
+
+def _selector_arrays(config):
+    """Return the frozen ``p2p`` and ``f2p`` exact selector arrays."""
+    arrays = {}
+    for key in ("p2p", "f2p"):
+        if key in config:
+            arrays[key] = _extract_selectors(config[key])
+    if not arrays:
+        # Tolerate the two arrays being nested one level down in the config
+        # document (for example under a plan object); only exact selectors are
+        # ever collected, never test files or broad patterns.
+        for value in config.values():
+            if isinstance(value, dict):
+                for key in ("p2p", "f2p"):
+                    if key in value:
+                        arrays.setdefault(key, []).extend(
+                            _extract_selectors(value[key])
+                        )
+    return arrays
+
+
+def _selectors_from_config(config_path):
+    with open(config_path) as handle:
+        config = json.load(handle)
+    selectors = []
+    arrays = _selector_arrays(config)
+    for key in ("p2p", "f2p"):
+        selectors.extend(arrays.get(key, []))
+    return selectors
+
+
+def _collect_selectors(config_path, selector_files, paths):
+    selectors = []
+    if config_path:
+        if os.path.isfile(config_path):
+            selectors.extend(_selectors_from_config(config_path))
+        else:
+            sys.stderr.write(
+                "f2p_runner: config document {!r} is not available\n".format(
+                    config_path
+                )
+            )
+    for selector_file in selector_files:
+        if not selector_file or not os.path.isfile(selector_file):
+            sys.stderr.write(
+                "f2p_runner: ignoring unavailable selectors file {!r}\n".format(
+                    selector_file
+                )
+            )
+            continue
+        with open(selector_file) as handle:
+            for line in handle:
+                entry = line.strip()
+                if not entry or entry.startswith("#"):
+                    continue
+                selectors.append(entry)
+    selectors.extend(paths)
+    unique = []
+    for selector in selectors:
+        if selector and selector not in unique:
+            unique.append(selector)
+    return unique
+
+
+def main(argv=None):
+    report, config_path, selector_files, paths = _parse_args(
+        list(sys.argv[1:] if argv is None else argv)
+    )
+    if not report:
+        raise SystemExit("f2p_runner: --report <junit.xml> is required")
+
+    selectors = _collect_selectors(config_path, selector_files, paths)
+    if not selectors:
+        raise SystemExit(
+            "f2p_runner: no exact selectors were provided by the config document, "
+            "the selectors file or the command line"
+        )
+
+    os.chdir(REPO_ROOT)
+    if REPO_ROOT not in sys.path:
+        sys.path.insert(0, REPO_ROOT)
+    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "wooey.test_settings")
+
+    import django
+
+    django.setup()
+
+    from django.test.runner import DiscoverRunner
+    from django.test.utils import setup_test_environment
+
+    setup_test_environment()
+    runner = DiscoverRunner(verbosity=0, interactive=False)
+    old_config = runner.setup_databases()
+
+    import pytest
+
+    args = [
+        "-p",
+        "no:cacheprovider",
+        "-q",
+        "--junitxml={}".format(report),
+    ]
+    args.extend(selectors)
+    return_code = pytest.main(args)
+
+    runner.teardown_databases(old_config)
+
+    if not os.path.exists(report):
+        sys.stderr.write(
+            "f2p_runner: pytest did not produce the JUnit report {!r}\n".format(report)
+        )
+        return 2
+    sys.stderr.write(
+        "f2p_runner: pytest rc={} selectors={} report={}\n".format(
+            return_code, len(selectors), report
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
