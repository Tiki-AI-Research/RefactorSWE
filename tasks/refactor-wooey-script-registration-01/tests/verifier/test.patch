+    def _sync_record_with_legacy_schema_links(self):
+        """Synchronize a real row whose current links predate its schema."""
+        path = self.save_script(
+            "{}.py".format(self._testMethodName), text=_script_source("1")
+        )
+        initial = utils.add_wooey_script(
+            script_path=path, script_name="p2p_sync_links"
+        )
+        self.assertIs(initial["valid"], True)
+        version = ScriptVersion.objects.get(pk=initial["script"].pk)
+        alpha = version.scriptparameter_set.get(script_param="alpha")
+        parser_name = alpha.parser.name
+        group_name = alpha.parameter_group.group_name
+        legacy_parser = ScriptParser.objects.create(name="legacy_parser")
+        legacy_group = ScriptParameterGroup.objects.create(group_name="legacy_group")
+        legacy_parameter = ScriptParameter.objects.create(
+            parser=legacy_parser,
+            parameter_group=legacy_group,
+            short_param="--legacy",
+            script_param="legacy",
+            is_output=False,
+            form_field="CharField",
+            input_type="str",
+            param_order=1,
+        )
+
+        # Model a persisted record with only old schema links. The current
+        # file still describes alpha, so sync must both retain old links and
+        # add missing current-schema links, not merely leave everything alone.
+        version.scriptparser_set.set([legacy_parser])
+        version.scriptparametergroup_set.set([legacy_group])
+        version.scriptparameter_set.set([legacy_parameter])
+        self.assertNotEqual(parser_name, legacy_parser.name)
+        self.assertNotEqual(group_name, legacy_group.group_name)
+        self.assertEqual(
+            list(version.scriptparser_set.values_list("pk", flat=True)),
+            [legacy_parser.pk],
+        )
+        self.assertEqual(
+            list(version.scriptparametergroup_set.values_list("pk", flat=True)),
+            [legacy_group.pk],
+        )
+        self.assertEqual(
+            list(version.scriptparameter_set.values_list("pk", flat=True)),
+            [legacy_parameter.pk],
+        )
+        before_pks = set(
+            ScriptVersion.objects.filter(script=version.script)
+            .values_list("pk", flat=True)
+        )
+        result = utils.add_wooey_script(script_version=version)
+        self.assertIs(result["valid"], True)
+        self.assertIsNone(result["errors"])
+        self.assertEqual(result["script"].pk, version.pk)
+        version.refresh_from_db()
+        self.assertEqual(
+            set(ScriptVersion.objects.filter(script=version.script)
+                .values_list("pk", flat=True)),
+            before_pks,
+        )
+        return (
+            version, legacy_parser, legacy_group, legacy_parameter,
+            parser_name, group_name,
+        )
