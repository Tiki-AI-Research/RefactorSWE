+    def test_duplicate_detection_returns_stored_version_untouched(self):
+        """C4/B2: duplicate content returns the stored version unchanged.
+
+        Re-registering byte-identical content must report the duplicate-script
+        error, return the already stored version and leave its label,
+        iteration, default flag, checksum and parameter links untouched.
+        """
+        source = os.path.join(
+            config.WOOEY_TEST_SCRIPTS, "versioned_script", "v1.py"
+        )
+        first_path = self.save_script("p2p_duplicate.py", source=source)
+        first = utils.add_wooey_script(
+            script_path=first_path, script_name="p2p_duplicate"
+        )
+        self.assertIs(first["valid"], True)
+        first_version = first["script"]
+
+        changed_source = os.path.join(
+            config.WOOEY_TEST_SCRIPTS, "versioned_script", "v2.py"
+        )
+        changed_path = self.save_script(
+            "p2p_duplicate_second.py", source=changed_source
+        )
+        second = utils.add_wooey_script(
+            script_path=changed_path, script_name="p2p_duplicate"
+        )
+        self.assertIs(second["valid"], True)
+        second_version = second["script"]
+
+        def snapshot(version):
+            version.refresh_from_db()
+            return (
+                str(version.script_version),
+                version.script_iteration,
+                version.default_version,
+                version.checksum,
+                version.script_path.name,
+                tuple(sorted(item.pk for item in version.get_parameters())),
+            )
+
+        before = (snapshot(first_version), snapshot(second_version))
+        versions_before = ScriptVersion.objects.count()
+
+        duplicate_path = self.save_script("p2p_duplicate_copy.py", source=source)
+        # Empty optional names use the filename, just like an omitted name.
+        # The original path therefore resolves to the same stored script.
+        for path, name in ((duplicate_path, "p2p_duplicate"), (first_path, "")):
+            duplicate = utils.add_wooey_script(
+                script_path=path, script_name=name
+            )
+            self.assertIs(duplicate["valid"], False)
+            self.assertEqual(
+                str(duplicate["errors"]),
+                str(ScriptVersion.error_messages["duplicate_script"]),
+            )
+            self.assertEqual(duplicate["script"].pk, first_version.pk)
+            self.assertEqual(ScriptVersion.objects.count(), versions_before)
+            self.assertEqual(
+                (snapshot(first_version), snapshot(second_version)), before
+            )
