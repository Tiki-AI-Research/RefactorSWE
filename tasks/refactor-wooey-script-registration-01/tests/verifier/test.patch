+    def test_listing_reports_newest_default_version(self):
+        """B4: the public listing reports the newest defaulted version as latest.
+
+        After a default-updating registration the current-script listing must
+        report the newest version as latest and must not report the superseded
+        one; a registration without default updating keeps the previous latest.
+        """
+        def latest_version_pk(script_name):
+            for script in utils.get_current_scripts():
