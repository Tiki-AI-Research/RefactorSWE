+    def test_duplicate_detection_with_legacy_duplicate_checksums(self):
+        """C4/B2: duplicate lookup also holds for legacy duplicate checksums.
+
+        When several stored versions carry the same checksum, the duplicate
+        result must still return one of the stored versions without creating or
+        modifying records. Direct synchronization of the selected checksum
+        match must still synchronize that same record, rather than reject it.
+        """
+        source = os.path.join(
+            config.WOOEY_TEST_SCRIPTS, "versioned_script", "v1.py"
+        )
+        stored = self.save_script("p2p_legacy.py", source=source)
+        result = utils.add_wooey_script(script_path=stored, script_name="p2p_legacy")
+        self.assertIs(result["valid"], True)
+        original = result["script"]
+
+        # Simulate legacy data: several stored versions carry the same checksum.
+        legacy = ScriptVersion(
+            script=original.script,
+            script_version=str(original.script_version),
+            script_iteration=original.script_iteration + 5,
+            script_path=self.save_script("p2p_legacy_selected.py", source=source),
+            checksum=original.checksum,
+            default_version=False,
+            is_active=True,
+        )
+        ScriptVersion.objects.bulk_create([legacy])
+        newest_legacy = (
+            ScriptVersion.objects.filter(script=original.script)
+            .order_by("script_version", "script_iteration")
+            .last()
+        )
+
+        again = self.save_script("p2p_legacy_again.py", source=source)
+        duplicate = utils.add_wooey_script(
+            script_path=again, script_name="p2p_legacy"
+        )
+
+        self.assertIs(duplicate["valid"], False)
+        self.assertEqual(
+            str(duplicate["errors"]),
+            str(ScriptVersion.error_messages["duplicate_script"]),
+        )
+        self.assertEqual(duplicate["script"].pk, newest_legacy.pk)
+        self.assertEqual(duplicate["script"].pk, legacy.pk)
+
+        # The legacy lookup selects this row itself. A same-record match is
+        # allowed in direct synchronization, even when other rows also match.
+        before_pks = set(
+            ScriptVersion.objects.filter(script=original.script)
+            .values_list("pk", flat=True)
+        )
+        selected = ScriptVersion.objects.get(pk=newest_legacy.pk)
+        synced = utils.add_wooey_script(
+            script_version=selected, set_default_version=False
+        )
+        self.assertIs(synced["valid"], True, synced.get("errors"))
+        self.assertIsNone(synced["errors"])
+        self.assertEqual(synced["script"].pk, selected.pk)
+        selected.refresh_from_db()
+        self.assertEqual(selected.checksum, original.checksum)
+        self.assertEqual(selected.script_iteration, 2)
+        self.assertIs(selected.default_version, True)
+        self.assertEqual(
+            set(selected.scriptparameter_set.values_list("script_param", flat=True)),
+            set(original.scriptparameter_set.values_list("script_param", flat=True)),
+        )
+        self.assertEqual(
+            set(ScriptVersion.objects.filter(script=original.script)
+                .values_list("pk", flat=True)),
+            before_pks,
+        )
