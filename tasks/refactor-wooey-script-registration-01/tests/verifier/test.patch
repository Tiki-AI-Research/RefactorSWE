index 0000000000000000000000000000000000000000..a5145fc823ed84113b2d46fac91a834733415cb2
--- /dev/null
+++ b/wooey/tests/p2p_runner.py
@@ -0,0 +1,175 @@
+"""Runner for the frozen P2P regression selection.
+
+This module is a repository-internal support file declared in the P2P plan's
+``test_paths``.  It is invoked by the declared ``command`` and is responsible
+for producing the JUnit ``{report}``:
+
+    python wooey/tests/p2p_runner.py --report <junit.xml> \
+        [--selectors <list>] [paths...]
+
+The runner only relies on repository files and tools that ship with the frozen
+environment image (Django + pytest).  It does not install anything, does not
+reach the network and does not use any selection list other than the ones
+passed on the command line.
+
+Two kinds of selection inputs are accepted:
+
+* test file paths or pytest node ids given as positional arguments, and
+* an optional selectors file (the pipeline-provided ``{p2p_select}``) whose
+  non-empty lines are test file paths or ``path::leaf`` selectors.
+
+If the selectors file has not been materialized (for example when the literal
+placeholder is passed through), it is ignored so that the positional selection
+still runs.
+"""
+
+from __future__ import absolute_import
+
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO_ROOT = os.path.dirname(os.path.dirname(HERE))
+
+
+def _parse_args(argv):
+    report = None
+    selector_files = []
+    paths = []
+    index = 0
+    while index < len(argv):
+        arg = argv[index]
+        if arg == "--report":
+            index += 1
+            report = argv[index]
+        elif arg.startswith("--report="):
+            report = arg.split("=", 1)[1]
+        elif arg in ("--selectors", "--selector-file"):
+            index += 1
+            selector_files.append(argv[index])
+        elif arg.startswith("--selectors="):
+            selector_files.append(arg.split("=", 1)[1])
+        elif arg.startswith("--"):
+            raise SystemExit("p2p_runner: unsupported option {!r}".format(arg))
+        else:
+            paths.append(arg)
+        index += 1
+    return report, selector_files, paths
+
+
+def _file_of(selector_or_path):
+    return selector_or_path.split("::", 1)[0]
+
+
+def _collect_from_selector_files(selector_files, paths):
+    for selector_file in selector_files:
+        if not selector_file or not os.path.isfile(selector_file):
+            # Placeholders that were not substituted, or a selectors file that
+            # does not exist yet, must not abort the positional selection.
+            sys.stderr.write(
+                "p2p_runner: ignoring unavailable selectors file {!r}\n".format(
+                    selector_file
+                )
+            )
+            continue
+        with open(selector_file) as handle:
+            for line in handle:
+                entry = line.strip()
+                if not entry or entry.startswith("#"):
+                    continue
+                if entry not in paths:
+                    paths.append(entry)
+    return paths
+
+
+def _resolved_paths(paths):
+    """Resolve positional selections against the repository root when needed."""
+    resolved = []
+    for path in paths:
+        file_path = _file_of(path)
+        if os.path.exists(file_path):
+            resolved.append(path)
+            continue
+        candidate = os.path.join(REPO_ROOT, file_path)
+        if os.path.exists(candidate):
+            suffix = path[len(file_path):]
+            resolved.append(candidate + suffix)
+        else:
+            resolved.append(path)
+    return resolved
+
+
+def _normalized_paths(paths):
+    """Drop redundant selectors whose file is already selected as a whole.
+
+    A ``path::leaf`` entry is only redundant when another entry selects its
+    whole file; a selection made up solely of exact selectors is kept as is.
+    """
+    selected_files = {path for path in paths if "::" not in path}
+    normalized = []
+    for path in paths:
+        if "::" in path and _file_of(path) in selected_files:
+            continue
+        if path not in normalized:
+            normalized.append(path)
+    return normalized
+
+
+def main(argv=None):
+    report, selector_files, paths = _parse_args(
+        list(sys.argv[1:] if argv is None else argv)
+    )
+    if not report:
+        raise SystemExit("p2p_runner: --report <junit.xml> is required")
+
+    paths = _collect_from_selector_files(selector_files, paths)
+    paths = _resolved_paths(paths)
+    paths = _normalized_paths(paths)
+    if not paths:
+        raise SystemExit("p2p_runner: no tests were selected to run")
+
+    os.chdir(REPO_ROOT)
+    if REPO_ROOT not in sys.path:
+        sys.path.insert(0, REPO_ROOT)
+    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "wooey.test_settings")
+
+    import django
+
+    django.setup()
+
+    from django.test.runner import DiscoverRunner
+    from django.test.utils import setup_test_environment
+
+    setup_test_environment()
+    runner = DiscoverRunner(verbosity=0, interactive=False)
+    old_config = runner.setup_databases()
+
+    import pytest
+
+    report_path = report
+    args = [
+        "-p",
+        "no:cacheprovider",
+        "-q",
+        "--junitxml={}".format(report_path),
+    ]
+    args.extend(paths)
+    return_code = pytest.main(args)
+
+    runner.teardown_databases(old_config)
+
+    if not os.path.exists(report_path):
+        sys.stderr.write(
+            "p2p_runner: pytest did not produce the JUnit report {!r}\n".format(
+                report_path
+            )
+        )
+        return 2
+    sys.stderr.write(
+        "p2p_runner: pytest rc={} report={}\n".format(return_code, report_path)
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/wooey/tests/test_f2p_decomposition.py b/wooey/tests/test_f2p_decomposition.py
new file mode 100644
index 0000000000000000000000000000000000000000..55ea6817797ff77447c6900d3052b9eab25835f0
--- /dev/null
+++ b/wooey/tests/test_f2p_decomposition.py
@@ -0,0 +1,729 @@
+"""F2P tests: the registration entry point delegates its three concerns.
+
+Freeze contract (``grader-verifier-f2p-draft:v2`` payload): the supplemental
+P2P selection already pins the externally visible registration behavior, so the
+F2P obligation is the part of the instruction those tests cannot observe --
+``REQ-STRUCT-001`` and ``REQ-STRUCT-002``.  The frozen instruction requires the
+one public entry point (``wooey.backend.utils.add_wooey_script``) to *delegate*
+to single-purpose parts for
+
+* storage normalization and checksum-based duplicate detection,
+* version lifecycle and default-version decisions,
+* parser and parameter synchronization,
+
+so that each concern can be understood and changed in isolation, instead of
+running interleaved in one pass. The lifecycle part also returns the selected
+persisted version so its result can be consumed without shared coordinator state.
+
+The checks below observe the real call structure of a real registration: the
+tests register scripts through the public entry point against the Django test
+database and the configured storage, and record which frame performs which
+work.  They do not require any helper name, class name or module placement
+(``REQ-STRUCT-004``): every observation is made on the executed code, and the
+only interface names used are the frozen public surface (the entry point, the
+models and the storage helpers that ``REQ-BEH-T1:C7`` already freezes).
+
+Every selector fails on the un-decomposed entry point (its own frame performs
+the concern's work) and passes once the concern is performed by a separate
+collaborator reached through the entry point.
+"""
+
+from __future__ import absolute_import
+
+import os
+import sys
+import types
+from collections.abc import Mapping
+
+from django.core.files import storage as django_storage
+from django.core.files.base import ContentFile
+from django.db import models as django_models
+from django.test import TransactionTestCase
+from packaging.version import parse as parse_version
+
+from .. import settings as wooey_settings
+from ..backend import utils
+from ..models import (
+    Script,
+    ScriptGroup,
+    ScriptParameter,
+    ScriptParameterGroup,
+    ScriptParser,
+    ScriptVersion,
+)
+
+# The repository root, derived from the registration module itself so the
+# attribution works no matter which directory pytest was started from.
+REPO_ROOT = os.path.dirname(
+    os.path.dirname(os.path.dirname(os.path.abspath(utils.__file__)))
+)
+
+# The public entry point that must stay the single external registration entry
+# point (C1/STRUCT-002).  ``__wrapped__`` is followed so a decorated entry point
+# is still recognised; no internal helper is referenced by name anywhere.
+_ENTRY_CODES = frozenset(
+    code
+    for code in (
+        getattr(utils.add_wooey_script, "__code__", None),
+        getattr(getattr(utils.add_wooey_script, "__wrapped__", None), "__code__", None),
+    )
+    if code is not None
+)
+
+
+def _underlying_code(func):
+    """Return the code object of ``func``, following context-manager wrappers."""
+    func = getattr(func, "__wrapped__", func)
+    return getattr(func, "__code__", None)
+
+
+# Public helper functions whose execution marks the storage/checksum concern.
+_CODE_TAGS = {}
+for _func, _tag in (
+    (utils.get_checksum, "storage.checksum"),
+    (utils.get_storage, "storage.handle"),
+    (utils.get_storage_object, "storage.file"),
+    (parse_version, "version.normalize"),
+):
+    _code = _underlying_code(_func)
+    if _code is not None:
+        _CODE_TAGS.setdefault(_code, set()).add(_tag)
+
+# The three concerns of the frozen instruction, keyed by the public models
+# each concern persists.  ``ScriptGroup``/``Script``/``ScriptVersion`` belong to
+# the version lifecycle concern, the three parameter/schema models to the
+# parser and parameter synchronization concern.
+_MODEL_GROUPS = {
+    Script: "version",
+    ScriptVersion: "version",
+    ScriptGroup: "version",
+    ScriptParameter: "schema",
+    ScriptParameterGroup: "schema",
+    ScriptParser: "schema",
+}
+
+_WRITE_NAMES = frozenset(
+    (
+        "create",
+        "update",
+        "bulk_create",
+        "save",
+        "delete",
+        "get_or_create",
+        "update_or_create",
+        "add",
+        "set",
+        "remove",
+        "clear",
+    )
+)
+_READ_NAMES = frozenset(
+    ("get", "filter", "exclude", "all", "first", "last", "exists", "count")
+)
+
+_CONCERN_GROUPS = ("storage", "version", "schema")
+
+
+def _has_kwarg(frame, key):
+    for value in frame.f_locals.values():
+        if type(value) is dict and key in value:
+            return True
+    return key in frame.f_locals
+
+
+def _call_tags(frame):
+    """Classify the work a call frame performs, by public surface only."""
+    tags = set()
+    try:
+        tags.update(_CODE_TAGS.get(frame.f_code, ()))
+        module = frame.f_globals.get("__name__", "") or ""
+        if module.startswith("hashlib"):
+            tags.add("storage.checksum")
+        if module.startswith("packaging"):
+            tags.add("version.normalize")
+        name = frame.f_code.co_name
+        if name in ("__init__", "__new__"):
+            return tags
+        self_obj = frame.f_locals.get("self")
+        model = None
+        if isinstance(self_obj, django_models.Model):
+            model = type(self_obj)
+        elif isinstance(self_obj, (django_models.QuerySet, django_models.Manager)):
+            model = getattr(self_obj, "model", None)
+        elif isinstance(self_obj, django_storage.Storage):
+            if name in ("open", "save", "delete"):
+                tags.add("storage.file")
+            elif name in ("exists", "path", "url", "get_available_name"):
+                tags.add("storage.handle")
+        group = _MODEL_GROUPS.get(model)
+        if group is not None:
+            if name in _WRITE_NAMES:
+                tags.add(group + ".write")
+            elif name in _READ_NAMES:
+                tags.add(group + ".read")
+            if model is ScriptVersion and name in ("get", "filter") and _has_kwarg(
+                frame, "checksum"
+            ):
+                tags.add("duplicate.lookup")
+            if model is ScriptVersion and _has_kwarg(frame, "default_version"):
+                tags.add("version.default")
+            if model is ScriptGroup and name in _WRITE_NAMES:
+                tags.add("group.write")
+        if module.startswith("clinto.parser"):
+            tags.add("parse")
+    except Exception:
+        # Classification must never break the observed registration; an
+        # unclassified call simply contributes no tag.
+        pass
+    return tags
+
+
+def _c_call_tags(cfunc):
+    module = getattr(cfunc, "__module__", "") or ""
+    if module.startswith(("hashlib", "_hashlib")):
+        return {"storage.checksum"}
+    return set()
+
+
+class _CallNode(object):
+    __slots__ = ("code", "name", "qualname", "module", "file", "parent", "children", "ops", "depth", "result")
+
+    def __init__(self, frame, parent):
+        self.code = frame.f_code
+        self.name = self.code.co_name
+        self.qualname = getattr(self.code, "co_qualname", self.name)
+        self.module = frame.f_globals.get("__name__", "") or ""
+        self.file = os.path.abspath(frame.f_code.co_filename)
+        self.parent = parent
+        self.children = []
+        self.result = None
+        self.ops = set()
+        self.depth = parent.depth + 1 if parent is not None else 0
+
+
+class _CallRecorder(object):
+    """Record the executed call tree and attribute work to code frames."""
+
+    def __init__(self, repo_root):
+        self.repo_root = os.path.abspath(repo_root) + os.sep
+        self.roots = []
+        self._stack = []
+
+    def _is_project_frame(self, node):
+        return node.file.startswith(self.repo_root)
+
+    def _attribute(self, tags, exclude=None):
+        """Credit ``tags`` to the nearest project frame that issued the call.
+
+        The frame that *performs* work is the one whose code contains the call;
+        work executed inside a framework frame is credited to the nearest
+        project frame below it, so a collaborator called from the entry point
+        owns its own work while the entry point stays clean.
+        """
+        if not tags:
+            return
+        target = None
+        for node in reversed(self._stack):
+            if node is exclude:
+                continue
+            if self._is_project_frame(node):
+                target = node
+                break
+        if target is None:
+            target = exclude if exclude is not None else (
+                self._stack[-1] if self._stack else None
+            )
+        if target is not None:
+            target.ops.update(tags)
+
+    def _profile(self, frame, event, arg):
+        try:
+            if event == "call":
+                parent = self._stack[-1] if self._stack else None
+                node = _CallNode(frame, parent)
+                if parent is None:
+                    self.roots.append(node)
+                else:
+                    parent.children.append(node)
+                self._stack.append(node)
+                self._attribute(_call_tags(frame), exclude=node)
+            elif event == "c_call":
+                self._attribute(_c_call_tags(arg))
+            elif event == "return":
+                if self._stack:
+                    node = self._stack.pop()
+                    if self._is_project_frame(node):
+                        node.result = arg
+        except Exception:
+            pass
+        return None
+
+    def capture(self, func, *args, **kwargs):
+        sys.setprofile(self._profile)
+        try:
+            return func(*args, **kwargs)
+        finally:
+            sys.setprofile(None)
+
+
+def _walk(node):
+    yield node
+    for child in node.children:
+        for descendant in _walk(child):
+            yield descendant
+
+
+class _RegistrationTrace(object):
+    """The recorded registration call tree, queried by public observations."""
+
+    def __init__(self, recorder):
+        self._nodes = [node for root in recorder.roots for node in _walk(root)]
+        matches = [node for node in self._nodes if node.code in _ENTRY_CODES]
+        self.entry_node = min(matches, key=lambda node: node.depth) if matches else None
+
+    @property
+    def observed(self):
+        return bool(self._nodes)
+
+    @property
+    def entry_ops(self):
+        return set(self.entry_node.ops) if self.entry_node is not None else set()
+
+    def delegated(self, op):
+        """True when ``op`` is performed outside the entry point's own frame.
+
+        The entry point must delegate the concern; if the entry frame itself
+        performs ``op`` the obligation is not met, and the work must also be
+        visible in a separate collaborating frame so the concern has not simply
+        been dropped.
+        """
+        if self.entry_node is None:
+            return False
+        if op in self.entry_node.ops:
+            return False
+        return any(
+            op in node.ops for node in self._nodes if node is not self.entry_node
+        )
+
+    def returns_selected_version(self, version):
+        """The lifecycle part exposes its selected row as a usable result."""
+        def contains(value, seen):
+            if isinstance(value, ScriptVersion):
+                return value.pk == version.pk
+            if id(value) in seen or isinstance(value, django_models.Model):
+                return False
+            seen.add(id(value))
+            if isinstance(value, Mapping):
+                items = list(value.values())
+            elif isinstance(value, (tuple, list, set, frozenset)):
+                items = value
+            else:
+                items = []
+                if not callable(value) and not isinstance(value, types.ModuleType):
+                    if hasattr(value, "__dict__"):
+                        items.extend(list(vars(value).values()))
+                    for cls in type(value).__mro__:
+                        slots = cls.__dict__.get("__slots__", ())
+                        if isinstance(slots, str):
+                            slots = (slots,)
+                        items.extend(getattr(value, name) for name in slots
+                                     if name not in ("__dict__", "__weakref__")
+                                     and hasattr(value, name))
+            return any(contains(item, seen) for item in items)
+
+        for node in self._nodes:
+            if node is self.entry_node or not node.file.startswith(REPO_ROOT + os.sep):
+                continue
+            ops = set(op for child in _walk(node) for op in child.ops)
+            if ("version.write" in ops
+                    and not any(op.startswith(("storage.", "schema.", "duplicate."))
+                                for op in ops)
+                    and contains(node.result, set())):
+                return True
+        return False
+
+    def work_frames(self):
+        """(qualname, module, ops) for every frame that performed classified work."""
+        return [
+            (node.qualname, node.module, set(node.ops))
+            for node in self._nodes
+            if node.ops
+        ]
+
+    def mixing_frames(self, *groups):
+        """Frames whose own work mixes all of the requested concern groups."""
+        offenders = []
+        for qualname, module, ops in self.work_frames():
+            if all(any(op.startswith(group) for op in ops) for group in groups):
+                offenders.append(
+                    "%s (%s): %s" % (qualname, module, ", ".join(sorted(ops)))
+                )
+        return offenders
+
+
+def _script_text(version="1", extra_parameter=False, description="f2p script"):
+    """A small argparse script used to drive real registrations."""
+    lines = [
+        "import argparse",
+        "",
+        "parser = argparse.ArgumentParser(description=%r)" % description,
+        "parser.version = %r" % version,
+        "parser.add_argument('--alpha')",
+    ]
+    if extra_parameter:
+        lines.append("parser.add_argument('--beta')")
+    lines.extend(
+        [
+            "",
+            "if __name__ == '__main__':",
+            "    parser.parse_args()",
+        ]
+    )
+    return "\n".join(lines) + "\n"
+
+
+def _multi_group_script_text(description="f2p subparser script"):
+    """An argparse script with subparsers, i.e. several parameter groups."""
+    return (
+        "import argparse\n"
+        "\n"
+        "parser = argparse.ArgumentParser(description=%r)\n"
+        "parser.version = '1'\n"
+        "parser.add_argument('--alpha')\n"
+        "subparsers = parser.add_subparsers(dest='subcommand')\n"
+        "first = subparsers.add_parser('first')\n"
+        "first.add_argument('--beta')\n"
+        "second = subparsers.add_parser('second')\n"
+        "second.add_argument('--gamma', type=int)\n"
+        "second.add_argument('--delta', choices=['x', 'y'])\n"
+    ) % description
+
