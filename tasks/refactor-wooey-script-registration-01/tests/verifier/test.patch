+"""Supplemental P2P regression tests for the script registration entry point.
+
+The frozen instruction keeps ``wooey.backend.utils.add_wooey_script`` as the one
+external registration entry point and freezes its observable behavior:
+signature and return mapping, duplicate handling, iteration numbering and
+default-version decisions, parameter reuse/linking and the storage/checksum
+side effects.  The repository's original tests cover parts of that contract;
+these supplemental tests add the remaining observable cases (public import
+surface, parse failures, declared version changes, ``set_default_version``
+semantics, current-script listings, checksum persistence and parameter
+attributes).
+
+Everything asserted here is part of the public contract: the entry point, the
+persisted ``Script``/``ScriptVersion``/``ScriptParameter`` records and the
+configured storage.  The helper surface checked below is derived from the
+Baseline repository's own imports (frozen contract C7); no internal helper
+introduced by an implementation, no class name and no module placement is
+required by these tests, so a legitimate refactor of the registration flow
+keeps passing (C8).
+"""
+
+import importlib
+import inspect
+import os
+
+from django.core.files.base import ContentFile
+from django.test import TransactionTestCase
+
+from .. import errors as wooey_errors
+from ..backend import utils
+from ..models import (
+    Script,
+    ScriptParameter,
+    ScriptParameterGroup,
+    ScriptParser,
+    ScriptVersion,
+)
+from . import config, mixins
+
+
+# Helpers the Baseline repository's other modules import from, or read on, the
+# registration module (``wooey/backend/utils.py``).  Derived from the Baseline
+# tree: every ``from ...backend.utils import <name>`` statement and every
+# ``utils.<name>`` attribute read outside the registration module itself and
+# outside this supplemental file.  Frozen contract C7 requires these to stay
+# importable from the registration module path.  Helpers that no Baseline
+# module uses are deliberately not listed, so the placement and naming of
+# internal helpers stays free (C8).
+_REGISTRATION_MODULE_CONSUMERS = (
+    "add_wooey_script",
+    "can_user_view_script",
+    "create_job_fileinfo",
+    "create_wooey_job",
+    "default_storage",
+    "ensure_list",
+    "flatten",
+    "get_available_file",
+    "get_checksum",
+    "get_current_scripts",
+    "get_file_info",
+    "get_file_previews",
+    "get_file_previews_by_ids",
+    "get_form_groups",
+    "get_job_commands",
+    "get_master_form",
+    "get_query",
+    "get_storage",
+    "get_storage_object",
+    "get_upload_path",
+    "mkdirs",
+    "purge_output",
+    "sanitize_name",
+    "sanitize_string",
+    "test_delimited",
+    "test_fastx",
+    "tokenize_html_attributes",
+    "valid_user",
+    "validate_form",
+)
+
+# Baseline production modules that call into the registration module (models,
+# forms, signals, tasks, the API, the views and the management command).
+# Importing them asserts the frozen call sites still load against the
+# registration module path (contracts C7 and STRUCT-002).  Data migrations are
+# intentionally not imported here.
+_REGISTRATION_CALL_SITE_MODULES = (
+    "wooey.api.scripts",
+    "wooey.forms.factory",
+    "wooey.management.commands.addscript",
+    "wooey.models.core",
+    "wooey.models.widgets",
+    "wooey.signals",
+    "wooey.tasks",
+    "wooey.templatetags.wooey_tags",
+    "wooey.views.views",
+    "wooey.views.wooey_celery",
+)
+
+
+def _script_source(version=None, extra_parameter=False):
+    """Return the source of a small argparse script for a declared version."""
+    lines = [
+        "import argparse",
+        "",
+        "parser = argparse.ArgumentParser(description='p2p versioned script')",
+    ]
+    if version is not None:
+        lines.append("parser.version = {!r}".format(version))
+    lines.append("parser.add_argument('--alpha')")
+    if extra_parameter:
+        lines.append("parser.add_argument('--beta')")
+    lines.extend(
+        [
+            "",
+            "if __name__ == '__main__':",
+            "    parser.parse_args()",
+        ]
+    )
+    return "\n".join(lines) + "\n"
+
+
+class P2PRegistrationTests(
+    mixins.ScriptFactoryMixin, mixins.FileMixin, TransactionTestCase
+):
+    def save_script(self, name, source=None, text=None):
+        if text is None:
+            with open(source, "rb") as handle:
+                text = handle.read().decode("utf-8")
+        return self.storage.save(
+            self.filename_func(name), ContentFile(text.encode("utf-8"))
+        )
+
+    def test_entry_point_signature_and_storage_helper_imports(self):
+        """C1/C7: entry-point identity and the helper surface the repository imports.
+
+        The entry point must stay importable from ``wooey.backend.utils``
+        under the same name, order and defaults (C1), and every helper the
+        Baseline repository already imports from that module path must stay
+        importable there (C7).  The consumer names and call-site modules below
+        come from the Baseline tree itself, so this test does not depend on any
+        particular internal decomposition (C8).
+        """
+        signature = inspect.signature(utils.add_wooey_script)
+        self.assertEqual(
+            list(signature.parameters),
+            [
+                "script_version",
+                "script_path",
+                "group",
+                "script_name",
+                "set_default_version",
+                "ignore_bad_imports",
+            ],
+        )
+        defaults = {
+            name: parameter.default
+            for name, parameter in signature.parameters.items()
+        }
+        self.assertIsNone(defaults["script_version"])
+        self.assertIsNone(defaults["script_path"])
+        self.assertIsNone(defaults["group"])
+        self.assertIsNone(defaults["script_name"])
+        self.assertIs(defaults["set_default_version"], True)
+        self.assertIsNone(defaults["ignore_bad_imports"])
+
+        for helper in _REGISTRATION_MODULE_CONSUMERS:
+            self.assertTrue(
+                hasattr(utils, helper),
+                "wooey.backend.utils no longer exposes {!r}".format(helper),
+            )
+
+        for module_name in _REGISTRATION_CALL_SITE_MODULES:
+            importlib.import_module(module_name)
+
+    def test_path_and_name_call_modes_register_new_script(self):
+        """C2/B1: path-only and path-plus-name registrations create a new version.
+
+        Both supported storage-path call modes must succeed, report
+        ``valid``/``errors``/``script`` and persist the requested script name.
+        """
+        path_only_source = os.path.join(
