+    def test_parameter_reuse_and_schema_attributes(self):
+        """B5/B6: parameter reuse, unlinking and schema-derived attributes.
+
+        Unchanged parameters must be relinked as the same records on the new
+        version, parameters missing from the new schema must not be linked, and
+        schema-derived attributes (choices, required/output flags, form field,
+        short parameter and argument ordering) must match the Baseline values.
+        """
+        choices_source = os.path.join(config.WOOEY_TEST_SCRIPTS, "choices.py")
+        choices_path = self.save_script("p2p_choices.py", source=choices_source)
+        first = utils.add_wooey_script(
+            script_path=choices_path, script_name="p2p_parameters"
+        )
+        self.assertIs(first["valid"], True)
+        first_version = first["script"]
+        first_parameters = {
+            parameter.script_param: parameter
+            for parameter in first_version.get_parameters()
+        }
+        self.assertEqual(
+            set(first_parameters),
+            {
+                "one_choice",
+                "two_choices",
+                "at_least_one_choice",
+                "all_choices",
+                "need_at_least_one_numbers",
+                "choices_str",
+                "multiple_file_choices",
+                "more_multiple_file_choices",
+            },
+        )
+
+        one_choice = first_parameters["one_choice"]
+        self.assertEqual(one_choice.short_param, "--one-choice")
+        self.assertEqual(one_choice.form_field, "IntegerField")
+        self.assertEqual(one_choice.choices, "[0, 1, 2, 3]")
+        self.assertIs(one_choice.required, False)
+        self.assertIs(one_choice.is_output, True)
+        self.assertEqual(one_choice.param_order, 1)
+
+        two_choices = first_parameters["two_choices"]
+        two_choices.refresh_from_db()
+        self.assertEqual(two_choices.choices, "[0, 1, 2, 3]")
+        self.assertEqual(two_choices.choice_limit, "2")
+
+        required_choice = first_parameters["need_at_least_one_numbers"]
+        self.assertIs(required_choice.required, True)
+        self.assertIs(required_choice.collapse_arguments, False)
+
+        file_choice = first_parameters["multiple_file_choices"]
+        self.assertEqual(file_choice.form_field, "FileField")
+        self.assertEqual(file_choice.input_type, "file")
+        self.assertIs(file_choice.is_output, False)
+
+        self.assertEqual(
+            [parameter.script_param for parameter in first_version.get_parameters()],
+            [
+                "one_choice",
+                "two_choices",
+                "at_least_one_choice",
+                "all_choices",
+                "need_at_least_one_numbers",
+                "choices_str",
+                "multiple_file_choices",
+                "more_multiple_file_choices",
+            ],
+        )
+
+        choices_2_source = os.path.join(config.WOOEY_TEST_SCRIPTS, "choices_2.py")
+        choices_2_path = self.save_script(
+            "p2p_choices_2.py", source=choices_2_source
+        )
+        second = utils.add_wooey_script(
+            script_path=choices_2_path, script_name="p2p_parameters"
+        )
+        self.assertIs(second["valid"], True)
+        second_version = second["script"]
+        second_parameters = {
+            parameter.script_param: parameter
+            for parameter in second_version.get_parameters()
+        }
+
+        self.assertNotIn("one_choice", second_parameters)
+        self.assertIn("one_choice_added", second_parameters)
+        for name in (
+            "two_choices",
+            "at_least_one_choice",
+            "all_choices",
+            "need_at_least_one_numbers",
+            "choices_str",
+            "multiple_file_choices",
+            "more_multiple_file_choices",
+        ):
+            self.assertEqual(
