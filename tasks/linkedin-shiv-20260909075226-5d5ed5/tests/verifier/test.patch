+def test_runtime_cache_path_remains_consistent_during_materialization(tmp_path):
+    """Root overrides must not split extraction from the path handed to runtime."""
+    import contextlib
+    import stat
+    import types
+
+    import pytest
+    import shiv.bootstrap as bootstrap
+
+    # Both cases use a real zip, real extraction, permissions, and compilation.
+    # The filename proxy supplies a deterministic change after root resolution,
+    # equivalent to another thread updating the referenced environment variable.
+    for change_root in (False, True):
+        work = tmp_path / ('changed' if change_root else 'stable')
+        work.mkdir()
+        initial_root, later_root = work / 'initial', work / 'later'
+        archive_path = work / 'app.pyz'
+        metadata = Environment(
+            built_at='2020-09-13 12:26:40', shiv_version='probe', build_id='context',
+            compile_pyc=True, entry_point='_cache_context_probe:main',
+        )
+        with zipfile.ZipFile(archive_path, 'w') as archive:
+            member = zipfile.ZipInfo('site-packages/context_payload.py')
+            member.external_attr = 0o100640 << 16
+            archive.writestr(member, 'VALUE = 42\n')
+            archive.writestr('environment.json', metadata.to_json())
+
+        class ArchiveView:
+            def __init__(self, archive):
+                self.archive = archive
+                self.changed = False
+
+            @property
+            def filename(self):
+                if change_root and not self.changed:
+                    os.environ['CACHE_CONTEXT_ROOT'] = str(later_root)
+                    self.changed = True
+                return str(archive_path)
+
+            def __getattr__(self, name):
+                return getattr(self.archive, name)
+
+        @contextlib.contextmanager
+        def current_archive():
+            with zipfile.ZipFile(archive_path) as archive:
+                yield ArchiveView(archive)
+
+        application = types.ModuleType('_cache_context_probe')
+        application.main = lambda: 0
+        site_dirs = []
+        runtime_env = {key: value for key, value in os.environ.items()
+                       if not key.startswith('SHIV_')}
+        runtime_env.update(
+            SHIV_ROOT='$CACHE_CONTEXT_ROOT', CACHE_CONTEXT_ROOT=str(initial_root),
+            SHIV_COMPILE_WORKERS='1',
+        )
+        with contextlib.ExitStack() as stack:
+            stack.enter_context(patch.dict(os.environ, runtime_env, clear=True))
+            stack.enter_context(patch.dict(sys.modules, {'_cache_context_probe': application}))
+            stack.enter_context(patch.object(sys, 'argv', [str(archive_path)]))
+            stack.enter_context(patch.object(sys, 'path', list(sys.path)))
+            stack.enter_context(patch.object(bootstrap, 'current_zipfile', current_archive))
+            stack.enter_context(patch.object(
+                bootstrap.site, 'addsitedir', lambda directory: site_dirs.append(str(directory)),
+            ))
+            with pytest.raises(SystemExit) as exit_info:
+                bootstrap.bootstrap()
+            assert exit_info.value.code == 0
+
+        expected = initial_root / 'app.pyz_context' / 'site-packages'
+        assert site_dirs == [str(expected)], 'runtime received a different cache path'
+        payload = expected / 'context_payload.py'
+        assert payload.is_file(), 'runtime cache path differs from the materialized directory'
+        assert payload.read_text() == 'VALUE = 42\n'
+        assert stat.S_IMODE(payload.stat().st_mode) == 0o640
+        assert list(expected.rglob('*.pyc')), 'bytecode was not placed in the runtime cache'
+        assert not later_root.exists(), 'materialization changed its evaluated cache target'
