+def test_force_boolean_resolution_and_real_cache_rebuild(tmp_path, monkeypatch):
+    """Issue 4: force boolean parsing is separate from interpreter string truthiness."""
+    sp = make_payload(tmp_path)
+    archive = build(sp, tmp_path / 'force.pyz')
+    cache = tmp_path / 'cache'
+    result = execute(archive, cache, '-c', 'pass')
+    assert result.returncode == 0, result.stderr
+    cached = next(cache.rglob('payload.py'))
+    original = (sp / 'payload.py').read_bytes()
+    for value, expected in [('yes', True), ('true', True), ('t', True), ('1', True),
+                            ('TRUE', True), ('false', False), ('0', False), ('', False)]:
+        monkeypatch.setenv('SHIV_FORCE_EXTRACT', value)
+        for default in (False, True):
+            env = Environment(built_at='2020-01-01 00:00:00', shiv_version='probe',
+                              always_write_cache=default)
+            assert env.force_extract is expected
+        cached.write_bytes(b'# cache sentinel\n')
+        result = execute(archive, cache, '-c', 'pass', overrides={'SHIV_FORCE_EXTRACT': value})
+        assert result.returncode == 0, result.stderr
+        assert cached.read_bytes() == (original if expected else b'# cache sentinel\n'), (
+            'force did not control real cache materialization', value,
+        )
+    monkeypatch.delenv('SHIV_FORCE_EXTRACT')
+    for default in (False, True):
+        env = Environment(built_at='2020-01-01 00:00:00', shiv_version='probe',
+                          always_write_cache=default)
+        assert env.force_extract is default, 'absent override must use always_write_cache'
+
+
+def _cache_contender(archive_path, target, role, ready, first_extract, release, overlap, count, errors, force_first=False):
+    """Hold process 1 inside extraction so process 2 competes before placement."""
+    real_extract = zipfile.ZipFile.extract
+
+    def extract(self, *args, **kwargs):
+        with count.get_lock():
+            count.value += 1
+        if role == 1:
+            first_extract.set()
+            if not release.wait(8):
+                raise RuntimeError('parent did not release extraction')
+        elif not release.is_set():
+            overlap.set()
+        return real_extract(self, *args, **kwargs)
+
+    try:
+        with patch.object(zipfile.ZipFile, 'extract', extract):
+            ready.set()
+            with zipfile.ZipFile(archive_path) as zf:
+                extract_site_packages(zf, Path(target), force=force_first and role == 1)
+        if role == 2:
+            if not release.is_set():
+                overlap.set()
+            assert (Path(target) / "site-packages/only.txt").read_bytes() == b"complete contents", (
+                "cache reuse returned before the concurrent refresh completed"
+            )
+        errors.put(None)
+    except BaseException as exc:
+        errors.put(type(exc).__name__ + ': ' + str(exc))
+
+
+def test_competing_materializations_are_serialized(tmp_path):
+    """Initial extraction and forced refresh both serialize compatibility cache reuse."""
+    for force_first in (False, True):
+        work_dir = tmp_path / ("refresh" if force_first else "initial")
+        work_dir.mkdir()
+        _check_competing_materializations(work_dir, force_first)
+
+
+def _check_competing_materializations(tmp_path, force_first):
+    assert os.name == 'posix', 'task runtime requires POSIX lock validation'
+    archive = tmp_path / 'cache.zip'
+    with zipfile.ZipFile(archive, 'w') as zf:
+        zf.writestr('site-packages/only.txt', b'complete contents')
+    ctx = multiprocessing.get_context('fork')
+    ready1, ready2, inside, release, overlap = [ctx.Event() for _ in range(5)]
+    count, errors = ctx.Value('i', 0), ctx.Queue()
+    target = tmp_path / 'shared-cache'
+    if force_first:
+        (target / "site-packages").mkdir(parents=True)
+        (target / "site-packages/only.txt").write_bytes(b"stale contents")
+    workers = [ctx.Process(target=_cache_contender, args=(
+        str(archive), str(target), role, ready, inside, release, overlap, count, errors, force_first,
+    )) for role, ready in [(1, ready1), (2, ready2)]]
+    try:
+        workers[0].start()
+        assert inside.wait(5), 'first materialization never reached extraction'
+        workers[1].start()
+        assert ready2.wait(5), 'second process never started materialization'
+        # First extraction remains blocked throughout this bounded contention window.
+        overlap.wait(0.5)
+        release.set()
+        for worker in workers:
+            worker.join(8)
+        assert all(not worker.is_alive() and worker.exitcode == 0 for worker in workers)
+        assert not overlap.is_set(), 'same-cache extraction or cache reuse bypassed synchronization'
+        results = [errors.get(timeout=2) for _ in workers]
+        assert results == [None, None], results
+        assert count.value == 1, 'cache was not rechecked after synchronization'
+        assert (target / 'site-packages/only.txt').read_bytes() == b'complete contents'
+    finally:
+        release.set()
+        for worker in workers:
+            if worker.pid and worker.is_alive():
+                worker.terminate()
+                worker.join(2)
+        errors.close()
+
