+                    break
+                if not entry["is_method"]:
+                    proc_kinds.setdefault(entry["qualname"], set()).add(effect["kind"])
+        if any({"lock", "extract", "place"}.issubset(kinds) for kinds in proc_kinds.values()):
+            return False
+        return True
