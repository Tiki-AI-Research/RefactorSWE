+def test_preserved_preparation_and_real_runtime(tmp_path):
+    import json, os, subprocess, sys, tempfile, hashlib
+    from pathlib import Path
+    from unittest.mock import patch
+    from click.testing import CliRunner
+    from shiv.cli import main
+    import shiv.cli as cli
+    
+    out=[]
+    def record(name,ok,**details):
+     out.append(dict(name=name,passed=bool(ok),**details))
+    def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else None
+    with tempfile.TemporaryDirectory() as tmp:
+     t=Path(tmp);sp=t/'sp';sp.mkdir();(sp/'probe.py').write_text('print("archive-marker")\n')
+     runner=CliRunner()
+     for failure in ['pip','copy']:
+      for existing in [False,True]:
+       target=t/f'{failure}-{existing}.pyz'
+       if existing:target.write_bytes(b'SENTINEL')
+       before=sha(target)
+       mock_target=cli.pip if failure=='pip' else cli
+       attr='install' if failure=='pip' else 'copytree'
+       args=['-o',str(target),'offline-nonexistent-dependency']
+       if failure=='copy':args+=['--site-packages',str(sp)]
+       with patch.object(mock_target,attr,side_effect=RuntimeError('isolated preparation failure')):
+        r=runner.invoke(main,args)
+       record('R06_'+failure+'_'+str(existing),r.exit_code!=0 and sha(target)==before,exit_code=r.exit_code,before_sha=before,after_sha=sha(target))
+     archive=t/'app.pyz'
+     r=runner.invoke(main,['--site-packages',str(sp),'-o',str(archive),'-p','/usr/bin/env python3','--no-modify'])
+     assert r.exit_code==0,repr(r.exception)
+     env={k:v for k,v in os.environ.items() if not k.startswith('SHIV_')};env['SHIV_ROOT']=str(t/'cache')
+     code='import sys,json;print(json.dumps(sys.argv))'
+     r=subprocess.run([sys.executable,str(archive),'-c',code,'tail-one','tail with space'],env=env,capture_output=True,text=True)
+     got=json.loads(r.stdout) if r.returncode==0 else None
+     record('R07_real_zipapp_argv',got==['-c','tail-one','tail with space'],returncode=r.returncode,argv=got,stderr=r.stderr)
+     env['SHIV_NO_MODIFY']='1'
+     r=subprocess.run([sys.executable,str(archive),'-c','print("clean")'],env=env,capture_output=True,text=True)
+     record('R09_clean',r.returncode==0,returncode=r.returncode,stdout=r.stdout,stderr=r.stderr)
+     unpacked=next((t/'cache').rglob('probe.py'));before=sha(unpacked);unpacked.write_text('print("tampered-marker")\n')
+     r=subprocess.run([sys.executable,str(archive),'-c','print("clean")'],env=env,capture_output=True,text=True)
+     record('R09_tamper_real_bootstrap',r.returncode!=0 and 'modified' in r.stderr,returncode=r.returncode,stderr=r.stderr,before_sha=before,after_sha=sha(unpacked))
+     env.pop('SHIV_NO_MODIFY');env['SHIV_ROOT']=str(t/'cache-order')
+     # An external directory with site-packages name gives baseline reorder a real competing module.
+     external=t/'external'/'site-packages';external.mkdir(parents=True);(external/'probe.py').write_text('print("external-marker")\n')
+     env['PYTHONPATH']=str(external)
+     r=subprocess.run([sys.executable,str(archive),'-c','import probe;print(probe.__file__)'],env=env,capture_output=True,text=True)
+     record('R10_real_import_precedence',r.returncode==0 and r.stdout.startswith('archive-marker'),returncode=r.returncode,stdout=r.stdout,stderr=r.stderr)
+    (tmp_path / 'probe-results.json').write_text(json.dumps(out,indent=2))
+    print(json.dumps(out,indent=2))
+    assert all(x['passed'] for x in out), out
