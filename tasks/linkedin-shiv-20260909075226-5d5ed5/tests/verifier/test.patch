+def _build_symbol_table(py_files_map):
+    mod_to_file = {}
+    file_to_mod = {}
+    for rel_path in py_files_map:
+        parts = Path(rel_path).with_suffix("").parts
+        if parts[-1] == "__init__":
+            mod_parts = parts[:-1]
+        else:
+            mod_parts = parts
+        mod1 = ".".join(mod_parts)
+        mod2 = "shiv." + mod1 if mod1 else "shiv"
+        short = mod_parts[-1] if mod_parts else ""
+        file_to_mod[rel_path] = mod2
+        mod_to_file[mod2] = rel_path
+        if mod1:
+            mod_to_file[mod1] = rel_path
+        if short:
+            mod_to_file[short] = rel_path
+
+    file_functions = {}
+    file_classes = {}
+    file_imports = {}
+    file_aliases = {}
+
+    for fname, tree in py_files_map.items():
+        fns = {}
+        cls = {}
+        imps = {}
+        aliases = {}
+        for node in tree.body:
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                fns[node.name] = node
+            elif isinstance(node, ast.ClassDef):
+                cls[node.name] = node
+                for item in node.body:
+                    if isinstance(item, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                        fns[f"{node.name}.{item.name}"] = item
+            elif isinstance(node, ast.Import):
+                for alias in node.names:
+                    as_name = alias.asname or alias.name
+                    target_mod = alias.name
+                    target_file = mod_to_file.get(target_mod)
+                    if not target_file:
+                        for sub in target_mod.split("."):
+                            if sub in mod_to_file:
+                                target_file = mod_to_file[sub]
+                    if target_file:
+                        imps[as_name] = ("MODULE", target_file)
+                    elif target_mod == "contextlib":
+                        imps[as_name] = ("STDLIB_MODULE", "contextlib")
+                    else:
+                        imps[as_name] = ("EXT_MODULE", target_mod)
+            elif isinstance(node, ast.ImportFrom):
+                mod = node.module or ""
+                cur_mod = file_to_mod.get(fname, "")
+                if node.level > 0:
+                    pkg = ".".join(cur_mod.split(".")[:-node.level])
+                    resolved_mod = f"{pkg}.{mod}" if mod else pkg
+                else:
+                    resolved_mod = mod
+                target_file = mod_to_file.get(resolved_mod)
+                for alias in node.names:
+                    as_name = alias.asname or alias.name
+                    if target_file:
+                        imps[as_name] = ("SYMBOL", target_file, alias.name)
+                    elif resolved_mod == "contextlib":
+                        imps[as_name] = ("STDLIB_SYMBOL", "contextlib", alias.name)
+                    else:
+                        submod = f"{resolved_mod}.{alias.name}" if resolved_mod else alias.name
+                        subfile = mod_to_file.get(submod) or mod_to_file.get(alias.name)
+                        if subfile:
+                            imps[as_name] = ("MODULE", subfile)
+                        else:
+                            imps[as_name] = ("EXT_SYMBOL", resolved_mod, alias.name)
+            elif isinstance(node, ast.Assign):
+                if isinstance(node.value, ast.Name):
+                    for tgt in node.targets:
+                        if isinstance(tgt, ast.Name):
+                            aliases[tgt.id] = node.value.id
+        file_functions[fname] = fns
+        file_classes[fname] = cls
+        file_imports[fname] = imps
+        file_aliases[fname] = aliases
+
+    return file_functions, file_classes, file_imports, file_aliases
