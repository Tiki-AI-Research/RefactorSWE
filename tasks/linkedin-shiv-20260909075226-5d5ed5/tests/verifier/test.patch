+def _expr_in_prep(expr, prep_vars):
+    if isinstance(expr, ast.Name):
+        return expr.id in prep_vars
+    elif isinstance(expr, ast.Attribute):
+        if isinstance(expr.value, ast.Name):
+            return f"{expr.value.id}.{expr.attr}" in prep_vars or expr.value.id in prep_vars
+        curr = expr
+        parts = []
+        while isinstance(curr, ast.Attribute):
+            parts.append(curr.attr)
+            curr = curr.value
+        if isinstance(curr, ast.Name):
+            parts.append(curr.id)
+            key = ".".join(reversed(parts))
+            return key in prep_vars or curr.id in prep_vars
+    return False
