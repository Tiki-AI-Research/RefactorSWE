+class ArgumentChangeWitness(RuntimeWitness):
+    """Change ambient arguments immediately after an observed request returns."""
+
+    def __init__(self, source_root, boundary, replacement_argv=None):
+        super().__init__(source_root)
+        self.boundary = boundary
+        self.changed = False
+        self.replacement_argv = list(replacement_argv) if replacement_argv is not None else [
+            "app.pyz", "-c", "CHANGED_SELECTION = 1", "changed-argument",
+        ]
+
+    def profile(self, frame, event, arg):
+        super().profile(frame, event, arg)
+        if (event == "return" and frame.f_code is self.boundary
+                and self.is_request_like(arg) and not self.changed):
+            self.changed = True
+            sys.argv[:] = self.replacement_argv
+
+
+def test_preamble_request_preserves_selected_archive_context(tmp_path):
+    """A consumed preamble request owns its archive identifier across argv changes."""
+    repo_root = Path(__file__).resolve().parent.parent
+    work_dir = tmp_path / "preamble"
+    baseline = RuntimeWitness(repo_root / "src")
+    assert run_e3_witness_case(repo_root, "pre", work_dir, witness=baseline)
+    preambles = [effect for effect in baseline.effects if effect["kind"] == "PRE"]
+    assert len(preambles) == 1
+    expected = preambles[0]["detail"]
+    assert expected["archive"] == "app.pyz"
+    assert expected["site_packages"] == str(
+        work_dir / "cache" / "app.pyz_probe" / "site-packages"
+    )
+    assert expected["environment_is_runtime"], "preamble must receive the runtime environment object"
+    boundaries = {
+        baseline.selectors[id(item["request"])]["selector_code"]
+        for item in preambles[0]["witnesses"]
+    }
+    preserved = []
+    for boundary in sorted(boundaries, key=lambda code: code.co_qualname):
+        # Only the archive identifier changes; primary mode and arguments stay valid.
+        replay = ArgumentChangeWitness(
+            repo_root / "src", boundary,
+            replacement_argv=["different-archive.pyz", "-c", "pass", "arg"],
+        )
+        normal = run_e3_witness_case(repo_root, "pre", work_dir, witness=replay)
+        actual = [effect for effect in replay.effects if effect["kind"] == "PRE"]
+        preserved.append(
+            replay.changed and normal and len(actual) == 1 and actual[0]["detail"] == expected
+        )
+    assert any(preserved), (
+        "selected preamble archive context remained dependent on ambient argv: "
+        f"{preserved}"
+    )
+
+
+class IncompleteInvocationWitness(RuntimeWitness):
+    """Supply a missing operand while observing the same production boundaries."""
+
+    def __init__(self, source_root, flag):
+        super().__init__(source_root)
+        self.flag = flag
+        self.called_codes = set()
+
+    def profile(self, frame, event, arg):
+        super().profile(frame, event, arg)
+        if event == "call" and self.candidate(frame):
+            self.called_codes.add(frame.f_code)
+
+    @contextlib.contextmanager
+    def active(self):
+        sys.argv[:] = ["app.pyz", self.flag]
+        with super().active():
+            yield
+
+
+def test_interpreter_primary_request_preserves_selected_arguments(tmp_path):
+    """An independently selected command/module request owns its target and argv.
+
+    Discover boundaries from requests consumed by real bootstrap, then repeat the
+    same runtime call with an argument change just after each observed return.
+    An outer request may still defer primary selection until after a preamble;
+    at least one consumed primary request must preserve the selected intent.
+    Object, callable, and data requests use the same production execution path.
+    """
+    repo_root = Path(__file__).resolve().parent.parent
+    results = {}
+    for mode in ("interp_c", "interp_m"):
+        baseline = RuntimeWitness(repo_root / "src")
+        normal = run_e3_witness_case(
+            repo_root, mode, tmp_path / mode / "baseline", witness=baseline,
+        )
+        assert normal, f"ordinary deferred selection failed for {mode}"
+        boundaries = {
+            baseline.selectors[id(item["request"])]["selector_code"]
+            for effect in baseline.effects for item in effect["witnesses"]
+        }
+        expected = [(effect["kind"], effect["detail"]) for effect in baseline.effects]
+        preserved = []
+        for index, boundary in enumerate(sorted(boundaries, key=lambda c: c.co_qualname)):
+            replay = ArgumentChangeWitness(repo_root / "src", boundary)
+            normal = run_e3_witness_case(
+                repo_root, mode, tmp_path / mode / str(index), witness=replay,
+            )
+            actual = [(effect["kind"], effect["detail"]) for effect in replay.effects]
+            preserved.append(replay.changed and normal and actual == expected)
+        results[mode] = any(preserved)
+        incomplete = IncompleteInvocationWitness(
+            repo_root / "src", "-c" if mode == "interp_c" else "-m",
+        )
+        with pytest.raises(IndexError):
+            run_e3_witness_case(
+                repo_root, mode, tmp_path / mode / "missing-operand", witness=incomplete,
+            )
+        returned_codes = {item["selector_code"] for item in incomplete.selectors.values()}
+        # An outer request may defer primary selection. Require a consumed primary
+        # boundary reached in this replay to reject the incomplete invocation.
+        rejected = (boundaries & incomplete.called_codes) - returned_codes
+        results[mode + "_missing_operand"] = bool(rejected) and not incomplete.effects
+    assert all(results.values()), (
+        "primary interpreter selection left mode/arguments dependent on ambient argv "
+        "or returned a request with a missing operand: "
+        f"{results}"
+    )
