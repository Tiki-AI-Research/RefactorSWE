+        stack_instances = [fr.f_locals.get("self") for fr in stack if "self" in fr.f_locals]
+        if any(sc in self.active_selector_codes for sc in stack_codes):
+            self.coupled = True
+
+        valid_witnesses = []
+        for req_id, sel in list(self.selectors.items()):
+            req = sel["request"]
+            consumed = False
+            if any(req is instance for instance in stack_instances):
+                consumed = True
+            # An external executor must receive the returned object as an argument;
+            # merely keeping an unused request in a caller's locals is insufficient.
+            elif any(req_id in self.request_reads.get(id(fr), set())
