+"""Public behavior regressions for audit issues 2--13 (no implementation names)."""
+import hashlib
+import inspect
+import json
+import multiprocessing
+import os
+import subprocess
+import sys
+import zipfile
+from pathlib import Path
+from unittest.mock import patch
+
+from click.testing import CliRunner
+
+from shiv.cli import main
+from shiv.bootstrap import extract_site_packages
+from shiv.bootstrap.environment import Environment
+
+
+def build(sp, target, *options):
+    result = CliRunner().invoke(main, [
+        '--site-packages', str(sp), '-o', str(target), '--reproducible', *options,
+    ])
+    assert result.exit_code == 0, repr(result.exception)
+    return target
+
+
+def execute(archive, cache, *args, overrides=None, stdin=None):
+    runtime_env = {k: v for k, v in os.environ.items() if not k.startswith('SHIV_')}
+    runtime_env['SHIV_ROOT'] = str(cache)
+    runtime_env.update(overrides or {})
+    return subprocess.run(
+        [sys.executable, '-B', str(archive), *args], input=stdin,
+        env=runtime_env, capture_output=True, text=True, timeout=20,
+    )
+
+
+def make_payload(tmp_path):
+    sp = tmp_path / 'sp'
+    sp.mkdir()
+    (sp / 'payload.py').write_text(
+        "import json,sys\n"
+        "def main():\n"
+        "    print(json.dumps({'target':'metadata','argv':sys.argv}))\n"
+        "    return 7\n"
+        "def other():\n"
+        "    print(json.dumps({'target':'entry','argv':sys.argv}))\n"
+        "    return 9\n"
+    )
+    return sp
+
+
+def test_pip_arguments_and_staged_merge(tmp_path):
+    """Issue 2: exercise the actual CLI while keeping installation offline."""
+    import shiv.cli as cli
+    sp = tmp_path / 'existing'
+    sp.mkdir()
+    (sp / 'kept.txt').write_bytes(b'original')
+    args = ['--no-index', '--find-links', 'wheel dir', 'package==1.2', '--no-deps']
+    calls = []
+
+    def install(actual):
+        calls.append(list(actual))
+        assert actual[0] == '--target', 'pip must install into transient staging'
+        assert actual[2:] == args, 'pass-through pip arguments/order were changed'
+        staged = Path(actual[1])
+        assert staged.resolve() != sp.resolve()
+        assert (staged / 'kept.txt').read_bytes() == b'original'
+        (staged / 'kept.txt').write_bytes(b'staged modification')
+        (staged / 'installed.txt').write_bytes(b'installed')
+
+    archive = tmp_path / 'merged.pyz'
+    with patch.object(cli.pip, 'install', side_effect=install):
+        result = CliRunner().invoke(main, [
+            '--site-packages', str(sp), '-o', str(archive), '--', *args,
+        ])
+    assert result.exit_code == 0, repr(result.exception)
+    assert len(calls) == 1, 'dependency installation was dropped'
+    assert (sp / 'kept.txt').read_bytes() == b'original'
+    assert not (sp / 'installed.txt').exists()
+    with zipfile.ZipFile(archive) as zf:
+        assert zf.read('site-packages/kept.txt') == b'staged modification'
+        assert zf.read('site-packages/installed.txt') == b'installed'
+
+
+def test_default_content_identity_and_explicit_build_id(tmp_path):
+    """Issue 3: frozen identity hashes file bytes then relative names in order."""
+    sp = tmp_path / 'identity'
+    sp.mkdir()
+    (sp / 'a.txt').write_bytes(b'alpha')
+    (sp / 'z.txt').write_bytes(b'omega')
+    (sp / 'ignored.pyc').write_bytes(b'not archived')
+    identities = []
+    for variant in range(3):
+        digest = hashlib.sha256()
+        for path in sorted(sp.rglob('*'), key=str):
+            if path.is_file() and path.suffix != '.pyc':
+                digest.update(path.read_bytes())
+                digest.update(str(path.relative_to(sp)).encode())
+        archive = build(sp, tmp_path / ('identity-%s.pyz' % variant))
+        with zipfile.ZipFile(archive) as zf:
+            actual = json.loads(zf.read('environment.json'))['build_id']
+        assert actual == digest.hexdigest(), 'persisted default build_id lost content identity'
+        identities.append(actual)
+        if variant == 0:
+            (sp / 'a.txt').write_bytes(b'changed')
+        elif variant == 1:
+            (sp / 'a.txt').rename(sp / 'renamed.txt')
+    assert len(set(identities)) == 3
+    explicit = build(sp, tmp_path / 'explicit.pyz', '--build-id', 'chosen-id')
+    with zipfile.ZipFile(explicit) as zf:
+        assert json.loads(zf.read('environment.json'))['build_id'] == 'chosen-id'
+
