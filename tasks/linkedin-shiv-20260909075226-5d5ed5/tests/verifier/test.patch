+def test_nonempty_interpreter_override(tmp_path):
+    """Issue 9: any nonempty override, including false/0, forces interpreter."""
+    sp = make_payload(tmp_path)
+    archive = build(sp, tmp_path / 'override.pyz', '-e', 'payload:main')
+    for value in ['false', '0', 'yes', 'arbitrary']:
+        result = execute(archive, tmp_path / 'cache', '-c', "print('interpreter')",
+                         overrides={'SHIV_INTERPRETER': value})
+        assert result.returncode == 0 and result.stdout == 'interpreter\n', (
+            'nonempty SHIV_INTERPRETER failed to force interpreter', value, result.stderr,
+        )
+    for overrides in [{}, {'SHIV_INTERPRETER': ''}]:
+        result = execute(archive, tmp_path / 'cache', overrides=overrides)
+        assert result.returncode == 7, result.stderr
+        assert json.loads(result.stdout)['target'] == 'metadata'
+
+    # Preambles run before primary dispatch and may set runtime overrides.
+    preamble = tmp_path / 'interpreter_override.py'
+    preamble.write_text(
+        "import os\n"
+        "os.environ['SHIV_INTERPRETER'] = '1'\n"
+        "print('preamble')\n"
+    )
+    archive = build(sp, tmp_path / 'preamble-override.pyz', '-e', 'payload:main',
+                    '--preamble', str(preamble))
+    result = execute(archive, tmp_path / 'preamble-cache', '-c',
+                     "import sys; print('interpreter'); sys.exit(6)")
+    assert (result.returncode, result.stdout, result.stderr) == (6, 'preamble\ninterpreter\n', ''), (
+        'SHIV_INTERPRETER set by the preamble must override the configured entry point',
+        result.returncode, result.stdout, result.stderr,
+    )
