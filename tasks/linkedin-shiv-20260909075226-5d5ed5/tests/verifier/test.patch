+def test_preamble_actual_context_and_order(tmp_path):
+    """Issue 7: run the preamble with its actual injected globals."""
+    sp = make_payload(tmp_path)
+    preamble = tmp_path / 'pre.py'
+    preamble.write_text(
+        "import json\n"
+        "print(json.dumps({'preamble': True, 'archive': archive, 'build_id': env.build_id,"
+        " 'entry_point': env.entry_point, 'site_packages': str(site_packages),"
+        " 'payload_present': (site_packages / 'payload.py').is_file()}))\n"
+    )
+    archive = build(sp, tmp_path / 'pre.pyz', '-e', 'payload:main', '--preamble', str(preamble))
+    with zipfile.ZipFile(archive) as zf:
+        metadata = json.loads(zf.read('environment.json'))
+    cache = tmp_path / 'cache'
+    result = execute(archive, cache)
+    assert result.returncode == 7, result.stderr
+    pre, app = [json.loads(line) for line in result.stdout.splitlines()]
+    assert pre == {
+        'preamble': True, 'archive': str(archive), 'build_id': metadata['build_id'],
+        'entry_point': 'payload:main', 'site_packages': str(next(cache.rglob('payload.py')).parent),
+        'payload_present': True,
+    }, 'preamble globals lost archive/environment/site-packages context'
