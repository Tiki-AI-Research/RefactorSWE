+        # Effect implementations may belong to different collaborating objects.
+        scopes = [entry for effect in self.effects if effect["kind"] == "lock"
+                  for entry in effect["chain"] if entry["is_method"]]
+        for scope in scopes:
+            if all(any(any(entry["frame"] is scope["frame"] for entry in effect["chain"])
+                       for effect in self.effects if effect["kind"] == kind)
+                   for kind in self.REQUIRED):
+                return scope
+        return None
