+            elif callable(req) and getattr(req, "__code__", None) in stack_codes:
+                consumed = True
+            elif any(callable(getattr(req, attr, None)) and getattr(getattr(req, attr, None), "__code__", None) in stack_codes for attr in dir(req) if not attr.startswith("__")):
