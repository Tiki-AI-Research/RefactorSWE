+def test_compile_workers_and_disabled_compilation(tmp_path, monkeypatch):
+    """Issue 6: inspect actual compiler arguments, not only whether it was called."""
+    import compileall
+    compiler_signature = inspect.signature(compileall.compile_dir)
+    archive = tmp_path / 'compile.zip'
+    with zipfile.ZipFile(archive, 'w') as zf:
+        zf.writestr('site-packages/example.py', b'value=1\n')
+    env = Environment(built_at='2020-01-01 00:00:00', shiv_version='probe')
+    for index, (value, workers) in enumerate([('0', 0), ('2', 2), ('3', 3), ('invalid', 0)]):
+        monkeypatch.setenv('SHIV_COMPILE_WORKERS', value)
+        assert env.compile_workers == workers
+        target = tmp_path / ('compile-%s' % index)
+        with patch.object(compileall, 'compile_dir', return_value=True) as compiler:
+            with zipfile.ZipFile(archive) as zf:
+                extract_site_packages(zf, target, compile_pyc=True, compile_workers=env.compile_workers)
+        assert compiler.call_count == 1
+        args, kwargs = compiler.call_args
+        bound = compiler_signature.bind(*args, **kwargs)
+        bound.apply_defaults()
+        assert bound.arguments['quiet'] == 2
+        assert bound.arguments['workers'] == workers, 'configured workers were ignored'
+        assert Path(args[0]).parent == target.parent
+    with patch.object(compileall, 'compile_dir') as compiler:
+        with zipfile.ZipFile(archive) as zf:
+            extract_site_packages(zf, tmp_path / 'disabled', compile_pyc=False, compile_workers=3)
+    compiler.assert_not_called()
+
+    # Also exercise propagation from runtime environment through production bootstrap.
+    sp = tmp_path / 'runtime-sp'
+    sp.mkdir()
+    (sp / 'example.py').write_text('value=1\n')
+    app = build(sp, tmp_path / 'runtime-compile.pyz', '--compile-pyc')
+    launcher = (
+        "import compileall,inspect,json,runpy,sys\n"
+        "signature=inspect.signature(compileall.compile_dir)\n"
+        "def observe(*args,**kwargs):\n"
+        "    bound=signature.bind(*args,**kwargs);bound.apply_defaults()\n"
+        "    print(json.dumps({k:bound.arguments[k] for k in ['quiet','workers']}))\n"
+        "    return True\n"
+        "compileall.compile_dir=observe\n"
+        "archive=sys.argv[1];sys.argv=[archive,'-c','pass']\n"
+        "runpy.run_path(archive,run_name='__main__')\n"
+    )
+    for value, workers in [('3', 3), ('invalid', 0)]:
+        runtime_env = {k: v for k, v in os.environ.items() if not k.startswith('SHIV_')}
+        runtime_env.update(SHIV_ROOT=str(tmp_path / ('runtime-cache-' + value)),
+                           SHIV_COMPILE_WORKERS=value)
+        result = subprocess.run([sys.executable, '-B', '-c', launcher, str(app)],
+                                env=runtime_env, capture_output=True, text=True, timeout=20)
+        assert result.returncode == 0, result.stderr
+        assert json.loads(result.stdout) == {'quiet': 2, 'workers': workers}, (
+            'bootstrap did not pass the configured compile worker value',
+        )
+
