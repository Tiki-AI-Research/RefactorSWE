+            return False
+        tname = type(val).__name__
+        if tname in ("Environment", "MockArchive", "ZipFile"):
+            return False
+        if hasattr(val, "execute") or hasattr(val, "run"):
+            return True
+        if callable(val) and getattr(val, "__code__", None) is not None and not isinstance(val, type):
+            return True
+        # Data requests may be mappings, tuples, or ordinary candidate objects.
+        # Recognition must not depend on a Command base class or private type name.
+        if isinstance(val, (dict, tuple, list)):
