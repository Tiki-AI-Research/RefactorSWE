+"""Preserve the original import location and behavior of interpreter callers."""
+import json
+import sys
+
+import pytest
+
+
+def test_bootstrap_interpreter_compatibility_entry_point(monkeypatch, capsys):
+    import shiv.bootstrap as bootstrap
+
+    invoke = getattr(bootstrap, "execute_interpreter", None)
+    assert callable(invoke), "the original bootstrap interpreter entry point must remain callable"
+    content = (
+        "import json,sys\n"
+        "print(json.dumps({'argv':sys.argv,'name':__name__,'file':__file__}))\n"
+        "print('compatibility stderr',file=sys.stderr)\n"
+        "sys.exit(9)\n"
+    )
+    monkeypatch.setattr(sys, "argv", ["app.pyz", "-c", content, "tail with space"])
+    with pytest.raises(SystemExit) as result:
+        invoke()
+    assert result.value.code == 9, "the compatibility call must execute and propagate the exit code"
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == {
+        "argv": ["-c", "tail with space"], "name": "__main__", "file": "-c <cmd>",
+    }
+    assert captured.err == "compatibility stderr\n"
+
+    for option in ("-c", "-m"):
+        monkeypatch.setattr(sys, "argv", ["app.pyz", option])
+        with pytest.raises(IndexError):
+            invoke()
