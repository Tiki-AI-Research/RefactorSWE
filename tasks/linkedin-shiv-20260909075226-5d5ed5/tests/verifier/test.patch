+            w.effect(
+                "PRE", path=str(path), archive=context.get("archive"),
+                site_packages=str(context.get("site_packages")),
+                environment_is_runtime=context.get("env") is env,
+            )
+        else:
+            w.effect("SCRIPT", path=str(path))
+        return {}
+
+    def ec(name, val, argv0=None):
+        w.effect("CONTENT", argv=list(sys.argv), name=name, content=val)
+        return None
+
+    def rm(name, **kw):
+        w.effect("MODULE", module=name, argv=list(sys.argv))
+
+    def interactive(*a, **kw):
+        w.effect("INTERACTIVE", argv=list(sys.argv))
+
+    real_exec = exec
+    def hooked_exec(code_obj, *args, **kwargs):
+        w.effect("CONTENT", argv=list(sys.argv))
+        return real_exec(code_obj, *args, **kwargs)
+
+    if kind in ("app", "app_script"):
+        argv = ["app.pyz"]
+    elif kind == "pre":
+        argv = ["app.pyz", "-c", "pass", "arg"]
+    elif kind == "interp_c":
+        argv = ["app.pyz", "-c", "x = 1", "arg"]
+    elif kind == "interp_m":
+        argv = ["app.pyz", "-m", "fixture_module", "arg"]
+    elif kind == "interp_script":
+        script_file = work_dir / "probe_script.py"
+        script_file.write_text("PROBE_SCRIPT_VAL = 1\n")
+        argv = ["app.pyz", str(script_file), "arg"]
+    elif kind == "interp_stdin":
+        argv = ["app.pyz", "-", "arg"]
+    elif kind == "interp_interactive":
+        argv = ["app.pyz"]
+    else:
+        argv = ["app.pyz"]
+
+    orig_run_path = runpy.run_path
+    orig_run_module = runpy.run_module
+    orig_interact = code.interact
+    orig_console_interact = getattr(code.InteractiveConsole, "interact", None)
+    orig_execute_content = getattr(i, "execute_content", None)
+
+    with clean_env(), contextlib.ExitStack() as stack:
+        sys.argv[:] = list(argv)
+        stack.enter_context(patch.object(b, "current_zipfile", arc))
+        stack.enter_context(patch.object(Environment, "from_json", lambda x: env))
+        stack.enter_context(patch.object(b.site, "addsitedir", lambda *a: None))
+        stack.enter_context(patch.object(runpy, "run_path", rp))
+        stack.enter_context(patch.object(runpy, "run_module", rm))
+        stack.enter_context(patch.object(code, "interact", interactive))
+        stack.enter_context(patch.object(code.InteractiveConsole, "interact", interactive))
+        stack.enter_context(patch("builtins.exec", side_effect=hooked_exec))
+        if hasattr(i, "execute_content"):
+            stack.enter_context(patch.object(i, "execute_content", ec))
+        if kind == "interp_stdin":
+            stack.enter_context(patch.object(sys, "stdin", io.StringIO("PROBE_STDIN_VAL = 1\n")))
+
+        for mname, mval in list(sys.modules.items()):
+            if mval and mname.startswith("shiv.bootstrap"):
+                for attr_name, attr_val in list(vars(mval).items()):
+                    if attr_val is orig_run_path or (hasattr(attr_val, "__wrapped__") and getattr(attr_val, "__wrapped__") is orig_run_path):
+                        stack.enter_context(patch.object(mval, attr_name, rp))
+                    elif attr_val is orig_run_module or (hasattr(attr_val, "__wrapped__") and getattr(attr_val, "__wrapped__") is orig_run_module):
+                        stack.enter_context(patch.object(mval, attr_name, rm))
+                    elif attr_val is orig_interact or attr_val is orig_console_interact:
+                        stack.enter_context(patch.object(mval, attr_name, interactive))
+                    elif orig_execute_content is not None and attr_val is orig_execute_content:
+                        stack.enter_context(patch.object(mval, attr_name, ec))
+                if hasattr(mval, "run_path"):
+                    stack.enter_context(patch.object(mval, "run_path", rp))
+                if hasattr(mval, "run_module"):
+                    stack.enter_context(patch.object(mval, "run_module", rm))
+                if hasattr(mval, "interact"):
+                    stack.enter_context(patch.object(mval, "interact", interactive))
+                if hasattr(mval, "execute_content"):
+                    stack.enter_context(patch.object(mval, "execute_content", ec))
+
+        with w.active():
+            try:
+                # Exercise selection through production bootstrap for every mode.
+                # execute_interpreter may remain an executor; the contract does not
+                # require the compatibility helper itself to return a request.
+                b.bootstrap()
+            except SystemExit:
+                pass
+
+    if w.coupled:
+        return False
+    out = w.effects
+
+    pre_effects = [e for e in out if e["kind"] == "PRE"]
+    primary_effects = [e for e in out if e["kind"] in ("APP", "SCRIPT", "CONTENT", "MODULE", "INTERACTIVE")]
+
+    if kind != "pre" and pre_effects:
+        return False
+
+    if kind == "app":
+        if not primary_effects or any(e["kind"] != "APP" for e in primary_effects):
+            return False
+        return bool(primary_effects[-1]["witnesses"]) and len(primary_effects) == 1
+    elif kind == "app_script":
+        if not primary_effects or any(e["kind"] != "SCRIPT" for e in primary_effects):
+            return False
+        if any(not str(e["detail"].get("path", "")).endswith("fixture_script") for e in primary_effects):
+            return False
+        return bool(primary_effects[-1]["witnesses"]) and len(primary_effects) == 1
+    elif kind == "pre":
+        if not pre_effects or not primary_effects:
+            return False
+        if any(e["kind"] != "CONTENT" for e in primary_effects):
+            return False
+        return (
+            bool(pre_effects[0]["witnesses"])
+            and bool(primary_effects[0]["witnesses"])
+            and pre_effects[0]["seq"] < primary_effects[0]["seq"]
+            and len(pre_effects) == 1
+        )
+    elif kind == "interp_c":
+        if not primary_effects or any(e["kind"] != "CONTENT" for e in primary_effects):
+            return False
+        c_with_content = [e for e in primary_effects if "content" in e["detail"]]
+        if c_with_content and any(e["detail"]["content"] != "x = 1" for e in c_with_content):
+            return False
+        return bool(primary_effects[-1]["witnesses"]) and len(c_with_content or primary_effects) == 1
+    elif kind == "interp_m":
+        if not primary_effects or any(e["kind"] != "MODULE" for e in primary_effects):
+            return False
+        if any(e["detail"].get("module") != "fixture_module" for e in primary_effects):
+            return False
+        return bool(primary_effects[-1]["witnesses"]) and len(primary_effects) == 1
+    elif kind == "interp_script":
+        if not primary_effects or any(e["kind"] not in ("CONTENT", "SCRIPT") for e in primary_effects):
+            return False
+        c_spurious = [e for e in primary_effects if e["kind"] == "CONTENT" and e["detail"].get("content") != "PROBE_SCRIPT_VAL = 1\n"]
+        if c_spurious:
+            return False
+        return bool(primary_effects[-1]["witnesses"])
+    elif kind == "interp_stdin":
+        if not primary_effects or any(e["kind"] != "CONTENT" for e in primary_effects):
+            return False
+        return bool(primary_effects[-1]["witnesses"]) and len(primary_effects) >= 1
+    elif kind == "interp_interactive":
+        if not primary_effects or any(e["kind"] != "INTERACTIVE" for e in primary_effects):
+            return False
+        return bool(primary_effects[-1]["witnesses"]) and len(primary_effects) == 1
+
+    return False
+
+
+# ---------------------------------------------------------------------------
+# Behavior Node 3 (BN-3 / E3): Selection -> Deferred Intent -> Execution
+# ---------------------------------------------------------------------------
+class TestF2P05E3ApplicationDeferredIntent:
+    def test_e3_application_target_deferred_intent(self, tmp_path):
+        """BN-3: Application callable and console script selection formulates a deferred execution
+        request before target invocation."""
+        repo_root = Path(__file__).resolve().parent.parent
+        res_callable = run_e3_witness_case(repo_root, "app", tmp_path / "app")
+        assert res_callable, "E3 callable selection failed to produce a deferred intent before execution"
