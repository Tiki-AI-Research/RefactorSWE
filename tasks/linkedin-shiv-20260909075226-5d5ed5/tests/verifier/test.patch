+                is_coupled = sel["selector_code"] in stack_codes
+                # Sequence check: execution must be strictly after selector returned
+                is_after = self.seq > sel["return_seq"]
+                if not is_coupled and is_after:
+                    valid_witnesses.append({
+                        "selector": sel["selector"],
+                        "request": req,
+                        "consumed": True,
+                    })
