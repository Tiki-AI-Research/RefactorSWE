+class CacheLifecycle:
+    """Manages the cache materialization lifecycle for zipapp site-packages."""
+
+    def __init__(
+        self,
+        archive: zipfile.ZipFile,
+        target_path: Optional[Path] = None,
+        compile_pyc: bool = False,
+        compile_workers: int = 0,
+        force: bool = False,
+        root_dir: Optional[str] = None,
+        build_id: Optional[str] = None,
+    ):
+        self.archive = archive
+        if target_path is not None:
+            self.target_path = Path(target_path)
+        else:
+            self.target_path = self._evaluate_target_path(root_dir, build_id)
+        self.compile_pyc = compile_pyc
+        self.compile_workers = compile_workers
+        self.force = force
+
+    def _evaluate_target_path(self, root_dir: Optional[str], build_id: Optional[str]) -> Path:
+        """Evaluate the cache target directory for the archive and build id."""
+        if root_dir:
+            if root_dir.startswith("$"):
+                root_dir = os.environ.get(root_dir[1:], root_dir[1:])
+            root_dir = Path(root_dir).expanduser()
+
+        root = root_dir or Path("~/.shiv").expanduser()
+        name = Path(self.archive.filename).resolve().name
+        return root / f"{name}_{build_id}"
+
+    @property
+    def site_packages(self) -> Path:
+        """Return the site-packages path within the target directory."""
+        return self.target_path / "site-packages"
+
+    @property
+    def parent_dir(self) -> Path:
+        return self.target_path.parent
+
+    @property
+    def temp_path(self) -> Path:
+        return Path(self.parent_dir, self.target_path.name + ".tmp")
+
+    @property
+    def lock_path(self) -> Path:
+        return Path(self.parent_dir, f".{self.target_path.name}_lock")
+
+    def should_materialize(self) -> bool:
+        """Determine if materialization is needed based on cache existence and force flag."""
+        return not self.target_path.exists() or self.force
+
+    def materialize(self) -> Path:
+        """Execute the materialization lifecycle and return the site-packages path."""
+        if not self.parent_dir.exists():
+            self.parent_dir.mkdir(parents=True, exist_ok=True)
+
+        with FileLock(self.lock_path):
+            # After acquiring lock, re-check if materialization is needed
+            if not self.should_materialize():
+                return self.site_packages
+
+            self._extract_and_restore_permissions()
+
+            if self.compile_pyc:
+                compileall.compile_dir(self.temp_path, quiet=2, workers=self.compile_workers)
+
+            if self.target_path.exists():
+                shutil.rmtree(str(self.target_path))
+
+            shutil.move(str(self.temp_path), str(self.target_path))
+
+        return self.site_packages
+
+    def _extract_and_restore_permissions(self) -> None:
+        """Extract packaged site-packages and restore file permissions."""
+        for fileinfo in self.archive.infolist():
+            if fileinfo.filename.startswith("site-packages"):
+                extracted = self.archive.extract(fileinfo.filename, self.temp_path)
+                os.chmod(extracted, fileinfo.external_attr >> 16)
 
 
