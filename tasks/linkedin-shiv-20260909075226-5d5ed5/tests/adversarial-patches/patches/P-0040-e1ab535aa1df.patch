+
+def select_execution_request(env: Environment, site_packages: Path) -> ExecutionRequest:
+    """Decouple target selection from execution.
+
+    Evaluates configuration, entry points, scripts, and interpreter options,
+    returning an independently representable ExecutionRequest without immediately executing it.
