+// Writer ownership and note identity are independently replaceable inputs.
+// Score them separately so an external manager does not imply a wrong identity.
+func TestF2PWritesUseOwnedNoteManager(t *testing.T) {
+	m := mustF2PPackage(t, findRepoRoot(t), "pkg", "actions")
+	owner := requireOperation(t, m)
+	entry := m.functionByName("Frontmatter")
+	writes := 0
+	for _, fn := range m.closure(entry) {
+		for _, call := range fn.calls {
+			if call.pkg != "" || call.name != "SetContents" {
+				continue
+			}
+			writes++
+			if call.receiver == nil || !m.origin(fn, exprString(m.fset, call.receiver), owner, false, map[string]bool{}, true) {
+				t.Errorf("frontmatter write manager at %s:%d is not owned by %s", relPath(fn.file), call.line, owner)
+			}
+		}
+	}
+	if writes == 0 {
+		t.Fatal("no reachable frontmatter write found")
+	}
+	for _, issue := range m.f2pInstanceProvenance().manager {
+		t.Error(issue)
+	}
+}
