+// These F2P-only flow helpers supplement the call-graph checks above. A shared
+// call whose value is discarded (including one used only for its error) is not
+// evidence that the returned note uses the shared implementation. Values carry
+// concrete result-site identities, not just names of reachable functions.
+// This is a bounded local may-flow analysis: branches are joined, helper bodies
+// are interpreted with their actual argument flows, and recursive calls stop.
+// It intentionally does not attempt general heap or arbitrary library analysis.
+func TestF2PKeyTransformsUseSharedSerializationResult(t *testing.T) {
+	m := mustF2PPackage(t, findRepoRoot(t), "pkg", "frontmatter")
+	f2pRequireReturnedSharedResult(t, m, "serialization")
+}
+
+func TestF2PKeyTransformsUseSharedReconstructionResult(t *testing.T) {
+	m := mustF2PPackage(t, findRepoRoot(t), "pkg", "frontmatter")
+	f2pRequireReturnedSharedResult(t, m, "reconstruction")
+}
+
+type f2pResultFlow map[string]bool
+
+type f2pResultEnv map[string]f2pResultFlow
+
+func f2pMergeFlow(values ...f2pResultFlow) f2pResultFlow {
+	out := f2pResultFlow{}
+	for _, value := range values {
+		for site := range value {
+			out[site] = true
+		}
+	}
+	return out
+}
+
+func f2pCopyEnv(env f2pResultEnv) f2pResultEnv {
+	out := f2pResultEnv{}
+	for name, value := range env {
+		out[name] = f2pMergeFlow(value)
+	}
+	return out
+}
+
+func f2pRequireReturnedSharedResult(t *testing.T, m *f2pModel, kind string) {
+	t.Helper()
+	outputs := []f2pResultFlow{}
+	for _, name := range []string{"SetKey", "DeleteKey"} {
+		results := m.f2pFunctionResults(m.functionByName(name), nil, nil, map[*funcInfo]bool{})
+		output := f2pResultFlow{}
+		if len(results) > 0 {
+			output = results[0]
+		}
+		outputs = append(outputs, output)
+	}
+	shared := false
+	prefix := kind + ":"
+	for site := range outputs[0] {
+		if strings.HasPrefix(site, prefix) && outputs[1][site] {
+			shared = true
+		}
+	}
+	if !shared {
+		t.Errorf("SetKey and DeleteKey must return note output derived from an actual shared %s result; a reachable but discarded helper does not satisfy sharing", kind)
+	}
+	f2pRequireReturnedSharedPaths(t, m, kind)
+}
+
+func (m *f2pModel) f2pFunctionResults(fn *funcInfo, args []f2pResultFlow, receiver f2pResultFlow, active map[*funcInfo]bool) []f2pResultFlow {
+	if fn == nil || active[fn] || len(active) > 32 {
+		return nil
+	}
+	active[fn] = true
+	defer delete(active, fn)
+	env := f2pResultEnv{}
+	// Bounded local YAML encoder-to-writer bindings. Encode returns only an
+	// error; serialization provenance belongs to the writer it actually fills.
+	encoders := m.f2pEncoderWriters(fn)
+	for i, name := range fn.params {
+		if i < len(args) {
+			env[name] = args[i]
+		}
+	}
+	if fn.recvName != "" {
+		env[fn.recvName] = receiver
+	}
+	results := make([]f2pResultFlow, len(fn.results))
+	var expr func(ast.Expr) f2pResultFlow
+	var callResults func(*ast.CallExpr) []f2pResultFlow
+	site := func(kind string, expression ast.Expr) string {
+		return fmt.Sprintf("%s:%s:%d", kind, fn.file, expression.Pos())
+	}
+	callResults = func(call *ast.CallExpr) []f2pResultFlow {
+		if array, ok := call.Fun.(*ast.ArrayType); ok && array.Len == nil && len(call.Args) == 1 {
+			if element, ok := array.Elt.(*ast.Ident); ok && element.Name == "byte" {
+				return []f2pResultFlow{expr(call.Args[0])}
+			}
+		}
+		ref, ok := describeCall(m.fset, fn.imports, call)
+		if !ok {
+			return nil
+		}
+		arguments := make([]f2pResultFlow, len(call.Args))
+		for i, argument := range call.Args {
+			arguments[i] = expr(argument)
+		}
+		// Resolve this particular call, never all calls elsewhere in the body.
+		if ref.pkg == "" {
+			for _, target := range m.byName[ref.name] {
+				matches := ref.receiver == nil && target.recvType == "" && target.parent == nil
+				if ref.receiver != nil {
+					owner := m.expressionType(fn, ref.receiver)
+					matches = owner != "" && (target.operationType() == owner || m.implements(target.operationType(), owner))
+				}
+				if matches {
+					return m.f2pFunctionResults(target, arguments, expr(ref.receiver), active)
+				}
+			}
+		}
+		// The source model deliberately does not type-check imports; versioned
+		// package paths (yaml.v3) may use a different default qualifier (yaml).
+		if ref.name == "Marshal" {
+			return []f2pResultFlow{{site("serialization", call): true}, nil}
+		}
+		if sel, ok := call.Fun.(*ast.SelectorExpr); ok && !fn.imports[ref.pkg] {
+			key := exprString(m.fset, sel.X)
+			if ref.name == "Encode" && encoders[key] != "" {
+				writer := encoders[key]
+				env[writer] = f2pMergeFlow(env[writer], f2pResultFlow{site("serialization", call): true})
+				return []f2pResultFlow{nil}
+			}
+			switch ref.name {
+			case "WriteString", "Write":
+				env[key] = f2pMergeFlow(append(arguments, env[key])...)
+				if containsDelimiterOperand(call) {
+					env[key][site("reconstruction", call)] = true
+				}
+				return nil
+			case "String", "Bytes":
+				return []f2pResultFlow{env[key]}
+			case "Reset":
+				env[key] = nil
+				return nil
+			}
+		}
+		// Only known value-preserving library operations propagate arguments.
+		// In particular, passing bytes to a helper that ignores them cannot work.
+		preserves := ref.pkg == "" && (ref.name == "string" || ref.name == "append")
+		if ref.pkg != "" {
+			preserves = (ref.pkg == "fmt" && ref.name == "Sprintf") ||
+				(ref.pkg == "strings" && (ref.name == "Join" || ref.name == "TrimPrefix" || ref.name == "TrimSuffix" || ref.name == "TrimSpace"))
+		}
+		if preserves {
+			value := f2pMergeFlow(arguments...)
+			if containsDelimiterOperand(call) && (ref.name == "Sprintf" || ref.name == "Join") {
+				value[site("reconstruction", call)] = true
+			}
+			return []f2pResultFlow{value}
+		}
+		return nil
+	}
+	expr = func(expression ast.Expr) f2pResultFlow {
+		switch value := expression.(type) {
+		case *ast.Ident:
+			return env[value.Name]
+		case *ast.ParenExpr:
+			return expr(value.X)
+		case *ast.UnaryExpr:
+			return expr(value.X)
+		case *ast.SelectorExpr:
+			return f2pMergeFlow(env[exprString(m.fset, value)], expr(value.X))
+		case *ast.BinaryExpr:
+			if value.Op == token.ADD {
+				flow := f2pMergeFlow(expr(value.X), expr(value.Y))
+				if containsDelimiterOperand(value) {
+					flow[site("reconstruction", value)] = true
+				}
+				return flow
+			}
+		case *ast.CompositeLit:
+			flow := f2pResultFlow{}
+			for _, element := range value.Elts {
+				if kv, ok := element.(*ast.KeyValueExpr); ok {
+					flow = f2pMergeFlow(flow, expr(kv.Value))
+				} else {
+					flow = f2pMergeFlow(flow, expr(element))
+				}
+			}
+			return flow
+		case *ast.CallExpr:
+			values := callResults(value)
+			if len(values) > 0 {
+				return values[0]
+			}
+		}
+		return nil
+	}
+	assign := func(names, values []ast.Expr, compound bool) {
+		flows := make([]f2pResultFlow, len(values))
+		if len(values) == 1 {
+			if call, ok := values[0].(*ast.CallExpr); ok {
+				flows = callResults(call)
+			} else {
+				flows[0] = expr(values[0])
+			}
+		} else {
+			for i, value := range values {
+				flows[i] = expr(value)
+			}
+		}
+		for i, name := range names {
+			key := exprString(m.fset, name)
+			if key == "_" {
+				continue
+			}
+			var flow f2pResultFlow
+			if i < len(flows) {
+				flow = flows[i]
+			}
+			if compound {
+				flow = f2pMergeFlow(env[key], flow)
+			}
+			env[key] = flow
+		}
+	}
+	var block func([]ast.Stmt) bool
+	var statement func(ast.Stmt) bool
+	statement = func(s ast.Stmt) bool {
+		switch value := s.(type) {
+		case *ast.AssignStmt:
+			assign(value.Lhs, value.Rhs, value.Tok == token.ADD_ASSIGN)
+		case *ast.DeclStmt:
+			if declaration, ok := value.Decl.(*ast.GenDecl); ok {
+				for _, spec := range declaration.Specs {
+					if v, ok := spec.(*ast.ValueSpec); ok {
+						names := []ast.Expr{}
+						for _, name := range v.Names {
+							names = append(names, name)
+						}
+						assign(names, v.Values, false)
+					}
+				}
+			}
+		case *ast.ExprStmt:
+			expr(value.X)
+		case *ast.ReturnStmt:
+			var flows []f2pResultFlow
+			if len(value.Results) == 1 {
+				if call, ok := value.Results[0].(*ast.CallExpr); ok {
+					flows = callResults(call)
+				}
+			}
+			if flows == nil {
+				for _, result := range value.Results {
+					flows = append(flows, expr(result))
+				}
+			}
+			for i, flow := range flows {
+				if i < len(results) {
+					results[i] = f2pMergeFlow(results[i], flow)
+				}
+			}
+			return false
+		case *ast.BlockStmt:
+			return block(value.List)
+		case *ast.IfStmt:
+			if value.Init != nil {
+				statement(value.Init)
+			}
+			before := f2pCopyEnv(env)
+			leftLive := block(value.Body.List)
+			left := env
+			env = f2pCopyEnv(before)
+			rightLive := true
+			if value.Else != nil {
+				rightLive = statement(value.Else)
+			}
+			if leftLive {
+				if !rightLive {
+					env = left
+				} else {
+					for key, flow := range left {
+						env[key] = f2pMergeFlow(env[key], flow)
+					}
+				}
+			}
+			return leftLive || rightLive
+		case *ast.SwitchStmt:
+			if value.Init != nil {
+				statement(value.Init)
+			}
+			before := f2pCopyEnv(env)
+			joined := f2pResultEnv{}
+			live, hasDefault := false, false
+			for _, item := range value.Body.List {
+				clause := item.(*ast.CaseClause)
+				hasDefault = hasDefault || clause.List == nil
+				env = f2pCopyEnv(before)
+				if block(clause.Body) {
+					live = true
+					for key, flow := range env {
+						joined[key] = f2pMergeFlow(joined[key], flow)
+					}
+				}
+			}
+			if !hasDefault {
+				live = true
+				for key, flow := range before {
+					joined[key] = f2pMergeFlow(joined[key], flow)
+				}
+			}
+			env = joined
+			return live
+		case *ast.ForStmt:
+			if value.Init != nil {
+				statement(value.Init)
+			}
+			before := f2pCopyEnv(env)
+			block(value.Body.List)
+			for key, flow := range before {
+				env[key] = f2pMergeFlow(env[key], flow)
+			}
+		case *ast.RangeStmt:
+			before := f2pCopyEnv(env)
+			block(value.Body.List)
+			for key, flow := range before {
+				env[key] = f2pMergeFlow(env[key], flow)
+			}
+		}
+		return true
+	}
+	block = func(statements []ast.Stmt) bool {
+		for _, s := range statements {
+			if !statement(s) {
+				return false
+			}
+		}
+		return true
+	}
+	block(fn.body.List)
+	return results
+}
+
+// f2pPathValue is deliberately separate from the shared source model and the
+// returned-result analysis. Objects retain construction-site identity: an unused
+// literal cannot supply provenance for the receiver that actually gets called.
+// Branches are joined conservatively, without attempting to prove predicates.
+type f2pPathValue struct {
+	pointer       bool
+	reassigned    bool
+	known         bool
+	owned         bool
+	writer        bool
+	closureOwned  bool
+	loaded        bool
+	flag          bool
+	typ           string
+	views         map[*f2pPathObject]string
+	closureOwners []*f2pPathObject
+	objects       []*f2pPathObject
+	closures      []*f2pPathClosure
+}
+
+type f2pPathObject struct {
+	// root survives branch snapshots, preserving actual object/alias identity.
+	root   *f2pPathObject
+	typ    string
+	fields map[string]f2pPathValue
+}
+
+type f2pPathClosure struct {
+	literal *ast.FuncLit
+	parent  *funcInfo
+	env     map[string]f2pPathValue
+}
+
+type f2pPathAudit struct {
+	contents  []string
+	identity  []string
+	manager   []string
+	receivers map[string]map[*f2pPathObject]bool
+	contexts  map[*f2pPathObject]bool
+	writers   map[*f2pPathObject]bool
+	unloaded  []string
+	selection []string
+	steps     int
+	model     *f2pModel
+}
+
+func f2pPathMerge(a, b f2pPathValue) f2pPathValue {
+	a.pointer = a.pointer && b.pointer
+	a.reassigned = a.reassigned || b.reassigned
+	a.known = a.known && b.known
+	a.owned = a.owned && b.owned
+	a.writer = a.writer && b.writer
+	a.closureOwned = a.closureOwned && b.closureOwned
+	a.loaded = a.loaded && b.loaded
+	a.flag = a.flag || b.flag
+	if a.typ == "" {
+		a.typ = b.typ
+	}
+	if a.views == nil {
+		a.views = map[*f2pPathObject]string{}
+	}
+	for root, typ := range b.views {
+		a.views[root] = typ
+	}
+	a.closureOwners = append(append([]*f2pPathObject(nil), a.closureOwners...), b.closureOwners...)
+	a.objects = append(append([]*f2pPathObject(nil), a.objects...), b.objects...)
+	a.closures = append(append([]*f2pPathClosure(nil), a.closures...), b.closures...)
+	return a
+}
+
+func f2pPathEnv(env map[string]f2pPathValue) map[string]f2pPathValue {
+	out := map[string]f2pPathValue{}
+	for name, value := range env {
+		out[name] = value
+	}
+	return out
+}
+
+func (m *f2pModel) f2pInstanceProvenance() *f2pPathAudit {
+	audit := &f2pPathAudit{model: m, receivers: map[string]map[*f2pPathObject]bool{}, contexts: map[*f2pPathObject]bool{}, writers: map[*f2pPathObject]bool{}}
+	entry := m.functionByName("Frontmatter")
+	if entry != nil {
+		audit.function(entry, nil, f2pPathValue{}, nil, false, 0)
+	}
+	return audit
+}
+
+func (a *f2pPathAudit) function(fn *funcInfo, args []f2pPathValue, recv f2pPathValue, captured map[string]f2pPathValue, capability bool, depth int) []f2pPathValue {
+	if fn == nil || depth > 40 || a.steps > 3000 {
+		return nil
+	}
+	a.steps++
+	env := f2pPathEnv(captured)
+	for i, name := range fn.params {
+		value := f2pPathValue{typ: fn.types[name], known: true}
+		if i < len(args) {
+			value = args[i]
+		}
+		if a.model.valueParams[fn.id][name] && !value.pointer && len(value.objects) > 0 {
+			value = f2pCopyValue(value)
+		}
+		env[name] = value
+	}
+	if fn.recvName != "" {
+		if a.model.valueReceivers[fn.id] {
+			recv = f2pCopyValue(recv)
+		}
+		env[fn.recvName] = recv
+	}
+	for _, cap := range allCapabilities {
+		if fn.operationType() != "" && a.model.exclusiveCapability(fn, cap) {
+			capability = true
+		}
+	}
+	previousContexts, previousWriters := a.contexts, a.writers
+	owner := a.model.declaredOperationType()
+	if len(recv.objects) > 0 && fn.operationType() != "" && a.model.ownedType(owner, fn.operationType(), map[string]bool{}) {
+		// Only the receiver actually invoked supplies this operation's ownership.
+		a.contexts, a.writers = map[*f2pPathObject]bool{}, map[*f2pPathObject]bool{}
+		seen := map[*f2pPathObject]bool{}
+		var visit func(f2pPathValue)
+		visit = func(value f2pPathValue) {
+			for _, object := range value.objects {
+				if seen[object] {
+					continue
+				}
+				seen[object] = true
+				root := f2pObjectRoot(object)
+				if a.model.sameLayout(object.typ, owner) || object.typ == owner || a.model.ownedType(object.typ, owner, map[string]bool{}) {
+					a.contexts[root] = true
+				}
+				a.writers[root] = true
+				for _, field := range object.fields {
+					visit(field)
+				}
+			}
+		}
+		visit(recv)
+	}
+
+	for _, cap := range allCapabilities {
+		if fn.operationType() == "" || !a.model.exclusiveCapability(fn, cap) {
+			continue
+		}
+		if a.receivers[cap] == nil {
+			a.receivers[cap] = map[*f2pPathObject]bool{}
+		}
+		for root := range a.contexts {
+			a.receivers[cap][root] = true
+		}
+	}
+	defer func() { a.contexts, a.writers = previousContexts, previousWriters }()
+	return a.body(fn, fn.body, env, capability, depth)
+}
+
+func (a *f2pPathAudit) body(fn *funcInfo, body *ast.BlockStmt, env map[string]f2pPathValue, capability bool, depth int) []f2pPathValue {
+	m := a.model
+	destinations := f2pDestinations(env)
+	var results []f2pPathValue
+	var returnedHeaps []map[string]f2pPathValue
+	mergeResults := func(values []f2pPathValue) {
+		for i, value := range values {
+			if i >= len(results) {
+				results = append(results, value)
+			} else {
+				results[i] = f2pPathMerge(results[i], value)
+			}
+		}
+	}
+	var expression func(ast.Expr) f2pPathValue
+	var addressable func(ast.Expr) f2pPathValue
+	var call func(*ast.CallExpr) []f2pPathValue
+	var block func([]ast.Stmt, map[string]f2pPathValue) bool
+	var assign func(ast.Expr, f2pPathValue)
+	field := func(base f2pPathValue, name string) f2pPathValue {
+		value := f2pPathValue{typ: m.fieldTypes[base.typ][name], known: base.known, owned: base.owned, writer: base.writer}
+		found := false
+		for _, object := range base.objects {
+			v := object.fields[name]
+			v.known = true
+			// Scalar provenance is stamped when read from the active instance,
+			// never merely because another object has the same nominal type.
+			if !v.reassigned {
+				v.owned = a.contexts[f2pObjectRoot(object)]
+				v.writer = a.writers[f2pObjectRoot(object)]
+			}
+			if len(v.closures) > 0 {
+				v.closureOwners = append(v.closureOwners, f2pObjectRoot(object))
+			}
+			v.closureOwned = v.owned || v.writer || (len(v.closures) > 0 && m.ownedType(m.declaredOperationType(), object.typ, map[string]bool{}))
+			if v.typ == "" {
+				v.typ = m.fieldTypes[object.typ][name]
+			}
+			if !found {
+				value, found = v, true
+			} else {
+				value = f2pPathMerge(value, v)
+			}
+		}
+		// Retain the nominal command-field source even on a zero-valued params
+		// field; this also preserves the existing direct-field negative controls.
+		if base.typ == "FrontmatterParams" && (name == "Print" || name == "Edit" || name == "Delete") {
+			value.flag = true
+		}
+		return value
+	}
+	expression = func(e ast.Expr) f2pPathValue {
+		switch e := e.(type) {
+		case *ast.Ident:
+			v := env[e.Name]
+			if v.typ == "" {
+				v.typ = fn.types[e.Name]
+			}
+			return v
+		case *ast.BasicLit:
+			return f2pPathValue{known: true}
+		case *ast.ParenExpr:
+			return expression(e.X)
+		case *ast.UnaryExpr:
+			if e.Op == token.AND {
+				if star, ok := f2pUnparen(e.X).(*ast.StarExpr); ok {
+					return expression(star.X)
+				}
+				value := expression(e.X)
+				value.pointer = true
+				return value
+			}
+			return expression(e.X)
+		case *ast.StarExpr:
+			return f2pCopyValue(expression(e.X))
+		case *ast.SelectorExpr:
+			return field(expression(e.X), e.Sel.Name)
+		case *ast.BinaryExpr:
+			if identity := f2pIdentityOperand(e); identity != nil {
+				return expression(identity)
+			}
+			v := f2pPathMerge(expression(e.X), expression(e.Y))
+			v.loaded = false
+			return v
+		case *ast.IndexExpr:
+			return f2pPathMerge(expression(e.X), expression(e.Index))
+		case *ast.CallExpr:
+			values := call(e)
+			if len(values) > 0 {
+				return values[0]
+			}
+		case *ast.FuncLit:
+			return f2pPathValue{closures: []*f2pPathClosure{{literal: e, parent: fn, env: env}}}
+		case *ast.CompositeLit:
+			typ := m.expressionType(fn, e)
+			object := &f2pPathObject{typ: typ, fields: map[string]f2pPathValue{}}
+			object.root = object
+			for i, element := range e.Elts {
+				name := ""
+				value := element
+				if kv, ok := element.(*ast.KeyValueExpr); ok {
+					if id, ok := kv.Key.(*ast.Ident); ok {
+						name = id.Name
+					}
+					value = kv.Value
+				} else if i < len(m.fieldOrder[typ]) {
+					name = m.fieldOrder[typ][i]
+				}
+				object.fields[name] = expression(value)
+			}
+			return f2pPathValue{known: true, typ: typ, objects: []*f2pPathObject{object}}
+		}
+		return f2pPathValue{}
+	}
+	call = func(c *ast.CallExpr) []f2pPathValue {
+		args := make([]f2pPathValue, len(c.Args))
+		for i, arg := range c.Args {
+			args[i] = expression(arg)
+		}
+
+		if typ, pointer := m.conversion(c.Fun); typ != "" && len(args) == 1 {
+			value := args[0]
+			if len(value.objects) > 0 && !m.sameLayout(value.typ, typ) {
+				return nil
+			}
+			value.typ = typ
+			value.pointer = pointer
+			value.views = map[*f2pPathObject]string{}
+			for _, object := range value.objects {
+				value.views[f2pObjectRoot(object)] = typ
+			}
+			if !pointer {
+				value = f2pCopyValue(value)
+			}
+			return []f2pPathValue{value}
+		}
+		ref, ok := describeCall(m.fset, fn.imports, c)
+		if !ok {
+			return nil
+		}
+		if ref.pkg == "frontmatter" && len(args) > 0 && capability && (ref.name == "HasFrontmatter" || ref.name == "Parse" || ref.name == "SetKey" || ref.name == "DeleteKey") && !args[0].loaded {
+			a.unloaded = append(a.unloaded, fmt.Sprintf("contents at %s:%d do not originate from the pre-operation GetContents result for the dispatched context", relPath(fn.file), ref.line))
+		}
+		if ref.pkg == "frontmatter" && len(args) > 0 && capability && (ref.name == "HasFrontmatter" || ref.name == "Parse" || ref.name == "SetKey" || ref.name == "DeleteKey") && args[0].known && !args[0].owned {
+			a.contents = append(a.contents, fmt.Sprintf("content input at %s:%d is not owned by the invoked operation instance", relPath(fn.file), ref.line))
+		}
+		if ref.pkg == "" && ref.name == "SetContents" && capability && len(args) >= 2 {
+			receiver := f2pPathValue{}
+			if sel, ok := c.Fun.(*ast.SelectorExpr); ok {
+				receiver = expression(sel.X)
+			}
+			if receiver.known && !receiver.writer {
+				a.manager = append(a.manager, fmt.Sprintf("write manager at %s:%d is not owned by the invoked operation instance", relPath(fn.file), ref.line))
+			}
+			for _, arg := range args[:2] {
+				if arg.known && !arg.owned {
+					a.identity = append(a.identity, fmt.Sprintf("write identity at %s:%d is not owned by the invoked operation instance", relPath(fn.file), ref.line))
+				}
+			}
+		}
+		if ref.pkg == "" && ref.name == "GetContents" {
+			return []f2pPathValue{{known: true, loaded: !capability}, {known: true}}
+		}
+		if ref.pkg == "" && (ref.name == "Path" || ref.name == "DefaultName") {
+			return []f2pPathValue{{known: true}, {known: true}}
+		}
+		var outputs []f2pPathValue
+		join := func(values []f2pPathValue) {
+			for i, v := range values {
+				if i >= len(outputs) {
+					outputs = append(outputs, v)
+				} else {
+					outputs[i] = f2pPathMerge(outputs[i], v)
+				}
+			}
+		}
+		invokeClosure := func(v f2pPathValue) bool {
+			for _, closure := range v.closures {
+				var target *funcInfo
+				for _, candidate := range m.funcs {
+					if candidate.body == closure.literal.Body {
+						target = candidate
+						break
+					}
+				}
+				if target == nil {
+					target = collectFunc(m.fset, closure.parent.imports, closure.parent.file, &ast.FuncDecl{Name: &ast.Ident{Name: "f2pClosure"}, Type: closure.literal.Type, Body: closure.literal.Body})
+					target.parent = closure.parent
+					for name, typ := range closure.parent.types {
+						if target.types[name] == "" {
+							target.types[name] = typ
+						}
+					}
+				}
+				captured := closure.env
+				previousContexts, previousWriters := a.contexts, a.writers
+				if v.closureOwned {
+					for _, cap := range allCapabilities {
+						if target.operationType() != "" && m.exclusiveCapability(target, cap) {
+							if a.receivers[cap] == nil {
+								a.receivers[cap] = map[*f2pPathObject]bool{}
+							}
+							for _, root := range v.closureOwners {
+								a.receivers[cap][root] = true
+							}
+						}
+					}
+					a.contexts, a.writers = map[*f2pPathObject]bool{}, map[*f2pPathObject]bool{}
+					for object, allowed := range previousContexts {
+						a.contexts[object] = allowed
+					}
+					for object, allowed := range previousWriters {
+						a.writers[object] = allowed
+					}
+					for root := range f2pDestinations(captured) {
+						a.contexts[root], a.writers[root] = true, true
+					}
+					// Captures installed on the active operation are its owned state.
+					captured = f2pPathEnv(captured)
+					for name, value := range captured {
+						value.owned, value.writer = true, true
+						captured[name] = value
+					}
+				}
+				join(a.function(target, args, f2pPathValue{}, captured, capability, depth+1))
+				a.contexts, a.writers = previousContexts, previousWriters
+			}
+			return len(v.closures) > 0
+		}
+		if ref.pkg == "" {
+			if id, ok := c.Fun.(*ast.Ident); ok {
+				if invokeClosure(env[id.Name]) {
+					return outputs
+				}
+				if target := m.functionByName(id.Name); target != nil {
+					return a.function(target, args, f2pPathValue{}, nil, capability, depth+1)
+				}
+			} else if sel, ok := c.Fun.(*ast.SelectorExpr); ok {
+				recv := expression(sel.X)
+				if invokeClosure(field(recv, sel.Sel.Name)) {
+					return outputs
+				}
+				for _, target := range m.byName[ref.name] {
+					if target.parent != nil || target.recvType == "" {
+						continue
+					}
+					if len(recv.objects) > 0 {
+						for _, object := range recv.objects {
+							view := object.typ
+							if typ := recv.views[f2pObjectRoot(object)]; typ != "" {
+								view = typ
+							}
+							if m.nominal(view) == target.recvType {
+								join(a.function(target, args, f2pPathValue{known: true, pointer: recv.pointer, typ: target.recvType, views: map[*f2pPathObject]string{f2pObjectRoot(object): target.recvType}, objects: []*f2pPathObject{object}}, nil, capability, depth+1))
+							}
+						}
+					} else if recv.typ == target.recvType {
+						join(a.function(target, args, recv, nil, capability, depth+1))
+					}
+				}
+				if len(outputs) > 0 {
+					return outputs
+				}
+			}
+		}
+		// Unknown calls can propagate selection dependency, but cannot manufacture
+		// loaded-content provenance. Type conversions preserve object/closure values.
+		if ref.pkg == "" && len(args) == 1 && (m.fieldTypes[ref.name] != nil || len(args[0].closures) > 0) {
+			return args
+		}
+		v := f2pPathValue{}
+		for _, arg := range args {
+			v.flag = v.flag || arg.flag
+		}
+		return []f2pPathValue{v}
+	}
+	addressable = func(e ast.Expr) f2pPathValue {
+		switch value := e.(type) {
+		case *ast.ParenExpr:
+			return addressable(value.X)
+		case *ast.StarExpr:
+			return expression(value.X)
+		default:
+			return expression(e)
+		}
+	}
+	assign = func(lhs ast.Expr, value f2pPathValue) {
+		if !value.pointer && len(value.objects) > 0 {
+			value = f2pCopyValue(value)
+		}
+		switch lhs := lhs.(type) {
+		case *ast.Ident:
+			if lhs.Name != "_" {
+				env[lhs.Name] = value
+			}
+		case *ast.SelectorExpr:
+			for _, object := range addressable(lhs.X).objects {
+				value.reassigned = capability
+				object.fields[lhs.Sel.Name] = value
+			}
+		}
+	}
+	condition := func(e ast.Expr, relevant bool) {
+		if e != nil && expression(e).flag && capability && relevant {
+			a.selection = append(a.selection, fmt.Sprintf("capability condition at %s:%d depends on command selection flags", relPath(fn.file), m.fset.Position(e.Pos()).Line))
+		}
+	}
+	block = func(statements []ast.Stmt, scope map[string]f2pPathValue) bool {
+		previous := env
+		env = scope
+		defer func() { env = previous }()
+		for _, statement := range statements {
+			switch s := statement.(type) {
+			case *ast.AssignStmt:
+				var values []f2pPathValue
+				if len(s.Rhs) == 1 {
+					if c, ok := s.Rhs[0].(*ast.CallExpr); ok {
+						values = call(c)
+					}
+				}
+				if values == nil {
+					for _, rhs := range s.Rhs {
+						values = append(values, expression(rhs))
+					}
+				}
+				for i, lhs := range s.Lhs {
+					v := f2pPathValue{}
+					if i < len(values) {
+						v = values[i]
+					}
+					assign(lhs, v)
+				}
+			case *ast.DeclStmt:
+				if declaration, ok := s.Decl.(*ast.GenDecl); ok {
+					for _, spec := range declaration.Specs {
+						if v, ok := spec.(*ast.ValueSpec); ok {
+							var values []f2pPathValue
+							if len(v.Values) == 1 {
+								if c, ok := v.Values[0].(*ast.CallExpr); ok {
+									values = call(c)
+								}
+							}
+							if values == nil {
+								for _, value := range v.Values {
+									values = append(values, expression(value))
+								}
+							}
+							for i, name := range v.Names {
+								value := f2pPathValue{typ: fn.types[name.Name]}
+								if i < len(values) {
+									value = values[i]
+								}
+								assign(name, value)
+							}
+						}
+					}
+				}
+			case *ast.ExprStmt:
+				expression(s.X)
+			case *ast.ReturnStmt:
+				var values []f2pPathValue
+				if len(s.Results) == 1 {
+					if c, ok := s.Results[0].(*ast.CallExpr); ok {
+						values = call(c)
+					}
+				}
+				if values == nil {
+					for _, e := range s.Results {
+						values = append(values, expression(e))
+					}
+				}
+				mergeResults(values)
+				returnedHeaps = append(returnedHeaps, f2pBranchEnv(env))
+				return true
+			case *ast.BlockStmt:
+				if block(s.List, env) {
+					return true
+				}
+			case *ast.IfStmt:
+				if s.Init != nil {
+					block([]ast.Stmt{s.Init}, env)
+				}
+				condition(s.Cond, f2pSelectionWork(s.Body) || f2pSelectionWork(s.Else))
+				left, right := f2pBranchEnv(env), f2pBranchEnv(env)
+				leftDone := block(s.Body.List, left)
+				rightDone := false
+				if s.Else != nil {
+					rightDone = block([]ast.Stmt{s.Else}, right)
+				}
+				live := []map[string]f2pPathValue{}
+				if !leftDone {
+					live = append(live, left)
+				}
+				if !rightDone {
+					live = append(live, right)
+				}
+				if len(live) == 0 {
+					live = []map[string]f2pPathValue{left, right}
+				}
+				f2pCommitBranches(live, f2pDestinations(env))
+				if leftDone && rightDone {
+					return true
+				}
+				for name, v := range left {
+					if leftDone {
+						env[name] = right[name]
+					} else if rightDone {
+						env[name] = v
+					} else {
+						env[name] = f2pPathMerge(v, right[name])
+					}
+				}
+				for name, v := range right {
+					if _, ok := left[name]; !ok && !rightDone {
+						env[name] = v
+					}
+				}
+			case *ast.SwitchStmt:
+				if s.Init != nil {
+					block([]ast.Stmt{s.Init}, env)
+				}
+				relevant := false
+				for _, item := range s.Body.List {
+					relevant = relevant || f2pSelectionWork(item)
+				}
+				condition(s.Tag, relevant)
+				var branches []map[string]f2pPathValue
+				hasDefault := false
+				for _, item := range s.Body.List {
+					clause := item.(*ast.CaseClause)
+					if len(clause.List) == 0 {
+						hasDefault = true
+					}
+					for _, e := range clause.List {
+						condition(e, relevant)
+					}
+					branch := f2pBranchEnv(env)
+					if !block(clause.Body, branch) {
+						branches = append(branches, branch)
+					}
+				}
+				if !hasDefault {
+					branches = append(branches, f2pBranchEnv(env))
+				}
+				if len(branches) == 0 {
+					return true
+				}
+				f2pCommitBranches(branches, f2pDestinations(env))
+				for name := range env {
+					delete(env, name)
+				}
+				for i, branch := range branches {
+					for name, v := range branch {
+						if old, ok := env[name]; ok && i > 0 {
+							env[name] = f2pPathMerge(old, v)
+						} else {
+							env[name] = v
+						}
+					}
+				}
+			case *ast.ForStmt:
+				if s.Init != nil {
+					block([]ast.Stmt{s.Init}, env)
+				}
+				condition(s.Cond, f2pSelectionWork(s.Body) || f2pSelectionWork(s.Post))
+				block(s.Body.List, env)
+				if s.Post != nil {
+					block([]ast.Stmt{s.Post}, env)
+				}
+			case *ast.RangeStmt:
+				expression(s.X)
+				block(s.Body.List, env)
+			case *ast.DeferStmt:
+				call(s.Call)
+			}
+		}
+		return false
+	}
+	if !block(body.List, env) {
+		returnedHeaps = append(returnedHeaps, env)
+	}
+	if len(returnedHeaps) > 0 {
+		resultEnv := map[string]f2pPathValue{}
+		for i, value := range results {
+			resultEnv[fmt.Sprintf("$result%d", i)] = value
+		}
+		f2pCommitBranches(returnedHeaps, destinations, resultEnv)
+		for i := range results {
+			results[i] = resultEnv[fmt.Sprintf("$result%d", i)]
+		}
+	}
+	return results
+}
+
+func requireOperation(t *testing.T, m *f2pModel) string {
+	t.Helper()
+	owner := m.operationAbstractionType()
+	if owner == "" {
+		t.Fatal("no operation context exposing three explicit capabilities")
+	}
+	return owner
+}
+
+func isContentCall(c callRef, capability string) bool {
+	if c.pkg != "frontmatter" || len(c.args) == 0 {
+		return false
+	}
+	if c.name == "HasFrontmatter" {
+		return true
+	}
+	switch capability {
+	case printCapability:
+		return c.name == "Parse"
+	case editCapability:
+		return c.name == "SetKey"
+	case deleteCapability:
+		return c.name == "DeleteKey"
+	}
+	return false
+}
+
+func keyTransformClosures(t *testing.T, m *f2pModel) (map[*funcInfo]bool, map[*funcInfo]bool) {
+	t.Helper()
+	a, b := m.functionByName("SetKey"), m.functionByName("DeleteKey")
+	if a == nil || b == nil {
+		t.Fatal("exported key transforms are missing")
+	}
+	return m.closureSet(a), m.closureSet(b)
+}
+
+func union(a, b map[*funcInfo]bool) map[*funcInfo]bool {
+	out := map[*funcInfo]bool{}
+	for fn := range a {
+		out[fn] = true
+	}
+	for fn := range b {
+		out[fn] = true
+	}
+	return out
+}
+
+// origin follows local aliases, constructor arguments, field initializers and
+// helper parameters. It checks the actual content/write argument rather than
+// accepting an unrelated string-field read elsewhere in a capability.
+func (m *pkgModel) origin(fn *funcInfo, text, owner string, loaded bool, seen map[string]bool, ownedWriter ...bool) bool {
+	key := fmt.Sprintf("%p/%s/%t/%v", fn, text, loaded, ownedWriter)
+	if seen[key] {
+		return false
+	}
+	seen[key] = true
+	expression, err := parser.ParseExpr(text)
+	if err != nil {
+		return false
+	}
+	if paren, ok := expression.(*ast.ParenExpr); ok {
+		return m.origin(fn, exprString(m.fset, paren.X), owner, loaded, seen, ownedWriter...)
+	}
+	if field, ok := expression.(*ast.SelectorExpr); ok {
+		if fn.parent != nil {
+			root, _ := rootIdentName(field)
+			if !fn.locals[root] && !containsString(fn.params, root) {
+				if !loaded && fn.ownerType == owner {
+					return true
+				}
+				if m.origin(fn.parent, text, owner, loaded, copySeen(seen), ownedWriter...) {
+					return true
+				}
+			}
+		}
+		if !loaded && m.ownedType(m.expressionType(fn, field.X), owner, map[string]bool{}) {
+			return true
+		}
+		// A selected wrapper can own a writer alongside its shared context. Only
+		// manager provenance admits these sibling fields: content and note identity
+		// must still come from the shared context. The wrapper must already be a
+		// reachable operation method, and this must be an actual writer field.
+		if !loaded && len(ownedWriter) > 0 && ownedWriter[0] {
+			typ := m.expressionType(fn, field.X)
+			fieldType := m.fieldTypes[typ][field.Sel.Name]
+			isWriter := containsString(m.interfaces[fieldType], "SetContents") || fieldType == "obsidian.NoteManager"
+			if isWriter && fn.operationType() == typ {
+				for _, operation := range m.operationMethods(owner) {
+					if operation == fn {
+						return true
+					}
+				}
+			}
+		}
+		typ := m.expressionType(fn, field.X)
+		if loaded {
+			// Trace the corresponding field, not any arbitrary string in the context.
+			for _, parent := range m.funcs {
+				found := false
+				ast.Inspect(parent.body, func(n ast.Node) bool {
+					if _, closure := n.(*ast.FuncLit); closure {
+						return false
+					}
+					switch v := n.(type) {
+					case *ast.CompositeLit:
+						if m.expressionType(parent, v) != typ {
+							break
+						}
+						for index, elt := range v.Elts {
+							if kv, ok := elt.(*ast.KeyValueExpr); ok {
+								if id, ok := kv.Key.(*ast.Ident); ok && id.Name == field.Sel.Name {
+									if m.origin(parent, exprString(m.fset, kv.Value), owner, true, copySeen(seen), ownedWriter...) {
+										found = true
+									}
+								}
+							} else if index < len(m.fieldOrder[typ]) && m.fieldOrder[typ][index] == field.Sel.Name {
+								if value, ok := elt.(ast.Expr); ok && m.origin(parent, exprString(m.fset, value), owner, true, copySeen(seen), ownedWriter...) {
+									found = true
+								}
+							}
+						}
+					case *ast.AssignStmt:
+						for i, lhs := range v.Lhs {
+							sel, ok := lhs.(*ast.SelectorExpr)
+							if ok && sel.Sel.Name == field.Sel.Name && m.expressionType(parent, sel.X) == typ && i < len(v.Rhs) {
+								if m.origin(parent, exprString(m.fset, v.Rhs[i]), owner, true, copySeen(seen), ownedWriter...) {
+									found = true
+								}
+							}
+						}
+					}
+					return !found
+				})
+				if found {
+					return true
+				}
+			}
+		}
+	}
+	id, ok := expression.(*ast.Ident)
+	if !ok {
+		return false
+	}
+	// Local aliases and the first result of GetContents (never its error result).
+	found := false
+	ast.Inspect(fn.body, func(n ast.Node) bool {
+		if _, closure := n.(*ast.FuncLit); closure {
+			return false
+		}
+		check := func(names []ast.Expr, values []ast.Expr) {
+			for i, lhs := range names {
+				name, ok := lhs.(*ast.Ident)
+				if !ok || name.Name != id.Name || i >= len(values) {
+					continue
+				}
+				if call, ok := values[i].(*ast.CallExpr); ok {
+					if callee, _ := calleeName(call.Fun); loaded && callee == "GetContents" && i == 0 && fn.operationType() == "" {
+						found = true
+						continue
+					}
+				}
+				if m.origin(fn, exprString(m.fset, values[i]), owner, loaded, copySeen(seen), ownedWriter...) {
+					found = true
+				}
+			}
+		}
+		switch n := n.(type) {
+		case *ast.AssignStmt:
+			check(n.Lhs, n.Rhs)
+		case *ast.ValueSpec:
+			names := []ast.Expr{}
+			for _, name := range n.Names {
+				names = append(names, name)
+			}
+			check(names, n.Values)
+		}
+		return !found
+	})
+	if found {
+		return true
+	}
+	for index, param := range fn.params {
+		if param != id.Name {
+			continue
+		}
+		matchedWriterCall := false
+		for _, caller := range m.funcs {
+			for _, call := range caller.calls {
+				if call.pkg != "" || call.name != fn.name || index >= len(call.args) {
+					continue
+				}
+				matches := false
+				for _, target := range m.callees(caller) {
+					if target == fn {
+						matches = true
+					}
+				}
+				if !matches {
+					continue
+				}
+				valid := m.origin(caller, call.args[index].text, owner, loaded, copySeen(seen), ownedWriter...)
+				if len(ownedWriter) > 0 && ownedWriter[0] {
+					// A helper shared by owned and external managers must not be
+					// accepted merely because one of its call sites is owned.
+					if !valid {
+						return false
+					}
+					matchedWriterCall = true
+				} else if valid {
+					return true
+				}
+			}
+		}
+		if matchedWriterCall {
+			return true
+		}
+	}
+	if fn.parent != nil && !fn.locals[id.Name] && !containsString(fn.params, id.Name) {
+		if !loaded && fn.ownerType == owner {
+			return true
+		}
+		return m.origin(fn.parent, text, owner, loaded, copySeen(seen), ownedWriter...)
+	}
+	return false
+}
+
+func (m *pkgModel) ownedType(typ, owner string, seen map[string]bool) bool {
+	if typ == owner {
+		return true
+	}
+	if seen[owner] {
+		return false
+	}
+	seen[owner] = true
+	for _, fieldType := range m.fieldTypes[owner] {
+		if m.ownedType(typ, fieldType, seen) {
+			return true
+		}
+	}
+	return false
+}
+
+func copySeen(in map[string]bool) map[string]bool {
+	out := map[string]bool{}
+	for key, value := range in {
+		out[key] = value
+	}
+	return out
+}
+
+func containsString(values []string, want string) bool {
+	for _, value := range values {
+		if value == want {
+			return true
+		}
+	}
+	return false
+}
+
+// Boolean modes are operation-specific constants supplied by the two exported
+// transforms and used to choose creation/rejection/mutation in a shared helper.
+// A data-derived boolean, a callback parameter, an unused boolean, and ordinary
+// command selection are deliberately outside this check. This remains a local
+// AST analysis, not a complete Go data-flow analysis.
+func (m *pkgModel) keyTransformBooleanModes() []string {
+	observed := [2]map[*funcInfo]map[string]int{}
+	for index, name := range []string{"SetKey", "DeleteKey"} {
+		observed[index] = map[*funcInfo]map[string]int{}
+		entry := m.functionByName(name)
+		if entry == nil {
+			continue
+		}
+		visited := map[string]bool{}
+		var visit func(*funcInfo, map[string]int)
+		visit = func(fn *funcInfo, values map[string]int) {
+			state := fn.id
+			for _, param := range fn.params {
+				state += fmt.Sprintf("/%s=%d", param, values[param])
+			}
+			if visited[state] {
+				return
+			}
+			visited[state] = true
+			if observed[index][fn] == nil {
+				observed[index][fn] = map[string]int{}
+			}
+			for _, param := range fn.params {
+				if fn.types[param] == "bool" {
+					value := values[param]
+					if value == 0 {
+						value = 4
+					}
+					observed[index][fn][param] |= value
+				}
+			}
+			for _, call := range fn.calls {
+				if call.pkg != "" {
+					continue
+				}
+				for _, target := range m.byName[call.name] {
+					if target.parent != nil || target.recvType != "" || call.receiver != nil {
+						continue
+					}
+					next := map[string]int{}
+					for i, param := range target.params {
+						if target.types[param] != "bool" || i >= len(call.args) {
+							continue
+						}
+						expression, err := parser.ParseExpr(call.args[i].text)
+						if err == nil {
+							next[param] = modeBoolValue(fn, expression, values, map[string]bool{})
+						}
+					}
+					visit(target, next)
+				}
+			}
+		}
+		visit(entry, map[string]int{})
+	}
+	var issues []string
+	for fn, params := range observed[0] {
+		for param, left := range params {
+			right := observed[1][fn][param]
+			if !((left == 1 && right == 2) || (left == 2 && right == 1)) {
+				continue
+			}
+			ast.Inspect(fn.body, func(node ast.Node) bool {
+				if _, nested := node.(*ast.FuncLit); nested {
+					return false
+				}
+				branch, ok := node.(*ast.IfStmt)
+				if !ok || !modeDependsOn(fn, branch.Cond, param, map[string]bool{}) {
+					return true
+				}
+				semantic := false
+				ast.Inspect(branch, func(inner ast.Node) bool {
+					switch value := inner.(type) {
+					case *ast.Ident:
+						if value.Name == "NoFrontmatterError" {
+							semantic = true
+						}
+					case *ast.BasicLit:
+						if value.Kind == token.STRING {
+							if s, err := strconv.Unquote(value.Value); err == nil && s == "note does not contain frontmatter" {
+								semantic = true
+							}
+						}
+					case *ast.CompositeLit:
+						if _, ok := value.Type.(*ast.MapType); ok {
+							semantic = true
+						}
+					case *ast.CallExpr:
+						if id, ok := value.Fun.(*ast.Ident); ok && id.Name == "delete" {
+							semantic = true
+						}
+						if id, ok := value.Fun.(*ast.Ident); ok && id.Name == "make" && len(value.Args) > 0 {
+							if _, ok := value.Args[0].(*ast.MapType); ok {
+								semantic = true
+							}
+						}
+					case *ast.AssignStmt:
+						for _, lhs := range value.Lhs {
+							if _, ok := lhs.(*ast.IndexExpr); ok {
+								semantic = true
+							}
+						}
+					}
+					return true
+				})
+				if semantic {
+					issues = append(issues, fmt.Sprintf("%s:%d uses boolean %s to dispatch key-transform semantics; SetKey and DeleteKey supply opposite operation constants", relPath(fn.file), m.fset.Position(branch.Pos()).Line, param))
+				}
+				return true
+			})
+		}
+	}
+	sort.Strings(issues)
+	return issues
+}
+
+// Only a unique assignment is followed. Ambiguous writes stay unknown rather
+// than turning data-dependent branches into presumed operation flags.
+func modeAlias(fn *funcInfo, name string) ast.Expr {
+	var found ast.Expr
+	count := 0
+	ast.Inspect(fn.body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		var names, values []ast.Expr
+		switch value := node.(type) {
+		case *ast.AssignStmt:
+			names, values = value.Lhs, value.Rhs
+		case *ast.ValueSpec:
+			for _, id := range value.Names {
+				names = append(names, id)
+			}
+			values = value.Values
+		}
+		for i, lhs := range names {
+			if id, ok := lhs.(*ast.Ident); ok && id.Name == name {
+				count++
+				if i < len(values) {
+					found = values[i]
+				}
+			}
+		}
+		return true
+	})
+	if count == 1 {
+		return found
+	}
+	return nil
+}
+
+// 1=false, 2=true, 4=unknown. Unknown includes HasFrontmatter and comparisons
+// against content, so factual booleans cannot be mistaken for operation modes.
+func modeBoolValue(fn *funcInfo, expression ast.Expr, values map[string]int, seen map[string]bool) int {
+	switch value := expression.(type) {
+	case *ast.ParenExpr:
+		return modeBoolValue(fn, value.X, values, seen)
+	case *ast.Ident:
+		if value.Name == "true" {
+			return 2
+		}
+		if value.Name == "false" {
+			return 1
+		}
+		if seen[value.Name] {
+			return 4
+		}
+		seen[value.Name] = true
+		if v := values[value.Name]; v != 0 {
+			return v
+		}
+		if alias := modeAlias(fn, value.Name); alias != nil {
+			return modeBoolValue(fn, alias, values, seen)
+		}
+	case *ast.UnaryExpr:
+		if value.Op == token.NOT {
+			switch modeBoolValue(fn, value.X, values, seen) {
+			case 1:
+				return 2
+			case 2:
+				return 1
+			}
+		}
+	}
+	return 4
+}
+
+func modeDependsOn(fn *funcInfo, expression ast.Expr, param string, seen map[string]bool) bool {
+	found := false
+	ast.Inspect(expression, func(node ast.Node) bool {
+		id, ok := node.(*ast.Ident)
+		if !ok {
+			return !found
+		}
+		if id.Name == param {
+			found = true
+			return false
+		}
+		if !seen[id.Name] {
+			seen[id.Name] = true
+			if alias := modeAlias(fn, id.Name); alias != nil && modeDependsOn(fn, alias, param, seen) {
+				found = true
+			}
+		}
+		return !found
+	})
+	return found
+}
diff --git a/tests/f2p/p2p_loaded_snapshot_test.go b/tests/f2p/p2p_loaded_snapshot_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..68290bc25a92091d1013c87a65d9772c300c0dae
--- /dev/null
+++ b/tests/f2p/p2p_loaded_snapshot_test.go
@@ -0,0 +1,77 @@
+package f2p
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/Yakitrak/notesmd-cli/pkg/actions"
+	"github.com/Yakitrak/notesmd-cli/pkg/obsidian"
+)
+
+// Embedding implements unused methods without copying or relying on candidate mocks.
+// A call to an unrelated method deliberately fails instead of silently succeeding.
+type snapshotNoteRecorder struct {
+	obsidian.NoteManager
+	contents string
+	readErr  error
+	reads    int
+}
+
+func (n *snapshotNoteRecorder) GetContents(string, string) (string, error) {
+	n.reads++
+	return n.contents, n.readErr
+}
+
+func (n *snapshotNoteRecorder) SetContents(string, string, string) error { return nil }
+
+type snapshotVaultRecorder struct{ obsidian.VaultManager }
+
+func (*snapshotVaultRecorder) DefaultName() (string, error) { return "snapshot-vault", nil }
+func (*snapshotVaultRecorder) Path() (string, error)        { return "/snapshot-vault", nil }
+
+var (
+	_ obsidian.NoteManager  = (*snapshotNoteRecorder)(nil)
+	_ obsidian.VaultManager = (*snapshotVaultRecorder)(nil)
+)
+
+// This is a baseline-PASS invariant, independent of operation-context discovery.
+// Observe calls through the public action so an initial read in a helper is legal.
+// Inputs cover each selected path without adding outcome/ownership assertions.
+func TestP2PFrontmatterOperationPathsDoNotRereadContents(t *testing.T) {
+	inputs := []struct {
+		contents string
+		readErr  error
+	}{
+		{"---\ntitle: Old\nkeep: retained\n---\nBody", nil},
+		{"---\n{}\n---\nBody", nil},
+		{"---\ntitle: Old\n---\nBody", nil},
+		{"Body", nil},
+		{"---\ninvalid: [unclosed\n---\nBody", nil},
+		{"", errors.New("snapshot read failure")},
+	}
+	for mask := 0; mask < 8; mask++ {
+		for variant := 0; variant < 3; variant++ {
+			for inputIndex, input := range inputs {
+				note := &snapshotNoteRecorder{contents: input.contents, readErr: input.readErr}
+				params := actions.FrontmatterParams{
+					NoteName: "folder/snapshot",
+					Print:    mask&1 != 0,
+					Edit:     mask&2 != 0,
+					Delete:   mask&4 != 0,
+					Key:      "title",
+					Value:    "New",
+				}
+				if variant == 1 {
+					params.Key = ""
+				}
+				if variant == 2 {
+					params.Value = ""
+				}
+				_, _ = actions.Frontmatter(&snapshotVaultRecorder{}, note, params)
+				if note.reads > 1 {
+					t.Errorf("selection=%d variant=%d input=%d rereads the note: GetContents called %d times; use the loaded snapshot", mask, variant, inputIndex, note.reads)
+				}
+			}
+		}
+	}
+}
diff --git a/tests/f2p/run_f2p.py b/tests/f2p/run_f2p.py
new file mode 100644
index 0000000000000000000000000000000000000000..5bf88ff856c035222b482653999e012869850048
--- /dev/null
+++ b/tests/f2p/run_f2p.py
@@ -0,0 +1,646 @@
+#!/usr/bin/env python3
+"""Aggregate JUnit runner for the frontmatter consolidation verification.
+
+The runner executes exactly two frozen selector sets against the repository it
+is started in and writes one conventional JUnit report:
+
+* the frozen P2P selectors, delegated to the frozen node runner
+  ``tests/p2p/run_p2p.py`` (which owns the authoritative P2P selector list and
+  its ``go test`` invocation), and
+* the F2P structural selectors of ``tests/f2p/f2p_structural_test.go`` embedded
+  below, each executed as its own ``go test -run ^<leaf>$`` invocation.
+
+Every node is reported from its own collected result: a node that never reports
+a result (compile failure, execution failure, timeout, crash) is reported as an
+``error`` and is never turned into an assertion failure. The runner installs
+nothing, downloads nothing and never touches the network; it only uses the Go
+toolchain and the files already present in the environment image.
+
+Build products are executed, so the runner works inside an execution-capable
+directory: ``VERIFIER_EXEC_DIR`` when the verifier provides one (this runner
+declares ``require_exec``), otherwise ``TMPDIR``. When the image's ``GOFLAGS``
+``-exec`` wrapper provably cannot execute anything while plain execution works,
+the wrapper is dropped for this run so that a sandbox-permission defect is
+reported as a real node result instead of a spurious infrastructure error.
+"""
+
+import argparse
+import atexit
+import glob
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+sys.dont_write_bytecode = True
+
+DEFAULT_NODE_TIMEOUT = 120
+P2P_NODE_TIMEOUT = 120
+P2P_RUNNER_RELATIVE_PATH = "tests/p2p/run_p2p.py"
+
+# Frozen F2P selectors ("<repo-relative test file path>::<exact top-level
+# leaf>"). This list is the authoritative run set of this runner and is kept in
+# sync with the declared F2P gates.
+F2P_SELECTORS = ['tests/f2p/f2p_structural_test.go::TestF2PExplicitCapabilitiesShareOneOperationContext', 'tests/f2p/f2p_structural_test.go::TestF2PCapabilitiesUseOwnedContents', 'tests/f2p/f2p_structural_test.go::TestF2POperationReceivesAlreadyLoadedContents', 'tests/f2p/f2p_structural_test.go::TestF2PWritesUseOwnedNoteIdentity', 'tests/f2p/f2p_structural_test.go::TestF2PWritesUseOwnedNoteManager', 'tests/f2p/f2p_structural_test.go::TestF2PFrontmatterDispatchUsesOperationCapabilities', 'tests/f2p/f2p_structural_test.go::TestF2PIndividualCapabilitiesDoNotDispatchSelectionFlags', 'tests/f2p/f2p_structural_test.go::TestF2POperationsDoNotReexpandContextBundles', 'tests/f2p/f2p_structural_test.go::TestF2PKeyTransformsShareSerialization', 'tests/f2p/f2p_structural_test.go::TestF2PKeyTransformsShareReconstruction', 'tests/f2p/f2p_structural_test.go::TestF2PKeyTransformsUseSharedSerializationResult', 'tests/f2p/f2p_structural_test.go::TestF2PKeyTransformsUseSharedReconstructionResult']
+
+SELECTOR_PATTERN = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_./\-]*::[A-Za-z0-9_]+$")
+PLACEHOLDER_PATTERN = re.compile(r"^\{[A-Za-z0-9_]+\}$")
+
+GO_BINARY_CANDIDATES = (
+    "/opt/envpipe/runtime/bin/go",
+    "/usr/local/go/bin/go",
+    "/usr/local/bin/go",
+    "/usr/bin/go",
+    "/opt/go/bin/go",
+    "/home/agent/.local/share/mise/shims/go",
+)
+
+GO_GLOB_CANDIDATES = (
+    "/home/*/.local/share/mise/installs/go/*/bin/go",
+    "/root/.local/share/mise/installs/go/*/bin/go",
+)
+
+SELECTION_ENV_VARS = (
+    "P2P_SELECT",
+    "P2P_SELECT_FILE",
+    "P2P_SELECTION",
+    "P2P_SELECTION_FILE",
+    "VERIFIER_P2P_SELECT",
+    "VERIFIER_P2P_SELECT_FILE",
+    "VERIFIER_P2P_SELECTORS",
+)
+
+
+def find_repo_root():
+    """Locate the repository root from this file or the current directory."""
+    here = Path(__file__).resolve()
+    candidates = list(here.parents[:5])
+    cwd = Path.cwd().resolve()
+    candidates.append(cwd)
+    candidates.extend(list(cwd.parents)[:5])
+    for candidate in candidates:
+        if (candidate / "go.mod").is_file() and (candidate / P2P_RUNNER_RELATIVE_PATH).is_file():
+            return candidate
+    for candidate in candidates:
+        if (candidate / "go.mod").is_file():
+            return candidate
+    return cwd
+
+
+def cleanup_bytecode_artifacts():
+    """Remove bytecode caches this runner could have created; never raises."""
+    try:
+        runner_dir = Path(__file__).resolve().parent
+    except (OSError, ValueError):
+        return
+    try:
+        for cache_dir in sorted(runner_dir.rglob("__pycache__"), reverse=True):
+            shutil.rmtree(cache_dir, ignore_errors=True)
+        for bytecode in runner_dir.rglob("*.pyc"):
+            try:
+                bytecode.unlink()
+            except OSError:
+                pass
+    except OSError:
+        pass
+
+
+atexit.register(cleanup_bytecode_artifacts)
+
+
+def _make_world_accessible(path):
+    try:
+        os.chmod(str(path), 0o777)
+    except OSError:
+        pass
+
+
+def _usable_directory(path):
+    try:
+        path.mkdir(parents=True, exist_ok=True)
+    except OSError:
+        return False
+    _make_world_accessible(path)
+    return os.access(str(path), os.W_OK | os.X_OK)
+
+
+def _exec_wrapper(environment):
+    match = re.search(r"-exec=(\S+)", environment.get("GOFLAGS", ""))
+    if not match:
+        return None
+    wrapper = match.group(1)
+    if os.path.isfile(wrapper) and os.access(wrapper, os.X_OK):
+        return wrapper
+    return None
+
+
+def _probe_execution(root, wrapper):
+    """Return True when a file created under root can actually be executed."""
+    try:
+        probe_dir = Path(tempfile.mkdtemp(prefix="f2p-exec-probe-", dir=str(root)))
+    except OSError:
+        return False
+    try:
+        probe = probe_dir / "probe.sh"
+        probe.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
+        os.chmod(str(probe), 0o755)
+        command = [wrapper, str(probe)] if wrapper else [str(probe)]
+        completed = subprocess.run(
+            command,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            timeout=60,
+        )
+        return completed.returncode == 0
+    except (OSError, subprocess.SubprocessError):
+        return False
+    finally:
+        shutil.rmtree(str(probe_dir), ignore_errors=True)
+
+
+def pick_exec_root(environment):
+    """Pick the execution-capable directory for build products."""
+    candidates = []
+    for name in ("VERIFIER_EXEC_DIR", "VERIFIER_PREPARATION_DIR"):
+        value = environment.get(name)
+        if value:
+            candidates.append((name, Path(value)))
+    for name in ("TMPDIR", "TEMP", "TMP"):
+        value = environment.get(name)
+        if value:
+            candidates.append((name, Path(value)))
+    candidates.append(("tempfile.gettempdir", Path(tempfile.gettempdir())))
+    seen = set()
+    for name, candidate in candidates:
+        key = str(candidate)
+        if key in seen:
+            continue
+        seen.add(key)
+        if _usable_directory(candidate):
+            return candidate, name
+    fallback = Path(tempfile.mkdtemp(prefix="f2p-run-"))
+    _make_world_accessible(fallback)
+    return fallback, "mkdtemp"
+
+
+def find_go_binary(environment):
+    """Locate the in-image Go toolchain; never downloads or installs anything."""
+    found = shutil.which("go", path=environment.get("PATH"))
+    if found:
+        return found
+    candidates = list(GO_BINARY_CANDIDATES)
+    for pattern in GO_GLOB_CANDIDATES:
+        candidates.extend(sorted(glob.glob(pattern), reverse=True))
+    for candidate in candidates:
+        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    return "go"
+
+
+def _writable_directory(path):
+    try:
+        path.mkdir(parents=True, exist_ok=True)
+    except OSError:
+        return False
+    return os.access(str(path), os.W_OK | os.X_OK)
+
+
+def prepare_environment(work_root, go_binary, drop_exec_wrapper=False):
+    """Return a go-friendly environment without touching the network."""
+    environment = dict(os.environ)
+    environment["PYTHONDONTWRITEBYTECODE"] = "1"
+    tmp_dir = work_root / "tmp"
+    if _writable_directory(tmp_dir):
+        _make_world_accessible(tmp_dir)
+        environment["TMPDIR"] = str(tmp_dir)
+    build_tmp = work_root / "go-build-tmp"
+    if _writable_directory(build_tmp):
+        _make_world_accessible(build_tmp)
+        environment["GOTMPDIR"] = str(build_tmp)
+    cache = environment.get("GOCACHE")
+    if not cache or not _writable_directory(Path(cache)):
+        fallback = work_root / "gocache"
+        if _writable_directory(fallback):
+            environment["GOCACHE"] = str(fallback)
+    if drop_exec_wrapper:
+        flags = environment.get("GOFLAGS", "")
+        environment["GOFLAGS"] = re.sub(r"-exec=\S+\s*", "", flags).strip()
+    if go_binary and os.path.dirname(go_binary):
+        go_dir = os.path.dirname(go_binary)
+        path_parts = [part for part in environment.get("PATH", "").split(os.pathsep) if part]
+        if go_dir not in path_parts:
+            environment["PATH"] = os.pathsep.join([go_dir] + path_parts)
+    return environment
+
+
+def parse_go_test_json(stdout, leaf):
+    """Return (status, leaf_output, package_output) from ``go test -json``."""
+    status = None
+    leaf_output = []
+    package_output = []
+    for raw_line in stdout.splitlines():
+        line = raw_line.strip()
+        if not line.startswith("{"):
+            if line:
+                package_output.append(line)
+            continue
+        try:
+            event = json.loads(line)
+        except json.JSONDecodeError:
+            package_output.append(line)
+            continue
+        action = event.get("Action")
+        test = event.get("Test")
+        output = event.get("Output", "")
+        if test == leaf or (isinstance(test, str) and test.startswith(leaf + "/")):
+            if action == "output":
+                leaf_output.append(output.rstrip("\n"))
+            elif test == leaf and action in ("pass", "fail", "skip"):
+                status = action
+        elif test is None:
+            if action == "output" and output.strip():
+                package_output.append(output.rstrip("\n"))
+    return status, leaf_output, package_output
+
+
+def run_go_selector(repo_root, selector, node_timeout, environment, go_binary):
+    path, leaf = selector.split("::", 1)
+    result = {
+        "selector": selector,
+        "path": path,
+        "leaf": leaf,
+        "role": "F2P",
+        "status": "error",
+        "message": "",
+        "output": "",
+        "duration": 0.0,
+    }
+
+    test_file = repo_root / path
+    if not test_file.is_file():
+        result["message"] = "collection error: test file %s is missing from the repository" % path
+        return result
+    package_dir = test_file.parent
+    try:
+        package_arg = "./" + str(package_dir.relative_to(repo_root)).replace(os.sep, "/")
+    except ValueError:
+        result["message"] = "collection error: test file %s is outside the repository root" % path
+        return result
+
+    command = [
+        go_binary,
+        "test",
+        "-json",
+        "-count=1",
+        "-timeout",
+        "%ds" % node_timeout,
+        "-run",
+        "^%s$" % re.escape(leaf),
+        package_arg,
+    ]
+    started = time.time()
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=str(repo_root),
+            env=environment,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+            timeout=node_timeout + 60,
+        )
+        stdout = completed.stdout or ""
+        status, leaf_output, package_output = parse_go_test_json(stdout, leaf)
+    except subprocess.TimeoutExpired as exc:
+        result["duration"] = time.time() - started
+        result["message"] = "selector timed out after %ds" % (node_timeout + 60)
+        result["output"] = (exc.stdout or "") if isinstance(exc.stdout, str) else ""
+        return result
+    except OSError as exc:
+        result["duration"] = time.time() - started
+        result["message"] = "execution error: unable to execute go test: %s" % exc
+        return result
+
+    result["duration"] = time.time() - started
+    combined_output = "\n".join([line for line in leaf_output if line] + package_output).strip()
+
+    if re.search(r"(?m)^panic: test timed out", combined_output):
+        result["message"] = "test timed out"
+        result["output"] = combined_output
+    elif completed.returncode not in (0, 1) or re.search(r"(?m)^(?:panic:|fatal error:|signal:)", combined_output):
+        result["message"] = "process crash during go test"
+        result["output"] = combined_output
+    elif status in ("pass", "fail", "skip") and completed.returncode != (1 if status == "fail" else 0):
+        result["message"] = "execution error: go test exit code disagrees with the test result"
+        result["output"] = combined_output
+    elif status == "fail" and re.search(r"(?m)^\s*f2p_structural_test\.go:\d+: (?:cannot determine the working directory:|could not locate the repository root \(|cannot load the production sources of )", combined_output):
+        result["message"] = "setup error: structural test fixture unavailable"
+        result["output"] = combined_output
+    elif status == "pass":
+        result["status"] = "pass"
+        result["output"] = combined_output
+    elif status == "fail":
+        result["status"] = "fail"
+        result["message"] = "test %s failed" % leaf
+        result["output"] = combined_output
+    elif status == "skip":
+        result["status"] = "skip"
+        result["output"] = combined_output
+    else:
+        category = "compile error" if "[build failed]" in combined_output else "collection error" if completed.returncode == 0 else "execution error"
+        result["message"] = "%s: test %s was not collected or did not report a result" % (category, leaf)
+        result["output"] = combined_output
+    return result
+
+
+def _looks_like_exec_wrapper_failure(result):
+    text = "%s\n%s" % (result.get("message", ""), result.get("output", ""))
+    lowered = text.lower()
+    if "permission denied" not in lowered:
+        return False
+    return "setpriv" in lowered or "failed to execute" in lowered
+
+
+def run_f2p_selectors(repo_root, node_timeout, environment, go_binary, notes):
+    results = []
+    for selector in F2P_SELECTORS:
+        result = run_go_selector(repo_root, selector, node_timeout, environment, go_binary)
+        if result["status"] == "error" and _looks_like_exec_wrapper_failure(result):
+            retry_env = dict(environment)
+            retry_env["GOFLAGS"] = re.sub(r"-exec=\S+\s*", "", retry_env.get("GOFLAGS", "")).strip()
+            retry = run_go_selector(repo_root, selector, node_timeout, retry_env, go_binary)
+            if retry["status"] != "error":
+                notes.append(
+                    "%s: the image's GOFLAGS -exec wrapper could not execute the test binary; "
+                    "the node was re-run without the wrapper" % selector
+                )
+                result = retry
+        results.append(result)
+    return results
+
+
+def _run_p2p_once(repo_root, environment, notes, p2p_select):
+    """Invoke the frozen P2P runner once and return (suites, output lines)."""
+    report_path = Path(tempfile.mkdtemp(prefix="f2p-p2p-report-", dir=str(Path(environment.get("TMPDIR", tempfile.gettempdir())))))
+    junit = report_path / "p2p-junit.xml"
+    runner = repo_root / P2P_RUNNER_RELATIVE_PATH
+    if not runner.is_file():
+        notes.append("the frozen P2P runner %s is missing from the repository" % P2P_RUNNER_RELATIVE_PATH)
+        return [], []
+    command = [sys.executable or "python3", str(runner), "--junit", str(junit), "--timeout", str(P2P_NODE_TIMEOUT)]
+    selection = p2p_select
+    if not selection:
+        for name in SELECTION_ENV_VARS:
+            value = os.environ.get(name)
+            if value and not PLACEHOLDER_PATTERN.match(value.strip()):
+                selection = value
+                break
+    if selection:
+        command.extend(["--select", selection])
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=str(repo_root),
+            env=environment,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+            timeout=P2P_NODE_TIMEOUT * 60 + 300,
+        )
+        output = completed.stdout or ""
+    except (OSError, subprocess.SubprocessError) as exc:
+        notes.append("the frozen P2P runner could not be executed: %s" % exc)
+        return [], []
+    for line in output.splitlines():
+        if line.startswith("P2P "):
+            print(line)
+    if not junit.is_file():
+        notes.append("the frozen P2P runner did not write a JUnit report")
+        return [], []
+    try:
+        tree = ET.parse(str(junit))
+    except ET.ParseError as exc:
+        notes.append("the frozen P2P JUnit report could not be parsed: %s" % exc)
+        return [], []
+    root = tree.getroot()
+    suites = list(root) if root.tag == "testsuites" else [root]
+    has_failure = any(case.find("failure") is not None or case.find("error") is not None for suite in suites for case in suite.iter("testcase"))
+    if completed.returncode not in (0, 1) or completed.returncode != int(has_failure):
+        notes.append("the frozen P2P runner exit code disagrees with its JUnit report")
+        return [], output.splitlines()
+    return suites, output.splitlines()
+
+
+def _p2p_exec_wrapper_failures(suites):
+    """Count P2P nodes whose error is the image's -exec wrapper failing to run."""
+    count = 0
+    for suite in suites:
+        for case in suite.iter("testcase"):
+            for error in case.findall("error"):
+                text = "%s\n%s" % (error.get("message", ""), error.text or "")
+                lowered = text.lower()
+                if "permission denied" in lowered and ("setpriv" in lowered or "failed to execute" in lowered):
+                    count += 1
+    return count
+
+
+def run_frozen_p2p(repo_root, environment, notes, p2p_select=None):
+    """Run the frozen P2P runner and return its JUnit suites.
+
+    When the image's GOFLAGS ``-exec`` wrapper provably cannot execute the
+    compiled test binaries (the environment defect documented in the frozen
+    handoff), the run is repeated once without the wrapper and the improved
+    report is used; a node that still does not report a result stays an error
+    and is never turned into an assertion failure.
+    """
+    suites, output = _run_p2p_once(repo_root, environment, notes, p2p_select)
+    failures = _p2p_exec_wrapper_failures(suites)
+    if failures:
+        retry_env = dict(environment)
+        retry_env["GOFLAGS"] = re.sub(r"-exec=\S+\s*", "", retry_env.get("GOFLAGS", "")).strip()
+        retry_suites, retry_output = _run_p2p_once(repo_root, retry_env, notes, p2p_select)
+        if retry_suites and _p2p_exec_wrapper_failures(retry_suites) < failures:
+            notes.append(
+                "%d frozen P2P node(s) failed because the image's GOFLAGS -exec wrapper could not execute "
+                "the test binaries; the frozen P2P set was re-run without the wrapper" % failures
+            )
+            return retry_suites, retry_output
+    return suites, output
+
+
+def build_suite(result):
+    suite = ET.Element("testsuite")
+    suite.set("name", result["selector"])
+    suite.set("selector", result["selector"])
+    suite.set("tests", "1")
+    suite.set("failures", "1" if result["status"] == "fail" else "0")
+    suite.set("errors", "1" if result["status"] == "error" else "0")
+    suite.set("skipped", "1" if result["status"] == "skip" else "0")
+    suite.set("time", "%.3f" % result["duration"])
+
+    case = ET.SubElement(suite, "testcase")
+    case.set("classname", result["path"])
+    case.set("name", result["leaf"])
+    case.set("file", result["path"])
+    case.set("selector", result["selector"])
+    case.set("role", result["role"])
+    case.set("time", "%.3f" % result["duration"])
+
+    if result["status"] == "fail":
+        failure = ET.SubElement(case, "failure")
+        failure.set("message", result["message"])
+        failure.set("type", "AssertionFailure")
+        failure.text = result["output"] or result["message"]
+    elif result["status"] == "error":
+        error = ET.SubElement(case, "error")
+        error.set("message", result["message"])
+        error.set("type", "RunnerError")
+        error.text = result["output"] or result["message"]
+    elif result["status"] == "skip":
+        ET.SubElement(case, "skipped")
+
+    if result["output"]:
+        system_out = ET.SubElement(suite, "system-out")
+        system_out.text = result["output"]
+    return suite
+
+
+def write_junit(report_path, p2p_suites, f2p_results, total_duration):
+    root = ET.Element("testsuites")
+    root.set("name", "verifier-frontmatter-consolidation-p2p-f2p")
+
+    tests = failures = errors = skipped = 0
+    for suite in p2p_suites:
+        root.append(suite)
+        tests += int(suite.get("tests", "1") or "1")
+        failures += int(suite.get("failures", "0") or "0")
+        errors += int(suite.get("errors", "0") or "0")
+        skipped += int(suite.get("skipped", "0") or "0")
+    for result in f2p_results:
+        suite = build_suite(result)
+        root.append(suite)
+        tests += 1
+        failures += 1 if result["status"] == "fail" else 0
+        errors += 1 if result["status"] == "error" else 0
+        skipped += 1 if result["status"] == "skip" else 0
+
+    root.set("tests", str(tests))
+    root.set("failures", str(failures))
+    root.set("errors", str(errors))
+    root.set("skipped", str(skipped))
+    root.set("time", "%.3f" % total_duration)
+
+    tree = ET.ElementTree(root)
+    ET.indent(tree, space="  ")
+    report_file = Path(report_path)
+    if report_file.parent and str(report_file.parent):
+        report_file.parent.mkdir(parents=True, exist_ok=True)
+    tree.write(str(report_file), encoding="utf-8", xml_declaration=True)
+    return failures, errors
+
+
+def cross_check_selection(selectors, notes):
+    """Best-effort cross-check against a pipeline-provided F2P selection asset."""
+    candidates = []
+    for name in ("F2P_SELECT", "F2P_SELECT_FILE", "VERIFIER_F2P_SELECT", "VERIFIER_F2P_SELECTORS"):
+        value = os.environ.get(name)
+        if value:
+            candidates.append(Path(value))
+    for directory in (Path.cwd(), Path.cwd().parent, Path("/workspace/repo"), Path("/workspace/verifier")):
+        for name in ("f2p_select.txt", "f2p_select.json"):
+            candidates.append(directory / name)
+            candidates.append(directory / "verifier" / name)
+    for path in candidates:
+        try:
+            if not path.is_file():
+                continue
+            text = path.read_text(encoding="utf-8-sig", errors="replace")
+        except OSError:
+            continue
+        external = [line.strip() for line in re.split(r"[\r\n,;]+", text) if SELECTOR_PATTERN.match(line.strip())]
+        if not external:
+            continue
+        missing = [selector for selector in selectors if selector not in external]
+        if missing:
+            notes.append(
+                "%s does not list %d embedded F2P selector(s); the embedded list stays authoritative: %s"
+                % (path, len(missing), ", ".join(missing))
+            )
+        return
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description="Run the frozen P2P and F2P selectors and write one JUnit report")
+    parser.add_argument("--junit", required=True, help="path of the aggregated JUnit report to write")
+    parser.add_argument("--p2p-select", default=None, help="optional frozen P2P selection asset forwarded to the P2P runner")
+    parser.add_argument("--timeout", type=int, default=DEFAULT_NODE_TIMEOUT, help="per-F2P-selector go test timeout in seconds")
+    args, _unknown = parser.parse_known_args(argv)
+
+    started = time.time()
+    notes = []
+    repo_root = find_repo_root()
+    print("F2P/P2P repository root: %s" % repo_root)
+
+    probe_environment = dict(os.environ)
+    exec_root, exec_source = pick_exec_root(probe_environment)
+    print("F2P/P2P execution root: %s (%s)" % (exec_root, exec_source))
+    work_root = Path(tempfile.mkdtemp(prefix="f2p-run-", dir=str(exec_root)))
+    _make_world_accessible(work_root)
+
+    wrapper = _exec_wrapper(probe_environment)
+    drop_wrapper = False
+    if wrapper:
+        if _probe_execution(work_root, wrapper) or not _probe_execution(work_root, None):
+            drop_wrapper = False
+        else:
+            drop_wrapper = True
+            notes.append(
+                "the image's GOFLAGS -exec wrapper %s cannot execute files under %s while plain execution works; "
+                "the wrapper is dropped for this run" % (wrapper, exec_root)
+            )
+
+    environment = prepare_environment(work_root, find_go_binary(dict(os.environ)), drop_exec_wrapper=drop_wrapper)
+    go_binary = find_go_binary(environment)
+    print("F2P/P2P go toolchain: %s" % go_binary)
+
+    cross_check_selection(F2P_SELECTORS, notes)
+
+    p2p_suites, p2p_output = run_frozen_p2p(repo_root, environment, notes, p2p_select=args.p2p_select)
+    if not p2p_suites:
+        for line in p2p_output:
+            print(line)
+
+    f2p_results = run_f2p_selectors(repo_root, args.timeout, environment, go_binary, notes)
+
+    total_duration = time.time() - started
+    failures, errors = write_junit(args.junit, p2p_suites, f2p_results, total_duration)
+
+    for note in notes:
+        print("F2P/P2P note: %s" % note)
+    for result in f2p_results:
+        print("%-8s %s" % (result["status"].upper(), result["selector"]))
+        if result["status"] in ("fail", "error", "skip") and result["output"]:
+            print(result["output"])
+    print(
+        "F2P nodes: %d total, %d passed, %d failed, %d errors, %d skipped (%.1fs)"
+        % (
+            len(f2p_results),
+            sum(1 for r in f2p_results if r["status"] == "pass"),
+            sum(1 for r in f2p_results if r["status"] == "fail"),
+            sum(1 for r in f2p_results if r["status"] == "error"),
+            sum(1 for r in f2p_results if r["status"] == "skip"),
+            total_duration,
+        )
+    )
+    print("JUnit report: %s" % args.junit)
+    return int(not p2p_suites or bool(failures or errors))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
