+// Only bare parameters and local aliases count as unpacked values. Context
+// selectors deliberately do not: helper(ctx) is a legitimate implementation.
+func (m *pkgModel) parameterAlias(fn *funcInfo, text string, seen map[string]bool) string {
+	expression, err := parser.ParseExpr(text)
+	if err != nil {
+		return ""
+	}
+	if paren, ok := expression.(*ast.ParenExpr); ok {
+		return m.parameterAlias(fn, exprString(m.fset, paren.X), seen)
+	}
+	id, ok := expression.(*ast.Ident)
+	if !ok || seen[id.Name] {
+		return ""
+	}
+	if containsString(fn.params, id.Name) {
+		return id.Name
+	}
+	seen[id.Name] = true
+	result := ""
+	ast.Inspect(fn.body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		var names, values []ast.Expr
+		switch value := node.(type) {
+		case *ast.AssignStmt:
+			names, values = value.Lhs, value.Rhs
+		case *ast.ValueSpec:
+			for _, name := range value.Names {
+				names = append(names, name)
+			}
+			values = value.Values
+		}
+		for i, name := range names {
+			if lhs, ok := name.(*ast.Ident); ok && lhs.Name == id.Name && i < len(values) {
+				if root := m.parameterAlias(fn, exprString(m.fset, values[i]), copySeen(seen)); root != "" {
+					result = root
+				}
+			}
+		}
+		return result == ""
+	})
+	return result
+}
