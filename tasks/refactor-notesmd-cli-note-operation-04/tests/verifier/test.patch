+	"strings"
+	"testing"
+)
+
+// instruction.md:9 explicitly distinguishes a nonnil empty map from nil.
+func TestP2PDeleteNonnilEmptyMapWritesBodyExactlyOnce(t *testing.T) {
+	for _, body := range []string{"", "Body", "\nBody", "\n\nBody\n", "Body\r\n"} {
+		vault, note := p2pFrontmatterNote("---\n{}\n---\n" + body)
+		out, err := actions.Frontmatter(vault, note, actions.FrontmatterParams{NoteName: "folder/empty-map", Delete: true, Key: "missing"})
+		assert.NoError(t, err)
+		assert.Equal(t, "Deleted frontmatter key 'missing' from folder/empty-map", out)
+		assert.Equal(t, 1, note.getCalls)
+		assert.Equal(t, 1, note.setCalls)
+		assert.Equal(t, strings.TrimPrefix(body, "\n"), note.lastContents)
+		assert.Equal(t, "/vaults/myVault", note.lastVaultPath)
+		assert.Equal(t, "folder/empty-map", note.lastNoteName)
+	}
+}
+
+func TestP2PWriteFailurePropagatesForBothMutations(t *testing.T) {
+	for _, mode := range []actions.FrontmatterParams{{Edit: true, Key: "title", Value: "New"}, {Delete: true, Key: "title"}} {
+		vault, note := p2pFrontmatterNote("---\ntitle: Old\n---\n\nBody")
+		sentinel := errors.New("write failure sentinel")
+		note.setErr = sentinel
+		mode.NoteName = "folder/write-error"
+		out, err := actions.Frontmatter(vault, note, mode)
+		assert.Same(t, sentinel, err)
+		assert.Empty(t, out)
+		assert.Equal(t, 1, note.getCalls)
+		assert.Equal(t, 1, note.setCalls)
+		assert.Equal(t, "folder/write-error", note.lastNoteName)
+	}
+}
+
+func TestP2PNoSelectionReadsMalformedContentsBeforeOperationError(t *testing.T) {
+	vault, note := p2pFrontmatterNote("---\ninvalid: [unclosed\n---\nBody")
+	out, err := actions.Frontmatter(vault, note, actions.FrontmatterParams{NoteName: "folder/no-selection", Key: "title", Value: "New"})
+	assert.EqualError(t, err, "no operation specified: use --print, --edit, or --delete")
+	assert.Empty(t, out)
+	assert.Equal(t, 1, vault.defaultCalls)
+	assert.Equal(t, 1, vault.pathCalls)
+	assert.Equal(t, 1, note.getCalls)
+	assert.Zero(t, note.setCalls)
+}
+
+func TestP2PAllSelectionCombinationsPreservePrecedence(t *testing.T) {
+	for mask := 0; mask < 8; mask++ {
+		vault, note := p2pFrontmatterNote("---\ntitle: Old\nkeep: retained\n---\nBody")
+		params := actions.FrontmatterParams{NoteName: "folder/priority", Print: mask&1 != 0, Edit: mask&2 != 0, Delete: mask&4 != 0, Key: "title", Value: "New"}
+		out, err := actions.Frontmatter(vault, note, params)
+		switch {
+		case params.Print:
+			assert.NoError(t, err)
+			assert.Equal(t, "keep: retained\ntitle: Old\n", out)
+			assert.Zero(t, note.setCalls)
+		case params.Edit:
+			assert.NoError(t, err)
+			assert.Equal(t, "Updated frontmatter key 'title' in folder/priority", out)
+			assert.Equal(t, 1, note.setCalls)
+			assert.Equal(t, "---\nkeep: retained\ntitle: New\n---\nBody", note.lastContents)
+		case params.Delete:
+			assert.NoError(t, err)
+			assert.Equal(t, "Deleted frontmatter key 'title' from folder/priority", out)
+			assert.Equal(t, 1, note.setCalls)
+			assert.Equal(t, "---\nkeep: retained\n---\nBody", note.lastContents)
+		default:
+			assert.EqualError(t, err, "no operation specified: use --print, --edit, or --delete")
+			assert.Empty(t, out)
+			assert.Zero(t, note.setCalls)
+		}
+		assert.Equal(t, 1, note.getCalls)
+	}
+}
+
+func TestP2PEditMalformedContentsNeverWrites(t *testing.T) {
+	vault, note := p2pFrontmatterNote("---\ninvalid: [unclosed\n---\nBody")
+	out, err := actions.Frontmatter(vault, note, actions.FrontmatterParams{NoteName: "broken", Edit: true, Key: "title", Value: "New"})
+	assert.EqualError(t, err, frontmatter.InvalidFrontmatterError)
+	assert.Empty(t, out)
+	assert.Zero(t, note.setCalls)
+}
