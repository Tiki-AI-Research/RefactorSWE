+func TestF2PFrontmatterDispatchUsesOperationCapabilities(t *testing.T) {
+	m := mustF2PPackage(t, findRepoRoot(t), "pkg", "actions")
+	owner := requireOperation(t, m)
+	entry := m.functionByName("Frontmatter")
+	if entry == nil {
+		t.Fatal("actions.Frontmatter is missing")
+	}
+	seen := map[*funcInfo]bool{}
+	reachedCaps := map[string]bool{}
+	var visit func(*funcInfo)
+	visit = func(fn *funcInfo) {
+		if seen[fn] {
+			return
+		}
+		seen[fn] = true
+		if fn.operationType() != "" && m.ownedType(owner, fn.operationType(), map[string]bool{}) {
+			for _, cap := range allCapabilities {
+				if m.exclusiveCapability(fn, cap) {
+					reachedCaps[cap] = true
+					return
+				}
+			}
+		}
+		for _, call := range fn.calls {
+			if call.pkg == "frontmatter" && (call.name == "Parse" || call.name == "HasFrontmatter" || call.name == "SetKey" || call.name == "DeleteKey") {
+				t.Errorf("%s:%d performs a capability before entering the operation context", relPath(fn.file), call.line)
+			}
+		}
+		for _, next := range m.callees(fn) {
+			visit(next)
+		}
+	}
+	visit(entry)
+	for _, cap := range allCapabilities {
+		if !reachedCaps[cap] {
+			t.Errorf("Frontmatter does not reach the %s capability on %s", cap, owner)
+		}
+	}
+}
