+
+// Frozen P2P regression nodes for the frontmatter consolidation. Every test in
+// this file is a top-level exact leaf so it can be collected and executed on
+// its own against the baseline and against a candidate solution. The recorders
+// below are local to this file on purpose: the frozen nodes must not depend on
+// any change a candidate makes to the shared mocks package.
+
+type p2pNoteRecorder struct {
+	contents      string
+	getErr        error
+	setErr        error
+	getCalls      int
+	setCalls      int
+	lastVaultPath string
+	lastNoteName  string
+	lastContents  string
+}
+
+func (n *p2pNoteRecorder) Move(string, string) error                { return nil }
+func (n *p2pNoteRecorder) Delete(string) error                      { return nil }
+func (n *p2pNoteRecorder) UpdateLinks(string, string, string) error { return nil }
+func (n *p2pNoteRecorder) GetNotesList(string) ([]string, error)    { return nil, nil }
+func (n *p2pNoteRecorder) FindBacklinks(string, string) ([]obsidian.NoteMatch, error) {
+	return nil, nil
+}
+func (n *p2pNoteRecorder) SearchNotesWithSnippets(string, string) ([]obsidian.NoteMatch, error) {
+	return nil, nil
+}
+
+func (n *p2pNoteRecorder) GetContents(string, string) (string, error) {
+	n.getCalls++
+	return n.contents, n.getErr
+}
+
+func (n *p2pNoteRecorder) SetContents(vaultPath, noteName, contents string) error {
+	n.setCalls++
+	n.lastVaultPath = vaultPath
+	n.lastNoteName = noteName
+	n.lastContents = contents
+	return n.setErr
+}
+
+type p2pVaultRecorder struct {
+	name           string
+	path           string
+	defaultNameErr error
+	pathErr        error
+	defaultCalls   int
+	pathCalls      int
+}
+
+func (v *p2pVaultRecorder) DefaultName() (string, error) {
+	v.defaultCalls++
+	if v.defaultNameErr != nil {
+		return "", v.defaultNameErr
+	}
+	return v.name, nil
+}
+
+func (v *p2pVaultRecorder) SetDefaultName(string) error { return nil }
+
+func (v *p2pVaultRecorder) Path() (string, error) {
+	v.pathCalls++
+	if v.pathErr != nil {
+		return "", v.pathErr
+	}
+	return v.path, nil
+}
+
+func (v *p2pVaultRecorder) DefaultOpenType() (string, error) { return "obsidian", nil }
+
+var (
+	_ obsidian.NoteManager  = (*p2pNoteRecorder)(nil)
+	_ obsidian.VaultManager = (*p2pVaultRecorder)(nil)
+)
+
+func p2pFrontmatterNote(contents string) (*p2pVaultRecorder, *p2pNoteRecorder) {
+	return &p2pVaultRecorder{name: "myVault", path: "/vaults/myVault"}, &p2pNoteRecorder{contents: contents}
