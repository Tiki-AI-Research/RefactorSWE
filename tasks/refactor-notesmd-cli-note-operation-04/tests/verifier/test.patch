@@ -0,0 +1,199 @@
+package frontmatter_test
+
+import (
+	"testing"
+
+	"github.com/Yakitrak/notesmd-cli/pkg/frontmatter"
+	"github.com/stretchr/testify/assert"
+)
+
+// Frozen P2P regression nodes for the frontmatter consolidation. Every test in
+// this file is a top-level exact leaf so it can be collected and executed on
+// its own against the baseline and against a candidate solution.
+
+var (
+	_ func(string) (map[string]interface{}, string, error) = frontmatter.Parse
+	_ func(map[string]interface{}) (string, error)         = frontmatter.Format
+	_ func(string) bool                                    = frontmatter.HasFrontmatter
+	_ func(string, string, string) (string, error)         = frontmatter.SetKey
+	_ func(string, string) (string, error)                 = frontmatter.DeleteKey
+)
+
+func TestP2PFrontmatterPackageAPISurface(t *testing.T) {
+	assert.Equal(t, "---", frontmatter.Delimiter)
+	assert.Equal(t, "note does not contain frontmatter", frontmatter.NoFrontmatterError)
+	assert.Equal(t, "frontmatter contains invalid YAML", frontmatter.InvalidFrontmatterError)
+}
+
+func TestP2PParseReturnsMapAndBodyForValidFrontmatter(t *testing.T) {
+	fm, body, err := frontmatter.Parse("---\ntitle: Test\ntags:\n  - a\n  - b\n---\nBody content")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "Test", fm["title"])
+	assert.Equal(t, []interface{}{"a", "b"}, fm["tags"])
+	assert.Equal(t, "Body content", body)
+}
+
+func TestP2PParseSurfacesErrorForMalformedFrontmatter(t *testing.T) {
+	fm, body, err := frontmatter.Parse("---\ninvalid: [unclosed\n---\nBody")
+	if !assert.Error(t, err) {
+		return
+	}
+	assert.Equal(t, frontmatter.InvalidFrontmatterError, err.Error())
+	assert.Nil(t, fm)
+	assert.Equal(t, "", body)
+}
+
+func TestP2PHasFrontmatterDetection(t *testing.T) {
+	assert.True(t, frontmatter.HasFrontmatter("---\ntitle: Test\n---\nBody"))
+	assert.True(t, frontmatter.HasFrontmatter(" \t--- \t\n title: Test\n---\nBody"))
+	assert.False(t, frontmatter.HasFrontmatter("Just body content"))
+	assert.False(t, frontmatter.HasFrontmatter(""))
+}
+
+func TestP2PSetKeyCreatesDelimiterBlockWhenAbsent(t *testing.T) {
+	got, err := frontmatter.SetKey("Body text", "title", "New")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\ntitle: New\n---\nBody text", got)
+}
+
+func TestP2PSetKeySerializesBooleans(t *testing.T) {
+	gotTrue, err := frontmatter.SetKey("---\n---\nBody", "draft", "true")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\ndraft: true\n---\nBody", gotTrue)
+
+	gotFalse, err := frontmatter.SetKey("---\n---\nBody", "published", "false")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\npublished: false\n---\nBody", gotFalse)
+}
+
+func TestP2PSetKeySerializesSequences(t *testing.T) {
+	sequence, err := frontmatter.SetKey("---\n---\nBody", "tags", "[one, two, three]")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\ntags:\n    - one\n    - two\n    - three\n---\nBody", sequence)
+
+	emptySequence, err := frontmatter.SetKey("---\n---\nBody", "tags", "[]")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\ntags: []\n---\nBody", emptySequence)
+}
+
+func TestP2PSetKeySerializesOtherValuesAsStrings(t *testing.T) {
+	got, err := frontmatter.SetKey("---\n---\nBody", "title", "My Note")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\ntitle: My Note\n---\nBody", got)
+
+	numeric, err := frontmatter.SetKey("---\n---\nBody", "count", "123")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\ncount: \"123\"\n---\nBody", numeric)
+}
+
+func TestP2PSetKeyPreservesBodyAndExistingKeys(t *testing.T) {
+	got, err := frontmatter.SetKey("---\ntitle: Old\n---\nBody line one\nBody line two", "author", "John")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\nauthor: John\ntitle: Old\n---\nBody line one\nBody line two", got)
+}
+
+func TestP2PSetKeyReconstructionLayoutIsExact(t *testing.T) {
+	updated, err := frontmatter.SetKey("---\ntitle: Old\n---\nBody", "title", "New")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\ntitle: New\n---\nBody", updated)
+
+	idempotent, err := frontmatter.SetKey("---\nauthor: John\ntitle: Old\n---\nBody", "title", "Old")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\nauthor: John\ntitle: Old\n---\nBody", idempotent)
+}
+
+func TestP2PSetKeySurfacesParseErrorForMalformedFrontmatter(t *testing.T) {
+	got, err := frontmatter.SetKey("---\ninvalid: [unclosed\n---\nBody", "title", "New")
+	if !assert.Error(t, err) {
+		return
+	}
+	assert.Equal(t, frontmatter.InvalidFrontmatterError, err.Error())
+	assert.Equal(t, "", got)
+}
+
+func TestP2PDeleteKeyPreservesRemainingKeysAndBody(t *testing.T) {
+	got, err := frontmatter.DeleteKey("---\ntitle: Test\nauthor: John\n---\nBody", "author")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\ntitle: Test\n---\nBody", got)
+}
+
+func TestP2PDeleteKeyFinalKeyReturnsBodyOnly(t *testing.T) {
+	got, err := frontmatter.DeleteKey("---\ntitle: Test\n---\nBody", "title")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "Body", got)
+
+	withBlankLine, err := frontmatter.DeleteKey("---\ntitle: Test\n---\n\nBody", "title")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "Body", withBlankLine)
+	assert.NotContains(t, withBlankLine, "---")
+	for _, yamlContent := range []string{"title: Test", "{}"} {
+		for _, leading := range []string{"\n\n", "\n\n\n"} {
+			contents := "---\n" + yamlContent + "\n---\n" + leading + "Body"
+			got, err := frontmatter.DeleteKey(contents, "title")
+			if assert.NoError(t, err, "contents: %q", contents) {
+				assert.Equal(t, leading[1:]+"Body", got)
+			}
+		}
+	}
+}
+
+func TestP2PDeleteKeyReconstructionLayoutIsExact(t *testing.T) {
+	got, err := frontmatter.DeleteKey("---\nauthor: John\ntitle: Old\n---\nBody", "author")
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "---\ntitle: Old\n---\nBody", got)
+}
+
+func TestP2PDeleteKeySurfacesNoFrontmatterError(t *testing.T) {
+	got, err := frontmatter.DeleteKey("Just body content", "title")
+	if !assert.Error(t, err) {
+		return
+	}
+	assert.Equal(t, frontmatter.NoFrontmatterError, err.Error())
+	assert.Equal(t, "", got)
+
+	gotEmpty, errEmpty := frontmatter.DeleteKey("---\n---\nBody", "title")
+	if !assert.Error(t, errEmpty) {
+		return
+	}
+	assert.Equal(t, frontmatter.NoFrontmatterError, errEmpty.Error())
+	assert.Equal(t, "", gotEmpty)
+}
+
+func TestP2PDeleteKeySurfacesParseErrorForMalformedFrontmatter(t *testing.T) {
+	got, err := frontmatter.DeleteKey("---\ninvalid: [unclosed\n---\nBody", "title")
+	if !assert.Error(t, err) {
+		return
+	}
+	assert.Equal(t, frontmatter.InvalidFrontmatterError, err.Error())
+	assert.Equal(t, "", got)
+}
diff --git a/tests/f2p/f2p_context_test.go b/tests/f2p/f2p_context_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b3d59264a349ad3104c17b6597b1176394a533b9
--- /dev/null
+++ b/tests/f2p/f2p_context_test.go
@@ -0,0 +1,725 @@
+package f2p
+
+import (
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// The shared model stays frozen for P2P. Only TestF2P loads this model.
+// Layout equivalence admits conversions, never methods or object identity.
+type f2pModel struct {
+	*pkgModel
+	definitions    map[string]ast.Expr
+	aliases        map[string]bool
+	valueParams    map[string]map[string]bool
+	valueReceivers map[string]bool
+}
+
+func mustF2PPackage(t *testing.T, root string, elems ...string) *f2pModel {
+	t.Helper()
+	base := mustPackage(t, root, elems...)
+	m := &f2pModel{pkgModel: base, definitions: map[string]ast.Expr{}, aliases: map[string]bool{}, valueParams: map[string]map[string]bool{}, valueReceivers: map[string]bool{}}
+	entries, err := os.ReadDir(base.dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") || strings.HasSuffix(entry.Name(), "_test.go") {
+			continue
+		}
+		file, err := parser.ParseFile(base.fset, filepath.Join(base.dir, entry.Name()), nil, parser.SkipObjectResolution)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ast.Inspect(file, func(n ast.Node) bool {
+			if decl, ok := n.(*ast.FuncDecl); ok && decl.Body != nil {
+				params := map[string]bool{}
+				if decl.Type.Params != nil {
+					for _, field := range decl.Type.Params.List {
+						_, pointer := f2pUnparen(field.Type).(*ast.StarExpr)
+						for _, name := range field.Names {
+							params[name.Name] = !pointer
+						}
+					}
+				}
+				for _, fn := range base.funcs {
+					if fn.body.Pos() == decl.Body.Pos() || (fn.file == filepath.Join(base.dir, entry.Name()) && fn.line == base.fset.Position(decl.Pos()).Line) {
+						m.valueParams[fn.id] = params
+						if decl.Recv != nil && len(decl.Recv.List) > 0 {
+							_, pointer := f2pUnparen(decl.Recv.List[0].Type).(*ast.StarExpr)
+							m.valueReceivers[fn.id] = !pointer
+						}
+					}
+				}
+			}
+			if spec, ok := n.(*ast.TypeSpec); ok {
+				m.definitions[spec.Name.Name] = spec.Type
+				m.aliases[spec.Name.Name] = spec.Assign.IsValid()
+			}
+			return true
+		})
+	}
+	for name := range m.definitions {
+		underlying := m.layout(name)
+		if underlying != "" && underlying != name {
+			m.fieldTypes[name] = m.fieldTypes[underlying]
+			m.fieldOrder[name] = m.fieldOrder[underlying]
+			m.strFields[name] = m.strFields[underlying]
+		}
+	}
+	for pass := 0; pass < 3; pass++ {
+		for _, fn := range m.funcs {
+			m.inferTypes(fn)
+		}
+	}
+	return m
+}
+
+// Value conversion/dereference allocates a distinct struct value; pointer fields
+// retain their referenced objects, exactly as a shallow Go struct copy does.
+func f2pCopyValue(value f2pPathValue) f2pPathValue {
+	copied := make([]*f2pPathObject, 0, len(value.objects))
+	views := map[*f2pPathObject]string{}
+	for _, object := range value.objects {
+		clone := &f2pPathObject{typ: object.typ, fields: map[string]f2pPathValue{}}
+		clone.root = clone
+		view := value.views[f2pObjectRoot(object)]
+		if view == "" {
+			view = object.typ
+		}
+		views[clone] = view
+		for name, field := range object.fields {
+			if !field.pointer && len(field.objects) > 0 {
+				field = f2pCopyValue(field)
+			}
+			clone.fields[name] = field
+		}
+		copied = append(copied, clone)
+	}
+	value.objects = copied
+	value.views = views
+	value.pointer = false
+	return value
+}
+
+func f2pUnparen(e ast.Expr) ast.Expr {
+	for {
+		if p, ok := e.(*ast.ParenExpr); ok {
+			e = p.X
+		} else {
+			return e
+		}
+	}
+}
+
+func (m *f2pModel) nominal(name string) string {
+	seen := map[string]bool{}
+	for m.aliases[name] && !seen[name] {
+		seen[name] = true
+		id, ok := f2pUnparen(m.definitions[name]).(*ast.Ident)
+		if !ok {
+			break
+		}
+		name = id.Name
+	}
+	return name
+}
+
+func (m *f2pModel) layout(name string) string {
+	seen := map[string]bool{}
+	for !seen[name] {
+		seen[name] = true
+		e := m.definitions[name]
+		if e == nil {
+			return ""
+		}
+		switch value := f2pUnparen(e).(type) {
+		case *ast.Ident:
+			name = value.Name
+		case *ast.StructType:
+			return name
+		default:
+			return ""
+		}
+	}
+	return ""
+}
+
+func (m *f2pModel) sameLayout(a, b string) bool {
+	left, right := m.layout(a), m.layout(b)
+	if left == "" || right == "" {
+		return false
+	}
+	return exprString(m.fset, m.definitions[left]) == exprString(m.fset, m.definitions[right])
+}
+
+// A conversion changes only the nominal view. Pointer views retain their heap.
+func (m *f2pModel) conversion(e ast.Expr) (string, bool) {
+	e = f2pUnparen(e)
+	pointer := false
+	if star, ok := e.(*ast.StarExpr); ok {
+		pointer = true
+		e = f2pUnparen(star.X)
+	}
+	if id, ok := e.(*ast.Ident); ok && m.definitions[id.Name] != nil {
+		return m.nominal(id.Name), pointer
+	}
+	return "", false
+}
+
+func (m *f2pModel) operationAbstractionType() string {
+	owner := m.declaredOperationType()
+	if owner == "" {
+		return ""
+	}
+	audit := m.f2pInstanceProvenance()
+	var common map[*f2pPathObject]bool
+	for _, cap := range allCapabilities {
+		roots := audit.receivers[cap]
+		if len(roots) == 0 {
+			return ""
+		}
+		if common == nil {
+			common = map[*f2pPathObject]bool{}
+			for root := range roots {
+				common[root] = true
+			}
+		} else {
+			for root := range common {
+				if !roots[root] {
+					delete(common, root)
+				}
+			}
+		}
+	}
+	if len(common) == 0 {
+		return ""
+	}
+	return owner
+}
+func (m *f2pModel) callees(fn *funcInfo) []*funcInfo {
+	var out []*funcInfo
+	for _, call := range fn.calls {
+		if call.pkg != "" {
+			continue
+		}
+		if field, ok := call.receiver.(*ast.SelectorExpr); ok {
+			for _, closure := range m.byName[field.Sel.Name] {
+				if closure.parent != nil && closure.ownerType == m.expressionType(fn, field.X) {
+					out = append(out, closure)
+				}
+			}
+		}
+		for _, target := range m.byName[call.name] {
+			if call.receiver == nil {
+				if target.operationType() == "" && target.parent == nil {
+					out = append(out, target)
+				}
+			} else if ownerType := m.expressionType(fn, call.receiver); ownerType != "" && (target.operationType() == ownerType || m.implements(target.operationType(), ownerType)) {
+				out = append(out, target)
+			}
+		}
+	}
+	return out
+}
+
+func (m *f2pModel) closureSet(fn *funcInfo) map[*funcInfo]bool {
+	seen := map[*funcInfo]bool{fn: true}
+	queue := []*funcInfo{fn}
+	for len(queue) > 0 {
+		current := queue[0]
+		queue = queue[1:]
+		for _, next := range m.callees(current) {
+			if !seen[next] {
+				seen[next] = true
+				queue = append(queue, next)
+			}
+		}
+	}
+	return seen
+}
+
+func (m *f2pModel) closure(fn *funcInfo) []*funcInfo {
+	set := m.closureSet(fn)
+	out := make([]*funcInfo, 0, len(set))
+	for reached := range set {
+		out = append(out, reached)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].id < out[j].id })
+	return out
+}
+
+func (m *f2pModel) reachesCall(fn *funcInfo, pkg, name string) bool {
+	for _, reached := range m.closure(fn) {
+		for _, call := range reached.calls {
+			if call.pkg == pkg && call.name == name {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (m *f2pModel) reachesCapability(fn *funcInfo, capability string) bool {
+	if capability == printCapability {
+		// Printing may use Parse/Format directly and need not call HasFrontmatter.
+		return m.reachesCall(fn, "frontmatter", "Parse") && m.reachesCall(fn, "frontmatter", "Format")
+	}
+	for _, reached := range m.closure(fn) {
+		for _, call := range reached.calls {
+			if call.pkg == "frontmatter" && capabilityCalls[call.name] == capability {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (m *f2pModel) exclusiveCapability(fn *funcInfo, capability string) bool {
+	if !m.reachesCapability(fn, capability) {
+		return false
+	}
+	for _, other := range allCapabilities {
+		if other != capability && m.reachesCapability(fn, other) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m *f2pModel) readsSelectionFlags(fn *funcInfo) bool {
+	for _, reached := range m.closure(fn) {
+		found := false
+		ast.Inspect(reached.body, func(node ast.Node) bool {
+			if _, nested := node.(*ast.FuncLit); nested {
+				return false
+			}
+			sel, ok := node.(*ast.SelectorExpr)
+			if !ok || m.expressionType(reached, sel.X) != "FrontmatterParams" {
+				return true
+			}
+			switch sel.Sel.Name {
+			case "Print", "Edit", "Delete":
+				found = true
+			}
+			return !found
+		})
+		if found {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *f2pModel) declaredOperationType() string {
+	exposed := map[string]map[string]bool{}
+	entry := m.functionByName("Frontmatter")
+	if entry == nil {
+		return ""
+	}
+	reachable := m.closureSet(entry)
+	for _, fn := range m.funcs {
+		if !reachable[fn] {
+			continue
+		}
+		ownerType := fn.operationType()
+		if ownerType == "" {
+			continue
+		}
+		for _, capability := range allCapabilities {
+			if m.exclusiveCapability(fn, capability) {
+				if exposed[ownerType] == nil {
+					exposed[ownerType] = map[string]bool{}
+				}
+				exposed[ownerType][capability] = true
+			}
+		}
+	}
+	var candidates []string
+	for typ, capabilities := range exposed {
+		if len(capabilities) == len(allCapabilities) {
+			candidates = append(candidates, typ)
+		}
+	}
+	sort.Strings(candidates)
+	if len(candidates) > 0 {
+		return candidates[0]
+	}
+	// Capabilities can be separate wrappers composed around one owned context.
+	// Discover shared local context types through composition, without requiring
+	// all three capability methods on the same concrete receiver.
+	for context := range m.fieldTypes {
+		capabilities := map[string]bool{}
+		for _, fn := range m.funcs {
+			if !reachable[fn] || fn.operationType() == "" || !m.ownedType(context, fn.operationType(), map[string]bool{}) {
+				continue
+			}
+			for _, capability := range allCapabilities {
+				if m.exclusiveCapability(fn, capability) {
+					capabilities[capability] = true
+				}
+			}
+		}
+		if len(capabilities) == len(allCapabilities) {
+			candidates = append(candidates, context)
+		}
+	}
+	sort.Strings(candidates)
+	if len(candidates) == 0 {
+		return ""
+	}
+	return candidates[0]
+}
+
+func (m *f2pModel) operationMethods(owner string) []*funcInfo {
+	entry := m.functionByName("Frontmatter")
+	if entry == nil {
+		return nil
+	}
+	reachable := m.closureSet(entry)
+	var out []*funcInfo
+	for _, fn := range m.funcs {
+		if reachable[fn] && fn.operationType() != "" && m.ownedType(owner, fn.operationType(), map[string]bool{}) {
+			out = append(out, fn)
+		}
+	}
+	return out
+}
+
+func (m *f2pModel) origin(fn *funcInfo, text, owner string, loaded bool, seen map[string]bool, ownedWriter ...bool) bool {
+	key := fmt.Sprintf("%p/%s/%t/%v", fn, text, loaded, ownedWriter)
+	if seen[key] {
+		return false
+	}
+	seen[key] = true
+	expression, err := parser.ParseExpr(text)
+	if err != nil {
+		return false
+	}
+	if paren, ok := expression.(*ast.ParenExpr); ok {
+		return m.origin(fn, exprString(m.fset, paren.X), owner, loaded, seen, ownedWriter...)
+	}
+	if field, ok := expression.(*ast.SelectorExpr); ok {
+		if fn.parent != nil {
+			root, _ := rootIdentName(field)
+			if !fn.locals[root] && !containsString(fn.params, root) {
+				if !loaded && fn.ownerType == owner {
+					return true
+				}
+				if m.origin(fn.parent, text, owner, loaded, copySeen(seen), ownedWriter...) {
+					return true
+				}
+			}
+		}
+		if !loaded && m.ownedType(m.expressionType(fn, field.X), owner, map[string]bool{}) {
+			return true
+		}
+		// A selected wrapper can own a writer alongside its shared context. Only
+		// manager provenance admits these sibling fields: content and note identity
+		// must still come from the shared context. The wrapper must already be a
+		// reachable operation method, and this must be an actual writer field.
+		if !loaded && len(ownedWriter) > 0 && ownedWriter[0] {
+			typ := m.expressionType(fn, field.X)
+			fieldType := m.fieldTypes[typ][field.Sel.Name]
+			isWriter := containsString(m.interfaces[fieldType], "SetContents") || fieldType == "obsidian.NoteManager"
+			if isWriter && fn.operationType() == typ {
+				for _, operation := range m.operationMethods(owner) {
+					if operation == fn {
+						return true
+					}
+				}
+			}
+		}
+		typ := m.expressionType(fn, field.X)
+		if loaded {
+			// Trace the corresponding field, not any arbitrary string in the context.
+			for _, parent := range m.funcs {
+				found := false
+				ast.Inspect(parent.body, func(n ast.Node) bool {
+					if _, closure := n.(*ast.FuncLit); closure {
+						return false
+					}
+					switch v := n.(type) {
+					case *ast.CompositeLit:
+						if m.expressionType(parent, v) != typ {
+							break
+						}
+						for index, elt := range v.Elts {
+							if kv, ok := elt.(*ast.KeyValueExpr); ok {
+								if id, ok := kv.Key.(*ast.Ident); ok && id.Name == field.Sel.Name {
+									if m.origin(parent, exprString(m.fset, kv.Value), owner, true, copySeen(seen), ownedWriter...) {
+										found = true
+									}
+								}
+							} else if index < len(m.fieldOrder[typ]) && m.fieldOrder[typ][index] == field.Sel.Name {
+								if value, ok := elt.(ast.Expr); ok && m.origin(parent, exprString(m.fset, value), owner, true, copySeen(seen), ownedWriter...) {
+									found = true
+								}
+							}
+						}
+					case *ast.AssignStmt:
+						for i, lhs := range v.Lhs {
+							sel, ok := lhs.(*ast.SelectorExpr)
+							if ok && sel.Sel.Name == field.Sel.Name && m.expressionType(parent, sel.X) == typ && i < len(v.Rhs) {
+								if m.origin(parent, exprString(m.fset, v.Rhs[i]), owner, true, copySeen(seen), ownedWriter...) {
+									found = true
+								}
+							}
+						}
+					}
+					return !found
+				})
+				if found {
+					return true
+				}
+			}
+		}
+	}
+	id, ok := expression.(*ast.Ident)
+	if !ok {
+		return false
+	}
+	// Local aliases and the first result of GetContents (never its error result).
+	found := false
+	ast.Inspect(fn.body, func(n ast.Node) bool {
+		if _, closure := n.(*ast.FuncLit); closure {
+			return false
+		}
+		check := func(names []ast.Expr, values []ast.Expr) {
+			for i, lhs := range names {
+				name, ok := lhs.(*ast.Ident)
+				if !ok || name.Name != id.Name || i >= len(values) {
+					continue
+				}
+				if call, ok := values[i].(*ast.CallExpr); ok {
+					if callee, _ := calleeName(call.Fun); loaded && callee == "GetContents" && i == 0 && fn.operationType() == "" {
+						found = true
+						continue
+					}
+				}
+				if m.origin(fn, exprString(m.fset, values[i]), owner, loaded, copySeen(seen), ownedWriter...) {
+					found = true
+				}
+			}
+		}
+		switch n := n.(type) {
+		case *ast.AssignStmt:
+			check(n.Lhs, n.Rhs)
+		case *ast.ValueSpec:
+			names := []ast.Expr{}
+			for _, name := range n.Names {
+				names = append(names, name)
+			}
+			check(names, n.Values)
+		}
+		return !found
+	})
+	if found {
+		return true
+	}
+	for index, param := range fn.params {
+		if param != id.Name {
+			continue
+		}
+		matchedWriterCall := false
+		for _, caller := range m.funcs {
+			for _, call := range caller.calls {
+				if call.pkg != "" || call.name != fn.name || index >= len(call.args) {
+					continue
+				}
+				matches := false
+				for _, target := range m.callees(caller) {
+					if target == fn {
+						matches = true
+					}
+				}
+				if !matches {
+					continue
+				}
+				valid := m.origin(caller, call.args[index].text, owner, loaded, copySeen(seen), ownedWriter...)
+				if len(ownedWriter) > 0 && ownedWriter[0] {
+					// A helper shared by owned and external managers must not be
+					// accepted merely because one of its call sites is owned.
+					if !valid {
+						return false
+					}
+					matchedWriterCall = true
+				} else if valid {
+					return true
+				}
+			}
+		}
+		if matchedWriterCall {
+			return true
+		}
+	}
+	if fn.parent != nil && !fn.locals[id.Name] && !containsString(fn.params, id.Name) {
+		if !loaded && fn.ownerType == owner {
+			return true
+		}
+		return m.origin(fn.parent, text, owner, loaded, copySeen(seen), ownedWriter...)
+	}
+	return false
+}
+
+func (m *f2pModel) ownedType(typ, owner string, seen map[string]bool) bool {
+	if m.nominal(typ) == m.nominal(owner) || m.sameLayout(typ, owner) {
+		return true
+	}
+	if seen[owner] {
+		return false
+	}
+	seen[owner] = true
+	for _, fieldType := range m.fieldTypes[owner] {
+		if m.ownedType(typ, fieldType, seen) {
+			return true
+		}
+	}
+	return false
+}
+
+func (model *f2pModel) inferTypes(fn *funcInfo) {
+	declared := map[string]string{}
+	ast.Inspect(fn.body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		if spec, ok := node.(*ast.ValueSpec); ok && spec.Type != nil {
+			for _, name := range spec.Names {
+				declared[name.Name] = strings.TrimPrefix(typeString(model.fset, spec.Type), "*")
+			}
+		}
+		return true
+	})
+	for pass := 0; pass <= len(fn.assigns)+len(fn.params)+1; pass++ {
+		changed := false
+		bind := func(name, typeName string) {
+			if explicit := declared[name]; explicit != "" {
+				typeName = explicit
+			}
+			if name != "_" && typeName != "" && fn.types[name] != typeName {
+				fn.types[name] = typeName
+				changed = true
+			}
+		}
+		ast.Inspect(fn.body, func(node ast.Node) bool {
+			if _, nested := node.(*ast.FuncLit); nested {
+				return false
+			}
+			switch statement := node.(type) {
+			case *ast.AssignStmt:
+				for index, expression := range statement.Rhs {
+					if index >= len(statement.Lhs) {
+						break
+					}
+					if name, ok := statement.Lhs[index].(*ast.Ident); ok {
+						bind(name.Name, model.expressionType(fn, expression))
+					}
+				}
+			case *ast.ValueSpec:
+				for index, name := range statement.Names {
+					if statement.Type != nil {
+						bind(name.Name, strings.TrimPrefix(typeString(model.fset, statement.Type), "*"))
+					} else if index < len(statement.Values) {
+						bind(name.Name, model.expressionType(fn, statement.Values[index]))
+					}
+				}
+			}
+			return true
+		})
+		if !changed {
+			break
+		}
+	}
+}
+
+func (model *f2pModel) expressionType(fn *funcInfo, expression ast.Expr) string {
+	switch value := expression.(type) {
+	case *ast.Ident:
+		// Resolve the innermost preceding declaration. Distinct branch-local
+		// variables may use the same spelling and have different nominal views.
+		var binding ast.Expr
+		var scopeStart, bindingPos token.Pos
+		if value.Pos() >= fn.body.Pos() && value.Pos() <= fn.body.End() {
+			ast.Inspect(fn.body, func(node ast.Node) bool {
+				block, ok := node.(*ast.BlockStmt)
+				if !ok {
+					return true
+				}
+				if value.Pos() < block.Pos() || value.Pos() > block.End() {
+					return false
+				}
+				for _, statement := range block.List {
+					if statement.End() >= value.Pos() {
+						continue
+					}
+					var names, values []ast.Expr
+					switch s := statement.(type) {
+					case *ast.AssignStmt:
+						names, values = s.Lhs, s.Rhs
+					case *ast.DeclStmt:
+						if d, ok := s.Decl.(*ast.GenDecl); ok {
+							for _, spec := range d.Specs {
+								if v, ok := spec.(*ast.ValueSpec); ok {
+									for _, name := range v.Names {
+										names = append(names, name)
+									}
+									values = v.Values
+								}
+							}
+						}
+					}
+					for i, name := range names {
+						if id, ok := name.(*ast.Ident); ok && id.Name == value.Name && i < len(values) && (block.Pos() > scopeStart || (block.Pos() == scopeStart && statement.Pos() > bindingPos)) {
+							binding = values[i]
+							scopeStart = block.Pos()
+							bindingPos = statement.Pos()
+						}
+					}
+				}
+				return true
+			})
+		}
+		if binding != nil {
+			if typ := model.expressionType(fn, binding); typ != "" {
+				return typ
+			}
+		}
+		return model.nominal(fn.types[value.Name])
+	case *ast.CompositeLit:
+		return model.nominal(strings.TrimPrefix(typeString(model.fset, value.Type), "*"))
+	case *ast.UnaryExpr:
+		return model.expressionType(fn, value.X)
+	case *ast.StarExpr:
+		return model.expressionType(fn, value.X)
+	case *ast.ParenExpr:
+		return model.expressionType(fn, value.X)
+	case *ast.SelectorExpr:
+		return model.fieldTypes[model.expressionType(fn, value.X)][value.Sel.Name]
+	case *ast.CallExpr:
+		if typ, _ := model.conversion(value.Fun); typ != "" {
+			return typ
+		}
+		if method, ok := value.Fun.(*ast.SelectorExpr); ok {
+			owner := model.expressionType(fn, method.X)
+			for _, target := range model.byName[method.Sel.Name] {
+				if target.operationType() == owner && len(target.results) > 0 {
+					return strings.TrimPrefix(target.results[0], "*")
+				}
+			}
+		}
+		if name, ok := value.Fun.(*ast.Ident); ok {
+			if target := model.functionByName(name.Name); target != nil && len(target.results) > 0 {
+				return strings.TrimPrefix(target.results[0], "*")
+			}
+		}
+	}
+	return ""
+}
diff --git a/tests/f2p/f2p_instances_test.go b/tests/f2p/f2p_instances_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4522035d1e847685c6a1224df530d0f47ac5b911
--- /dev/null
+++ b/tests/f2p/f2p_instances_test.go
@@ -0,0 +1,373 @@
+package f2p
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"strconv"
+)
+
+// Only literal empty-string addition is an identity. Arbitrary string operations
+// must not acquire owned or loaded provenance merely by mentioning owned input.
+func f2pIdentityOperand(expression ast.Expr) ast.Expr {
+	binary, ok := expression.(*ast.BinaryExpr)
+	if !ok || binary.Op != token.ADD {
+		return nil
+	}
+	empty := func(expression ast.Expr) bool {
+		for {
+			if paren, ok := expression.(*ast.ParenExpr); ok {
+				expression = paren.X
+				continue
+			}
+			literal, ok := expression.(*ast.BasicLit)
+			if !ok || literal.Kind != token.STRING {
+				return false
+			}
+			text, err := strconv.Unquote(literal.Value)
+			return err == nil && text == ""
+		}
+	}
+	if empty(binary.X) {
+		return binary.Y
+	}
+	if empty(binary.Y) {
+		return binary.X
+	}
+	return nil
+}
+
+// The shared origin model is frozen. Normalize identities only for this F2P
+// content check, including aliases and helper arguments which contain them.
+func (m *f2pModel) f2pContentOrigin(fn *funcInfo, text, owner string, seen map[string]bool) bool {
+	if fn == nil || len(seen) > 64 {
+		return false
+	}
+	key := fn.id + "/" + text
+	if seen[key] {
+		return false
+	}
+	seen[key] = true
+	if m.origin(fn, text, owner, false, map[string]bool{}) {
+		return true
+	}
+	expression, err := parser.ParseExpr(text)
+	if err != nil {
+		return false
+	}
+	if paren, ok := expression.(*ast.ParenExpr); ok {
+		return m.f2pContentOrigin(fn, exprString(m.fset, paren.X), owner, seen)
+	}
+	if identity := f2pIdentityOperand(expression); identity != nil {
+		return m.f2pContentOrigin(fn, exprString(m.fset, identity), owner, seen)
+	}
+	id, ok := expression.(*ast.Ident)
+	if !ok {
+		return false
+	}
+	found := false
+	ast.Inspect(fn.body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		var names, values []ast.Expr
+		switch value := node.(type) {
+		case *ast.AssignStmt:
+			names, values = value.Lhs, value.Rhs
+		case *ast.ValueSpec:
+			for _, name := range value.Names {
+				names = append(names, name)
+			}
+			values = value.Values
+		}
+		for i, name := range names {
+			if lhs, ok := name.(*ast.Ident); ok && lhs.Name == id.Name && len(names) == len(values) {
+				found = found || m.f2pContentOrigin(fn, exprString(m.fset, values[i]), owner, copySeen(seen))
+			}
+		}
+		return !found
+	})
+	if found {
+		return true
+	}
+	for i, param := range fn.params {
+		if param != id.Name {
+			continue
+		}
+		for _, caller := range m.funcs {
+			for _, call := range caller.calls {
+				if call.pkg != "" || call.name != fn.name || i >= len(call.args) {
+					continue
+				}
+				for _, target := range m.callees(caller) {
+					if target == fn && m.f2pContentOrigin(caller, call.args[i].text, owner, copySeen(seen)) {
+						return true
+					}
+				}
+			}
+		}
+	}
+	if fn.parent != nil && !fn.locals[id.Name] && !containsString(fn.params, id.Name) {
+		return m.f2pContentOrigin(fn.parent, text, owner, seen)
+	}
+	return false
+}
+
+// Bounded summaries carry only content parameters used by a key transform.
+// They never infer that an arbitrary string-returning helper transforms content.
+func (m *f2pModel) f2pContentParameters(fn *funcInfo, active map[*funcInfo]bool) map[string]bool {
+	out := map[string]bool{}
+	if fn == nil || active[fn] || len(active) >= 16 {
+		return out
+	}
+	active[fn] = true
+	defer delete(active, fn)
+	for _, call := range fn.calls {
+		if isContentCall(call, editCapability) || isContentCall(call, deleteCapability) {
+			if call.name != "HasFrontmatter" {
+				if param := m.parameterAlias(fn, call.args[0].text, map[string]bool{}); param != "" {
+					out[param] = true
+				}
+			}
+			continue
+		}
+		if call.pkg != "" || call.receiver != nil {
+			continue
+		}
+		for _, target := range m.callees(fn) {
+			if target.name != call.name || target.recvType != "" || target.parent != nil {
+				continue
+			}
+			summary := m.f2pContentParameters(target, active)
+			for i, param := range target.params {
+				if summary[param] && i < len(call.args) {
+					if input := m.parameterAlias(fn, call.args[i].text, map[string]bool{}); input != "" {
+						out[input] = true
+					}
+				}
+			}
+		}
+	}
+	return out
+}
+
+func (m *f2pModel) f2pConsumesContentParameter(fn *funcInfo, active map[*funcInfo]bool) bool {
+	return len(m.f2pContentParameters(fn, active)) > 0
+}
+
+// A blank assignment without calls is inert. Everything else (especially a
+// return which suppresses later work) remains relevant to capability dispatch.
+func f2pSelectionWork(node ast.Node) bool {
+	if node == nil {
+		return false
+	}
+	switch node := node.(type) {
+	case *ast.BlockStmt:
+		for _, statement := range node.List {
+			if f2pSelectionWork(statement) {
+				return true
+			}
+		}
+		return false
+	case *ast.AssignStmt:
+		for _, lhs := range node.Lhs {
+			if id, ok := lhs.(*ast.Ident); !ok || id.Name != "_" {
+				return true
+			}
+		}
+		calls := false
+		for _, rhs := range node.Rhs {
+			ast.Inspect(rhs, func(n ast.Node) bool {
+				if _, ok := n.(*ast.CallExpr); ok {
+					calls = true
+				}
+				return true
+			})
+		}
+		return calls
+	case *ast.EmptyStmt:
+		return false
+	case *ast.CaseClause:
+		return f2pSelectionWork(&ast.BlockStmt{List: node.Body})
+	}
+	return true
+}
+
+// These helpers belong only to the F2P instance interpreter. The shared source
+// model and frozen P2P checks deliberately do not use their heap approximations.
+func f2pObjectRoot(object *f2pPathObject) *f2pPathObject {
+	if object.root != nil {
+		return object.root
+	}
+	return object
+}
+
+// Snapshot one branch's reachable object graph, preserving aliasing and cycles.
+// Copying only variable maps lets one branch overwrite another branch's fields.
+func f2pBranchEnv(env map[string]f2pPathValue) map[string]f2pPathValue {
+	objects := map[*f2pPathObject]*f2pPathObject{}
+	closures := map[*f2pPathClosure]*f2pPathClosure{}
+	var value func(f2pPathValue) f2pPathValue
+	var scope func(map[string]f2pPathValue) map[string]f2pPathValue
+	scope = func(input map[string]f2pPathValue) map[string]f2pPathValue {
+		out := map[string]f2pPathValue{}
+		for name, v := range input {
+			out[name] = value(v)
+		}
+		return out
+	}
+	value = func(v f2pPathValue) f2pPathValue {
+		out := v
+		out.objects = nil
+		out.closures = nil
+		for _, object := range v.objects {
+			clone := objects[object]
+			if clone == nil {
+				clone = &f2pPathObject{root: f2pObjectRoot(object), typ: object.typ, fields: map[string]f2pPathValue{}}
+				objects[object] = clone
+				for name, field := range object.fields {
+					clone.fields[name] = value(field)
+				}
+			}
+			out.objects = append(out.objects, clone)
+		}
+		for _, closure := range v.closures {
+			clone := closures[closure]
+			if clone == nil {
+				clone = &f2pPathClosure{literal: closure.literal, parent: closure.parent}
+				closures[closure] = clone
+				clone.env = scope(closure.env)
+			}
+			out.closures = append(out.closures, clone)
+		}
+		return out
+	}
+	return scope(env)
+}
+
+// Join live branch heaps back into canonical objects. Callers and captured aliases
+// retain their original pointers; writes performed by a helper remain observable.
+// Scalar provenance is must-flow, while object alternatives are retained as may-flow.
+func f2pCommitBranches(branches []map[string]f2pPathValue, destinations map[*f2pPathObject]*f2pPathObject, extras ...map[string]f2pPathValue) {
+	states := map[*f2pPathObject][]*f2pPathObject{}
+	seen := map[*f2pPathObject]bool{}
+	seenClosures := map[*f2pPathClosure]bool{}
+	var visit func(f2pPathValue)
+	visit = func(v f2pPathValue) {
+		for _, object := range v.objects {
+			if seen[object] {
+				continue
+			}
+			seen[object] = true
+			root := f2pObjectRoot(object)
+			states[root] = append(states[root], object)
+			for _, field := range object.fields {
+				visit(field)
+			}
+		}
+		for _, closure := range v.closures {
+			if seenClosures[closure] {
+				continue
+			}
+			seenClosures[closure] = true
+			for _, captured := range closure.env {
+				visit(captured)
+			}
+		}
+	}
+	for _, branch := range branches {
+		for _, v := range branch {
+			visit(v)
+		}
+	}
+	// Build before replacing root fields: some input states can themselves be roots.
+	joined := map[*f2pPathObject]map[string]f2pPathValue{}
+	for root, alternatives := range states {
+		fields := map[string]f2pPathValue{}
+		for i, object := range alternatives {
+			for name, v := range object.fields {
+				if old, ok := fields[name]; ok && i > 0 {
+					fields[name] = f2pPathMerge(old, v)
+				} else {
+					fields[name] = v
+				}
+			}
+		}
+		joined[root] = fields
+	}
+	var canonical func(f2pPathValue) f2pPathValue
+	seenClosures = map[*f2pPathClosure]bool{}
+	canonical = func(v f2pPathValue) f2pPathValue {
+		v.objects = append([]*f2pPathObject(nil), v.objects...)
+		for i, object := range v.objects {
+			root := f2pObjectRoot(object)
+			if destination := destinations[root]; destination != nil {
+				v.objects[i] = destination
+			} else {
+				v.objects[i] = root
+			}
+		}
+		for _, closure := range v.closures {
+			if seenClosures[closure] {
+				continue
+			}
+			seenClosures[closure] = true
+			for name, captured := range closure.env {
+				closure.env[name] = canonical(captured)
+			}
+		}
+		return v
+	}
+	for root, fields := range joined {
+		for name, v := range fields {
+			fields[name] = canonical(v)
+		}
+		destination := destinations[root]
+		if destination == nil {
+			destination = root
+		}
+		destination.fields = fields
+	}
+	for _, branch := range append(branches, extras...) {
+		for name, v := range branch {
+			branch[name] = canonical(v)
+		}
+	}
+}
+
+// A nested join writes into the caller's current snapshot, not a global root.
+// Stable roots establish identity only; the current object establishes heap state.
+func f2pDestinations(env map[string]f2pPathValue) map[*f2pPathObject]*f2pPathObject {
+	out := map[*f2pPathObject]*f2pPathObject{}
+	seen := map[*f2pPathObject]bool{}
+	closures := map[*f2pPathClosure]bool{}
+	var visit func(f2pPathValue)
+	visit = func(value f2pPathValue) {
+		for _, object := range value.objects {
+			if seen[object] {
+				continue
+			}
+			seen[object] = true
+			root := f2pObjectRoot(object)
+			if out[root] == nil {
+				out[root] = object
+			}
+			for _, field := range object.fields {
+				visit(field)
+			}
+		}
+		for _, closure := range value.closures {
+			if closures[closure] {
+				continue
+			}
+			closures[closure] = true
+			for _, captured := range closure.env {
+				visit(captured)
+			}
+		}
+	}
+	for _, value := range env {
+		visit(value)
+	}
+	return out
+}
diff --git a/tests/f2p/f2p_paths_test.go b/tests/f2p/f2p_paths_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0a2ae67c2dc142ecd54a6548d2391c27e871c185
--- /dev/null
+++ b/tests/f2p/f2p_paths_test.go
@@ -0,0 +1,1026 @@
+package f2p
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// Recognize a local yaml.v3 encoder with one immutable constructor binding.
+// Calls through parameters, reassigned encoder variables, and helper-returned
+// encoders remain outside this bounded writer-effect summary.
+func (m *f2pModel) f2pEncoderWriters(fn *funcInfo) map[string]string {
+	out := map[string]string{}
+	file, err := parser.ParseFile(token.NewFileSet(), fn.file, nil, parser.ImportsOnly)
+	if err != nil {
+		return out
+	}
+	yamlAliases := map[string]bool{}
+	for _, spec := range file.Imports {
+		path, err := strconv.Unquote(spec.Path.Value)
+		if err == nil && path == "gopkg.in/yaml.v3" {
+			alias := "yaml"
+			if spec.Name != nil {
+				alias = spec.Name.Name
+			}
+			yamlAliases[alias] = true
+		}
+	}
+	writes := map[string]int{}
+	ast.Inspect(fn.body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		switch value := node.(type) {
+		case *ast.AssignStmt:
+			for _, lhs := range value.Lhs {
+				if id, ok := lhs.(*ast.Ident); ok {
+					writes[id.Name]++
+				}
+			}
+		case *ast.ValueSpec:
+			for _, name := range value.Names {
+				writes[name.Name]++
+			}
+		}
+		return true
+	})
+	for _, statement := range fn.body.List {
+		assignment, ok := statement.(*ast.AssignStmt)
+		if !ok || len(assignment.Lhs) != 1 || len(assignment.Rhs) != 1 {
+			continue
+		}
+		id, ok := assignment.Lhs[0].(*ast.Ident)
+		if !ok || writes[id.Name] != 1 {
+			continue
+		}
+		call, ok := assignment.Rhs[0].(*ast.CallExpr)
+		if !ok || len(call.Args) != 1 {
+			continue
+		}
+		sel, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok || sel.Sel.Name != "NewEncoder" {
+			continue
+		}
+		pkg, ok := sel.X.(*ast.Ident)
+		if !ok || !yamlAliases[pkg.Name] {
+			continue
+		}
+		writer := call.Args[0]
+		if unary, ok := writer.(*ast.UnaryExpr); ok && unary.Op == token.AND {
+			writer = unary.X
+		}
+		if name, ok := writer.(*ast.Ident); ok {
+			out[id.Name] = name.Name
+		}
+	}
+	return out
+}
+
+// Recognize delimiter construction expressions, not observations such as
+// strings.Contains(content, "---"). Keep the shared P2P predicate frozen.
+// Discarded construction still counts as a private implementation here; returned
+// value flow separately establishes whether a shared implementation is consumed.
+func (m *f2pModel) f2pProducesReconstruction(fn *funcInfo) bool {
+	found := false
+	ast.Inspect(fn.body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		var expression ast.Expr
+		switch value := node.(type) {
+		case *ast.BinaryExpr:
+			if value.Op == token.ADD {
+				expression = value
+			}
+		case *ast.CallExpr:
+			ref, ok := describeCall(m.fset, fn.imports, value)
+			if !ok {
+				return true
+			}
+			if ref.pkg == "fmt" && ref.name == "Sprintf" || ref.pkg == "strings" && ref.name == "Join" || ref.pkg == "" && (ref.name == "WriteString" || ref.name == "Write") {
+				expression = value
+			}
+		}
+		if expression != nil && containsDelimiterOperand(expression) {
+			found = true
+		}
+		return true
+	})
+	return found
+}
+
+// f2pRequireReturnedSharedPaths supplements the pooled result-flow check. It
+// separates local if/switch paths before replaying the existing value interpreter,
+// including in reachable full-note helpers: a good return in rebuildContent must
+// not conceal another return which discards its serialized bytes or assembled note.
+// Parse/Format and other YAML-only primitives are not full-note output helpers.
+//
+// This is deliberately bounded, not a Go verifier. Calls retain the existing
+// interpreter's argument-sensitive may-flow semantics, supplemented by bounded
+// local helper success-return replay. Map facts track direct aliases and writes;
+// unknown map-taking calls invalidate them. Arbitrary heap effects, callback
+// dispatch, loop-carried alternatives, deferred result changes and general
+// interprocedural predicate correlation are outside the proof. Unsupported local
+// paths are logged and left to runtime tests, rather than reported as defects.
+func f2pRequireReturnedSharedPaths(t *testing.T, m *f2pModel, kind string) {
+	t.Helper()
+	roots := []*funcInfo{m.functionByName("SetKey"), m.functionByName("DeleteKey")}
+	shared := f2pResultFlow{}
+	outputs := make([]f2pResultFlow, 2)
+	for i, fn := range roots {
+		values := m.f2pFunctionResults(fn, nil, nil, map[*funcInfo]bool{})
+		if len(values) > 0 {
+			outputs[i] = values[0]
+		}
+	}
+	for site := range outputs[0] {
+		if strings.HasPrefix(site, kind+":") && outputs[1][site] {
+			shared[site] = true
+		}
+	}
+	if len(shared) == 0 {
+		return // The existing pooled-result check reports this defect.
+	}
+	seen := map[*funcInfo]bool{}
+	for _, root := range roots {
+		if root == nil {
+			continue
+		}
+		for _, fn := range m.closure(root) {
+			if seen[fn] || fn.body == nil {
+				continue
+			}
+			seen[fn] = true
+			public := fn == roots[0] || fn == roots[1]
+			values := m.f2pFunctionResults(fn, nil, nil, map[*funcInfo]bool{})
+			if !public {
+				// A serializer returning YAML is not returning a whole note. A
+				// joining helper may accept bytes as arguments, so only require
+				// serialization here when its own output actually carries it.
+				if len(values) == 0 || !f2pPathHasKind(values[0], "reconstruction") || !f2pPathShares(values[0], shared) {
+					continue
+				}
+			}
+			paths, limited := f2pExpandOutputPaths(m, fn)
+			if limited {
+				t.Logf("bounded %s path check in %s: unsupported control flow or path limit; remaining cases use pooled flow and runtime tests", kind, fn.id)
+			}
+			for _, path := range paths {
+				if path.result == nil || f2pPathErrorReturn(m, path) || f2pPathEmptyBody(m, fn, path) {
+					continue
+				}
+				clone := *fn
+				clone.body = &ast.BlockStmt{List: path.statements}
+				result := m.f2pFunctionResults(&clone, nil, nil, map[*funcInfo]bool{})
+				if len(result) > 0 && f2pPathShares(result[0], shared) {
+					if f2pPathHelperFailure(m, fn, path, shared) {
+						t.Errorf("%s:%d: successful output path in %s drops an actual shared %s result on a bounded helper success return", relPath(fn.file), m.fset.Position(path.result.Pos()).Line, fn.id, kind)
+					}
+					continue
+				}
+				t.Errorf("%s:%d: successful output path in %s must return an actual shared %s result; another successful branch cannot supply that result", relPath(fn.file), m.fset.Position(path.result.Pos()).Line, fn.id, kind)
+			}
+		}
+	}
+}
+
+// Re-evaluate one bounded local helper success return in the caller's actual
+// argument environment. This catches wrappers which return either the good or
+// discarded value: interpreting the helper without arguments loses that detail.
+// YAML primitives and sentinel empty-string contracts remain outside this probe.
+func f2pPathHelperFailure(m *f2pModel, caller *funcInfo, path f2pOutputPath, shared f2pResultFlow) bool {
+	seen := map[*funcInfo]bool{}
+	counts := map[*funcInfo]int{}
+	for _, statement := range path.statements {
+		ast.Inspect(statement, func(node ast.Node) bool {
+			if _, nested := node.(*ast.FuncLit); nested {
+				return false
+			}
+			if call, ok := node.(*ast.CallExpr); ok {
+				counts[f2pPathLocalTarget(m, caller, call)]++
+			}
+			return true
+		})
+	}
+	failed := false
+	for _, statement := range path.statements {
+		ast.Inspect(statement, func(node ast.Node) bool {
+			if _, nested := node.(*ast.FuncLit); nested {
+				return false
+			}
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			target := f2pPathLocalTarget(m, caller, call)
+			if target == nil || target == caller || seen[target] || counts[target] != 1 || target.body == nil || target.name == "Format" || target.name == "Parse" {
+				return true
+			}
+			seen[target] = true
+			// Literal arguments require predicate substitution before exploring
+			// both callee branches. Leave these to existing pooled/runtime checks.
+			for _, argument := range call.Args {
+				correlated := false
+				ast.Inspect(argument, func(node ast.Node) bool {
+					if id, ok := node.(*ast.Ident); ok {
+						for fact := range path.facts {
+							if f2pPathMentions(fact, id.Name) {
+								correlated = true
+							}
+						}
+					}
+					return true
+				})
+				if correlated {
+					return true
+				}
+				if _, literal := argument.(*ast.BasicLit); literal {
+					return true
+				}
+				if id, ok := argument.(*ast.Ident); ok && (id.Name == "true" || id.Name == "false" || id.Name == "nil") {
+					return true
+				}
+			}
+			alternatives, limited := f2pExpandOutputPaths(m, target)
+			if limited || len(alternatives) > 32 {
+				return true
+			}
+			for _, alternative := range alternatives {
+				if alternative.result == nil || f2pPathErrorReturn(m, alternative) || f2pPathEmptyBody(m, target, alternative) {
+					continue
+				}
+				if len(alternative.result.Results) > 0 {
+					if literal, ok := alternative.result.Results[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {
+						if text, err := strconv.Unquote(literal.Value); err == nil && text == "" {
+							continue
+						}
+					}
+				}
+				variant := *target
+				variant.body = &ast.BlockStmt{List: alternative.statements}
+				model := *m
+				base := *m.pkgModel
+				model.pkgModel = &base
+				model.byName = map[string][]*funcInfo{}
+				for name, functions := range m.byName {
+					model.byName[name] = append([]*funcInfo(nil), functions...)
+					for i, function := range functions {
+						if function == target {
+							model.byName[name][i] = &variant
+						}
+					}
+				}
+				root := *caller
+				root.body = &ast.BlockStmt{List: path.statements}
+				values := model.f2pFunctionResults(&root, nil, nil, map[*funcInfo]bool{})
+				if len(values) > 0 && !f2pPathShares(values[0], shared) {
+					failed = true
+				}
+			}
+			return true
+		})
+	}
+	return failed
+}
+
+func f2pPathHasKind(flow f2pResultFlow, kind string) bool {
+	for site := range flow {
+		if strings.HasPrefix(site, kind+":") {
+			return true
+		}
+	}
+	return false
+}
+
+func f2pPathShares(flow, shared f2pResultFlow) bool {
+	for site := range flow {
+		if shared[site] {
+			return true
+		}
+	}
+	return false
+}
+
+type f2pOutputPath struct {
+	statements []ast.Stmt
+	result     *ast.ReturnStmt
+	// Facts use the printed expression and its polarity. They rule out simple
+	// contradictory guards; assignments invalidate facts mentioning that name.
+	facts map[string]bool
+	// Empty-map permission belongs to a particular map object and mutation
+	// version. Variable aliases share the object; reassignment changes the ref.
+	maps      map[string]string
+	versions  map[string]int
+	emptyMaps map[string]int
+	metadata  map[string]bool
+	formatted map[string]f2pPathFormatValue
+}
+
+type f2pPathFormatValue struct {
+	object    string
+	version   int
+	errorName string
+}
+
+func f2pPathMapType(text string) bool {
+	text = strings.Join(strings.Fields(text), "")
+	return text == "map[string]interface{}" || text == "map[string]any"
+}
+
+func f2pPathMapRef(path *f2pOutputPath, expression ast.Expr) string {
+	if paren, ok := expression.(*ast.ParenExpr); ok {
+		return f2pPathMapRef(path, paren.X)
+	}
+	if unary, ok := expression.(*ast.UnaryExpr); ok && unary.Op == token.AND {
+		return f2pPathMapRef(path, unary.X)
+	}
+	if star, ok := expression.(*ast.StarExpr); ok {
+		return f2pPathMapRef(path, star.X)
+	}
+	if id, ok := expression.(*ast.Ident); ok {
+		return path.maps[id.Name]
+	}
+	return ""
+}
+
+func f2pPathEmptyMap(path f2pOutputPath) bool {
+	found := false
+	for name := range path.metadata {
+		object := path.maps[name]
+		if object == "" {
+			continue
+		}
+		found = true
+		version, known := path.emptyMaps[object]
+		if !known || version != path.versions[object] {
+			return false
+		}
+	}
+	return found
+}
+
+func f2pPathCopy(path f2pOutputPath) f2pOutputPath {
+	path.statements = append([]ast.Stmt(nil), path.statements...)
+	facts := map[string]bool{}
+	for key, value := range path.facts {
+		facts[key] = value
+	}
+	path.facts = facts
+	path.maps = f2pPathCopyStrings(path.maps)
+	path.versions = f2pPathCopyVersions(path.versions)
+	path.emptyMaps = f2pPathCopyVersions(path.emptyMaps)
+	metadata := map[string]bool{}
+	for name, value := range path.metadata {
+		metadata[name] = value
+	}
+	path.metadata = metadata
+	path.formatted = f2pPathCopyFormatted(path.formatted)
+	return path
+}
+
+func f2pPathCopyStrings(source map[string]string) map[string]string {
+	copy := map[string]string{}
+	for key, value := range source {
+		copy[key] = value
+	}
+	return copy
+}
+func f2pPathCopyVersions(source map[string]int) map[string]int {
+	copy := map[string]int{}
+	for key, value := range source {
+		copy[key] = value
+	}
+	return copy
+}
+func f2pPathCopyFormatted(source map[string]f2pPathFormatValue) map[string]f2pPathFormatValue {
+	copy := map[string]f2pPathFormatValue{}
+	for key, value := range source {
+		copy[key] = value
+	}
+	return copy
+}
+
+// Expand only local structured control flow, retaining original expression
+// positions so concrete serialization/reconstruction site identities still match.
+func f2pExpandOutputPaths(m *f2pModel, fn *funcInfo) ([]f2pOutputPath, bool) {
+	const maxPaths = 128
+	limited := false
+	var expand func([]ast.Stmt, []f2pOutputPath, int) []f2pOutputPath
+	expand = func(body []ast.Stmt, paths []f2pOutputPath, depth int) []f2pOutputPath {
+		if depth > 32 {
+			limited = true
+			return nil
+		}
+		for _, stmt := range body {
+			var next []f2pOutputPath
+			for _, path := range paths {
+				if path.result != nil {
+					next = append(next, path)
+					continue
+				}
+				switch s := stmt.(type) {
+				case *ast.BlockStmt:
+					next = append(next, expand(s.List, []f2pOutputPath{path}, depth+1)...)
+				case *ast.IfStmt:
+					initial := []f2pOutputPath{path}
+					if s.Init != nil {
+						initial = expand([]ast.Stmt{s.Init}, initial, depth+1)
+					}
+					for _, start := range initial {
+						f2pPathCalls(m, fn, &start, s.Cond)
+						for _, truth := range []bool{true, false} {
+							branch := f2pPathCopy(start)
+							if !f2pPathAssume(m, &branch, s.Cond, truth) {
+								continue
+							}
+							var statements []ast.Stmt
+							if truth {
+								statements = s.Body.List
+							} else if s.Else != nil {
+								statements = []ast.Stmt{s.Else}
+							}
+							next = append(next, expand(statements, []f2pOutputPath{branch}, depth+1)...)
+						}
+					}
+				case *ast.SwitchStmt:
+					initial := []f2pOutputPath{path}
+					if s.Init != nil {
+						initial = expand([]ast.Stmt{s.Init}, initial, depth+1)
+					}
+					for _, start := range initial {
+						if s.Tag != nil {
+							f2pPathCalls(m, fn, &start, s.Tag)
+						}
+						remaining := []f2pOutputPath{start}
+						var fallback *ast.CaseClause
+						for _, item := range s.Body.List {
+							clause := item.(*ast.CaseClause)
+							if clause.List == nil {
+								fallback = clause
+								continue
+							}
+							for _, value := range clause.List {
+								condition := value
+								if s.Tag != nil {
+									condition = &ast.BinaryExpr{X: s.Tag, Op: token.EQL, Y: value}
+								}
+								var rest []f2pOutputPath
+								for _, candidate := range remaining {
+									branch := f2pPathCopy(candidate)
+									if f2pPathAssume(m, &branch, condition, true) {
+										next = append(next, expand(clause.Body, []f2pOutputPath{branch}, depth+1)...)
+									}
+									if f2pPathAssume(m, &candidate, condition, false) {
+										rest = append(rest, candidate)
+									}
+								}
+								remaining = rest
+							}
+						}
+						if fallback != nil {
+							remaining = expand(fallback.Body, remaining, depth+1)
+						}
+						next = append(next, remaining...)
+					}
+				case *ast.ReturnStmt:
+					if len(s.Results) == 0 { // Named results need a separate environment model.
+						limited = true
+						continue
+					}
+					f2pPathCalls(m, fn, &path, s)
+					path.statements = append(path.statements, stmt)
+					path.result = s
+					next = append(next, path)
+				case *ast.BranchStmt, *ast.TypeSwitchStmt, *ast.SelectStmt, *ast.DeferStmt, *ast.GoStmt, *ast.LabeledStmt:
+					limited = true
+				case *ast.ForStmt, *ast.RangeStmt:
+					// The pooled interpreter cannot establish must-flow through a
+					// loop. Skip this local path rather than inventing an iteration.
+					limited = true
+				default:
+					f2pPathUpdate(m, fn, &path, stmt)
+					path.statements = append(path.statements, stmt)
+					next = append(next, path)
+				}
+				if len(next) > maxPaths {
+					limited = true
+					return next[:maxPaths]
+				}
+			}
+			paths = next
+		}
+		return paths
+	}
+	initial := f2pOutputPath{facts: map[string]bool{}, maps: map[string]string{}, versions: map[string]int{}, emptyMaps: map[string]int{}, metadata: map[string]bool{}, formatted: map[string]f2pPathFormatValue{}}
+	for _, name := range fn.params {
+		if f2pPathMapType(fn.types[name]) {
+			initial.maps[name] = "parameter:" + name
+			initial.metadata[name] = true
+		}
+	}
+	return expand(fn.body.List, []f2pOutputPath{initial}, 0), limited
+}
+
+// Replay map bindings in source order. Objects and version numbers are local to
+// one expanded path; unknown calls invalidate only maps actually passed to them.
+func f2pPathUpdate(m *f2pModel, fn *funcInfo, path *f2pOutputPath, stmt ast.Stmt) {
+	f2pPathCalls(m, fn, path, stmt)
+	assign := func(left, right []ast.Expr) {
+		refs := make([]string, len(left))
+		formats := make([]f2pPathFormatValue, len(left))
+		meta := make([]bool, len(left))
+		transformed := map[string]bool{}
+		for i := range left {
+			if len(left) == len(right) {
+				refs[i] = f2pPathMapRef(path, right[i])
+				if id, ok := right[i].(*ast.Ident); ok {
+					formats[i] = path.formatted[id.Name]
+				}
+				switch value := right[i].(type) {
+				case *ast.CompositeLit:
+					if _, ok := value.Type.(*ast.MapType); ok {
+						refs[i] = "map:" + strconv.Itoa(int(value.Pos()))
+					}
+				case *ast.CallExpr:
+					if id, ok := value.Fun.(*ast.Ident); ok && id.Name == "make" && len(value.Args) > 0 {
+						if _, ok := value.Args[0].(*ast.MapType); ok {
+							refs[i] = "map:" + strconv.Itoa(int(value.Pos()))
+						}
+					}
+				}
+			}
+			if len(right) == 1 {
+				if call, ok := right[0].(*ast.CallExpr); ok {
+					results := f2pPathCallResultTypes(m, fn, call)
+					if i < len(results) && f2pPathMapType(results[i]) {
+						refs[i] = "result:" + strconv.Itoa(int(call.Pos())) + ":" + strconv.Itoa(i)
+						meta[i] = true
+						for _, argument := range call.Args {
+							if object := f2pPathMapRef(path, argument); object != "" {
+								transformed[object] = true
+							}
+						}
+					}
+					if target := f2pPathLocalTarget(m, fn, call); target != nil {
+						if i == 0 && target == m.functionByName("Format") && fn.name != "Format" && len(call.Args) == 1 && len(left) == 2 && f2pPathCanonicalFormat(m) {
+							object := f2pPathMapRef(path, call.Args[0])
+							if err, ok := left[1].(*ast.Ident); ok && object != "" {
+								formats[i] = f2pPathFormatValue{object, path.versions[object], err.Name}
+							}
+						}
+					}
+				}
+			}
+		}
+		// A map-returning transform advances the metadata role to its result.
+		// Keep independent maps, but stop requiring an obsolete input snapshot
+		// to be empty when its replacement map controls the output.
+		for name := range path.metadata {
+			if transformed[path.maps[name]] {
+				delete(path.metadata, name)
+			}
+		}
+		for _, lhs := range left {
+			if id, ok := lhs.(*ast.Ident); ok {
+				for name, value := range path.formatted {
+					if value.errorName == id.Name {
+						delete(path.formatted, name)
+					}
+				}
+			}
+		}
+		for i, lhs := range left {
+			if index, ok := lhs.(*ast.IndexExpr); ok {
+				f2pPathMutate(m, path, f2pPathMapRef(path, index.X))
+			}
+			if id, ok := lhs.(*ast.Ident); ok && id.Name != "_" {
+				for key := range path.facts {
+					if f2pPathMentions(key, id.Name) {
+						delete(path.facts, key)
+					}
+				}
+				path.maps[id.Name] = refs[i]
+				delete(path.formatted, id.Name)
+				if formats[i].object != "" {
+					path.formatted[id.Name] = formats[i]
+				}
+				if meta[i] {
+					path.metadata[id.Name] = true
+				}
+			}
+		}
+	}
+	switch value := stmt.(type) {
+	case *ast.AssignStmt:
+		assign(value.Lhs, value.Rhs)
+	case *ast.DeclStmt:
+		if decl, ok := value.Decl.(*ast.GenDecl); ok {
+			for _, spec := range decl.Specs {
+				if value, ok := spec.(*ast.ValueSpec); ok {
+					var left []ast.Expr
+					for _, name := range value.Names {
+						left = append(left, name)
+					}
+					assign(left, value.Values)
+				}
+			}
+		}
+	case *ast.IncDecStmt:
+		if index, ok := value.X.(*ast.IndexExpr); ok {
+			f2pPathMutate(m, path, f2pPathMapRef(path, index.X))
+		}
+	}
+}
+
+// Use declared function/callback result types, independent of helper names.
+// Callback effects remain unknown; only the identity of its returned map is
+// established here, and a later len/Format check must prove that version empty.
+func f2pPathCallResultTypes(m *f2pModel, fn *funcInfo, call *ast.CallExpr) []string {
+	if target := f2pPathLocalTarget(m, fn, call); target != nil {
+		return target.results
+	}
+	id, ok := call.Fun.(*ast.Ident)
+	if !ok {
+		return nil
+	}
+	expression, err := parser.ParseExpr(fn.types[id.Name])
+	if err != nil {
+		return nil
+	}
+	signature, ok := expression.(*ast.FuncType)
+	if !ok || signature.Results == nil {
+		return nil
+	}
+	var results []string
+	for _, field := range signature.Results.List {
+		count := len(field.Names)
+		if count == 0 {
+			count = 1
+		}
+		for i := 0; i < count; i++ {
+			results = append(results, typeString(m.fset, field.Type))
+		}
+	}
+	return results
+}
+
+func f2pPathLocalTarget(m *f2pModel, fn *funcInfo, call *ast.CallExpr) *funcInfo {
+	ref, ok := describeCall(m.fset, fn.imports, call)
+	if !ok || ref.pkg != "" {
+		return nil
+	}
+	for _, target := range m.byName[ref.name] {
+		if ref.receiver == nil && target.recvType == "" && target.parent == nil && fn.types[ref.name] == "" {
+			return target
+		}
+		if ref.receiver != nil && target.operationType() == m.expressionType(fn, ref.receiver) && target.operationType() != "" {
+			return target
+		}
+	}
+	return nil
+}
+
+func f2pPathMutate(m *f2pModel, path *f2pOutputPath, object string) {
+	if object == "" {
+		return
+	}
+	path.versions[object]++
+	for name, ref := range path.maps {
+		if ref != object {
+			continue
+		}
+		for key := range path.facts {
+			if f2pPathMentions(key, name) {
+				delete(path.facts, key)
+			}
+		}
+	}
+}
+
+func f2pPathCalls(m *f2pModel, fn *funcInfo, path *f2pOutputPath, node ast.Node) {
+	ast.Inspect(node, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		ref, described := describeCall(m.fset, fn.imports, call)
+		if !described {
+			return true
+		}
+		target := f2pPathLocalTarget(m, fn, call)
+		for i, argument := range call.Args {
+			object := f2pPathMapRef(path, argument)
+			if object == "" {
+				continue
+			}
+			// Identify the map feeding the actual serializer/full-note pipeline.
+			metadata := ref.name == "Marshal"
+			if target != nil && i < len(target.params) && f2pPathMapType(target.types[target.params[i]]) {
+				values := m.f2pFunctionResults(target, nil, nil, map[*funcInfo]bool{})
+				metadata = metadata || len(values) > 0 && (f2pPathHasKind(values[0], "serialization") || f2pPathHasKind(values[0], "reconstruction"))
+			}
+			if metadata {
+				if id, ok := argument.(*ast.Ident); ok {
+					// The actual map feeding the output pipeline supersedes an
+					// earlier parsed/input snapshot (a transform can return a new map).
+					path.metadata = map[string]bool{id.Name: true}
+				}
+			}
+			readOnly := ref.pkg == "" && (ref.name == "len" || ref.name == "cap") || ref.name == "Marshal"
+			if target != nil {
+				readOnly = f2pPathReadOnlyMap(m, target, i, map[*funcInfo]bool{})
+			}
+			if !readOnly {
+				f2pPathMutate(m, path, object)
+			}
+		}
+		return true
+	})
+}
+
+// Prove only simple read-only map use. Unknown map-taking calls and all heap
+// writes invalidate an empty fact, rather than claiming the map stayed empty.
+func f2pPathReadOnlyMap(m *f2pModel, fn *funcInfo, index int, active map[*funcInfo]bool) bool {
+	if index >= len(fn.params) || active[fn] || len(active) > 16 {
+		return false
+	}
+	active[fn] = true
+	defer delete(active, fn)
+	aliases := map[string]bool{fn.params[index]: true}
+	safe := true
+	ast.Inspect(fn.body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			safe = false
+			return false
+		}
+		mentions := func(expression ast.Expr) bool {
+			found := false
+			ast.Inspect(expression, func(n ast.Node) bool {
+				if id, ok := n.(*ast.Ident); ok && aliases[id.Name] {
+					found = true
+				}
+				return true
+			})
+			return found
+		}
+		switch value := node.(type) {
+		case *ast.AssignStmt:
+			for i, lhs := range value.Lhs {
+				if _, ok := lhs.(*ast.IndexExpr); ok && mentions(lhs) {
+					safe = false
+				}
+				if len(value.Lhs) == len(value.Rhs) && mentions(value.Rhs[i]) {
+					if id, ok := lhs.(*ast.Ident); ok {
+						aliases[id.Name] = true
+					} else {
+						safe = false
+					}
+				}
+			}
+		case *ast.CallExpr:
+			ref, ok := describeCall(m.fset, fn.imports, value)
+			for i, arg := range value.Args {
+				if !mentions(arg) {
+					continue
+				}
+				if ok && (ref.name == "Marshal" || ref.pkg == "" && (ref.name == "len" || ref.name == "cap")) {
+					continue
+				}
+				target := f2pPathLocalTarget(m, fn, value)
+				if target == nil || !f2pPathReadOnlyMap(m, target, i, active) {
+					safe = false
+				}
+			}
+		case *ast.IncDecStmt:
+			if mentions(value.X) {
+				safe = false
+			}
+		}
+		return true
+	})
+	return safe
+}
+
+func f2pPathMentions(expression, name string) bool {
+	for _, word := range strings.FieldsFunc(expression, func(r rune) bool {
+		return !(r == '_' || r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9')
+	}) {
+		if word == name {
+			return true
+		}
+	}
+	return false
+}
+
+func f2pPathAssume(m *f2pModel, path *f2pOutputPath, condition ast.Expr, truth bool) bool {
+	if paren, ok := condition.(*ast.ParenExpr); ok {
+		return f2pPathAssume(m, path, paren.X, truth)
+	}
+	if unary, ok := condition.(*ast.UnaryExpr); ok && unary.Op == token.NOT {
+		return f2pPathAssume(m, path, unary.X, !truth)
+	}
+	if id, ok := condition.(*ast.Ident); ok && (id.Name == "true" || id.Name == "false") {
+		return truth == (id.Name == "true")
+	}
+	key := exprString(m.fset, condition)
+	if binary, ok := condition.(*ast.BinaryExpr); ok {
+		if binary.Op == token.NEQ {
+			copy := *binary
+			copy.Op = token.EQL
+			key = exprString(m.fset, &copy)
+			truth = !truth
+		}
+		// EQL/NEQ were normalized above; length permission is tied to the
+		// referenced metadata object at this exact version.
+		if call, ok := binary.X.(*ast.CallExpr); ok && len(call.Args) == 1 {
+			if id, ok := call.Fun.(*ast.Ident); ok && id.Name == "len" {
+				if zero, ok := binary.Y.(*ast.BasicLit); ok && zero.Value == "0" {
+					if (binary.Op == token.EQL || binary.Op == token.NEQ) && truth || binary.Op == token.GTR && !truth || binary.Op == token.LEQ && truth {
+						if object := f2pPathMapRef(path, call.Args[0]); object != "" {
+							path.emptyMaps[object] = path.versions[object]
+						}
+					}
+				}
+			}
+		}
+		if binary.Op == token.EQL || binary.Op == token.NEQ {
+			if literal, ok := binary.Y.(*ast.BasicLit); ok && literal.Kind == token.STRING && truth {
+				text, err := strconv.Unquote(literal.Value)
+				if id, ok := binary.X.(*ast.Ident); ok && err == nil && text == "" {
+					if value, known := path.formatted[id.Name]; known && value.version == path.versions[value.object] {
+						nilFact := exprString(m.fset, &ast.BinaryExpr{X: ast.NewIdent(value.errorName), Op: token.EQL, Y: ast.NewIdent("nil")})
+						if path.facts[nilFact] {
+							path.emptyMaps[value.object] = value.version
+						}
+					}
+				}
+			}
+		}
+	}
+	if known, ok := path.facts[key]; ok && known != truth {
+		return false
+	}
+	path.facts[key] = truth
+	return true
+}
+
+func f2pPathErrorReturn(m *f2pModel, path f2pOutputPath) bool {
+	ret := path.result
+	if len(ret.Results) < 2 {
+		return false // A delegated call may return a successful note.
+	}
+	err := ret.Results[len(ret.Results)-1]
+	if id, ok := err.(*ast.Ident); ok && id.Name == "nil" {
+		return false
+	}
+	key := exprString(m.fset, &ast.BinaryExpr{X: err, Op: token.EQL, Y: ast.NewIdent("nil")})
+	if nilValue, known := path.facts[key]; known && !nilValue {
+		return true
+	}
+	if call, ok := err.(*ast.CallExpr); ok {
+		if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+			if pkg, ok := sel.X.(*ast.Ident); ok {
+				return pkg.Name == "errors" && sel.Sel.Name == "New" || pkg.Name == "fmt" && sel.Sel.Name == "Errorf"
+			}
+		}
+	}
+	return false
+}
+
+func f2pPathEmptyBody(m *f2pModel, fn *funcInfo, path f2pOutputPath) bool {
+	if len(path.result.Results) != 2 || !f2pPathEmptyMap(path) {
+		return false
+	}
+	// Follow local result aliases but do not exempt arbitrary empty-map returns.
+	expression := path.result.Results[0]
+	for depth := 0; depth < 16; depth++ {
+		id, alias := expression.(*ast.Ident)
+		if !alias {
+			break
+		}
+		var replacement ast.Expr
+		for _, stmt := range path.statements {
+			if assignment, ok := stmt.(*ast.AssignStmt); ok {
+				for i, lhs := range assignment.Lhs {
+					if name, ok := lhs.(*ast.Ident); ok && name.Name == id.Name && len(assignment.Lhs) == len(assignment.Rhs) {
+						replacement = assignment.Rhs[i]
+					}
+				}
+			}
+		}
+		if replacement == nil {
+			return false
+		}
+		expression = replacement
+	}
+	call, ok := expression.(*ast.CallExpr)
+	if !ok || len(call.Args) != 2 {
+		return false
+	}
+	sel, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok || sel.Sel.Name != "TrimPrefix" {
+		return false
+	}
+	pkg, ok := sel.X.(*ast.Ident)
+	if !ok || pkg.Name != "strings" {
+		return false
+	}
+	literal, ok := call.Args[1].(*ast.BasicLit)
+	if !ok || literal.Kind != token.STRING {
+		return false
+	}
+	prefix, err := strconv.Unquote(literal.Value)
+	return err == nil && prefix == "\n"
+}
+
+// Recognize the canonical local Format empty-map contract, rather than treating
+// an arbitrary empty string comparison as permission to bypass reconstruction.
+func f2pPathCanonicalFormat(m *f2pModel) bool {
+	format := m.functionByName("Format")
+	if format == nil || len(format.params) != 1 {
+		return false
+	}
+	values := m.f2pFunctionResults(format, nil, nil, map[*funcInfo]bool{})
+	if len(values) == 0 || !f2pPathHasKind(values[0], "serialization") {
+		return false
+	}
+	canonical := false
+	for _, statement := range format.body.List {
+		branch, ok := statement.(*ast.IfStmt)
+		if !ok {
+			continue
+		}
+		condition, ok := branch.Cond.(*ast.BinaryExpr)
+		if !ok || condition.Op != token.EQL {
+			continue
+		}
+		call, ok := condition.X.(*ast.CallExpr)
+		if !ok || len(call.Args) != 1 {
+			continue
+		}
+		name, ok := call.Fun.(*ast.Ident)
+		if !ok || name.Name != "len" {
+			continue
+		}
+		parameter, ok := call.Args[0].(*ast.Ident)
+		if !ok || parameter.Name != format.params[0] {
+			continue
+		}
+		zero, ok := condition.Y.(*ast.BasicLit)
+		if !ok || zero.Value != "0" {
+			continue
+		}
+		if len(branch.Body.List) != 1 {
+			continue
+		}
+		result, ok := branch.Body.List[0].(*ast.ReturnStmt)
+		if !ok || len(result.Results) != 2 {
+			continue
+		}
+		text, ok := result.Results[0].(*ast.BasicLit)
+		if !ok || text.Kind != token.STRING {
+			continue
+		}
+		empty, err := strconv.Unquote(text.Value)
+		nilError, ok := result.Results[1].(*ast.Ident)
+		if err == nil && empty == "" && ok && nilError.Name == "nil" {
+			canonical = true
+		}
+	}
+	if !canonical {
+		return false
+	}
+	paths, limited := f2pExpandOutputPaths(m, format)
+	if limited {
+		return false
+	}
+	for _, path := range paths {
+		if path.result == nil || f2pPathErrorReturn(m, path) {
+			continue
+		}
+		if len(path.result.Results) > 0 {
+			if literal, ok := path.result.Results[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {
+				if text, err := strconv.Unquote(literal.Value); err == nil && text == "" {
+					if !f2pPathEmptyMap(path) {
+						return false
+					}
+					continue
+				}
+			}
+		}
+		clone := *format
+		clone.body = &ast.BlockStmt{List: path.statements}
+		values := m.f2pFunctionResults(&clone, nil, nil, map[*funcInfo]bool{})
+		if len(values) == 0 || !f2pPathHasKind(values[0], "serialization") {
+			return false
+		}
+	}
+	return true
+}
diff --git a/tests/f2p/f2p_structural_test.go b/tests/f2p/f2p_structural_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..983700dc2c56f9f2cd69f9ee4a4c4c5940fffd6e
--- /dev/null
+++ b/tests/f2p/f2p_structural_test.go
@@ -0,0 +1,2651 @@
+// Package f2p checks the consolidation obligations independently of runtime
+// regressions. Nodes describe ownership and shared implementation relationships;
+// private names, parameter counts, constructor shape and delegation depth are free.
+// The AST model is deliberately local to the directly affected production packages.
+package f2p
+
+import (
+	"bytes"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/printer"
+	"go/token"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// Capability identifiers used across the structural nodes.
+const (
+	printCapability  = "print"
+	editCapability   = "edit"
+	deleteCapability = "delete"
+)
+
+// capabilityCalls maps the public pkg/frontmatter entry point that implements a
+// capability to the capability it belongs to.
+var capabilityCalls = map[string]string{
+	"HasFrontmatter": printCapability,
+	"SetKey":         editCapability,
+	"DeleteKey":      deleteCapability,
+}
+
+var allCapabilities = []string{printCapability, editCapability, deleteCapability}
+
+// ---------------------------------------------------------------------------
+// Source model
+// ---------------------------------------------------------------------------
+
+type argRef struct {
+	text  string
+	field bool
+	root  string
+}
+
+type callRef struct {
+	pkg      string
+	name     string
+	args     []argRef
+	line     int
+	receiver ast.Expr
+}
+
+type selRef struct {
+	root string
+	sel  string
+}
+
+type litRef struct {
+	typeName string
+	values   []string
+}
+
+type assignRef struct {
+	lhs   []string
+	calls []string
+}
+
+type funcInfo struct {
+	id               string
+	name             string
+	recvType         string
+	recvName         string
+	params           []string
+	results          []string
+	file             string
+	line             int
+	calls            []callRef
+	sels             []selRef
+	lits             []litRef
+	assigns          []assignRef
+	hasDelimiterJoin bool
+	ownerType        string
+	parent           *funcInfo
+	body             *ast.BlockStmt
+	imports          map[string]bool
+	types            map[string]string
+	uses             map[string]bool
+	locals           map[string]bool
+}
+
+type pkgModel struct {
+	dir        string
+	funcs      []*funcInfo
+	byName     map[string][]*funcInfo
+	strFields  map[string][]string
+	fieldTypes map[string]map[string]string
+	fieldOrder map[string][]string
+	interfaces map[string][]string
+	fset       *token.FileSet
+}
+
+func (fn *funcInfo) identifier() string {
+	if fn.recvType == "" {
+		return fn.name
+	}
+	return "(" + fn.recvType + ")." + fn.name
+}
+
+func (fn *funcInfo) operationType() string {
+	if fn.ownerType != "" {
+		return fn.ownerType
+	}
+	return fn.recvType
+}
+
+// ---------------------------------------------------------------------------
+// Repository / package loading
+// ---------------------------------------------------------------------------
+
+func findRepoRoot(t *testing.T) string {
+	t.Helper()
+	if _, file, _, ok := runtime.Caller(0); ok {
+		dir := filepath.Dir(filepath.Dir(filepath.Dir(file)))
+		if isRepoRoot(dir) {
+			return dir
+		}
+	}
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("cannot determine the working directory: %v", err)
+	}
+	for {
+		if isRepoRoot(dir) {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatalf("could not locate the repository root (go.mod of github.com/Yakitrak/notesmd-cli) above %s", dir)
+		}
+		dir = parent
+	}
+}
+
+func isRepoRoot(dir string) bool {
+	data, err := os.ReadFile(filepath.Join(dir, "go.mod"))
+	if err != nil {
+		return false
+	}
+	return strings.Contains(string(data), "module github.com/Yakitrak/notesmd-cli")
+}
+
+func mustPackage(t *testing.T, root string, elems ...string) *pkgModel {
+	t.Helper()
+	dir := filepath.Join(append([]string{root}, elems...)...)
+	model, err := loadPackage(dir)
+	if err != nil {
+		t.Fatalf("cannot load the production sources of %s: %v", dir, err)
+	}
+	if len(model.funcs) == 0 {
+		t.Fatalf("no production function declarations found in %s", dir)
+	}
+	return model
+}
+
+func loadPackage(dir string) (*pkgModel, error) {
+	fset := token.NewFileSet()
+	model := &pkgModel{
+		dir:        dir,
+		byName:     map[string][]*funcInfo{},
+		strFields:  map[string][]string{},
+		fieldTypes: map[string]map[string]string{},
+		fieldOrder: map[string][]string{},
+		interfaces: map[string][]string{},
+		fset:       fset,
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, err
+	}
+	names := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		path := filepath.Join(dir, name)
+		file, err := parser.ParseFile(fset, path, nil, parser.SkipObjectResolution)
+		if err != nil {
+			return nil, fmt.Errorf("parse %s: %w", path, err)
+		}
+		imports := map[string]bool{}
+		for _, spec := range file.Imports {
+			importPath := strings.Trim(spec.Path.Value, `"`)
+			alias := filepath.Base(importPath)
+			if spec.Name != nil {
+				alias = spec.Name.Name
+			}
+			if alias == "_" || alias == "." {
+				continue
+			}
+			imports[alias] = true
+			// Normalize the frontmatter package identity independently of its local alias.
+			if importPath == "github.com/Yakitrak/notesmd-cli/pkg/frontmatter" {
+				imports["@frontmatter:"+alias] = true
+			}
+		}
+		for _, decl := range file.Decls {
+			switch d := decl.(type) {
+			case *ast.GenDecl:
+				if d.Tok != token.TYPE {
+					continue
+				}
+				for _, spec := range d.Specs {
+					typeSpec, ok := spec.(*ast.TypeSpec)
+					if !ok {
+						continue
+					}
+					if iface, ok := typeSpec.Type.(*ast.InterfaceType); ok && iface.Methods != nil {
+						for _, field := range iface.Methods.List {
+							for _, name := range field.Names {
+								model.interfaces[typeSpec.Name.Name] = append(model.interfaces[typeSpec.Name.Name], name.Name)
+							}
+						}
+					}
+					structType, ok := typeSpec.Type.(*ast.StructType)
+					if !ok || structType.Fields == nil {
+						continue
+					}
+					model.fieldTypes[typeSpec.Name.Name] = map[string]string{}
+					for _, field := range structType.Fields.List {
+						for _, fieldName := range field.Names {
+							model.fieldTypes[typeSpec.Name.Name][fieldName.Name] = strings.TrimPrefix(typeString(fset, field.Type), "*")
+							model.fieldOrder[typeSpec.Name.Name] = append(model.fieldOrder[typeSpec.Name.Name], fieldName.Name)
+						}
+						if typeString(fset, field.Type) != "string" || len(field.Names) == 0 {
+							continue
+						}
+						for _, fieldName := range field.Names {
+							model.strFields[typeSpec.Name.Name] = append(model.strFields[typeSpec.Name.Name], fieldName.Name)
+						}
+					}
+				}
+			case *ast.FuncDecl:
+				if d.Body == nil {
+					continue
+				}
+				fn := collectFunc(fset, imports, path, d)
+				model.funcs = append(model.funcs, fn)
+				model.byName[fn.name] = append(model.byName[fn.name], fn)
+			}
+		}
+	}
+	for _, fn := range model.funcs {
+		model.inferTypes(fn)
+	}
+	for _, fn := range append([]*funcInfo(nil), model.funcs...) {
+		model.collectClosures(fn)
+	}
+	return model, nil
+}
+
+func collectFunc(fset *token.FileSet, imports map[string]bool, path string, decl *ast.FuncDecl) *funcInfo {
+	fn := &funcInfo{
+		name:    decl.Name.Name,
+		file:    path,
+		line:    fset.Position(decl.Pos()).Line,
+		body:    decl.Body,
+		imports: imports,
+		types:   map[string]string{},
+		uses:    map[string]bool{},
+		locals:  map[string]bool{},
+	}
+	if decl.Recv != nil && len(decl.Recv.List) > 0 {
+		fn.recvType = receiverTypeName(decl.Recv.List[0].Type)
+		if len(decl.Recv.List[0].Names) > 0 {
+			fn.recvName = decl.Recv.List[0].Names[0].Name
+			fn.types[fn.recvName] = fn.recvType
+		}
+	}
+	if decl.Type.Params != nil {
+		for _, field := range decl.Type.Params.List {
+			if len(field.Names) == 0 {
+				fn.params = append(fn.params, "_")
+				continue
+			}
+			for _, paramName := range field.Names {
+				fn.params = append(fn.params, paramName.Name)
+				fn.types[paramName.Name] = strings.TrimPrefix(typeString(fset, field.Type), "*")
+			}
+		}
+	}
+	if decl.Type.Results != nil {
+		for _, field := range decl.Type.Results.List {
+			text := typeString(fset, field.Type)
+			if len(field.Names) == 0 {
+				fn.results = append(fn.results, text)
+				continue
+			}
+			for range field.Names {
+				fn.results = append(fn.results, text)
+			}
+		}
+	}
+	fn.id = fn.identifier()
+	fn.hasDelimiterJoin = bodyHasDelimiterJoin(decl.Body)
+
+	ast.Inspect(decl.Body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		switch n := node.(type) {
+		case *ast.Ident:
+			fn.uses[n.Name] = true
+		case *ast.ValueSpec:
+			for _, name := range n.Names {
+				fn.locals[name.Name] = true
+			}
+		case *ast.AssignStmt:
+			assign := assignRef{}
+			for _, lhs := range n.Lhs {
+				if id, ok := lhs.(*ast.Ident); ok {
+					assign.lhs = append(assign.lhs, id.Name)
+					if n.Tok == token.DEFINE {
+						fn.locals[id.Name] = true
+					}
+				}
+			}
+			for _, rhs := range n.Rhs {
+				ast.Inspect(rhs, func(inner ast.Node) bool {
+					if call, ok := inner.(*ast.CallExpr); ok {
+						if name, ok := calleeName(call.Fun); ok {
+							assign.calls = append(assign.calls, name)
+						}
+					}
+					return true
+				})
+			}
+			fn.assigns = append(fn.assigns, assign)
+		case *ast.CallExpr:
+			if call, ok := describeCall(fset, imports, n); ok {
+				fn.calls = append(fn.calls, call)
+			}
+		case *ast.SelectorExpr:
+			if root, ok := rootIdentName(n.X); ok {
+				fn.sels = append(fn.sels, selRef{root: root, sel: n.Sel.Name})
+			}
+		case *ast.CompositeLit:
+			lit := litRef{typeName: typeString(fset, n.Type)}
+			for _, elt := range n.Elts {
+				switch e := elt.(type) {
+				case *ast.KeyValueExpr:
+					if id, ok := e.Value.(*ast.Ident); ok {
+						lit.values = append(lit.values, id.Name)
+					}
+				case *ast.Ident:
+					lit.values = append(lit.values, e.Name)
+				}
+			}
+			fn.lits = append(fn.lits, lit)
+		}
+		return true
+	})
+	return fn
+}
+
+func describeCall(fset *token.FileSet, imports map[string]bool, call *ast.CallExpr) (callRef, bool) {
+	ref := callRef{line: fset.Position(call.Pos()).Line}
+	switch fun := call.Fun.(type) {
+	case *ast.Ident:
+		ref.name = fun.Name
+	case *ast.SelectorExpr:
+		ref.name = fun.Sel.Name
+		if id, ok := fun.X.(*ast.Ident); ok && imports[id.Name] {
+			ref.pkg = id.Name
+			if imports["@frontmatter:"+id.Name] {
+				ref.pkg = "frontmatter"
+			}
+		} else {
+			ref.receiver = fun.X
+		}
+	default:
+		return ref, false
+	}
+	for _, arg := range call.Args {
+		root, _ := rootIdentName(arg)
+		ref.args = append(ref.args, argRef{text: exprString(fset, arg), field: isFieldAccess(arg), root: root})
+	}
+	return ref, true
+}
+
+func (model *pkgModel) expressionType(fn *funcInfo, expression ast.Expr) string {
+	switch value := expression.(type) {
+	case *ast.Ident:
+		return fn.types[value.Name]
+	case *ast.CompositeLit:
+		return strings.TrimPrefix(typeString(model.fset, value.Type), "*")
+	case *ast.UnaryExpr:
+		return model.expressionType(fn, value.X)
+	case *ast.StarExpr:
+		return model.expressionType(fn, value.X)
+	case *ast.ParenExpr:
+		return model.expressionType(fn, value.X)
+	case *ast.SelectorExpr:
+		return model.fieldTypes[model.expressionType(fn, value.X)][value.Sel.Name]
+	case *ast.CallExpr:
+		if method, ok := value.Fun.(*ast.SelectorExpr); ok {
+			owner := model.expressionType(fn, method.X)
+			for _, target := range model.byName[method.Sel.Name] {
+				if target.operationType() == owner && len(target.results) > 0 {
+					return strings.TrimPrefix(target.results[0], "*")
+				}
+			}
+		}
+		if name, ok := value.Fun.(*ast.Ident); ok {
+			if target := model.functionByName(name.Name); target != nil && len(target.results) > 0 {
+				return strings.TrimPrefix(target.results[0], "*")
+			}
+		}
+	}
+	return ""
+}
+
+func (model *pkgModel) inferTypes(fn *funcInfo) {
+	declared := map[string]string{}
+	ast.Inspect(fn.body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		if spec, ok := node.(*ast.ValueSpec); ok && spec.Type != nil {
+			for _, name := range spec.Names {
+				declared[name.Name] = strings.TrimPrefix(typeString(model.fset, spec.Type), "*")
+			}
+		}
+		return true
+	})
+	for pass := 0; pass <= len(fn.assigns)+len(fn.params)+1; pass++ {
+		changed := false
+		bind := func(name, typeName string) {
+			if explicit := declared[name]; explicit != "" {
+				typeName = explicit
+			}
+			if name != "_" && typeName != "" && fn.types[name] != typeName {
+				fn.types[name] = typeName
+				changed = true
+			}
+		}
+		ast.Inspect(fn.body, func(node ast.Node) bool {
+			if _, nested := node.(*ast.FuncLit); nested {
+				return false
+			}
+			switch statement := node.(type) {
+			case *ast.AssignStmt:
+				for index, expression := range statement.Rhs {
+					if index >= len(statement.Lhs) {
+						break
+					}
+					if name, ok := statement.Lhs[index].(*ast.Ident); ok {
+						bind(name.Name, model.expressionType(fn, expression))
+					}
+				}
+			case *ast.ValueSpec:
+				for index, name := range statement.Names {
+					if statement.Type != nil {
+						bind(name.Name, strings.TrimPrefix(typeString(model.fset, statement.Type), "*"))
+					} else if index < len(statement.Values) {
+						bind(name.Name, model.expressionType(fn, statement.Values[index]))
+					}
+				}
+			}
+			return true
+		})
+		if !changed {
+			break
+		}
+	}
+}
+
+func (model *pkgModel) collectClosures(parent *funcInfo) {
+	register := func(ownerType, member string, literal *ast.FuncLit) {
+		if ownerType == "" || model.fieldTypes[ownerType][member] == "" {
+			return
+		}
+		declaration := &ast.FuncDecl{
+			Name: &ast.Ident{Name: member, NamePos: literal.Pos()},
+			Type: literal.Type,
+			Body: literal.Body,
+		}
+		closure := collectFunc(model.fset, parent.imports, parent.file, declaration)
+		closure.ownerType = ownerType
+		closure.parent = parent
+		closure.id = fmt.Sprintf("(%s).%s@%d", ownerType, member, closure.line)
+		inherited := map[string]string{}
+		for name, typeName := range parent.types {
+			inherited[name] = typeName
+		}
+		for name, typeName := range closure.types {
+			inherited[name] = typeName
+		}
+		closure.types = inherited
+		model.inferTypes(closure)
+		model.funcs = append(model.funcs, closure)
+		model.byName[member] = append(model.byName[member], closure)
+		model.collectClosures(closure)
+	}
+	ast.Inspect(parent.body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		switch statement := node.(type) {
+		case *ast.AssignStmt:
+			for index, expression := range statement.Rhs {
+				literal, ok := expression.(*ast.FuncLit)
+				if !ok || index >= len(statement.Lhs) {
+					continue
+				}
+				if target, ok := statement.Lhs[index].(*ast.SelectorExpr); ok {
+					register(model.expressionType(parent, target.X), target.Sel.Name, literal)
+				}
+			}
+		case *ast.CompositeLit:
+			ownerType := model.expressionType(parent, statement)
+			for _, element := range statement.Elts {
+				entry, ok := element.(*ast.KeyValueExpr)
+				if !ok {
+					continue
+				}
+				member, named := entry.Key.(*ast.Ident)
+				value := entry.Value
+				// A named function type can adapt a closure to an interface.
+				if conversion, ok := value.(*ast.CallExpr); ok && len(conversion.Args) == 1 {
+					value = conversion.Args[0]
+				}
+				literal, callable := value.(*ast.FuncLit)
+				if named && callable {
+					register(ownerType, member.Name, literal)
+				}
+			}
+		}
+		return true
+	})
+}
+
+func calleeName(fun ast.Expr) (string, bool) {
+	switch f := fun.(type) {
+	case *ast.Ident:
+		return f.Name, true
+	case *ast.SelectorExpr:
+		return f.Sel.Name, true
+	}
+	return "", false
+}
+
+func receiverTypeName(expr ast.Expr) string {
+	switch t := expr.(type) {
+	case *ast.StarExpr:
+		return receiverTypeName(t.X)
+	case *ast.Ident:
+		return t.Name
+	case *ast.IndexExpr:
+		return receiverTypeName(t.X)
+	case *ast.IndexListExpr:
+		return receiverTypeName(t.X)
+	}
+	return ""
+}
+
+func rootIdentName(expr ast.Expr) (string, bool) {
+	switch e := expr.(type) {
+	case *ast.Ident:
+		return e.Name, true
+	case *ast.SelectorExpr:
+		return rootIdentName(e.X)
+	case *ast.StarExpr:
+		return rootIdentName(e.X)
+	case *ast.IndexExpr:
+		return rootIdentName(e.X)
+	case *ast.ParenExpr:
+		return rootIdentName(e.X)
+	}
+	return "", false
+}
+
+func isFieldAccess(expr ast.Expr) bool {
+	switch e := expr.(type) {
+	case *ast.SelectorExpr:
+		return true
+	case *ast.StarExpr:
+		return isFieldAccess(e.X)
+	case *ast.ParenExpr:
+		return isFieldAccess(e.X)
+	case *ast.IndexExpr:
+		return isFieldAccess(e.X)
+	}
+	return false
+}
+
+func typeString(fset *token.FileSet, expr ast.Expr) string {
+	if expr == nil {
+		return ""
+	}
+	var buf bytes.Buffer
+	if err := printer.Fprint(&buf, fset, expr); err != nil {
+		return ""
+	}
+	return buf.String()
+}
+
+func exprString(fset *token.FileSet, expr ast.Expr) string {
+	return typeString(fset, expr)
+}
+
+func bodyHasDelimiterJoin(body *ast.BlockStmt) bool {
+	found := false
+	ast.Inspect(body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		if found {
+			return false
+		}
+		var expression ast.Expr
+		switch n := node.(type) {
+		case *ast.BinaryExpr:
+			if n.Op == token.ADD {
+				expression = n
+			}
+		case *ast.CallExpr:
+			expression = n // fmt.Sprintf, strings.Join and Builder.WriteString
+		}
+		if expression != nil && containsDelimiterOperand(expression) {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
+
+func containsDelimiterOperand(expr ast.Expr) bool {
+	found := false
+	ast.Inspect(expr, func(node ast.Node) bool {
+		if found {
+			return false
+		}
+		switch n := node.(type) {
+		case *ast.BasicLit:
+			if n.Kind != token.STRING {
+				return true
+			}
+			if value, err := strconv.Unquote(n.Value); err == nil && strings.Contains(value, "---") {
+				found = true
+			}
+		case *ast.Ident:
+			if n.Name == "Delimiter" {
+				found = true
+			}
+		}
+		return !found
+	})
+	return found
+}
+
+// ---------------------------------------------------------------------------
+// Model queries
+// ---------------------------------------------------------------------------
+
+func (m *pkgModel) functionByName(name string) *funcInfo {
+	for _, fn := range m.funcs {
+		if fn.name == name && fn.recvType == "" && fn.parent == nil {
+			return fn
+		}
+	}
+	return nil
+}
+
+func (m *pkgModel) methodsOfType(typ string) []*funcInfo {
+	var out []*funcInfo
+	for _, fn := range m.funcs {
+		if fn.operationType() == typ {
+			out = append(out, fn)
+		}
+	}
+	return out
+}
+
+func (m *pkgModel) callees(fn *funcInfo) []*funcInfo {
+	var out []*funcInfo
+	for _, call := range fn.calls {
+		if call.pkg != "" {
+			continue
+		}
+		if field, ok := call.receiver.(*ast.SelectorExpr); ok {
+			for _, closure := range m.byName[field.Sel.Name] {
+				if closure.parent != nil && closure.ownerType == m.expressionType(fn, field.X) {
+					out = append(out, closure)
+				}
+			}
+		}
+		for _, target := range m.byName[call.name] {
+			if call.receiver == nil {
+				if target.operationType() == "" && target.parent == nil {
+					out = append(out, target)
+				}
+			} else if ownerType := m.expressionType(fn, call.receiver); ownerType != "" && (target.operationType() == ownerType || m.implements(target.operationType(), ownerType)) {
+				out = append(out, target)
+			}
+		}
+	}
+	return out
+}
+
+// Expand locally declared interfaces by their complete method set. This
+// accepts capability interfaces without treating arbitrary same-named methods
+// as edges. External interfaces remain outside this small source model.
+func (m *pkgModel) implements(concrete, iface string) bool {
+	methods := m.interfaces[iface]
+	if concrete == "" || len(methods) == 0 {
+		return false
+	}
+	for _, name := range methods {
+		found := false
+		for _, fn := range m.byName[name] {
+			if fn.operationType() == concrete {
+				found = true
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+func (m *pkgModel) closureSet(fn *funcInfo) map[*funcInfo]bool {
+	seen := map[*funcInfo]bool{fn: true}
+	queue := []*funcInfo{fn}
+	for len(queue) > 0 {
+		current := queue[0]
+		queue = queue[1:]
+		for _, next := range m.callees(current) {
+			if !seen[next] {
+				seen[next] = true
+				queue = append(queue, next)
+			}
+		}
+	}
+	return seen
+}
+
+func (m *pkgModel) closure(fn *funcInfo) []*funcInfo {
+	set := m.closureSet(fn)
+	out := make([]*funcInfo, 0, len(set))
+	for reached := range set {
+		out = append(out, reached)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].id < out[j].id })
+	return out
+}
+
+func (m *pkgModel) reachesCall(fn *funcInfo, pkg, name string) bool {
+	for _, reached := range m.closure(fn) {
+		for _, call := range reached.calls {
+			if call.pkg == pkg && call.name == name {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (m *pkgModel) reachesCapability(fn *funcInfo, capability string) bool {
+	if capability == printCapability {
+		// Printing may use Parse/Format directly and need not call HasFrontmatter.
+		return m.reachesCall(fn, "frontmatter", "Parse") && m.reachesCall(fn, "frontmatter", "Format")
+	}
+	for _, reached := range m.closure(fn) {
+		for _, call := range reached.calls {
+			if call.pkg == "frontmatter" && capabilityCalls[call.name] == capability {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (m *pkgModel) exclusiveCapability(fn *funcInfo, capability string) bool {
+	if !m.reachesCapability(fn, capability) {
+		return false
+	}
+	for _, other := range allCapabilities {
+		if other != capability && m.reachesCapability(fn, other) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m *pkgModel) readsSelectionFlags(fn *funcInfo) bool {
+	for _, reached := range m.closure(fn) {
+		found := false
+		ast.Inspect(reached.body, func(node ast.Node) bool {
+			if _, nested := node.(*ast.FuncLit); nested {
+				return false
+			}
+			sel, ok := node.(*ast.SelectorExpr)
+			if !ok || m.expressionType(reached, sel.X) != "FrontmatterParams" {
+				return true
+			}
+			switch sel.Sel.Name {
+			case "Print", "Edit", "Delete":
+				found = true
+			}
+			return !found
+		})
+		if found {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *pkgModel) operationAbstractionType() string {
+	exposed := map[string]map[string]bool{}
+	entry := m.functionByName("Frontmatter")
+	if entry == nil {
+		return ""
+	}
+	reachable := m.closureSet(entry)
+	for _, fn := range m.funcs {
+		if !reachable[fn] {
+			continue
+		}
+		ownerType := fn.operationType()
+		if ownerType == "" {
+			continue
+		}
+		for _, capability := range allCapabilities {
+			if m.exclusiveCapability(fn, capability) {
+				if exposed[ownerType] == nil {
+					exposed[ownerType] = map[string]bool{}
+				}
+				exposed[ownerType][capability] = true
+			}
+		}
+	}
+	var candidates []string
+	for typ, capabilities := range exposed {
+		if len(capabilities) == len(allCapabilities) {
+			candidates = append(candidates, typ)
+		}
+	}
+	sort.Strings(candidates)
+	if len(candidates) > 0 {
+		return candidates[0]
+	}
+	// Capabilities can be separate wrappers composed around one owned context.
+	// Discover shared local context types through composition, without requiring
+	// all three capability methods on the same concrete receiver.
+	for context := range m.fieldTypes {
+		capabilities := map[string]bool{}
+		for _, fn := range m.funcs {
+			if !reachable[fn] || fn.operationType() == "" || !m.ownedType(context, fn.operationType(), map[string]bool{}) {
+				continue
+			}
+			for _, capability := range allCapabilities {
+				if m.exclusiveCapability(fn, capability) {
+					capabilities[capability] = true
+				}
+			}
+		}
+		if len(capabilities) == len(allCapabilities) {
+			candidates = append(candidates, context)
+		}
+	}
+	sort.Strings(candidates)
+	if len(candidates) == 0 {
+		return ""
+	}
+	return candidates[0]
+}
+
+// Include entry-reachable wrappers that own the selected context by composition.
+// Subsequent nodes inspect their actual capability bodies and arguments.
+func (m *pkgModel) operationMethods(owner string) []*funcInfo {
+	entry := m.functionByName("Frontmatter")
+	if entry == nil {
+		return nil
+	}
+	reachable := m.closureSet(entry)
+	var out []*funcInfo
+	for _, fn := range m.funcs {
+		if reachable[fn] && fn.operationType() != "" && m.ownedType(owner, fn.operationType(), map[string]bool{}) {
+			out = append(out, fn)
+		}
+	}
+	return out
+}
+
+func relPath(path string) string {
+	if idx := strings.Index(path, string(filepath.Separator)+"pkg"+string(filepath.Separator)); idx >= 0 {
+		return path[idx+1:]
+	}
+	if idx := strings.Index(path, string(filepath.Separator)+"cmd"+string(filepath.Separator)); idx >= 0 {
+		return path[idx+1:]
+	}
+	return path
+}
