+package frontmatter_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/Yakitrak/notesmd-cli/pkg/frontmatter"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestP2PSetKeyPreservesStringAndSequenceConversionEdges(t *testing.T) {
+	rows := []struct{ input, yaml string }{
+		{"TRUE", "value: \"TRUE\"\n"}, {"False", "value: \"False\"\n"}, {"null", "value: \"null\"\n"},
+		{"[one, ,true,123]", "value:\n    - one\n    - \"\"\n    - \"true\"\n    - \"123\"\n"},
+		{"[ ]", "value:\n    - \"\"\n"}, {"[one", "value: '[one'\n"},
+	}
+	for _, content := range []string{"Body", "---\n---\nBody", "---\nvalue: Old\n---\nBody"} {
+		for _, row := range rows {
+			got, err := frontmatter.SetKey(content, "value", row.input)
+			assert.NoError(t, err)
+			assert.Equal(t, "---\n"+row.yaml+"---\nBody", got, "input=%q", row.input)
+		}
+	}
+}
+func TestP2PTransformsPreserveBodyBytes(t *testing.T) {
+	for _, body := range []string{"", "\n", "\n\nBody\n", "Body\r\nsecond\r\n", "---\nbody delimiter\n", "\tBody\n\n"} {
+		content := "---\ntitle: Old\nkeep: retained\n---\n" + body
+		set, err := frontmatter.SetKey(content, "title", "New")
+		assert.NoError(t, err)
+		assert.Equal(t, "---\nkeep: retained\ntitle: New\n---\n"+body, set)
+		deleted, err := frontmatter.DeleteKey(content, "title")
+		assert.NoError(t, err)
+		assert.Equal(t, "---\nkeep: retained\n---\n"+body, deleted)
+		created, err := frontmatter.SetKey(body, "title", "New")
+		if !strings.HasPrefix(body, "---") {
+			assert.NoError(t, err)
+			assert.Equal(t, "---\ntitle: New\n---\n"+body, created)
+		}
+	}
+}
+func TestP2PDeleteMissingKeyPreservesNonemptyMap(t *testing.T) {
+	got, err := frontmatter.DeleteKey("---\ntitle: Old\n---\n\nBody\n", "missing")
+	assert.NoError(t, err)
+	assert.Equal(t, "---\ntitle: Old\n---\n\nBody\n", got)
+}
+func TestP2PParsePreservesNilVersusEmptyMap(t *testing.T) {
+	for _, row := range []struct {
+		content string
+		nilMap  bool
+	}{
+		{"Body", true}, {"---\n---\nBody", true}, {"---\nnull\n---\nBody", true}, {"---\n{}\n---\nBody", false},
+	} {
+		fm, body, err := frontmatter.Parse(row.content)
+		assert.NoError(t, err)
+		assert.Equal(t, "Body", body)
+		assert.Empty(t, fm)
+		if row.nilMap {
+			assert.Nil(t, fm)
+		} else {
+			assert.NotNil(t, fm)
+		}
+	}
+}
+
+func TestP2PFormatPreservesNestedYAML(t *testing.T) {
+	got, err := frontmatter.Format(map[string]interface{}{"title": "A: B", "tags": []string{"one", "two"}, "meta": map[string]interface{}{"draft": false, "count": 2}})
+	assert.NoError(t, err)
+	assert.Equal(t, "meta:\n    count: 2\n    draft: false\ntags:\n    - one\n    - two\ntitle: 'A: B'\n", got)
+}
+
+func TestP2PSetKeyCreatesFromParsedNilMap(t *testing.T) {
+	for _, content := range []string{"---\n---\nBody", "---\nnull\n---\nBody", "---\n{}\n---\nBody"} {
+		got, err := frontmatter.SetKey(content, "title", "New")
+		assert.NoError(t, err)
+		assert.Equal(t, "---\ntitle: New\n---\nBody", got)
+	}
+}
