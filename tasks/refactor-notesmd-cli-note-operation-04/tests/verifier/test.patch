+def cleanup_bytecode_artifacts():
+    """Remove bytecode caches this runner could have created; never raises."""
+    try:
+        runner_dir = Path(__file__).resolve().parent
+    except (OSError, ValueError):
+        return
+    try:
+        for cache_dir in sorted(runner_dir.rglob("__pycache__"), reverse=True):
+            shutil.rmtree(cache_dir, ignore_errors=True)
+        for bytecode in runner_dir.rglob("*.pyc"):
+            try:
+                bytecode.unlink()
+            except OSError:
+                pass
+    except OSError:
+        pass
+
+
+atexit.register(cleanup_bytecode_artifacts)
