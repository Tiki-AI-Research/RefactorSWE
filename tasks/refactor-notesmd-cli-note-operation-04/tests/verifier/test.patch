@@ -0,0 +1,191 @@
+package cmd
+
+import (
+	"encoding/json"
+	"os/exec"
+	"sort"
+	"testing"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+	"github.com/stretchr/testify/assert"
+)
+
+// Frozen P2P regression nodes for the frontmatter consolidation. Every test in
+// this file is a top-level exact leaf so it can be collected and executed on
+// its own against the baseline and against a candidate solution.
+
+func TestP2PFrontmatterCommandSurface(t *testing.T) {
+	assert.Equal(t, "frontmatter <note>", frontmatterCmd.Use)
+	assert.Contains(t, frontmatterCmd.Aliases, "fm")
+	assert.NotNil(t, frontmatterCmd.Args)
+
+	assert.NoError(t, frontmatterCmd.Args(frontmatterCmd, []string{"note"}))
+	assert.Error(t, frontmatterCmd.Args(frontmatterCmd, []string{}))
+	assert.Error(t, frontmatterCmd.Args(frontmatterCmd, []string{"first", "second"}))
+
+	expected := map[string]string{
+		"print":  "p",
+		"edit":   "e",
+		"delete": "d",
+		"key":    "k",
+		"value":  "",
+		"vault":  "v",
+	}
+	for name, shorthand := range expected {
+		flag := frontmatterCmd.Flags().Lookup(name)
+		if !assert.NotNilf(t, flag, "frontmatter flag --%s must exist", name) {
+			continue
+		}
+		assert.Equalf(t, shorthand, flag.Shorthand, "shorthand of --%s", name)
+	}
+	flags := frontmatterCmd.Flags()
+	selections := []string{"print", "edit", "delete"}
+	previousValues := map[string]string{}
+	previousChanged := map[string]bool{}
+	for _, name := range selections {
+		flag := flags.Lookup(name)
+		if !assert.NotNil(t, flag) {
+			return
+		}
+		previousValues[name] = flag.Value.String()
+		previousChanged[name] = flag.Changed
+	}
+	t.Cleanup(func() {
+		for _, name := range selections {
+			assert.NoError(t, flags.Set(name, previousValues[name]))
+			flags.Lookup(name).Changed = previousChanged[name]
+		}
+	})
+	for _, selected := range selections {
+		for _, argument := range []string{"--" + selected, "-" + expected[selected]} {
+			for _, name := range selections {
+				assert.NoError(t, flags.Set(name, "false"))
+			}
+			if !assert.NoError(t, flags.Parse([]string{argument})) {
+				continue
+			}
+			for _, name := range selections {
+				wanted := "false"
+				if name == selected {
+					wanted = "true"
+				}
+				assert.Equalf(t, wanted, flags.Lookup(name).Value.String(), "%s must select only %s, checking %s", argument, selected, name)
+			}
+		}
+	}
+}
+
+// The frozen public surface is independent of private command variables and
+// handler layout. Alias and flag order is canonicalized, current parsed values
+// are ignored, and only Cobra's standard generated help/version surfaces are omitted.
+type p2pSurfaceFlag struct {
+	Name, Type, Shorthand, Default string
+	Persistent                     bool
+}
+type p2pSurfaceCommand struct {
+	Path    string
+	Aliases []string
+	Flags   []p2pSurfaceFlag
+}
+
+func p2pCommandSurface(root *cobra.Command) []p2pSurfaceCommand {
+	rows := []p2pSurfaceCommand{}
+	var visit func(*cobra.Command, string)
+	visit = func(c *cobra.Command, path string) {
+		aliases := append([]string{}, c.Aliases...)
+		sort.Strings(aliases)
+		row := p2pSurfaceCommand{Path: path, Aliases: aliases, Flags: []p2pSurfaceFlag{}}
+		for _, set := range []struct {
+			flags      *pflag.FlagSet
+			persistent bool
+		}{{c.LocalNonPersistentFlags(), false}, {c.PersistentFlags(), true}} {
+			set.flags.VisitAll(func(f *pflag.Flag) {
+				if f.Name == "help" && f.Value.Type() == "bool" && f.Shorthand == "h" && f.DefValue == "false" {
+					return
+				}
+				if c == root && f.Name == "version" && f.Value.Type() == "bool" && f.DefValue == "false" {
+					return
+				}
+				row.Flags = append(row.Flags, p2pSurfaceFlag{f.Name, f.Value.Type(), f.Shorthand, f.DefValue, set.persistent})
+			})
+		}
+		sort.Slice(row.Flags, func(i, j int) bool { return row.Flags[i].Name < row.Flags[j].Name })
+		rows = append(rows, row)
+		for _, child := range c.Commands() {
+			// Cobra installs these lazily when Execute runs. Ignore only their generated
+			// entry points; all ordinary command subtrees remain in the comparison.
+			if child.Name() == "help" || child.Name() == "completion" {
+				continue
+			}
+			visit(child, path+"/"+child.Name())
+		}
+	}
+	visit(root, "notesmd-cli")
+	return rows
+}
+func TestP2PNoUnrelatedCommandsOrFlags(t *testing.T) {
+	const baseline = `[{"Path":"notesmd-cli","Aliases":[],"Flags":[]},{"Path":"notesmd-cli/add-vault","Aliases":["av"],"Flags":[{"Name":"set-default","Type":"bool","Shorthand":"","Default":"false","Persistent":false}]},{"Path":"notesmd-cli/create","Aliases":["c"],"Flags":[{"Name":"append","Type":"bool","Shorthand":"a","Default":"false","Persistent":false},{"Name":"content","Type":"string","Shorthand":"c","Default":"","Persistent":false},{"Name":"editor","Type":"bool","Shorthand":"e","Default":"false","Persistent":false},{"Name":"open","Type":"bool","Shorthand":"","Default":"false","Persistent":false},{"Name":"overwrite","Type":"bool","Shorthand":"o","Default":"false","Persistent":false},{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/daily","Aliases":["d"],"Flags":[{"Name":"content","Type":"string","Shorthand":"c","Default":"","Persistent":false},{"Name":"editor","Type":"bool","Shorthand":"e","Default":"false","Persistent":false},{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/delete","Aliases":["d"],"Flags":[{"Name":"open","Type":"bool","Shorthand":"o","Default":"false","Persistent":false},{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/frontmatter","Aliases":["fm"],"Flags":[{"Name":"delete","Type":"bool","Shorthand":"d","Default":"false","Persistent":false},{"Name":"edit","Type":"bool","Shorthand":"e","Default":"false","Persistent":false},{"Name":"key","Type":"string","Shorthand":"k","Default":"","Persistent":false},{"Name":"print","Type":"bool","Shorthand":"p","Default":"false","Persistent":false},{"Name":"value","Type":"string","Shorthand":"","Default":"","Persistent":false},{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/list","Aliases":["ls"],"Flags":[{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/list-vaults","Aliases":["lv"],"Flags":[{"Name":"default","Type":"bool","Shorthand":"","Default":"false","Persistent":false},{"Name":"json","Type":"bool","Shorthand":"","Default":"false","Persistent":false},{"Name":"path-only","Type":"bool","Shorthand":"","Default":"false","Persistent":false}]},{"Path":"notesmd-cli/move","Aliases":["m"],"Flags":[{"Name":"editor","Type":"bool","Shorthand":"e","Default":"false","Persistent":false},{"Name":"open","Type":"bool","Shorthand":"o","Default":"false","Persistent":false},{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/open","Aliases":["o"],"Flags":[{"Name":"editor","Type":"bool","Shorthand":"e","Default":"false","Persistent":false},{"Name":"section","Type":"string","Shorthand":"s","Default":"","Persistent":false},{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/print","Aliases":["p"],"Flags":[{"Name":"mentions","Type":"bool","Shorthand":"m","Default":"false","Persistent":false},{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/print-default","Aliases":["pd"],"Flags":[{"Name":"path-only","Type":"bool","Shorthand":"","Default":"false","Persistent":false}]},{"Path":"notesmd-cli/remove-vault","Aliases":["rv"],"Flags":[]},{"Path":"notesmd-cli/search","Aliases":["s"],"Flags":[{"Name":"editor","Type":"bool","Shorthand":"e","Default":"false","Persistent":false},{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/search-content","Aliases":["sc"],"Flags":[{"Name":"editor","Type":"bool","Shorthand":"e","Default":"false","Persistent":false},{"Name":"format","Type":"string","Shorthand":"","Default":"text","Persistent":false},{"Name":"no-interactive","Type":"bool","Shorthand":"","Default":"false","Persistent":false},{"Name":"page","Type":"int","Shorthand":"","Default":"0","Persistent":false},{"Name":"page-size","Type":"int","Shorthand":"","Default":"0","Persistent":false},{"Name":"vault","Type":"string","Shorthand":"v","Default":"","Persistent":false}]},{"Path":"notesmd-cli/set-default","Aliases":[],"Flags":[{"Name":"open-type","Type":"string","Shorthand":"","Default":"","Persistent":false}]},{"Path":"notesmd-cli/set-default-vault","Aliases":["sd"],"Flags":[{"Name":"open-type","Type":"string","Shorthand":"","Default":"","Persistent":false}]}]`
+	var want []p2pSurfaceCommand
+	if err := json.Unmarshal([]byte(baseline), &want); err != nil {
+		t.Fatal(err)
+	}
+	assert.Equal(t, want, p2pCommandSurface(rootCmd), "public command/alias/flag surface must preserve baseline; frontmatter consolidation does not add unrelated CLI features")
+}
+
+func TestP2PModuleDependencySurfaceUnchanged(t *testing.T) {
+	baselineModules := map[string]bool{
+		"github.com/BurntSushi/toml":           true,
+		"github.com/adrg/frontmatter":          true,
+		"github.com/gdamore/encoding":          true,
+		"github.com/gdamore/tcell/v2":          true,
+		"github.com/inconshreveable/mousetrap": true,
+		"github.com/ktr0731/go-ansisgr":        true,
+		"github.com/ktr0731/go-fuzzyfinder":    true,
+		"github.com/lucasb-eyer/go-colorful":   true,
+		"github.com/mattn/go-runewidth":        true,
+		"github.com/nsf/termbox-go":            true,
+		"github.com/pkg/errors":                true,
+		"github.com/rivo/uniseg":               true,
+		"github.com/skratchdot/open-golang":    true,
+		"github.com/spf13/cobra":               true,
+		"github.com/spf13/pflag":               true,
+		"github.com/stretchr/testify":          true,
+		"go.yaml.in/yaml/v3":                   true,
+		"golang.org/x/sys":                     true,
+		"golang.org/x/term":                    true,
+		"golang.org/x/text":                    true,
+		"gopkg.in/yaml.v2":                     true,
+		"gopkg.in/yaml.v3":                     true,
+	}
+
+	// Delegate grammar, quoted strings and block directives to the installed Go
+	// toolchain. This reads go.mod only; it does not resolve/download modules.
+	command := exec.Command("go", "mod", "edit", "-json", "go.mod")
+	command.Dir = ".."
+	data, err := command.Output()
+	if !assert.NoError(t, err, "read go.mod with Go parser") {
+		return
+	}
+	var module struct {
+		Module  struct{ Path string }
+		Require []struct{ Path, Version string }
+		Replace []struct {
+			Old, New struct{ Path, Version string }
+		}
+	}
+	if err := json.Unmarshal(data, &module); !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, "github.com/Yakitrak/notesmd-cli", module.Module.Path)
+	if !assert.NotEmpty(t, module.Require) {
+		return
+	}
+	for _, require := range module.Require {
+		assert.Truef(t, baselineModules[require.Path], "unexpected third-party module %q added to go.mod", require.Path)
+	}
+	for _, replace := range module.Replace {
+		assert.Truef(t, baselineModules[replace.Old.Path], "replacement introduces nonbaseline module %q", replace.Old.Path)
+		assert.Truef(t, baselineModules[replace.New.Path], "replacement introduces nonbaseline source %q (including local replacement sources)", replace.New.Path)
+	}
+}
diff --git a/pkg/actions/zz_p2p_audit_test.go b/pkg/actions/zz_p2p_audit_test.go
