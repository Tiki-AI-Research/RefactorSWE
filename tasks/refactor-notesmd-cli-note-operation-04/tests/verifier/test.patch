+package actions_test
+
+import (
+	"testing"
+
+	"github.com/Yakitrak/notesmd-cli/pkg/actions"
+	"github.com/stretchr/testify/assert"
+)
+
+// Check the action boundary as well as the standalone SetKey conversion tests:
+// the selected operation must forward the value and write the full result once.
+func TestP2PEditForwardsValueConversionsAndPreservesContents(t *testing.T) {
+	rows := []struct{ value, yaml string }{
+		{"true", " true"},
+		{"false", " false"},
+		{"[one, two]", "\n    - one\n    - two"},
+		{"[]", " []"},
+		{"123", " \"123\""},
+	}
+	for _, row := range rows {
+		vault, note := p2pFrontmatterNote("---\nkeep: retained\nvalue: Old\n---\n\nBody\r\n")
+		out, err := actions.Frontmatter(vault, note, actions.FrontmatterParams{
+			NoteName: "folder/conversions", Edit: true, Key: "value", Value: row.value,
+		})
+		assert.NoError(t, err, "value=%q", row.value)
+		assert.Equal(t, "Updated frontmatter key 'value' in folder/conversions", out)
+		assert.Equal(t, 1, note.getCalls)
+		assert.Equal(t, 1, note.setCalls)
+		assert.Equal(t, "/vaults/myVault", note.lastVaultPath)
+		assert.Equal(t, "folder/conversions", note.lastNoteName)
+		assert.Equal(t, "---\nkeep: retained\nvalue:"+row.yaml+"\n---\n\nBody\r\n", note.lastContents, "value=%q", row.value)
+	}
+}
+
+func TestP2PEditInitializesParsedNilAndEmptyMaps(t *testing.T) {
+	for _, yaml := range []string{"", "null\n", "{}\n"} {
+		vault, note := p2pFrontmatterNote("---\n" + yaml + "---\n\nBody\n")
+		out, err := actions.Frontmatter(vault, note, actions.FrontmatterParams{
+			NoteName: "folder/initialize", Edit: true, Key: "title", Value: "New",
+		})
+		assert.NoError(t, err, "yaml=%q", yaml)
+		assert.Equal(t, "Updated frontmatter key 'title' in folder/initialize", out)
+		assert.Equal(t, 1, note.getCalls)
+		assert.Equal(t, 1, note.setCalls)
+		assert.Equal(t, "/vaults/myVault", note.lastVaultPath)
+		assert.Equal(t, "folder/initialize", note.lastNoteName)
+		assert.Equal(t, "---\ntitle: New\n---\n\nBody\n", note.lastContents)
+	}
+}
+
+func TestP2PDeleteMissingKeyStillWritesPreservedContentsOnce(t *testing.T) {
+	const contents = "---\ntitle: Old\n---\n\nBody\r\n"
+	vault, note := p2pFrontmatterNote(contents)
+	out, err := actions.Frontmatter(vault, note, actions.FrontmatterParams{
+		NoteName: "folder/missing-key", Delete: true, Key: "missing",
+	})
+	assert.NoError(t, err)
+	assert.Equal(t, "Deleted frontmatter key 'missing' from folder/missing-key", out)
+	assert.Equal(t, 1, note.getCalls)
+	assert.Equal(t, 1, note.setCalls)
+	assert.Equal(t, "/vaults/myVault", note.lastVaultPath)
+	assert.Equal(t, "folder/missing-key", note.lastNoteName)
+	assert.Equal(t, contents, note.lastContents)
+}
