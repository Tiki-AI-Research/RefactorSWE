@@ -0,0 +1,140 @@
+package actions_test
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/Yakitrak/notesmd-cli/pkg/actions"
+	"github.com/Yakitrak/notesmd-cli/pkg/frontmatter"
+	"github.com/stretchr/testify/assert"
+)
+
+// Each row exercises the same precedence contract for a different operation.
+func TestP2PResolutionFailurePrecedesEveryOperation(t *testing.T) {
+	modes := []actions.FrontmatterParams{
+		{}, {Print: true}, {Edit: true}, {Delete: true}, {Print: true, Edit: true, Delete: true},
+	}
+	for _, mode := range modes {
+		mode.NoteName = "folder/audit-note"
+		for _, stage := range []string{"default", "path", "read"} {
+			vault, note := p2pFrontmatterNote("---\ninvalid: [unclosed\n---\nBody")
+			sentinel := errors.New("audit " + stage)
+			switch stage {
+			case "default":
+				vault.defaultNameErr = sentinel
+			case "path":
+				vault.pathErr = sentinel
+			case "read":
+				note.getErr = sentinel
+			}
+			output, err := actions.Frontmatter(vault, note, mode)
+			assert.ErrorIs(t, err, sentinel, "mode=%+v stage=%s", mode, stage)
+			assert.Empty(t, output)
+			assert.Equal(t, 0, note.setCalls)
+			if stage == "default" {
+				assert.Equal(t, 0, vault.pathCalls)
+			}
+			if stage != "read" {
+				assert.Equal(t, 0, note.getCalls)
+			}
+		}
+	}
+}
+
+type auditVault struct {
+	*p2pVaultRecorder
+	events *[]string
+}
+
+func (v *auditVault) DefaultName() (string, error) {
+	*v.events = append(*v.events, "default")
+	return v.p2pVaultRecorder.DefaultName()
+}
+func (v *auditVault) Path() (string, error) {
+	*v.events = append(*v.events, "path")
+	return v.p2pVaultRecorder.Path()
+}
+
+type auditNote struct {
+	*p2pNoteRecorder
+	events *[]string
+	t      *testing.T
+}
+
+func (n *auditNote) GetContents(path, name string) (string, error) {
+	*n.events = append(*n.events, "read")
+	assert.Equal(n.t, "/vaults/myVault", path)
+	assert.Equal(n.t, "folder/audit-note", name)
+	return n.p2pNoteRecorder.GetContents(path, name)
+}
+func TestP2PResolutionOrderAndLoadedContents(t *testing.T) {
+	for _, mode := range []actions.FrontmatterParams{{}, {Print: true}, {Edit: true, Key: "title", Value: "New"}, {Delete: true, Key: "title"}} {
+		mode.NoteName = "folder/audit-note"
+		vault, note := p2pFrontmatterNote("---\ntitle: Old\n---\nBody")
+		events := []string{}
+		_, err := actions.Frontmatter(&auditVault{vault, &events}, &auditNote{note, &events, t}, mode)
+		if mode.Print || mode.Edit || mode.Delete {
+			assert.NoError(t, err)
+		} else {
+			assert.EqualError(t, err, "no operation specified: use --print, --edit, or --delete")
+		}
+		assert.Equal(t, []string{"default", "path", "read"}, events)
+	}
+}
+func TestP2PPrintNeverWritesForEmptyOrMalformedContents(t *testing.T) {
+	for _, content := range []string{"Body", "---\n---\nBody", "---\n{}\n---\nBody", "---\nnull\n---\nBody", "---\ninvalid: [unclosed\n---\nBody"} {
+		vault, note := p2pFrontmatterNote(content)
+		note.setErr = errors.New("must not write")
+		output, err := actions.Frontmatter(vault, note, actions.FrontmatterParams{NoteName: "audit-note", Print: true})
+		if content == "---\ninvalid: [unclosed\n---\nBody" {
+			assert.EqualError(t, err, frontmatter.InvalidFrontmatterError)
+		} else {
+			assert.NoError(t, err)
+		}
+		assert.Equal(t, "", output, "content=%q", content)
