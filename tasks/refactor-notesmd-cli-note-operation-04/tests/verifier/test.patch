+#!/usr/bin/env python3
+"""P2P node runner for the frontmatter consolidation task.
+
+Every frozen P2P selector is executed as its own ``go test -run ^<leaf>$``
+invocation against the repository and the real per-node results are written as
+a conventional JUnit report. The runner never installs, downloads or reaches
+the network: it only uses the Go toolchain and the repository files that are
+already present in the frozen environment image.
+
+Selector format: ``<repo-relative test file path>::<exact top-level leaf>``.
+
+The frozen selector list is embedded in this file so the report production
+mechanism is self-sufficient: the runner can always execute exactly the frozen
+P2P nodes and write the report even when no pipeline selection asset is handed
+to it. When the pipeline does provide its ``p2p_select``/``config`` asset (as
+``--select``/``--config``, through a P2P/VERIFIER environment variable, or at a
+well-known path), that asset is read and cross-checked against the embedded
+list; the embedded list stays authoritative for what is executed and reported,
+so the JUnit report always covers exactly the frozen nodes.
+"""
+
+import argparse
+import atexit
+import glob
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+# The repository is diffed against the frozen baseline after every round, so
+# the runner must never leave a bytecode cache (``__pycache__``/``*.pyc``)
+# behind under the test tree. Interpreter startup cannot be controlled from
+# inside this file, so caches created when this module is imported by other
+# tooling are removed again on interpreter exit.
+sys.dont_write_bytecode = True
+
+DEFAULT_NODE_TIMEOUT = 120
+
+# Frozen P2P selectors (``path::exact top-level leaf``). Keep in sync with the
+# evidence p2p-plan.json declaration; this list is the authoritative run set.
+FROZEN_SELECTORS = [
+    "cmd/zz_p2p_frontmatter_regression_test.go::TestP2PFrontmatterCommandSurface",
+    "pkg/actions/zz_p2p_frontmatter_regression_test.go::TestP2PFrontmatterExportedSignatureAndParams",
+    "pkg/frontmatter/zz_p2p_frontmatter_regression_test.go::TestP2PFrontmatterPackageAPISurface",
