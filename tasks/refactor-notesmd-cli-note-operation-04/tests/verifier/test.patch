+	vaultRead, noteRead := p2pFrontmatterNote("---\ntitle: Test\n---\nBody")
+	noteRead.getErr = errors.New("note not found")
+	_, errRead := actions.Frontmatter(vaultRead, noteRead, keyMissing)
