+package cmd
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func completenessCLI(t *testing.T, testName string, explicitVault bool, flags []string, wantOut, wantContents string) {
+	t.Helper()
+	dir := t.TempDir()
+	vault := filepath.Join(dir, "vault")
+	cfg := filepath.Join(dir, "config")
+	for _, path := range []string{vault, filepath.Join(cfg, "notesmd-cli")} {
+		if err := os.MkdirAll(path, 0755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	prefs, err := json.Marshal(map[string]string{"default_vault_name": vault})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(cfg, "notesmd-cli/preferences.json"), prefs, 0644); err != nil {
+		t.Fatal(err)
+	}
+	const contents = "---\ntitle: Old\nkeep: retained\n---\nBody\n"
+	note := filepath.Join(vault, "Chosen Note.md")
+	if err := os.WriteFile(note, []byte(contents), 0644); err != nil {
+		t.Fatal(err)
+	}
+	executable, err := os.ReadFile(os.Args[0])
+	if err != nil {
+		executable, err = os.ReadFile("/proc/self/exe")
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	binary := filepath.Join(dir, "completeness.test")
+	if err := os.WriteFile(binary, executable, 0700); err != nil {
+		t.Fatal(err)
+	}
+	arguments := []string{"fm", "Chosen Note"}
+	if explicitVault {
+		arguments = append(arguments, "--vault", vault)
+	}
+	arguments = append(arguments, flags...)
+	data, err := json.Marshal(arguments)
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command(binary, "-test.run=^"+testName+"$", "-test.count=1")
+	child.Env = append(os.Environ(), "NOTESMD_AUDIT_CHILD=1", "NOTESMD_AUDIT_ARGS="+string(data), "XDG_CONFIG_HOME="+cfg)
+	out, err := child.CombinedOutput()
+	if !assert.NoError(t, err, "%s", out) {
+		return
+	}
+	assert.Equal(t, wantOut+"PASS\n", string(out), "args=%v", arguments)
+	got, err := os.ReadFile(note)
+	assert.NoError(t, err)
+	assert.Equal(t, wantContents, string(got))
+}
+
+func TestP2PCLICombinedSelectionsPreservePriority(t *testing.T) {
+	if auditCLIChild(t) {
+		return
+	}
+	const initial = "---\ntitle: Old\nkeep: retained\n---\nBody\n"
+	for _, flags := range [][]string{
+		{"--print", "--edit", "--delete"},
+		{"-p", "-e"},
+		{"-p", "-d"},
+	} {
+		// Empty edit/delete inputs must not stop the higher-priority print.
+		completenessCLI(t, "TestP2PCLICombinedSelectionsPreservePriority", true, flags, "keep: retained\ntitle: Old\n", initial)
+	}
+	completenessCLI(t, "TestP2PCLICombinedSelectionsPreservePriority", true,
+		[]string{"--edit", "--delete", "--key", "title", "--value", "New"},
+		"Updated frontmatter key 'title' in Chosen Note", "---\nkeep: retained\ntitle: New\n---\nBody\n")
+}
+
+func TestP2PCLIUsesDefaultVaultWhenFlagAbsent(t *testing.T) {
+	if auditCLIChild(t) {
+		return
+	}
+	completenessCLI(t, "TestP2PCLIUsesDefaultVaultWhenFlagAbsent", false,
+		[]string{"--print"}, "keep: retained\ntitle: Old\n", "---\ntitle: Old\nkeep: retained\n---\nBody\n")
+}
