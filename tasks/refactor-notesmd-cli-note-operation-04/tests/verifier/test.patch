+def _collect_selector_strings(node, out):
+    if isinstance(node, str):
+        value = node.strip()
+        if SELECTOR_PATTERN.match(value):
+            out.append(value)
+    elif isinstance(node, list):
+        for item in node:
+            _collect_selector_strings(item, out)
+    elif isinstance(node, dict):
+        for item in node.values():
+            _collect_selector_strings(item, out)
+
+
+def parse_selector_text(text):
+    """Extract selector-like strings from raw text (JSON, or line/comma list)."""
+    out = []
+    stripped = text.strip()
+    if not stripped:
+        return out
+    if stripped[0] in "[{":
+        try:
+            data = json.loads(stripped)
+        except json.JSONDecodeError:
+            data = None
+        if data is not None:
+            _collect_selector_strings(data, out)
+            return out
+    for raw_line in re.split(r"[\r\n,;]+", stripped):
+        line = raw_line.strip().strip('"').strip("'")
+        if line and not line.startswith("#") and SELECTOR_PATTERN.match(line):
+            out.append(line)
+    return out
+
+
+def is_readable_file(value):
+    """Return True only for a regular file; never raise on odd path strings."""
+    try:
+        return Path(value).is_file()
+    except (OSError, ValueError):
+        return False
+
+
+def _search_directories(repo_root):
+    candidates = [
+        repo_root,
+        repo_root.parent,
+        Path.cwd(),
+        Path.cwd().parent,
+        Path("/workspace"),
+        Path("/workspace/repo"),
+        Path("/workspace/verifier"),
+        Path("/workspace/evidence"),
+        Path("/verifier"),
+        Path("/evidence"),
+        Path("/opt/verifier"),
+        Path(os.environ.get("TMPDIR") or tempfile.gettempdir()),
+    ]
+    unique = []
+    for candidate in candidates:
+        if candidate not in unique:
+            unique.append(candidate)
+    return unique
+
+
+def resolve_external_selection(args, repo_root):
+    """Best-effort read of a pipeline-provided selection asset.
+
+    Returns ``(selectors, source_description, notes)``; ``selectors`` is empty
+    when no usable asset is found, in which case the embedded frozen list is the
+    only selection input.
+    """
+    notes = []
+    explicit = []
+    if args.select:
+        explicit.append(("--select", args.select))
+    if args.config:
+        explicit.append(("--config", args.config))
+    for name in SELECTOR_ENV_VARS:
+        value = os.environ.get(name)
+        if value:
+            explicit.append(("env:%s" % name, value))
+    for name in CONFIG_ENV_VARS:
+        value = os.environ.get(name)
+        if value:
+            explicit.append(("env:%s" % name, value))
+
+    candidates = []
+    for source, value in explicit:
+        text_value = value.strip()
+        if PLACEHOLDER_PATTERN.match(text_value):
+            notes.append("%s was handed the unresolved placeholder %s" % (source, text_value))
+            continue
+        if "::" in text_value and not is_readable_file(text_value):
+            candidates.append((source, "inline", text_value))
+            continue
+        candidates.append((source, "file", Path(text_value)))
+
+    for directory in _search_directories(repo_root):
+        for name in SELECTION_FILE_NAMES + CONFIG_FILE_NAMES:
+            candidates.append(("well-known", "file", directory / name))
+        for sub in ("verifier", "evidence", "tests/p2p"):
+            for name in SELECTION_FILE_NAMES + CONFIG_FILE_NAMES:
+                candidates.append(("well-known", "file", directory / sub / name))
+
+    for source, kind, payload in candidates:
+        if kind == "inline":
+            selectors = parse_selector_text(payload)
+            if selectors:
+                return selectors, "%s (inline)" % source, notes
+            continue
+        path = Path(payload)
+        if not is_readable_file(path):
+            continue
+        try:
+            text = path.read_text(encoding="utf-8-sig", errors="replace")
+        except OSError as exc:
+            notes.append("could not read %s: %s" % (path, exc))
+            continue
+        selectors = parse_selector_text(text)
+        if selectors:
+            return selectors, "%s (%s)" % (source, path), notes
+    return [], None, notes
+
+
+def _writable_directory(path):
+    try:
+        path.mkdir(parents=True, exist_ok=True)
+    except OSError:
+        return False
+    return os.access(str(path), os.W_OK | os.X_OK)
+
+
+def find_go_binary(environment):
+    """Locate the in-image Go toolchain; never downloads or installs anything."""
+    found = shutil.which("go", path=environment.get("PATH"))
+    if found:
+        return found
+    candidates = list(GO_BINARY_CANDIDATES)
+    for pattern in GO_GLOB_CANDIDATES:
+        candidates.extend(sorted(glob.glob(pattern), reverse=True))
+    for candidate in candidates:
+        if is_readable_file(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    return "go"
+
+
+def prepare_environment():
+    """Return a go-friendly environment without touching the network."""
+    environment = dict(os.environ)
+    environment.setdefault("PYTHONDONTWRITEBYTECODE", "1")
+    tmp_dir = Path(environment.get("TMPDIR") or tempfile.gettempdir())
+    if not _writable_directory(tmp_dir):
+        tmp_dir = Path(tempfile.gettempdir())
+    if not environment.get("GOTMPDIR"):
+        environment["GOTMPDIR"] = str(tmp_dir)
+
+    cache = environment.get("GOCACHE")
+    if not cache:
+        try:
+            completed = subprocess.run(
+                ["go", "env", "GOCACHE"],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.DEVNULL,
+                text=True,
+                timeout=60,
+            )
+            if completed.returncode == 0:
+                cache = completed.stdout.strip()
+        except (OSError, subprocess.SubprocessError):
+            cache = None
+    if not cache or not _writable_directory(Path(cache)):
+        fallback = tmp_dir / "gocache"
+        if _writable_directory(fallback):
+            environment["GOCACHE"] = str(fallback)
+    go_binary = find_go_binary(environment)
+    if os.path.dirname(go_binary):
+        go_dir = os.path.dirname(go_binary)
+        path_parts = [part for part in environment.get("PATH", "").split(os.pathsep) if part]
+        if go_dir not in path_parts:
+            environment["PATH"] = os.pathsep.join([go_dir] + path_parts)
+    return environment
+
+
+def parse_go_test_json(stdout, leaf):
+    """Return (status, leaf_output, package_output) from `go test -json`."""
+    status = None
+    leaf_output = []
+    package_output = []
+    for raw_line in stdout.splitlines():
+        line = raw_line.strip()
+        if not line.startswith("{"):
+            if line:
+                package_output.append(line)
+            continue
+        try:
+            event = json.loads(line)
+        except json.JSONDecodeError:
+            package_output.append(line)
+            continue
+        action = event.get("Action")
+        test = event.get("Test")
+        output = event.get("Output", "")
+        if test == leaf or (isinstance(test, str) and test.startswith(leaf + "/")):
+            if action == "output":
+                leaf_output.append(output.rstrip("\n"))
+            elif test == leaf and action in ("pass", "fail", "skip"):
+                status = action
+        elif test is None:
+            if action == "output" and output.strip():
+                package_output.append(output.rstrip("\n"))
+    return status, leaf_output, package_output
+
+
+def run_selector(repo_root, selector, node_timeout, environment, go_binary):
+    path, leaf = selector.split("::", 1)
+    result = {
+        "selector": selector,
+        "path": path,
+        "leaf": leaf,
+        "status": "error",
+        "message": "",
+        "output": "",
+        "duration": 0.0,
+    }
+
+    test_file = repo_root / path
+    if not test_file.is_file():
+        result["message"] = "collection error: test file %s is missing from the repository" % path
+        return result
+
+    package_dir = test_file.parent
+    try:
+        package_arg = "./" + str(package_dir.relative_to(repo_root)).replace(os.sep, "/")
+    except ValueError:
+        result["message"] = "collection error: test file %s is outside the repository root" % path
+        return result
+
+    command = [
+        go_binary,
+        "test",
+        "-json",
+        "-count=1",
+        "-timeout",
+        "%ds" % node_timeout,
+        "-run",
+        "^%s$" % re.escape(leaf),
+        package_arg,
+    ]
+    started = time.time()
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=str(repo_root),
+            env=environment,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+            timeout=node_timeout + 180,
+        )
+        stdout = completed.stdout or ""
+        status, leaf_output, package_output = parse_go_test_json(stdout, leaf)
+    except subprocess.TimeoutExpired as exc:
+        result["duration"] = time.time() - started
+        result["message"] = "selector timed out after %ds" % (node_timeout + 180)
+        result["output"] = (exc.stdout or "") if isinstance(exc.stdout, str) else ""
+        return result
+    except OSError as exc:
+        result["duration"] = time.time() - started
+        result["message"] = "execution error: unable to execute go test: %s" % exc
+        return result
+
+    result["duration"] = time.time() - started
+    combined_output = "\n".join([line for line in leaf_output if line] + package_output).strip()
+
+    if re.search(r"(?m)^panic: test timed out", combined_output):
+        result["message"] = "test timed out"
+        result["output"] = combined_output
+    elif completed.returncode not in (0, 1) or re.search(r"(?m)^(?:panic:|fatal error:|signal:)", combined_output):
+        result["message"] = "process crash during go test"
+        result["output"] = combined_output
+    elif status in ("pass", "fail", "skip") and completed.returncode != (1 if status == "fail" else 0):
+        result["message"] = "execution error: go test exit code disagrees with the test result"
+        result["output"] = combined_output
+    elif status == "pass":
+        result["status"] = "pass"
+        result["output"] = combined_output
+    elif status == "fail":
+        result["status"] = "fail"
+        result["message"] = "test %s failed" % leaf
+        result["output"] = combined_output
+    elif status == "skip":
+        result["status"] = "skip"
+        result["message"] = "test %s was skipped" % leaf
+        result["output"] = combined_output
+    else:
+        result["status"] = "error"
+        category = "compile error" if "[build failed]" in combined_output else "collection error" if completed.returncode == 0 else "execution error"
+        result["message"] = "%s: test %s was not collected or did not report a result" % (category, leaf)
+        result["output"] = combined_output or "go test produced no result for the exact leaf"
+    return result
+
+
+def write_junit(report_path, results, total_duration):
+    root = ET.Element("testsuites")
+    root.set("name", "p2p-frontmatter-consolidation")
+    root.set("tests", str(len(results)))
+    root.set("failures", str(sum(1 for r in results if r["status"] == "fail")))
+    root.set("errors", str(sum(1 for r in results if r["status"] == "error")))
+    root.set("skipped", str(sum(1 for r in results if r["status"] == "skip")))
+    root.set("time", "%.3f" % total_duration)
+
+    for result in results:
+        suite = ET.SubElement(root, "testsuite")
+        suite.set("name", result["selector"])
+        suite.set("selector", result["selector"])
+        suite.set("tests", "1")
+        suite.set("failures", "1" if result["status"] == "fail" else "0")
+        suite.set("errors", "1" if result["status"] == "error" else "0")
+        suite.set("skipped", "1" if result["status"] == "skip" else "0")
+        suite.set("time", "%.3f" % result["duration"])
+
+        case = ET.SubElement(suite, "testcase")
+        case.set("classname", result["path"])
+        case.set("name", result["leaf"])
+        case.set("file", result["path"])
+        case.set("selector", result["selector"])
+        case.set("time", "%.3f" % result["duration"])
+
+        if result["status"] == "fail":
+            failure = ET.SubElement(case, "failure")
+            failure.set("message", result["message"])
+            failure.set("type", "AssertionFailure")
+            failure.text = result["output"] or result["message"]
+        elif result["status"] == "error":
+            error = ET.SubElement(case, "error")
+            error.set("message", result["message"])
+            error.set("type", "RunnerError")
+            error.text = result["output"] or result["message"]
+        elif result["status"] == "skip":
+            ET.SubElement(case, "skipped")
+
+        if result["output"]:
+            system_out = ET.SubElement(suite, "system-out")
+            system_out.text = result["output"]
+
+    tree = ET.ElementTree(root)
+    ET.indent(tree, space="  ")
+    report_file = Path(report_path)
+    if report_file.parent and str(report_file.parent):
+        report_file.parent.mkdir(parents=True, exist_ok=True)
+    tree.write(str(report_file), encoding="utf-8", xml_declaration=True)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description="Run frozen P2P selectors and write a JUnit report")
+    parser.add_argument(
+        "--select",
+        default=None,
+        help="pipeline selection asset with <path>::<leaf> selectors (optional; the frozen list is embedded)",
+    )
+    parser.add_argument(
+        "--config",
+        default=None,
+        help="pipeline config asset carrying the P2P selectors (optional)",
+    )
+    parser.add_argument("--junit", required=True, help="path of the JUnit report to write")
+    parser.add_argument(
+        "--timeout",
+        type=int,
+        default=DEFAULT_NODE_TIMEOUT,
+        help="per-selector go test timeout in seconds",
+    )
+    args = parser.parse_args(argv)
+
+    repo_root = find_repo_root()
+    external, source, notes = resolve_external_selection(args, repo_root)
+    print("P2P repository root: %s" % repo_root)
+    for note in notes:
+        print("P2P selection note: %s" % note)
+
+    run_list = list(FROZEN_SELECTORS)
+    if external:
+        external_known = [s for s in external if s in FROZEN_SELECTORS]
+        external_unknown = [s for s in external if s not in FROZEN_SELECTORS]
+        missing = [s for s in FROZEN_SELECTORS if s not in external]
+        print(
+            "P2P selection cross-check: external=%d, matching-frozen=%d, unknown=%d, frozen-missing-from-external=%d"
+            % (len(external), len(external_known), len(external_unknown), len(missing))
+        )
+        for selector in external_unknown:
+            print("P2P selection note: external selector not in the frozen list, ignored: %s" % selector)
+        for selector in missing:
+            print("P2P selection note: frozen selector missing from the external asset, still executed: %s" % selector)
+    print(
+        "P2P selection source: %s"
+        % (source or "embedded frozen list (no external selection asset found)")
+    )
+    if source is None:
+        env_candidates = sorted(
+            "%s=%s" % (key, value[:200])
+            for key, value in os.environ.items()
+            if re.search(r"P2P|VERIFIER|SELECT|REPORT|CONFIG", key)
+        )
+        if env_candidates:
+            print("P2P selection note: environment candidates: %s" % ", ".join(env_candidates))
+
+    environment = prepare_environment()
+    go_binary = find_go_binary(environment)
+    print("P2P go toolchain: %s" % go_binary)
+    started = time.time()
+    results = [
+        run_selector(repo_root, selector, args.timeout, environment, go_binary)
+        for selector in run_list
+    ]
+    total_duration = time.time() - started
+
+    write_junit(args.junit, results, total_duration)
+
+    for result in results:
+        print("%-8s %s" % (result["status"].upper(), result["selector"]))
+        if result["status"] in ("fail", "error", "skip") and result["output"]:
+            print(result["output"])
+    print(
+        "P2P nodes: %d total, %d passed, %d failed, %d errors, %d skipped (%.1fs)"
+        % (
+            len(results),
+            sum(1 for r in results if r["status"] == "pass"),
+            sum(1 for r in results if r["status"] == "fail"),
+            sum(1 for r in results if r["status"] == "error"),
+            sum(1 for r in results if r["status"] == "skip"),
+            total_duration,
+        )
+    )
+    return int(any(result["status"] in ("fail", "error") for result in results))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
