+// A capability that unpacks its context into the original contents/manager/
+// identity parameter bundle leaves the overlapping operation implementation in
+// place. Passing an owned context to helpers, or using focused content/writer
+// helpers, remains free. This node checks the unpacked bundle, independently of
+// whether its values have valid owned origins (the preceding ownership nodes).
+func TestF2POperationsDoNotReexpandContextBundles(t *testing.T) {
+	m := mustF2PPackage(t, findRepoRoot(t), "pkg", "actions")
+	entry := m.functionByName("Frontmatter")
+	if entry == nil {
+		t.Fatal("actions.Frontmatter is missing")
+	}
+	for _, fn := range m.closure(entry) {
+		if !m.f2pConsumesContentParameter(fn, map[*funcInfo]bool{}) {
+			continue
+		}
+		for _, write := range fn.calls {
+			if write.pkg != "" || write.name != "SetContents" || write.receiver == nil || len(write.args) < 2 {
+				continue
+			}
+			manager := m.parameterAlias(fn, exprString(m.fset, write.receiver), map[string]bool{})
+			path := m.parameterAlias(fn, write.args[0].text, map[string]bool{})
+			name := m.parameterAlias(fn, write.args[1].text, map[string]bool{})
+			if manager != "" && path != "" && name != "" {
+				t.Errorf("%s retains the overlapping contents, note manager and note identity parameter bundle; keep the context through operation helpers", fn.id)
+			}
+		}
+	}
+}
