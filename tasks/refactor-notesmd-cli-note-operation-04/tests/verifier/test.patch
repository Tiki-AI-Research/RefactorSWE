+package frontmatter_test
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/Yakitrak/notesmd-cli/pkg/frontmatter"
+	"github.com/stretchr/testify/assert"
+)
+
+type completenessMarshalFailure struct{ err error }
+
+func (v completenessMarshalFailure) MarshalYAML() (interface{}, error) {
+	return nil, v.err
+}
+
+// Format accepts arbitrary map values. Its error return can be exercised
+// without depending on private operation helpers or inducing a YAML panic.
+func TestP2PFormatPropagatesMarshalFailure(t *testing.T) {
+	sentinel := errors.New("completeness YAML marshal failure")
+	got, err := frontmatter.Format(map[string]interface{}{
+		"value": completenessMarshalFailure{err: sentinel},
+	})
+	assert.ErrorIs(t, err, sentinel)
+	assert.Empty(t, got)
+}
