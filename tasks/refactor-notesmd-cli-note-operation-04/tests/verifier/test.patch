+// Each test below owns one obligation. Finding an abstraction is a prerequisite
+// for ownership/dispatch checks, not a second independently scored assertion.
+func TestF2PExplicitCapabilitiesShareOneOperationContext(t *testing.T) {
+	m := mustF2PPackage(t, findRepoRoot(t), "pkg", "actions")
+	if m.operationAbstractionType() == "" {
+		t.Fatal("frontmatter needs one context exposing distinct print, edit and delete capabilities; a generic flag-dispatch method is not three explicit capabilities")
+	}
+}
+
+func TestF2PCapabilitiesUseOwnedContents(t *testing.T) {
+	m := mustF2PPackage(t, findRepoRoot(t), "pkg", "actions")
+	owner := requireOperation(t, m)
+	for _, cap := range allCapabilities {
+		found := false
+		for _, fn := range m.operationMethods(owner) {
+			if !m.exclusiveCapability(fn, cap) {
+				continue
+			}
+			for _, reached := range m.closure(fn) {
+				for _, call := range reached.calls {
+					if !isContentCall(call, cap) {
+						continue
+					}
+					found = true
+					if !m.f2pContentOrigin(reached, call.args[0].text, owner, map[string]bool{}) {
+						t.Errorf("%s at %s:%d receives note contents outside the operation context: %s", cap, relPath(reached.file), call.line, call.args[0].text)
+					}
+				}
+			}
+		}
+		if !found {
+			t.Errorf("%s capability has no identifiable content input", cap)
+		}
+	}
+	for _, issue := range m.f2pInstanceProvenance().contents {
+		t.Error(issue)
+	}
+}
+
+func TestF2POperationReceivesAlreadyLoadedContents(t *testing.T) {
+	m := mustF2PPackage(t, findRepoRoot(t), "pkg", "actions")
+	_ = requireOperation(t, m)
+	// This node checks only the provenance of content actually consumed.
+	// Additional reads, including ignored reads, are a separate baseline-PASS invariant.
+	for _, issue := range m.f2pInstanceProvenance().unloaded {
+		t.Error(issue)
+	}
+}
+
+func TestF2PWritesUseOwnedNoteIdentity(t *testing.T) {
+	m := mustF2PPackage(t, findRepoRoot(t), "pkg", "actions")
+	owner := requireOperation(t, m)
+	entry := m.functionByName("Frontmatter")
+	if entry == nil {
+		t.Fatal("actions.Frontmatter is missing")
+	}
+	writes := 0
+	for _, fn := range m.closure(entry) {
+		for _, call := range fn.calls {
+			if call.pkg != "" || call.name != "SetContents" {
+				continue
+			}
+			writes++
+			for i := 0; i < 2 && i < len(call.args); i++ {
+				if !m.origin(fn, call.args[i].text, owner, false, map[string]bool{}) {
+					t.Errorf("frontmatter write identity at %s:%d is not owned by %s: %s", relPath(fn.file), call.line, owner, call.args[i].text)
+				}
+			}
+		}
+	}
+	if writes == 0 {
+		t.Fatal("no reachable frontmatter write found")
+	}
+	for _, issue := range m.f2pInstanceProvenance().identity {
+		t.Error(issue)
+	}
+}
