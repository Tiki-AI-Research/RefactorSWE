+++ b/cmd/zz_p2p_audit_test.go
@@ -0,0 +1,123 @@
+package cmd
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// Child processes exercise the real Cobra command and its production handler.
+// They reuse this test binary, avoiding a toolchain dependency inside tests.
+func auditCLIChild(t *testing.T) bool {
+	if os.Getenv("NOTESMD_AUDIT_CHILD") != "1" {
+		return false
+	}
+	arguments := []string{}
+	if err := json.Unmarshal([]byte(os.Getenv("NOTESMD_AUDIT_ARGS")), &arguments); err != nil {
+		t.Fatal(err)
+	}
+	rootCmd.SetArgs(arguments)
+	if err := rootCmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	return true
+}
+
+func TestP2PFrontmatterCLIFlagsReachOperations(t *testing.T) {
+	if auditCLIChild(t) {
+		return
+	}
+	for _, alias := range []string{"frontmatter", "fm"} {
+		for _, short := range []bool{false, true} {
+			dir := t.TempDir()
+			vault := filepath.Join(dir, "chosen-vault")
+			wrong := filepath.Join(dir, "default-vault")
+			cfg := filepath.Join(dir, "config")
+			for _, d := range []string{vault, wrong, filepath.Join(cfg, "notesmd-cli")} {
+				if err := os.MkdirAll(d, 0755); err != nil {
+					t.Fatal(err)
+				}
+			}
+			prefs, _ := json.Marshal(map[string]string{"default_vault_name": wrong})
+			if err := os.WriteFile(filepath.Join(cfg, "notesmd-cli/preferences.json"), prefs, 0644); err != nil {
+				t.Fatal(err)
+			}
+			// go test's build directory may be root-owned while the test runs
+			// as nobody. Copy the binary into our own executable temp directory.
+			binary := filepath.Join(dir, "audit-command.test")
+			executable, err := os.ReadFile(os.Args[0])
+			if err != nil {
+				executable, err = os.ReadFile("/proc/self/exe")
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(binary, executable, 0700); err != nil {
+				t.Fatal(err)
+			}
+			note := filepath.Join(vault, "Chosen Note.md")
+			initial := "---\ntitle: Old\nkeep: retained\n---\nBody\n"
+			flag := func(long, shorthand string) string {
+				if short {
+					return shorthand
+				}
+				return long
+			}
+			run := func(extra []string, wantOut, wantFile string) {
+				if err := os.WriteFile(note, []byte(initial), 0644); err != nil {
+					t.Fatal(err)
+				}
+				arguments := append([]string{alias, "Chosen Note", flag("--vault", "-v"), vault}, extra...)
+				data, _ := json.Marshal(arguments)
+				child := exec.Command(binary, "-test.run=^TestP2PFrontmatterCLIFlagsReachOperations$", "-test.count=1")
+				child.Env = append(os.Environ(), "NOTESMD_AUDIT_CHILD=1", "NOTESMD_AUDIT_ARGS="+string(data), "XDG_CONFIG_HOME="+cfg)
+				out, err := child.CombinedOutput()
+				if !assert.NoError(t, err, "%s", out) {
+					return
+				}
+				assert.Equal(t, wantOut+"PASS\n", string(out), "args=%v", arguments)
+				contents, err := os.ReadFile(note)
+				assert.NoError(t, err)
+				assert.Equal(t, wantFile, string(contents))
+			}
+			run([]string{flag("--print", "-p")}, "keep: retained\ntitle: Old\n", initial)
+			run([]string{flag("--edit", "-e"), flag("--key", "-k"), "title", "--value", "New"}, "Updated frontmatter key 'title' in Chosen Note", "---\nkeep: retained\ntitle: New\n---\nBody\n")
+			run([]string{flag("--delete", "-d"), flag("--key", "-k"), "title"}, "Deleted frontmatter key 'title' from Chosen Note", "---\nkeep: retained\n---\nBody\n")
+		}
+	}
+}
+
+func TestP2PFrontmatterStringFlagsBindOperationInputs(t *testing.T) {
+	flags := frontmatterCmd.Flags()
+	names := []string{"key", "value", "vault"}
+	previous := map[string]string{}
+	changed := map[string]bool{}
+	for _, name := range names {
+		flag := flags.Lookup(name)
+		if !assert.NotNil(t, flag) {
+			return
+		}
+		previous[name] = flag.Value.String()
+		changed[name] = flag.Changed
+		assert.Equal(t, "string", flag.Value.Type())
+	}
+	t.Cleanup(func() {
+		for _, name := range names {
+			assert.NoError(t, flags.Set(name, previous[name]))
+			flags.Lookup(name).Changed = changed[name]
+		}
+	})
+	for _, arguments := range [][]string{{"--key", "audit-key", "--value", "audit-value", "--vault", "audit-vault"}, {"-k", "audit-key", "--value", "audit-value", "-v", "audit-vault"}} {
+		for _, name := range names {
+			assert.NoError(t, flags.Set(name, ""))
+		}
+		assert.NoError(t, flags.Parse(arguments))
+		assert.Equal(t, "audit-key", flags.Lookup("key").Value.String())
+		assert.Equal(t, "audit-value", flags.Lookup("value").Value.String())
+		assert.Equal(t, "audit-vault", flags.Lookup("vault").Value.String())
+	}
+}
