+func TestGoldenOutputsAndExactErrors(t *testing.T) {
+	t.Run("SetKey golden outputs", func(t *testing.T) {
+		tests := []struct {
+			name     string
+			content  string
+			key      string
+			val      string
+			expected string
+		}{
+			{"update", "---\ntitle: Old\n---\nBody", "title", "New", "---\ntitle: New\n---\nBody"},
+			{"add", "---\ntitle: Test\n---\nBody", "author", "John", "---\nauthor: John\ntitle: Test\n---\nBody"},
+			{"create", "Just body", "title", "New", "---\ntitle: New\n---\nJust body"},
+			{"bool true", "---\n---\nBody", "draft", "true", "---\ndraft: true\n---\nBody"},
+			{"bool false", "---\n---\nBody", "published", "false", "---\npublished: false\n---\nBody"},
+			{"array", "---\n---\nBody", "tags", "[one, two, three]", "---\ntags:\n    - one\n    - two\n    - three\n---\nBody"},
+			{"empty array", "---\n---\nBody", "tags", "[]", "---\ntags: []\n---\nBody"},
+			{"numeric string", "---\n---\nBody", "count", "123", "---\ncount: \"123\"\n---\nBody"},
+			{"multiline body", "---\ntitle: Test\n---\nLine1\nLine2\n", "title", "New", "---\ntitle: New\n---\nLine1\nLine2\n"},
+		}
+		for _, tc := range tests {
+			t.Run(tc.name, func(t *testing.T) {
+				actual, err := frontmatter.SetKey(tc.content, tc.key, tc.val)
+				assert.NoError(t, err)
+				assert.Equal(t, tc.expected, actual)
+			})
+		}
+	})
+
+	t.Run("DeleteKey golden outputs", func(t *testing.T) {
+		tests := []struct {
+			name     string
+			content  string
+			key      string
+			expected string
+		}{
+			{"retain keys", "---\nauthor: John\ntitle: Test\n---\nBody", "author", "---\ntitle: Test\n---\nBody"},
+			{"final key", "---\ntitle: Test\n---\nBody", "title", "Body"},
+			{"final key with newline", "---\ntitle: Test\n---\n\nBody", "title", "Body"},
+			{"multiline body", "---\ntitle: Test\n---\nLine1\nLine2", "title", "Line1\nLine2"},
+			{"nonexistent key", "---\ntitle: Test\n---\nBody", "missing", "---\ntitle: Test\n---\nBody"},
+		}
+		for _, tc := range tests {
+			t.Run(tc.name, func(t *testing.T) {
+				actual, err := frontmatter.DeleteKey(tc.content, tc.key)
+				assert.NoError(t, err)
+				assert.Equal(t, tc.expected, actual)
+			})
+		}
+	})
+
+	t.Run("Reconstruction layout", func(t *testing.T) {
+		actual, err := frontmatter.SetKey("body", "k", "v")
+		assert.NoError(t, err)
