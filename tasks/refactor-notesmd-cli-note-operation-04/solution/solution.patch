+
+		_, err = frontmatter.SetKey("---\ninvalid: [unclosed\n---\nBody", "k", "v")
+		assert.EqualError(t, err, frontmatter.InvalidFrontmatterError)
+
+		_, err = frontmatter.DeleteKey("Just body", "k")
