+
+		_, err = frontmatter.DeleteKey("---\n---\nBody", "k")
+		assert.EqualError(t, err, frontmatter.NoFrontmatterError)
+
+		_, err = frontmatter.DeleteKey("---\ninvalid: [unclosed\n---\nBody", "k")
+		assert.EqualError(t, err, frontmatter.InvalidFrontmatterError)
+	})
+
+	t.Run("Format exact output", func(t *testing.T) {
+		formatted, err := frontmatter.Format(map[string]interface{}{"title": "Test"})
+		assert.NoError(t, err)
+		assert.Equal(t, "title: Test\n", formatted)
+
+		empty, err := frontmatter.Format(map[string]interface{}{})
+		assert.NoError(t, err)
+		assert.Equal(t, "", empty)
+
+		nilMap, err := frontmatter.Format(nil)
+		assert.NoError(t, err)
+		assert.Equal(t, "", nilMap)
+	})
