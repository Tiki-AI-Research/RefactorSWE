diff --git a/pkg/actions/frontmatter_test.go b/pkg/actions/frontmatter_test.go
index 2cead4688ffb3620e84e157944c6c33b75bf3b79..91ad2391d5d39b7cae22c2aeaafea3aab55bfeb5 100644
--- a/pkg/actions/frontmatter_test.go
+++ b/pkg/actions/frontmatter_test.go
@@ -235,3 +235,288 @@ func TestFrontmatter_NoOperation(t *testing.T) {
 		assert.Contains(t, err.Error(), "no operation specified")
 	})
 }
+
+type recordingVault struct {
+	mocks.MockVaultOperator
+	name           string
+	defaultNameErr error
+	pathErr        error
+	events         *[]string
+}
+
+func (v *recordingVault) DefaultName() (string, error) {
+	if v.events != nil {
+		*v.events = append(*v.events, "DefaultName")
+	}
+	if v.defaultNameErr != nil {
+		return "", v.defaultNameErr
+	}
+	return v.name, nil
+}
+
+func (v *recordingVault) Path() (string, error) {
+	if v.events != nil {
+		*v.events = append(*v.events, "Path")
+	}
+	if v.pathErr != nil {
+		return "", v.pathErr
+	}
+	return "/vault/" + v.name, nil
+}
+
+type recordingNote struct {
+	mocks.MockNoteManager
+	contents       string
+	getContentsErr error
+	setContentsErr error
+	setCalls       int
+	lastVaultPath  string
+	lastNoteName   string
+	lastWritten    string
+	events         *[]string
+}
+
+func (n *recordingNote) GetContents(vaultPath, noteName string) (string, error) {
+	if n.events != nil {
+		*n.events = append(*n.events, "GetContents")
+	}
+	if n.getContentsErr != nil {
+		return "", n.getContentsErr
+	}
+	return n.contents, nil
+}
+
+func (n *recordingNote) SetContents(vaultPath, noteName, contents string) error {
+	if n.events != nil {
+		*n.events = append(*n.events, "SetContents")
+	}
+	n.setCalls++
+	n.lastVaultPath = vaultPath
+	n.lastNoteName = noteName
+	n.lastWritten = contents
+	if n.setContentsErr != nil {
+		return n.setContentsErr
+	}
+	return nil
+}
+
+func TestFrontmatter_PrintEdgeCases(t *testing.T) {
+	t.Run("empty frontmatter block returns empty with zero writes", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		n := &recordingNote{contents: "---\n---\nBody"}
+		out, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "note1", Print: true})
+		assert.NoError(t, err)
+		assert.Equal(t, "", out)
+		assert.Equal(t, 0, n.setCalls)
+	})
+
+	t.Run("invalid YAML returns error with zero writes", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		n := &recordingNote{contents: "---\ninvalid: [unclosed\n---\nBody"}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "note1", Print: true})
+		assert.EqualError(t, err, "frontmatter contains invalid YAML")
+		assert.Equal(t, 0, n.setCalls)
+	})
+
+	t.Run("exact YAML output without body and zero writes", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		n := &recordingNote{contents: "---\ntitle: Test\n---\nBody"}
+		out, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "note1", Print: true})
+		assert.NoError(t, err)
+		assert.Equal(t, "title: Test\n", out)
+		assert.Equal(t, 0, n.setCalls)
+	})
+}
+
+func TestFrontmatter_SideEffectsAndErrors(t *testing.T) {
+	t.Run("edit input validation zero writes", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		n := &recordingNote{contents: "---\ntitle: Old\n---\nBody"}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Edit: true, Value: "val"})
+		assert.EqualError(t, err, "--key is required for edit operation")
+		assert.Equal(t, 0, n.setCalls)
+
+		_, err = actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Edit: true, Key: "k"})
+		assert.EqualError(t, err, "--value is required for edit operation")
+		assert.Equal(t, 0, n.setCalls)
+	})
+
+	t.Run("edit invalid YAML zero writes", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		n := &recordingNote{contents: "---\ninvalid: [unclosed\n---\nBody"}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Edit: true, Key: "k", Value: "v"})
+		assert.EqualError(t, err, "frontmatter contains invalid YAML")
+		assert.Equal(t, 0, n.setCalls)
+	})
+
+	t.Run("edit success wording and exactly one write", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		n := &recordingNote{contents: "---\ntitle: Old\n---\nBody"}
+		out, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Edit: true, Key: "title", Value: "New"})
+		assert.NoError(t, err)
+		assert.Equal(t, "Updated frontmatter key 'title' in n1", out)
+		assert.Equal(t, 1, n.setCalls)
+		assert.Equal(t, "/vault/v", n.lastVaultPath)
+		assert.Equal(t, "n1", n.lastNoteName)
+		assert.Equal(t, "---\ntitle: New\n---\nBody", n.lastWritten)
+	})
+
+	t.Run("edit create when no frontmatter writes once", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		n := &recordingNote{contents: "Just body"}
+		out, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Edit: true, Key: "title", Value: "New"})
+		assert.NoError(t, err)
+		assert.Equal(t, "Updated frontmatter key 'title' in n1", out)
+		assert.Equal(t, 1, n.setCalls)
+		assert.Equal(t, "---\ntitle: New\n---\nJust body", n.lastWritten)
+	})
+
+	t.Run("delete input validation and empty frontmatter zero writes", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		n := &recordingNote{contents: "---\ntitle: Old\n---\nBody"}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Delete: true})
+		assert.EqualError(t, err, "--key is required for delete operation")
+		assert.Equal(t, 0, n.setCalls)
+
+		n.contents = "Just body"
+		_, err = actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Delete: true, Key: "k"})
+		assert.EqualError(t, err, "note does not contain frontmatter")
+		assert.Equal(t, 0, n.setCalls)
+
+		n.contents = "---\n---\nBody"
+		_, err = actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Delete: true, Key: "k"})
+		assert.EqualError(t, err, "note does not contain frontmatter")
+		assert.Equal(t, 0, n.setCalls)
+
+		n.contents = "---\ninvalid: [unclosed\n---\nBody"
+		_, err = actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Delete: true, Key: "k"})
+		assert.EqualError(t, err, "frontmatter contains invalid YAML")
+		assert.Equal(t, 0, n.setCalls)
+	})
+
+	t.Run("delete success wording and write", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		n := &recordingNote{contents: "---\ntitle: Old\n---\nBody"}
+		out, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Delete: true, Key: "title"})
+		assert.NoError(t, err)
+		assert.Equal(t, "Deleted frontmatter key 'title' from n1", out)
+		assert.Equal(t, 1, n.setCalls)
+		assert.Equal(t, "Body", n.lastWritten)
+
+		// Deleting non-existent key still writes once
+		n = &recordingNote{contents: "---\ntitle: Old\n---\nBody"}
+		out, err = actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Delete: true, Key: "missing"})
+		assert.NoError(t, err)
+		assert.Equal(t, "Deleted frontmatter key 'missing' from n1", out)
+		assert.Equal(t, 1, n.setCalls)
+		assert.Equal(t, "---\ntitle: Old\n---\nBody", n.lastWritten)
+	})
+
+	t.Run("write error propagation occurs after single write attempt", func(t *testing.T) {
+		v := &recordingVault{name: "v"}
+		writeErr := errors.New("write failed")
+		n := &recordingNote{contents: "---\ntitle: Old\n---\nBody", setContentsErr: writeErr}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Edit: true, Key: "title", Value: "New"})
+		assert.Equal(t, writeErr, err)
+		assert.Equal(t, 1, n.setCalls)
+	})
+}
+
+func TestFrontmatter_OperationPriority(t *testing.T) {
+	v := &recordingVault{name: "v"}
+
+	t.Run("print takes precedence over edit", func(t *testing.T) {
+		n := &recordingNote{contents: "---\ntitle: Test\n---\nBody"}
+		out, err := actions.Frontmatter(v, n, actions.FrontmatterParams{
+			NoteName: "n1",
+			Print:    true,
+			Edit:     true,
+			Key:      "title",
+			Value:    "New",
+		})
+		assert.NoError(t, err)
+		assert.Equal(t, "title: Test\n", out)
+		assert.Equal(t, 0, n.setCalls)
+	})
+
+	t.Run("edit takes precedence over delete", func(t *testing.T) {
+		n := &recordingNote{contents: "---\ntitle: Test\n---\nBody"}
+		out, err := actions.Frontmatter(v, n, actions.FrontmatterParams{
+			NoteName: "n1",
+			Edit:     true,
+			Delete:   true,
+			Key:      "title",
+			Value:    "New",
+		})
+		assert.NoError(t, err)
+		assert.Equal(t, "Updated frontmatter key 'title' in n1", out)
+		assert.Equal(t, 1, n.setCalls)
+		assert.Equal(t, "---\ntitle: New\n---\nBody", n.lastWritten)
+	})
+
+	t.Run("all three specified chooses print", func(t *testing.T) {
+		n := &recordingNote{contents: "---\ntitle: Test\n---\nBody"}
+		out, err := actions.Frontmatter(v, n, actions.FrontmatterParams{
+			NoteName: "n1",
+			Print:    true,
+			Edit:     true,
+			Delete:   true,
+			Key:      "title",
+			Value:    "New",
+		})
+		assert.NoError(t, err)
+		assert.Equal(t, "title: Test\n", out)
+		assert.Equal(t, 0, n.setCalls)
+	})
+}
+
+func TestFrontmatter_ErrorPrecedence(t *testing.T) {
+	t.Run("default name error precedence", func(t *testing.T) {
+		events := []string{}
+		defErr := errors.New("default err")
+		v := &recordingVault{name: "v", defaultNameErr: defErr, events: &events}
+		n := &recordingNote{contents: "Body", events: &events}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1"})
+		assert.Equal(t, defErr, err)
+		assert.Equal(t, []string{"DefaultName"}, events)
+	})
+
+	t.Run("path error precedence", func(t *testing.T) {
+		events := []string{}
+		pathErr := errors.New("path err")
+		v := &recordingVault{name: "v", pathErr: pathErr, events: &events}
+		n := &recordingNote{contents: "Body", events: &events}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1"})
+		assert.Equal(t, pathErr, err)
+		assert.Equal(t, []string{"DefaultName", "Path"}, events)
+	})
+
+	t.Run("get contents error precedence", func(t *testing.T) {
+		events := []string{}
+		getErr := errors.New("get err")
+		v := &recordingVault{name: "v", events: &events}
+		n := &recordingNote{getContentsErr: getErr, events: &events}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1"})
+		assert.Equal(t, getErr, err)
+		assert.Equal(t, []string{"DefaultName", "Path", "GetContents"}, events)
+	})
+
+	t.Run("all prerequisites succeed before no-op error", func(t *testing.T) {
+		events := []string{}
+		v := &recordingVault{name: "v", events: &events}
+		n := &recordingNote{contents: "Body", events: &events}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1"})
+		assert.EqualError(t, err, "no operation specified: use --print, --edit, or --delete")
+		assert.Equal(t, []string{"DefaultName", "Path", "GetContents"}, events)
+	})
+
+	t.Run("read error precedes edit validation error", func(t *testing.T) {
+		events := []string{}
+		getErr := errors.New("get err")
+		v := &recordingVault{name: "v", events: &events}
+		n := &recordingNote{getContentsErr: getErr, events: &events}
+		_, err := actions.Frontmatter(v, n, actions.FrontmatterParams{NoteName: "n1", Edit: true})
+		assert.Equal(t, getErr, err)
+		assert.Equal(t, []string{"DefaultName", "Path", "GetContents"}, events)
+	})
+}
