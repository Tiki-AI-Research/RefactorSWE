+		assert.Equal(t, frontmatter.Delimiter, parts[0])
+		assert.Equal(t, "k: v", parts[1])
+		assert.Equal(t, frontmatter.Delimiter, parts[2])
+		assert.Equal(t, "body", parts[3])
+	})
+
+	t.Run("Exact errors", func(t *testing.T) {
