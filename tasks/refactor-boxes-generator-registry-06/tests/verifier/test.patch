+"""Supplemental fail-to-pass (F2P) checks for the generator discovery consolidation.
+
+Every check in this module observes an externally visible acceptance surface that the
+frozen Baseline checkout violates and that the consolidated generator catalog has to
+satisfy:
+
+* repeated CLI listings, web server constructions and gallery renders must not grow any
+  group's generator collection with duplicates,
+* the ``BOXES_GENERATOR_PATH`` extension directories must keep being discovered without
+  permanently mutating the generator package search path,
+* a generator whose ``ui_group`` is not registered must keep falling back to ``Misc``.
+
+Each check runs its scenario in a fresh interpreter against the repository copy that is
+under test, so module-level state cannot leak between checks and every selector below can
+be executed and graded on its own.
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import textwrap
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+
+_PREAMBLE = r'''
+import json
+from pathlib import Path
+
+import boxes
+
+_REPO_ROOT = Path(__REPO_ROOT__).resolve()
+assert Path(boxes.__file__).resolve().is_relative_to(_REPO_ROOT), (
+    "the repository copy under test must be imported, got %s" % (boxes.__file__,)
+)
+'''
+
+_LISTING_HELPERS = r'''
+import contextlib
+import io
+import re
+
+import boxes.generators as generators
+from boxes.scripts.boxes_main import print_grouped_generators
+
+_ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
+_ENTRY_RE = re.compile(r"^ \*  (\S+) +- \x1b\[3m(.*)\x1b\[0m$")
+
+
+def run_listing():
+    buffer = io.StringIO()
+    with contextlib.redirect_stdout(buffer):
+        print_grouped_generators()
+    return buffer.getvalue()
+
+
+def parse_listing(text):
+    payload = {"headers": [], "entries": [], "invalid": [], "sections": {}, "lines": text.split("\n")}
+    current = None
+    for line in payload["lines"]:
+        if line.startswith(" *  "):
+            match = _ENTRY_RE.match(line)
+            if match is None or line != (
+                f" *  {match.group(1):<15} - \x1b[3m{match.group(2)}\x1b[0m"
+            ):
+                payload["invalid"].append(line)
+                continue
+            payload["entries"].append([match.group(1), match.group(2)])
+            if current is not None:
+                payload["sections"][current].append(match.group(1))
+        elif "\x1b[4m" in line:
+            current = _ANSI_RE.sub("", line)
+            payload["headers"].append(current)
+            payload["sections"][current] = []
+    return payload
+
+
+def generator_class_names():
+    return sorted({value.__name__ for value in generators.getAllBoxGenerators().values()})
+
+
+def listing_summary(payload):
+    names = [entry[0] for entry in payload["entries"]]
+    classes = generator_class_names()
+    return {
+        "headers": payload["headers"],
+        "sections": payload["sections"],
+        "invalid": payload["invalid"],
+        "duplicates": sorted({name for name in names if names.count(name) > 1}),
+        "missing": sorted(set(classes) - set(names)),
+        "extra": sorted(set(names) - set(classes)),
+        "entry_count": len(names),
+        "class_count": len(classes),
+        "hole_pattern_count": names.count("HolePattern"),
+    }
+'''
+
+_SERVER_HELPERS = r'''
+import boxes.generators as generators
+from boxes.scripts.boxesserver import BServer
+
+
+def web_generator_names():
+    return sorted(
+        {value.__name__ for value in generators.getAllBoxGenerators().values() if value.webinterface}
+    )
+
+
+def server_group_payload(server):
+    members = [box.__name__ for group in server.groups for box in group.generators]
+    return {
+        "members": members,
+        "duplicates": sorted({name for name in members if members.count(name) > 1}),
+        "groups": {group.name: [box.__name__ for box in group.generators] for group in server.groups},
+        "group_names": [group.name for group in server.groups],
+        "box_names": sorted(server.boxes),
+    }
+'''
+
+_GALLERY_HELPERS = r'''
+import re
+
+
+def render_gallery(server):
+    captured = {}
+
+    def start_response(status, headers):
+        captured["status"] = status
+
+    environ = {
+        "PATH_INFO": "/",
+        "QUERY_STRING": "",
+        "HTTP_ACCEPT_LANGUAGE": "en",
+        "REQUEST_METHOD": "GET",
+        "SCRIPT_NAME": "",
+        "SERVER_NAME": "localhost",
+        "HTTP_HOST": "localhost",
+    }
+    parts = server.serve(dict(environ), start_response)
+    return captured.get("status"), b"".join(parts).decode("utf-8")
+
+
+def gallery_entry_names(html):
+    return re.findall(r'id="search_id_([^"]+)"', html)
+'''
+
+_PROBE_GENERATOR_SOURCE = '''"""Generator module written into a temporary directory by the F2P checks."""
+
+from __future__ import annotations
+
+from boxes import Boxes
+
+
+class {class_name}(Boxes):
+    """F2P probe generator"""
+
+    ui_group = {ui_group!r}
+    webinterface = {webinterface!r}
+'''
+
+
+def _run_probe(snippet: str, env_extra: dict[str, str] | None = None) -> dict:
+    """Run a snippet in a fresh interpreter against the repository copy under test."""
+    environment = dict(os.environ)
+    environment.pop("BOXES_GENERATOR_PATH", None)
+    environment["PYTHONPATH"] = os.pathsep.join(
+        part for part in (str(REPO_ROOT), environment.get("PYTHONPATH", "")) if part
+    )
+    environment["PYTHONDONTWRITEBYTECODE"] = "1"
+    if env_extra:
+        environment.update(env_extra)
+    program = textwrap.dedent(snippet).replace("__REPO_ROOT__", repr(str(REPO_ROOT)))
+    completed = subprocess.run(
+        [sys.executable, "-c", program],
+        cwd=str(REPO_ROOT),
+        env=environment,
+        capture_output=True,
+        text=True,
+        timeout=300,
+    )
+    assert completed.returncode == 0, (
+        "probe process failed with exit code %d:\n%s"
+        % (completed.returncode, completed.stderr[-4000:])
+    )
+    lines = [line for line in completed.stdout.splitlines() if line.strip()]
+    assert lines, "probe process produced no output:\n%s" % (completed.stderr[-2000:],)
+    return json.loads(lines[-1])
+
+
+def _write_probe_generator(
+    directory: Path,
+    module_name: str,
+    class_name: str,
+    ui_group: str,
+    webinterface: bool = False,
+) -> None:
+    (directory / (module_name + ".py")).write_text(
+        _PROBE_GENERATOR_SOURCE.format(
+            class_name=class_name, ui_group=ui_group, webinterface=webinterface
+        ),
+        encoding="utf-8",
+    )
+
+
+def test_repeated_cli_listing_emits_each_generator_once() -> None:
+    """REQ-BEH-T4:B2, REQ-BEH-T4:B3, REQ-STRUCT-002: a second listing in one process stays complete."""
+    payload = _run_probe(
+        _PREAMBLE
+        + _LISTING_HELPERS
+        + r'''
+_first = parse_listing(run_listing())
+_second = parse_listing(run_listing())
+_summary = listing_summary(_second)
+print(json.dumps({
+    "first_entry_count": len(_first["entries"]),
+    "invalid": _summary["invalid"],
+    "duplicates": _summary["duplicates"],
+    "missing": _summary["missing"],
+    "extra": _summary["extra"],
+    "hole_pattern_count": _summary["hole_pattern_count"],
+    "entry_count": _summary["entry_count"],
+    "class_count": _summary["class_count"],
+}))
+'''
+    )
+    assert payload["invalid"] == []
+    assert payload["duplicates"] == []
+    assert payload["missing"] == []
+    assert payload["extra"] == []
+    assert payload["hole_pattern_count"] == 1
+    assert payload["class_count"] > 100
+    assert payload["first_entry_count"] == payload["class_count"]
+    assert payload["entry_count"] == payload["class_count"]
+
+
+def test_cli_listing_after_webserver_construction_is_not_duplicated() -> None:
+    """REQ-BEH-T4:B2, REQ-BEH-T4:B3, REQ-STRUCT-004: the listing stays complete after a server was built."""
+    payload = _run_probe(
+        _PREAMBLE
+        + _LISTING_HELPERS
+        + r'''
+from boxes.scripts.boxesserver import BServer
+
+_server = BServer()
+_summary = listing_summary(parse_listing(run_listing()))
+print(json.dumps({
+    "invalid": _summary["invalid"],
+    "duplicates": _summary["duplicates"],
+    "missing": _summary["missing"],
+    "extra": _summary["extra"],
+    "entry_count": _summary["entry_count"],
+    "class_count": _summary["class_count"],
+}))
+'''
+    )
+    assert payload["invalid"] == []
+    assert payload["duplicates"] == []
+    assert payload["missing"] == []
+    assert payload["extra"] == []
+    assert payload["class_count"] > 100
+    assert payload["entry_count"] == payload["class_count"]
+
+
+def test_repeated_webserver_construction_keeps_group_members_unique() -> None:
+    """REQ-BEH-T4:B3, REQ-STRUCT-001, REQ-STRUCT-002: two server objects share one stable group view."""
+    payload = _run_probe(
+        _PREAMBLE
+        + _SERVER_HELPERS
+        + r'''
+_first = BServer()
+_second = BServer()
+_web = web_generator_names()
+_payload = server_group_payload(_second)
+print(json.dumps({
+    "web": _web,
+    "members": _payload["members"],
+    "duplicates": _payload["duplicates"],
+    "group_names": _payload["group_names"],
+    "box_names": _payload["box_names"],
+}))
+'''
+    )
+    assert payload["web"] and len(payload["web"]) > 100
+    assert payload["duplicates"] == []
+    assert set(payload["members"]) == set(payload["web"])
+    assert len(payload["members"]) == len(payload["web"])
+    assert payload["box_names"] == payload["web"]
+    assert payload["group_names"]
+
+
+def test_gallery_of_earlier_server_stays_unique_after_second_construction() -> None:
+    """REQ-BEH-T4:C6, REQ-BEH-T4:B3: an earlier server handle is not corrupted by a later server."""
+    payload = _run_probe(
+        _PREAMBLE
+        + _SERVER_HELPERS
+        + _GALLERY_HELPERS
+        + r'''
+_first = BServer()
+_second = BServer()
+_status, _html = render_gallery(_first)
+_entries = gallery_entry_names(_html)
+_web = web_generator_names()
+print(json.dumps({
+    "status": _status,
+    "web": _web,
+    "entries": _entries,
+    "entry_duplicates": sorted({name for name in _entries if _entries.count(name) > 1}),
+}))
+'''
+    )
+    assert payload["status"] == "200 OK"
+    assert payload["web"] and len(payload["web"]) > 100
+    assert payload["entry_duplicates"] == []
+    assert set(payload["entries"]) == set(payload["web"])
+    assert len(payload["entries"]) == len(payload["web"])
+
+
+def test_webserver_after_listing_exposes_web_generators_once() -> None:
+    """REQ-BEH-T4:C6, REQ-BEH-T4:B3, REQ-STRUCT-004: the server view stays web-only after a listing."""
+    payload = _run_probe(
+        _PREAMBLE
+        + _LISTING_HELPERS
+        + _SERVER_HELPERS
+        + r'''
+run_listing()
+_server = BServer()
+_payload = server_group_payload(_server)
+_web = web_generator_names()
+print(json.dumps({
+    "web": _web,
+    "members": _payload["members"],
+    "duplicates": _payload["duplicates"],
+}))
+'''
+    )
+    assert payload["web"] and len(payload["web"]) > 100
+    assert payload["duplicates"] == []
+    assert set(payload["members"]) == set(payload["web"])
+    assert len(payload["members"]) == len(payload["web"])
+
+
+def test_gallery_after_listing_has_one_entry_per_web_generator() -> None:
+    """REQ-BEH-T4:C6, REQ-BEH-T4:B3, REQ-STRUCT-004: the rendered gallery stays web-only after a listing."""
+    payload = _run_probe(
+        _PREAMBLE
+        + _LISTING_HELPERS
+        + _SERVER_HELPERS
+        + _GALLERY_HELPERS
+        + r'''
+run_listing()
+_server = BServer()
+_status, _html = render_gallery(_server)
+_entries = gallery_entry_names(_html)
+_web = web_generator_names()
+print(json.dumps({
+    "status": _status,
+    "web": _web,
+    "entries": _entries,
+    "entry_duplicates": sorted({name for name in _entries if _entries.count(name) > 1}),
+}))
+'''
+    )
+    assert payload["status"] == "200 OK"
+    assert payload["web"] and len(payload["web"]) > 100
+    assert payload["entry_duplicates"] == []
+    assert set(payload["entries"]) == set(payload["web"])
+    assert len(payload["entries"]) == len(payload["web"])
+
+
+def test_extension_path_generator_listed_once_across_repeated_listings() -> None:
+    """REQ-BEH-T4:C4, REQ-BEH-T4:B5, REQ-BEH-T4:B3: an extension generator is listed once, not per run."""
+    with tempfile.TemporaryDirectory() as temporary_directory:
+        _write_probe_generator(Path(temporary_directory), "f2p_probe_misc", "F2PProbeMisc", "Misc")
+        payload = _run_probe(
+            _PREAMBLE
+            + _LISTING_HELPERS
+            + r'''
+parse_listing(run_listing())
+_second = parse_listing(run_listing())
+_summary = listing_summary(_second)
+print(json.dumps({
+    "headers": _summary["headers"],
+    "misc_names": _summary["sections"].get("Misc", []),
+    "invalid": _summary["invalid"],
+    "duplicates": _summary["duplicates"],
+    "missing": _summary["missing"],
+    "extra": _summary["extra"],
+    "entry_count": _summary["entry_count"],
+    "class_count": _summary["class_count"],
+}))
+''',
+            {"BOXES_GENERATOR_PATH": temporary_directory},
+        )
+    assert payload["invalid"] == []
+    assert payload["misc_names"].count("F2PProbeMisc") == 1
+    assert payload["duplicates"] == []
+    assert payload["missing"] == []
+    assert payload["extra"] == []
+    assert payload["class_count"] > 100
+    assert payload["entry_count"] == payload["class_count"]
+
