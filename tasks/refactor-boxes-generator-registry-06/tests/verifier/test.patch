+def test_box_generator_discovery_does_not_mutate_package_search_path() -> None:
+    """REQ-STRUCT-003, REQ-BEH-T4:C4: getAllBoxGenerators() must not permanently extend __path__."""
+    with tempfile.TemporaryDirectory() as temporary_directory:
+        _write_probe_generator(Path(temporary_directory), "f2p_probe_path", "F2PProbePath", "Misc")
+        payload = _run_probe(
+            _PREAMBLE
+            + r'''
+import boxes.generators as generators
+
+_extra_key = "boxes.generators.f2p_probe_path.F2PProbePath"
+_before = list(generators.__path__)
+_first = generators.getAllBoxGenerators()
+_middle = list(generators.__path__)
+_second = generators.getAllBoxGenerators()
+_after = list(generators.__path__)
+print(json.dumps({
+    "before": _before,
+    "middle": _middle,
+    "after": _after,
+    "added_after_first": [path for path in _middle if path not in _before],
+    "added_after_second": [path for path in _after if path not in _before],
+    "first_count": len(_first),
+    "second_count": len(_second),
+    "extra_present": _extra_key in _second,
