+++ b/tests/f2p_selectors_runner.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Aggregate runner for the frozen P2P + F2P verification plan.
+
+The runner never guesses a selection set from test files, directory patterns or the
+original inventory.  It reads the frozen exact selectors from the canonical
+``config.json`` that the pipeline materialises from the merged plan (the ``p2p`` and
+``f2p`` arrays, falling back to the frozen ``p2p``/``f2p`` gate rows) and executes
+exactly those selectors with a real pytest producer.  The complete JUnit report for the
+run is written to the path given via ``--report``.
+
+Usage:
+    python3 tests/f2p_selectors_runner.py --config {config} --report {report}
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+_SELECTOR_KEYS = ("selectors", "tests", "test", "selector", "node", "id")
+_ARRAY_KEYS = ("p2p", "f2p")
+_GATE_KINDS = ("P2P", "F2P")
+
+
+def _selector_strings(value) -> list[str]:
+    """Collect exact selector strings from a config value of any supported shape."""
+    if isinstance(value, str):
+        return [value]
+    if isinstance(value, dict):
+        for key in _SELECTOR_KEYS:
+            item = value.get(key)
+            if isinstance(item, str):
+                return [item]
+            if isinstance(item, (list, tuple)):
+                result = []
+                for entry in item:
+                    result.extend(_selector_strings(entry))
+                return result
+        return []
+    if isinstance(value, (list, tuple)):
+        result = []
+        for entry in value:
+            result.extend(_selector_strings(entry))
+        return result
+    return []
+
+
+def collect_selectors(config: dict) -> list[str]:
+    selectors: list[str] = []
+    for key in _ARRAY_KEYS:
+        if key in config:
+            for selector in _selector_strings(config[key]):
+                if selector not in selectors:
+                    selectors.append(selector)
+    if not selectors:
+        for gate in config.get("gates") or []:
+            if not isinstance(gate, dict) or gate.get("kind") not in _GATE_KINDS:
+                continue
+            for selector in _selector_strings(gate.get("tests")):
+                if selector not in selectors:
+                    selectors.append(selector)
+    return selectors
+
+
+def _locate_config(candidate: Path, repository_root: Path) -> Path | None:
+    """Return the first existing config path, searching only when the declared one is missing."""
+    if candidate.is_file():
+        return candidate
+    search_roots = [Path.cwd(), repository_root, repository_root.parent]
+    search_roots.extend(repository_root.parents[:3])
+    seen: list[Path] = []
+    for root in search_roots:
+        for probe in (root / "config.json", root / "verifier" / "config.json"):
+            if probe not in seen:
+                seen.append(probe)
+                if probe.is_file():
+                    return probe
+    return None
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", required=True, help="canonical config.json with the frozen selectors")
+    parser.add_argument("--report", required=True, help="path of the JUnit report to write")
+    args = parser.parse_args(argv)
+
+    repository_root = Path(__file__).resolve().parent.parent
+    config_path = _locate_config(Path(args.config).expanduser(), repository_root)
+    if config_path is None:
+        print("config not found: %s" % (args.config,), file=sys.stderr)
+        return 2
+    config = json.loads(config_path.read_text(encoding="utf-8"))
+    if not isinstance(config, dict):
+        print("config must be a JSON object", file=sys.stderr)
+        return 2
+
+    selectors = collect_selectors(config)
+    if not selectors:
+        print("no frozen P2P/F2P exact selectors found in %s" % (config_path,), file=sys.stderr)
+        return 2
+
+    report_path = Path(args.report).expanduser()
+    if not report_path.is_absolute():
+        report_path = Path.cwd() / report_path
+    command = [
+        sys.executable,
+        "-m",
+        "pytest",
+        *selectors,
+        "--junit-xml",
+        str(report_path),
+        "-p",
+        "no:cacheprovider",
+        "-q",
+    ]
+    return subprocess.run(command, cwd=str(repository_root)).returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
