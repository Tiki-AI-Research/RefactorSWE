+print(json.dumps({"new_scans": scans[before:], "statuses": [first_status, second_status],
+                  "first": sorted(re.findall(r'id="search_id_([^"]+)"', first)),
+                  "second": sorted(re.findall(r'id="search_id_([^"]+)"', second))}))
