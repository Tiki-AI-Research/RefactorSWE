+"""Task-contract regressions for the independently audited catalog omissions.
+
+Each selector runs a real public consumer in a fresh process. Private catalog
+names and cache container shapes are deliberately not prescribed.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import textwrap
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+MANIFEST = json.loads((Path(__file__).parent / "p2p_baseline_manifest.json").read_text())
+WEB_NAMES = sorted({key.rsplit(".", 1)[1] for key, flags in MANIFEST["generators"].items() if flags[0]})
+
+
+def _probe(program: str) -> dict:
+    environment = dict(os.environ)
+    environment.pop("BOXES_GENERATOR_PATH", None)
+    environment["PYTHONPATH"] = str(REPO_ROOT)
+    environment["PYTHONDONTWRITEBYTECODE"] = "1"
+    prefix = "import json, os, sys\nfrom pathlib import Path\n"
+    prefix += f"sys.path.insert(0, {str(REPO_ROOT)!r})\n"
+    prefix += "import boxes.generators as generators\n"
+    prefix += f"assert Path(generators.__file__).resolve().is_relative_to(Path({str(REPO_ROOT)!r}))\n"
+    completed = subprocess.run(
+        [sys.executable, "-B", "-c", prefix + textwrap.dedent(program)],
+        cwd=REPO_ROOT, env=environment, capture_output=True, text=True, timeout=300,
+    )
+    assert completed.returncode == 0, completed.stderr[-4000:]
+    return json.loads(completed.stdout.splitlines()[-1])
+
+
+_SCAN_TRACE = r'''
+import pkgutil
+
+scans = []
+metadata_reads = []
+_walk_code = pkgutil.walk_packages.__code__
+_generator_root = Path(generators.__file__).resolve().parent
+
+
+def _profile(frame, event, argument):
+    if event == "call" and frame.f_code is _walk_code:
+        if frame.f_locals.get("prefix", "").startswith("boxes.generators."):
+            scans.append("walk_packages")
+
+
+def _audit(event, arguments):
+    if event in {"os.listdir", "os.scandir"} and arguments:
+        path = arguments[0]
+        if isinstance(path, (str, bytes, os.PathLike)):
+            if isinstance(path, bytes):
+                path = os.fsdecode(path)
+            if Path(path).resolve().is_relative_to(_generator_root):
+                metadata_reads.append(event)
+
+
+sys.setprofile(_profile)
+sys.addaudithook(_audit)
+'''
+
+_SERVER = r'''
+from boxes.scripts.boxesserver import BServer
+
+
+def group_members(groups=None):
+    source = generators.ui_groups if groups is None else groups
+    return [[group.name, [cls.__module__ + "." + cls.__name__ for cls in group.generators]]
+            for group in source]
+
+
+def gallery(server):
+    captured = {}
+
+    def start_response(status, headers):
+        captured["status"] = status
+
+    environ = {"PATH_INFO": "/", "QUERY_STRING": "", "HTTP_ACCEPT_LANGUAGE": "en",
+               "REQUEST_METHOD": "GET", "SCRIPT_NAME": "", "SERVER_NAME": "localhost",
+               "HTTP_HOST": "localhost"}
+    html = b"".join(server.serve(environ, start_response)).decode("utf-8")
+    return captured.get("status"), html
+'''
+
+
+def test_cached_discovery_views_share_scan() -> None:
+    """F-CATALOG: module/full views reuse the warmed class discovery source."""
+    result = _probe(_SCAN_TRACE + r'''
+first = generators.getAllBoxGenerators()
+before = len(scans)
+modules = generators.getAllGeneratorModules()
+second = generators.getAllBoxGenerators()
+again = generators.getAllGeneratorModules()
+print(json.dumps({"new_scans": scans[before:], "keys_equal": set(first) == set(second),
+                  "modules_equal": set(modules) == set(again), "count": len(second)}))
+''')
+    assert result["new_scans"] == []
+    assert result["keys_equal"] and result["modules_equal"]
+    assert result["count"] == MANIFEST["generator_count"]
+
+
+def test_cli_listing_uses_warmed_catalog() -> None:
+    """F-CATALOG: real CLI listing cannot independently rescan discovery."""
+    result = _probe(_SCAN_TRACE + r'''
