+from boxes.scripts.boxes_main import print_grouped_generators
+generators.getAllBoxGenerators()
+before = len(scans)
+buffer = io.StringIO()
+with contextlib.redirect_stdout(buffer):
+    print_grouped_generators()
+print(json.dumps({"new_scans": scans[before:], "output": buffer.getvalue()}))
+''')
+    assert result["new_scans"] == []
+    assert result["output"].startswith("Available generators:")
+
+
+def test_generator_snapshot_uses_warmed_catalog() -> None:
+    """F-CATALOG: importing the snapshot consumes warmed catalog discovery."""
+    result = _probe(_SCAN_TRACE + r'''
