+"""Supplemental pass-to-pass (P2P) regression checks for the generator discovery refactor.
+
+Every assertion in this module already holds on the frozen Baseline checkout.  The
+module freezes the externally observable behaviour of the discovery entry points,
+the UI group registry, the ``--list`` CLI output and the web server catalog and
+checks that none of it shrinks or changes.  Each check runs in a fresh interpreter
+so that module level state of the package under test (discovery paths, UI group
+membership, ...) cannot leak between checks.
+
+The expected values in ``p2p_baseline_manifest.json`` were collected from the
+Baseline checkout before this refactor.
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import textwrap
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+MANIFEST = json.loads(
+    (Path(__file__).resolve().parent / "p2p_baseline_manifest.json").read_text(encoding="utf-8")
+)
+
+EXPECTED_GENERATOR_KEYS = sorted(MANIFEST["generators"])
+EXPECTED_WEB_NAMES = sorted(
+    {key.rsplit(".", 1)[-1] for key, flags in MANIFEST["generators"].items() if flags[0]}
+)
+EXPECTED_GROUP_NAMES = [group[0] for group in MANIFEST["groups"]]
+
+_PREAMBLE = r'''
+import json
+import re
+from pathlib import Path
+
+import boxes
+
+_REPO_ROOT = Path(__REPO_ROOT__).resolve()
+assert Path(boxes.__file__).resolve().is_relative_to(_REPO_ROOT), (
+    "the repository copy under test must be imported, got %s" % (boxes.__file__,)
+)
+'''
+
+_PROBE_GENERATOR_SOURCE = '''"""Generator module written into a temporary directory by the P2P checks."""
+
+from __future__ import annotations
+
+from boxes import Boxes
+
+
+class {class_name}(Boxes):
+    """P2P probe generator"""
+
+    ui_group = {ui_group!r}
+    webinterface = False
+'''
+
+_LISTING_SCRIPT = r'''
+import contextlib
+import io
+import sys
+
+import boxes.generators as generators
+from boxes.scripts.boxes_main import main
+
+_buffer = io.StringIO()
+_argv = sys.argv
+sys.argv = ["boxes", "--list"]
+try:
+    with contextlib.redirect_stdout(_buffer):
+        main()
+finally:
+    sys.argv = _argv
+
+_lines = _buffer.getvalue().split("\n")
+_ansi = re.compile(r"\x1b\[[0-9;]*m")
+_entry_re = re.compile(r"^ \*  (\S+) +- \x1b\[3m(.*)\x1b\[0m$")
+
+_header_positions = [
+    index for index, line in enumerate(_lines)
+    if "\x1b[4m" in line and not line.startswith(" *  ")
+]
+_entries = []
+_invalid_entries = []
+for _line in _lines:
+    if not _line.startswith(" *  "):
+        continue
+    _match = _entry_re.match(_line)
+    if _match is None or _line != (
+        f" *  {_match.group(1):<15} - \x1b[3m{_match.group(2)}\x1b[0m"
+    ):
+        _invalid_entries.append(_line)
+    else:
+        _entries.append([_match.group(1), _match.group(2)])
+
+_sections = []
+for _position, _next_position in zip(_header_positions, _header_positions[1:] + [len(_lines)]):
+    _section_lines = _lines[_position:_next_position]
+    _names = []
+    for _line in _section_lines[1:]:
+        _match = _entry_re.match(_line)
+        if _match:
+            _names.append(_match.group(1))
+    _description = ""
+    if len(_section_lines) > 2 and not _section_lines[2].startswith(" *  "):
+        _description = _section_lines[2]
+    _sections.append(
+        {"title": _ansi.sub("", _section_lines[0]), "description": _description, "names": _names}
+    )
+
+_all_generators = generators.getAllBoxGenerators()
+_class_names = sorted({value.__name__ for value in _all_generators.values()})
+_docs_by_name = {}
+for _value in _all_generators.values():
+    _docs_by_name.setdefault(_value.__name__, []).append(
+        (_value.__doc__ or "").replace("\n", "").replace("\r", "").strip()
+    )
+_entry_names = [entry[0] for entry in _entries]
+
+listing_payload = {
+    "first_line": _lines[0],
+    "second_line": _lines[1],
+    "headers": [_ansi.sub("", _lines[_position]) for _position in _header_positions],
+    "sections": _sections,
+    "entries": _entries,
+    "invalid_entries": _invalid_entries,
+    "class_names": _class_names,
+    "duplicate_names": sorted({name for name in _entry_names if _entry_names.count(name) > 1}),
+    "unknown_names": sorted(set(_entry_names) - set(_class_names)),
+    "missing_names": sorted(set(_class_names) - set(_entry_names)),
+    "hole_pattern_count": _entry_names.count("HolePattern"),
+    "description_mismatches": sorted(
+        {name for name, description in _entries if description not in _docs_by_name.get(name, [])}
+    ),
+}
+'''
+
+
+def _run_probe(snippet: str, env_extra: dict[str, str] | None = None) -> dict:
+    """Run a snippet in a fresh interpreter against the repository copy of the package."""
+    environment = dict(os.environ)
+    environment.pop("BOXES_GENERATOR_PATH", None)
+    environment["PYTHONPATH"] = os.pathsep.join(
+        part for part in (str(REPO_ROOT), environment.get("PYTHONPATH", "")) if part
+    )
+    environment["PYTHONDONTWRITEBYTECODE"] = "1"
+    if env_extra:
+        environment.update(env_extra)
+    program = textwrap.dedent(snippet).replace("__REPO_ROOT__", repr(str(REPO_ROOT)))
+    completed = subprocess.run(
+        [sys.executable, "-c", program],
+        cwd=str(REPO_ROOT),
+        env=environment,
+        capture_output=True,
+        text=True,
+        timeout=300,
+    )
+    assert completed.returncode == 0, (
+        "probe process failed with exit code %d:\n%s"
+        % (completed.returncode, completed.stderr[-4000:])
+    )
+    lines = [line for line in completed.stdout.splitlines() if line.strip()]
+    assert lines, "probe process produced no output:\n%s" % (completed.stderr[-2000:],)
+    return json.loads(lines[-1])
+
+
+def _listing_payload(env_extra: dict[str, str] | None = None) -> dict:
+    return _run_probe(
+        _PREAMBLE + _LISTING_SCRIPT + "\nprint(json.dumps(listing_payload))\n", env_extra
+    )
+
+
+def _write_probe_generator(directory: Path, module_name: str, class_name: str, ui_group: str) -> None:
+    (directory / (module_name + ".py")).write_text(
+        _PROBE_GENERATOR_SOURCE.format(class_name=class_name, ui_group=ui_group),
+        encoding="utf-8",
+    )
+
+
+def test_entry_point_signatures_accept_no_arguments() -> None:
+    """REQ-BEH-T4:C1, REQ-BEH-T4:C2, REQ-INTEGRITY-001: entry points stay callable without arguments."""
+    payload = _run_probe(
+        _PREAMBLE
+        + r'''
+import inspect
+
+import boxes.generators as generators
+
+
+def _required_parameters(signature):
+    return [
+        parameter.name
+        for parameter in signature.parameters.values()
+        if parameter.kind
+        in (parameter.POSITIONAL_ONLY, parameter.POSITIONAL_OR_KEYWORD, parameter.KEYWORD_ONLY)
+        and parameter.default is inspect.Parameter.empty
+    ]
+
+
+_all_box = generators.getAllBoxGenerators()
+_modules = generators.getAllGeneratorModules()
+print(json.dumps({
+    "required_all_box": _required_parameters(inspect.signature(generators.getAllBoxGenerators)),
+    "required_modules": _required_parameters(inspect.signature(generators.getAllGeneratorModules)),
+    "all_box_is_dict": isinstance(_all_box, dict),
+    "modules_is_dict": isinstance(_modules, dict),
+    "all_box_count": len(_all_box),
+    "module_count": len(_modules),
+}))
+'''
+    )
+    assert payload["required_all_box"] == []
+    assert payload["required_modules"] == []
+    assert payload["all_box_is_dict"] is True
+    assert payload["modules_is_dict"] is True
+    assert payload["all_box_count"] == MANIFEST["generator_count"]
+    assert payload["module_count"] >= MANIFEST["module_count"]
+
+
+def test_box_generators_mapping_shape() -> None:
+    """REQ-BEH-T4:C1: mapping is keyed by module.ClassName and holds generator classes."""
+    payload = _run_probe(
+        _PREAMBLE
+        + r'''
+import inspect
+
+import boxes
+import boxes.generators as generators
+
+_all_box = generators.getAllBoxGenerators()
+_not_a_class = []
+_name_suffix_mismatch = []
+_key_pattern_mismatch = []
+for _key, _value in _all_box.items():
+    if not (inspect.isclass(_value) and issubclass(_value, boxes.Boxes)):
+        _not_a_class.append(_key)
+    if _key.rsplit(".", 1)[-1] != getattr(_value, "__name__", None):
+        _name_suffix_mismatch.append(_key)
+    if not re.match(r"^boxes\.generators(\.[A-Za-z_][A-Za-z0-9_]*)+\.\w+$", _key):
+        _key_pattern_mismatch.append(_key)
+print(json.dumps({
+    "count": len(_all_box),
+    "not_a_class": sorted(_not_a_class),
+    "name_suffix_mismatch": sorted(_name_suffix_mismatch),
+    "key_pattern_mismatch": sorted(_key_pattern_mismatch),
+    "sample_present": "boxes.generators.abox.ABox" in _all_box,
+}))
+'''
+    )
+    assert payload["count"] == MANIFEST["generator_count"]
+    assert payload["not_a_class"] == []
+    assert payload["name_suffix_mismatch"] == []
+    assert payload["key_pattern_mismatch"] == []
+    assert payload["sample_present"] is True
+
