+from __future__ import annotations
+
+import inspect
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+import pytest
+
+import boxes.generators as g
+import boxes.scripts.boxes_generator as bg
+
+
+def test_single_scan_view_consistency_and_signatures() -> None:
+    code = r"""
+import inspect, pkgutil, re, sys
+import boxes.generators as g
+
+walks = 0
+orig_walk = pkgutil.walk_packages
+def counted_walk(*a, **kw):
+    global walks
+    walks += 1
+    return orig_walk(*a, **kw)
+pkgutil.walk_packages = counted_walk
+
+all_boxes = g.getAllBoxGenerators()
+all_mods = g.getAllGeneratorModules()
+web_boxes = g.getWebGenerators()
+buckets = g.getGeneratorsByUIGroup()
+groups = g.getGeneratorGroups()
+
+assert walks == 1, f"Expected 1 walk, got {walks}"
+assert len(all_boxes) == 195, f"Expected 195, got {len(all_boxes)}"
+assert len(all_mods) == 188, f"Expected 188, got {len(all_mods)}"
+assert len(web_boxes) == 182, f"Expected 182, got {len(web_boxes)}"
+assert len(buckets) == 10, f"Expected 10 buckets, got {len(buckets)}"
+assert sum(len(b) for b in buckets.values()) == 195
+assert len(groups) == 9
+
+assert not inspect.signature(g.getAllBoxGenerators).parameters
+assert not inspect.signature(g.getAllGeneratorModules).parameters
+
+for k, cls in all_boxes.items():
+    assert re.match(r"^boxes\.generators\.[^.]+\.[^.]+$", k)
+for name, cls in web_boxes.items():
+    assert cls.webinterface
+
+copy_check = g.getAllBoxGenerators()
+copy_check.clear()
+assert len(g.getAllBoxGenerators()) == 195
+
+bucket_copy = g.getGeneratorsByUIGroup()
+bucket_copy["Box"].clear()
+assert len(g.getGeneratorsByUIGroup()["Box"]) > 0
+"""
+    res = subprocess.run([sys.executable, "-B", "-c", code], capture_output=True, text=True)
+    assert res.returncode == 0, res.stderr
+
+
+def test_boxes_generator_path_accumulation_and_reachability() -> None:
+    code = """
+import os, tempfile, sys
+import boxes.generators as g
+
+assert len(g.__path__) == 1
+builtins = set(g.getAllBoxGenerators().keys())
+assert len(builtins) == 195
+
+with tempfile.TemporaryDirectory() as da, tempfile.TemporaryDirectory() as db:
+    with open(os.path.join(da, "exta.py"), "w") as f:
+        f.write("import boxes\\nclass ExtA(boxes.Boxes):\\n    pass\\n")
+    with open(os.path.join(db, "extb.py"), "w") as f:
+        f.write("import boxes\\nclass ExtB(boxes.Boxes):\\n    pass\\n")
+
+    os.environ["BOXES_GENERATOR_PATH"] = da
+    res1 = g.getAllBoxGenerators()
+    mods1 = g.getAllGeneratorModules()
+    assert len(res1) == 196
+    assert len(mods1) == 189
+    assert "boxes.generators.exta.ExtA" in res1
+    assert builtins.issubset(res1.keys())
+    assert len(g.__path__) == 1
+
+    os.environ["BOXES_GENERATOR_PATH"] = db
+    res2 = g.getAllBoxGenerators()
+    assert len(res2) == 197
+    assert "boxes.generators.exta.ExtA" in res2
+    assert "boxes.generators.extb.ExtB" in res2
+    assert len(g.__path__) == 1
+
+    del os.environ["BOXES_GENERATOR_PATH"]
+    res3 = g.getAllBoxGenerators()
+    assert len(res3) == 197
+    assert "boxes.generators.exta.ExtA" in res3
+    assert "boxes.generators.extb.ExtB" in res3
+    assert len(g.__path__) == 1
+"""
+    res = subprocess.run([sys.executable, "-B", "-c", code], capture_output=True, text=True)
+    assert res.returncode == 0, res.stderr
+
+
+def test_generators_snapshot_and_generate_smoke(tmp_path: Path) -> None:
+    assert bg.GENERATORS == g.getWebGenerators()
+    assert len(bg.GENERATORS) == 182
+    assert all(b.webinterface for b in bg.GENERATORS.values())
+
+    out = bg.generate({"Boxes": [{"box_type": "ABox"}]}, str(tmp_path / "out"))
+    assert len(out) == 1 and Path(out[0]).exists()
+
+    with pytest.raises(ValueError, match="box_type must be provided"):
+        bg.generate({"Boxes": [{}]}, str(tmp_path / "out"))
+    with pytest.raises(ValueError, match="invalid generator"):
+        bg.generate({"Boxes": [{"box_type": "NoSuchBox"}]}, str(tmp_path / "out"))
+
+
+def test_boxes_generator_import_zero_get_all_calls() -> None:
+    code = """
+import boxes.generators as g
+calls = 0
+orig = g.getAllBoxGenerators
+def counted():
+    global calls
+    calls += 1
+    return orig()
+g.getAllBoxGenerators = counted
+
+import boxes.scripts.boxes_generator as bg
+assert calls == 0, f"Expected 0 calls, got {calls}"
+"""
+    res = subprocess.run([sys.executable, "-B", "-c", code], capture_output=True, text=True)
+    assert res.returncode == 0, res.stderr
