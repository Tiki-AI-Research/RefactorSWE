+from __future__ import annotations
+
+import re
+
+import boxes.generators as g
+import boxes.scripts.boxesserver as bs
+
+
+class _DummyLang:
+    def gettext(self, s: str) -> str:
+        return s
+
+    def info(self) -> dict[str, str]:
+        return {}
+
+
+def test_boxesserver_isolation_and_rendering() -> None:
+    srv1 = bs.BServer()
+    srv2 = bs.BServer()
+
+    assert len(srv1.boxes) == 182
+    assert all(b.UI == "web" for b in srv1.boxes.values())
+
+    expected_groups = [
+        "Box",
+        "FlexBox",
+        "Tray",
+        "Shelf",
+        "WallMounted",
+        "Holes",
+        "Part",
+        "Misc",
+        "Unstable",
+    ]
+    assert [grp.name for grp in srv1.groups] == expected_groups
+    assert set(srv1.groups_by_name.keys()) == set(expected_groups)
+
+    members1 = [b for grp in srv1.groups for b in grp.generators]
+    members2 = [b for grp in srv2.groups for b in grp.generators]
+    assert len(members1) == 182
+    assert len(set(members1)) == 182
+    assert len(members2) == 182
+    assert len(set(members2)) == 182
+
+    assert srv1.groups is not srv2.groups
+    assert all(len(grp.generators) == 0 for grp in g.ui_groups)
+
+    lang = _DummyLang()
+
+    def start_response(status: str, headers: list[tuple[str, str]]) -> None:
+        pass
+
+    gallery_html = b"".join(srv1.serveGallery({}, start_response, lang)).decode("utf-8")
+    gallery_ids = re.findall(r'id="search_id_([^"]+)"', gallery_html)
+    assert len(gallery_ids) == 182
+    assert len(set(gallery_ids)) == 182
+    assert gallery_ids.count("HolePattern") == 1
+
+    menu_html = b"".join(srv1.genPageMenu(lang)).decode("utf-8")
+    menu_ids = re.findall(r'id="search_id_([^"]+)"', menu_html)
+    assert len(menu_ids) == 182
+    assert len(set(menu_ids)) == 182
+    assert menu_ids.count("HolePattern") == 1
