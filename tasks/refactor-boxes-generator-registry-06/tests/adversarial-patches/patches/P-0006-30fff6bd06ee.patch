+import boxes.generators as g
+import boxes.scripts.boxes_main as bm
+
+
+def test_generator_groups_idempotence_sorting_and_fallback() -> None:
+    g1 = bm.generator_groups()
+    g2 = bm.generator_groups()
+
+    assert [x.name for x in g1] == [x.name for x in g2]
+    assert g1 is not g2
+    assert g1[0].generators is not g2[0].generators
+
+    for i in range(len(g1)):
+        names1 = [b.__name__ for b in g1[i].generators]
+        names2 = [b.__name__ for b in g2[i].generators]
+        assert names1 == names2
+        assert names1 == sorted(names1)
+        assert len(set(names1)) == len(names1)
+
+    assert sum(len(x.generators) for x in g1) == 186
+    assert all(len(x.generators) == 0 for x in g.ui_groups)
+
+    misc_group = next(x for x in g1 if x.name == "Misc")
+    misc_names = {b.__name__ for b in misc_group.generators}
+    assert "BeeQueenCage" in misc_names
+    assert "BeeQueenTransportBox" in misc_names
+
+    for grp in g1:
+        if grp.name != "Misc":
+            names = {b.__name__ for b in grp.generators}
+            assert "BeeQueenCage" not in names
+            assert "BeeQueenTransportBox" not in names
+
+
+def test_list_stability_and_formatting() -> None:
+    buf1 = io.StringIO()
+    with contextlib.redirect_stdout(buf1):
+        bm.print_grouped_generators()
+    out1 = buf1.getvalue()
+
+    buf2 = io.StringIO()
+    with contextlib.redirect_stdout(buf2):
+        bm.print_grouped_generators()
+    out2 = buf2.getvalue()
+
+    assert out1 == out2
+    assert out1.startswith("Available generators:")
+    assert len(re.findall(r"^ \*  ", out1, re.MULTILINE)) == 186
+    assert len(re.findall(r"^ \*  HolePattern\b", out1, re.MULTILINE)) == 1
+
+
+def test_ui_group_definitions_match_baseline() -> None:
+    expected_order = [
+        "Box",
+        "FlexBox",
+        "Tray",
+        "Shelf",
+        "WallMounted",
+        "Holes",
+        "Part",
+        "Misc",
+        "Unstable",
+    ]
+    assert [x.name for x in g.ui_groups] == expected_order
+    assert g.ui_groups_by_name == {x.name: x for x in g.ui_groups}
+
+    expected_attrs = {
+        "Box": ("Boxes", "", "UniversalBox.jpg", "UniversalBox-thumb.jpg"),
+        "FlexBox": ("Boxes with flex", "", "RoundedBox.jpg", "RoundedBox-thumb.jpg"),
+        "Tray": ("Trays and Drawer Inserts", "", "TypeTray.jpg", "TypeTray-thumb.jpg"),
+        "Shelf": ("Shelves", "", "DisplayShelf.jpg", "DisplayShelf-thumb.jpg"),
+        "WallMounted": ("WallMounted", "", "WallTypeTray.jpg", "WallTypeTray-thumb.jpg"),
+        "Holes": ("Hole patterns", "", "", ""),
