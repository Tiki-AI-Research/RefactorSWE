+def parse_js(path):
+    source = Path(path).read_bytes()
+    parser = Parser(Language(tree_sitter_javascript.language()))
+    return source, parser.parse(source)
+
+
+def walk(node):
+    yield node
+    for child in node.named_children:
+        yield from walk(child)
+
+
+def node_text(source, node):
+    return source[node.start_byte:node.end_byte].decode('utf-8', 'replace')
+
+
+def named_child_text(source, node, field):
+    child = node.child_by_field_name(field)
+    return node_text(source, child) if child is not None else ''
+
+
+FUNCTION_TYPES = {'function_declaration', 'method_definition', 'function', 'arrow_function'}
+
+
+def function_units(source, tree):
+    units = {}
+    for node in walk(tree.root_node):
+        if node.type in {'function_declaration', 'method_definition'}:
+            name = named_child_text(source, node, 'name')
+            body = node.child_by_field_name('body')
+            if name and body is not None:
+                units.setdefault(name, []).append(node)
+        elif node.type == 'variable_declarator':
+            name = named_child_text(source, node, 'name')
+            value = node.child_by_field_name('value')
+            if value is not None and value.type in {'function', 'arrow_function'}:
+                units.setdefault(name, []).append(value)
+    return units
+
+
+def function_node(source, tree, name):
+    for node in walk(tree.root_node):
+        if node.type == 'function_declaration' and named_child_text(source, node, 'name') == name:
+            return node
+    raise AssertionError(f'missing public function: {name}')
+
+
+def dispatch_tables(source, tree):
+    """Map local object-dispatch tables to helper names, including table[key](...) calls."""
+    tables = {}
+    for item in walk(tree.root_node):
+        if item.type != 'variable_declarator':
+            continue
+        name = named_child_text(source, item, 'name')
+        value = item.child_by_field_name('value')
+        if not name or value is None or value.type != 'object':
+            continue
+        targets = set()
+        for pair in value.named_children:
+            if pair.type != 'pair':
+                continue
+            pair_value = pair.child_by_field_name('value')
+            pair_key = pair.child_by_field_name('key')
+            if pair_value is None:
+                continue
+            if pair_value.type == 'identifier':
+                targets.add(node_text(source, pair_value))
+            elif pair_value.type in {'function', 'arrow_function'}:
+                # Inline table entries keep their helpers reachable through the
+                # calls they make, instead of only recording the key spelling.
+                targets.update(call_targets(source, pair_value))
+        if targets:
+            tables[name] = targets
+    return tables
+
+
+def call_targets(source, node, tables=None):
+    targets = set()
+    tables = tables or {}
+    for item in walk(node):
+        if item.type != 'call_expression':
+            continue
+        callee = item.child_by_field_name('function')
+        if callee is None:
+            continue
+        if callee.type == 'identifier':
+            targets.add(node_text(source, callee))
+        elif callee.type == 'member_expression':
+            prop = callee.child_by_field_name('property')
+            if prop is not None:
+                targets.add(node_text(source, prop))
+        elif callee.type == 'subscript_expression':
+            owner = node_text(source, callee).split('[', 1)[0].strip()
+            targets.update(tables.get(owner, set()))
+    return targets
+
+
+def descendant_count(node, kind):
+    return sum(1 for item in walk(node) if item.type == kind)
+
+
+def is_state_object(node):
+    return node.type == 'object' and sum(1 for child in node.named_children if child.type == 'pair') >= 3
+
+
+def returned_state_factories():
+    """Accept factory-created state containers instead of requiring `new Class(...)` only."""
+    factories = set()
+    for relpath, source, tree in project_sources():
+        for name, nodes in function_units(source, tree).items():
+            for node in nodes:
+                body = node.child_by_field_name('body')
+                if body is None:
+                    continue
+                local_state_objects = set()
+                local_state_instances = set()
+                for item in walk(body):
+                    if item.type != 'variable_declarator':
+                        continue
+                    local_name = named_child_text(source, item, 'name')
+                    value = item.child_by_field_name('value')
+                    if local_name and value is not None and is_state_object(value):
+                        local_state_objects.add(local_name)
+                    if local_name and value is not None and value.type == 'new_expression':
+                        local_state_instances.add(local_name)
+                for item in walk(body):
+                    if item.type != 'return_statement':
+                        continue
+                    returned = item.named_children
+                    if any(is_state_object(child) for child in returned):
+                        factories.add(name)
+                    # A factory that returns a freshly constructed instance is accepted too.
+                    if any(child.type == 'new_expression' for child in returned):
+                        factories.add(name)
+                    if any(child.type == 'identifier' and node_text(source, child) in local_state_instances for child in returned):
+                        factories.add(name)
+                    if any(child.type == 'identifier' and node_text(source, child) in local_state_objects for child in returned):
+                        factories.add(name)
+    return factories
+
+
+def has_state_owner_creation(source, node, state_factories=None):
+    state_factories = state_factories or set()
+    for item in walk(node):
+        if item.type == 'new_expression':
+            return True
+        if is_state_object(item):
+            return True
+        if item.type == 'call_expression':
+            callee = item.child_by_field_name('function')
+            if callee is not None and callee.type == 'identifier' and node_text(source, callee) in state_factories:
+                return True
+    return False
+
