+}
+# Preserve the already declared compatibility exceptions; do not weaken assertions.
+UPSTREAM_EXCEPTIONS = {
+    'typed array with non-ArrayBuffer input': 'F2P-SAFETY-VIEW',
+    'ArrayBuffer with non-string value': 'F2P-SAFETY-BUFFER',
+    'prototype pollution': 'F2P-SAFETY-PROTO',
+    'prototype pollution via null-prototype object': 'F2P-SAFETY-NULL-PROTO',
+    'nested prototype pollution via null-prototype object': 'F2P-SAFETY-NESTED-PROTO',
+    'TypedArray self-reference': 'F2P-SAFETY-VIEW-SELF',
+    'mutual TypedArray reference': 'F2P-SAFETY-VIEW',
+}
+UPSTREAM_SELECTION_SHA256 = '27037e37b37fda79f8afeefe0e4a61f2a543b1847fb4fddfba7bd4d94ebe9ec1'
+UVU_ENGINE_SHA256 = 'dde0c5b1ef6ef2f49dc85de12882021b9b15a45e65452aff17e50d70a4fe17f8'
