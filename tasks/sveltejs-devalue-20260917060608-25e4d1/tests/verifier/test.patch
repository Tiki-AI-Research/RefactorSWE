+
+def upstream_id(nodeid):
+    """Stable ID binds source, suite, test name and duplicate-name occurrence."""
+    readable = re.sub(r'[^A-Za-z0-9]+', '_', nodeid).strip('_').lower()[:160]
+    return 'unit_js_' + readable + '_' + hashlib.sha256(nodeid.encode()).hexdigest()[:10]
+
+
+def upstream_nodeid(source, row):
+    return source + '::' + quote(row['suite'], safe='') + '::' + quote(row['name'], safe='') + '::' + str(row['occurrence'])
+
+
+def load_upstream_selection():
+    selection = Path(os.environ.get('UPSTREAM_SELECTION', '/tests/verifier/p2p_select.txt'))
+    data = selection.read_bytes()
+    if hashlib.sha256(data).hexdigest() != UPSTREAM_SELECTION_SHA256:
+        raise ValueError('P2P selection digest mismatch')
+    nodes = data.decode('utf-8').splitlines()
+    if len(nodes) != 798 or len(set(nodes)) != 798:
+        raise ValueError('P2P selection must have 798 distinct nodes')
+    if any(n.split('::')[0] not in UPSTREAM_FILES or len(n.split('::')) != 4 for n in nodes):
+        raise ValueError('Invalid P2P selection node')
+    return nodes
+
+
+def instrument_uvu(source):
+    """Add result recording to the pinned native runner; keep native assertions/hooks."""
+    records = """
+import fs from 'node:fs';
+const __rows = [];
+const __stringify = JSON.stringify.bind(JSON);
+const __write = fs.writeFileSync.bind(fs);
+const __report = process.env.UVU_RECORDS;
+const __counts = new Map();
+const into = (ctx, key) => (name, handler) => {
+    const suite = String(ctx.state.__suite__ || '');
+    const label = String(name);
+    const keyName = __stringify([suite, label]);
+    const occurrence = __counts.get(keyName) || 0;
+    __counts.set(keyName, occurrence + 1);
+    const record = {suite, name: label, occurrence, status: 'not_run', duration_ms: 0};
+    __rows.push(record);
+    ctx[key].push({name, handler, __record: record});
+};
+"""
+    changes = [
+        ('const into = (ctx, key) => (name, handler) => ctx[key].push({ name, handler });', records),
+        ('state.__test__ = test.name;', 'state.__test__ = test.name;\n            const __start = Date.now();'),
+        ('write(PASS);', "test.__record.status = 'passed';\n                test.__record.duration_ms = Date.now() - __start;\n                write(PASS);"),
+        ('} catch (err) {', """} catch (err) {
+                test.__record.status = 'failed';
+                test.__record.duration_ms = Date.now() - __start;
+                test.__record.message = String(err && (err.stack || err.message || err));"""),
+        ('if (isNode) process.exitCode = code;', """__write(__report, __stringify({
+        schema_version: 'uvu-node-results/v1', complete: true,
+        total, passed: done, skipped: skips, tests: __rows
+    }));
+    if (isNode) process.exitCode = code;"""),
+    ]
+    for old, new in changes:
+        if source.count(old) != 1:
+            raise ValueError('Pinned uvu instrumentation anchor changed: ' + old)
+        source = source.replace(old, new, 1)
+    return source
+
+
+def _frozen(relative, expected_hash):
+    result = subprocess.run(['git', 'show', f'{UPSTREAM_BASE}:{relative}'],
+                            cwd=ROOT, capture_output=True, timeout=20)
+    if result.returncode or hashlib.sha256(result.stdout).hexdigest() != expected_hash:
+        raise RuntimeError('Frozen upstream source unavailable/mismatched: ' + relative)
+    return result.stdout
+
+
+def run_upstream_file(relative, expected_nodes=None):
+    """Execute one frozen source ONCE and return individual uvu results."""
+    logs = Path(os.environ['UPSTREAM_REPORT_DIR'])
+    logs.mkdir(parents=True, exist_ok=True)
+    label = relative.replace('/', '__')
+    audit = {'source': relative, 'base_commit': UPSTREAM_BASE, 'tests': [],
+             'excluded_legacy_assertions': UPSTREAM_EXCEPTIONS if relative == 'test/index.test.js' else {}}
+    try:
+        original_hash, expected_total = UPSTREAM_FILES[relative]
+        original = _frozen(relative, original_hash)
+        selected = original.decode('utf-8')
+        if relative == 'test/index.test.js':
+            marker = 'for (const { name, json, message, revivers } of invalid) {'
+            if selected.count(marker) != 1 or not all(
+                selected.count("name: '" + name + "'") == 1 for name in UPSTREAM_EXCEPTIONS
+            ):
+                raise ValueError('Upstream exception-selection anchor changed')
+            selected = selected.replace(marker, marker + '\n\tif (' + json.dumps(list(UPSTREAM_EXCEPTIONS)) + '.includes(name)) continue;')
+        audit.update(source_sha256=original_hash, selected_sha256=hashlib.sha256(selected.encode()).hexdigest())
+        with tempfile.TemporaryDirectory(prefix='devalue-upstream-nodes-') as temporary:
+            workspace = Path(temporary)
+            runtime_hashes = {}
+            # Candidate tests/scripts are never used as evaluation sources.
+            for source in [ROOT/'index.js', *(ROOT/'src').rglob('*')]:
+                if source.is_symlink():
+                    raise ValueError('Symlink in candidate runtime: ' + str(source))
+                if not source.is_file() or source.name.endswith('.test.js'):
+                    continue
+                name = source.relative_to(ROOT)
+                target = workspace/name
+                target.parent.mkdir(parents=True, exist_ok=True)
+                data = source.read_bytes()
+                target.write_bytes(data)
+                runtime_hashes[str(name)] = hashlib.sha256(data).hexdigest()
+            audit['runtime_files'] = runtime_hashes
+            (workspace/'package.json').write_bytes(_frozen(
+                'package.json', '32cde197ba35df8206712c972e3e0cfb225465d1a21d757c5d130aa4aa7e1204'))
+            if not (ROOT/'node_modules').is_dir():
+                raise RuntimeError('Preinstalled upstream dependencies missing')
+            (workspace/'node_modules').symlink_to(ROOT/'node_modules', target_is_directory=True)
+            env = dict(os.environ, FORCE_COLOR='0', NO_COLOR='1')
+            env.pop('NODE_OPTIONS', None)
+            probe = subprocess.run(['node', '-e', """
+                const {createRequire} = require('module');
+                const uvu = require.resolve('uvu');
+                const r = createRequire(uvu);
+                console.log(JSON.stringify({uvu, kleur:r.resolve('kleur'), diff:r.resolve('uvu/diff')}));
+                """], cwd=workspace, env=env, capture_output=True, text=True, timeout=20)
+            if probe.returncode:
+                raise RuntimeError('Cannot resolve trusted uvu dependencies: ' + probe.stderr)
+            paths = json.loads(probe.stdout)
+            engine = Path(paths['uvu']).with_name('index.mjs').read_bytes()
+            if hashlib.sha256(engine).hexdigest() != UVU_ENGINE_SHA256:
+                raise ValueError('Upstream runner must be the pinned uvu 0.5.6 engine')
+            engine_source = instrument_uvu(engine.decode())
+            engine_source = engine_source.replace("from 'kleur'", 'from ' + json.dumps(Path(paths['kleur']).as_uri()))
+            engine_source = engine_source.replace("from 'uvu/diff'", 'from ' + json.dumps(Path(paths['diff']).as_uri()))
+            engine_path = workspace/'__trusted_uvu.mjs'
+            engine_path.write_text(engine_source)
+            # Only redirect the runner import; the upstream assertion bodies stay untouched.
+            engine_url = json.dumps(engine_path.as_uri())
+            if "from 'uvu'" not in selected:
+                raise ValueError('Missing upstream uvu import')
+            selected = selected.replace("from 'uvu'", 'from ' + engine_url)
+            target = workspace/relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_text(selected)
+            launcher = workspace/'__launch.mjs'
+            launcher.write_text("""
+                globalThis.UVU_DEFER = true;
+                globalThis.UVU_QUEUE = [[null]];
+                await import(process.argv[2]);
+                const engine = await import(process.argv[3]);
+                await engine.exec();
+            """)
+            record_path = workspace/'__records.json'
+            env['UVU_RECORDS'] = str(record_path)
+            argv = ['node', str(launcher), target.as_uri(), engine_path.as_uri()]
+            completed = subprocess.run(argv, cwd=workspace, env=env, capture_output=True, text=True, timeout=90)
+            (logs/(label+'.log')).write_text(completed.stdout+completed.stderr)
+            audit.update(command=argv, returncode=completed.returncode, log=label+'.log')
+            if not record_path.is_file():
+                raise RuntimeError('Runner did not finish/report every case')
+            payload = json.loads(record_path.read_text())
+            rows = payload.get('tests', [])
+            nodeids = [upstream_nodeid(relative, row) for row in rows]
+            # Missing, duplicated, skipped or unexpected cases are never accepted as passes.
+            if (payload.get('schema_version') != 'uvu-node-results/v1'
+                    or payload.get('complete') is not True or payload.get('total') != expected_total
+                    or payload.get('skipped') != 0 or len(rows) != expected_total
+                    or len(set(nodeids)) != expected_total):
+                raise ValueError('Invalid/partial/duplicate uvu result set')
+            if expected_nodes is not None and nodeids != expected_nodes:
+                raise ValueError('Observed upstream cases differ from frozen selection')
+            passed = sum(row.get('status') == 'passed' for row in rows)
+            if payload.get('passed') != passed or any(row.get('status') not in ('passed', 'failed') for row in rows):
+                raise ValueError('Uvu summary and per-case outcomes disagree')
+            if completed.returncode != (0 if passed == expected_total else 1):
+                raise ValueError('Uvu process status disagrees with per-case results')
+            for nodeid, row in zip(nodeids, rows):
+                row.update(nodeid=nodeid, id=upstream_id(nodeid), source=relative)
+            audit.update(tests=rows, passed=passed, total=len(rows),
+                         status='PASS' if passed == len(rows) else 'FAIL')
+    except (OSError, ValueError, RuntimeError, KeyError, TypeError, subprocess.SubprocessError) as exc:
+        audit.update(status='INFRA_ERROR', error=type(exc).__name__ + ': ' + str(exc))
+    (logs/(label+'.json')).write_text(json.dumps(audit, ensure_ascii=True, indent=2)+'\n')
+    return audit
+
+
+@pytest.fixture(scope='session')
+def upstream_batches():
+    # A cache keeps 798 pytest items to five uvu file executions, not 798 processes.
+    return {}
+
+
+@pytest.mark.parametrize('upstream_node', load_upstream_selection(), ids=upstream_id)
+def test_upstream_case(upstream_node, upstream_batches):
+    source = upstream_node.split('::')[0]
+    if source not in upstream_batches:
+        nodes = [n for n in load_upstream_selection() if n.split('::')[0] == source]
+        upstream_batches[source] = run_upstream_file(source, nodes)
+    batch = upstream_batches[source]
+    if batch['status'] == 'INFRA_ERROR':
+        pytest.fail('INFRA_ERROR: ' + batch.get('error', 'upstream batch unavailable'))
+    rows = [row for row in batch['tests'] if row['nodeid'] == upstream_node]
+    if len(rows) != 1:
+        pytest.fail('INFRA_ERROR: missing/duplicated upstream node: ' + upstream_node)
+    row = rows[0]
+    assert row['status'] == 'passed', row.get('message', 'Upstream test failed: ' + upstream_node)
