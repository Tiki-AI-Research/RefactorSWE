+    'src/utils.test.js': ('be0d7a44c1dff10278761dc83e8616dd4de35393168208dd0da5e723831e862a', 9),
+    'test/index.test.js': ('dd59ae93eed1f80e7aa1fd36ccaf2fe1eecf0f06d947fe8f557c4f6f886ebcba', 729),
