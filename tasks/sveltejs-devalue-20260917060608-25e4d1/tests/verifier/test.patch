+def source_import_targets(source, tree):
+    targets = set()
+    for node in walk(tree.root_node):
+        literal = None
+        if node.type in {'import_statement', 'export_statement'}:
+            literal = node.child_by_field_name('source')
+        elif node.type == 'call_expression':
+            callee = named_child_text(source, node, 'function')
+            arguments = node.child_by_field_name('arguments')
+            if callee in {'import', 'require'} and arguments is not None and arguments.named_children:
+                literal = arguments.named_children[0]
+        if literal is not None and literal.type == 'string':
+            targets.add(node_text(source, literal)[1:-1])
+    return targets
+
+
+def import_targets(path):
+    return source_import_targets(*parse_js(path))
+
+
+def assert_no_new_runtime_dependencies():
+    # An installed dev/test package does not authorize a production import.
+    # Compare the reachable production graph to Git, not to node_modules.
+    parser = Parser(Language(tree_sitter_javascript.language()))
+    current, original = set(), set()
+    for relpath, path in reachable_import_paths().items():
+        current.update(import_targets(path))
+        baseline = subprocess.run(['git', 'show', BASE_COMMIT + ':' + relpath],
+                                  cwd=ROOT, capture_output=True, timeout=20)
+        if baseline.returncode == 0:
+            original.update(source_import_targets(baseline.stdout, parser.parse(baseline.stdout)))
+    builtin_result = subprocess.run(['node', '--input-type=module', '-e',
+                                    "import {builtinModules} from 'node:module'; console.log(JSON.stringify(builtinModules));"],
+                                   cwd=ROOT, capture_output=True, text=True, check=True, timeout=20)
+    builtins = set(json.loads(builtin_result.stdout))
+    additions = {spec for spec in current - original
+                 if not spec.startswith('.') and spec.removeprefix('node:') not in builtins}
+    assert not additions, 'New production runtime dependencies: ' + ', '.join(sorted(additions))
+
+
+def reachable_import_paths():
+    root = ROOT / 'src/parse.js'
+    seen = {}
+    pending = [root]
+    while pending:
+        path = pending.pop()
+        try:
+            resolved = path.resolve().relative_to(ROOT.resolve()).as_posix()
+        except ValueError:
+            continue
+        if resolved in seen or not path.exists():
+            continue
+        seen[resolved] = path
+        for spec in import_targets(path):
+            if not spec.startswith('.'):
+                continue
+            candidate = (path.parent / spec)
+            if candidate.suffix != '.js':
+                candidate = candidate.with_suffix('.js')
+            pending.append(candidate)
+    return seen
+
+
+def reachable_import_files():
+    return set(reachable_import_paths())
+
+
+def project_sources():
+    files = reachable_import_paths()
+    parsed = []
+    for relpath in sorted(files):
+        source, tree = parse_js(files[relpath])
+        parsed.append((relpath, source, tree))
+    return parsed
+
+
+def project_function_units():
+    units = {}
+    for relpath, source, tree in project_sources():
+        for name, nodes in function_units(source, tree).items():
+            units.setdefault(name, []).extend((source, node, relpath) for node in nodes)
+    return units
+
+
+def project_dispatch_tables():
+    tables = {}
+    for relpath, source, tree in project_sources():
+        tables[relpath] = dispatch_tables(source, tree)
+    return tables
+
+
+def project_reachable_units(roots=('unflatten',)):
+    units = project_function_units()
+    tables = project_dispatch_tables()
+    returned = returned_callable_targets(units)
+    seen = set()
+    pending = list(roots)
+    while pending:
+        name = pending.pop()
+        if name in seen:
+            continue
+        seen.add(name)
+        for source, node, relpath in units.get(name, []):
+            for target in call_targets(source, node, tables.get(relpath)) | invoked_returned_targets(source, node, returned):
+                if target in units and target not in seen:
+                    pending.append(target)
+    return seen, units
+
+
+def real_reachable_helpers(reachable, units):
+    helpers = reachable - {'parse', 'unflatten', 'constructor'}
+    real_helpers = []
+    for name in helpers:
+        for source, node, relpath in units.get(name, []):
+            body = node.child_by_field_name('body')
+            if body is not None and descendant_count(body, 'statement_block') + descendant_count(body, 'switch_statement') + len(body.named_children) >= 2:
+                real_helpers.append((name, relpath))
+                break
+    return real_helpers
+
+
+def direct_walk(node):
+    """Visit one routine's executable body without attributing nested routines to it."""
+    yield node
+    for child in node.named_children:
+        if child.type not in FUNCTION_TYPES:
+            yield from direct_walk(child)
+
+
+def hydration_state_layout():
+    """Follow public inputs through calls, constructors, factories and field aliases.
+
+    Roles come from input positions and actual allocation/use, not private names.
+    Shapes identify one owner; independent objects cannot pool their fields.
+    """
+    records = {}
+    names = {}
+    classes = {}
+    for path, source, tree in project_sources():
+        for name, nodes in function_units(source, tree).items():
+            for node in nodes:
+                key = (path, node.start_byte)
+                records[key] = (source, node)
+                names.setdefault(name, set()).add(key)
+                if name == 'constructor' and node.parent is not None:
+                    cls = node.parent.parent
+                    if cls is not None and cls.type in {'class_declaration', 'class'}:
+                        classes[named_child_text(source, cls, 'name')] = key
+
+    # Each abstract value is (input/allocation roles, owner shapes).
+    def union(*values):
+        return (set().union(*(v[0] for v in values)),
+                set().union(*(v[1] for v in values))) if values else (set(), set())
+
+    empty = (set(), set())
+    params, receivers, returns, return_fields, fields = {}, {}, {}, {}, {}
+    active = set(names.get('unflatten', ()))
+    custom_hosts = set()
+    reads = set()
+    indexed_reads, indexed_writes, membership, removals = set(), set(), set(), set()
+
+    def storage_roles(shapes):
+        roles = set()
+        if shapes & indexed_reads & indexed_writes & membership:
+            roles.add('cache')
+        if shapes & indexed_writes & membership & removals:
+            roles.add('tracker')
+        return roles
+    for key in active:
+        params[key] = [{'payload'}, {'revivers'}, {'options'}]
+
+    def merge(mapping, key, value):
+        old = mapping.get(key, empty)
+        mapping[key] = union(old, value)
+        return old != mapping[key]
+
+    def parameters(source, node):
+        p = node.child_by_field_name('parameters')
+        return [node_text(source, c) for c in p.named_children] if p is not None else []
+
+    while True:
+        changed = False
+        for key in list(active):
+            source, node = records[key]
+            env = {n: (set(r), set()) for n, r in zip(parameters(source, node), params.get(key, []))}
+            # Parameter shapes are kept separately from role propagation.
+            for index, name in enumerate(parameters(source, node)):
+                env[name] = union(env.get(name, empty), receivers.get((key, index), empty))
+            env['this'] = receivers.get((key, 'this'), empty)
+
+            def property_value(value, prop):
+                reads.update((shape, prop) for shape in value[1])
+                result = union(*(fields.get((shape, prop), empty) for shape in value[1]))
+                result = union(result, (storage_roles(result[1]), set()))
+                if prop == 'operations' and 'options' in value[0]:
+                    result = union(result, ({'operations'}, set()))
+                return result
+
+            def value(expr):
+                nonlocal changed
+                if expr is None:
+                    return empty
+                text = node_text(source, expr)
+                if expr.type in {'identifier', 'this'}:
+                    return env.get(text, empty)
+                if expr.type in FUNCTION_TYPES:
+                    return empty
+                if expr.type == 'object':
+                    shape = ('object', key, expr.start_byte)
+                    for pair in expr.named_children:
+                        if pair.type == 'pair':
+                            prop = named_child_text(source, pair, 'key').strip('\"\'')
+                            changed |= merge(fields, (shape, prop), value(pair.child_by_field_name('value')))
+                        elif pair.type == 'shorthand_property_identifier':
+                            prop = node_text(source, pair)
+                            changed |= merge(fields, (shape, prop), env.get(prop, empty))
+                    return (set(), {shape})
+                if expr.type == 'array':
+                    return ({'cache'}, {('array', key, expr.start_byte)})
+                if expr.type in {'member_expression', 'subscript_expression'}:
+                    obj = expr.child_by_field_name('object')
+                    prop = expr.child_by_field_name('property') or expr.child_by_field_name('index')
+                    name = node_text(source, prop).strip('\"\'') if prop is not None else ''
+                    base = value(obj)
+                    result = property_value(base, name)
+                    if obj is not None and obj.type == 'identifier':
+                        result = union(result, env.get(node_text(source, obj) + '.' + name, empty))
+                    # Indexing a reviver table preserves the callback origin.
+                    if expr.type == 'subscript_expression':
+                        indexed_reads.update(base[1])
+                        result = union(result, (base[0], set()))
+                    return result
+                if expr.type in {'call_expression', 'new_expression'}:
+                    callee = expr.child_by_field_name('function') or expr.child_by_field_name('constructor')
+                    name = node_text(source, callee) if callee is not None else ''
+                    args = expr.child_by_field_name('arguments')
+                    actual = [value(a) for a in args.named_children] if args is not None else []
+                    if name in {'Object.hasOwn', 'Object.prototype.hasOwnProperty.call'} and actual:
+                        membership.update(actual[0][1])
+                    if name == 'Object.create':
+                        return (set(), {('allocation', key, expr.start_byte)})
+                    if name == 'Object.assign' and actual:
+                        for destination in actual[0][1]:
+                            for addition in actual[1:]:
+                                for (shape, prop), field in list(fields.items()):
+                                    if shape in addition[1]:
+                                        changed |= merge(fields, (destination, prop), field)
+                        return actual[0]
+                    if 'revivers' in value(callee)[0]:
+                        custom_hosts.add(key)
+                    targets = set(names.get(name, ()))
+                    owner = empty
+                    if expr.type == 'new_expression' and name in classes:
+                        targets = {classes[name]}
+                        owner = (set(), {('class', classes[name])})
+                    elif callee is not None and callee.type == 'member_expression':
+                        member = named_child_text(source, callee, 'property')
+                        owner = value(callee.child_by_field_name('object'))
+                        targets = set(names.get(member, ())) if owner[1] else set()
+                        if member in {'has', 'hasOwnProperty', 'includes', 'indexOf'}:
+                            membership.update(owner[1])
+                        if member in {'set', 'push'}:
+                            indexed_writes.update(owner[1])
+                        if member in {'delete', 'pop', 'splice'}:
+                            removals.update(owner[1])
+                    for target in targets:
+                        if target not in active:
+                            active.add(target); changed = True
+                        slots = params.setdefault(target, [])
+                        for i, arg in enumerate(actual):
+                            while len(slots) <= i:
+                                slots.append(set())
+                            if not arg[0].issubset(slots[i]):
+                                slots[i].update(arg[0]); changed = True
+                            changed |= merge(receivers, (target, i), (set(), arg[1]))
+                        changed |= merge(receivers, (target, 'this'), owner)
+                    if expr.type == 'new_expression' and name in classes:
+                        return owner
+                    result = union(*(returns.get(t, empty) for t in targets))
+                    # Preserve named properties returned by validation/option helpers.
+                    for target in targets:
+                        for prop, field in return_fields.get(target, {}).items():
+                            synthetic = ('return', target)
+                            changed |= merge(fields, (synthetic, prop), field)
+                            result = union(result, (set(), {synthetic}))
+                    if name in {'Array', 'Map'}:
+                        result = union(result, ({'cache'}, set()))
+                    if name == 'Set' and expr.type == 'new_expression':
+                        result = union(result, ({'tracker'}, set()))
+                    # Objects assembled through indexed writes carry the
+                    # corresponding public input role, even with renamed keys.
+                    result = union(result, (set().union(*(r for (shape, _), (r, _) in fields.items() if shape in result[1])), set()))
+                    return result
+                return union(*(value(c) for c in expr.named_children))
+
+            def bind(left, result):
+                nonlocal changed
+                if left is None:
+                    return
+                if left.type == 'identifier':
+                    env[node_text(source, left)] = union(env.get(node_text(source, left), empty), result)
+                elif left.type in {'member_expression', 'subscript_expression'}:
+                    prop = left.child_by_field_name('property') or left.child_by_field_name('index')
+                    prop = node_text(source, prop).strip('\"\'') if prop is not None else ''
+                    shapes = value(left.child_by_field_name('object'))[1]
+                    if left.type == 'subscript_expression':
+                        indexed_writes.update(shapes)
+                    for shape in shapes:
+                        changed |= merge(fields, (shape, prop), result)
+                elif left.type == 'object_pattern':
+                    for part in left.named_children:
+                        prop = named_child_text(source, part, 'key') if part.type == 'pair_pattern' else node_text(source, part)
+                        local = part.child_by_field_name('value') if part.type == 'pair_pattern' else part
+                        env[node_text(source, local)] = property_value(result, prop)
+
+            body = node.child_by_field_name('body')
+            if body is None:
+                continue
+            for item in direct_walk(body):
+                if item.type == 'variable_declarator':
+                    bind(item.child_by_field_name('name'), value(item.child_by_field_name('value')))
+                elif item.type in {'assignment_expression', 'augmented_assignment_expression'}:
+                    bind(item.child_by_field_name('left'), value(item.child_by_field_name('right')))
+                elif item.type in {'call_expression', 'new_expression'}:
+                    value(item)
+                elif item.type == 'unary_expression' and node_text(source, item).lstrip().startswith('delete '):
+                    target = item.named_children[-1]
+                    if target.type == 'subscript_expression':
+                        removals.update(value(target.child_by_field_name('object'))[1])
+                elif item.type == 'return_statement':
+                    for child in item.named_children:
+                        result = value(child)
+                        changed |= merge(returns, key, result)
+                        if child.type == 'object':
+                            props = return_fields.setdefault(key, {})
+                            for pair in child.named_children:
+                                if pair.type == 'pair':
+                                    prop = named_child_text(source, pair, 'key').strip('\"\'')
+                                    changed |= merge(props, prop, value(pair.child_by_field_name('value')))
+            if node.child_by_field_name('body').type != 'statement_block':
+                changed |= merge(returns, key, value(body))
+        if not changed:
+            break
+    owners = {}
+    for (shape, prop), (roles, allocated) in fields.items():
+        if (shape, prop) in reads:
+            owners.setdefault(shape, {})[prop] = roles | storage_roles(allocated)
+    return owners, custom_hosts
+
+
+def assert_complete_state_owner():
+    owners, _ = hydration_state_layout()
+    required = {'payload', 'revivers', 'operations', 'cache', 'tracker'}
+    assert any(required.issubset(set().union(*props.values())) for props in owners.values()), (
+        'No single per-call owner holds payload, revivers, operations, cache and cycle tracker')
+
+
+def returned_callable_targets(units):
+    """Functions returned as values are reachable only when that value is called."""
+    returned = {}
+    for name, entries in units.items():
+        for source, node, path in entries:
+            body = node.child_by_field_name('body')
+            if body is None:
+                continue
+            for item in direct_walk(body):
+                if item.type == 'return_statement':
+                    # Ignore identifiers inside calls: returning f(x) does not
+                    # imply that x, or f itself, is the returned callable.
+                    pending = list(item.named_children)
+                    while pending:
+                        expr = pending.pop()
+                        if expr.type == 'identifier':
+                            target = node_text(source, expr)
+                            if target in units:
+                                returned.setdefault(name, set()).add(target)
+                        elif expr.type in {'ternary_expression', 'parenthesized_expression'}:
+                            pending.extend(expr.named_children)
+    return returned
+
+
+def invoked_returned_targets(source, node, returned):
+    aliases = {}
+    result = set()
+
+    def factory_targets(expr):
+        if expr is None or expr.type != 'call_expression':
+            return set()
+        callee = expr.child_by_field_name('function')
+        if callee is None:
+            return set()
+        name = named_child_text(source, callee, 'property') if callee.type == 'member_expression' else node_text(source, callee)
+        return returned.get(name, set())
+
+    for item in direct_walk(node.child_by_field_name('body') or node):
+        if item.type == 'variable_declarator':
+            name = item.child_by_field_name('name')
+            if name is not None and name.type == 'identifier':
+                aliases[node_text(source, name)] = factory_targets(item.child_by_field_name('value'))
+        if item.type == 'call_expression':
+            callee = item.child_by_field_name('function')
+            if callee is not None:
+                result.update(factory_targets(callee))
+                if callee.type == 'identifier':
+                    result.update(aliases.get(node_text(source, callee), set()))
+    return result
+
+
+def population_responsibilities(reachable, units, operations):
+    """Track created containers into dedicated population routines.
+
+    Creation/cache placement is independent of population responsibility.
+    Roles follow arguments and simple returned parameters, not private names.
+    A generic population routine receiving several roles is not a separated seam.
+    """
+    parameters, return_parameters = {}, {}
+    for name, entries in units.items():
+        for source, node, path in entries:
+            params = node.child_by_field_name('parameters')
+            names = [node_text(source, p) for p in params.named_children] if params else []
+            parameters.setdefault(name, names)
+            body = node.child_by_field_name('body')
+            if body is not None:
+                for item in direct_walk(body):
+                    if item.type == 'return_statement' and len(item.named_children) == 1:
+                        expr = item.named_children[0]
+                        if expr.type == 'identifier' and node_text(source, expr) in names:
+                            return_parameters.setdefault(name, set()).add(names.index(node_text(source, expr)))
+    inputs = {name: [set() for _ in params] for name, params in parameters.items()}
+    populations = {}
+    creation_roles = {method: group for group, methods in operations.items() for method in methods}
+    for _ in range(1 + sum(map(len, parameters.values())) * max(1, len(operations))):
+        changed = False
+        for name in reachable:
+            for source, node, path in units.get(name, []):
+                body = node.child_by_field_name('body')
+                if body is None:
+                    continue
+                env = {p: set(roles) for p, roles in zip(parameters[name], inputs[name])}
+
+                def value(expr):
+                    if expr is None:
+                        return set()
+                    if expr.type == 'identifier':
+                        return env.get(node_text(source, expr), set())
+                    if expr.type in {'parenthesized_expression', 'assignment_expression'}:
+                        children = expr.named_children[-1:]
+                        return value(children[0]) if children else set()
+                    if expr.type == 'call_expression':
+                        callee = expr.child_by_field_name('function')
+                        if callee is None:
+                            return set()
+                        called = named_child_text(source, callee, 'property') if callee.type == 'member_expression' else node_text(source, callee)
+                        if called in creation_roles:
+                            return {creation_roles[called]}
+                        args = expr.child_by_field_name('arguments')
+                        args = args.named_children if args else []
+                        roles = set()
+                        for pos in return_parameters.get(called, set()):
+                            if pos < len(args):
+                                roles.update(value(args[pos]))
+                        return roles
+                    return set()
+
+                for item in direct_walk(body):
+                    if item.type == 'variable_declarator':
+                        local = item.child_by_field_name('name')
+                        if local is not None and local.type == 'identifier':
+                            env.setdefault(node_text(source, local), set()).update(value(item.child_by_field_name('value')))
+                    if item.type != 'call_expression':
+                        continue
+                    callee = item.child_by_field_name('function')
+                    if callee is None:
+                        continue
+                    called = named_child_text(source, callee, 'property') if callee.type == 'member_expression' else node_text(source, callee)
+                    args = item.child_by_field_name('arguments')
+                    args = args.named_children if args else []
+                    if called in {'set', 'addValue', 'addEntry'} and args:
+                        populations.setdefault((path, node.start_byte), set()).update(value(args[0]))
+                    if called in inputs:
+                        for pos, arg in enumerate(args[:len(inputs[called])]):
+                            roles = value(arg)
+                            if not roles.issubset(inputs[called][pos]):
+                                inputs[called][pos].update(roles)
+                                changed = True
+        if not changed:
+            break
+    return populations
+
+
+def assert_separate_hydration_responsibilities():
+    reachable, units = project_reachable_units()
+    _, custom_hosts = hydration_state_layout()
+    operations = {
+        'builtins': {'fromISOString', 'fromRegExpInfo', 'box', 'fromViewInfo', 'fromArrayBuffer', 'fromStringValue'},
+        'sparse': {'createSparseArray'},
+        'regular': {'createArray', 'createObject'},
+        'set_map': {'createSet', 'createMap'},
+        'null_prototype': {'createNullPrototypeObject'},
+    }
+    populations = population_responsibilities(reachable, units, operations)
+    separated = set()
+    for name in reachable:
+        for source, node, path in units.get(name, []):
+            body = node.child_by_field_name('body')
+            if body is None:
+                continue
+            calls = set()
+            aliases = {}
+            for item in direct_walk(body):
+                if item.type == 'variable_declarator':
+                    local = item.child_by_field_name('name')
+                    expr = item.child_by_field_name('value')
+                    if local is not None and local.type == 'identifier' and expr is not None and expr.type == 'member_expression':
+                        aliases[node_text(source, local)] = named_child_text(source, expr, 'property')
+                    elif local is not None and local.type == 'object_pattern':
+                        for part in local.named_children:
+                            prop = named_child_text(source, part, 'key') if part.type == 'pair_pattern' else node_text(source, part)
+                            target = named_child_text(source, part, 'value') if part.type == 'pair_pattern' else prop
+                            aliases[target] = prop
+                if item.type == 'call_expression':
+                    callee = item.child_by_field_name('function')
+                    if callee is not None:
+                        called = named_child_text(source, callee, 'property') if callee.type == 'member_expression' else node_text(source, callee)
+                        calls.add(aliases.get(called, called))
+            groups = {group for group, methods in operations.items() if calls & methods}
+            groups.update(populations.get((path, node.start_byte), set()))
+            if (path, node.start_byte) in custom_hosts:
+                groups.add('custom_reviver')
+            # Utilities or one dispatcher doing several groups cannot stand in
+            # for a routine dedicated to each required responsibility.
+            if len(groups) == 1:
+                separated.update(groups)
+    required = set(operations) | {'custom_reviver'}
+    assert required.issubset(separated), 'Unseparated hydration responsibilities: ' + ', '.join(sorted(required - separated))
+
