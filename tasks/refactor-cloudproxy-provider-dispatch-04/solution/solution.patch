+def test_provider_type_level_default_derivation():
+    """Test provider type-level region and ami default derivation matrix"""
+    # 1. DigitalOcean derives region from default instance when missing at top level
+    do_inst = {
+        "enabled": True,
+        "ips": [],
+        "scaling": {"min_scaling": 0, "max_scaling": 0},
+        "region": "nyc1",
+    }
+    do_p = DigitalOceanProvider(instances={"default": do_inst})
+    assert do_p.region == "nyc1"
+
+    # 2. AWS derives region and ami from default instance; spot defaults to False
+    aws_inst = {
+        "enabled": True,
+        "ips": [],
+        "scaling": {"min_scaling": 0, "max_scaling": 0},
+        "region": "us-east-1",
+        "ami": "ami-12345",
+        "spot": True,
+    }
+    aws_p = AWSProvider(instances={"default": aws_inst})
+    assert aws_p.region == "us-east-1"
+    assert aws_p.ami == "ami-12345"
+    assert aws_p.spot is False
+
+    # 3. Top-level region/ami takes precedence over default instance
+    do_top = DigitalOceanProvider(region="sfo3", instances={"default": do_inst})
+    assert do_top.region == "sfo3"
+    aws_top = AWSProvider(region="us-west-2", ami="ami-custom", instances={"default": aws_inst})
+    assert aws_top.region == "us-west-2"
+    assert aws_top.ami == "ami-custom"
+
+    # 4. With no default instance, required fields remain required
+    with pytest.raises(ValidationError):
+        DigitalOceanProvider(instances={"prod": do_inst})
+    aws_no_def = AWSProvider(instances={"prod": aws_inst})
+    assert aws_no_def.region == ""
+    assert aws_no_def.ami == ""
+
+    # 5. Missing region/ami key in default instance yields empty string
+    bare_inst = {"enabled": True, "ips": [], "scaling": {"min_scaling": 0, "max_scaling": 0}}
+    do_bare = DigitalOceanProvider(instances={"default": bare_inst})
+    assert do_bare.region == ""
+    aws_bare = AWSProvider(instances={"default": bare_inst})
+    assert aws_bare.region == ""
+    assert aws_bare.ami == ""
+
+    # 6. Direct construction of DigitalOceanProvider with no instances raises ValidationError
+    with pytest.raises(ValidationError):
+        DigitalOceanProvider()
+
+    # 7. BaseProvider, GCPProvider, HetznerProvider do not derive defaults
+    base_p = BaseProvider(instances={"default": do_inst})
+    assert base_p.region == ""
+    gcp_p = GCPProvider(
+        zone="us-central1-a",
+        image_project="debian-cloud",
+        image_family="debian-10",
+        instances={"default": do_inst},
+    )
+    assert gcp_p.region == ""
+    hetzner_p = HetznerProvider(instances={"default": do_inst})
+    assert hetzner_p.region == ""
+
+
+def test_provider_model_factory_dispatch_and_extensibility():
+    """Test factory type dispatch, generic fallback, caller config immutability, and extensibility"""
+    import copy
+    from cloudproxy.main import get_provider_model, PROVIDER_MODEL_TYPES
+
+    inst = {
+        "enabled": True,
+        "ips": [],
+        "scaling": {"min_scaling": 0, "max_scaling": 0},
+        "region": "nyc1",
+        "ami": "ami-1",
+    }
+    cfg = {
+        "instances": {"default": inst},
+        "zone": "us-central1-a",
+        "image_project": "debian-cloud",
+        "image_family": "debian-10",
+    }
+
+    # Verify exact types for all 7 names
+    assert type(get_provider_model("digitalocean", cfg)) is DigitalOceanProvider
+    assert type(get_provider_model("aws", cfg)) is AWSProvider
+    assert type(get_provider_model("gcp", cfg)) is GCPProvider
+    assert type(get_provider_model("hetzner", cfg)) is HetznerProvider
+    assert type(get_provider_model("azure", cfg)) is BaseProvider
+    assert type(get_provider_model("vultr", cfg)) is BaseProvider
+    assert type(get_provider_model("unknown_provider", cfg)) is BaseProvider
+
+    # Verify caller config top-level deep equality before and after
+    cfg_copy = copy.deepcopy(cfg)
+    get_provider_model("aws", cfg)
+    assert cfg == cfg_copy
+    get_provider_model("digitalocean", cfg)
+    assert cfg == cfg_copy
+
+    # Verify extensibility via registration
+    class CustomProvider(BaseProvider):
+        custom_key: str = "default_custom"
+
+    PROVIDER_MODEL_TYPES["custom"] = CustomProvider
+    try:
+        custom_model = get_provider_model("custom", {"custom_key": "custom_value"})
+        assert type(custom_model) is CustomProvider
+        assert custom_model.custom_key == "custom_value"
+    finally:
+        PROVIDER_MODEL_TYPES.pop("custom", None) 
