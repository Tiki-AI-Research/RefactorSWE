+def _get_instance_field(default_inst: Any, key: str) -> Any:
+    if isinstance(default_inst, dict):
+        return default_inst.get(key, "")
+    elif hasattr(default_inst, "model_fields_set"):
+        if key in default_inst.model_fields_set:
+            return getattr(default_inst, key, None)
+        return ""
+    return ""
+
+def _derive_fields_from_default_instance(data: Any, fields: Tuple[str, ...]) -> Any:
+    if isinstance(data, dict) and "instances" in data and data["instances"] is not None:
+        data = dict(data)
+        instances = data["instances"]
+        default_inst = instances.get("default") if isinstance(instances, dict) else None
+        if default_inst is not None:
+            for key in fields:
+                if key not in data:
+                    data[key] = _get_instance_field(default_inst, key)
+    return data
