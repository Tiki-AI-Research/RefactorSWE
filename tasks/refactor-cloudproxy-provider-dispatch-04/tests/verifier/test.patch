+def test_p2p_provider_model_validation_expectations_are_unchanged():
+    """Model field requirements and bounds stay unchanged."""
+    with pytest.raises(ValidationError):
+        DigitalOceanProvider()
+
+    with pytest.raises(ValidationError):
+        get_provider_model("digitalocean", {"instances": {"prod": _instance_config()}})
+
+    with pytest.raises(ValidationError):
+        GCPProvider(zone="us-central1-a", image_project="debian-cloud")
+
+    with pytest.raises(ValidationError):
+        GCPProvider(zone="us-central1-a", image_family="debian-10")
+
+    with pytest.raises(ValidationError):
+        GCPProvider(image_project="debian-cloud", image_family="debian-10")
+
+    gcp_provider = GCPProvider(
+        zone="us-central1-a", image_project="debian-cloud", image_family="debian-10"
+    )
+    assert gcp_provider.zone == "us-central1-a"
+    assert gcp_provider.image_project == "debian-cloud"
+    assert gcp_provider.image_family == "debian-10"
+
+    with pytest.raises(ValidationError):
+        ProviderScaling(min_scaling=-1, max_scaling=1)
+
+    with pytest.raises(ValidationError):
+        ProviderScaling(min_scaling=0, max_scaling=-1)
+
+    assert AWSProvider().spot is False
+    assert AWSProvider(spot=True).spot is True
+    assert isinstance(HetznerProvider(location="nbg1"), BaseProvider)
+
+    # Type-owned normalization must not change the original public constructors.
+    with pytest.raises(ValidationError):
+        DigitalOceanProvider(instances={"default": _instance_config(region="from-default")})
+    direct = AWSProvider(instances={"default": _instance_config(region="from-default", ami="ami-default")})
+    assert direct.region == "" and direct.ami == ""
+    explicit = AWSProvider(region="explicit", instances={"default": _instance_config(region="from-default", ami="ami-default")})
+    assert explicit.region == "explicit" and explicit.ami == ""
+    _assert_subclass_declaration_does_not_replace_existing_provider()
+
+    # An absent/empty instances mapping is valid; an explicitly malformed
+    # container must not be silently treated as an empty mapping instead.
+    for provider_name in ("digitalocean", "aws", "gcp", "hetzner", "p2p-unmodeled"):
+        fields = {"region": "p2p-region", "zone": "p2p-zone",
+                  "image_project": "p2p-project", "image_family": "p2p-family"}
+        assert not get_provider_model(provider_name, dict(fields)).instances
+        assert not get_provider_model(provider_name, dict(fields, instances={})).instances
+        for invalid_instances in (None, []):
+            with pytest.raises((AttributeError, TypeError, ValidationError)):
+                get_provider_model(provider_name, dict(fields, instances=invalid_instances))
+
