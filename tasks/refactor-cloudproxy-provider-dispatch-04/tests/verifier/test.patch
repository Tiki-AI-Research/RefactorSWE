@@ -0,0 +1,423 @@
+"""Supplemental pass-to-pass regression tests for provider-model construction.
+
+These tests pin the frozen public behavior of the provider-model factory
+``get_provider_model`` and of the provider model types it returns:
+
+* provider-specific backfill of region/ami from the default instance entry,
+* generic fallback for unmodeled provider names,
+* scaling normalization for model instances and min/max mappings,
+* immutability of the caller-supplied configuration mapping,
+* unchanged model validation expectations,
+* provider listing/retrieval payloads with secrets excluded.
+* provider listing resolution through the public factory call path.
+"""
+import copy
+import json
+from collections.abc import Mapping
+
+import pytest
+from fastapi.testclient import TestClient
+from pydantic import ValidationError
+
+from cloudproxy.main import (
+    AWSProvider,
+    BaseProvider,
+    DigitalOceanProvider,
+    GCPProvider,
+    HetznerProvider,
+    ProviderScaling,
+    app,
+    get_provider_model,
+)
+from cloudproxy.providers import settings
+
+client = TestClient(app)
+
+
+class _ReadOnlyMapping(Mapping):
+    """Mapping protocol only; dict-specific mutation/copy methods are absent."""
+
+    def __init__(self, values):
+        self._values = values
+
+    def __getitem__(self, key):
+        return self._values[key]
+
+    def __iter__(self):
+        return iter(self._values)
+
+    def __len__(self):
+        return len(self._values)
+
+
+def _instance_config(**overrides):
+    config = {
+        "enabled": True,
+        "ips": [],
+        "scaling": {"min_scaling": 1, "max_scaling": 3},
+    }
+    config.update(overrides)
+    return config
+
+
+def test_p2p_factory_public_entrypoint_on_cloudproxy_main():
+    """get_provider_model stays at cloudproxy.main and is callable by keyword."""
+    from cloudproxy import main as main_module
+
+    factory = getattr(main_module, "get_provider_model", None)
+    assert callable(factory)
+
+    provider = main_module.get_provider_model(
+        provider_name="digitalocean",
+        provider_config={"instances": {"default": _instance_config(region="nyc1")}},
+    )
+    assert isinstance(provider, DigitalOceanProvider)
+
+
+def test_p2p_aws_backfills_region_and_ami_from_default_instance():
+    """AWS region/ami are derived from the default instance when absent at top level."""
+    provider_config = {
+        "instances": {"default": _instance_config(region="us-east-1", ami="ami-12345")}
+    }
+
+    provider = get_provider_model("aws", provider_config)
+
+    assert isinstance(provider, AWSProvider)
+    assert provider.region == "us-east-1"
+    assert provider.ami == "ami-12345"
+    assert provider.instances["default"].region == "us-east-1"
+    assert provider.instances["default"].ami == "ami-12345"
+
+    # Equivalent nested mappings accepted by the existing factory must not
+    # disable default derivation simply because they are not concrete dicts.
+    from collections import UserDict
+    from types import MappingProxyType
+
+    expected = provider.model_dump()
+    for mapping_type in (UserDict, MappingProxyType, _ReadOnlyMapping):
+        for instances in (
+            mapping_type({"default": _instance_config(region="us-east-1", ami="ami-12345")}),
+            {"default": mapping_type(_instance_config(region="us-east-1", ami="ami-12345"))},
+        ):
+            try:
+                actual = get_provider_model("aws", {"instances": instances})
+            except (AttributeError, TypeError, ValidationError) as exc:
+                raise AssertionError(
+                    "nested mappings accepted by the existing factory must remain "
+                    f"supported, including mappings without dict.copy(): {exc}"
+                ) from None
+            assert isinstance(actual, AWSProvider)
+            assert actual.model_dump() == expected
+
+
+def test_p2p_digitalocean_backfills_region_from_default_instance():
+    """DigitalOcean region is derived from the default instance when absent at top level."""
+    provider_config = {"instances": {"default": _instance_config(region="nyc1")}}
+
+    provider = get_provider_model("digitalocean", provider_config)
+
+    assert isinstance(provider, DigitalOceanProvider)
+    assert provider.region == "nyc1"
+    assert provider.instances["default"].region == "nyc1"
+
+
+def test_p2p_explicit_top_level_values_win_over_default_instance():
+    """Backfill must not override values already present at the top level."""
+    aws_provider = get_provider_model(
+        "aws",
+        {
+            "region": "eu-west-2",
+            "ami": "ami-top-level",
+            "instances": {
+                "default": _instance_config(region="us-east-1", ami="ami-instance")
+            },
+        },
+    )
+    assert aws_provider.region == "eu-west-2"
+    assert aws_provider.ami == "ami-top-level"
+
+    do_provider = get_provider_model(
+        "digitalocean",
+        {
+            "region": "sfo3",
+            "instances": {"default": _instance_config(region="nyc1")},
+        },
+    )
+    assert do_provider.region == "sfo3"
+
+
+def test_p2p_construction_does_not_add_backfilled_keys_to_caller_config():
+    """The caller-supplied mapping must not gain backfilled top-level keys."""
+    aws_config = {"instances": {"default": _instance_config(region="us-east-1", ami="ami-12345")}}
+    aws_snapshot = copy.deepcopy(aws_config)
+
+    aws_provider = get_provider_model("aws", aws_config)
+
+    assert aws_provider.region == "us-east-1"
+    assert aws_provider.ami == "ami-12345"
+    assert "region" not in aws_config
+    assert "ami" not in aws_config
+    assert aws_config == aws_snapshot
+
+    do_config = {"instances": {"default": _instance_config(region="nyc1")}}
+    do_snapshot = copy.deepcopy(do_config)
+
+    do_provider = get_provider_model("digitalocean", do_config)
+
+    assert do_provider.region == "nyc1"
+    assert "region" not in do_config
+    assert do_config == do_snapshot
+
+
+def test_p2p_unmodeled_provider_names_fall_back_to_generic_base_provider():
+    """Unknown or unmodeled names must not raise and must use the generic model."""
+    provider_config = {
+        "instances": {"default": _instance_config(region="nyc1", ami="ami-1")}
+    }
+
+    for provider_name in ("azure", "vultr", "scaleway", "p2p-not-a-provider"):
+        provider = get_provider_model(provider_name, copy.deepcopy(provider_config))
+        assert type(provider) is BaseProvider
+        assert "default" in provider.instances
+
+
+def test_p2p_scaling_model_instances_are_normalized_on_provider_and_instances():
+    """Scaling supplied as ProviderScaling instances is exposed on provider and instances."""
+    provider_config = {
+        "region": "nyc1",
+        "scaling": ProviderScaling(min_scaling=4, max_scaling=6),
+        "instances": {
+            "default": _instance_config(
+                scaling=ProviderScaling(min_scaling=1, max_scaling=2)
+            )
+        },
+    }
+
+    provider = get_provider_model("digitalocean", provider_config)
+
+    assert provider.scaling.min_scaling == 4
+    assert provider.scaling.max_scaling == 6
+    assert provider.instances["default"].scaling.min_scaling == 1
+    assert provider.instances["default"].scaling.max_scaling == 2
+    _assert_scaling_revalidation_and_isolation()
+
+
+def test_p2p_scaling_mappings_are_exposed_on_provider_and_instances():
+    """Scaling supplied as min/max mappings is exposed on provider and instances."""
+    provider_config = {
+        "region": "nyc1",
