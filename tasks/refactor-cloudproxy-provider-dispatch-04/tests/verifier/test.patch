+def test_p2p_providers_listing_covers_configured_providers_without_secrets(monkeypatch):
+    """Exercise secret exclusion with nonempty values, not ambient credentials."""
+    configured = copy.deepcopy(settings.config["providers"])
+    for name, provider_config in configured.items():
+        provider_config["secrets"] = {"token": f"p2p-provider-secret-{name}-sentinel"}
+        for instance_name, instance_config in provider_config.get("instances", {}).items():
+            instance_config["secrets"] = {
+                "token": f"p2p-instance-secret-{name}-{instance_name}-sentinel"
+            }
+    monkeypatch.setitem(settings.config, "providers", configured)
+
+    response = client.get("/providers")
+    assert response.status_code == 200
+
+    payload = response.json()
+    assert "metadata" in payload
+    assert "providers" in payload
+
+    configured = settings.config["providers"]
+    assert configured
+    for name, provider_config in configured.items():
+        assert name in payload["providers"]
+        provider_data = payload["providers"][name]
+        assert "secrets" not in provider_data
+        for secret_value in provider_config["secrets"].values():
+            assert secret_value not in json.dumps(payload)
+        for instance_name, instance_config in provider_config.get("instances", {}).items():
+            assert instance_name in provider_data["instances"]
+            assert "secrets" not in provider_data["instances"][instance_name]
+            for secret_value in (instance_config.get("secrets") or {}).values():
+                if secret_value:
+                    assert secret_value not in json.dumps(payload)
+
