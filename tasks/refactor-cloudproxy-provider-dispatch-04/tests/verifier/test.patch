+def _assert_scaling_revalidation_and_isolation():
+    for name in ('aws', 'digitalocean', 'gcp', 'hetzner', 'p2p-unmodeled'):
+        for location in ('provider', 'instance'):
+            for field in ('min_scaling', 'max_scaling'):
+                data = _regression_factory_config()
+                invalid = ProviderScaling(min_scaling=1, max_scaling=3)
+                setattr(invalid, field, -1)
+                target = data if location == 'provider' else data['instances']['default']
+                target['scaling'] = invalid
+                with pytest.raises(ValidationError):
+                    get_provider_model(name, data)
+        data = _regression_factory_config()
+        top = ProviderScaling(min_scaling=1, max_scaling=3)
+        nested = ProviderScaling(min_scaling=2, max_scaling=4)
+        data['scaling'] = top; data['instances']['default']['scaling'] = nested
+        result = get_provider_model(name, data)
+        before = result.model_dump()
+        top.min_scaling = 6; top.max_scaling = 7
+        nested.min_scaling = 8; nested.max_scaling = 9
+        assert result.model_dump() == before, 'factory output must retain its scaling snapshot after input mutation'
+        result.scaling.min_scaling = 10; result.scaling.max_scaling = 11
+        result.instances['default'].scaling.min_scaling = 12
+        result.instances['default'].scaling.max_scaling = 13
+        assert (top.min_scaling, top.max_scaling, nested.min_scaling, nested.max_scaling) == (6, 7, 8, 9), 'output mutations must not change caller scaling objects'
+
