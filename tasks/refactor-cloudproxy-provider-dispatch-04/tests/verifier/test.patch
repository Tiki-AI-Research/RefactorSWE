index 0000000000000000000000000000000000000000..6818046fd2a49ccc93a0dffd3cb0ee22e484e60c
--- /dev/null
+++ b/tests/test_f2p_provider_model_ownership.py
@@ -0,0 +1,408 @@
+"""Fail-to-pass tests: provider types own construction and configuration normalization.
+
+These tests pin the structural obligations of the provider-model refactor:
+
+* each provider type derives its own top-level defaults from the configuration it
+  receives, so region/AMI derivation is no longer duplicated in a shared branch
+  chain (REQ-STRUCT-002),
+* the factory selects the existing provider types without a shared chain of name
+  comparisons, and unknown names retain the generic fallback (REQ-STRUCT-001,
+  REQ-STRUCT-003),
+* constructing through the type leaves the caller-supplied configuration mapping
+  untouched (REQ-BEH-T4:B6).
+
+The frozen contract leaves internal module placement, dispatch mechanism and
+helper structure free (REQ-BEH-T4:C6), so every case drives the provider type
+through the type-owned construction entry actually used by the public factory,
+or the model's public validation entry when construction uses model validators.
+Construction helpers are discovered by behavior, never by their method name.
+While a type builds through its own entry, the shared
+name-dispatch factory is made unavailable, so an entry point that merely forwards
+the configuration back to the shared factory (which still holds the name-keyed
+derivation) fails the case.  The dispatch and listing cases observe that same
+factory from the outside instead and require it to preserve each type's own
+normalization. Runtime registration of new types is not a public requirement.
+No private helper name and no unique implementation shape is required; a
+baseline that keeps construction and normalization in the shared name-comparison
+chain fails every case with a real assertion failure.
+"""
+import ast
+import copy
+import inspect
+import sys
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+from pydantic import ValidationError
+
+from cloudproxy import main as main_module
+from cloudproxy.main import (
+    AWSProvider,
+    BaseProvider,
+    DigitalOceanProvider,
+    GCPProvider,
+    HetznerProvider,
+    ProviderInstance,
+    ProviderScaling,
+    app,
+    get_provider_model,
+)
+from cloudproxy.providers import settings
+
+client = TestClient(app)
+
+def _instance(**overrides):
+    config = {
+        "enabled": True,
+        "ips": [],
+        "scaling": {"min_scaling": 1, "max_scaling": 3},
+    }
+    config.update(overrides)
+    return config
+
+
+def _type_construction_entry(model_type, provider_config):
+    """Discover the factory's type-owned builder without prescribing its name.
+
+    A type-owned builder may have any name (internal helpers are unrestricted).
+    Observe which type-owned helper returns the model, then exercise it directly
+    on the original raw configuration with the shared factory unavailable. Merely
+    observing a successful factory call does not establish type ownership.
+    """
+    entries = {}
+    for _name, entry in inspect.getmembers(model_type, callable):
+        code = getattr(getattr(entry, "__func__", entry), "__code__", None)
+        if code is not None:
+            entries[code] = entry
+    selected = None
+
+    def profile(frame, event, result):
+        nonlocal selected
+        if event == "return" and frame.f_code in entries and isinstance(result, model_type):
+            entry = entries[frame.f_code]
+            try:
+                inspect.signature(entry).bind(provider_config)
+            except TypeError:
+                return
+            # Outer builders return after their helpers, so prefer the entry
+            # nearest the public factory over nested implementation helpers.
+            selected = entry
+
+    name = next(name for name, candidate, _config in _factory_cases()
+                if candidate is model_type)
+    previous = sys.getprofile()
+    try:
+        sys.setprofile(profile)
+        get_provider_model(name, copy.deepcopy(provider_config))
+    finally:
+        sys.setprofile(previous)
+    return selected or model_type.model_validate
+
+
+def _shared_factory_unavailable(monkeypatch):
+    """Make the shared name-dispatch factory unreachable while a provider type builds.
+
+    The provider type must own its construction and default derivation.  An entry
+    point that forwards the caller's configuration back to the shared factory --
+    the module-level ``get_provider_model`` symbol or any module-level alias of
+    it -- therefore cannot build a model inside these cases.
+    """
+
+    def _forbidden_factory(*args, **kwargs):
+        raise AssertionError(
+            "building the provider type reached the shared name-dispatch factory "
+            "get_provider_model; the provider type must own its construction and "
+            "default derivation instead of forwarding the configuration to the "
+            "shared factory"
+        )
+
+    shared_factory = getattr(main_module, "get_provider_model", None)
+    monkeypatch.setattr(
+        main_module, "get_provider_model", _forbidden_factory, raising=False
+    )
+    for attribute, value in list(vars(main_module).items()):
+        if value is shared_factory and value is not _forbidden_factory:
+            monkeypatch.setattr(main_module, attribute, _forbidden_factory)
+
+
+def _build_via_type(model_type, provider_config, monkeypatch=None):
+    """Build ``model_type`` from ``provider_config`` through the type's own entry point."""
+    entry = model_type.model_validate
+    try:
+        entry = _type_construction_entry(model_type, provider_config)
+        if monkeypatch is not None:
+            _shared_factory_unavailable(monkeypatch)
+        return entry(provider_config)
+    except ValidationError as exc:
+        # These valid configurations must construct successfully. Report this
+        # contract mismatch as an assertion in every probe, not an unknown error.
+        raise AssertionError(
+            f"{model_type.__name__} did not own construction of its model from the "
+            f"configuration it receives: building through {getattr(entry, '__name__', entry)!r} "
+            f"failed with {type(exc).__name__}: {exc}"
+        ) from None
+
+
+def _factory_cases():
+    """Exercise supported names and the public fallback, not an invented registry API."""
+    for name, model_type in (
+        ("digitalocean", DigitalOceanProvider),
+        ("aws", AWSProvider),
+        ("gcp", GCPProvider),
+        ("hetzner", HetznerProvider),
+        ("f2p-unmodeled-provider", BaseProvider),
+    ):
+        config = {
+            "instances": {"default": _instance(region=f"{name}-region", ami="ami-f2p")}
+        }
+        if model_type is GCPProvider:
+            config.update(zone="f2p-zone", image_project="f2p-project", image_family="f2p-family")
+        yield name, model_type, config
+
+
+def _trace_factory_paths(cases):
+    """Observe executed production functions, including helpers in private modules.
+
+    A module-wide text search would reject unrelated lifecycle code or dead code.
+    Trace only factory probes, then inspect the executed branch lines per function.
+    No mapping, helper name, construction method, or registration API is assumed.
+    """
+    root = Path(main_module.__file__).resolve().parent.parent
+    paths = {}
+
+    def trace(frame, event, arg):
+        if event == "call":
+            filename = frame.f_code.co_filename
+            # Frozen or synthetic code objects (e.g. "<frozen abc>") are not
+            # source files; resolving them relative to the cwd misplaces them
+            # inside the repository.
+            if filename.startswith("<") or not Path(filename).is_file():
+                return None
+            source = Path(filename).resolve()
+            if not source.is_relative_to(root):
+                return None
+            relative = source.relative_to(root)
+            if any(part.startswith(".") or part in {"tests", "test"} for part in relative.parts):
+                return None
+        if event == "line":
+            paths.setdefault(frame.f_code, set()).add(frame.f_lineno)
+        return trace
+
+    previous = sys.gettrace()
+    try:
+        sys.settrace(trace)
+        for name, expected_type, config in cases:
+            result = get_provider_model(name, copy.deepcopy(config))
+            assert type(result) is expected_type
+    finally:
+        sys.settrace(previous)
+    assert paths, "the public factory did not execute observable production code"
+    return paths
+
+
+def _assert_no_central_name_chain(paths):
+    """Reject executed literal-name branch chains, not declarative dispatch tables.
+
+    Group conditions by their compared expression within each executed function.
+    Independent type-owned validators are therefore not conflated. Dict lookup,
+    subclass discovery, and helper-module placement remain unrestricted.
+    """
+    names = {"digitalocean", "aws", "gcp", "hetzner"}
+
+    def literals(node):
+        if isinstance(node, ast.Constant) and isinstance(node.value, str):
+            return {node.value} & names
+        if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
+            return set().union(*(literals(item) for item in node.elts))
+        return set()
+
+    trees = {}
+    for code, executed in paths.items():
+        filename = code.co_filename
+        if filename not in trees:
+            trees[filename] = ast.parse(Path(filename).read_text(encoding="utf-8"))
+        comparisons = {}
+        for node in ast.walk(trees[filename]):
+            if not isinstance(node, (ast.If, ast.IfExp, ast.Match)) or node.lineno not in executed:
+                continue
+            if isinstance(node, ast.Match):
+                choices = [
+                    {part.value.value for part in ast.walk(case.pattern)
+                     if isinstance(part, ast.MatchValue)
+                     and isinstance(part.value, ast.Constant)
+                     and isinstance(part.value.value, str)} & names
+                    for case in node.cases
+                ]
+                key = ast.dump(node.subject)
+                comparisons.setdefault(key, []).extend(choice for choice in choices if choice)
+                continue
+            for condition in ast.walk(node.test):
+                if not isinstance(condition, ast.Compare):
+                    continue
+                operands = [condition.left, *condition.comparators]
+                for left, op, right in zip(operands, condition.ops, operands[1:]):
+                    if not isinstance(op, (ast.Eq, ast.NotEq, ast.Is, ast.IsNot, ast.In, ast.NotIn)):
+                        continue
+                    for value, expression in ((left, right), (right, left)):
+                        choice = literals(value)
+                        if choice and not literals(expression):
+                            comparisons.setdefault(ast.dump(expression), []).append(choice)
+        for choices in comparisons.values():
+            assert not (len(choices) > 1 and len(set().union(*choices)) > 1), (
+                f"central provider-name comparison chain in {Path(filename).name}:{code.co_name}; "
+                "provider selection must not retain shared literal-name branches"
+            )
+
+
+def test_f2p_digitalocean_type_build_derives_region_from_default_instance(monkeypatch):
+    provider_config = {"instances": {"default": _instance(region="nyc1")}}
+
+    provider = _build_via_type(DigitalOceanProvider, provider_config, monkeypatch)
+
+    assert isinstance(provider, DigitalOceanProvider)
+    assert provider.region == "nyc1"
+
+
+def test_f2p_aws_type_build_derives_region_from_default_instance(monkeypatch):
+    provider_config = {
+        "instances": {"default": _instance(region="us-east-1", ami="ami-12345")}
+    }
+
+    provider = _build_via_type(AWSProvider, provider_config, monkeypatch)
+
+    assert isinstance(provider, AWSProvider)
+    assert provider.region == "us-east-1"
+
+
+def test_f2p_aws_type_build_derives_ami_from_default_instance(monkeypatch):
+    provider_config = {
+        "instances": {"default": _instance(region="us-east-1", ami="ami-12345")}
+    }
+
+    provider = _build_via_type(AWSProvider, provider_config, monkeypatch)
+
+    assert isinstance(provider, AWSProvider)
+    assert provider.ami == "ami-12345"
+
+
+def test_f2p_type_build_exposes_derived_region_on_default_instance(monkeypatch):
+    provider_config = {"instances": {"default": _instance(region="nyc1")}}
+
+    provider = _build_via_type(DigitalOceanProvider, provider_config, monkeypatch)
+
+    default_instance = provider.instances["default"]
+    assert isinstance(default_instance, ProviderInstance)
+    assert default_instance.region == "nyc1"
+
+
+def test_f2p_aws_type_build_keeps_explicit_top_level_region_and_derives_ami(monkeypatch):
+    provider_config = {
+        "region": "eu-west-2",
+        "instances": {"default": _instance(region="us-east-1", ami="ami-instance")},
+    }
+
+    provider = _build_via_type(AWSProvider, provider_config, monkeypatch)
+
+    assert provider.region == "eu-west-2"
+    assert provider.ami == "ami-instance"
+
+
+def test_f2p_type_build_derives_from_the_default_instance_only(monkeypatch):
+    provider_config = {
+        "instances": {
+            "prod": _instance(region="ams3"),
+            "default": _instance(region="nyc1"),
+        }
+    }
+
+    provider = _build_via_type(DigitalOceanProvider, provider_config, monkeypatch)
+
+    assert provider.region == "nyc1"
+
+
+def test_f2p_type_build_does_not_add_derived_keys_to_caller_config(monkeypatch):
+    provider_config = {"instances": {"default": _instance(region="nyc1")}}
+    before = copy.deepcopy(provider_config)
+
+    provider = _build_via_type(DigitalOceanProvider, provider_config, monkeypatch)
+
+    assert provider.region == "nyc1"
+    assert provider_config == before
+
+
+def test_f2p_type_build_does_not_rewrite_nested_instance_config(monkeypatch):
+    scaling = ProviderScaling(min_scaling=1, max_scaling=3)
+    default_instance = _instance(region="nyc1", scaling=scaling)
+    provider_config = {"instances": {"default": default_instance}}
+
+    provider = _build_via_type(DigitalOceanProvider, provider_config, monkeypatch)
+
+    assert provider.region == "nyc1"
+    assert provider.instances["default"].scaling.max_scaling == 3
+    # The frozen factory may normalize a nested scaling model into a mapping.
+    # Preserve values without imposing a new nested-object identity contract.
+    observed = dict(provider_config["instances"]["default"])
+    observed_scaling = observed["scaling"]
+    observed["scaling"] = (observed_scaling.model_dump()
+                           if isinstance(observed_scaling, ProviderScaling)
+                           else dict(observed_scaling))
+    assert observed == _instance(region="nyc1", scaling={"min_scaling": 1, "max_scaling": 3})
+
+
+def test_f2p_type_build_normalizes_provider_scaling_model_instance(monkeypatch):
+    provider_config = {
+        "scaling": ProviderScaling(min_scaling=5, max_scaling=7),
+        "instances": {"default": _instance(region="nyc1")},
+    }
+
+    provider = _build_via_type(DigitalOceanProvider, provider_config, monkeypatch)
+
+    assert provider.region == "nyc1"
+    assert provider.scaling.min_scaling == 5
+    assert provider.scaling.max_scaling == 7
+
+
+def test_f2p_type_build_normalizes_scaling_mapping_on_provider_and_instances(monkeypatch):
+    provider_config = {
+        "scaling": {"min_scaling": 2, "max_scaling": 4},
+        "instances": {
+            "default": _instance(region="nyc1", scaling={"min_scaling": 1, "max_scaling": 3})
+        },
+    }
+
+    provider = _build_via_type(DigitalOceanProvider, provider_config, monkeypatch)
+
+    assert provider.scaling.min_scaling == 2
+    assert provider.scaling.max_scaling == 4
+    assert provider.instances["default"].scaling.min_scaling == 1
+
+
+def test_f2p_factory_has_no_central_provider_name_chain():
+    _assert_no_central_name_chain(_trace_factory_paths(_factory_cases()))
+
+
+def test_f2p_factory_preserves_type_owned_normalization():
+    for name, model_type, config in _factory_cases():
+        if model_type not in (DigitalOceanProvider, AWSProvider):
+            continue
+        direct = _build_via_type(model_type, copy.deepcopy(config))
+        provider = get_provider_model(name, copy.deepcopy(config))
+        assert type(provider) is model_type
+        assert provider.region == direct.region == f"{name}-region"
+        if model_type is AWSProvider:
+            assert provider.ami == direct.ami == "ami-f2p"
+
+
+def test_f2p_provider_listing_preserves_type_owned_normalization(monkeypatch):
+    cases = [(name, model_type, config) for name, model_type, config in _factory_cases()
+             if model_type in (DigitalOceanProvider, AWSProvider)]
+    monkeypatch.setitem(settings.config, "providers", {
+        name: copy.deepcopy(config) for name, _model_type, config in cases
+    })
+    response = client.get("/providers")
+    assert response.status_code == 200
+    payload = response.json()["providers"]
+    assert set(payload) == {name for name, _model_type, _config in cases}
+    for name, model_type, config in cases:
+        direct = _build_via_type(model_type, copy.deepcopy(config))
+        assert payload[name]["region"] == direct.region == f"{name}-region"
