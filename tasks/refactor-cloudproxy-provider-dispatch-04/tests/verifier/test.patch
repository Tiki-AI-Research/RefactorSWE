+def _assert_subclass_declaration_does_not_replace_existing_provider():
+    # Registration side effects stay in a fresh process, never leaking to tests.
+    import json
+    import subprocess
+    import sys
+    script = '''import json
+from cloudproxy import main as m
+def observe():
+    try:
+        result=m.get_provider_model('aws', {'region':'region','ami':'ami','instances':{}})
+        return {'type':type(result).__name__,'value':result.model_dump()}
+    except Exception as exc:
+        return {'error':type(exc).__name__,'message':str(exc)}
+before=observe()
+class ExtendedAWS(m.AWSProvider):
+    deployment_label: str
+print('PROVIDER_SUBCLASS_RESULT='+json.dumps({'before':before,'after':observe()}))
+'''
+    result = subprocess.run([sys.executable, '-B', '-c', script], capture_output=True, text=True, timeout=30)
+    if result.returncode: raise RuntimeError('subclass observation process failed: '+result.stderr[-2000:])
+    receipts = [line for line in result.stdout.splitlines() if line.startswith('PROVIDER_SUBCLASS_RESULT=')]
+    if len(receipts) != 1: raise RuntimeError('missing unique subclass observation receipt')
+    observation = json.loads(receipts[0].split('=', 1)[1])
+    assert observation['before']['type'] == 'AWSProvider'
+    assert observation['after'] == observation['before'], 'declaring an unregistered subclass must not take over aws'
