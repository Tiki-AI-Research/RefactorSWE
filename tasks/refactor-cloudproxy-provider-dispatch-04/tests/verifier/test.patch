+    provider = get_provider_model("digitalocean", provider_config)
+
+    assert provider.scaling.min_scaling == 5
+    assert provider.scaling.max_scaling == 7
+    assert provider.instances["default"].scaling.min_scaling == 2
+    assert provider.instances["default"].scaling.max_scaling == 3
