+func assertSameProof(t *testing.T, a, b *ProofNode) {
+	t.Helper()
+	if a == nil || b == nil {
+		if a != b {
+			t.Fatalf("mismatched nil: a=%v, b=%v", a, b)
+		}
+		return
+	}
+	if a.ID != b.ID {
+		t.Errorf("ID mismatch: %q vs %q", a.ID, b.ID)
+	}
+	if a.Fact.String() != b.Fact.String() {
+		t.Errorf("Fact mismatch: %q vs %q", a.Fact.String(), b.Fact.String())
+	}
+	if a.Kind != b.Kind {
+		t.Errorf("Kind mismatch: %v vs %v", a.Kind, b.Kind)
+	}
+	if a.RuleID != b.RuleID {
+		t.Errorf("RuleID mismatch: %q vs %q", a.RuleID, b.RuleID)
+	}
+	if a.Partial != b.Partial {
+		t.Errorf("Partial mismatch: %v vs %v", a.Partial, b.Partial)
+	}
+	if len(a.Bindings) != len(b.Bindings) {
+		t.Errorf("Bindings len mismatch: %d vs %d", len(a.Bindings), len(b.Bindings))
+	} else {
+		for i := range a.Bindings {
+			if a.Bindings[i].Var != b.Bindings[i].Var || !a.Bindings[i].Value.Equals(b.Bindings[i].Value) {
+				t.Errorf("Binding %d mismatch: %+v vs %+v", i, a.Bindings[i], b.Bindings[i])
+			}
+		}
+	}
+	if len(a.Premises) != len(b.Premises) {
+		t.Fatalf("Premises len mismatch for %s: %d vs %d", a.ID, len(a.Premises), len(b.Premises))
+	}
+	for i := range a.Premises {
+		assertSameProof(t, a.Premises[i], b.Premises[i])
+	}
+}
+
+func collectSortedFacts(store factstore.SimpleInMemoryStore) []string {
+	var facts []string
+	for _, p := range store.ListPredicates() {
+		store.GetFacts(ast.NewQuery(p), func(a ast.Atom) error {
+			facts = append(facts, a.String())
+			return nil
+		})
+	}
+	sort.Strings(facts)
+	return facts
+}
