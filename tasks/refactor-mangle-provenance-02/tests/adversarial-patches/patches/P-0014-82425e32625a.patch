+func TestExplainMaxDepthPartial(t *testing.T) {
+	pi, store := buildAndEval(t, `
+		edge(1, 2).
+		edge(2, 3).
+		edge(3, 4).
+		path(X, Y) :- edge(X, Y).
+		path(X, Z) :- edge(X, Y), path(Y, Z).
+	`)
+	goal := mustAtom(t, "path(1, 4)")
+	// MaxDepth: 1 should truncate deep recursion and mark proof Partial with partialID.
+	proofs, err := Explain(pi, store, goal, Options{MaxDepth: 1})
+	if err != nil {
+		t.Fatalf("Explain: %v", err)
+	}
+	if len(proofs) != 1 {
+		t.Fatalf("got %d proofs, want 1", len(proofs))
+	}
+	p := proofs[0]
+	if !p.Partial {
+		t.Errorf("expected root proof to be marked partial")
+	}
+	// Check that at least one sub-proof is a partial leaf.
+	var foundPartialLeaf bool
+	var walk func(n *ProofNode)
+	walk = func(n *ProofNode) {
+		if n == nil {
+			return
+		}
+		if n.Partial && strings.HasPrefix(n.ID, "/proof/partial/") {
+			foundPartialLeaf = true
+			if n.ID != partialID(n.Fact) {
+				t.Errorf("got partial ID %q, want %q", n.ID, partialID(n.Fact))
+			}
+		}
+		for _, sub := range n.Premises {
+			walk(sub)
+		}
+	}
+	walk(p)
+	if !foundPartialLeaf {
+		t.Errorf("expected to find a partial leaf in the proof tree")
+	}
+}
