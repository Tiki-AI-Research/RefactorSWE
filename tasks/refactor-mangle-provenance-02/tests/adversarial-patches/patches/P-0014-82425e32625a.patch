+func TestFullModeMemoization(t *testing.T) {
+	source := `
+		edge(1, 2).
+		edge(2, 3).
+		path(X, Y) :- edge(X, Y).
+		path(X, Z) :- edge(X, Y), path(Y, Z).
+		reach(X, Y) :- path(X, Y), path(X, Y).
+	`
+	_, store, rec := buildEvalRec(t, source)
+	goal := mustAtom(t, "reach(1, 3)")
+	proofs, err := BuildFromRecording(rec, store, goal, Options{})
+	if err != nil {
+		t.Fatalf("BuildFromRecording: %v", err)
+	}
+	if len(proofs) != 1 {
+		t.Fatalf("got %d proofs, want 1", len(proofs))
+	}
+	// Within a single call, memoized subproofs must share pointer and ID.
+	if len(proofs[0].Premises) != 2 {
+		t.Fatalf("expected 2 premises for reach, got %d", len(proofs[0].Premises))
+	}
+	sub1 := proofs[0].Premises[0]
+	sub2 := proofs[0].Premises[1]
+	if sub1 != sub2 {
+		t.Errorf("expected pointer sharing between memoized subproofs")
+	}
+	if sub1.ID != sub2.ID {
+		t.Errorf("expected identical ID for memoized subproofs: %q vs %q", sub1.ID, sub2.ID)
+	}
+
+	// Repeated call in separate invocation produces identical IDs.
+	proofs2, err := BuildFromRecording(rec, store, goal, Options{})
+	if err != nil {
+		t.Fatalf("BuildFromRecording (2nd call): %v", err)
+	}
+	if proofs[0].ID != proofs2[0].ID {
+		t.Errorf("expected stable proof ID across calls: %q vs %q", proofs[0].ID, proofs2[0].ID)
+	}
+}
