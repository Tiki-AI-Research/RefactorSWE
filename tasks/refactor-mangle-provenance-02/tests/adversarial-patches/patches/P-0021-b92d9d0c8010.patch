+func TestFullModeMatchesSimpleOutput(t *testing.T) {
+	// Program with derived rules, EDB facts, shared subderivations, and negation.
+	source := `
+		edge(1, 2).
+		edge(2, 3).
+		edge(3, 4).
+		path(X, Y) :- edge(X, Y).
+		path(X, Z) :- edge(X, Y), path(Y, Z).
+		node(1).
+		node(2).
+		node(3).
+		node(4).
+		unreachable_from_1(X) :- node(X), !path(1, X).
+	`
+	pi, store, rec := buildEvalRec(t, source)
+
+	// Test 1: path(1, 4) - derived with shared sub-proofs
+	goal1 := mustAtom(t, "path(1, 4)")
+	pSimple1, err := Explain(pi, store, goal1, Options{})
+	if err != nil {
+		t.Fatalf("Explain(path(1, 4)): %v", err)
+	}
+	pFull1, err := BuildFromRecording(rec, store, goal1, Options{})
+	if err != nil {
+		t.Fatalf("BuildFromRecording(path(1, 4)): %v", err)
+	}
+	if len(pSimple1) != len(pFull1) {
+		t.Fatalf("proof count mismatch: %d vs %d", len(pSimple1), len(pFull1))
+	}
+	assertSameProof(t, pSimple1[0], pFull1[0])
+
+	var bufSimple, bufFull bytes.Buffer
+	if err := Print(&bufSimple, pSimple1); err != nil {
+		t.Fatalf("Print simple: %v", err)
+	}
+	if err := Print(&bufFull, pFull1); err != nil {
+		t.Fatalf("Print full: %v", err)
+	}
+	if bufSimple.String() != bufFull.String() {
+		t.Errorf("Print output mismatch:\nsimple:\n%s\nfull:\n%s", bufSimple.String(), bufFull.String())
+	}
+
+	outSimple := factstore.NewSimpleInMemoryStore()
+	if err := EmitFacts(pSimple1, &outSimple); err != nil {
+		t.Fatalf("EmitFacts simple: %v", err)
+	}
+	outFull := factstore.NewSimpleInMemoryStore()
+	if err := EmitFacts(pFull1, &outFull); err != nil {
+		t.Fatalf("EmitFacts full: %v", err)
+	}
+	factsSimple := collectSortedFacts(outSimple)
+	factsFull := collectSortedFacts(outFull)
+	if strings.Join(factsSimple, "\n") != strings.Join(factsFull, "\n") {
+		t.Errorf("EmitFacts mismatch:\nsimple:\n%v\nfull:\n%v", factsSimple, factsFull)
+	}
+
+	// Test 2: unreachable_from_1(1) has no proof because path(1, 1) or !path(1, 1) fails;
+	// but node(1) is stored:
+	goalEDB := mustAtom(t, "node(1)")
+	pSimpleEDB, err := Explain(pi, store, goalEDB, Options{})
+	if err != nil {
+		t.Fatalf("Explain(node(1)): %v", err)
+	}
+	pFullEDB, err := BuildFromRecording(rec, store, goalEDB, Options{})
+	if err != nil {
+		t.Fatalf("BuildFromRecording(node(1)): %v", err)
+	}
+	assertSameProof(t, pSimpleEDB[0], pFullEDB[0])
+}
