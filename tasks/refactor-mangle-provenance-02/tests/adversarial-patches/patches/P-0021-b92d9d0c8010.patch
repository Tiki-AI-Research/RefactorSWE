+func TestFullModeCycleTermination(t *testing.T) {
+	// Evaluator with a cycle.
+	source := `
+		edge(1, 2).
+		edge(2, 1).
+		reach(X, Y) :- edge(X, Y).
+		reach(X, Z) :- reach(X, Y), edge(Y, Z).
+	`
+	_, store, rec := buildEvalRec(t, source)
+	goal := mustAtom(t, "reach(1, 2)")
+	// Should terminate without infinite recursion.
+	proofs, err := BuildFromRecording(rec, store, goal, Options{})
+	if err != nil {
+		t.Fatalf("BuildFromRecording: %v", err)
+	}
+	if len(proofs) == 0 {
+		t.Fatalf("expected at least 1 proof")
+	}
+}
