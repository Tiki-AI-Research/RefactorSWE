+func TestRuleIDSameTextDifferentIndices(t *testing.T) {
+	// ProgramInfo with two identical clauses at different rule indices.
+	pi, store := buildAndEval(t, `
+		a(1).
+		foo(X) :- a(X).
+		foo(X) :- a(X).
+	`)
+	goal := mustAtom(t, "foo(1)")
+	proofs, err := Explain(pi, store, goal, Options{MaxProofs: 2})
+	if err != nil {
+		t.Fatalf("Explain: %v", err)
+	}
+	if len(proofs) == 0 {
+		t.Fatalf("expected at least 1 proof")
+	}
+	// RuleID should match ruleContentID for foo(X) :- a(X).
+	wantRuleID := ruleContentID(pi.Rules[0])
+	if proofs[0].RuleID != wantRuleID {
+		t.Errorf("got RuleID %q, want %q", proofs[0].RuleID, wantRuleID)
+	}
+}
