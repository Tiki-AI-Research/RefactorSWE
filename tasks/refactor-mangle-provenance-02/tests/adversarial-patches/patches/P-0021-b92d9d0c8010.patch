+func TestFullModeMaxProofs(t *testing.T) {
+	source := `
+		a(1).
+		b(1).
+		c(1).
+		foo(X) :- a(X).
+		foo(X) :- b(X).
+		foo(X) :- c(X).
+	`
+	_, store, rec := buildEvalRec(t, source)
+	goal := mustAtom(t, "foo(1)")
+	for _, max := range []int{0, 1, 2, 3} {
+		proofs, err := BuildFromRecording(rec, store, goal, Options{MaxProofs: max})
+		if err != nil {
+			t.Fatalf("MaxProofs=%d BuildFromRecording: %v", max, err)
+		}
+		want := max
+		if want == 0 {
+			want = 1
+		}
+		if len(proofs) != want {
+			t.Errorf("MaxProofs=%d: got %d proofs, want %d", max, len(proofs), want)
+		}
+	}
+	for _, neg := range []int{-1, -5} {
+		proofs, err := BuildFromRecording(rec, store, goal, Options{MaxProofs: neg})
+		if err != ErrNoProof {
+			t.Errorf("MaxProofs=%d BuildFromRecording: got err %v, want %v", neg, err, ErrNoProof)
+		}
+		if proofs != nil {
+			t.Errorf("MaxProofs=%d BuildFromRecording: want nil proofs, got %v", neg, proofs)
+		}
+	}
+}
