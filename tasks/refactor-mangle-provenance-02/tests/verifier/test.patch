+// TestP2PSharedSubProofCollapse pins that a sub-derivation shared by two
+// alternative proofs within one call collapses onto one memoized node.
+func TestP2PSharedSubProofCollapse(t *testing.T) {
+	source := `
+		bar(1).
+		baz(1).
+		qux(1).
+		foo1(X) :- bar(X), baz(X).
+		foo2(X) :- bar(X), qux(X).
+		mid(X) :- foo1(X).
+		mid(X) :- foo2(X).
+	`
+	pi, store := p2pEvalProgram(t, source, nil)
+	proofs, err := provenance.Explain(pi, store, p2pAtom(t, "mid(1)"), provenance.Options{MaxProofs: 2})
+	if err != nil {
+		t.Fatalf("Explain: %v", err)
+	}
+	if len(proofs) != 2 {
+		t.Fatalf("got %d proofs, want 2 alternatives", len(proofs))
+	}
+	var barIDs []string
+	for _, p := range proofs {
+		for _, sub := range p.Premises {
+			for _, leaf := range sub.Premises {
+				if leaf.Fact.String() == "bar(1)" {
+					barIDs = append(barIDs, leaf.ID)
+				}
+			}
+		}
+	}
+	if len(barIDs) != 2 {
+		t.Fatalf("expected bar(1) as a sub-proof of both derivations, got %d occurrences", len(barIDs))
+	}
+	if barIDs[0] != barIDs[1] {
+		t.Errorf("shared sub-proof should collapse onto one id, got %q and %q", barIDs[0], barIDs[1])
+	}
+}
