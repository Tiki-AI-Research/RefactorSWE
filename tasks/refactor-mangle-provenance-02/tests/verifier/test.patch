+// Supplemental P2P regression coverage for the mgwhy CLI: the -mode flag must
+// keep selecting post-hoc ("simple") versus recording-based ("full")
+// construction, and the tree/facts output formats must stay unchanged.
+package main
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"codeberg.org/TauCeti/mangle-go/provenance"
+)
+
+const p2pCLIPlainProgram = `
+	bar(1).
+	baz(1).
+	foo(X) :- bar(X), baz(X).
+`
+
+const p2pCLITransformProgram = `
+	measurement(1, 10).
+	measurement(2, 20).
+	scaled(ID, V) :- measurement(ID, Raw) |> let V = fn:mult(Raw, 2).
+`
+
+func p2pWriteProgram(t *testing.T, src string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "program.mg")
+	if err := os.WriteFile(path, []byte(src), 0o644); err != nil {
+		t.Fatalf("write program: %v", err)
+	}
+	return path
+}
+
+// p2pCaptureStdout runs fn with os.Stdout redirected to a pipe and returns
+// everything fn wrote. run() writes directly to os.Stdout.
+func p2pCaptureStdout(t *testing.T, fn func() error) string {
+	t.Helper()
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	old := os.Stdout
+	os.Stdout = w
+	runErr := fn()
+	os.Stdout = old
+	if err := w.Close(); err != nil {
+		t.Fatalf("close pipe: %v", err)
+	}
+	data, readErr := io.ReadAll(r)
+	if err := r.Close(); err != nil {
+		t.Fatalf("close read end: %v", err)
+	}
+	if runErr != nil {
+		t.Fatalf("run: %v", runErr)
+	}
+	if readErr != nil {
+		t.Fatalf("read stdout: %v", readErr)
+	}
+	return string(data)
+}
+
+func p2pSortedLines(s string) string {
+	lines := strings.Split(strings.TrimSpace(s), "\n")
+	sort.Strings(lines)
+	return strings.Join(lines, "\n")
+}
+
+func TestP2PCLIModeFlagSelectsBuilderAndFormats(t *testing.T) {
+	plain := p2pWriteProgram(t, p2pCLIPlainProgram)
+
+	// Plain Datalog: both modes must print the same tree and emit the same
+	// facts.
+	simpleTree := p2pCaptureStdout(t, func() error { return run(plain, "", "foo(1)", "simple", "tree", 1, 64) })
+	fullTree := p2pCaptureStdout(t, func() error { return run(plain, "", "foo(1)", "full", "tree", 1, 64) })
+	if simpleTree != fullTree {
+		t.Errorf("tree output differs between simple and full modes:\nsimple:\n%s\nfull:\n%s", simpleTree, fullTree)
+	}
+	if !strings.Contains(simpleTree, "bar(1)") || !strings.Contains(simpleTree, "by rule /rule/") {
+		t.Errorf("tree output missing expected proof structure:\n%s", simpleTree)
+	}
+
+	simpleFacts := p2pCaptureStdout(t, func() error { return run(plain, "", "foo(1)", "simple", "facts", 1, 64) })
+	fullFacts := p2pCaptureStdout(t, func() error { return run(plain, "", "foo(1)", "full", "facts", 1, 64) })
+	if p2pSortedLines(simpleFacts) != p2pSortedLines(fullFacts) {
+		t.Errorf("facts output differs between simple and full modes:\nsimple:\n%s\nfull:\n%s", simpleFacts, fullFacts)
+	}
+	for _, want := range []string{"proves(", "uses_rule(", "premise(", "edb_leaf(", "binding("} {
+		if !strings.Contains(simpleFacts, want) {
+			t.Errorf("facts output missing %q:\n%s", want, simpleFacts)
+		}
+	}
+
+	// Transform program: the post-hoc mode cannot reconstruct it, the
+	// recording-based mode replays the let-transform.
+	transform := p2pWriteProgram(t, p2pCLITransformProgram)
+	if err := run(transform, "", "scaled(1,20)", "simple", "tree", 1, 64); err != provenance.ErrNoProof {
+		t.Errorf("simple mode on a transform-derived goal: err = %v, want ErrNoProof", err)
+	}
+	fullTransformTree := p2pCaptureStdout(t, func() error { return run(transform, "", "scaled(1,20)", "full", "tree", 1, 64) })
+	if !strings.Contains(fullTransformTree, "transform:") {
+		t.Errorf("full mode tree missing the transform text:\n%s", fullTransformTree)
+	}
+	if !strings.Contains(fullTransformTree, "scaled(1,20)") {
+		t.Errorf("full mode tree missing the goal fact:\n%s", fullTransformTree)
+	}
+	fullTransformFacts := p2pCaptureStdout(t, func() error { return run(transform, "", "scaled(1,20)", "full", "facts", 1, 64) })
+	if !strings.Contains(fullTransformFacts, "uses_transform(") {
+		t.Errorf("full mode facts output missing uses_transform:\n%s", fullTransformFacts)
+	}
+}
