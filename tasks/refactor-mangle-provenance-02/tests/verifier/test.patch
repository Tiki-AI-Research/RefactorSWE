+package f2p
+
+import (
+	"sort"
+	"strings"
+	"testing"
+)
+
+// The tests in this package verify, by inspecting the production sources of
+// package provenance, that the duplicated proof-graph construction skeleton
+// has been converged into one shared construction component that both public
+// entry points use, and that the two entry points diverge only in premise
+// resolution (store lookups for Explain, recorded-event replay for
+// BuildFromRecording). Ownership evidence is always a data-flow or
+// delegation relation to the shared component: the proof slice returned by an
+// entry point must be produced by shared code, and each construction
+// responsibility must be carried by code the two entries share while no
+// entry-private code carries it.
+
+func (a *constructionAnalysis) ownersWith(pred func(*fnInfo) bool) []*fnInfo {
+	var out []*fnInfo
+	for _, f := range a.region {
+		if pred(f) {
+			out = append(out, f)
+		}
+	}
+	return out
+}
+
+// assertOwnedBySharedCode asserts that at least one function carrying the
+// responsibility is usable by both entry points and that no entry-private
+// code carries it.
+func (a *constructionAnalysis) assertOwnedBySharedCode(t *testing.T, what string, owners []*fnInfo) {
+	t.Helper()
+	if len(owners) == 0 {
+		t.Errorf("no code in the construction paths of %s/%s implements %s", entryPostHoc, entryRecording, what)
+		return
+	}
+	var shared, private []*fnInfo
+	for _, f := range owners {
+		if a.shared(f) {
+			shared = append(shared, f)
+		} else {
+			private = append(private, f)
+		}
+	}
+	if len(shared) == 0 {
+		t.Errorf("%s: no function usable by both %s and %s implements %s; owners are entry-private:\n  %s",
+			what, entryPostHoc, entryRecording, what, a.locations(private))
+	}
+	if len(private) > 0 {
+		t.Errorf("%s is still implemented by code private to one entry point instead of the shared construction component:\n  %s",
+			what, a.locations(private))
+	}
+}
+
+func TestF2PExplainReturnValueProducedBySharedCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	fr := a.frontier(a.post)
+	if len(fr) == 0 {
+		t.Fatalf("cannot trace the proof slice returned by %s to any producing function", entryPostHoc)
+	}
+	var private []*fnInfo
+	for k := range fr {
+		f := a.byKey[k]
+		if f == nil {
+			t.Errorf("the returned proof slice of %s is produced by unknown code %q", entryPostHoc, k)
+			continue
+		}
+		if !a.shared(f) {
+			private = append(private, f)
+		}
+	}
+	if len(private) > 0 {
+		t.Errorf("%s returns a proof slice produced by code private to that entry point; the shared construction component must produce it:\n  %s",
+			entryPostHoc, a.locations(private))
+	}
+}
+
+func TestF2PRecordingReturnValueProducedBySharedCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	fr := a.frontier(a.rec)
+	if len(fr) == 0 {
+		t.Fatalf("cannot trace the proof slice returned by %s to any producing function", entryRecording)
+	}
+	var private []*fnInfo
+	for k := range fr {
+		f := a.byKey[k]
+		if f == nil {
+			t.Errorf("the returned proof slice of %s is produced by unknown code %q", entryRecording, k)
+			continue
+		}
+		if !a.shared(f) {
+			private = append(private, f)
+		}
+	}
+	if len(private) > 0 {
+		t.Errorf("%s returns a proof slice produced by code private to that entry point; the shared construction component must produce it:\n  %s",
+			entryRecording, a.locations(private))
+	}
+}
+
+func TestF2PBothEntryPointsUseSameConstructionProducer(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	postFrontier := a.frontier(a.post)
+	recFrontier := a.frontier(a.rec)
+	if len(postFrontier) == 0 || len(recFrontier) == 0 {
+		t.Fatalf("cannot trace the proof slices returned by %s/%s to producing functions (%v vs %v)",
+			entryPostHoc, entryRecording, a.keys(postFrontier), a.keys(recFrontier))
+	}
+	var onlyPost, onlyRec, common []string
+	for k := range postFrontier {
+		if recFrontier[k] {
+			common = append(common, k)
+		} else {
+			onlyPost = append(onlyPost, k)
+		}
+	}
+	for k := range recFrontier {
+		if !postFrontier[k] {
+			onlyRec = append(onlyRec, k)
+		}
+	}
+	sort.Strings(common)
+	sort.Strings(onlyPost)
+	sort.Strings(onlyRec)
+	if len(onlyPost) > 0 || len(onlyRec) > 0 {
+		t.Errorf("%s and %s return proof slices built by different construction code; %s-only producers: %v; %s-only producers: %v",
+			entryPostHoc, entryRecording, entryPostHoc, onlyPost, entryRecording, onlyRec)
+	}
+	for _, k := range common {
+		if f := a.byKey[k]; f != nil && !a.shared(f) {
+			t.Errorf("the construction code shared by both entry points (%s) is private to one of them", a.location(f))
+		}
+	}
+}
+
+func TestF2POptionDefaultsOwnedBySharedConstructionCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	a.assertOwnedBySharedCode(t, "Options zero-value defaulting", a.ownersWith(a.writesOptionsFields))
+}
+
+func TestF2PGroundGoalRejectionOwnedBySharedConstructionCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	owners := a.ownersWith(a.returnsErrGoalNotGround)
+	a.assertOwnedBySharedCode(t, "non-ground goal rejection with ErrGoalNotGround", owners)
+	if len(owners) == 0 {
+		return
+	}
+	for _, entry := range []*fnInfo{a.post, a.rec} {
+		chains := a.groundErrorChains(entry)
+		if len(chains) == 0 {
+			t.Errorf("the error returned by %s for a non-ground goal does not originate in shared validation code", entry.name)
+			continue
+		}
+		for _, chain := range chains {
+			for _, k := range chain {
+				f := a.byKey[k]
+				if f != nil && !a.shared(f) {
+					t.Errorf("the non-ground rejection propagated by %s is produced by entry-private code %s", entry.name, a.location(f))
+				}
+			}
+		}
+	}
+}
+
+func TestF2PDepthLimitOwnedBySharedConstructionCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	a.assertOwnedBySharedCode(t, "MaxDepth depth limiting with Partial marking", a.ownersWith(a.depthHandling))
+}
+
+func TestF2PProofNodeAssemblyOwnedBySharedConstructionCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	a.assertOwnedBySharedCode(t, "proof-node assembly", a.ownersWith(a.assemblesProofNode))
+}
+
+func TestF2PContentAddressedIDStampingOwnedBySharedConstructionCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	a.assertOwnedBySharedCode(t, "content-addressed identifier stamping on proof nodes", a.ownersWith(a.stampsNodeID))
+}
+
+func (a *constructionAnalysis) assertStateOwnedBySharedCode(t *testing.T, what string, kind stateKind) {
+	t.Helper()
+	var owners []*fnInfo
+	seen := map[string]bool{}
+	for _, acc := range a.stateAccessAll() {
+		if acc.kind != kind || seen[acc.fn.key] {
+			continue
+		}
+		seen[acc.fn.key] = true
+		owners = append(owners, acc.fn)
+	}
+	a.assertOwnedBySharedCode(t, what, owners)
+}
+
+func TestF2PProofMemoStateOwnedBySharedConstructionCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	a.assertStateOwnedBySharedCode(t, "proof-slice memoization state", stateProof)
+}
+
+func TestF2PCycleTrackingStateOwnedBySharedConstructionCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	a.assertStateOwnedBySharedCode(t, "in-progress cycle-tracking state", stateBool)
+}
+
+func TestF2PRuleIDMemoStateOwnedBySharedConstructionCode(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	a.assertStateOwnedBySharedCode(t, "rule-identifier memoization state", stateString)
+}
+
+func TestF2PConstructionStateDeclaredBySingleComponentType(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	types := a.stateTypes()
+	var full []string
+	for typ, kinds := range types {
+		if kinds[stateProof] && kinds[stateBool] && kinds[stateString] {
+			full = append(full, typ)
+		}
+	}
+	sort.Strings(full)
+	if len(full) != 1 {
+		t.Errorf("proof memoization, cycle tracking and rule-identifier memoization must be owned by one construction type; found %d such types: %v",
+			len(full), full)
+		return
+	}
+	owner := full[0]
+	var private []*fnInfo
+	for _, acc := range a.stateAccessAll() {
+		if compositionContains(a.compositionEdges(), owner, acc.typ, map[string]bool{}) && !a.shared(acc.fn) {
+			private = append(private, acc.fn)
+		}
+	}
+	if len(private) > 0 {
+		t.Errorf("construction type %s owns proof-memo, cycle and rule-ID state but its state is accessed by entry-private code:\n  %s",
+			owner, a.locations(private))
+	}
+}
+
+func TestF2PPostHocPremiseResolutionDoesNotOwnConstruction(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	storeRefs := a.referencesStore()
+	if len(storeRefs) == 0 {
+		t.Errorf("no code in the %s construction path queries the fact store; the post-hoc premise source is missing", entryPostHoc)
+		return
+	}
+	var owners []*fnInfo
+	for _, f := range a.region {
+		if a.attrE[f.key] && !a.attrR[f.key] && a.isConstructionOwner(f) {
+			owners = append(owners, f)
+		}
+	}
