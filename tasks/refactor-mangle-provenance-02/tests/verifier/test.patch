+// TestP2PCycleTerminationBothModes pins that cyclic derivations terminate in
+// both modes. A goal currently under proof contributes no proof on that
+// branch; the recording mode retains its existing partial fallback shape.
+func TestP2PCycleTerminationBothModes(t *testing.T) {
+	source := `
+		base(1).
+		p(X) :- base(X).
+		p(X) :- q(X).
+		q(X) :- p(X).
+	`
+	rec := provenance.NewMemoryRecorder()
+	pi, store := p2pEvalProgram(t, source, rec)
+
+	simple, err := provenance.Explain(pi, store, p2pAtom(t, "p(1)"), provenance.Options{MaxProofs: 5})
+	if err != nil {
+		t.Fatalf("Explain: %v", err)
+	}
+	if len(simple) == 0 {
+		t.Fatalf("post-hoc: expected at least the base-case proof")
+	}
+	full, err := provenance.BuildFromRecording(rec, store, p2pAtom(t, "p(1)"), provenance.Options{MaxProofs: 5})
+	if err != nil {
+		t.Fatalf("BuildFromRecording: %v", err)
+	}
+	if len(full) == 0 {
+		t.Fatalf("recording: expected at least the base-case proof")
+	}
+	if len(simple) != 1 || len(full) != 2 {
+		t.Errorf("cycle pruning: simple roots=%d recording roots=%d; want 1 and 2 (including the replay fallback)", len(simple), len(full))
+	}
+	p2pAssertFrozenOutput(t, "cycle/false", simple)
+	p2pAssertFrozenOutput(t, "cycle/true", full)
+	if !p2pIDSet(full)[simple[0].ID] {
+		t.Errorf("base-case proof id %s (post-hoc) is missing from the recording-mode proofs", simple[0].ID)
+	}
+}
