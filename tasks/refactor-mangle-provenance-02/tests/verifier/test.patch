+// These fingerprints were captured from the task's frozen baseline, using
+// only exported APIs. Keep the readable shape assertions as well: a digest
+// mismatch must not be mistaken for a compiler or collection failure.
+func p2pOutputFingerprint(t *testing.T, proofs []*provenance.ProofNode) string {
+	t.Helper()
+	var kinds []string
+	p2pWalk(proofs, func(n *provenance.ProofNode) {
+		kinds = append(kinds, fmt.Sprintf("%s|%d|%t|%s", n.Fact.String(), n.Kind, n.Partial, n.ID))
+	})
+	value := strings.Join(kinds, "\n") + "\nTREE\n" + p2pPrintOutput(t, proofs) + "\nFACTS\n" + p2pFactsDump(t, proofs)
+	return fmt.Sprintf("%x", sha256.Sum256([]byte(value)))
+}
