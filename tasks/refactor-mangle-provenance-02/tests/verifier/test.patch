+func p2pFrozenOutputCases(t *testing.T) map[string][]*provenance.ProofNode {
+	t.Helper()
+	cases := map[string][]*provenance.ProofNode{}
+	rec := provenance.NewMemoryRecorder()
+	pi, store := p2pEvalProgram(t, "a(1). b(1). blocked(2). foo(X) :- a(X), b(X), !blocked(X).", rec)
+	for _, recording := range []bool{false, true} {
+		var proofs []*provenance.ProofNode
+		var err error
+		if recording {
+			proofs, err = provenance.BuildFromRecording(rec, store, p2pAtom(t, "foo(1)"), provenance.Options{})
+		} else {
+			proofs, err = provenance.Explain(pi, store, p2pAtom(t, "foo(1)"), provenance.Options{})
+		}
+		if err != nil || len(proofs) != 1 {
+			t.Fatalf("ordinary output: proofs=%d error=%v", len(proofs), err)
+		}
+		// The repeated root exercises shared-subproof references as well as
+		// zero-based indices 0,1,2 and absence leaves in the fact schema.
+		cases[fmt.Sprintf("output/ordinary/%t", recording)] = append(proofs, proofs[0])
+		cases[fmt.Sprintf("output/partial/%t", recording)] = p2pDeepProofs(t, recording, 1)
+	}
+	for _, input := range []struct{ label, source, goal string }{
+		{"let", "measurement(1,10). scaled(ID,V) :- measurement(ID,Raw) |> let V = fn:mult(Raw,2).", "scaled(1,20)"},
+		{"aggregate", `sale("apple",3). sale("apple",5). totals(Product,Sum) :- sale(Product,N) |> do fn:group_by(Product), let Sum = fn:sum(N).`, `totals("apple",8)`},
+	} {
+		rec := provenance.NewMemoryRecorder()
+		_, store := p2pEvalProgram(t, input.source, rec)
+		proofs, err := provenance.BuildFromRecording(rec, store, p2pAtom(t, input.goal), provenance.Options{})
+		if err != nil || len(proofs) != 1 {
+			t.Fatalf("%s output: proofs=%d error=%v", input.label, len(proofs), err)
+		}
+		cases["output/"+input.label] = proofs
+	}
+	return cases
+}
+
+var p2pFrozenOutputs = map[string]string{
