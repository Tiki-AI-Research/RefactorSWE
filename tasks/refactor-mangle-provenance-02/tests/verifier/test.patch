+func p2pDeepProofs(t *testing.T, recording bool, limit int) []*provenance.ProofNode {
+	t.Helper()
+	var source strings.Builder
+	source.WriteString("step0(1).\n")
+	for i := 1; i <= 70; i++ {
+		fmt.Fprintf(&source, "step%d(X) :- step%d(X).\n", i, i-1)
+	}
+	rec := provenance.NewMemoryRecorder()
+	pi, store := p2pEvalProgram(t, source.String(), rec)
+	goal := p2pAtom(t, "step70(1)")
+	opts := provenance.Options{MaxDepth: limit}
+	var proofs []*provenance.ProofNode
+	var err error
+	if recording {
+		proofs, err = provenance.BuildFromRecording(rec, store, goal, opts)
+	} else {
+		proofs, err = provenance.Explain(pi, store, goal, opts)
+	}
+	if err != nil || len(proofs) != 1 {
+		t.Fatalf("depth %d recording=%t: proofs=%d error=%v", limit, recording, len(proofs), err)
+	}
+	return proofs
+}
+
+func p2pCheckExactDepth(t *testing.T, recording bool) {
+	t.Helper()
+	for _, limit := range []int{0, 1, 2, 64, 65, 70} {
+		t.Run(fmt.Sprintf("exact-depth-%t-%d", recording, limit), func(t *testing.T) {
+			proofs := p2pDeepProofs(t, recording, limit)
+			effective := limit
+			if effective == 0 {
+				effective = 64
+			}
+			terminalDepth := effective + 1
+			truncated := terminalDepth < 70
+			if !truncated {
+				terminalDepth = 70
+			}
+			n := proofs[0]
+			for depth := 0; depth <= terminalDepth; depth++ {
+				if n == nil {
+					t.Fatalf("missing node at depth %d", depth)
+				}
+				wantFact := fmt.Sprintf("step%d(1)", 70-depth)
+				// Simple mode propagates Partial to ancestors; replay keeps
+				// the original per-node flag, including only the cutoff leaf
+				// for this chain. This refactor must preserve both contracts.
+				wantPartial := truncated && (!recording || depth == terminalDepth)
+				if n.Fact.String() != wantFact || n.Partial != wantPartial {
+					t.Fatalf("depth %d: fact=%s partial=%t; want %s partial=%t", depth, n.Fact, n.Partial, wantFact, wantPartial)
+				}
+				if depth == terminalDepth {
+					if len(n.Premises) != 0 || n.Kind != provenance.KindEDB || n.Rule != nil || n.RuleID != "" {
+						t.Fatal("cutoff/EDB leaf has unexpected construction fields")
+					}
+					if strings.HasPrefix(n.ID, "/proof/partial/") != truncated {
+						t.Fatalf("terminal ID=%q partial=%t", n.ID, truncated)
+					}
+				} else {
+					if n.Kind != provenance.KindDerived || n.Rule == nil || n.RuleID == "" || len(n.Premises) != 1 {
+						t.Fatalf("depth %d must remain a single-premise derived node", depth)
+					}
+					n = n.Premises[0]
+				}
+			}
+			p2pAssertFrozenOutput(t, fmt.Sprintf("depth/%t/%d", recording, limit), proofs)
+		})
+	}
+}
