+func p2pAssertFrozenOutput(t *testing.T, label string, proofs []*provenance.ProofNode) {
+	t.Helper()
+	want, ok := p2pFrozenOutputs[label]
+	if !ok {
+		t.Fatalf("missing frozen baseline fixture for %s", label)
+	}
+	if got := p2pOutputFingerprint(t, proofs); got != want {
+		t.Errorf("%s: proof fields, tree or fact records changed: fingerprint %s, want %s", label, got, want)
+	}
+}
