@@ -0,0 +1,559 @@
+// Command p2p_runner executes the declared P2P regression nodes of the
+// provenance package and writes a JUnit XML report.
+//
+// It is intentionally self-contained: it shells out to the Go toolchain that
+// is already required to build this module, reads no selection manifest other
+// than the pipeline-provided {p2p_select} file (when present), and produces
+// the report at the caller-provided path.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+// manifest lists the exact leaf selectors of every collected P2P node:
+// the original provenance tests (restored from the baseline) and the
+// supplemental regression tests added by the P2P owner.
+var manifest = []string{
+	// --- original: provenance/provenance_test.go ---
+	"provenance/provenance_test.go::TestExplainSimpleDerivation",
+	"provenance/provenance_test.go::TestExplainNoProof",
+	"provenance/provenance_test.go::TestExplainNonGroundGoal",
+	"provenance/provenance_test.go::TestExplainMultipleDerivations",
+	"provenance/provenance_test.go::TestExplainRecursiveClosure",
+	"provenance/provenance_test.go::TestExplainCycleDetection",
+	"provenance/provenance_test.go::TestContentHashDeterminism",
+	"provenance/provenance_test.go::TestSharedSubProofID",
+	"provenance/provenance_test.go::TestEmitFactsSchema",
+	"provenance/provenance_test.go::TestEmitFactsAtomEncoding",
+	"provenance/provenance_test.go::TestPrintOutput",
+	"provenance/provenance_test.go::TestMaxProofs",
+	"provenance/provenance_test.go::TestExplainStratifiedNegation",
+	"provenance/provenance_test.go::TestEmitFactsAbsenceLeaf",
+	"provenance/provenance_test.go::TestExplainShowcase",
+	// --- original: provenance/recorder_test.go ---
+	"provenance/recorder_test.go::TestFullModeMatchesSimpleOnDatalog",
+	"provenance/recorder_test.go::TestFullExplainLetTransform",
+	"provenance/recorder_test.go::TestFullExplainAggregation",
+	"provenance/recorder_test.go::TestFullEmitFactsSchema",
+	"provenance/recorder_test.go::TestFullPrintAggregation",
+	// --- supplemental: provenance/p2p_regression_test.go ---
+	"provenance/p2p_regression_test.go::TestP2PExplainEDBLeafShape",
+	"provenance/p2p_regression_test.go::TestP2PExplainDefaultsAndCaps",
+	"provenance/p2p_regression_test.go::TestP2PExplainDepthPartial",
+	"provenance/p2p_regression_test.go::TestP2PRecordingDepthPartial",
+	"provenance/p2p_regression_test.go::TestP2PRecordingErrorsAndDefaults",
+	"provenance/p2p_regression_test.go::TestP2PRecordingAlternativesAndCaps",
+	"provenance/p2p_regression_test.go::TestP2PRecordingAbsenceLeaf",
+	"provenance/p2p_regression_test.go::TestP2PCrossModeIdenticalIDs",
+	"provenance/p2p_regression_test.go::TestP2PExplainSkipsTransforms",
+	"provenance/p2p_regression_test.go::TestP2PSharedSubProofCollapse",
+	"provenance/p2p_regression_test.go::TestP2PMemoizationIsolationAcrossCalls",
+	"provenance/p2p_regression_test.go::TestP2PCycleTerminationBothModes",
+	"provenance/p2p_regression_test.go::TestP2PModeOutputsMatchForDeterministicProgram",
+	"provenance/p2p_regression_test.go::TestP2PEmitFactsSharedSubProofReference",
+	"provenance/p2p_regression_test.go::TestP2PPinnedContentAddressedIdentifiers",
+	"provenance/p2p_regression_test.go::TestP2PExportedContractPins",
+	"provenance/p2p_regression_test.go::TestP2PRecorderEngineIntegration",
+	// --- supplemental: cmd/mgwhy/mgwhy_p2p_test.go ---
+	"cmd/mgwhy/mgwhy_p2p_test.go::TestP2PCLIModeFlagSelectsBuilderAndFormats",
+}
+
+type sel struct {
+	selector string
+	path     string
+	leaf     string
+}
+
+func parseSelector(s string) (sel, error) {
+	i := strings.Index(s, "::")
+	if i <= 0 || i+2 >= len(s) {
+		return sel{}, fmt.Errorf("not a path::leaf selector: %q", s)
+	}
+	p, l := s[:i], s[i+2:]
+	if p == "" || l == "" || strings.Contains(l, "::") {
+		return sel{}, fmt.Errorf("not a path::leaf selector: %q", s)
+	}
+	return sel{selector: s, path: p, leaf: l}, nil
+}
+
+// nodeResult is the outcome of one declared selector.
+type nodeResult struct {
+	sel     sel
+	result  string // pass|fail|skip|error
+	message string
+	typ     string
+	body    string
+	elapsed float64
+}
+
+type testResult struct {
+	action  string
+	elapsed float64
+	output  []string
+}
+
+type junitTestSuites struct {
+	XMLName  xml.Name         `xml:"testsuites"`
+	Name     string           `xml:"name,attr"`
+	Tests    int              `xml:"tests,attr"`
+	Failures int              `xml:"failures,attr"`
+	Errors   int              `xml:"errors,attr"`
+	Skipped  int              `xml:"skipped,attr"`
+	Time     string           `xml:"time,attr"`
+	Suites   []junitTestSuite `xml:"testsuite"`
+}
+
+type junitTestSuite struct {
+	Name      string          `xml:"name,attr"`
+	Tests     int             `xml:"tests,attr"`
+	Failures  int             `xml:"failures,attr"`
+	Errors    int             `xml:"errors,attr"`
+	Skipped   int             `xml:"skipped,attr"`
+	Time      string          `xml:"time,attr"`
+	TestCases []junitTestCase `xml:"testcase"`
+}
+
+type junitTestCase struct {
+	Classname string        `xml:"classname,attr"`
+	Name      string        `xml:"name,attr"`
+	File      string        `xml:"file,attr"`
+	Time      string        `xml:"time,attr"`
+	Failure   *junitMessage `xml:"failure,omitempty"`
+	Error     *junitMessage `xml:"error,omitempty"`
+	Skipped   *junitMessage `xml:"skipped,omitempty"`
+}
+
+type junitMessage struct {
+	Message string `xml:"message,attr"`
+	Type    string `xml:"type,attr"`
+	Body    string `xml:",chardata"`
+}
+
+func main() {
+	var (
+		reportPath = flag.String("report", "", "path of the JUnit XML report to write (required)")
+		selectPath = flag.String("select", "", "optional pipeline-provided p2p_select file listing path::leaf selectors")
+		one        = flag.String("selector", "", "optional single path::leaf selector to execute (node mode)")
+		rootFlag   = flag.String("root", "", "optional module root")
+		deadline   = flag.Duration("deadline", 240*time.Second, "internal deadline for the go test invocation")
+	)
+	flag.Parse()
+	if *reportPath == "" {
+		fmt.Fprintln(os.Stderr, "p2p_runner: -report is required")
+		os.Exit(2)
+	}
+
+	root, err := findModuleRoot(*rootFlag)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "p2p_runner: %v\n", err)
+		os.Exit(2)
+	}
+
+	selByKey := map[string]sel{}
+	for _, s := range manifest {
+		parsed, err := parseSelector(s)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "p2p_runner: bad manifest entry: %v\n", err)
+			os.Exit(2)
+		}
+		selByKey[parsed.selector] = parsed
+	}
+
+	wanted := make([]string, 0, len(manifest))
+	seen := map[string]bool{}
+	add := func(s string) {
+		if _, ok := selByKey[s]; !ok {
+			fmt.Fprintf(os.Stderr, "p2p_runner: ignoring selector not in the declared node set: %q\n", s)
+			return
+		}
+		if seen[s] {
+			return
+		}
+		seen[s] = true
+		wanted = append(wanted, s)
+	}
+	if *one != "" {
+		add(*one)
+	} else {
+		for _, s := range manifest {
+			add(s)
+		}
+		if *selectPath != "" {
+			if data, err := os.ReadFile(*selectPath); err == nil {
+				for _, line := range strings.Split(string(data), "\n") {
+					line = strings.TrimSpace(line)
+					if line == "" || strings.HasPrefix(line, "#") {
+						continue
+					}
+					add(line)
+				}
+			} else {
+				fmt.Fprintf(os.Stderr, "p2p_runner: p2p_select %q not readable (%v); continuing with the declared node set\n", *selectPath, err)
+			}
+		}
+	}
+	sort.Strings(wanted)
+
+	selectors := make([]sel, 0, len(wanted))
+	for _, s := range wanted {
+		selectors = append(selectors, selByKey[s])
+	}
+
+	// Verify each declared node is actually collectable in its file.
+	pkgDirs := map[string]bool{}
+	missing := map[string]string{}
+	for _, s := range selectors {
+		full := filepath.Join(root, filepath.FromSlash(s.path))
+		data, err := os.ReadFile(full)
+		if err != nil {
+			missing[s.selector] = fmt.Sprintf("test file %s not readable: %v", s.path, err)
+			continue
+		}
+		if !regexp.MustCompile(`(?m)^func ` + regexp.QuoteMeta(s.leaf) + `\(`).Match(data) {
+			missing[s.selector] = fmt.Sprintf("leaf %s not found in %s", s.leaf, s.path)
+			continue
+		}
+		pkgDirs[filepath.Dir(s.path)] = true
+	}
+
+	pkgs := make([]string, 0, len(pkgDirs))
+	for d := range pkgDirs {
+		pkgs = append(pkgs, "./"+filepath.ToSlash(d))
+	}
+	sort.Strings(pkgs)
+
+	var leaves []string
+	for _, s := range selectors {
+		leaves = append(leaves, regexp.QuoteMeta(s.leaf))
+	}
+
+	results := map[string]testResult{}
+	pkgOutput := map[string][]string{}
+	buildOutput := map[string][]string{}
+	buildFailed := map[string]bool{}
+	runnerErr := ""
+	testStderr := ""
+	if len(pkgs) == 0 {
+		runnerErr = "no collectable test package found"
+	} else {
+		ctx, cancel := context.WithTimeout(context.Background(), *deadline)
+		defer cancel()
+		args := []string{"test", "-json", "-count=1", "-v", "-run", "^(" + strings.Join(leaves, "|") + ")$"}
+		args = append(args, pkgs...)
+		cmd := exec.CommandContext(ctx, "go", args...)
+		cmd.Dir = root
+		cmd.Env = buildEnv(root)
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			runnerErr = fmt.Sprintf("stdout pipe: %v", err)
+		} else {
+			var stderr strings.Builder
+			cmd.Stderr = &stderr
+			if err := cmd.Start(); err != nil {
+				runnerErr = fmt.Sprintf("start go test: %v", err)
+			} else {
+				dec := json.NewDecoder(stdout)
+				for {
+					var ev struct {
+						Action      string  `json:"Action"`
+						Package     string  `json:"Package"`
+						ImportPath  string  `json:"ImportPath"`
+						Test        string  `json:"Test"`
+						Output      string  `json:"Output"`
+						Elapsed     float64 `json:"Elapsed"`
+						FailedBuild string  `json:"FailedBuild"`
+					}
+					if err := dec.Decode(&ev); err != nil {
+						break
+					}
+					switch ev.Action {
+					case "build-output":
+						base := ev.ImportPath
+						if i := strings.Index(base, " ["); i >= 0 {
+							base = base[:i]
+						}
+						buildOutput[base] = append(buildOutput[base], ev.Output)
+					case "build-fail":
+						base := ev.ImportPath
+						if i := strings.Index(base, " ["); i >= 0 {
+							base = base[:i]
+						}
+						buildFailed[base] = true
+					case "output":
+						if ev.Test == "" {
+							pkgOutput[ev.Package] = append(pkgOutput[ev.Package], ev.Output)
+						} else {
+							key := ev.Package + "|" + ev.Test
+							r := results[key]
+							r.output = append(r.output, ev.Output)
+							results[key] = r
+						}
+					case "pass", "fail", "skip":
+						if ev.Test == "" {
+							if ev.Action == "fail" && ev.FailedBuild != "" {
+								base := ev.FailedBuild
+								if i := strings.Index(base, " ["); i >= 0 {
+									base = base[:i]
+								}
+								buildFailed[base] = true
+							}
+							continue
+						}
+						key := ev.Package + "|" + ev.Test
+						r := results[key]
+						r.action = ev.Action
+						r.elapsed = ev.Elapsed
+						results[key] = r
+					}
+				}
+				waitErr := cmd.Wait()
+				if ctx.Err() == context.DeadlineExceeded {
+					runnerErr = fmt.Sprintf("go test exceeded the internal deadline of %s", deadline.String())
+				} else if waitErr != nil && len(results) == 0 && len(pkgOutput) == 0 {
+					runnerErr = fmt.Sprintf("go test failed to produce any output: %v; stderr: %s", waitErr, strings.TrimSpace(stderr.String()))
+				}
+				testStderr = strings.TrimSpace(stderr.String())
+			}
+		}
+	}
+
+	nodes := make([]nodeResult, 0, len(selectors))
+	for _, s := range selectors {
+		n := nodeResult{sel: s}
+		if msg, ok := missing[s.selector]; ok {
+			n.result = "error"
+			n.typ = "not_collected"
+			n.message = "selector not collected"
+			n.body = msg
+			nodes = append(nodes, n)
+			continue
+		}
+		pkg := pkgPath(root, s.path)
+		r, ok := results[pkg+"|"+s.leaf]
+		switch {
+		case !ok:
+			n.result = "error"
+			switch {
+			case buildFailed[pkg] || strings.Contains(strings.Join(pkgOutput[pkg], ""), "build failed"):
+				n.typ = "build_error"
+				n.message = "package failed to build"
+				n.body = strings.Join(buildOutput[pkg], "") + strings.Join(pkgOutput[pkg], "")
+			case runnerErr != "":
+				n.typ = "not_run"
+				n.message = "selector did not run"
+				n.body = runnerErr
+			default:
+				n.typ = "not_run"
+				n.message = "selector did not run"
+				n.body = "no test event observed for this selector"
+				if extra := strings.Join(pkgOutput[pkg], ""); extra != "" {
+					n.body += "; package output: " + strings.TrimSpace(extra)
+				} else if testStderr != "" {
+					n.body += "; go test stderr: " + testStderr
+				}
+			}
+		case r.action == "pass":
+			n.result = "pass"
+			n.elapsed = r.elapsed
+		case r.action == "skip":
+			n.result = "skip"
+			n.body = strings.Join(r.output, "")
+		default:
+			n.result = "fail"
+			n.typ = "assertion"
+			n.message = "test failed"
+			body := strings.Join(r.output, "")
+			if strings.Contains(body, "panic:") {
+				n.typ = "panic"
+				n.message = "test panicked"
+			}
+			n.body = body
+			n.elapsed = r.elapsed
+		}
+		nodes = append(nodes, n)
+	}
+
+	suites := buildSuites(nodes)
+
+	out := junitTestSuites{Name: "p2p", Suites: suites}
+	for _, s := range suites {
+		out.Tests += s.Tests
+		out.Failures += s.Failures
+		out.Errors += s.Errors
+		out.Skipped += s.Skipped
+	}
+	out.Time = fmt.Sprintf("%.3f", maxSuiteTime(suites))
+
+	if err := writeReport(*reportPath, out); err != nil {
+		fmt.Fprintf(os.Stderr, "p2p_runner: write report: %v\n", err)
+		os.Exit(2)
+	}
+
+	failed := out.Failures + out.Errors
+	fmt.Printf("p2p_runner: %d nodes, %d failures, %d errors, %d skipped (report: %s)\n",
+		out.Tests, out.Failures, out.Errors, out.Skipped, *reportPath)
+	if runnerErr != "" {
+		fmt.Fprintf(os.Stderr, "p2p_runner: %s\n", runnerErr)
+	}
+	if failed > 0 {
+		os.Exit(1)
+	}
+}
+
+func buildSuites(nodes []nodeResult) []junitTestSuite {
+	byPkg := map[string][]int{}
+	var order []string
+	for i, n := range nodes {
+		pkg := filepath.Dir(n.sel.path)
+		if _, ok := byPkg[pkg]; !ok {
+			order = append(order, pkg)
+		}
+		byPkg[pkg] = append(byPkg[pkg], i)
+	}
+	sort.Strings(order)
+	suites := make([]junitTestSuite, 0, len(order))
+	for _, pkg := range order {
+		suite := junitTestSuite{Name: "codeberg.org/TauCeti/mangle-go/" + filepath.ToSlash(pkg)}
+		var total float64
+		for _, i := range byPkg[pkg] {
+			n := nodes[i]
+			tc := junitTestCase{
+				Classname: n.sel.path,
+				Name:      n.sel.leaf,
+				File:      n.sel.path,
+				Time:      fmt.Sprintf("%.3f", n.elapsed),
+			}
+			switch n.result {
+			case "pass":
+				suite.Tests++
+			case "skip":
+				suite.Tests++
+				suite.Skipped++
+				tc.Skipped = &junitMessage{Message: "skipped", Type: "skip", Body: n.body}
+			case "fail":
+				suite.Tests++
+				suite.Failures++
+				tc.Failure = &junitMessage{Message: n.message, Type: n.typ, Body: n.body}
+			default:
+				suite.Tests++
+				suite.Errors++
+				tc.Error = &junitMessage{Message: n.message, Type: n.typ, Body: n.body}
+			}
+			suite.TestCases = append(suite.TestCases, tc)
+			total += n.elapsed
+		}
+		suite.Time = fmt.Sprintf("%.3f", total)
+		suites = append(suites, suite)
+	}
+	return suites
+}
+
+func maxSuiteTime(suites []junitTestSuite) float64 {
+	var max float64
+	for _, s := range suites {
+		var t float64
+		if _, err := fmt.Sscanf(s.Time, "%f", &t); err == nil && t > max {
+			max = t
+		}
+	}
+	return max
+}
+
+func pkgPath(root, relPath string) string {
+	dir := filepath.ToSlash(filepath.Dir(relPath))
+	return "codeberg.org/TauCeti/mangle-go/" + dir
+}
+
+func writeReport(path string, suites junitTestSuites) error {
+	if dir := filepath.Dir(path); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			return err
+		}
+	}
+	data, err := xml.MarshalIndent(suites, "", "  ")
+	if err != nil {
+		return err
+	}
+	out := append([]byte(xml.Header), data...)
+	out = append(out, '\n')
+	return os.WriteFile(path, out, 0o644)
+}
+
+// buildEnv returns the environment for the go test invocation. It keeps the
+// image-provided toolchain, module cache and build cache, falls back to a
+// temporary build cache when the inherited one is not usable, and disables
+// any network or toolchain download so replay stays offline.
+func buildEnv(root string) []string {
+	env := os.Environ()
+	cache := os.Getenv("GOCACHE")
+	if cache == "" {
+		if home, err := os.UserHomeDir(); err == nil && home != "" {
+			cache = filepath.Join(home, ".cache", "go-build")
+		}
+	}
+	if cache == "" || !writableDir(cache) {
+		fallback := filepath.Join(os.TempDir(), "p2p-go-build-cache")
+		if err := os.MkdirAll(fallback, 0o755); err == nil {
+			cache = fallback
+		}
+	}
+	if cache != "" {
+		env = append(env, "GOCACHE="+cache)
+	}
+	env = append(env,
+		"GOPROXY=off",
+		"GOTOOLCHAIN=local",
+		"GOFLAGS=-mod=readonly",
+	)
+	return env
+}
+
+func writableDir(dir string) bool {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return false
+	}
+	f, err := os.CreateTemp(dir, ".p2p-write-probe-*")
+	if err != nil {
+		return false
+	}
+	name := f.Name()
+	_ = f.Close()
+	_ = os.Remove(name)
+	return true
+}
+
+func findModuleRoot(override string) (string, error) {
+	candidates := []string{}
+	if override != "" {
+		candidates = append(candidates, override)
+	}
+	if wd, err := os.Getwd(); err == nil {
+		candidates = append(candidates, wd)
+	}
+	for _, start := range candidates {
+		dir := start
+		for {
+			if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+				return dir, nil
+			}
+			parent := filepath.Dir(dir)
+			if parent == dir {
+				break
+			}
+			dir = parent
+		}
+	}
+	return "", fmt.Errorf("could not locate the module root (go.mod) from %v", candidates)
+}
