+func TestF2PRecordingPremiseResolutionDoesNotOwnConstruction(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	recRefs := a.referencesRecorder()
+	if len(recRefs) == 0 {
+		t.Errorf("no code in the %s construction path replays recorder events; the recording premise source is missing", entryRecording)
+		return
+	}
+	var owners []*fnInfo
+	for _, f := range a.region {
+		if a.attrR[f.key] && !a.attrE[f.key] && a.isConstructionOwner(f) {
+			owners = append(owners, f)
+		}
+	}
+	if len(owners) > 0 {
+		t.Errorf("recorded-event premise replay also implements shared construction responsibilities instead of only supplying premises:\n  %s",
+			a.locations(owners))
+	}
+}
+
+// producerLinkedToType reports whether the proof producer is part of the
+// component type: it is a method of that type, takes it as a parameter, or
+// constructs/uses a value of it in its own body.
+func (a *constructionAnalysis) producerLinkedToType(f *fnInfo, typ string) bool {
+	if f.recv == typ {
+		return true
+	}
+	for _, p := range f.params {
+		if strings.TrimPrefix(f.pkg.resolve(p), "*") == typ {
+			return true
+		}
+	}
+	linked := a.m.instantiatedStructs(map[string]bool{f.key: true})
+	return linked[typ]
+}
+
+func TestF2PConstructionStateOwnedByProofProducingComponent(t *testing.T) {
+	a := newConstructionAnalysis(t)
+	postFrontier := a.frontier(a.post)
+	recFrontier := a.frontier(a.rec)
+	var common []string
+	for k := range postFrontier {
+		if recFrontier[k] {
+			common = append(common, k)
+		}
+	}
+	sort.Strings(common)
+	if len(common) == 0 {
+		t.Errorf("%s and %s do not share a proof-producing function, so no component can own the construction state", entryPostHoc, entryRecording)
+		return
+	}
+	types := a.stateTypes()
+	var full []string
+	for typ, kinds := range types {
+		if kinds[stateProof] && kinds[stateBool] && kinds[stateString] {
+			full = append(full, typ)
+		}
+	}
+	if len(full) != 1 {
+		t.Errorf("expected one construction type owning proof-memo, cycle and rule-ID state; found %v", full)
+		return
+	}
+	owner := full[0]
+	var mismatched []string
+	for _, k := range common {
+		f := a.byKey[k]
+		if f == nil {
+			mismatched = append(mismatched, k+" (unknown)")
+			continue
+		}
+		if !a.producerLinkedToType(f, owner) {
+			mismatched = append(mismatched, a.location(f))
+		}
+	}
+	if len(mismatched) > 0 {
+		t.Errorf("the shared proof producers %v are not linked to construction type %s, which owns the memoization, cycle-tracking and rule-ID state",
+			mismatched, owner)
+	}
+}
diff --git a/tests/f2p/model_test.go b/tests/f2p/model_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2edda53e768dbdcef38dbe936e7282cc04bff73b
--- /dev/null
+++ b/tests/f2p/model_test.go
@@ -0,0 +1,947 @@
+package f2p
+
+import (
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// This file builds an in-memory model of the Go sources of the mangle module
+// so the convergence tests can inspect, without depending on private symbol
+// names, which code produces the proof slices returned by the two public
+// provenance entry points and which code owns each construction
+// responsibility.
+
+const (
+	entryPostHoc   = "Explain"
+	entryRecording = "BuildFromRecording"
+)
+
+type callSite struct {
+	call    *ast.CallExpr
+	targets []string // resolved callee keys (empty when the callee is dynamic)
+	weak    bool     // resolution relied on interface/name fallback
+}
+
+type fnInfo struct {
+	key        string // "Name" for funcs, "Recv.Name" for methods (Recv without *)
+	name       string
+	recv       string
+	file       string
+	startLine  int
+	endLine    int
+	params     []string
+	paramNames []string
+	results    []string
+	decl       *ast.FuncDecl
+	astFile    *ast.File
+	pkg        *pkgModel
+
+	localTypes map[string]string
+	assigns    map[string][]ast.Expr
+	calls      []callSite
+}
+
+func (f *fnInfo) returnsProofSlice() bool {
+	if len(f.results) == 0 {
+		return false
+	}
+	return isProofSliceType(f.results[0])
+}
+
+func (f *fnInfo) returnsError() bool {
+	for _, r := range f.results {
+		if r == "error" {
+			return true
+		}
+	}
+	return false
+}
+
+type pkgModel struct {
+	dir      string
+	impPath  string
+	fset     *token.FileSet
+	files    []*ast.File
+	funcs    map[string]*fnInfo
+	structs  map[string]map[string]string // struct name -> field -> declared type
+	named    map[string]string            // named type -> underlying type string
+	embedded map[string][]string
+	bindings map[string][]string
+	ifaces   map[string][]string // interface name -> method names
+	imports  map[*ast.File]map[string]string
+}
+
+func (p *pkgModel) fn(key string) *fnInfo { return p.funcs[key] }
+
+// resolve expands named types to their underlying type spelling, recursively.
+// Package-qualified names and unknown identifiers are left untouched.
+func (p *pkgModel) resolve(t string) string {
+	seen := map[string]bool{}
+	for i := 0; i < 32; i++ {
+		t = strings.TrimSpace(t)
+		if t == "" {
+			return ""
+		}
+		if u, ok := p.named[t]; ok && !seen[t] && u != "" && u != "struct{}" && u != "interface{}" && u != "func" {
+			seen[t] = true
+			t = u
+			continue
+		}
+		switch {
+		case strings.HasPrefix(t, "*"):
+			return "*" + p.resolve(t[1:])
+		case strings.HasPrefix(t, "[]"):
+			return "[]" + p.resolve(t[2:])
+		case strings.HasPrefix(t, "map["):
+			k, v, ok := parseMapType(t)
+			if !ok {
+				return t
+			}
+			return "map[" + p.resolve(k) + "]" + p.resolve(v)
+		default:
+			return t
+		}
+	}
+	return t
+}
+
+type moduleModel struct {
+	root    string
+	modPath string
+	pkgs    map[string]*pkgModel // import path -> package
+	dirPath map[string]string    // absolute dir -> import path
+	loadErr error
+}
+
+var (
+	loadOnce sync.Once
+	cached   *moduleModel
+)
+
+func moduleSources(t *testing.T) *moduleModel {
+	t.Helper()
+	loadOnce.Do(func() { cached = mustLoadModule() })
+	if cached.loadErr != nil {
+		t.Fatalf("cannot load module sources: %v", cached.loadErr)
+	}
+	return cached
+}
+
+func mustLoadModule() *moduleModel {
+	_, thisFile, _, ok := runtime.Caller(0)
+	if !ok {
+		return &moduleModel{loadErr: fmt.Errorf("runtime.Caller failed")}
+	}
+	root, err := findModuleRoot(filepath.Dir(thisFile))
+	if err != nil {
+		return &moduleModel{loadErr: err}
+	}
+	modPath, err := readModulePath(root)
+	if err != nil {
+		return &moduleModel{loadErr: err}
+	}
+	m := &moduleModel{root: root, modPath: modPath, pkgs: map[string]*pkgModel{}, dirPath: map[string]string{}}
+	if err := m.scan(); err != nil {
+		return &moduleModel{loadErr: err}
+	}
+	for _, pkg := range m.pkgs {
+		for _, f := range pkg.funcs {
+			m.inferLocalTypes(f)
+		}
+	}
+	m.bindFunctionValues()
+	m.buildCallGraph()
+	return m
+}
+
+func findModuleRoot(start string) (string, error) {
+	dir := start
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir, nil
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "", fmt.Errorf("go.mod not found above %s", start)
+		}
+		dir = parent
+	}
+}
+
+func readModulePath(root string) (string, error) {
+	data, err := os.ReadFile(filepath.Join(root, "go.mod"))
+	if err != nil {
+		return "", err
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		line = strings.TrimSpace(line)
+		if strings.HasPrefix(line, "module ") {
+			return strings.TrimSpace(strings.TrimPrefix(line, "module ")), nil
+		}
+	}
+	return "", fmt.Errorf("module directive not found in go.mod")
+}
+
+func (m *moduleModel) scan() error {
+	fset := token.NewFileSet()
+	return filepath.WalkDir(m.root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return nil
+		}
+		name := d.Name()
+		if d.IsDir() {
+			if path == m.root {
+				return nil
+			}
+			if strings.HasPrefix(name, ".") || name == "vendor" || name == "testdata" || name == "node_modules" {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			return nil
+		}
+		rel, relErr := filepath.Rel(m.root, filepath.Dir(path))
+		if relErr != nil {
+			return nil
+		}
+		impPath := m.modPath
+		if rel != "." {
+			impPath = m.modPath + "/" + filepath.ToSlash(rel)
+		}
+		pkg := m.pkgs[impPath]
+		if pkg == nil {
+			pkg = &pkgModel{dir: filepath.Dir(path), impPath: impPath, fset: fset,
+				funcs: map[string]*fnInfo{}, structs: map[string]map[string]string{},
+				named: map[string]string{}, ifaces: map[string][]string{},
+				imports: map[*ast.File]map[string]string{}}
+			m.pkgs[impPath] = pkg
+			m.dirPath[pkg.dir] = impPath
+		}
+		f, parseErr := parser.ParseFile(fset, path, nil, 0)
+		if parseErr != nil {
+			return nil
+		}
+		pkg.files = append(pkg.files, f)
+		pkg.absorbFile(f)
+		return nil
+	})
+}
+
+func (p *pkgModel) absorbFile(f *ast.File) {
+	if p.embedded == nil {
+		p.embedded = map[string][]string{}
+		p.bindings = map[string][]string{}
+	}
+	imports := map[string]string{}
+	for _, spec := range f.Imports {
+		path := strings.Trim(spec.Path.Value, `"`)
+		alias := ""
+		if spec.Name != nil {
+			alias = spec.Name.Name
+		} else {
+			base := path
+			if i := strings.LastIndex(base, "/"); i >= 0 {
+				base = base[i+1:]
+			}
+			alias = base
+		}
+		imports[alias] = path
+	}
+	p.imports[f] = imports
+
+	for _, decl := range f.Decls {
+		switch d := decl.(type) {
+		case *ast.FuncDecl:
+			fi := &fnInfo{
+				name:       d.Name.Name,
+				decl:       d,
+				astFile:    f,
+				pkg:        p,
+				localTypes: map[string]string{},
+				assigns:    map[string][]ast.Expr{},
+				file:       p.fset.Position(d.Pos()).Filename,
+			}
+			fi.startLine = p.fset.Position(d.Pos()).Line
+			fi.endLine = p.fset.Position(d.End()).Line
+			if d.Recv != nil && len(d.Recv.List) > 0 {
+				name, _ := bareTypeName(d.Recv.List[0].Type)
+				fi.recv = name
+			}
+			if d.Type.Results != nil {
+				for _, r := range d.Type.Results.List {
+					n := len(r.Names)
+					if n == 0 {
+						n = 1
+					}
+					for i := 0; i < n; i++ {
+						fi.results = append(fi.results, typeString(r.Type))
+					}
+				}
+			}
+			if d.Type.Params != nil {
+				idx := 0
+				for _, prm := range d.Type.Params.List {
+					n := len(prm.Names)
+					if n == 0 {
+						n = 1
+					}
+					for i := 0; i < n; i++ {
+						fi.params = append(fi.params, typeString(prm.Type))
+						name := ""
+						if i < len(prm.Names) {
+							name = prm.Names[i].Name
+						}
+						fi.paramNames = append(fi.paramNames, name)
+						idx++
+					}
+				}
+			}
+			if fi.recv != "" {
+				fi.key = fi.recv + "." + fi.name
+			} else {
+				fi.key = fi.name
+			}
+			p.funcs[fi.key] = fi
+		case *ast.GenDecl:
+			for _, spec := range d.Specs {
+				ts, ok := spec.(*ast.TypeSpec)
+				if !ok {
+					continue
+				}
+				switch tt := ts.Type.(type) {
+				case *ast.StructType:
+					fields := map[string]string{}
+					for _, fl := range tt.Fields.List {
+						if len(fl.Names) == 0 {
+							if name, ok := bareTypeName(fl.Type); ok {
+								fields[name] = typeString(fl.Type)
+								p.embedded[ts.Name.Name] = append(p.embedded[ts.Name.Name], name)
+							}
+						}
+						for _, nm := range fl.Names {
+							fields[nm.Name] = typeString(fl.Type)
+						}
+					}
+					p.structs[ts.Name.Name] = fields
+					p.named[ts.Name.Name] = "struct{}"
+				case *ast.InterfaceType:
+					var ms []string
+					for _, mth := range tt.Methods.List {
+						if ft, ok := mth.Type.(*ast.FuncType); ok && ft != nil {
+							for _, nm := range mth.Names {
+								ms = append(ms, nm.Name)
+							}
+						}
+					}
+					p.ifaces[ts.Name.Name] = ms
+					p.named[ts.Name.Name] = "interface{}"
+				default:
+					p.named[ts.Name.Name] = typeString(ts.Type)
+				}
+			}
+		}
+	}
+}
+
+// typeString renders a type expression into a canonical, comparable string.
+func typeString(e ast.Expr) string {
+	switch t := e.(type) {
+	case *ast.Ident:
+		return t.Name
+	case *ast.StarExpr:
+		return "*" + typeString(t.X)
+	case *ast.SelectorExpr:
+		return typeString(t.X) + "." + t.Sel.Name
+	case *ast.ArrayType:
+		return "[]" + typeString(t.Elt)
+	case *ast.MapType:
+		return "map[" + typeString(t.Key) + "]" + typeString(t.Value)
+	case *ast.InterfaceType:
+		return "interface{}"
+	case *ast.StructType:
+		return "struct{}"
+	case *ast.FuncType:
+		return "func"
+	case *ast.ChanType:
+		return "chan " + typeString(t.Value)
+	case *ast.Ellipsis:
+		return "..." + typeString(t.Elt)
+	case *ast.IndexExpr:
+		return typeString(t.X)
+	case *ast.IndexListExpr:
+		return typeString(t.X)
+	case *ast.ParenExpr:
+		return typeString(t.X)
+	}
+	return "?"
+}
+
+func parseMapType(s string) (key, val string, ok bool) {
+	if !strings.HasPrefix(s, "map[") {
+		return "", "", false
+	}
+	depth := 0
+	for i := 4; i < len(s); i++ {
+		switch s[i] {
+		case '[':
+			depth++
+		case ']':
+			if depth == 0 {
+				return s[4:i], s[i+1:], true
+			}
+			depth--
+		}
+	}
+	return "", "", false
+}
+
+func elemType(s string) string {
+	if strings.HasPrefix(s, "[]") {
+		return strings.TrimPrefix(s, "[]")
+	}
+	return ""
+}
+
+func (m *moduleModel) inferLocalTypes(f *fnInfo) {
+	if f.decl.Body == nil {
+		return
+	}
+	if f.decl.Recv != nil && len(f.decl.Recv.List) > 0 && len(f.decl.Recv.List[0].Names) > 0 {
+		f.localTypes[f.decl.Recv.List[0].Names[0].Name] = typeString(f.decl.Recv.List[0].Type)
+	}
+	for i, name := range f.paramNames {
+		if name != "" && i < len(f.params) {
+			f.localTypes[name] = f.params[i]
+		}
+	}
+	for pass := 0; pass < 3; pass++ {
+		ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+			switch s := n.(type) {
+			case *ast.AssignStmt:
+				for i, lhs := range s.Lhs {
+					id, ok := lhs.(*ast.Ident)
+					if !ok || id.Name == "_" {
+						continue
+					}
+					switch {
+					case len(s.Lhs) == len(s.Rhs) && i < len(s.Rhs):
+						f.assigns[id.Name] = append(f.assigns[id.Name], s.Rhs[i])
+						if t := m.exprType(f, s.Rhs[i]); t != "" {
+							f.localTypes[id.Name] = t
+						}
+					case len(s.Rhs) == 1:
+						f.assigns[id.Name] = append(f.assigns[id.Name], s.Rhs[0])
+						if ts := m.callResultTypes(f, s.Rhs[0]); i < len(ts) && ts[i] != "" {
+							f.localTypes[id.Name] = ts[i]
+						}
+					}
+				}
+			case *ast.DeclStmt:
+				gd, ok := s.Decl.(*ast.GenDecl)
+				if !ok {
+					return true
+				}
+				for _, spec := range gd.Specs {
+					vs, ok := spec.(*ast.ValueSpec)
+					if !ok {
+						continue
+					}
+					for i, nm := range vs.Names {
+						if len(vs.Values) == len(vs.Names) && i < len(vs.Values) {
+							f.assigns[nm.Name] = append(f.assigns[nm.Name], vs.Values[i])
+						}
+						if vs.Type != nil {
+							f.localTypes[nm.Name] = typeString(vs.Type)
+						} else if len(vs.Values) == len(vs.Names) && i < len(vs.Values) {
+							if t := m.exprType(f, vs.Values[i]); t != "" {
+								f.localTypes[nm.Name] = t
+							}
+						}
+					}
+				}
+			case *ast.RangeStmt:
+				if s.Tok != token.DEFINE && s.Tok != token.ASSIGN {
+					return true
+				}
+				container := f.pkg.resolve(m.exprType(f, s.X))
+				if k, v, ok := parseMapType(container); ok {
+					if id, ok := s.Key.(*ast.Ident); ok && id.Name != "_" {
+						f.localTypes[id.Name] = k
+					}
+					if id, ok := s.Value.(*ast.Ident); ok && id.Name != "_" {
+						f.localTypes[id.Name] = v
+					}
+				} else if et := elemType(container); et != "" {
+					if id, ok := s.Value.(*ast.Ident); ok && id.Name != "_" {
+						f.localTypes[id.Name] = et
+					}
+				}
+			}
+			return true
+		})
+	}
+}
+
+func (m *moduleModel) callResultTypes(f *fnInfo, e ast.Expr) []string {
+	call, ok := e.(*ast.CallExpr)
+	if !ok {
+		return nil
+	}
+	if id, ok := call.Fun.(*ast.Ident); ok {
+		switch id.Name {
+		case "new":
+			if len(call.Args) > 0 {
+				return []string{"*" + typeString(call.Args[0])}
+			}
+			return nil
+		case "make":
+			if len(call.Args) > 0 {
+				return []string{typeString(call.Args[0])}
+			}
+			return nil
+		}
+	}
+	targets, weak := m.resolveCall(f, call)
+	if weak || len(targets) != 1 {
+		return nil
+	}
+	if g := f.pkg.funcs[targets[0]]; g != nil {
+		return g.results
+	}
+	return nil
+}
+
+func (m *moduleModel) exprType(f *fnInfo, e ast.Expr) string {
+	if e == nil {
+		return ""
+	}
+	switch t := e.(type) {
+	case *ast.Ident:
+		if v, ok := f.localTypes[t.Name]; ok {
+			return v
+		}
+		return ""
+	case *ast.ParenExpr:
+		return m.exprType(f, t.X)
+	case *ast.StarExpr:
+		return strings.TrimPrefix(m.exprType(f, t.X), "*")
+	case *ast.UnaryExpr:
+		inner := m.exprType(f, t.X)
+		if t.Op == token.AND {
+			return "*" + inner
+		}
+		return inner
+	case *ast.SelectorExpr:
+		base := strings.TrimPrefix(f.pkg.resolve(m.exprType(f, t.X)), "*")
+		if _, ft, ok := f.pkg.promotedField(base, t.Sel.Name, map[string]bool{}); ok {
+			return ft
+		}
+		return ""
+	case *ast.CompositeLit:
+		return typeString(t.Type)
+	case *ast.CallExpr:
+		if id, ok := uninstantiate(t.Fun).(*ast.Ident); ok {
+			switch id.Name {
+			case "make":
+				if len(t.Args) > 0 {
+					return typeString(t.Args[0])
+				}
+				return ""
+			case "new":
+				if len(t.Args) > 0 {
+					return "*" + typeString(t.Args[0])
+				}
+				return ""
+			case "append":
+				if len(t.Args) > 0 {
+					return m.exprType(f, t.Args[0])
+				}
+				return ""
+			}
+			if target, ok := f.pkg.funcs[id.Name]; ok && target.recv == "" && len(target.results) == 1 {
+				return target.results[0]
+			}
+			if _, ok := f.pkg.named[id.Name]; ok {
+				return id.Name
+			}
+			if _, ok := f.pkg.structs[id.Name]; ok {
+				return id.Name
+			}
+			return ""
+		}
+		if _, ok := uninstantiate(t.Fun).(*ast.SelectorExpr); ok {
+			if ts := m.callResultTypes(f, t); len(ts) == 1 {
+				return ts[0]
+			}
+		}
+		return ""
+	case *ast.IndexExpr:
+		base := f.pkg.resolve(m.exprType(f, t.X))
+		if _, v, ok := parseMapType(base); ok {
+			return v
+		}
+		if et := elemType(base); et != "" {
+			return et
+		}
+		return ""
+	case *ast.TypeAssertExpr:
+		return typeString(t.Type)
+	}
+	return ""
+}
+
+// resolveCall resolves a call expression to same-package function keys.
+// weak is true when the callee could not be pinned to a unique concrete
+// function (interface dispatch, func-typed field, unknown receiver), in which
+// case targets lists the candidate methods for reachability purposes but must
+// not be treated as proof of value flow.
+func (m *moduleModel) resolveCall(f *fnInfo, call *ast.CallExpr) (targets []string, weak bool) {
+	switch fun := uninstantiate(call.Fun).(type) {
+	case *ast.Ident:
+		if target, ok := f.pkg.funcs[fun.Name]; ok && target.recv == "" {
+			return []string{target.key}, false
+		}
+		return f.pkg.bindings["local:"+f.key+":"+fun.Name], true
+	case *ast.SelectorExpr:
+		if id, ok := fun.X.(*ast.Ident); ok {
+			if _, isImport := f.pkg.imports[f.astFile][id.Name]; isImport {
+				return nil, false
+			}
+		}
+		base := strings.TrimPrefix(f.pkg.resolve(m.exprType(f, fun.X)), "*")
+		if _, ok := f.pkg.structs[base]; ok {
+			if keys := f.pkg.promotedMethods(base, fun.Sel.Name, map[string]bool{}); len(keys) > 0 {
+				return keys, len(keys) != 1
+			}
+			owner, _, ok := f.pkg.promotedField(base, fun.Sel.Name, map[string]bool{})
+			if ok {
+				return f.pkg.bindings["field:"+owner+":"+fun.Sel.Name], true
+			}
+			return nil, true
+		}
+		if _, ok := f.pkg.ifaces[base]; ok {
+			return f.pkg.methodCandidates(fun.Sel.Name), true
+		}
+		return f.pkg.methodCandidates(fun.Sel.Name), true
+	}
+	return nil, true
+}
+
+func (p *pkgModel) methodCandidates(name string) []string {
+	var out []string
+	for key, cand := range p.funcs {
+		if cand.recv != "" && cand.name == name {
+			out = append(out, key)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func (m *moduleModel) buildCallGraph() {
+	for _, pkg := range m.pkgs {
+		for _, f := range pkg.funcs {
+			if f.decl.Body == nil {
+				continue
+			}
+			ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+				call, ok := n.(*ast.CallExpr)
+				if !ok {
+					return true
+				}
+				targets, weak := m.resolveCall(f, call)
+				f.calls = append(f.calls, callSite{call: call, targets: targets, weak: weak})
+				return true
+			})
+		}
+	}
+}
+
+// reach returns every function key reachable from f. With strongOnly set,
+// calls that could not be pinned to a concrete function are not traversed.
+func (m *moduleModel) reach(f *fnInfo, strongOnly bool) map[string]bool {
+	seen := map[string]bool{f.key: true}
+	queue := []*fnInfo{f}
+	for len(queue) > 0 {
+		cur := queue[0]
+		queue = queue[1:]
+		for _, cs := range cur.calls {
+			if strongOnly && cs.weak {
+				continue
+			}
+			for _, k := range cs.targets {
+				if seen[k] {
+					continue
+				}
+				seen[k] = true
+				if next := m.fnByKey(k); next != nil {
+					queue = append(queue, next)
+				}
+			}
+		}
+	}
+	return seen
+}
+
+func (m *moduleModel) fnByKey(key string) *fnInfo {
+	for _, pkg := range m.pkgs {
+		if f := pkg.funcs[key]; f != nil {
+			return f
+		}
+	}
+	return nil
+}
+
+// strongCallers maps a function key to the functions that call it through a
+// statically pinned (non-weak) call site.
+func (m *moduleModel) strongCallers() map[string][]string {
+	out := map[string][]string{}
+	for _, pkg := range m.pkgs {
+		for _, f := range pkg.funcs {
+			for _, cs := range f.calls {
+				if cs.weak {
+					continue
+				}
+				for _, k := range cs.targets {
+					out[k] = append(out[k], f.key)
+				}
+			}
+		}
+	}
+	for k := range out {
+		sort.Strings(out[k])
+		out[k] = dedupeSorted(out[k])
+	}
+	return out
+}
+
+// instantiatedStructs returns the struct type names constructed with a
+// composite literal or new() anywhere in the bodies of the given functions.
+// Nested function literals are included because they are part of the
+// enclosing declaration's construction path.
+func (m *moduleModel) instantiatedStructs(funcs map[string]bool) map[string]bool {
+	out := map[string]bool{}
+	for key := range funcs {
+		f := m.fnByKey(key)
+		if f == nil || f.decl.Body == nil {
+			continue
+		}
+		ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+			switch t := n.(type) {
+			case *ast.CompositeLit:
+				if name, ok := bareTypeName(t.Type); ok {
+					if _, isStruct := f.pkg.structs[name]; isStruct {
+						out[name] = true
+					}
+				}
+			case *ast.CallExpr:
+				if id, ok := t.Fun.(*ast.Ident); ok && id.Name == "new" && len(t.Args) == 1 {
+					if name, ok := bareTypeName(t.Args[0]); ok {
+						if _, isStruct := f.pkg.structs[name]; isStruct {
+							out[name] = true
+						}
+					}
+				}
+			}
+			return true
+		})
+	}
+	return out
+}
+
+func bareTypeName(e ast.Expr) (string, bool) {
+	switch t := e.(type) {
+	case *ast.Ident:
+		return t.Name, true
+	case *ast.StarExpr:
+		return bareTypeName(t.X)
+	case *ast.IndexExpr:
+		return bareTypeName(t.X)
+	case *ast.IndexListExpr:
+		return bareTypeName(t.X)
+	case *ast.ParenExpr:
+		return bareTypeName(t.X)
+	}
+	return "", false
+}
+
+func dedupeSorted(in []string) []string {
+	var out []string
+	for i, v := range in {
+		if i > 0 && in[i-1] == v {
+			continue
+		}
+		out = append(out, v)
+	}
+	return out
+}
+
+// isProofSliceType reports whether the resolved type is a slice of proof
+// nodes, i.e. the result type of the two public entry points.
+func isProofSliceType(t string) bool {
+	t = strings.ReplaceAll(t, " ", "")
+	switch t {
+	case "[]*ProofNode", "[]ProofNode", "[]*provenance.ProofNode", "[]provenance.ProofNode":
+		return true
+	}
+	return false
+}
+
+// Instantiation changes type arguments, not the declaration that owns code.
+func uninstantiate(e ast.Expr) ast.Expr {
+	switch x := e.(type) {
+	case *ast.IndexExpr:
+		return uninstantiate(x.X)
+	case *ast.IndexListExpr:
+		return uninstantiate(x.X)
+	case *ast.ParenExpr:
+		return uninstantiate(x.X)
+	}
+	return e
+}
+func (p *pkgModel) promotedMethods(base, name string, seen map[string]bool) []string {
+	if seen[base] {
+		return nil
+	}
+	seen[base] = true
+	if f := p.funcs[base+"."+name]; f != nil {
+		return []string{f.key}
+	}
+	var out []string
+	for _, embed := range p.embedded[base] {
+		out = append(out, p.promotedMethods(embed, name, seen)...)
+	}
+	sort.Strings(out)
+	return dedupeSorted(out)
+}
+func (p *pkgModel) promotedField(base, name string, seen map[string]bool) (string, string, bool) {
+	if seen[base] {
+		return "", "", false
+	}
+	seen[base] = true
+	if t, ok := p.structs[base][name]; ok {
+		return base, t, true
+	}
+	var owner, typ string
+	count := 0
+	for _, embed := range p.embedded[base] {
+		if o, t, ok := p.promotedField(embed, name, seen); ok {
+			owner, typ = o, t
+			count++
+		}
+	}
+	return owner, typ, count == 1
+}
+
+// Function values are linked only through assignments and actual arguments;
+// a same-named unrelated method is not evidence of a callback connection.
+func (m *moduleModel) valueKey(f *fnInfo, e ast.Expr) string {
+	switch x := e.(type) {
+	case *ast.Ident:
+		return "local:" + f.key + ":" + x.Name
+	case *ast.SelectorExpr:
+		base := strings.TrimPrefix(f.pkg.resolve(m.exprType(f, x.X)), "*")
+		owner, _, ok := f.pkg.promotedField(base, x.Sel.Name, map[string]bool{})
+		if ok {
+			return "field:" + owner + ":" + x.Sel.Name
+		}
+	}
+	return ""
+}
+func (m *moduleModel) valueTargets(f *fnInfo, e ast.Expr) []string {
+	if e == nil {
+		return nil
+	}
+	e = uninstantiate(e)
+	switch x := e.(type) {
+	case *ast.Ident:
+		if g := f.pkg.funcs[x.Name]; g != nil && g.recv == "" {
+			return []string{g.key}
+		}
+	case *ast.SelectorExpr:
+		base := strings.TrimPrefix(f.pkg.resolve(m.exprType(f, x.X)), "*")
+		if keys := f.pkg.promotedMethods(base, x.Sel.Name, map[string]bool{}); len(keys) > 0 {
+			return keys
+		}
+	}
+	return f.pkg.bindings[m.valueKey(f, e)]
+}
+func (m *moduleModel) bindFunctionValues() {
+	for pass := 0; pass < 32; pass++ {
+		changed := false
+		for _, p := range m.pkgs {
+			for _, f := range p.funcs {
+				if f.decl.Body == nil {
+					continue
+				}
+				add := func(key string, values []string) {
+					if key == "" || len(values) == 0 {
+						return
+					}
+					old := p.bindings[key]
+					v := append(append([]string{}, old...), values...)
+					sort.Strings(v)
+					v = dedupeSorted(v)
+					if len(v) != len(old) {
+						p.bindings[key] = v
+						changed = true
+					}
+				}
+				ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+					switch x := n.(type) {
+					case *ast.AssignStmt:
+						if len(x.Lhs) == len(x.Rhs) {
+							for i, l := range x.Lhs {
+								add(m.valueKey(f, l), m.valueTargets(f, x.Rhs[i]))
+							}
+						}
+					case *ast.ValueSpec:
+						if len(x.Names) == len(x.Values) {
+							for i, l := range x.Names {
+								add(m.valueKey(f, l), m.valueTargets(f, x.Values[i]))
+							}
+						}
+					case *ast.CompositeLit:
+						base, _ := bareTypeName(x.Type)
+						for _, elt := range x.Elts {
+							if kv, ok := elt.(*ast.KeyValueExpr); ok {
+								if name, ok := kv.Key.(*ast.Ident); ok {
+									add("field:"+base+":"+name.Name, m.valueTargets(f, kv.Value))
+								}
+							}
+						}
+					case *ast.CallExpr:
+						targets, weak := m.resolveCall(f, x)
+						if !weak {
+							for _, key := range targets {
+								g := p.funcs[key]
+								if g == nil {
+									continue
+								}
+								for i, arg := range x.Args {
+									if i < len(g.paramNames) {
+										add("local:"+g.key+":"+g.paramNames[i], m.valueTargets(f, arg))
+									}
+								}
+							}
+						}
+					}
+					return true
+				})
+			}
+		}
+		if !changed {
+			return
+		}
+	}
+}
diff --git a/tests/f2p/runner/main.go b/tests/f2p/runner/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..28821c87ad7b6dc2bd93c453c5605c9da0a3bc72
--- /dev/null
+++ b/tests/f2p/runner/main.go
@@ -0,0 +1,557 @@
+// Command f2p_runner executes the exact leaf selectors declared for this task
+// and writes a JUnit XML report.
+//
+// The runner is self-contained: it shells out to the Go toolchain that is
+// already required to build this module and reads the frozen selector sets
+// from the pipeline-provided config file ({config}). The config's "p2p" and
+// "f2p" arrays are the only source of the final selection set; the frozen
+// {p2p_select} file is not used here because it does not contain the F2P
+// leaves.
+//
+// Modes:
+//
+//	f2p_runner --report <path> --config <config.json>   run every frozen P2P and F2P selector
+//	f2p_runner --report <path> --selector <sel> ...     run exactly the given selectors
+//
+// A selector is "<repo-relative .go file>::<top-level test function>".
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+type sel struct {
+	selector string
+	path     string
+	leaf     string
+}
+
+func parseSelector(s string) (sel, error) {
+	i := strings.Index(s, "::")
+	if i <= 0 || i+2 >= len(s) {
+		return sel{}, fmt.Errorf("not a path::leaf selector: %q", s)
+	}
+	p, l := s[:i], s[i+2:]
+	if p == "" || l == "" || strings.Contains(l, "::") {
+		return sel{}, fmt.Errorf("not a path::leaf selector: %q", s)
+	}
+	return sel{selector: s, path: p, leaf: l}, nil
+}
+
+// nodeResult is the outcome of one declared selector.
+type nodeResult struct {
+	sel     sel
+	result  string // pass|fail|skip|error
+	message string
+	typ     string
+	body    string
+	elapsed float64
+}
+
+type testResult struct {
+	action  string
+	elapsed float64
+	output  []string
+}
+
+type junitTestSuites struct {
+	XMLName  xml.Name         `xml:"testsuites"`
+	Name     string           `xml:"name,attr"`
+	Tests    int              `xml:"tests,attr"`
+	Failures int              `xml:"failures,attr"`
+	Errors   int              `xml:"errors,attr"`
+	Skipped  int              `xml:"skipped,attr"`
+	Time     string           `xml:"time,attr"`
+	Suites   []junitTestSuite `xml:"testsuite"`
+}
+
+type junitTestSuite struct {
+	Name      string          `xml:"name,attr"`
+	Tests     int             `xml:"tests,attr"`
+	Failures  int             `xml:"failures,attr"`
+	Errors    int             `xml:"errors,attr"`
+	Skipped   int             `xml:"skipped,attr"`
+	Time      string          `xml:"time,attr"`
+	TestCases []junitTestCase `xml:"testcase"`
+}
+
+type junitTestCase struct {
+	Classname string        `xml:"classname,attr"`
+	Name      string        `xml:"name,attr"`
+	File      string        `xml:"file,attr"`
+	Time      string        `xml:"time,attr"`
+	Failure   *junitMessage `xml:"failure,omitempty"`
+	Error     *junitMessage `xml:"error,omitempty"`
+	Skipped   *junitMessage `xml:"skipped,omitempty"`
+}
+
+type junitMessage struct {
+	Message string `xml:"message,attr"`
+	Type    string `xml:"type,attr"`
+	Body    string `xml:",chardata"`
+}
+
+type selectorList []string
+
+func (s *selectorList) String() string { return strings.Join(*s, ",") }
+func (s *selectorList) Set(v string) error {
+	if strings.TrimSpace(v) == "" {
+		return fmt.Errorf("empty selector")
+	}
+	*s = append(*s, v)
+	return nil
+}
+
+func main() {
+	var (
+		reportPath = flag.String("report", "", "path of the JUnit XML report to write (required)")
+		configPath = flag.String("config", "", "path of the pipeline config.json holding the frozen p2p and f2p selector arrays")
+		deadline   = flag.Float64("deadline", 240, "internal deadline for the go test invocation, in seconds")
+	)
+	var selectors selectorList
+	flag.Var(&selectors, "selector", "run exactly this selector (repeatable)")
+	flag.Parse()
+
+	if *reportPath == "" {
+		fmt.Fprintln(os.Stderr, "f2p_runner: --report is required")
+		os.Exit(2)
+	}
+
+	var wanted []string
+	if len(selectors) > 0 {
+		wanted = append(wanted, selectors...)
+	} else if *configPath != "" {
+		fromConfig, err := readConfigSelectors(*configPath)
+		if err != nil {
+			writeFatal(*reportPath, fmt.Sprintf("cannot read selector configuration: %v", err))
+			os.Exit(2)
+		}
+		wanted = fromConfig
+	} else {
+		fmt.Fprintln(os.Stderr, "f2p_runner: one of --config or --selector is required")
+		os.Exit(2)
+	}
+
+	seen := map[string]bool{}
+	var unique []string
+	for _, s := range wanted {
+		s = strings.TrimSpace(s)
+		if s == "" || seen[s] {
+			continue
+		}
+		seen[s] = true
+		unique = append(unique, s)
+	}
+	sort.Strings(unique)
+	if len(unique) == 0 {
+		writeFatal(*reportPath, "no selectors were declared in the configuration")
+		os.Exit(2)
+	}
+
+	parsed := make([]sel, 0, len(unique))
+	for _, s := range unique {
+		p, err := parseSelector(s)
+		if err != nil {
+			writeFatal(*reportPath, err.Error())
+			os.Exit(2)
+		}
+		parsed = append(parsed, p)
+	}
+
+	root, err := findModuleRoot()
+	if err != nil {
+		writeFatal(*reportPath, fmt.Sprintf("cannot locate the module root: %v", err))
+		os.Exit(2)
+	}
+	modulePath, err := modulePath(root)
+	if err != nil {
+		writeFatal(*reportPath, fmt.Sprintf("cannot read the module path: %v", err))
+		os.Exit(2)
+	}
+
+	// Verify each declared node is collectable in its file; keep the rest.
+	nodes := map[string]nodeResult{}
+	pkgDirs := map[string]bool{}
+	for _, s := range parsed {
+		full := filepath.Join(root, filepath.FromSlash(s.path))
+		data, err := os.ReadFile(full)
+		if err != nil {
+			nodes[s.selector] = nodeResult{sel: s, result: "error", typ: "setup",
+				message: fmt.Sprintf("test file %s not readable: %v", s.path, err)}
+			continue
+		}
+		if !regexp.MustCompile(`(?m)^func ` + regexp.QuoteMeta(s.leaf) + `\(`).Match(data) {
+			nodes[s.selector] = nodeResult{sel: s, result: "error", typ: "setup",
+				message: fmt.Sprintf("leaf %s not found in %s", s.leaf, s.path)}
+			continue
+		}
+		pkgDirs[filepath.Dir(s.path)] = true
+	}
+
+	pkgs := make([]string, 0, len(pkgDirs))
+	for d := range pkgDirs {
+		pkgs = append(pkgs, "./"+filepath.ToSlash(d))
+	}
+	sort.Strings(pkgs)
+
+	var leaves []string
+	for _, s := range parsed {
+		if _, ok := nodes[s.selector]; ok {
+			continue
+		}
+		leaves = append(leaves, regexp.QuoteMeta(s.leaf))
+	}
+
+	results := map[string]testResult{}
+	runnerErr := ""
+	if len(pkgs) > 0 {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Duration(*deadline*float64(time.Second)))
+		defer cancel()
+		args := []string{"test", "-json", "-count=1", "-v", "-run", "^(" + strings.Join(leaves, "|") + ")$"}
+		args = append(args, pkgs...)
+		cmd := exec.CommandContext(ctx, "go", args...)
+		cmd.Dir = root
+		cmd.Env = buildEnv()
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			runnerErr = fmt.Sprintf("stdout pipe: %v", err)
+		} else {
+			var stderr strings.Builder
+			cmd.Stderr = &stderr
+			if err := cmd.Start(); err != nil {
+				runnerErr = fmt.Sprintf("start go test: %v", err)
+			} else {
+				dec := json.NewDecoder(stdout)
+				for {
+					var ev struct {
+						Action  string  `json:"Action"`
+						Package string  `json:"Package"`
+						Test    string  `json:"Test"`
+						Output  string  `json:"Output"`
+						Elapsed float64 `json:"Elapsed"`
+					}
+					if err := dec.Decode(&ev); err != nil {
+						break
+					}
+					switch ev.Action {
+					case "output", "pass", "fail", "skip":
+						if ev.Test == "" {
+							continue
+						}
+						key := ev.Package + "|" + topLevelTest(ev.Test)
+						r := results[key]
+						if ev.Action == "output" {
+							r.output = append(r.output, ev.Output)
+						} else {
+							r.action = ev.Action
+							r.elapsed = ev.Elapsed
+						}
+						results[key] = r
+					}
+				}
+				waitErr := cmd.Wait()
+				if ctx.Err() == context.DeadlineExceeded {
+					runnerErr = fmt.Sprintf("go test exceeded the internal deadline of %.0fs", *deadline)
+				} else if waitErr != nil && len(results) == 0 {
+					runnerErr = fmt.Sprintf("go test produced no test events: %v; stderr: %s", waitErr, strings.TrimSpace(stderr.String()))
+				}
+			}
+		}
+	}
+
+	failed := false
+	for _, s := range parsed {
+		if _, ok := nodes[s.selector]; ok {
+			failed = true
+			continue
+		}
+		key := pkgImportPath(modulePath, s.path) + "|" + s.leaf
+		r, ok := results[key]
+		if !ok {
+			nodes[s.selector] = nodeResult{sel: s, result: "error", typ: "not_run",
+				message: "test was not executed by the go test invocation"}
+			failed = true
+			continue
+		}
+		switch r.action {
+		case "pass":
+			nodes[s.selector] = nodeResult{sel: s, result: "pass", elapsed: r.elapsed}
+		case "skip":
+			nodes[s.selector] = nodeResult{sel: s, result: "skip", body: strings.Join(r.output, "")}
+		default:
+			body := strings.Join(r.output, "")
+			typ := "assertion"
+			message := "test failed"
+			if strings.Contains(body, "panic:") {
+				typ = "panic"
+				message = "test panicked"
+			}
+			nodes[s.selector] = nodeResult{sel: s, result: "fail", typ: typ, message: message, body: body, elapsed: r.elapsed}
+			failed = true
+		}
+	}
+
+	var ordered []nodeResult
+	for _, s := range parsed {
+		ordered = append(ordered, nodes[s.selector])
+	}
+	suites := buildSuites(ordered)
+	out := junitTestSuites{Name: "grader-verifier", Suites: suites}
+	for _, suite := range suites {
+		out.Tests += suite.Tests
+		out.Failures += suite.Failures
+		out.Errors += suite.Errors
+		out.Skipped += suite.Skipped
+	}
+	out.Time = fmt.Sprintf("%.3f", maxSuiteTime(suites))
+	if err := writeReport(*reportPath, out); err != nil {
+		fmt.Fprintf(os.Stderr, "f2p_runner: write report: %v\n", err)
+		os.Exit(2)
+	}
+	fmt.Printf("f2p_runner: %d nodes, %d failures, %d errors, %d skipped (report: %s)\n",
+		out.Tests, out.Failures, out.Errors, out.Skipped, *reportPath)
+	if runnerErr != "" {
+		fmt.Fprintf(os.Stderr, "f2p_runner: %s\n", runnerErr)
+	}
+	if failed {
+		os.Exit(1)
+	}
+}
+
+// topLevelTest strips subtest qualifiers so a selector maps to its declared
+// top-level test function.
+func topLevelTest(name string) string {
+	if i := strings.Index(name, "/"); i >= 0 {
+		return name[:i]
+	}
+	return name
+}
+
+// readConfigSelectors reads the frozen exact selectors from the pipeline
+// config's p2p and f2p arrays. Both plain-string entries and row objects with
+// selector/test fields are accepted.
+func readConfigSelectors(path string) ([]string, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var doc struct {
+		P2P []json.RawMessage `json:"p2p"`
+		F2P []json.RawMessage `json:"f2p"`
+	}
+	if err := json.Unmarshal(data, &doc); err != nil {
+		return nil, err
+	}
+	var out []string
+	for _, group := range [][]json.RawMessage{doc.P2P, doc.F2P} {
+		for _, raw := range group {
+			var s string
+			if err := json.Unmarshal(raw, &s); err == nil && s != "" {
+				out = append(out, s)
+				continue
+			}
+			var row struct {
+				Selector string `json:"selector"`
+				Test     string `json:"test"`
+			}
+			if err := json.Unmarshal(raw, &row); err != nil {
+				continue
+			}
+			if row.Selector != "" {
+				out = append(out, row.Selector)
+			} else if row.Test != "" {
+				out = append(out, row.Test)
+			}
+		}
+	}
+	return out, nil
+}
+
+func buildSuites(nodes []nodeResult) []junitTestSuite {
+	byPkg := map[string][]int{}
+	var order []string
+	for i, n := range nodes {
+		pkg := filepath.Dir(n.sel.path)
+		if _, ok := byPkg[pkg]; !ok {
+			order = append(order, pkg)
+		}
+		byPkg[pkg] = append(byPkg[pkg], i)
+	}
+	sort.Strings(order)
+	suites := make([]junitTestSuite, 0, len(order))
+	for _, pkg := range order {
+		suite := junitTestSuite{Name: "codeberg.org/TauCeti/mangle-go/" + filepath.ToSlash(pkg)}
+		var total float64
+		for _, i := range byPkg[pkg] {
+			n := nodes[i]
+			tc := junitTestCase{
+				Classname: n.sel.path,
+				Name:      n.sel.leaf,
+				File:      n.sel.path,
+				Time:      fmt.Sprintf("%.3f", n.elapsed),
+			}
+			switch n.result {
+			case "pass":
+				suite.Tests++
+			case "skip":
+				suite.Tests++
+				suite.Skipped++
+				tc.Skipped = &junitMessage{Message: "skipped", Type: "skip", Body: n.body}
+			case "fail":
+				suite.Tests++
+				suite.Failures++
+				tc.Failure = &junitMessage{Message: n.message, Type: n.typ, Body: n.body}
+			default:
+				suite.Tests++
+				suite.Errors++
+				tc.Error = &junitMessage{Message: n.message, Type: n.typ, Body: n.body}
+			}
+			suite.TestCases = append(suite.TestCases, tc)
+			total += n.elapsed
+		}
+		suite.Time = fmt.Sprintf("%.3f", total)
+		suites = append(suites, suite)
+	}
+	return suites
+}
+
+func maxSuiteTime(suites []junitTestSuite) float64 {
+	var max float64
+	for _, s := range suites {
+		var t float64
+		if _, err := fmt.Sscanf(s.Time, "%f", &t); err == nil && t > max {
+			max = t
+		}
+	}
+	return max
+}
+
+func pkgImportPath(modulePath, relPath string) string {
+	dir := filepath.ToSlash(filepath.Dir(relPath))
+	if dir == "." {
+		return modulePath
+	}
+	return modulePath + "/" + dir
+}
+
+func writeReport(path string, suites junitTestSuites) error {
+	if dir := filepath.Dir(path); dir != "" && dir != "." {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			return err
+		}
+	}
+	data, err := xml.MarshalIndent(suites, "", "  ")
+	if err != nil {
+		return err
+	}
+	out := append([]byte(xml.Header), data...)
+	out = append(out, '\n')
+	return os.WriteFile(path, out, 0o644)
+}
+
+// writeFatal records an infrastructure failure as an error testcase so the
+// report still exists and the node ledger shows the selection was not run.
+func writeFatal(reportPath, message string) {
+	suites := junitTestSuites{Name: "grader-verifier", Tests: 1, Errors: 1}
+	suites.Suites = []junitTestSuite{{
+		Name:   "grader-verifier/f2p_runner",
+		Tests:  1,
+		Errors: 1,
+		Time:   "0.000",
+		TestCases: []junitTestCase{{
+			Classname: "provenance/f2p/runner",
+			Name:      "f2p_runner_setup",
+			File:      "provenance/f2p/runner/main.go",
+			Time:      "0.000",
+			Error:     &junitMessage{Message: message, Type: "setup", Body: message},
+		}},
+	}}
+	if err := writeReport(reportPath, suites); err != nil {
+		fmt.Fprintf(os.Stderr, "f2p_runner: write fatal report: %v\n", err)
+	}
+	fmt.Fprintf(os.Stderr, "f2p_runner: %s\n", message)
+}
+
+func findModuleRoot() (string, error) {
+	dir, err := os.Getwd()
+	if err != nil {
+		return "", err
+	}
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir, nil
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return "", fmt.Errorf("could not locate the module root (go.mod) from %s", dir)
+		}
+		dir = parent
+	}
+}
+
+func modulePath(root string) (string, error) {
+	data, err := os.ReadFile(filepath.Join(root, "go.mod"))
+	if err != nil {
+		return "", err
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		line = strings.TrimSpace(line)
+		if strings.HasPrefix(line, "module ") {
+			return strings.TrimSpace(strings.TrimPrefix(line, "module ")), nil
+		}
+	}
+	return "", fmt.Errorf("module directive not found in go.mod")
+}
+
+// buildEnv keeps the image-provided toolchain and module cache, falls back to
+// a temporary build cache when the inherited one is not usable, and disables
+// any network or toolchain download so replay stays offline.
+func buildEnv() []string {
+	env := os.Environ()
+	cache := os.Getenv("GOCACHE")
+	if cache == "" {
+		if home, err := os.UserHomeDir(); err == nil && home != "" {
+			cache = filepath.Join(home, ".cache", "go-build")
+		}
+	}
+	if cache == "" || !writableDir(cache) {
+		fallback := filepath.Join(os.TempDir(), "f2p-go-build-cache")
+		if err := os.MkdirAll(fallback, 0o755); err == nil {
+			cache = fallback
+		}
+	}
+	if cache != "" {
+		env = append(env, "GOCACHE="+cache)
+	}
+	env = append(env,
+		"GOPROXY=off",
+		"GOTOOLCHAIN=local",
+		"GOFLAGS=-mod=readonly",
+	)
+	return env
+}
+
+func writableDir(dir string) bool {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return false
+	}
+	f, err := os.CreateTemp(dir, ".f2p-write-probe-*")
+	if err != nil {
+		return false
+	}
+	name := f.Name()
+	_ = f.Close()
+	_ = os.Remove(name)
+	return true
+}
