+func p2pCheckGroundErrorOrdering(t *testing.T) {
+	t.Helper()
+	rec := provenance.NewMemoryRecorder()
+	pi, store := p2pEvalProgram(t, "a(1). foo(X) :- a(X).", rec)
+	goal := ast.NewAtom("foo", ast.Variable{Symbol: "X"})
+	for _, recording := range []bool{false, true} {
+		t.Run(fmt.Sprintf("non-ground-before-premises-%t", recording), func(t *testing.T) {
+			counted := &p2pAccessCountingStore{ReadOnlyFactStore: store}
+			var proofs []*provenance.ProofNode
+			var err error
+			if recording {
+				proofs, err = provenance.BuildFromRecording(rec, counted, goal, provenance.Options{})
+			} else {
+				proofs, err = provenance.Explain(pi, counted, goal, provenance.Options{})
+			}
+			if err != provenance.ErrGoalNotGround || proofs != nil || counted.reads != 0 {
+				t.Errorf("proofs=%v error=%v store reads=%d; want nil, ErrGoalNotGround, 0", proofs, err, counted.reads)
+			}
+		})
+	}
+	// A recorder is not needed to reject an invalid goal. Dereferencing this
+	// nil recorder would reveal event lookup before ground validation.
+	if proofs, err := provenance.BuildFromRecording(nil, store, goal, provenance.Options{}); err != provenance.ErrGoalNotGround || proofs != nil {
+		t.Errorf("nil recorder non-ground rejection: proofs=%v error=%v", proofs, err)
+	}
+}
