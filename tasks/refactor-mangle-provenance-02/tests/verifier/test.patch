+// TestP2PRecorderEngineIntegration pins that MemoryRecorder remains usable
+// with the engine: callbacks fire for rule, let-transform and do-transform
+// derivations, EventsFor resolves recorded outputs, and fresh recorders stay
+// isolated.
+func TestP2PRecorderEngineIntegration(t *testing.T) {
+	source := `
+		bar(1).
+		baz(1).
+		foo(X) :- bar(X), baz(X).
+		measurement(1, 10).
+		scaled(ID, V) :- measurement(ID, Raw) |> let V = fn:mult(Raw, 2).
+		sale("apple", 3).
+		sale("apple", 5).
+		totals(Product, Sum) :- sale(Product, N)
+			|> do fn:group_by(Product), let Sum = fn:sum(N).
+	`
+	rec := provenance.NewMemoryRecorder()
+	if len(rec.Events()) != 0 {
+		t.Fatalf("fresh recorder must be empty")
+	}
+	_, store := p2pEvalProgram(t, source, rec)
+	if len(rec.Events()) == 0 {
+		t.Fatalf("engine did not fire derivation callbacks with a recorder attached")
+	}
+	for _, fact := range []string{"foo(1)", "scaled(1, 20)", `totals("apple", 8)`} {
+		if got := rec.EventsFor(p2pAtom(t, fact)); len(got) == 0 {
+			t.Errorf("EventsFor(%s) is empty", fact)
+		}
+	}
+	if !store.Contains(p2pAtom(t, `totals("apple", 8)`)) {
+		t.Errorf("derived fact missing from the store")
+	}
+
+	other := provenance.NewMemoryRecorder()
+	if len(other.Events()) != 0 {
+		t.Errorf("a new recorder must not see another recorder's events")
+	}
+	_, _ = p2pEvalProgram(t, `bar(1). foo(X) :- bar(X).`, nil)
+	if len(other.Events()) != 0 {
+		t.Errorf("recorder without engine attachment must stay empty")
+	}
+}
