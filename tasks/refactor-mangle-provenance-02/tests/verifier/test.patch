@@ -0,0 +1,989 @@
+// Supplemental P2P regression coverage for the provenance construction
+// refactor. These tests pin observable behavior that the baseline already
+// exhibits and that must not change when the duplicated proof-graph
+// construction skeleton is converged into one shared component.
+//
+// They intentionally use only the exported provenance API so that internal
+// helper reorganization remains free (REQ-BEH-T5:C8).
+package provenance_test
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+	"testing"
+
+	"codeberg.org/TauCeti/mangle-go/analysis"
+	"codeberg.org/TauCeti/mangle-go/ast"
+	"codeberg.org/TauCeti/mangle-go/engine"
+	"codeberg.org/TauCeti/mangle-go/factstore"
+	"codeberg.org/TauCeti/mangle-go/parse"
+	"codeberg.org/TauCeti/mangle-go/provenance"
+	"codeberg.org/TauCeti/mangle-go/unionfind"
+)
+
+// p2pEvalProgram parses, analyzes and evaluates source, optionally attaching
+// a derivation recorder, and returns the program info and fact store.
+func p2pEvalProgram(t *testing.T, source string, rec *provenance.MemoryRecorder) (*analysis.ProgramInfo, factstore.SimpleInMemoryStore) {
+	t.Helper()
+	unit, err := parse.Unit(strings.NewReader(source))
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	pi, err := analysis.AnalyzeOneUnit(unit, nil)
+	if err != nil {
+		t.Fatalf("analyze: %v", err)
+	}
+	store := factstore.NewSimpleInMemoryStore()
+	for _, f := range pi.InitialFacts {
+		store.Add(f)
+	}
+	strata, predToStratum, err := analysis.Stratify(analysis.Program{
+		EdbPredicates: pi.EdbPredicates,
+		IdbPredicates: pi.IdbPredicates,
+		Rules:         pi.Rules,
+	})
+	if err != nil {
+		t.Fatalf("stratify: %v", err)
+	}
+	var evalOpts []engine.EvalOption
+	if rec != nil {
+		evalOpts = append(evalOpts, engine.WithDerivationRecorder(rec))
+	}
+	if _, err := engine.EvalStratifiedProgramWithStats(pi, strata, predToStratum, store, evalOpts...); err != nil {
+		t.Fatalf("eval: %v", err)
+	}
+	return pi, store
+}
+
+func p2pAtom(t *testing.T, s string) ast.Atom {
+	t.Helper()
+	a, err := parse.Atom(s)
+	if err != nil {
+		t.Fatalf("parse atom %q: %v", s, err)
+	}
+	return a
+}
+
+// p2pWalk visits every unique node of the given proofs.
+func p2pWalk(proofs []*provenance.ProofNode, fn func(*provenance.ProofNode)) {
+	seen := map[string]bool{}
+	var rec func(n *provenance.ProofNode)
+	rec = func(n *provenance.ProofNode) {
+		if n == nil || seen[n.ID] {
+			return
+		}
+		seen[n.ID] = true
+		fn(n)
+		for _, sub := range n.Premises {
+			rec(sub)
+		}
+	}
+	for _, p := range proofs {
+		rec(p)
+	}
+}
+
+func p2pPrintOutput(t *testing.T, proofs []*provenance.ProofNode) string {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := provenance.Print(&buf, proofs); err != nil {
+		t.Fatalf("Print: %v", err)
+	}
+	return buf.String()
+}
+
+// p2pFactsDump renders the EmitFacts payload as sorted "fact" lines so that
+// comparisons are independent of fact-store iteration order.
+func p2pFactsDump(t *testing.T, proofs []*provenance.ProofNode) string {
+	t.Helper()
+	out := factstore.NewSimpleInMemoryStore()
+	if err := provenance.EmitFacts(proofs, &out); err != nil {
+		t.Fatalf("EmitFacts: %v", err)
+	}
+	var lines []string
+	for _, p := range out.ListPredicates() {
+		out.GetFacts(ast.NewQuery(p), func(a ast.Atom) error {
+			lines = append(lines, a.String())
+			return nil
+		})
+	}
+	sort.Strings(lines)
+	return strings.Join(lines, "\n")
+}
+
+func p2pIDSet(proofs []*provenance.ProofNode) map[string]bool {
+	out := map[string]bool{}
+	p2pWalk(proofs, func(n *provenance.ProofNode) { out[n.ID] = true })
+	return out
+}
+
+// --- post-hoc contract ---
+
+// TestP2PExplainEDBLeafShape pins the stored-EDB leaf shape: bare KindEDB
+// node with a content-addressed /proof/<32 hex> identifier.
+func TestP2PExplainEDBLeafShape(t *testing.T) {
+	pi, store := p2pEvalProgram(t, `bar(1).`, nil)
+	proofs, err := provenance.Explain(pi, store, p2pAtom(t, "bar(1)"), provenance.Options{})
+	if err != nil {
+		t.Fatalf("Explain: %v", err)
+	}
+	if len(proofs) != 1 {
+		t.Fatalf("got %d proofs, want 1", len(proofs))
+	}
+	p := proofs[0]
+	if p.Kind != provenance.KindEDB {
+		t.Errorf("kind = %v, want KindEDB", p.Kind)
+	}
+	if !strings.HasPrefix(p.ID, "/proof/") || len(p.ID) != len("/proof/")+32 {
+		t.Errorf("id = %q, want /proof/<32 hex>", p.ID)
+	}
+	if p.Rule != nil || p.RuleID != "" || len(p.Premises) != 0 || len(p.Bindings) != 0 || p.Partial {
+		t.Errorf("EDB leaf must be bare: rule=%v ruleID=%q premises=%d bindings=%d partial=%v",
+			p.Rule, p.RuleID, len(p.Premises), len(p.Bindings), p.Partial)
+	}
+}
+
+// TestP2PExplainDefaultsAndCaps pins the post-hoc entry point's option
+// defaults (zero MaxProofs means one proof) and explicit MaxProofs caps.
+func TestP2PExplainDefaultsAndCaps(t *testing.T) {
+	source := `
+		a(1).
+		b(1).
+		c(1).
+		foo(X) :- a(X).
+		foo(X) :- b(X).
+		foo(X) :- c(X).
+	`
+	pi, store := p2pEvalProgram(t, source, nil)
+	goal := p2pAtom(t, "foo(1)")
+
+	got, err := provenance.Explain(pi, store, goal, provenance.Options{})
+	if err != nil {
+		t.Fatalf("Explain: %v", err)
+	}
+	if len(got) != 1 {
+		t.Errorf("default MaxProofs: got %d proofs, want 1", len(got))
+	}
+	two, err := provenance.Explain(pi, store, goal, provenance.Options{MaxProofs: 2})
+	if err != nil {
+		t.Fatalf("Explain: %v", err)
+	}
+	if len(two) != 2 {
+		t.Errorf("MaxProofs=2: got %d proofs, want 2", len(two))
+	}
+	three, err := provenance.Explain(pi, store, goal, provenance.Options{MaxProofs: 3})
+	if err != nil {
+		t.Fatalf("Explain: %v", err)
+	}
+	if len(three) != 3 {
+		t.Errorf("MaxProofs=3: got %d proofs, want 3", len(three))
+	}
+}
+
+// TestP2PExplainDepthPartial pins depth-capping semantics: exceeding MaxDepth
+// yields partial subproofs (no error), and the default cap leaves ordinary
+// proofs fully expanded.
+func TestP2PExplainDepthPartial(t *testing.T) {
+	p2pCheckExactDepth(t, false)
+	source := `
+		edge(1, 2).
+		edge(2, 3).
+		edge(3, 4).
+		edge(4, 5).
+		edge(5, 6).
+		edge(6, 7).
+		edge(7, 8).
+		edge(8, 9).
+		edge(9, 10).
+		edge(10, 11).
+		edge(11, 12).
+		path(X, Y) :- edge(X, Y).
+		path(X, Z) :- edge(X, Y), path(Y, Z).
+	`
+	pi, store := p2pEvalProgram(t, source, nil)
+	goal := p2pAtom(t, "path(1, 12)")
+
+	deep, err := provenance.Explain(pi, store, goal, provenance.Options{})
+	if err != nil {
+		t.Fatalf("default depth: %v", err)
+	}
+	p2pWalk(deep, func(n *provenance.ProofNode) {
+		if n.Partial {
+			t.Errorf("default MaxDepth must fully expand path(1,12); node %s is Partial", n.ID)
+		}
+	})
+
+	shallow, err := provenance.Explain(pi, store, goal, provenance.Options{MaxDepth: 2})
+	if err != nil {
+		t.Fatalf("MaxDepth=2 must not fail: %v", err)
+	}
+	if len(shallow) == 0 {
+		t.Fatalf("MaxDepth=2 returned no proofs")
+	}
+	var truncated int
+	p2pWalk(shallow, func(n *provenance.ProofNode) {
+		if n.Partial && strings.HasPrefix(n.ID, "/proof/partial/") {
+			truncated++
+		}
+	})
+	if truncated == 0 {
+		t.Errorf("MaxDepth=2 must mark depth-limited subproofs Partial with /proof/partial/ ids")
+	}
+}
+
+// --- recording-based contract ---
+
+// TestP2PRecordingDepthPartial pins the same depth-capping semantics for the
+// recording-based entry point.
+func TestP2PRecordingDepthPartial(t *testing.T) {
+	p2pCheckExactDepth(t, true)
+	source := `
+		edge(1, 2).
+		edge(2, 3).
+		edge(3, 4).
+		edge(4, 5).
+		edge(5, 6).
+		edge(6, 7).
+		edge(7, 8).
+		edge(8, 9).
+		edge(9, 10).
+		edge(10, 11).
+		edge(11, 12).
+		path(X, Y) :- edge(X, Y).
+		path(X, Z) :- edge(X, Y), path(Y, Z).
+	`
+	rec := provenance.NewMemoryRecorder()
+	_, store := p2pEvalProgram(t, source, rec)
+	goal := p2pAtom(t, "path(1, 12)")
+
+	deep, err := provenance.BuildFromRecording(rec, store, goal, provenance.Options{})
+	if err != nil {
+		t.Fatalf("default depth: %v", err)
+	}
+	p2pWalk(deep, func(n *provenance.ProofNode) {
+		if n.Partial {
+			t.Errorf("default MaxDepth must fully expand path(1,12) in recording mode; node %s is Partial", n.ID)
+		}
+	})
+
+	shallow, err := provenance.BuildFromRecording(rec, store, goal, provenance.Options{MaxDepth: 2})
+	if err != nil {
+		t.Fatalf("MaxDepth=2 must not fail: %v", err)
+	}
+	var truncated int
+	p2pWalk(shallow, func(n *provenance.ProofNode) {
+		if n.Partial && strings.HasPrefix(n.ID, "/proof/partial/") {
+			truncated++
+		}
+	})
+	if truncated == 0 {
+		t.Errorf("recording MaxDepth=2 must mark depth-limited subproofs Partial with /proof/partial/ ids")
+	}
+}
+
+// TestP2PRecordingErrorsAndDefaults pins sentinel errors and option defaults
+// for the recording-based entry point: non-ground goals are rejected before
+// any premise is resolved (nil proof slice), missing proofs return ErrNoProof,
+// and MaxProofs defaults to 1.
+func TestP2PRecordingErrorsAndDefaults(t *testing.T) {
+	p2pCheckGroundErrorOrdering(t)
+	source := `
+		a(1).
+		b(1).
+		c(1).
+		foo(X) :- a(X).
+		foo(X) :- b(X).
+		foo(X) :- c(X).
+	`
+	rec := provenance.NewMemoryRecorder()
+	_, store := p2pEvalProgram(t, source, rec)
+
+	if proofs, err := provenance.BuildFromRecording(rec, store, ast.NewAtom("foo", ast.Variable{Symbol: "X"}), provenance.Options{}); err != provenance.ErrGoalNotGround || proofs != nil {
+		t.Errorf("non-ground: proofs=%v err=%v, want (nil, ErrGoalNotGround)", proofs, err)
+	}
+	if proofs, err := provenance.BuildFromRecording(rec, store, p2pAtom(t, "nope(9)"), provenance.Options{}); err != provenance.ErrNoProof || proofs != nil {
+		t.Errorf("no proof: proofs=%v err=%v, want (nil, ErrNoProof)", proofs, err)
+	}
+	got, err := provenance.BuildFromRecording(rec, store, p2pAtom(t, "foo(1)"), provenance.Options{})
+	if err != nil {
+		t.Fatalf("BuildFromRecording: %v", err)
+	}
+	if len(got) != 1 {
+		t.Errorf("default MaxProofs: got %d proofs, want 1", len(got))
+	}
+}
+
+// TestP2PRecordingAlternativesAndCaps pins that the recording-based entry
+// point returns all alternative derivations up to MaxProofs with distinct
+// content-addressed identifiers, and honors explicit caps.
+func TestP2PRecordingAlternativesAndCaps(t *testing.T) {
+	source := `
+		a(1).
+		b(1).
+		c(1).
+		foo(X) :- a(X).
+		foo(X) :- b(X).
+		foo(X) :- c(X).
+	`
+	rec := provenance.NewMemoryRecorder()
+	_, store := p2pEvalProgram(t, source, rec)
+
+	all, err := provenance.BuildFromRecording(rec, store, p2pAtom(t, "foo(1)"), provenance.Options{MaxProofs: 10})
+	if err != nil {
+		t.Fatalf("BuildFromRecording: %v", err)
+	}
+	if len(all) != 3 {
+		t.Fatalf("MaxProofs=10: got %d proofs, want 3", len(all))
+	}
+	ids := map[string]bool{}
+	ruleIDs := map[string]bool{}
+	for _, p := range all {
+		ids[p.ID] = true
+		ruleIDs[p.RuleID] = true
+	}
+	if len(ids) != 3 || len(ruleIDs) != 3 {
+		t.Errorf("expected 3 distinct proof ids and rule ids, got ids=%d ruleIDs=%d", len(ids), len(ruleIDs))
+	}
+
+	two, err := provenance.BuildFromRecording(rec, store, p2pAtom(t, "foo(1)"), provenance.Options{MaxProofs: 2})
+	if err != nil {
+		t.Fatalf("BuildFromRecording: %v", err)
+	}
+	if len(two) != 2 {
+		t.Errorf("MaxProofs=2: got %d proofs, want 2", len(two))
+	}
+}
+
+// TestP2PRecordingAbsenceLeaf pins closed-world negation in recording mode:
+// a satisfied negated premise contributes a KindAbsence leaf (not Partial),
+// and a negated premise that holds in the store yields no proof.
+func TestP2PRecordingAbsenceLeaf(t *testing.T) {
+	source := `
+		node(1).
+		node(2).
+		node(3).
+		reachable(1).
+		reachable(2).
+		unreachable(X) :- node(X), !reachable(X).
+	`
+	rec := provenance.NewMemoryRecorder()
+	_, store := p2pEvalProgram(t, source, rec)
+
+	proofs, err := provenance.BuildFromRecording(rec, store, p2pAtom(t, "unreachable(3)"), provenance.Options{})
+	if err != nil {
+		t.Fatalf("BuildFromRecording: %v", err)
+	}
+	p := proofs[0]
+	if p.Partial {
+		t.Errorf("closed-world negation must not be Partial")
+	}
+	last := p.Premises[len(p.Premises)-1]
+	if last.Kind != provenance.KindAbsence {
+		t.Fatalf("last premise kind = %v, want KindAbsence", last.Kind)
+	}
+	if last.Fact.String() != "reachable(3)" {
+		t.Errorf("absence fact = %q, want reachable(3)", last.Fact.String())
+	}
+	if _, err := provenance.BuildFromRecording(rec, store, p2pAtom(t, "unreachable(1)"), provenance.Options{}); err != provenance.ErrNoProof {
+		t.Errorf("unreachable(1) (reachable(1) exists): err = %v, want ErrNoProof", err)
+	}
+}
+
+// TestP2PExplainSkipsTransforms pins that post-hoc proofs stay derived from
+// fact-store queries and closed-world absence checks and never include
+// transform nodes: a fact only derivable through a transform has no post-hoc
+// proof.
+func TestP2PExplainSkipsTransforms(t *testing.T) {
+	source := `
+		measurement(1, 10).
+		measurement(2, 20).
+		scaled(ID, V) :- measurement(ID, Raw) |> let V = fn:mult(Raw, 2).
+		totals(Sum) :- measurement(ID, Raw) |> do fn:group_by(), let Sum = fn:sum(Raw).
+	`
+	pi, store := p2pEvalProgram(t, source, nil)
+	if !store.Contains(p2pAtom(t, "scaled(1, 20)")) {
+		t.Fatalf("scaled(1, 20) not derived by the evaluator")
+	}
+	if !store.Contains(p2pAtom(t, "totals(30)")) {
+		t.Fatalf("totals(30) not derived by the evaluator")
+	}
+	if _, err := provenance.Explain(pi, store, p2pAtom(t, "scaled(1, 20)"), provenance.Options{}); err != provenance.ErrNoProof {
+		t.Errorf("post-hoc let-transform: err = %v, want ErrNoProof", err)
+	}
+	if _, err := provenance.Explain(pi, store, p2pAtom(t, "totals(30)"), provenance.Options{}); err != provenance.ErrNoProof {
+		t.Errorf("post-hoc do-transform: err = %v, want ErrNoProof", err)
+	}
+}
+
+// --- shared construction invariants ---
+
+// TestP2PCrossModeIdenticalIDs pins that shared construction produces
+// identical node identifiers and rule identifiers across both entry points
+// for the same derivation, including closed-world absence leaves.
+func TestP2PCrossModeIdenticalIDs(t *testing.T) {
+	source := `
+		node(1).
+		node(2).
+		blocked(1).
+		edge(1, 2).
+		edge(2, 3).
+		path(X, Y) :- edge(X, Y).
+		path(X, Z) :- edge(X, Y), path(Y, Z).
+		allowed(X) :- node(X), !blocked(X).
+	`
+	rec := provenance.NewMemoryRecorder()
+	pi, store := p2pEvalProgram(t, source, rec)
+
+	for _, goalStr := range []string{"allowed(2)", "path(1, 3)"} {
+		goal := p2pAtom(t, goalStr)
+		simple, err := provenance.Explain(pi, store, goal, provenance.Options{})
+		if err != nil {
+			t.Fatalf("Explain(%s): %v", goalStr, err)
+		}
+		full, err := provenance.BuildFromRecording(rec, store, goal, provenance.Options{})
+		if err != nil {
+			t.Fatalf("BuildFromRecording(%s): %v", goalStr, err)
+		}
+		a, b := p2pIDSet(simple), p2pIDSet(full)
+		for id := range a {
+			if !b[id] {
+				t.Errorf("%s: node id %s present in post-hoc but missing in recording mode", goalStr, id)
+			}
+		}
+		for id := range b {
+			if !a[id] {
+				t.Errorf("%s: node id %s present in recording mode but missing in post-hoc", goalStr, id)
+			}
+		}
+		if simple[0].ID != full[0].ID {
+			t.Errorf("%s: root id differs across modes: %q vs %q", goalStr, simple[0].ID, full[0].ID)
+		}
+		if simple[0].RuleID != full[0].RuleID {
+			t.Errorf("%s: rule id differs across modes: %q vs %q", goalStr, simple[0].RuleID, full[0].RuleID)
+		}
+	}
+}
