index 0000000000000000000000000000000000000000..15e09c6a60a7e6148c1d6894a9c253337503d8f5
--- /dev/null
+++ b/tests/f2p/analysis_test.go
@@ -0,0 +1,999 @@
+package f2p
+
+import (
+	"fmt"
+	"go/ast"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// constructionAnalysis separates the code that produces the proof slices
+// returned by Explain and BuildFromRecording from the code that only supplies
+// mode-specific premises. It never depends on private symbol names: the
+// construction component is identified by the value flow of each entry
+// point's returned proof slice, and ownership of a responsibility is
+// attributed to the function that directly performs it.
+type constructionAnalysis struct {
+	m    *moduleModel
+	pkg  *pkgModel
+	post *fnInfo
+	rec  *fnInfo
+
+	reachE, reachR   map[string]bool // any-edge reachability from each entry
+	strongE, strongR map[string]bool // statically pinned calls only
+	instE, instR     map[string]bool // struct types constructed in each strong region
+	strongCallers    map[string][]string
+
+	attrE, attrR map[string]bool
+	region       []*fnInfo
+	byKey        map[string]*fnInfo
+}
+
+func newConstructionAnalysis(t *testing.T) *constructionAnalysis {
+	t.Helper()
+	m := moduleSources(t)
+	pkg := m.pkgs[m.modPath+"/provenance"]
+	if pkg == nil {
+		t.Fatalf("package %s/provenance not found in module sources", m.modPath)
+	}
+	post := pkg.fn(entryPostHoc)
+	rec := pkg.fn(entryRecording)
+	if post == nil || rec == nil {
+		t.Fatalf("provenance package must keep the public entry points %s and %s", entryPostHoc, entryRecording)
+	}
+	a := &constructionAnalysis{
+		m: m, pkg: pkg, post: post, rec: rec,
+		reachE: m.reach(post, false), reachR: m.reach(rec, false),
+		strongE: m.reach(post, true), strongR: m.reach(rec, true),
+		strongCallers: m.strongCallers(),
+		byKey:         map[string]*fnInfo{},
+	}
+	a.instE = m.instantiatedStructs(a.strongE)
+	a.instR = m.instantiatedStructs(a.strongR)
+	for _, f := range pkg.funcs {
+		if a.reachE[f.key] || a.reachR[f.key] {
+			a.region = append(a.region, f)
+			a.byKey[f.key] = f
+		}
+	}
+	sort.Slice(a.region, func(i, j int) bool { return a.region[i].key < a.region[j].key })
+	a.attribute()
+	return a
+}
+
+// attribute partitions the region into code private to one entry point and
+// code both entry points can use. A function is entry-private when its
+// receiver type is only constructed in one entry's statically pinned region,
+// or when every pinned call site that can reach it belongs to one entry.
+func (a *constructionAnalysis) attribute() {
+	a.attrE = map[string]bool{}
+	a.attrR = map[string]bool{}
+	for _, f := range a.region {
+		if f.recv != "" {
+			if a.instE[f.recv] && !a.instR[f.recv] {
+				a.attrE[f.key] = true
+			}
+			if a.instR[f.recv] && !a.instE[f.recv] {
+				a.attrR[f.key] = true
+			}
+		}
+		if a.sharedType(f.recv) {
+			// Methods of a component type constructed in both entry points
+			// belong to the shared component even when only one mode
+			// currently calls one of them.
+			continue
+		}
+		if a.strongE[f.key] && !a.reachR[f.key] {
+			a.attrE[f.key] = true
+		}
+		if a.strongR[f.key] && !a.reachE[f.key] {
+			a.attrR[f.key] = true
+		}
+	}
+	for pass := 0; pass < 8; pass++ {
+		changed := false
+		for _, f := range a.region {
+			if a.attrE[f.key] || a.attrR[f.key] || a.sharedType(f.recv) {
+				continue
+			}
+			callers := a.strongCallers[f.key]
+			if len(callers) == 0 {
+				continue
+			}
+			allE, allR := true, true
+			for _, ck := range callers {
+				if !(a.attrE[ck] || ck == a.post.key) {
+					allE = false
+				}
+				if !(a.attrR[ck] || ck == a.rec.key) {
+					allR = false
+				}
+			}
+			switch {
+			case allE && !allR && !a.strongR[f.key]:
+				a.attrE[f.key] = true
+				changed = true
+			case allR && !allE && !a.strongE[f.key]:
+				a.attrR[f.key] = true
+				changed = true
+			}
+		}
+		if !changed {
+			return
+		}
+	}
+}
+
+// sharedType reports whether the receiver type is constructed by both entry
+// points' statically pinned construction code.
+func (a *constructionAnalysis) sharedType(recv string) bool {
+	return recv != "" && a.instE[recv] && a.instR[recv]
+}
+
+// entryPrivate reports whether f is used by exactly one of the two entry
+// points and therefore cannot be the shared construction component.
+func (a *constructionAnalysis) entryPrivate(f *fnInfo) bool {
+	e, r := a.attrE[f.key], a.attrR[f.key]
+	return e != r
+}
+
+// shared reports whether f belongs to code that both entry points can use.
+func (a *constructionAnalysis) shared(f *fnInfo) bool { return !a.entryPrivate(f) }
+
+func (a *constructionAnalysis) location(f *fnInfo) string {
+	return fmt.Sprintf("%s:%d (%s)", f.file, f.startLine, f.key)
+}
+
+func (a *constructionAnalysis) locations(fns []*fnInfo) string {
+	var out []string
+	for _, f := range fns {
+		out = append(out, a.location(f))
+	}
+	sort.Strings(out)
+	return strings.Join(out, "\n  ")
+}
+
+func (a *constructionAnalysis) keys(m map[string]bool) []string {
+	var out []string
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// --- returned proof-slice value flow ---
+
+func isNilExpr(e ast.Expr) bool {
+	id, ok := e.(*ast.Ident)
+	return ok && id.Name == "nil"
+}
+
+// proofReturns lists the expressions a function returns as its first
+// ([]*ProofNode) result. Returns nested inside function literals are ignored:
+// they are not the declaration's own value.
+func (a *constructionAnalysis) proofReturns(f *fnInfo) []ast.Expr {
+	if f == nil || f.decl == nil || f.decl.Body == nil || !f.returnsProofSlice() {
+		return nil
+	}
+	var out []ast.Expr
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if _, ok := n.(*ast.FuncLit); ok {
+			return false
+		}
+		rs, ok := n.(*ast.ReturnStmt)
+		if !ok || len(rs.Results) == 0 {
+			return true
+		}
+		first := rs.Results[0]
+		if isNilExpr(first) {
+			return true
+		}
+		out = append(out, first)
+		return true
+	})
+	return out
+}
+
+// exprProducers resolves which functions can produce the value of an
+// expression: calls to a pinned function, or identifiers assigned from such
+// calls. weak=true means the value is produced locally or through dynamic
+// dispatch and cannot be traced further.
+func (a *constructionAnalysis) exprProducers(f *fnInfo, e ast.Expr) (targets []string, weak bool) {
+	switch x := e.(type) {
+	case *ast.ParenExpr:
+		return a.exprProducers(f, x.X)
+	case *ast.CallExpr:
+		ts, w := a.m.resolveCall(f, x)
+		if w || len(ts) == 0 {
+			return nil, true
+		}
+		return ts, false
+	case *ast.Ident:
+		if x.Name == "nil" {
+			return nil, false
+		}
+		rhs := f.assigns[x.Name]
+		if len(rhs) == 0 {
+			return nil, true
+		}
+		var out []string
+		weak := false
+		for _, r := range rhs {
+			ts, w := a.exprProducers(f, r)
+			if w || len(ts) == 0 {
+				weak = true
+			}
+			out = append(out, ts...)
+		}
+		if weak {
+			return nil, true
+		}
+		sort.Strings(out)
+		return dedupeSorted(out), false
+	}
+	return nil, true
+}
+
+// frontier returns the functions at which the value flow of the entry's
+// returned proof slice terminates: the functions that actually build the
+// returned slice. Thin forwarders are traversed; dynamic dispatch stops the
+// trace at the calling function because no further identity is provable.
+func (a *constructionAnalysis) frontier(entry *fnInfo) map[string]bool {
+	frontier := map[string]bool{}
+	visited := map[string]bool{entry.key: true}
+	var expand func(f *fnInfo)
+	expand = func(f *fnInfo) {
+		terminal := false
+		for _, e := range a.proofReturns(f) {
+			targets, weak := a.exprProducers(f, e)
+			if weak || len(targets) == 0 {
+				terminal = true
+				continue
+			}
+			for _, k := range targets {
+				if visited[k] {
+					continue
+				}
+				g := a.byKey[k]
+				if g == nil {
+					terminal = true
+					continue
+				}
+				visited[k] = true
+				expand(g)
+			}
+		}
+		if terminal {
+			frontier[f.key] = true
+		}
+	}
+	expand(entry)
+	return frontier
+}
+
+// --- responsibility detectors ---
+
+func (a *constructionAnalysis) assignedLHS(f *fnInfo) map[ast.Node]bool {
+	lhsNodes := map[ast.Node]bool{}
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		switch s := n.(type) {
+		case *ast.AssignStmt:
+			for _, l := range s.Lhs {
+				lhsNodes[l] = true
+			}
+		case *ast.IncDecStmt:
+			lhsNodes[s.X] = true
+		}
+		return true
+	})
+	return lhsNodes
+}
+
+// writesOptionsFields reports whether the function directly assigns one of
+// the frozen Options fields, or builds an Options value carrying them.
+func (a *constructionAnalysis) writesOptionsFields(f *fnInfo) bool {
+	found := false
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if found {
+			return false
+		}
+		switch s := n.(type) {
+		case *ast.AssignStmt:
+			for _, l := range s.Lhs {
+				if sel, ok := l.(*ast.SelectorExpr); ok && (sel.Sel.Name == "MaxProofs" || sel.Sel.Name == "MaxDepth") {
+					found = true
+				}
+			}
+		case *ast.IncDecStmt:
+			if sel, ok := s.X.(*ast.SelectorExpr); ok && (sel.Sel.Name == "MaxProofs" || sel.Sel.Name == "MaxDepth") {
+				found = true
+			}
+		case *ast.CompositeLit:
+			name, _ := bareTypeName(s.Type)
+			if name != "Options" {
+				return true
+			}
+			for _, el := range s.Elts {
+				if kv, ok := el.(*ast.KeyValueExpr); ok {
+					if id, ok := kv.Key.(*ast.Ident); ok && (id.Name == "MaxProofs" || id.Name == "MaxDepth") {
+						found = true
+					}
+				}
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// returnsErrGoalNotGround reports whether the function's own body returns the
+// frozen ErrGoalNotGround sentinel.
+func (a *constructionAnalysis) returnsErrGoalNotGround(f *fnInfo) bool {
+	found := false
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if found {
+			return false
+		}
+		rs, ok := n.(*ast.ReturnStmt)
+		if !ok {
+			return true
+		}
+		for _, r := range rs.Results {
+			if id, ok := r.(*ast.Ident); ok && id.Name == "ErrGoalNotGround" {
+				found = true
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// maxDepthReads reports whether the function reads the frozen MaxDepth option
+// field anywhere (comparison, local hoist, arithmetic or otherwise).
+func (a *constructionAnalysis) maxDepthReads(f *fnInfo) bool {
+	lhs := a.assignedLHS(f)
+	found := false
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if found {
+			return false
+		}
+		sel, ok := n.(*ast.SelectorExpr)
+		if !ok || sel.Sel.Name != "MaxDepth" {
+			return true
+		}
+		if lhs[sel] {
+			return true
+		}
+		found = true
+		return true
+	})
+	return found
+}
+
+// proofNodeFieldWrites walks the function body, resolving composite literals
+// (including elided element literals of proof-slice literals) and field
+// assignments to the frozen ProofNode fields.
+func (a *constructionAnalysis) proofNodeFieldWrites(f *fnInfo, wanted map[string]bool) []string {
+	var hits []string
+	lhs := a.assignedLHS(f)
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		switch s := n.(type) {
+		case *ast.CompositeLit:
+			typ := ""
+			if s.Type != nil {
+				typ = typeString(s.Type)
+			} else {
+				typ = elidedProofHint
+			}
+			if isProofValueType(f.pkg, typ) {
+				for _, el := range s.Elts {
+					kv, ok := el.(*ast.KeyValueExpr)
+					if !ok {
+						continue
+					}
+					if id, ok := kv.Key.(*ast.Ident); ok && wanted[id.Name] {
+						hits = append(hits, id.Name)
+					}
+				}
+			}
+			// elided composites inside []*ProofNode{...} / []ProofNode{...}
+			if et := elemType(f.pkg.resolve(typ)); et != "" && isProofValueType(f.pkg, et) {
+				for _, el := range s.Elts {
+					inner, ok := el.(*ast.CompositeLit)
+					if !ok || inner.Type != nil {
+						continue
+					}
+					for _, iel := range inner.Elts {
+						kv, ok := iel.(*ast.KeyValueExpr)
+						if !ok {
+							continue
+						}
+						if id, ok := kv.Key.(*ast.Ident); ok && wanted[id.Name] {
+							hits = append(hits, id.Name)
+						}
+					}
+				}
+			}
+		case *ast.AssignStmt:
+			for _, l := range s.Lhs {
+				sel, ok := l.(*ast.SelectorExpr)
+				if !ok || !wanted[sel.Sel.Name] {
+					continue
+				}
+				base := f.pkg.resolve(strings.TrimPrefix(a.m.exprType(f, sel.X), "*"))
+				if isProofValueType(f.pkg, base) {
+					hits = append(hits, sel.Sel.Name)
+				}
+			}
+		}
+		return true
+	})
+	_ = lhs
+	return hits
+}
+
+// elidedProofHint marks composite literals without an explicit type; the
+// caller resolves them through their slice element hint.
+const elidedProofHint = ""
+
+func isProofValueType(pkg *pkgModel, t string) bool {
+	t = strings.ReplaceAll(pkg.resolve(t), " ", "")
+	switch t {
+	case "ProofNode", "*ProofNode", "provenance.ProofNode", "*provenance.ProofNode":
+		return true
+	}
+	return false
+}
+
+func (a *constructionAnalysis) assemblesProofNode(f *fnInfo) bool {
+	if len(a.proofNodeFieldWrites(f, proofNodeFields)) > 0 {
+		return true
+	}
+	found := false
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if found {
+			return false
+		}
+		switch s := n.(type) {
+		case *ast.CompositeLit:
+			if s.Type != nil && isProofValueType(f.pkg, typeString(s.Type)) {
+				found = true
+			}
+		case *ast.CallExpr:
+			if id, ok := s.Fun.(*ast.Ident); ok && id.Name == "new" && len(s.Args) == 1 {
+				if name, ok := bareTypeName(s.Args[0]); ok && isProofValueType(f.pkg, name) {
+					found = true
+				}
+			}
+		}
+		return true
+	})
+	return found
+}
+
+var proofNodeFields = map[string]bool{
+	"ID": true, "Fact": true, "Kind": true, "Rule": true, "RuleID": true,
+	"Bindings": true, "Premises": true, "GroupKey": true, "TransformText": true,
+	"Partial": true,
+}
+
+func (a *constructionAnalysis) stampsNodeID(f *fnInfo) bool {
+	if len(a.proofNodeFieldWrites(f, map[string]bool{"ID": true})) == 0 {
+		return false
+	}
+	return a.reachesContentAddressedID(f, map[string]bool{})
+}
+
+// reachesContentAddressedID reports whether the function (or a function it
+// calls) builds the frozen "/proof/" or "/rule/" identifiers.
+func (a *constructionAnalysis) reachesContentAddressedID(f *fnInfo, seen map[string]bool) bool {
+	if seen[f.key] {
+		return false
+	}
+	seen[f.key] = true
+	if hasIDPrefixLiteral(f) {
+		return true
+	}
+	for _, cs := range f.calls {
+		for _, k := range cs.targets {
+			if g := a.byKey[k]; g != nil {
+				if a.reachesContentAddressedID(g, seen) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func hasIDPrefixLiteral(f *fnInfo) bool {
+	found := false
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if found {
+			return false
+		}
+		bl, ok := n.(*ast.BasicLit)
+		if !ok {
+			return true
+		}
+		v := strings.Trim(bl.Value, `"`)
+		if strings.HasPrefix(v, "/proof/") || strings.HasPrefix(v, "/rule/") {
+			found = true
+		}
+		return true
+	})
+	return found
+}
+
+// depthHandling reports whether the function turns the MaxDepth option into
+// a depth truncation decision: it reads the option and either compares a
+// depth value while doing so or marks a proof node Partial. Merely forwarding
+// the configured limit is not ownership of the depth handling.
+func (a *constructionAnalysis) depthHandling(f *fnInfo) bool {
+	if !a.maxDepthReads(f) {
+		return false
+	}
+	if len(a.proofNodeFieldWrites(f, map[string]bool{"Partial": true})) > 0 {
+		return true
+	}
+	found := false
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if found {
+			return false
+		}
+		be, ok := n.(*ast.BinaryExpr)
+		if !ok {
+			return true
+		}
+		if exprMentionsIdent(be.X, "depth") || exprMentionsIdent(be.Y, "depth") {
+			found = true
+		}
+		return true
+	})
+	return found
+}
+
+func exprMentionsIdent(e ast.Expr, name string) bool {
+	switch t := e.(type) {
+	case nil:
+		return false
+	case *ast.Ident:
+		return t.Name == name
+	case *ast.ParenExpr:
+		return exprMentionsIdent(t.X, name)
+	case *ast.UnaryExpr:
+		return exprMentionsIdent(t.X, name)
+	case *ast.BinaryExpr:
+		return exprMentionsIdent(t.X, name) || exprMentionsIdent(t.Y, name)
+	case *ast.SelectorExpr:
+		return exprMentionsIdent(t.X, name)
+	case *ast.CallExpr:
+		for _, arg := range t.Args {
+			if exprMentionsIdent(arg, name) {
+				return true
+			}
+		}
+		return exprMentionsIdent(t.Fun, name)
+	case *ast.IndexExpr:
+		return exprMentionsIdent(t.X, name) || exprMentionsIdent(t.Index, name)
+	}
+	return false
+}
+
+// --- construction state (memo / cycle / rule-ID maps) ---
+
+type stateKind int
+
+const (
+	stateProof stateKind = iota
+	stateBool
+	stateString
+)
+
+type stateAccess struct {
+	fn    *fnInfo
+	typ   string // struct type declaring the field, "" when accessed through a local
+	field string
+	kind  stateKind
+	write bool
+	line  int
+}
+
+func stateKindOf(pkg *pkgModel, t string) (stateKind, bool) {
+	t = strings.ReplaceAll(pkg.resolve(t), " ", "")
+	switch t {
+	case "[]*ProofNode", "[]ProofNode", "[]*provenance.ProofNode", "[]provenance.ProofNode":
+		return stateProof, true
+	case "bool":
+		return stateBool, true
+	case "string":
+		return stateString, true
+	}
+	return 0, false
+}
+
+// stateAccesses lists every read or write of a map whose value type is a
+// proof slice, a bool, or a string, together with the struct field it lives in
+// when the access goes through one.
+func (a *constructionAnalysis) stateAccesses(f *fnInfo) []stateAccess {
+	var out []stateAccess
+	record := func(index *ast.IndexExpr, write bool) {
+		container := a.m.exprType(f, index.X)
+		if container == "" {
+			return
+		}
+		_ = f.pkg
+		_, val, ok := parseMapType(f.pkg.resolve(container))
+		if !ok {
+			return
+		}
+		kind, ok := stateKindOf(f.pkg, val)
+		if !ok {
+			return
+		}
+		acc := stateAccess{fn: f, kind: kind, write: write, line: f.pkg.fset.Position(index.Pos()).Line}
+		if sel, ok := index.X.(*ast.SelectorExpr); ok {
+			acc.field = sel.Sel.Name
+			acc.typ = strings.TrimPrefix(f.pkg.resolve(a.m.exprType(f, sel.X)), "*")
+			if owner, _, ok := f.pkg.promotedField(acc.typ, sel.Sel.Name, map[string]bool{}); ok {
+				acc.typ = owner
+			}
+		}
+		out = append(out, acc)
+	}
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		switch s := n.(type) {
+		case *ast.AssignStmt:
+			for _, l := range s.Lhs {
+				if idx, ok := l.(*ast.IndexExpr); ok {
+					record(idx, true)
+				}
+			}
+		case *ast.IndexExpr:
+			record(s, false)
+		case *ast.RangeStmt:
+			if idx, ok := s.X.(*ast.IndexExpr); ok {
+				record(idx, false)
+			}
+		}
+		return true
+	})
+	return out
+}
+
+// stateAccessAll returns every state access in the region.
+func (a *constructionAnalysis) stateAccessAll() []stateAccess {
+	var out []stateAccess
+	for _, f := range a.region {
+		out = append(out, a.stateAccesses(f)...)
+	}
+	return out
+}
+
+// compositionEdges follows actual field accesses in the shared construction
+// region, including promoted fields. An unused field or an unrelated local
+// type cannot lend its state to a component merely by having a matching type.
+func (a *constructionAnalysis) compositionEdges() map[string]map[string]bool {
+	edges := map[string]map[string]bool{}
+	add := func(parent, child string) {
+		if parent == child || !a.sharedType(parent) || a.pkg.structs[child] == nil {
+			return
+		}
+		if edges[parent] == nil {
+			edges[parent] = map[string]bool{}
+		}
+		edges[parent][child] = true
+	}
+	for _, f := range a.region {
+		ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+			sel, ok := n.(*ast.SelectorExpr)
+			if !ok {
+				return true
+			}
+			parent := strings.TrimPrefix(f.pkg.resolve(a.m.exprType(f, sel.X)), "*")
+			owner, fieldType, ok := f.pkg.promotedField(parent, sel.Sel.Name, map[string]bool{})
+			if ok {
+				add(parent, owner)
+				add(owner, strings.TrimPrefix(f.pkg.resolve(fieldType), "*"))
+			}
+			return true
+		})
+	}
+	return edges
+}
+
+func compositionContains(edges map[string]map[string]bool, parent, child string, seen map[string]bool) bool {
+	if parent == child {
+		return true
+	}
+	if seen[parent] {
+		return false
+	}
+	seen[parent] = true
+	for nested := range edges[parent] {
+		if compositionContains(edges, nested, child, seen) {
+			return true
+		}
+	}
+	return false
+}
+
+// stateTypes attributes observed state accesses to the component that owns
+// them, allowing private composition instead of requiring all maps to be
+// declared directly on one struct. Full nested helpers are counted with their
+// outer component, while separate construction roots remain separate.
+func (a *constructionAnalysis) stateTypes() map[string]map[stateKind]bool {
+	out := map[string]map[stateKind]bool{}
+	for _, acc := range a.stateAccessAll() {
+		if acc.typ == "" {
+			continue
+		}
+		if out[acc.typ] == nil {
+			out[acc.typ] = map[stateKind]bool{}
+		}
+		out[acc.typ][acc.kind] = true
+	}
+	edges := a.compositionEdges()
+	for changed := true; changed; {
+		changed = false
+		for parent, children := range edges {
+			if out[parent] == nil {
+				out[parent] = map[stateKind]bool{}
+			}
+			for child := range children {
+				for kind := range out[child] {
+					if !out[parent][kind] {
+						out[parent][kind] = true
+						changed = true
+					}
+				}
+			}
+		}
+	}
+	// Do not merge sibling roots or resolve a cycle by arbitrarily selecting
+	// one owner. Only an acyclic enclosing component subsumes a full helper.
+	nested := map[string]bool{}
+	for parent, kinds := range out {
+		if len(kinds) != 3 {
+			continue
+		}
+		for child, childKinds := range out {
+			if parent != child && len(childKinds) == 3 &&
+				compositionContains(edges, parent, child, map[string]bool{}) &&
+				!compositionContains(edges, child, parent, map[string]bool{}) {
+				nested[child] = true
+			}
+		}
+	}
+	for child := range nested {
+		delete(out, child)
+	}
+	return out
+}
+
+// --- mode-specific premise sources ---
+
+func (a *constructionAnalysis) ownStoreQuery(f *fnInfo) bool {
+	found := false
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if found {
+			return false
+		}
+		call, ok := n.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		sel, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		switch sel.Sel.Name {
+		case "GetFacts", "Contains", "ListPredicates", "EstimateFactCount":
+			recv := f.pkg.resolve(a.m.exprType(f, sel.X))
+			if recv == "" || strings.Contains(recv, "FactStore") {
+				found = true
+			}
+		}
+		return true
+	})
+	return found
+}
+
+// referencesStore reports whether the function queries the fact store itself
+// or strongly delegates to code that does. Dynamic calls are not traversed.
+func (a *constructionAnalysis) referencesStore() map[string]bool {
+	out := map[string]bool{}
+	for _, f := range a.region {
+		if a.ownStoreQuery(f) {
+			out[f.key] = true
+		}
+	}
+	for pass := 0; pass < 8; pass++ {
+		changed := false
+		for _, f := range a.region {
+			if out[f.key] || a.shared(f) {
+				continue
+			}
+			for _, cs := range f.calls {
+				if cs.weak {
+					continue
+				}
+				for _, k := range cs.targets {
+					if out[k] {
+						out[f.key] = true
+						changed = true
+					}
+				}
+			}
+		}
+		if !changed {
+			break
+		}
+	}
+	return out
+}
+
+func (a *constructionAnalysis) ownRecorderAccess(f *fnInfo) bool {
+	found := false
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if found {
+			return false
+		}
+		switch s := n.(type) {
+		case *ast.SelectorExpr:
+			switch s.Sel.Name {
+			case "EventsFor", "MemoryRecorder":
+				found = true
+			case "Events":
+				recv := f.pkg.resolve(a.m.exprType(f, s.X))
+				if strings.Contains(recv, "MemoryRecorder") {
+					found = true
+				}
+			}
+		case *ast.Ident:
+			if s.Name == "MemoryRecorder" {
+				found = true
+			}
+		}
+		return true
+	})
+	return found
+}
+
+func (a *constructionAnalysis) referencesRecorder() map[string]bool {
+	out := map[string]bool{}
+	for _, f := range a.region {
+		if a.ownRecorderAccess(f) {
+			out[f.key] = true
+		}
+	}
+	for pass := 0; pass < 8; pass++ {
+		changed := false
+		for _, f := range a.region {
+			if out[f.key] || a.shared(f) {
+				continue
+			}
+			for _, cs := range f.calls {
+				if cs.weak {
+					continue
+				}
+				for _, k := range cs.targets {
+					if out[k] {
+						out[f.key] = true
+						changed = true
+					}
+				}
+			}
+		}
+		if !changed {
+			break
+		}
+	}
+	return out
+}
+
+// --- entry error value flow (ground-goal rejection) ---
+
+func (a *constructionAnalysis) errorOrigins(f *fnInfo) []string {
+	var out []string
+	seen := map[string]bool{}
+	add := func(k string) {
+		if !seen[k] {
+			seen[k] = true
+			out = append(out, k)
+		}
+	}
+	ast.Inspect(f.decl.Body, func(n ast.Node) bool {
+		if _, ok := n.(*ast.FuncLit); ok {
+			return false
+		}
+		rs, ok := n.(*ast.ReturnStmt)
+		if !ok || len(rs.Results) == 0 {
+			return true
+		}
+		x := rs.Results[len(rs.Results)-1]
+		if len(rs.Results) == 1 {
+			if !f.returnsError() {
+				return true
+			}
+			switch x.(type) {
+			case *ast.CallExpr, *ast.Ident:
+			default:
+				return true
+			}
+		}
+		if isNilExpr(x) {
+			return true
+		}
+		a.originKeys(f, x, add, map[ast.Expr]bool{})
+		return true
+	})
+	sort.Strings(out)
+	return out
+}
+
+func (a *constructionAnalysis) originKeys(f *fnInfo, e ast.Expr, add func(string), seen map[ast.Expr]bool) {
+	if e == nil || seen[e] {
+		return
+	}
+	seen[e] = true
+	switch x := e.(type) {
+	case *ast.ParenExpr:
+		a.originKeys(f, x.X, add, seen)
+	case *ast.CallExpr:
+		ts, weak := a.m.resolveCall(f, x)
+		if weak {
+			return
+		}
+		for _, t := range ts {
+			add(t)
+		}
+	case *ast.Ident:
+		for _, rhs := range f.assigns[x.Name] {
+			a.originKeys(f, rhs, add, seen)
+		}
+	}
+}
+
+// groundErrorChains returns, for each error value returned by the entry, the
+// chain of functions that produce it, stopping at (and including) functions
+// that directly return ErrGoalNotGround. Only chains that end in a ground
+// rejection are reported.
+func (a *constructionAnalysis) groundErrorChains(entry *fnInfo) [][]string {
+	var chains [][]string
+	var walk func(key string, path []string, seen map[string]bool)
+	walk = func(key string, path []string, seen map[string]bool) {
+		if len(path) > 8 || seen[key] {
+			return
+		}
+		g := a.byKey[key]
+		if g == nil {
+			return
+		}
+		seen[key] = true
+		path = append(path, key)
+		if a.returnsErrGoalNotGround(g) {
+			chains = append(chains, append([]string(nil), path...))
+			return
+		}
+		for _, k := range a.errorOrigins(g) {
+			walk(k, path, seen)
+		}
+	}
+	for _, o := range a.errorOrigins(entry) {
+		walk(o, nil, map[string]bool{})
+	}
+	return chains
+}
+
+// --- aggregate ownership view ---
+
+func (a *constructionAnalysis) isConstructionOwner(f *fnInfo) bool {
+	if a.writesOptionsFields(f) || a.returnsErrGoalNotGround(f) ||
+		a.depthHandling(f) || a.assemblesProofNode(f) || a.stampsNodeID(f) {
+		return true
+	}
+	return len(a.stateAccesses(f)) > 0
+}
