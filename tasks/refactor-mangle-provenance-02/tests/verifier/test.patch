+// TestP2PMemoizationIsolationAcrossCalls pins that memoization does not leak
+// across entry-point calls: the same goal atom proved against a different
+// program/store must use that call's own derivation, and repeating an
+// identical call must reproduce the same identifiers.
+func TestP2PMemoizationIsolationAcrossCalls(t *testing.T) {
+	pi1, store1 := p2pEvalProgram(t, `bar(1). foo(X) :- bar(X).`, nil)
+	pi2, store2 := p2pEvalProgram(t, `bar(1). baz(1). foo(X) :- bar(X), baz(X).`, nil)
+	goal := p2pAtom(t, "foo(1)")
+
+	first, err := provenance.Explain(pi1, store1, goal, provenance.Options{})
+	if err != nil {
+		t.Fatalf("Explain #1: %v", err)
+	}
+	second, err := provenance.Explain(pi2, store2, goal, provenance.Options{})
+	if err != nil {
+		t.Fatalf("Explain #2: %v", err)
+	}
+	if len(first[0].Premises) != 1 {
+		t.Errorf("first call: got %d premises, want 1", len(first[0].Premises))
+	}
+	if len(second[0].Premises) != 2 {
+		t.Errorf("second call: got %d premises, want 2 (memoization leaked across calls?)", len(second[0].Premises))
+	}
+	if first[0].ID == second[0].ID {
+		t.Errorf("different derivations must not share a proof id: %q", first[0].ID)
+	}
+
+	again, err := provenance.Explain(pi1, store1, goal, provenance.Options{})
+	if err != nil {
+		t.Fatalf("Explain #1 repeated: %v", err)
+	}
+	if again[0].ID != first[0].ID {
+		t.Errorf("repeated identical call changed the proof id: %q vs %q", again[0].ID, first[0].ID)
+	}
+}
