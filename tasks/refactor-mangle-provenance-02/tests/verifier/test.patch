+// TestP2PEmitFactsSharedSubProofReference pins the printed-tree reference to
+// shared subproofs by identifier and the deduplication of emitted facts.
+func TestP2PEmitFactsSharedSubProofReference(t *testing.T) {
+	for label, proofs := range p2pFrozenOutputCases(t) {
+		p2pAssertFrozenOutput(t, label, proofs)
+	}
+	source := `
+		bar(1).
+		baz(1).
+		qux(1).
+		foo1(X) :- bar(X), baz(X).
+		foo2(X) :- bar(X), qux(X).
+		both(X) :- foo1(X), foo2(X).
+	`
+	pi, store := p2pEvalProgram(t, source, nil)
+	proofs, err := provenance.Explain(pi, store, p2pAtom(t, "both(1)"), provenance.Options{})
+	if err != nil {
+		t.Fatalf("Explain: %v", err)
+	}
+	printed := p2pPrintOutput(t, proofs)
+	if !strings.Contains(printed, "... see /proof/") {
+		t.Errorf("printed tree must reference shared subproofs by id:\n%s", printed)
+	}
+
+	out := factstore.NewSimpleInMemoryStore()
+	if err := provenance.EmitFacts(proofs, &out); err != nil {
+		t.Fatalf("EmitFacts: %v", err)
+	}
+	var barLeaves int
+	for _, p := range out.ListPredicates() {
+		if p.Symbol != "edb_leaf" {
+			continue
+		}
+		out.GetFacts(ast.NewQuery(p), func(a ast.Atom) error {
+			if strings.Contains(a.Args[1].String(), "bar") {
+				barLeaves++
+			}
+			return nil
+		})
+	}
+	if barLeaves != 1 {
+		t.Errorf("shared bar(1) leaf emitted %d times, want 1 (deduplicated by id)", barLeaves)
+	}
+}
