+def test_threaded_shutdown_stops_worker_and_later_strokes(make_engine):
+    class ThreadedMachine(ThreadedStenotypeBase):
+        instance = None
+
+        def __init__(self, options):
+            super().__init__()
+            self.options = options
+            self.daemon = True
+            self.request_stroke = threading.Event()
+            self.stroke_sent = threading.Event()
+            self.worker_exited = threading.Event()
+            self.stop_calls = 0
+
+        @classmethod
+        def get_keys(cls):
+            return system.KEYS
+
+        @classmethod
+        def get_option_info(cls):
+            return {"option": ("default", str)}
+
+        def start_capture(self):
+            type(self).instance = self
+            super().start_capture()
+
+        def run(self):
+            try:
+                self._ready()
+                while True:
+                    self.request_stroke.wait()
+                    self.request_stroke.clear()
+                    if self.finished.is_set():
+                        return
+                    self._notify(("S-", "T-"))
+                    self.stroke_sent.set()
+            finally:
+                self.worker_exited.set()
+
+        def stop_capture(self):
+            self.stop_calls += 1
+            self.finished.set()
+            self.request_stroke.set()
+            super().stop_capture()
+            type(self).instance = None
+
+    registry.register_plugin("machine", PRIMARY_MACHINE_TYPE, ThreadedMachine)
+    engine = make_engine(engine_class=ThreadAwareEngine)
+    assert engine.load_config()
+
+    def run_engine():
+        engine.engine_thread_ident = threading.get_ident()
+        engine.run()
+
+    engine_thread = threading.Thread(target=run_engine, daemon=True)
+    engine_thread.start()
+    assert wait_for(lambda: engine.engine_thread_ident is not None)
+    machine = None
+    try:
+        engine.start()
+        assert wait_for(lambda: engine.machine_state == STATE_RUNNING)
+        machine = ThreadedMachine.instance
+        assert machine is not None and machine.is_alive()
+        machine.request_stroke.set()
+        assert machine.stroke_sent.wait(5)
+        assert wait_for(lambda: len(engine.hooks("stroked")) == 1)
+        engine.quit(0)
+        engine_thread.join(10)
+        assert not engine_thread.is_alive(), "quit must complete after stopping capture"
+        assert machine.stop_calls == 1
+        assert machine.finished.is_set()
+        assert machine.worker_exited.is_set()
+        assert not machine.is_alive(), "capture worker must have exited before quit completes"
+        assert ThreadedMachine.instance is None
+        events = list(engine.events)
+        machine.request_stroke.set()
+        assert engine.events == events
+    finally:
+        if machine is not None:
+            machine.finished.set()
+            machine.request_stroke.set()
+            machine.join(5)
+        if engine_thread.is_alive():
+            engine.quit(0)
+            engine_thread.join(10)
+
