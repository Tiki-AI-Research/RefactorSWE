+def test_command_resume_and_toggle_delegate_last_stroke_suppression(make_engine):
+    engine = make_engine()
+    assert engine.load_config()
+    engine.start()
+    machine = PrimaryRecordingMachine.instance
+    output = engine._keyboard_emulation
+
+    def suppress(machine, send_backspaces):
+        machine.calls.append("suppress_last_stroke")
+        send_backspaces(7)
+
+    with mock.patch.object(PrimaryRecordingMachine, "suppress_last_stroke", suppress):
+        for command in ("resume", "toggle"):
+            engine.set_output(False)
+            machine.calls.clear()
+            engine.events.clear()
+            output.backspaces.clear()
+            engine._send_engine_command(command)
+            assert engine.output is True
+            assert machine.calls == [("set_suppression", True), "suppress_last_stroke"]
+            assert engine.output_events() == [(True,)]
+            assert output.backspaces == [7], "the plugin must receive the real output callback"
+        machine.calls.clear()
+        output.backspaces.clear()
+        engine._send_engine_command("resume")
+        assert machine.calls == [], "already-enabled commands must not suppress a previous stroke"
+        assert output.backspaces == []
