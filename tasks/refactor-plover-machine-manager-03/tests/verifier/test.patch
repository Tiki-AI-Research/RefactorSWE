+def test_config_update_loads_dictionaries_after_config_changed(make_engine, tmp_path):
+    first_path = tmp_path / "p2p_first.json"
+    second_path = tmp_path / "p2p_second.json"
+    first_path.write_text(json.dumps({"SKP": "and"}), encoding="utf-8")
+    second_path.write_text(json.dumps({"SKP": "or"}), encoding="utf-8")
+    engine = make_engine(dictionaries=[DictionaryConfig(str(first_path), True)])
+    assert engine.load_config()
+    engine.start()
+    assert engine.lookup(("SKP",)) == "and"
+    engine.events.clear()
+    dictionaries = [DictionaryConfig(str(second_path), True)]
+    engine.config = {"dictionaries": dictionaries}
+    hook_names = [hook for hook, _, _ in engine.events]
+    assert hook_names[0] == "config_changed"
+    assert engine.events[0] == ("config_changed", ({"dictionaries": dictionaries},), {})
+    assert "dictionaries_loaded" in hook_names
+    assert hook_names.index("config_changed") < hook_names.index("dictionaries_loaded")
+    assert engine.hooks("machine_state_changed") == []
+    assert engine.lookup(("SKP",)) == "or"
