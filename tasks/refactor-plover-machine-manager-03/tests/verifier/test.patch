+def test_forced_reconnection_rebuilds_machine_instance(make_engine):
+    engine = make_engine()
+    assert engine.load_config()
+    engine.start()
+    previous = PrimaryRecordingMachine.instance
+    engine.events.clear()
+    result = engine.reset_machine()
+    assert result is None
+    current = PrimaryRecordingMachine.instance
+    assert current is not previous
+    assert "stop_capture" in previous.calls
+    assert current.call_names() == ["set_suppression", "set_keymap", "start_capture"]
+    assert engine.state_events() == [
+        (PRIMARY_MACHINE_TYPE, STATE_STOPPED),
+        (PRIMARY_MACHINE_TYPE, STATE_INITIALIZING),
+        (PRIMARY_MACHINE_TYPE, STATE_RUNNING),
+    ]
+
+    # A state hook can request reconnection while the plugin is dispatching
+    # a report. Other registered subscribers must still receive that report,
+    # including the stopped report nested inside the reconnection.
+    plugin_reports = []
+    current.add_state_callback(plugin_reports.append)
+
+    def reconnect_on_disconnect(machine_type, state):
+        if state == STATE_ERROR:
+            engine.reset_machine()
+
+    engine.hook_connect("machine_state_changed", reconnect_on_disconnect)
+    engine.events.clear()
+    current.report_disconnected()
+    assert PrimaryRecordingMachine.instance is not current
+    assert engine.machine_state == STATE_RUNNING
+    assert engine.state_events() == [
+        (PRIMARY_MACHINE_TYPE, STATE_ERROR),
+        (PRIMARY_MACHINE_TYPE, STATE_STOPPED),
+        (PRIMARY_MACHINE_TYPE, STATE_INITIALIZING),
+        (PRIMARY_MACHINE_TYPE, STATE_RUNNING),
+    ]
+    assert plugin_reports == [STATE_STOPPED, STATE_ERROR], (
+        "reconnection must preserve delivery to registered subscribers "
+        "of the plugin report already being dispatched"
+    )
