+def test_none_keymap_reuse_skips_plugin_call(make_engine):
+    engine = make_engine()
+    assert engine.load_config()
+    engine.start()
+    machine = PrimaryRecordingMachine.instance
+    original_keymap = machine.keymap
+    original_config = engine._config.as_dict
+    reads = []
+
+    def config_snapshot():
+        config = original_config()
+        config["system_keymap"] = None
+        reads.append(config)
+        return config
+
+    machine.calls.clear()
+    engine.events.clear()
+    with mock.patch.object(engine._config, "as_dict", side_effect=config_snapshot):
+        # Full reload includes system_keymap in the applied update while keeping
+        # type/options unchanged, so the live instance takes the reuse path.
+        assert engine.reload_config() is None
+    assert reads, "the None-keymap update must reach configuration application"
+    assert PrimaryRecordingMachine.instance is machine
+    assert machine.keymap is original_keymap
+    assert machine.calls == [], "None must not call set_keymap or restart capture"
+    assert engine.state_events() == []
