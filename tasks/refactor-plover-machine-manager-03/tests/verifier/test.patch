+"""Supplemental P2P tests for the engine machine-management boundary.
+
+The frozen instruction keeps the externally observable machine contract
+unchanged while machine connection state, machine instance lifetime and keymap
+updating move out of the engine's mixed-responsibility reconfiguration method
+into a dedicated machine-management collaborator.
+
+These tests pin that contract through public engine entry points (``start``,
+``quit``, ``reset_machine``, ``machine_state``, ``output``/``set_output``,
+``config``), engine hooks, and the documented machine plugin contract. Fake
+machine plugins are registered in the plugin registry itself and every fake
+machine records its own interactions, so the tests do not depend on where the
+collaborator lives or on any private engine attribute.
+
+Importing this module also publishes the repository's own plugin entry points
+as distribution metadata (see ``_publish_repository_entry_points``), because the
+replay environment ships the frozen runtime dependencies but never installs
+this repository: without those entry points ``plover.registry`` finds no system
+plugin and the session fixture in ``test/conftest.py`` fails before any test
+runs. The module is therefore also loadable as a pytest plugin
+(``-p test.test_machine_management_p2p``) so the metadata is published even
+when only original test files are selected.
+"""
+
+import configparser
+import json
+import os
+import sys
+import tempfile
+import threading
+import time
+from functools import partial
+from unittest import mock
+
+import pytest
+
+from plover import system
+from plover.config import Config, DictionaryConfig
+from plover.engine import StenoEngine
+from plover.machine.base import (
+    STATE_ERROR,
+    STATE_INITIALIZING,
+    STATE_RUNNING,
+    STATE_STOPPED,
+    StenotypeBase,
+    ThreadedStenotypeBase,
+)
+from plover.machine.keymap import Keymap
+from plover.oslayer.controller import Controller
+from plover.output import Output
+from plover.registry import registry
+from plover.steno import Stroke
+
+_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+_ENTRY_POINTS_DIR = None
+
+
+def _declared_entry_points_metadata():
+    """Render this repository's declared plugin entry points as metadata."""
+    parser = configparser.RawConfigParser()
+    parser.read(os.path.join(_REPO_ROOT, "setup.cfg"), encoding="utf-8")
+    sections = []
+    for group, value in parser.items("options.entry_points"):
+        if not group.startswith("plover."):
+            continue
+        entries = [
+            line.strip()
+            for line in value.splitlines()
+            if line.strip() and "=" in line
+        ]
+        if entries:
+            sections.append(f"[{group}]\n" + "\n".join(entries))
+    return "\n\n".join(sections) + "\n"
+
+
+def _publish_repository_entry_points():
+    """Expose the repository's plugin entry points without installing it.
+
+    ``plover.registry.Registry.update()`` -- called by the session fixture in
+    ``test/conftest.py`` and by the engine fixture in ``test/test_engine.py`` --
+    reads the entry points of the installed plover distribution. The replay
+    environment provides the frozen runtime dependencies but does not install
+    the repository itself, so that lookup finds nothing and every test under
+    ``test/`` errors during setup with ``KeyError: 'english stenotype'``.
+
+    Writing the entry point metadata the repository declares in its own
+    ``setup.cfg`` into a private directory under ``TMPDIR`` (the location the
+    execution contract reserves for temporary data) and putting that directory
+    on ``sys.path`` makes the standard registry update path work unchanged.
+    Nothing is installed, downloaded or fetched from the network.
+    """
+    global _ENTRY_POINTS_DIR
+    if _ENTRY_POINTS_DIR is not None:
+        return
+    metadata_dir = os.path.join(
+        tempfile.mkdtemp(prefix="plover-test-support-"),
+        "plover_test_support-0.0.0.dist-info",
+    )
+    os.makedirs(metadata_dir)
+    with open(os.path.join(metadata_dir, "METADATA"), "w", encoding="utf-8") as fp:
+        fp.write("Metadata-Version: 2.1\nName: plover-test-support\nVersion: 0.0.0\n")
+    with open(
+        os.path.join(metadata_dir, "entry_points.txt"), "w", encoding="utf-8"
+    ) as fp:
+        fp.write(_declared_entry_points_metadata())
+    shim_dir = os.path.dirname(metadata_dir)
+    if shim_dir not in sys.path:
+        sys.path.append(shim_dir)
+    _ENTRY_POINTS_DIR = metadata_dir
+
+
+_publish_repository_entry_points()
+
+PRIMARY_MACHINE_TYPE = "P2P Fake"
+SECONDARY_MACHINE_TYPE = "P2P Fake 2"
+
+
+class RecordingMachine(StenotypeBase):
+    """A machine plugin recording every interaction the engine makes."""
+
+    instance = None
+    instances = []
+
+    def __init__(self, options):
+        super().__init__()
+        self.options = options
+        self.is_suppressed = False
+        self.calls = []
+        self.callback_order = []
+
+    @classmethod
+    def get_keys(cls):
+        return system.KEYS
+
+    @classmethod
+    def get_option_info(cls):
+        return {"option": ("default", str)}
+
+    def start_capture(self):
+        cls = type(self)
+        assert cls.instance is None, "capture started while an instance is live"
+        assert self.state_subscribers, "state callback must precede capture start"
+        assert self.stroke_subscribers, "stroke callback must precede capture start"
+        self.callback_order.append("start_capture")
+        cls.instance = self
+        cls.instances.append(self)
+        self.calls.append("start_capture")
+        self._initializing()
+        self._ready()
+
+    def stop_capture(self):
+        cls = type(self)
+        self.calls.append("stop_capture")
+        cls.instance = None
+        self._stopped()
+
+    def set_suppression(self, enabled):
+        self.calls.append(("set_suppression", enabled))
+        self.is_suppressed = enabled
+
+    def set_keymap(self, keymap):
+        self.calls.append(("set_keymap", keymap))
+        super().set_keymap(keymap)
+
+    def add_state_callback(self, callback):
+        self.callback_order.append("add_state_callback")
+        super().add_state_callback(callback)
+
+    def add_stroke_callback(self, callback):
+        self.callback_order.append("add_stroke_callback")
+        super().add_stroke_callback(callback)
+
+    def call_names(self):
+        return [call[0] if isinstance(call, tuple) else call for call in self.calls]
+
+    def report_disconnected(self):
+        self._error()
+
+    def report_stroke(self, steno_keys):
+        self._notify(steno_keys)
+
+
+class PrimaryRecordingMachine(RecordingMachine):
+    pass
+
+
+class SecondaryRecordingMachine(RecordingMachine):
+    pass
+
+
+class FakeOutput(Output):
+    def __init__(self):
+        self.backspaces = []
+
+    def send_backspaces(self, b):
+        self.backspaces.append(b)
+
+    def send_string(self, s):
+        pass
+
+    def send_key_combination(self, c):
+        pass
+
+    def set_key_press_delay(self, delay_ms):
+        pass
+
+
+class RecordingEngine(StenoEngine):
+    """An engine running reconfiguration synchronously, recording hook calls."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.events = []
+        for hook in self.HOOKS:
+            self.hook_connect(hook, partial(self._record_hook, hook))
+
+    def _record_hook(self, hook, *args, **kwargs):
+        self.events.append((hook, args, kwargs))
+
+    def _in_engine_thread(self):
+        return True
+
+    def quit(self, code=0):
+        self._same_thread_hook(self._quit, code)
+
+    def start(self):
+        StenoEngine.start(self)
+
+    def hooks(self, name):
+        return [event for event in self.events if event[0] == name]
+
+    def state_events(self):
+        return [args for _, args, _ in self.hooks("machine_state_changed")]
+
+    def output_events(self):
+        return [args for _, args, _ in self.hooks("output_changed")]
+
+
+class ThreadAwareEngine(RecordingEngine):
+    """An engine whose reconfiguration runs on a real engine thread."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.engine_thread_ident = None
+
+    def _in_engine_thread(self):
+        return threading.get_ident() == self.engine_thread_ident
+
+
+def wait_for(predicate, timeout=10.0):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if predicate():
+            return True
+        time.sleep(0.005)
+    return predicate()
+
+
+def identity_keymap_mappings():
+    return [[key, key] for key in system.KEYS]
+
+
+def identity_keymap():
+    keymap = Keymap(system.KEYS, system.KEYS)
+    keymap.set_mappings(identity_keymap_mappings())
+    return keymap
+
+
+def reversed_keymap():
+    keymap = Keymap(system.KEYS, system.KEYS)
+    keymap.set_mappings(zip(system.KEYS, reversed(system.KEYS)))
+    return keymap
+
