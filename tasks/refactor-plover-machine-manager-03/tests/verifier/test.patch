+def test_reset_machine_reloads_configuration_and_dictionaries(make_engine, tmp_path):
+    dictionary_path = tmp_path / "p2p_dict.json"
+    dictionary_path.write_text(json.dumps({"SKP": "and"}), encoding="utf-8")
+    engine = make_engine(dictionaries=[DictionaryConfig(str(dictionary_path), True)])
+    assert engine.load_config()
+    engine.start()
+    assert engine.lookup(("SKP",)) == "and"
+    timestamp = dictionary_path.stat().st_mtime
+    dictionary_path.write_text(json.dumps({"SKP": "or"}), encoding="utf-8")
+    os.utime(dictionary_path, (timestamp + 60, timestamp + 60))
+    # Keep disk and memory deliberately different: reset must not load disk.
+    disk_config = Config(engine._config.path)
+    disk_config.load()
+    disk_config["machine_specific_options"] = {"option": "disk-only"}
+    disk_config.save()
+    engine._config["machine_specific_options"] = {"option": "memory-only"}
+    previous = PrimaryRecordingMachine.instance
+    engine.events.clear()
+    with mock.patch.object(engine._config, "load", wraps=engine._config.load) as load:
+        assert engine.reset_machine() is None
+    load.assert_not_called()
+    current = PrimaryRecordingMachine.instance
+    assert current is not previous
+    assert current.options == {"option": "memory-only"}
+    assert engine.config["machine_specific_options"] == {"option": "memory-only"}
+    assert engine.lookup(("SKP",)) == "or"
+    # The forced reconnection also happened while reloading.
+    assert engine.machine_state == STATE_RUNNING
+    assert engine.state_events() == [
+        (PRIMARY_MACHINE_TYPE, STATE_STOPPED),
+        (PRIMARY_MACHINE_TYPE, STATE_INITIALIZING),
