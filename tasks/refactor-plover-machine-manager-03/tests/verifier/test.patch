index 0000000000000000000000000000000000000000..ef9c711f3b395618ef83f7db68efa9473d700a6b
--- /dev/null
+++ b/test/machine_management_f2p_runner.py
@@ -0,0 +1,123 @@
+"""Aggregate runner for the frozen P2P selectors and the declared F2P nodes.
+
+The pipeline materialises ``config.json`` from the canonical plan: its ``p2p``
+array carries the frozen P2P selectors and its ``f2p`` array carries the F2P
+selectors declared for this task.  The runner reads exactly those selectors --
+never a whole test file and never a broad pattern -- runs them through the real
+pytest JUnit producer, and writes the complete execution report to the report
+location it is given.
+
+Usage::
+
+    python test/machine_management_f2p_runner.py <config.json> <report.xml>
+    python test/machine_management_f2p_runner.py --config <config.json> --report <report.xml>
+
+Temporary data stays inside ``TMPDIR`` (pytest's cache provider is disabled),
+nothing is installed, downloaded or fetched, and the repository that contains
+this runner is the only working directory the run needs.
+"""
+
+import json
+import os
+import sys
+
+_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+_DEFAULT_CONFIG = "/tests/config.json"
+_DEFAULT_REPORT = "junit.xml"
+
+
+def _resolve_selector(entry):
+    """Return the exact selector declared by one config entry."""
+    if isinstance(entry, str):
+        return entry
+    if isinstance(entry, dict):
+        for key in ("selector", "test", "node_id", "nodeid"):
+            value = entry.get(key)
+            if isinstance(value, str) and value:
+                return value
+    return None
+
+
+def _selectors(config):
+    """Frozen P2P selectors followed by the declared F2P selectors."""
+    selectors = []
+    for key in ("p2p", "f2p"):
+        for entry in config.get(key) or ():
+            selector = _resolve_selector(entry)
+            if selector is not None and selector not in selectors:
+                selectors.append(selector)
+    return selectors
+
+
+def _parse_arguments(argv):
+    config = None
+    report = None
+    positional = []
+    pending = None
+    for argument in argv[1:]:
+        if pending == "config":
+            config = argument
+            pending = None
+        elif pending == "report":
+            report = argument
+            pending = None
+        elif argument in ("--config", "-c"):
+            pending = "config"
+        elif argument in ("--report", "-r"):
+            pending = "report"
+        elif argument.startswith("--config="):
+            config = argument.split("=", 1)[1]
+        elif argument.startswith("--report="):
+            report = argument.split("=", 1)[1]
+        else:
+            positional.append(argument)
+    if config is None and positional:
+        config = positional.pop(0)
+    if report is None and positional:
+        report = positional.pop(0)
+    return config, report
+
+
+def _resolve(value, placeholder, env_name, default):
+    if value and value != placeholder:
+        return os.path.abspath(value)
+    from_environment = os.environ.get(env_name)
+    if from_environment:
+        return os.path.abspath(from_environment)
+    return default
+
+
+def main(argv):
+    config_argument, report_argument = _parse_arguments(argv)
+    config_path = _resolve(config_argument, "{config}", "GRADER_CONFIG", _DEFAULT_CONFIG)
+    report_path = _resolve(report_argument, "{report}", "GRADER_REPORT", _DEFAULT_REPORT)
+    with open(config_path, encoding="utf-8") as config_file:
+        config = json.load(config_file)
+    selectors = _selectors(config)
+    if not selectors:
+        print("no selectors declared in %s" % config_path, file=sys.stderr)
+        return 2
+    report_dir = os.path.dirname(report_path)
+    if report_dir:
+        os.makedirs(report_dir, exist_ok=True)
+    os.chdir(_REPO_ROOT)
+    if _REPO_ROOT not in sys.path:
+        sys.path.insert(0, _REPO_ROOT)
+    import pytest
+
+    arguments = [
+        "-p",
+        "test.test_machine_management_f2p",
+        "-p",
+        "no:cacheprovider",
+        "-p",
+        "no:pytest-qt",
+        "--junitxml",
+        report_path,
+    ]
+    arguments.extend(selectors)
+    return int(pytest.main(arguments))
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
