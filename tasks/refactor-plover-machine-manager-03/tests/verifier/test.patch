+++ b/test/test_machine_management_f2p.py
@@ -0,0 +1,624 @@
+"""Supplemental F2P tests for the engine machine-management extraction.
+
+The frozen instruction moves machine connection state, machine instance
+lifetime and keymap updating out of the engine's mixed-responsibility
+reconfiguration method into a dedicated machine-management collaborator the
+engine delegates to, while every externally observable machine behavior stays
+unchanged.  The P2P nodes pin the preserved behavior; these F2P nodes pin the
+new boundary itself, which the behavior-preserving nodes cannot observe:
+
+* every documented machine plugin operation -- resolution and construction,
+  state and stroke callback registration, suppression update, keymap
+  application and capture start/stop -- must be performed by the dedicated
+  collaborator instead of by the engine itself, and
+* the machine instance, its parameters and its last reported connection state
+  must live in that collaborator instead of in the engine's own instance
+  state.
+
+Nothing here names the collaborator, its module or any private engine
+attribute.  The responsible object is discovered at runtime from what the
+engine owns and from the frame that performs each documented machine plugin
+call, so a permitted restructuring keeps passing while the pre-extraction
+engine fails.
+
+Importing this module also publishes the repository's own plugin entry points
+as distribution metadata (see ``_publish_repository_entry_points``): the
+replay environment ships the frozen runtime dependencies but never installs
+this repository, so without those entry points ``plover.registry`` finds no
+system plugin and the session fixture in ``test/conftest.py`` fails before any
+test runs.  The module is therefore also loadable as a pytest plugin
+(``-p test.test_machine_management_f2p``).
+"""
+
+import configparser
+import inspect
+import os
+import sys
+import tempfile
+from functools import partial
+from unittest import mock
+
+import pytest
+
+from plover import system
+from plover.config import DEFAULT_SYSTEM_NAME, Config
+from plover.engine import StenoEngine
+from plover.machine.base import STATE_ERROR, StenotypeBase
+from plover.machine.keymap import Keymap
+from plover.oslayer.controller import Controller
+from plover.output import Output
+from plover.registry import registry
+
+_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+_ENTRY_POINTS_DIR = None
+
+
+def _declared_entry_points_metadata():
+    """Render this repository's declared plugin entry points as metadata."""
+    parser = configparser.RawConfigParser()
+    parser.read(os.path.join(_REPO_ROOT, "setup.cfg"), encoding="utf-8")
+    if not parser.has_section("options.entry_points"):
+        return ""
+    sections = []
+    for group, value in parser.items("options.entry_points"):
+        if not group.startswith("plover."):
+            continue
+        entries = [
+            line.strip()
+            for line in value.splitlines()
+            if line.strip() and "=" in line
+        ]
+        if entries:
+            sections.append(f"[{group}]\n" + "\n".join(entries))
+    return "\n\n".join(sections) + "\n"
+
+
+def _publish_repository_entry_points():
+    """Expose the repository's plugin entry points without installing it.
+
+    ``plover.registry.Registry.update()`` -- called by the session fixture in
+    ``test/conftest.py`` -- reads the entry points of the installed plover
+    distribution.  When this repository is not installed, writing the entry
+    point metadata it declares in its own ``setup.cfg`` into a private
+    directory under ``TMPDIR`` (the location the execution contract reserves
+    for temporary data) and putting that directory on ``sys.path`` makes the
+    standard registry update path work unchanged.  Nothing is installed,
+    downloaded or fetched from the network.
+    """
+    global _ENTRY_POINTS_DIR
+    if _ENTRY_POINTS_DIR is not None:
+        return
+    metadata = _declared_entry_points_metadata()
+    if not metadata:
+        return
+    metadata_dir = os.path.join(
+        tempfile.mkdtemp(prefix="plover-f2p-support-"),
+        "plover-f2p-support-0.0.0.dist-info",
+    )
+    os.makedirs(metadata_dir)
+    with open(os.path.join(metadata_dir, "METADATA"), "w", encoding="utf-8") as fp:
+        fp.write(
+            "Metadata-Version: 2.1\nName: plover-f2p-support\nVersion: 0.0.0\n"
+        )
+    with open(
+        os.path.join(metadata_dir, "entry_points.txt"), "w", encoding="utf-8"
+    ) as fp:
+        fp.write(metadata)
+    shim_dir = os.path.dirname(metadata_dir)
+    if shim_dir not in sys.path:
+        sys.path.append(shim_dir)
+    _ENTRY_POINTS_DIR = metadata_dir
+
+
+try:
+    _publish_repository_entry_points()
+except Exception:
+    pass
+
+PRIMARY_MACHINE_TYPE = "F2P Fake"
+SECONDARY_MACHINE_TYPE = "F2P Fake 2"
+
+
+def _operation_caller():
+    """Find the executing method receiver without assuming its local name.
+
+    Match the receiver's actual method code, rather than accepting an arbitrary
+    object present in the frame. Ownership is checked separately by the tests.
+    """
+    frame = inspect.currentframe()
+    try:
+        caller = frame.f_back
+        if caller is None:
+            return None
+        caller = caller.f_back
+        while caller is not None:
+            code = caller.f_code
+            if code.co_argcount:
+                candidate = caller.f_locals.get(code.co_varnames[0])
+                plugin_frame = isinstance(candidate, StenotypeBase) or (
+                    isinstance(candidate, type) and issubclass(candidate, StenotypeBase)
+                )
+                if candidate is not None and not plugin_frame:
+                    method = inspect.getattr_static(type(candidate), code.co_name, None)
+                    method = getattr(method, "__func__", method)
+                    if method is not None and (
+                        getattr(method, "__code__", None) is code
+                        or getattr(inspect.unwrap(method), "__code__", None) is code
+                    ):
+                        return candidate
+            caller = caller.f_back
+        return None
+    finally:
+        del frame
+
+
+def only_caller(callers):
+    assert len(callers) == 1, f"expected one plugin operation, got {callers!r}"
+    return callers[0]
+
+
+class RecordingMachine(StenotypeBase):
+    """A machine plugin recording who invokes each documented operation."""
+
+    instance = None
+    construction_callers = []
+
+    def __init__(self, options):
+        super().__init__()
+        type(self).construction_callers.append(_operation_caller())
+        self.options = options
+        self.is_suppressed = False
+        self.calls = []
+
+    @classmethod
+    def get_keys(cls):
+        return system.KEYS
+
+    @classmethod
+    def get_option_info(cls):
+        return {"option": ("default", str)}
+
+    def _record(self, operation):
+        self.calls.append((operation, _operation_caller()))
+
+    def callers(self, operation):
+        return [caller for name, caller in self.calls if name == operation]
+
+    def start_capture(self):
+        cls = type(self)
+        assert cls.instance is None, "capture started while an instance is live"
+        assert self.state_subscribers, "state callback must precede capture start"
+        assert self.stroke_subscribers, "stroke callback must precede capture start"
+        cls.instance = self
+        self._record("start_capture")
+        self._initializing()
+        self._ready()
+
+    def stop_capture(self):
+        cls = type(self)
+        self._record("stop_capture")
+        cls.instance = None
+        self._stopped()
+
+    def set_suppression(self, enabled):
+        self._record("set_suppression")
+        self.is_suppressed = enabled
+
+    def set_keymap(self, keymap):
+        self._record("set_keymap")
+        super().set_keymap(keymap)
+
+    def add_state_callback(self, callback):
+        self._record("add_state_callback")
+        super().add_state_callback(callback)
+
+    def add_stroke_callback(self, callback):
+        self._record("add_stroke_callback")
+        super().add_stroke_callback(callback)
+
+    def report_disconnected(self):
+        self._error()
+
+
+class PrimaryRecordingMachine(RecordingMachine):
+    pass
+
+
+class SecondaryRecordingMachine(RecordingMachine):
+    pass
+
+
+class FakeOutput(Output):
+    def send_backspaces(self, b):
+        pass
+
+    def send_string(self, s):
+        pass
+
+    def send_key_combination(self, c):
+        pass
+
+    def set_key_press_delay(self, delay_ms):
+        pass
+
+
+class SynchronousEngine(StenoEngine):
+    """An engine running reconfiguration synchronously, recording hook calls."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.events = []
+        for hook in self.HOOKS:
+            self.hook_connect(hook, partial(self._record_hook, hook))
+
+    def _record_hook(self, hook, *args, **kwargs):
+        self.events.append((hook, args, kwargs))
+
+    def _in_engine_thread(self):
+        return True
+
+    def quit(self, code=0):
+        self._same_thread_hook(self._quit, code)
+
+
+def instance_holders(engine, instance):
+    """Locate ``instance`` in the engine's instance state.
+
+    Returns ``(direct, holders)``: ``direct`` names the engine's own attributes
+    bound to ``instance``, ``holders`` lists the engine-owned objects holding
+    ``instance`` in their own instance state one attribute hop away.
+    """
+    direct = []
+    holders = []
+    for name, value in vars(engine).items():
+        if name.startswith("__"):
+            continue
+        if value is instance:
+            direct.append(name)
+            continue
+        try:
+            members = vars(value)
+        except TypeError:
+            continue
+        if any(member is instance for member in members.values()):
+            holders.append(value)
+    return direct, holders
+
+
+def engine_owns(engine, obj):
+    """Whether ``obj`` is one of the engine's own attribute values."""
+    return any(value is obj for value in vars(engine).values())
+
+
+def identity_keymap_mappings():
+    return [[key, key] for key in system.KEYS]
+
+
+def identity_keymap():
+    keymap = Keymap(system.KEYS, system.KEYS)
+    keymap.set_mappings(identity_keymap_mappings())
+    return keymap
+
+
+def reversed_keymap():
+    keymap = Keymap(system.KEYS, system.KEYS)
+    keymap.set_mappings(zip(system.KEYS, reversed(system.KEYS)))
+    return keymap
+
+
+@pytest.fixture(scope="session", autouse=True)
+def f2p_ensure_default_system():
+    """Load the registry and the default system like ``test/conftest.py`` does.
+
+    The shared session fixture is normally what makes ``plover.system`` usable;
+    repeating the same two idempotent calls here keeps this module runnable
+    when it is executed on its own, for example through ``-p``.
+    """
+    registry.update()
+    system.setup(DEFAULT_SYSTEM_NAME)
+
+
+@pytest.fixture(autouse=True)
+def f2p_register_fake_machines():
+    registry.register_plugin("machine", PRIMARY_MACHINE_TYPE, PrimaryRecordingMachine)
+    registry.register_plugin(
+        "machine", SECONDARY_MACHINE_TYPE, SecondaryRecordingMachine
+    )
+
+
+@pytest.fixture(autouse=True)
+def f2p_reset_recording_machines():
+    for machine_class in (PrimaryRecordingMachine, SecondaryRecordingMachine):
+        machine_class.instance = None
+        machine_class.construction_callers.clear()
+
+
+@pytest.fixture
+def f2p_make_engine(tmp_path):
+    config_count = [0]
+
+    def factory(
+        machine_type=PRIMARY_MACHINE_TYPE,
+        machine_options=None,
+        **settings,
+    ):
+        config_count[0] += 1
+        config_path = tmp_path / f"plover-{config_count[0]}.config"
+        config = Config(str(config_path))
+        config["dictionaries"] = []
+        config["machine_type"] = machine_type
+        config["machine_specific_options"] = (
+            {"option": "default"} if machine_options is None else dict(machine_options)
+        )
+        config["system_keymap"] = identity_keymap_mappings()
+        for name, value in settings.items():
+            config[name] = value
+        config.save()
+        controller = mock.MagicMock(spec=Controller)
+        return SynchronousEngine(config, controller, FakeOutput())
+
+    return factory
+
+
+def start_engine(engine):
+    assert engine.load_config()
+    engine.start()
+    return engine
+
+
+def test_startup_machine_construction_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine(machine_options={"option": "configured"}))
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    assert machine.options == {"option": "configured"}
+    caller = only_caller(PrimaryRecordingMachine.construction_callers)
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_startup_state_callback_registration_is_delegated_to_machine_owner(
+    f2p_make_engine,
+):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    caller = only_caller(machine.callers("add_state_callback"))
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_startup_stroke_callback_registration_is_delegated_to_machine_owner(
+    f2p_make_engine,
+):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    caller = only_caller(machine.callers("add_stroke_callback"))
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_startup_suppression_sync_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    assert machine.is_suppressed is False
+    caller = only_caller(machine.callers("set_suppression"))
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_startup_keymap_application_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    assert machine.keymap == identity_keymap()
+    caller = only_caller(machine.callers("set_keymap"))
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_startup_capture_start_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    caller = only_caller(machine.callers("start_capture"))
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_keymap_only_change_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    machine.calls.clear()
+    engine.config = {"system_keymap": reversed_keymap()}
+    assert machine.keymap == reversed_keymap()
+    caller = only_caller(machine.callers("set_keymap"))
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_machine_options_change_rebuild_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine(machine_options={"option": "first"}))
+    previous = PrimaryRecordingMachine.instance
+    assert previous is not None
+    PrimaryRecordingMachine.construction_callers.clear()
+    engine.config = {"machine_specific_options": {"option": "second"}}
+    current = PrimaryRecordingMachine.instance
+    assert current is not None
+    assert current is not previous
+    stop_caller = only_caller(previous.callers("stop_capture"))
+    build_caller = only_caller(PrimaryRecordingMachine.construction_callers)
+    start_caller = only_caller(current.callers("start_capture"))
+    assert stop_caller is not engine
+    assert build_caller is not engine
+    assert start_caller is not engine
+    assert engine_owns(engine, build_caller)
+
+
+def test_machine_type_change_rebuild_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    previous = PrimaryRecordingMachine.instance
+    assert previous is not None
+    SecondaryRecordingMachine.construction_callers.clear()
+    engine.config = {"machine_type": SECONDARY_MACHINE_TYPE}
+    current = SecondaryRecordingMachine.instance
+    assert current is not None
+    stop_caller = only_caller(previous.callers("stop_capture"))
+    build_caller = only_caller(SecondaryRecordingMachine.construction_callers)
+    start_caller = only_caller(current.callers("start_capture"))
+    assert stop_caller is not engine
+    assert build_caller is not engine
+    assert start_caller is not engine
+    assert engine_owns(engine, build_caller)
+
+
+def test_forced_reconnection_rebuild_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    previous = PrimaryRecordingMachine.instance
+    assert previous is not None
+    PrimaryRecordingMachine.construction_callers.clear()
+    assert engine.reset_machine() is None
+    current = PrimaryRecordingMachine.instance
+    assert current is not None
+    assert current is not previous
+    stop_caller = only_caller(previous.callers("stop_capture"))
+    build_caller = only_caller(PrimaryRecordingMachine.construction_callers)
+    start_caller = only_caller(current.callers("start_capture"))
+    assert stop_caller is not engine
+    assert build_caller is not engine
+    assert start_caller is not engine
+    assert engine_owns(engine, build_caller)
+
+
+def test_shutdown_capture_stop_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    engine.quit(0)
+    assert engine.join() == 0
+    caller = only_caller(machine.callers("stop_capture"))
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_output_enable_suppression_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    machine.calls.clear()
+    engine.output = True
+    assert machine.is_suppressed is True
+    caller = only_caller(machine.callers("set_suppression"))
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_output_disable_suppression_is_delegated_to_machine_owner(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    engine.output = True
+    machine.calls.clear()
+    engine.output = False
+    assert machine.is_suppressed is False
+    caller = only_caller(machine.callers("set_suppression"))
+    assert caller is not engine
+    assert engine_owns(engine, caller)
+
+
+def test_engine_does_not_hold_the_live_machine_instance(f2p_make_engine):
+    engine = start_engine(f2p_make_engine())
+    machine = PrimaryRecordingMachine.instance
+    assert machine is not None
+    direct, _ = instance_holders(engine, machine)
+    assert direct == [], f"engine attributes still bound to the machine: {direct}"
+
+
