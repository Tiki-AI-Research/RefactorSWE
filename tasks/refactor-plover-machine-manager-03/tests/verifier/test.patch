+def test_machine_callbacks_are_marshalled_onto_engine_thread(make_engine):
+    engine = make_engine(engine_class=ThreadAwareEngine)
+    assert engine.load_config()
+    delivered = []
+    engine.hook_connect(
+        "machine_state_changed",
+        lambda *args: delivered.append(("state", args, threading.get_ident())),
+    )
+    engine.hook_connect(
+        "stroked",
+        lambda *args: delivered.append(("stroke", args, threading.get_ident())),
+    )
+    stroke_order = []
+    engine.hook_connect(
+        "stroked",
+        lambda stroke: stroke_order.append(("stroked", stroke, threading.get_ident())),
+    )
+    original_translate = engine._translator.translate
+
+    def translate(stroke):
+        stroke_order.append(("translate", stroke, threading.get_ident()))
+        return original_translate(stroke)
+
+    def run_engine():
+        engine.engine_thread_ident = threading.get_ident()
+        engine.run()
+
+    engine_thread = threading.Thread(target=run_engine, name="p2p-engine", daemon=True)
+    engine_thread.start()
+    assert wait_for(lambda: engine.engine_thread_ident is not None)
+    try:
+        engine.start()
+        assert wait_for(lambda: engine.machine_state == STATE_RUNNING), (
+            f"machine never connected: {delivered!r}"
+        )
+        machine = PrimaryRecordingMachine.instance
+        assert machine is not None
+        # Machine reports from the machine's own thread must be marshalled
+        # through the engine before the engine hooks run.
+        with mock.patch(
+            "plover.engine.log.stroke",
+            side_effect=lambda stroke: stroke_order.append(
+                ("log", stroke, threading.get_ident())
+            ),
+        ), mock.patch.object(engine._translator, "translate", side_effect=translate):
+            machine.report_disconnected()
+            machine.report_stroke(("S-", "T-"))
+            assert wait_for(lambda: len(delivered) >= 4 and len(stroke_order) == 3), (
+                f"hooks or stroke stages not delivered: {delivered!r}, {stroke_order!r}"
+            )
+            recorded = list(delivered)
+    finally:
+        engine.quit(0)
+        engine_thread.join(10)
+    assert not engine_thread.is_alive()
+    assert {thread_id for _, _, thread_id in recorded} == {engine_thread.ident}
+    assert [kind for kind, _, _ in recorded] == ["state", "state", "state", "stroke"]
+    assert [args for kind, args, _ in recorded if kind == "state"] == [
+        (PRIMARY_MACHINE_TYPE, STATE_INITIALIZING),
+        (PRIMARY_MACHINE_TYPE, STATE_RUNNING),
+        (PRIMARY_MACHINE_TYPE, STATE_ERROR),
+    ]
+    (stroke,) = recorded[3][1]
+    assert isinstance(stroke, Stroke)
+    assert stroke.steno_keys == ["S-", "T-"]
+    assert [stage for stage, _, _ in stroke_order] == ["log", "translate", "stroked"]
+    assert all(observed is stroke for _, observed, _ in stroke_order)
+    assert {thread_id for _, _, thread_id in stroke_order} == {engine_thread.ident}
+
