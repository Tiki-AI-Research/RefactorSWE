+def test_reload_config_reads_disk_before_full_update(make_engine):
+    engine = make_engine(machine_options={"option": "memory"})
+    assert engine.load_config()
+    engine.start()
+    disk = Config(engine._config.path)
+    disk.load()
+    disk["machine_specific_options"] = {"option": "disk"}
+    disk["undo_levels"] = 59
+    disk.save()
+    trace = []
+    original_load = engine._config.load
+
+    def load_disk():
+        trace.append("load")
+        original_load()
+
+    engine.events.clear()
+    engine.hook_connect("config_changed", lambda update: trace.append("update"))
+    with mock.patch.object(engine._config, "load", side_effect=load_disk) as load:
+        assert engine.reload_config() is None
+    load.assert_called_once_with()
+    assert trace == ["load", "update"]
+    assert PrimaryRecordingMachine.instance.options == {"option": "disk"}
+    assert engine.config["undo_levels"] == 59
+    assert engine.hooks("config_changed") == [("config_changed", (engine.config,), {})]
