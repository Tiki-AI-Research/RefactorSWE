+def test_output_transitions_synchronize_suppression_once(make_engine):
+    engine = make_engine()
+    assert engine.load_config()
+    engine.start()
+    machine = PrimaryRecordingMachine.instance
+    engine.events.clear()
+    machine.calls.clear()
+    # Enabling output suppresses the machine and reports exactly one event.
+    engine.output = True
+    assert engine.output is True
+    assert machine.is_suppressed is True
+    assert machine.calls == [("set_suppression", True)]
+    assert engine.output_events() == [(True,)]
+    # A redundant request is a no-op.
+    machine.calls.clear()
+    engine.events.clear()
+    engine.output = True
+    assert machine.calls == []
+    assert engine.events == []
+    # Disabling output releases suppression and reports exactly one event.
+    engine.output = False
+    assert engine.output is False
+    assert machine.is_suppressed is False
+    assert machine.calls == [("set_suppression", False)]
+    assert engine.output_events() == [(False,)]
