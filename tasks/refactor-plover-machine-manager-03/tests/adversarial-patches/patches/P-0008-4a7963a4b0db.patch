+def test_suppress_last_stroke(engine):
+    engine.start()
+    engine.output = False
+    assert FakeMachine.suppressed_callback is None
+    engine._send_engine_command("resume")
+    assert FakeMachine.suppressed_callback == engine._keyboard_emulation.send_backspaces
+
+
+def test_machine_rebuild_and_state(engine):
+    assert engine.machine_state is None
+    engine.start()
+    assert engine.machine_state == STATE_RUNNING
+    assert FakeMachine.init_count == 1
+    assert FakeMachine.start_count == 1
+    assert FakeMachine.suppression_count == 1
+    assert FakeMachine.keymap_count == 1
+    first_instance = FakeMachine.instance
+
+    engine.events.clear()
+    engine.config = {"machine_type": "Fake2"}
+    assert FakeMachine.instance is not None
+    assert FakeMachine.instance is not first_instance
+    assert FakeMachine.stop_count == 1
+    assert FakeMachine.init_count == 2
+    assert FakeMachine.start_count == 2
+    assert FakeMachine.suppression_count == 2
+    assert FakeMachine.keymap_count == 2
+    assert engine.events[:3] == [
+        ("machine_state_changed", ("Fake", STATE_STOPPED), {}),
+        ("machine_state_changed", ("Fake2", STATE_INITIALIZING), {}),
+        ("machine_state_changed", ("Fake2", STATE_RUNNING), {}),
+    ]
+    assert engine.events[3][0] == "config_changed"
+    assert engine.events[3][1][0]["machine_type"] == "Fake2"
+    assert len(engine.events) == 4
+
+    FakeMachine.instance._error()
+    assert engine.machine_state == STATE_ERROR
+
+    engine.quit()
+    assert engine.machine_state == STATE_STOPPED
+
+
+def test_output_toggling(engine):
+    engine.start()
+    FakeMachine.suppression_count = 0
+    engine.events.clear()
+
+    # Redundant output change should not emit event or set suppression.
+    engine.output = False
+    assert engine.events == []
+    assert FakeMachine.suppression_count == 0
+
+    # Effective output transition.
+    engine.output = True
+    assert engine.events == [("output_changed", (True,), {})]
+    assert FakeMachine.instance.is_suppressed
+    assert FakeMachine.suppression_count == 1
+
+    # Redundant output change.
+    engine.events.clear()
+    engine.output = True
+    assert engine.events == []
+    assert FakeMachine.suppression_count == 1
+
+    # Toggling twice.
+    engine.toggle_output()
+    assert not engine.output
+    assert not FakeMachine.instance.is_suppressed
+    assert FakeMachine.suppression_count == 2
+
+    engine.toggle_output()
+    assert engine.output
+    assert FakeMachine.instance.is_suppressed
+    assert FakeMachine.suppression_count == 3
+
+
+def test_output_without_machine(engine):
+    assert FakeMachine.instance is None
+    assert not engine.output
+    engine.events.clear()
+
+    engine.output = True
+    assert engine.output is True
+    assert engine.events == [("output_changed", (True,), {})]
+    assert FakeMachine.instance is None
+    assert FakeMachine.suppression_count == 0
+
+    engine.events.clear()
+    engine.quit()
+    assert FakeMachine.instance is None
+    assert engine.events == [("quit", (), {})]
+
+
+def test_machine_callbacks_marshaled_to_engine_thread(engine, monkeypatch):
+    engine.start()
+    engine.events.clear()
+    monkeypatch.setattr(engine, "_in_engine_thread", lambda: False)
+
+    for callback in FakeMachine.instance.state_subscribers:
+        callback(STATE_ERROR)
+    for callback in FakeMachine.instance.stroke_subscribers:
+        callback(("S-",))
+
+    assert engine.events == []
+    assert engine.machine_state != STATE_ERROR
+
+    engine._queue.put((lambda: True, (), {}))
+    engine.run()
+
+    assert engine.machine_state == STATE_ERROR
+    assert engine.events == [
+        ("machine_state_changed", ("Fake", STATE_ERROR), {}),
+        ("stroked", (Stroke(("S-",)),), {}),
+    ]
+    assert engine._queue.empty()
+
